// Create publishDiagnostics notification
fn publish_diagnostics_notification(uri: String, diagnostics: [Diagnostic]) -> String {
    let mut params = json_object()
    params = json_set(params, "uri", json_string(uri))
    params = json_set(params, "diagnostics", diagnostics_to_json(diagnostics))
    return jsonrpc_notification("textDocument/publishDiagnostics", params)
}
