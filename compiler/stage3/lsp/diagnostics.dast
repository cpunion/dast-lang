// LSP Diagnostics Generation using Stage 2 bridge
// Calls lsp_analyze_source() which is compiled with Stage 2

// Parse error string format: "line:col:message"
fn parse_error_string(err: String) -> [i32] {
    // Simple parser: find first two colons
    let mut first_colon = -1
    let mut second_colon = -1
    let mut i = 0
    while i < len(err) {
        if char_at(err, i) == 58 {  // ':'
            if first_colon < 0 {
                first_colon = i
            } else if second_colon < 0 {
                second_colon = i
            }
        }
        i = i + 1
    }

    let mut result: [i32] = []
    if first_colon >= 0 && second_colon > first_colon {
        // Extract line number (simplified - just use 0)
        push(&mut result, 0)
        push(&mut result, 0)
    } else {
        push(&mut result, 0)
        push(&mut result, 0)
    }
    return result
}

// Generate diagnostics for a document
fn lsp_generate_diagnostics(uri: String, content: String) -> [Diagnostic] {
    let mut diagnostics: [Diagnostic] = []

    // Call Stage 2 bridge function
    let errors = lsp_analyze_source(content)

    // Convert error strings to diagnostics
    let mut i = 0
    while i < len(errors) {
        let err = errors[i]
        let pos = parse_error_string(err)
        let line = pos[0]
        let col = pos[1]
        let range = range_new(line, col, line, col + 10)
        let diag = diagnostic_new(range, DiagnosticSeverity.Error, err)
        let mut diags = diagnostics
        push(&mut diags, diag)
        diagnostics = diags
        i = i + 1
    }

    return diagnostics
}
