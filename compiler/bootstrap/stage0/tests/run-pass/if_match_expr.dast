enum OptionI32 {
    Some(i32),
    None,
}

fn main() {
    let x = if true { 1 } else { 2 }
    println("x", x)

    let y = if false { 1 } else if true { 2 } else { 3 }
    println("y", y)

    let z = { let a = 3; a + 4 }
    println("z", z)

    let opt = OptionI32.Some(10)
    let v = match opt {
        .Some(n) => n + 1,
        .None => 0,
    }
    println("v", v)
}
