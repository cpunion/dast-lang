struct Counter {
    value: i32,
}

impl Counter {
    fn inc(self: &mut Self) {
        self.value = self.value + 1
    }

    fn get(self: &Self) -> i32 {
        self.value
    }
}

fn make_counter(value: i32) -> Counter {
    Counter { value: value }
}

fn main() {
    let mut c = make_counter(1)
    let mut r = &mut c
    r.inc()
    println("v", r.get())
}
