fn test_math() {
    if add(1, 2) != 3 { exit(1) }
    if mul(2, 3) != 6 { exit(1) }
    if sub.add10(5) != 15 { exit(1) }
    if local_value() != 7 { exit(1) }
    if inc(9) != 10 { exit(1) }
}

fn test_mutation() {
    let mut c = Counter { value: 1 }
    c.value = c.value + 2
    if c.value != 3 { exit(1) }

    let mut xs = [1, 2]
    push(&mut xs, 3)
    if len(xs) != 3 { exit(1) }
    let v = pop(&mut xs)
    if v != 3 { exit(1) }
    if len(xs) != 2 { exit(1) }
}
