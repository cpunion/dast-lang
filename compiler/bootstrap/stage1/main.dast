struct ArgSplit {
    files: [String],
    rest: [String],
}

struct ParseResult {
    prog: Program,
    errors: [ParseError],
}

fn struct_list_new() -> [StructDecl] {
    let mut items: [StructDecl] = []
    return items
}

fn enum_list_new() -> [EnumDecl] {
    let mut items: [EnumDecl] = []
    return items
}

fn const_list_new() -> [ConstDecl] {
    let mut items: [ConstDecl] = []
    return items
}

fn func_list_new() -> [FunctionDecl] {
    let mut items: [FunctionDecl] = []
    return items
}

fn impl_list_new() -> [ImplDecl] {
    let mut items: [ImplDecl] = []
    return items
}

fn program_empty() -> Program {
    return Program {
        structs: struct_list_new(),
        enums: enum_list_new(),
        consts: const_list_new(),
        functions: func_list_new(),
        impls: impl_list_new(),
    }
}

fn usage() {
    println("usage:")
    println("  dast run <file.dast> [more.dast ...] [-- args...]")
    println("  dast ir <file.dast> [more.dast ...]")
    println("  dast ir-run <file.ir> [-- args...]")
}

fn split_args(args: [String], start: i32) -> ArgSplit {
    let mut files: [String] = []
    let mut rest: [String] = []
    let mut i = start
    let mut done = false
    while i < len(args) && !done {
        if args[i] == "--" {
            i = i + 1
            done = true
        } else {
            push(&mut files, args[i])
            i = i + 1
        }
    }
    while i < len(args) {
        push(&mut rest, args[i])
        i = i + 1
    }
    return ArgSplit { files: files, rest: rest }
}

fn parse_files(files: [String]) -> ParseResult {
    let mut merged = program_empty()
    let mut errs: [ParseError] = []
    let mut i = 0
    while i < len(files) {
        let src = read_file(files[i])
        let mut lex = lexer_new(src)
        let mut local_errs: [ParseError] = []
        let prog = parse_program(src, &mut lex, &mut local_errs)
        append_program(&mut merged, prog)
        let mut j = 0
        while j < len(local_errs) {
            push(&mut errs, local_errs[j])
            j = j + 1
        }
        i = i + 1
    }
    return ParseResult { prog: merged, errors: errs }
}

fn append_program(dst: &mut Program, src: Program) {
    let mut structs = dst.structs
    let mut i = 0
    while i < len(src.structs) {
        push(&mut structs, src.structs[i])
        i = i + 1
    }
    dst.structs = structs
    let mut enums = dst.enums
    i = 0
    while i < len(src.enums) {
        push(&mut enums, src.enums[i])
        i = i + 1
    }
    dst.enums = enums
    let mut consts = dst.consts
    i = 0
    while i < len(src.consts) {
        push(&mut consts, src.consts[i])
        i = i + 1
    }
    dst.consts = consts
    let mut funcs = dst.functions
    i = 0
    while i < len(src.functions) {
        push(&mut funcs, src.functions[i])
        i = i + 1
    }
    dst.functions = funcs
    let mut impls = dst.impls
    i = 0
    while i < len(src.impls) {
        push(&mut impls, src.impls[i])
        i = i + 1
    }
    dst.impls = impls
}

fn print_errors(errors: [ParseError]) {
    let mut i = 0
    while i < len(errors) {
        let e = errors[i]
        println("error", e.pos, e.msg)
        i = i + 1
    }
}

fn main() {
    let argv = args()
    if len(argv) < 1 {
        usage()
        return
    }
    let cmd = argv[0]
    if cmd != "run" && cmd != "ir" && cmd != "ir-run" {
        usage()
        return
    }
    let mut debug = false
    let mut start = 1
    if len(argv) > 1 && argv[1] == "--debug" {
        debug = true
        start = 2
    }
    if debug { println("stage1: start") }
    let split = split_args(argv, start)
    if len(split.files) == 0 {
        usage()
        return
    }

    if cmd == "ir-run" {
        if len(split.files) != 1 {
            usage()
            return
        }
        let text = read_file(split.files[0])
        let parsed = ir_parse_program(text)
        if !parsed.ok {
            println("error", parsed.line, parsed.error)
            return
        }
        let mut rt = runtime_new(parsed.prog, split.rest)
        if debug { println("stage1: running ir") }
        runtime_run(&mut rt, parsed.prog.entry)
        if rt.error != "" {
            println("error", rt.error)
        }
        return
    }
    let parse_res = parse_files(split.files)
    if len(parse_res.errors) > 0 {
        print_errors(parse_res.errors)
        return
    }
    if debug { println("stage1: parsed") }
    let tctx = check_program(parse_res.prog)
    if len(tctx.errors) > 0 {
        print_errors(tctx.errors)
        return
    }
    if debug { println("stage1: typechecked") }
    let comp = compile_program(parse_res.prog, tctx)
    if len(comp.errors) > 0 {
        print_errors(comp.errors)
        return
    }
    if debug { println("stage1: compiled") }
    if cmd == "ir" {
        print(ir_program_format(comp.prog))
        return
    }
    let mut rt = runtime_new(comp.prog, split.rest)
    if debug { println("stage1: running") }
    runtime_run(&mut rt, comp.prog.entry)
    if rt.error != "" {
        println("error", rt.error)
    }
}
