fn ir_kind_int() -> i32 { return 0 }
fn ir_kind_bool() -> i32 { return 1 }
fn ir_kind_string() -> i32 { return 2 }
fn ir_kind_unit() -> i32 { return 3 }
fn ir_kind_ref() -> i32 { return 4 }
fn ir_kind_struct() -> i32 { return 5 }
fn ir_kind_enum() -> i32 { return 6 }
fn ir_kind_array() -> i32 { return 7 }

fn int_to_string(x: i32) -> String {
    if x == 0 {
        return "0"
    }
    let mut n = x
    let mut neg = false
    if n < 0 {
        neg = true
        n = -n
    }
    let mut digits: [i32] = []
    while n > 0 {
        push(&mut digits, n % 10)
        n = n / 10
    }
    let mut out = ""
    if neg {
        out = "-"
    }
    let mut i = len(digits) - 1
    while i >= 0 {
        out = out + substr("0123456789", digits[i], 1)
        if i == 0 {
            i = -1
        } else {
            i = i - 1
        }
    }
    return out
}

struct IrValue {
    kind: i32,
    int: i32,
    int_type: String,
    bool: bool,
    str: String,
    ref: i32,
    obj: i32,
}

fn ir_value_unit() -> IrValue {
    return IrValue { kind: ir_kind_unit(), int: 0, int_type: "", bool: false, str: "", ref: -1, obj: -1 }
}

fn ir_value_int(v: i32) -> IrValue {
    return IrValue { kind: ir_kind_int(), int: v, int_type: "", bool: false, str: "", ref: -1, obj: -1 }
}

fn ir_value_int_t(v: i32, t: String) -> IrValue {
    return IrValue { kind: ir_kind_int(), int: v, int_type: t, bool: false, str: "", ref: -1, obj: -1 }
}

fn ir_value_bool(v: bool) -> IrValue {
    return IrValue { kind: ir_kind_bool(), int: 0, int_type: "", bool: v, str: "", ref: -1, obj: -1 }
}

fn ir_value_string(v: String) -> IrValue {
    return IrValue { kind: ir_kind_string(), int: 0, int_type: "", bool: false, str: v, ref: -1, obj: -1 }
}

fn ir_value_ref(addr: i32) -> IrValue {
    return IrValue { kind: ir_kind_ref(), int: 0, int_type: "", bool: false, str: "", ref: addr, obj: -1 }
}

fn ir_value_struct(idx: i32) -> IrValue {
    return IrValue { kind: ir_kind_struct(), int: 0, int_type: "", bool: false, str: "", ref: -1, obj: idx }
}

fn ir_value_enum(idx: i32) -> IrValue {
    return IrValue { kind: ir_kind_enum(), int: 0, int_type: "", bool: false, str: "", ref: -1, obj: idx }
}

fn ir_value_array(idx: i32) -> IrValue {
    return IrValue { kind: ir_kind_array(), int: 0, int_type: "", bool: false, str: "", ref: -1, obj: idx }
}

struct IrStructFieldValue {
    name: String,
    value: IrValue,
}

struct IrStructValue {
    name: String,
    fields: [IrStructFieldValue],
}

struct IrEnumValue {
    name: String,
    variant: String,
    tag: i32,
    tag_type: String,
    has_payload: bool,
    payload: IrValue,
}

struct IrArrayValue {
    elems: [IrValue],
}

struct IrProgram {
    version: String,
    features: [String],
    functions: [IrFunction],
    entry: String,
}

struct IrFunction {
    name: String,
    params: [String],
    param_types: [String],
    return_type: String,
    blocks: [IrBlock],
    temp_count: i32,
}

struct IrBlock {
    label: String,
    instrs: [IrInstr],
    term: IrTerm,
}

struct IrConst {
    dst: i32,
    value: IrValue,
}

struct IrLoadVar {
    dst: i32,
    name: String,
}

struct IrStoreVar {
    name: String,
    src: i32,
}

struct IrAddrOf {
    dst: i32,
    name: String,
}

struct IrLoadRef {
    dst: i32,
    src: i32,
}

struct IrStoreRef {
    ref: i32,
    src: i32,
}

struct IrBinOp {
    dst: i32,
    op: String,
    lhs: i32,
    rhs: i32,
}

struct IrUnaryOp {
    dst: i32,
    op: String,
    src: i32,
}

struct IrCall {
    dst: i32,
    callee: String,
    args: [i32],
}

struct IrMakeArray {
    dst: i32,
    elems: [i32],
}

struct IrIndex {
    dst: i32,
    array: i32,
    index: i32,
}

struct IrSetIndex {
    array: i32,
    index: i32,
    src: i32,
}

struct IrIndexUnchecked {
    dst: i32,
    array: i32,
    index: i32,
}

struct IrSetIndexUnchecked {
    array: i32,
    index: i32,
    src: i32,
}

struct IrStructFieldInit {
    name: String,
    src: i32,
}

struct IrMakeStruct {
    dst: i32,
    name: String,
    fields: [IrStructFieldInit],
}

struct IrGetField {
    dst: i32,
    src: i32,
    field: String,
}

struct IrSetField {
    src: i32,
    field: String,
    value: i32,
}

struct IrMakeEnum {
    dst: i32,
    name: String,
    variant: String,
    tag: i32,
    tag_type: String,
    payload: i32,
}

struct IrEnumTag {
    dst: i32,
    src: i32,
}

struct IrEnumPayload {
    dst: i32,
    src: i32,
}

enum IrInstr {
    Const(IrConst),
    LoadVar(IrLoadVar),
    StoreVar(IrStoreVar),
    AddrOf(IrAddrOf),
    LoadRef(IrLoadRef),
    StoreRef(IrStoreRef),
    BinOp(IrBinOp),
    UnaryOp(IrUnaryOp),
    Call(IrCall),
    MakeArray(IrMakeArray),
    Index(IrIndex),
    SetIndex(IrSetIndex),
    IndexUnchecked(IrIndexUnchecked),
    SetIndexUnchecked(IrSetIndexUnchecked),
    MakeStruct(IrMakeStruct),
    GetField(IrGetField),
    SetField(IrSetField),
    MakeEnum(IrMakeEnum),
    EnumTag(IrEnumTag),
    EnumPayload(IrEnumPayload),
}

struct IrJump {
    target: String,
}

struct IrBranch {
    cond: i32,
    then_label: String,
    else_label: String,
}

struct IrReturn {
    has_value: bool,
    value: i32,
}

struct IrNoTerm {}

enum IrTerm {
    None(IrNoTerm),
    Jump(IrJump),
    Branch(IrBranch),
    Return(IrReturn),
}

fn ir_term_none() -> IrTerm {
    return IrTerm.None(IrNoTerm {})
}

fn ir_value_stringify(v: IrValue) -> String {
    if v.kind == ir_kind_int() {
        if v.int_type != "" {
            return v.int_type + " " + int_to_string(v.int)
        }
        return int_to_string(v.int)
    }
    if v.kind == ir_kind_bool() {
        if v.bool { return "true" }
        return "false"
    }
    if v.kind == ir_kind_string() { return "\"" + ir_escape_string(v.str) + "\"" }
    if v.kind == ir_kind_ref() { return "&" + int_to_string(v.ref) }
    if v.kind == ir_kind_struct() { return "struct#" + int_to_string(v.obj) }
    if v.kind == ir_kind_enum() { return "enum#" + int_to_string(v.obj) }
    if v.kind == ir_kind_array() { return "array#" + int_to_string(v.obj) }
    return "unit"
}

fn ir_escape_string(s: String) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == '\n' { out = out + "\\n" }
        else if c == '\t' { out = out + "\\t" }
        else if c == '\r' { out = out + "\\r" }
        else if c == '\\' { out = out + "\\\\" }
        else if c == '"' { out = out + "\\\"" }
        else { out = out + substr(s, i, 1) }
        i = i + 1
    }
    return out
}

fn ir_instr_string(inst: IrInstr) -> String {
    match inst {
        IrInstr.Const(i) => { return "t" + int_to_string(i.dst) + " = const " + ir_value_stringify(i.value) }
        .LoadVar(i) => { return "t" + int_to_string(i.dst) + " = load " + i.name }
        .StoreVar(i) => { return "store " + i.name + ", t" + int_to_string(i.src) }
        .AddrOf(i) => { return "t" + int_to_string(i.dst) + " = addr_of " + i.name }
        .LoadRef(i) => { return "t" + int_to_string(i.dst) + " = load_ref t" + int_to_string(i.src) }
        .StoreRef(i) => { return "store_ref t" + int_to_string(i.ref) + ", t" + int_to_string(i.src) }
        .BinOp(i) => {
            return "t" + int_to_string(i.dst) + " = " + i.op + " t" + int_to_string(i.lhs) + ", t" + int_to_string(i.rhs)
        }
        .UnaryOp(i) => { return "t" + int_to_string(i.dst) + " = " + i.op + " t" + int_to_string(i.src) }
        IrInstr.Call(i) => {
            let mut args = ""
            let mut j = 0
            while j < len(i.args) {
                if j > 0 { args = args + ", " }
                args = args + "t" + int_to_string(i.args[j])
                j = j + 1
            }
            if i.dst >= 0 {
                return "t" + int_to_string(i.dst) + " = call " + i.callee + "(" + args + ")"
            }
            return "call " + i.callee + "(" + args + ")"
        }
        .MakeArray(i) => {
            let mut elems = ""
            let mut j = 0
            while j < len(i.elems) {
                if j > 0 { elems = elems + ", " }
                elems = elems + "t" + int_to_string(i.elems[j])
                j = j + 1
            }
            return "t" + int_to_string(i.dst) + " = array [" + elems + "]"
        }
        IrInstr.Index(i) => { return "t" + int_to_string(i.dst) + " = index t" + int_to_string(i.array) + "[t" + int_to_string(i.index) + "]" }
        .SetIndex(i) => { return "set_index t" + int_to_string(i.array) + "[t" + int_to_string(i.index) + "] = t" + int_to_string(i.src) }
        .IndexUnchecked(i) => { return "t" + int_to_string(i.dst) + " = index_unchecked t" + int_to_string(i.array) + "[t" + int_to_string(i.index) + "]" }
        .SetIndexUnchecked(i) => { return "set_index_unchecked t" + int_to_string(i.array) + "[t" + int_to_string(i.index) + "] = t" + int_to_string(i.src) }
        .MakeStruct(i) => {
            let mut fields = ""
            let mut j = 0
            while j < len(i.fields) {
                if j > 0 { fields = fields + ", " }
                fields = fields + i.fields[j].name + ": t" + int_to_string(i.fields[j].src)
                j = j + 1
            }
            return "t" + int_to_string(i.dst) + " = struct " + i.name + " { " + fields + " }"
        }
        .GetField(i) => { return "t" + int_to_string(i.dst) + " = get_field t" + int_to_string(i.src) + "." + i.field }
        .SetField(i) => { return "set_field t" + int_to_string(i.src) + "." + i.field + " = t" + int_to_string(i.value) }
        .MakeEnum(i) => {
            let mut tag = ""
            if i.tag_type != "" {
                tag = "@" + int_to_string(i.tag) + ":" + i.tag_type
            }
            if i.payload >= 0 {
                return "t" + int_to_string(i.dst) + " = enum " + i.name + "." + i.variant + tag + "(t" + int_to_string(i.payload) + ")"
            }
            return "t" + int_to_string(i.dst) + " = enum " + i.name + "." + i.variant + tag
        }
        .EnumTag(i) => { return "t" + int_to_string(i.dst) + " = enum_tag t" + int_to_string(i.src) }
        .EnumPayload(i) => { return "t" + int_to_string(i.dst) + " = enum_payload t" + int_to_string(i.src) }
    }
    return ""
}

fn ir_term_string(term: IrTerm) -> String {
    match term {
        .None(_) => { return "" }
        .Jump(t) => { return "jump " + t.target }
        .Branch(t) => {
            return "branch t" + int_to_string(t.cond) + ", " + t.then_label + ", " + t.else_label
        }
        IrTerm.Return(t) => {
            if !t.has_value { return "return" }
            return "return t" + int_to_string(t.value)
        }
    }
}

fn ir_program_format(p: IrProgram) -> String {
    let mut out = "ir " + p.version + "\n"
    let mut i = 0
    while i < len(p.functions) {
        let f = p.functions[i]
        let mut params = ""
        let mut has_types = false
        if len(f.param_types) == len(f.params) {
            let mut t = 0
            while t < len(f.param_types) {
                if f.param_types[t] != "" { has_types = true }
                t = t + 1
            }
        }
        let mut j = 0
        while j < len(f.params) {
            if j > 0 { params = params + ", " }
            if has_types {
                let tname = f.param_types[j]
                if tname != "" {
                    params = params + f.params[j] + ": " + tname
                } else {
                    params = params + f.params[j]
                }
            } else {
                params = params + f.params[j]
            }
            j = j + 1
        }
        out = out + "fn " + f.name + "(" + params + ")"
        if f.return_type != "" && f.return_type != "unit" {
            out = out + " -> " + f.return_type
        }
        out = out + "\n"
        let mut b = 0
        while b < len(f.blocks) {
            let blk = f.blocks[b]
            out = out + "  block " + blk.label + ":\n"
            let mut k = 0
            while k < len(blk.instrs) {
                out = out + "    " + ir_instr_string(blk.instrs[k]) + "\n"
                k = k + 1
            }
            let term = ir_term_string(blk.term)
            if term != "" {
                out = out + "    " + term + "\n"
            }
            b = b + 1
        }
        out = out + "\n"
        i = i + 1
    }
    return out
}

struct IrParseResult {
    ok: bool,
    prog: IrProgram,
    error: String,
    line: i32,
}

struct IrLineParse {
    ok: bool,
    is_term: bool,
    instr: IrInstr,
    term: IrTerm,
    max_temp: i32,
    error: String,
}

fn ir_instr_dummy() -> IrInstr {
    return IrInstr.Const(IrConst { dst: 0, value: ir_value_unit() })
}

fn ir_is_space(c: i32) -> bool {
    if c == 32 { return true }
    if c == 9 { return true }
    if c == 13 { return true }
    return false
}

fn trim_space(s: String) -> String {
    let mut start = 0
    let mut end = len(s)
    let mut done = false
    while start < end && !done {
        if !ir_is_space(char_at(s, start)) {
            done = true
        } else {
            start = start + 1
        }
    }
    done = false
    while end > start && !done {
        if !ir_is_space(char_at(s, end - 1)) {
            done = true
        } else {
            end = end - 1
        }
    }
    return substr(s, start, end - start)
}

fn has_prefix(s: String, pref: String) -> bool {
    if len(s) < len(pref) { return false }
    return substr(s, 0, len(pref)) == pref
}

fn has_suffix(s: String, suf: String) -> bool {
    if len(s) < len(suf) { return false }
    return substr(s, len(s) - len(suf), len(suf)) == suf
}

fn find_char(s: String, ch: i32, start: i32) -> i32 {
    let mut i = start
    while i < len(s) {
        if char_at(s, i) == ch { return i }
        i = i + 1
    }
    return -1
}

fn find_arrow(s: String) -> i32 {
    let mut i = 0
    while i + 1 < len(s) {
        if char_at(s, i) == 45 && char_at(s, i + 1) == 62 {
            return i
        }
        i = i + 1
    }
    return -1
}

fn split_lines(s: String) -> [String] {
    let mut lines: [String] = []
    let mut start = 0
    let mut i = 0
    while i < len(s) {
        if char_at(s, i) == 10 {
            push(&mut lines, substr(s, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    if start <= len(s) {
        push(&mut lines, substr(s, start, len(s) - start))
    }
    return lines
}

fn split_comma_list(s: String) -> [String] {
    let mut parts: [String] = []
    let mut start = 0
    let mut i = 0
    while i < len(s) {
        if char_at(s, i) == 44 {
            let part = trim_space(substr(s, start, i - start))
            if part != "" { push(&mut parts, part) }
            start = i + 1
        }
        i = i + 1
    }
    let part = trim_space(substr(s, start, len(s) - start))
    if part != "" { push(&mut parts, part) }
    return parts
}

fn ir_function_list_new() -> [IrFunction] {
    let mut items: [IrFunction] = []
    return items
}

fn ir_block_list_new() -> [IrBlock] {
    let mut items: [IrBlock] = []
    return items
}

fn ir_instr_list_new() -> [IrInstr] {
    let mut items: [IrInstr] = []
    return items
}

fn ir_string_list_new() -> [String] {
    return string_list_new()
}

fn parse_temp_name(text: String) -> i32 {
    let t = trim_space(text)
    if len(t) < 2 { return -1 }
    if char_at(t, 0) != 116 { return -1 }
    return parse_int(substr(t, 1, len(t) - 1))
}

fn strip_quotes(text: String) -> String {
    if len(text) < 2 { return text }
    return ir_unescape_string(substr(text, 1, len(text) - 2))
}

fn ir_unescape_string(s: String) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == '\\' && i + 1 < len(s) {
            let n = char_at(s, i + 1)
            if n == 'n' { out = out + "\n" }
            else if n == 't' { out = out + "\t" }
            else if n == 'r' { out = out + "\r" }
            else if n == '\\' { out = out + "\\" }
            else if n == '"' { out = out + "\"" }
            else { out = out + substr(s, i + 1, 1) }
            i = i + 2
        } else {
            out = out + substr(s, i, 1)
            i = i + 1
        }
    }
    return out
}

fn parse_ir_value(text: String) -> IrValue {
    let t = trim_space(text)
    if t == "unit" { return ir_value_unit() }
    if t == "true" { return ir_value_bool(true) }
    if t == "false" { return ir_value_bool(false) }
    let space = find_char(t, 32, 0)
    if space > 0 {
        let prefix = trim_space(substr(t, 0, space))
        let rest = trim_space(substr(t, space + 1, len(t) - space - 1))
        if is_int_type_name(prefix) {
            return ir_value_int_t(parse_int(rest), prefix)
        }
    }
    if len(t) >= 2 {
        if char_at(t, 0) == 34 {
            if char_at(t, len(t) - 1) == 34 {
                return ir_value_string(strip_quotes(t))
            }
        }
        if char_at(t, 0) == 38 {
            let n = parse_int(substr(t, 1, len(t) - 1))
            return ir_value_ref(n)
        }
    }
    if has_prefix(t, "struct#") {
        let n = parse_int(substr(t, 7, len(t) - 7))
        return ir_value_struct(n)
    }
    if has_prefix(t, "enum#") {
        let n = parse_int(substr(t, 5, len(t) - 5))
        return ir_value_enum(n)
    }
    if has_prefix(t, "array#") {
        let n = parse_int(substr(t, 6, len(t) - 6))
        return ir_value_array(n)
    }
    return ir_value_int(parse_int(t))
}

fn is_int_type_name(name: String) -> bool {
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "i128" { return true }
    if name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "u128" { return true }
    if name == "isize" || name == "usize" || name == "char" { return true }
    return false
}

fn ir_line_parse_error(msg: String) -> IrLineParse {
    return IrLineParse { ok: false, is_term: false, instr: ir_instr_dummy(), term: ir_term_none(), max_temp: -1, error: msg }
}

fn ir_parse_call(text: String, dst: i32) -> IrLineParse {
    let open = find_char(text, 40, 0)
    let close = find_char(text, 41, 0)
    if open < 0 || close < 0 || close < open {
        return ir_line_parse_error("invalid call syntax")
    }
    let callee = trim_space(substr(text, 0, open))
    let args_text = trim_space(substr(text, open + 1, close - open - 1))
    let mut args: [i32] = []
    if args_text != "" {
        let parts = split_comma_list(args_text)
        let mut i = 0
        while i < len(parts) {
            let t = parse_temp_name(parts[i])
            push(&mut args, t)
            i = i + 1
        }
    }
    let mut max = dst
    let mut mi = 0
    while mi < len(args) {
        if args[mi] > max { max = args[mi] }
        mi = mi + 1
    }
    return IrLineParse { ok: true, is_term: false, instr: IrInstr.Call(IrCall { dst: dst, callee: callee, args: args }), term: ir_term_none(), max_temp: max, error: "" }
}

fn ir_parse_line(line: String) -> IrLineParse {
    let l = trim_space(line)
    if l == "" { return ir_line_parse_error("empty line") }
    if has_prefix(l, "jump ") {
        let target = trim_space(substr(l, 5, len(l) - 5))
        return IrLineParse { ok: true, is_term: true, instr: ir_instr_dummy(), term: IrTerm.Jump(IrJump { target: target }), max_temp: -1, error: "" }
    }
    if has_prefix(l, "branch ") {
        let rest = trim_space(substr(l, 7, len(l) - 7))
        let first = find_char(rest, 44, 0)
        if first < 0 { return ir_line_parse_error("invalid branch syntax") }
        let second = find_char(rest, 44, first + 1)
        if second < 0 { return ir_line_parse_error("invalid branch syntax") }
        let cond = parse_temp_name(substr(rest, 0, first))
        let then_label = trim_space(substr(rest, first + 1, second - first - 1))
        let else_label = trim_space(substr(rest, second + 1, len(rest) - second - 1))
        return IrLineParse { ok: true, is_term: true, instr: ir_instr_dummy(), term: IrTerm.Branch(IrBranch { cond: cond, then_label: then_label, else_label: else_label }), max_temp: cond, error: "" }
    }
    if has_prefix(l, "return") {
        let rest = trim_space(substr(l, 6, len(l) - 6))
        if rest == "" {
            return IrLineParse { ok: true, is_term: true, instr: ir_instr_dummy(), term: IrTerm.Return(IrReturn { has_value: false, value: 0 }), max_temp: -1, error: "" }
        }
        let val = parse_temp_name(rest)
        return IrLineParse { ok: true, is_term: true, instr: ir_instr_dummy(), term: IrTerm.Return(IrReturn { has_value: true, value: val }), max_temp: val, error: "" }
    }
    if has_prefix(l, "store_ref ") {
        let rest = trim_space(substr(l, 10, len(l) - 10))
        let comma = find_char(rest, 44, 0)
        if comma < 0 { return ir_line_parse_error("invalid store_ref syntax") }
        let r = parse_temp_name(substr(rest, 0, comma))
        let src = parse_temp_name(substr(rest, comma + 1, len(rest) - comma - 1))
        let mut max = r
        if src > max { max = src }
        return IrLineParse { ok: true, is_term: false, instr: IrInstr.StoreRef(IrStoreRef { ref: r, src: src }), term: ir_term_none(), max_temp: max, error: "" }
    }
    if has_prefix(l, "store ") {
        let rest = trim_space(substr(l, 6, len(l) - 6))
        let comma = find_char(rest, 44, 0)
        if comma < 0 { return ir_line_parse_error("invalid store syntax") }
        let name = trim_space(substr(rest, 0, comma))
        let src = parse_temp_name(substr(rest, comma + 1, len(rest) - comma - 1))
        return IrLineParse { ok: true, is_term: false, instr: IrInstr.StoreVar(IrStoreVar { name: name, src: src }), term: ir_term_none(), max_temp: src, error: "" }
    }
    if has_prefix(l, "set_index_unchecked ") {
        let rest = trim_space(substr(l, 20, len(l) - 20))
        let eq = find_char(rest, 61, 0)
        if eq < 0 { return ir_line_parse_error("invalid set_index_unchecked syntax") }
        let left = trim_space(substr(rest, 0, eq))
        let right = trim_space(substr(rest, eq + 1, len(rest) - eq - 1))
        let open = find_char(left, 91, 0)
        let close = find_char(left, 93, 0)
        if open < 0 || close < 0 || close < open {
            return ir_line_parse_error("invalid set_index_unchecked syntax")
        }
        let array = parse_temp_name(substr(left, 0, open))
        let index = parse_temp_name(substr(left, open + 1, close - open - 1))
        let src = parse_temp_name(right)
        let max = array
        let mut max2 = max
        if index > max2 { max2 = index }
        let mut max3 = max2
        if src > max3 { max3 = src }
        return IrLineParse { ok: true, is_term: false, instr: IrInstr.SetIndexUnchecked(IrSetIndexUnchecked { array: array, index: index, src: src }), term: ir_term_none(), max_temp: max3, error: "" }
    }
    if has_prefix(l, "set_index ") {
        let rest = trim_space(substr(l, 10, len(l) - 10))
        let eq = find_char(rest, 61, 0)
        if eq < 0 { return ir_line_parse_error("invalid set_index syntax") }
        let left = trim_space(substr(rest, 0, eq))
        let right = trim_space(substr(rest, eq + 1, len(rest) - eq - 1))
        let open = find_char(left, 91, 0)
        let close = find_char(left, 93, 0)
        if open < 0 || close < 0 || close < open {
            return ir_line_parse_error("invalid set_index syntax")
        }
        let array = parse_temp_name(substr(left, 0, open))
        let index = parse_temp_name(substr(left, open + 1, close - open - 1))
        let src = parse_temp_name(right)
        let max = array
        let mut max2 = max
        if index > max2 { max2 = index }
        let mut max3 = max2
        if src > max3 { max3 = src }
        return IrLineParse { ok: true, is_term: false, instr: IrInstr.SetIndex(IrSetIndex { array: array, index: index, src: src }), term: ir_term_none(), max_temp: max3, error: "" }
    }
    if has_prefix(l, "set_field ") {
        let rest = trim_space(substr(l, 10, len(l) - 10))
        let eq = find_char(rest, 61, 0)
        if eq < 0 { return ir_line_parse_error("invalid set_field syntax") }
        let left = trim_space(substr(rest, 0, eq))
        let right = trim_space(substr(rest, eq + 1, len(rest) - eq - 1))
        let dot = find_char(left, 46, 0)
        if dot < 0 { return ir_line_parse_error("invalid set_field syntax") }
        let recv = parse_temp_name(substr(left, 0, dot))
        let field = trim_space(substr(left, dot + 1, len(left) - dot - 1))
        let val = parse_temp_name(right)
        let mut max = recv
        if val > max { max = val }
        return IrLineParse { ok: true, is_term: false, instr: IrInstr.SetField(IrSetField { src: recv, field: field, value: val }), term: ir_term_none(), max_temp: max, error: "" }
    }
    if has_prefix(l, "call ") {
        let rest = trim_space(substr(l, 5, len(l) - 5))
        return ir_parse_call(rest, -1)
    }
    if has_prefix(l, "t") {
        let eq = find_char(l, 61, 0)
        if eq < 0 { return ir_line_parse_error("invalid assignment syntax") }
        let left = trim_space(substr(l, 0, eq))
        let right = trim_space(substr(l, eq + 1, len(l) - eq - 1))
        let dst = parse_temp_name(left)
        if has_prefix(right, "const ") {
            let v = parse_ir_value(substr(right, 6, len(right) - 6))
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.Const(IrConst { dst: dst, value: v }), term: ir_term_none(), max_temp: dst, error: "" }
        }
        if has_prefix(right, "load ") {
            let name = trim_space(substr(right, 5, len(right) - 5))
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.LoadVar(IrLoadVar { dst: dst, name: name }), term: ir_term_none(), max_temp: dst, error: "" }
        }
        if has_prefix(right, "addr_of ") {
            let name = trim_space(substr(right, 8, len(right) - 8))
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.AddrOf(IrAddrOf { dst: dst, name: name }), term: ir_term_none(), max_temp: dst, error: "" }
        }
        if has_prefix(right, "load_ref ") {
            let src = parse_temp_name(substr(right, 9, len(right) - 9))
            let mut max = dst
            if src > max { max = src }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.LoadRef(IrLoadRef { dst: dst, src: src }), term: ir_term_none(), max_temp: max, error: "" }
        }
        if has_prefix(right, "call ") {
            let rest = trim_space(substr(right, 5, len(right) - 5))
            let res = ir_parse_call(rest, dst)
            if res.ok {
                let mut max = dst
                if res.max_temp > max { max = res.max_temp }
                return IrLineParse { ok: true, is_term: false, instr: res.instr, term: ir_term_none(), max_temp: max, error: "" }
            }
            return res
        }
        if has_prefix(right, "array ") {
            let rest = trim_space(substr(right, 6, len(right) - 6))
            let open = find_char(rest, 91, 0)
            let close = find_char(rest, 93, 0)
            if open < 0 || close < 0 || close < open {
                return ir_line_parse_error("invalid array syntax")
            }
            let inside = trim_space(substr(rest, open + 1, close - open - 1))
            let mut elems: [i32] = []
            let mut max = dst
            if inside != "" {
                let parts = split_comma_list(inside)
                let mut i = 0
                while i < len(parts) {
                    let t = parse_temp_name(parts[i])
                    push(&mut elems, t)
                    if t > max { max = t }
                    i = i + 1
                }
            }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.MakeArray(IrMakeArray { dst: dst, elems: elems }), term: ir_term_none(), max_temp: max, error: "" }
        }
        if has_prefix(right, "index_unchecked ") {
            let rest = trim_space(substr(right, 16, len(right) - 16))
            let open = find_char(rest, 91, 0)
            let close = find_char(rest, 93, 0)
            if open < 0 || close < 0 || close < open {
                return ir_line_parse_error("invalid index_unchecked syntax")
            }
            let array = parse_temp_name(substr(rest, 0, open))
            let index = parse_temp_name(substr(rest, open + 1, close - open - 1))
            let mut max = dst
            if array > max { max = array }
            if index > max { max = index }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.IndexUnchecked(IrIndexUnchecked { dst: dst, array: array, index: index }), term: ir_term_none(), max_temp: max, error: "" }
        }
        if has_prefix(right, "index ") {
            let rest = trim_space(substr(right, 6, len(right) - 6))
            let open = find_char(rest, 91, 0)
            let close = find_char(rest, 93, 0)
            if open < 0 || close < 0 || close < open {
                return ir_line_parse_error("invalid index syntax")
            }
            let array = parse_temp_name(substr(rest, 0, open))
            let index = parse_temp_name(substr(rest, open + 1, close - open - 1))
            let mut max = dst
            if array > max { max = array }
            if index > max { max = index }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.Index(IrIndex { dst: dst, array: array, index: index }), term: ir_term_none(), max_temp: max, error: "" }
        }
        if has_prefix(right, "struct ") {
            let rest = trim_space(substr(right, 7, len(right) - 7))
            let open = find_char(rest, 123, 0)
            let close = find_char(rest, 125, 0)
            if open < 0 || close < 0 || close < open {
                return ir_line_parse_error("invalid struct syntax")
            }
            let name = trim_space(substr(rest, 0, open))
            let fields_text = trim_space(substr(rest, open + 1, close - open - 1))
            let mut fields: [IrStructFieldInit] = []
            let mut max = dst
            if fields_text != "" {
                let parts = split_comma_list(fields_text)
                let mut i = 0
                while i < len(parts) {
                    let part = parts[i]
                    let colon = find_char(part, 58, 0)
                    if colon < 0 { return ir_line_parse_error("invalid struct field") }
                    let fname = trim_space(substr(part, 0, colon))
                    let fsrc = parse_temp_name(substr(part, colon + 1, len(part) - colon - 1))
                    push(&mut fields, IrStructFieldInit { name: fname, src: fsrc })
                    if fsrc > max { max = fsrc }
                    i = i + 1
                }
            }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.MakeStruct(IrMakeStruct { dst: dst, name: name, fields: fields }), term: ir_term_none(), max_temp: max, error: "" }
        }
        if has_prefix(right, "get_field ") {
            let rest = trim_space(substr(right, 10, len(right) - 10))
            let dot = find_char(rest, 46, 0)
            if dot < 0 { return ir_line_parse_error("invalid get_field syntax") }
            let src = parse_temp_name(substr(rest, 0, dot))
            let field = trim_space(substr(rest, dot + 1, len(rest) - dot - 1))
            let mut max = dst
            if src > max { max = src }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.GetField(IrGetField { dst: dst, src: src, field: field }), term: ir_term_none(), max_temp: max, error: "" }
        }
        if has_prefix(right, "enum ") {
            let rest = trim_space(substr(right, 5, len(right) - 5))
            let open = find_char(rest, 40, 0)
            let mut name_variant = rest
            let mut payload = -1
            if open >= 0 {
                let close = find_char(rest, 41, 0)
                if close < 0 { return ir_line_parse_error("invalid enum syntax") }
                name_variant = trim_space(substr(rest, 0, open))
                let payload_text = trim_space(substr(rest, open + 1, close - open - 1))
                payload = parse_temp_name(payload_text)
            }
            let dot = find_char(name_variant, 46, 0)
            if dot < 0 { return ir_line_parse_error("invalid enum syntax") }
            let name = trim_space(substr(name_variant, 0, dot))
            let variant_part = trim_space(substr(name_variant, dot + 1, len(name_variant) - dot - 1))
            let mut variant = variant_part
            let mut tag = 0
            let mut tag_type = ""
            let at = find_char(variant_part, 64, 0)
            if at >= 0 {
                variant = trim_space(substr(variant_part, 0, at))
                let tag_spec = trim_space(substr(variant_part, at + 1, len(variant_part) - at - 1))
                let colon = find_char(tag_spec, 58, 0)
                if colon < 0 { return ir_line_parse_error("invalid enum tag") }
                let tag_text = trim_space(substr(tag_spec, 0, colon))
                tag_type = trim_space(substr(tag_spec, colon + 1, len(tag_spec) - colon - 1))
                tag = parse_int(tag_text)
            }
            let mut max = dst
            if payload > max { max = payload }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.MakeEnum(IrMakeEnum { dst: dst, name: name, variant: variant, tag: tag, tag_type: tag_type, payload: payload }), term: ir_term_none(), max_temp: max, error: "" }
        }
        if has_prefix(right, "enum_tag ") {
            let src = parse_temp_name(substr(right, 9, len(right) - 9))
            let mut max = dst
            if src > max { max = src }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.EnumTag(IrEnumTag { dst: dst, src: src }), term: ir_term_none(), max_temp: max, error: "" }
        }
        if has_prefix(right, "enum_payload ") {
            let src = parse_temp_name(substr(right, 13, len(right) - 13))
            let mut max = dst
            if src > max { max = src }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.EnumPayload(IrEnumPayload { dst: dst, src: src }), term: ir_term_none(), max_temp: max, error: "" }
        }
        let space = find_char(right, 32, 0)
        if space < 0 { return ir_line_parse_error("invalid op syntax") }
        let op = trim_space(substr(right, 0, space))
        let rest = trim_space(substr(right, space + 1, len(right) - space - 1))
        let comma = find_char(rest, 44, 0)
        if comma >= 0 {
            let lhs = parse_temp_name(substr(rest, 0, comma))
            let rhs = parse_temp_name(substr(rest, comma + 1, len(rest) - comma - 1))
            let mut max = dst
            if lhs > max { max = lhs }
            if rhs > max { max = rhs }
            return IrLineParse { ok: true, is_term: false, instr: IrInstr.BinOp(IrBinOp { dst: dst, op: op, lhs: lhs, rhs: rhs }), term: ir_term_none(), max_temp: max, error: "" }
        }
        let src = parse_temp_name(rest)
        let mut max = dst
        if src > max { max = src }
        return IrLineParse { ok: true, is_term: false, instr: IrInstr.UnaryOp(IrUnaryOp { dst: dst, op: op, src: src }), term: ir_term_none(), max_temp: max, error: "" }
    }
    return ir_line_parse_error("unknown instruction")
}

fn ir_parse_program(text: String) -> IrParseResult {
    let lines = split_lines(text)
    let mut i = 0
    let mut header = ""
    while i < len(lines) && header == "" {
        let t = trim_space(lines[i])
        if t != "" { header = t }
        if header == "" { i = i + 1 }
    }
    if header == "" {
        return IrParseResult { ok: false, prog: IrProgram { version: "v0", features: string_list_new(), functions: ir_function_list_new(), entry: "" }, error: "empty ir", line: 1 }
    }
    if !has_prefix(header, "ir ") {
        return IrParseResult { ok: false, prog: IrProgram { version: "v0", features: string_list_new(), functions: ir_function_list_new(), entry: "" }, error: "missing ir header", line: i + 1 }
    }
    let version = trim_space(substr(header, 3, len(header) - 3))
    let mut prog = IrProgram { version: version, features: string_list_new(), functions: ir_function_list_new(), entry: "" }
    i = i + 1
    let mut func_active = false
    let mut block_active = false
    let mut cur_fn = IrFunction { name: "", params: string_list_new(), param_types: string_list_new(), return_type: "", blocks: ir_block_list_new(), temp_count: 0 }
    let mut cur_block = IrBlock { label: "", instrs: ir_instr_list_new(), term: ir_term_none() }
    let mut max_temp = -1
    while i < len(lines) {
        let line = trim_space(lines[i])
        if line == "" {
            if block_active {
                let mut blks = cur_fn.blocks
                push(&mut blks, cur_block)
                cur_fn.blocks = blks
                block_active = false
            }
            if func_active {
                if max_temp < 0 { cur_fn.temp_count = 0 } else { cur_fn.temp_count = max_temp + 1 }
                let mut funcs = prog.functions
                push(&mut funcs, cur_fn)
                prog.functions = funcs
                func_active = false
            }
            i = i + 1
        } else if has_prefix(line, "fn ") {
            if block_active {
                let mut blks = cur_fn.blocks
                push(&mut blks, cur_block)
                cur_fn.blocks = blks
                block_active = false
            }
            if func_active {
                if max_temp < 0 { cur_fn.temp_count = 0 } else { cur_fn.temp_count = max_temp + 1 }
                let mut funcs = prog.functions
                push(&mut funcs, cur_fn)
                prog.functions = funcs
                func_active = false
            }
            let mut header = line
            let mut ret_type = ""
            let arrow = find_arrow(line)
            if arrow >= 0 {
                ret_type = trim_space(substr(line, arrow + 2, len(line) - arrow - 2))
                header = trim_space(substr(line, 0, arrow))
            }
            let open = find_char(header, 40, 0)
            let close = find_char(header, 41, 0)
            if open < 0 || close < 0 || close < open {
                return IrParseResult { ok: false, prog: prog, error: "invalid fn syntax", line: i + 1 }
            }
            let name = trim_space(substr(header, 3, open - 3))
            let params_text = trim_space(substr(header, open + 1, close - open - 1))
            let mut params: [String] = []
            let mut param_types: [String] = []
            if params_text != "" {
                let parts = split_comma_list(params_text)
                let mut p = 0
                while p < len(parts) {
                    let part = parts[p]
                    let colon = find_char(part, 58, 0)
                    if colon >= 0 {
                        let pname = trim_space(substr(part, 0, colon))
                        let ptype = trim_space(substr(part, colon + 1, len(part) - colon - 1))
                        push(&mut params, pname)
                        push(&mut param_types, ptype)
                    } else {
                        push(&mut params, part)
                        push(&mut param_types, "")
                    }
                    p = p + 1
                }
            }
            cur_fn = IrFunction { name: name, params: params, param_types: param_types, return_type: ret_type, blocks: ir_block_list_new(), temp_count: 0 }
            func_active = true
            max_temp = -1
            i = i + 1
        } else if has_prefix(line, "block ") {
            if !func_active {
                return IrParseResult { ok: false, prog: prog, error: "block outside function", line: i + 1 }
            }
            if block_active {
                let mut blks = cur_fn.blocks
                push(&mut blks, cur_block)
                cur_fn.blocks = blks
                block_active = false
            }
            if !has_suffix(line, ":") {
                return IrParseResult { ok: false, prog: prog, error: "invalid block syntax", line: i + 1 }
            }
            let label = trim_space(substr(line, 6, len(line) - 7))
            cur_block = IrBlock { label: label, instrs: ir_instr_list_new(), term: ir_term_none() }
            block_active = true
            i = i + 1
        } else {
            if !block_active {
                return IrParseResult { ok: false, prog: prog, error: "instruction outside block", line: i + 1 }
            }
            match cur_block.term {
                .None(_) => {}
                _ => { return IrParseResult { ok: false, prog: prog, error: "instruction after terminator", line: i + 1 } }
            }
            let res = ir_parse_line(line)
            if !res.ok {
                return IrParseResult { ok: false, prog: prog, error: res.error, line: i + 1 }
            }
            if res.max_temp > max_temp { max_temp = res.max_temp }
            if res.is_term {
                cur_block.term = res.term
            } else {
                let mut instrs = cur_block.instrs
                push(&mut instrs, res.instr)
                cur_block.instrs = instrs
            }
            i = i + 1
        }
    }
    if block_active {
        let mut blks = cur_fn.blocks
        push(&mut blks, cur_block)
        cur_fn.blocks = blks
    }
    if func_active {
        if max_temp < 0 { cur_fn.temp_count = 0 } else { cur_fn.temp_count = max_temp + 1 }
        let mut funcs = prog.functions
        push(&mut funcs, cur_fn)
        prog.functions = funcs
    }
    let mut entry = ""
    let mut idx = 0
    while idx < len(prog.functions) && entry == "" {
        if prog.functions[idx].name == "main" { entry = "main" }
        idx = idx + 1
    }
    if entry == "" && len(prog.functions) > 0 { entry = prog.functions[0].name }
    prog.entry = entry
    return IrParseResult { ok: true, prog: prog, error: "", line: 0 }
}

fn ir_string_list_contains(items: [String], name: String) -> bool {
    let mut i = 0
    while i < len(items) {
        if items[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn ir_is_bin_op(op: String) -> bool {
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" { return true }
    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return true }
    if op == "&&" || op == "||" { return true }
    return false
}

fn ir_is_unary_op(op: String) -> bool {
    return op == "-" || op == "!"
}

fn ir_validate_temp(t: i32, temp_count: i32, allow_neg1: bool) -> String {
    if allow_neg1 && t == -1 {
        return ""
    }
    if t < 0 {
        return "invalid temp t" + int_to_string(t)
    }
    if t >= temp_count {
        return "temp t" + int_to_string(t) + " out of range (temp_count=" + int_to_string(temp_count) + ")"
    }
    return ""
}

fn ir_validate_instr(inst: IrInstr, temp_count: i32, declared: [String]) -> String {
    match inst {
        IrInstr.Const(i) => { return ir_validate_temp(i.dst, temp_count, false) }
        .LoadVar(i) => {
            if i.name == "" { return "load var name is empty" }
            if !ir_string_list_contains(declared, i.name) { return "undefined variable '" + i.name + "'" }
            return ir_validate_temp(i.dst, temp_count, false)
        }
        .StoreVar(i) => {
            if i.name == "" { return "store var name is empty" }
            return ir_validate_temp(i.src, temp_count, false)
        }
        .AddrOf(i) => {
            if i.name == "" { return "addr_of name is empty" }
            if !ir_string_list_contains(declared, i.name) { return "undefined variable '" + i.name + "'" }
            return ir_validate_temp(i.dst, temp_count, false)
        }
        .LoadRef(i) => {
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            return ir_validate_temp(i.src, temp_count, false)
        }
        .StoreRef(i) => {
            let err = ir_validate_temp(i.ref, temp_count, false)
            if err != "" { return err }
            return ir_validate_temp(i.src, temp_count, false)
        }
        .BinOp(i) => {
            if !ir_is_bin_op(i.op) { return "invalid binop '" + i.op + "'" }
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            let err2 = ir_validate_temp(i.lhs, temp_count, false)
            if err2 != "" { return err2 }
            return ir_validate_temp(i.rhs, temp_count, false)
        }
        .UnaryOp(i) => {
            if !ir_is_unary_op(i.op) { return "invalid unary op '" + i.op + "'" }
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            return ir_validate_temp(i.src, temp_count, false)
        }
        IrInstr.Call(i) => {
            if i.callee == "" { return "call callee is empty" }
            let err = ir_validate_temp(i.dst, temp_count, true)
            if err != "" { return err }
            let mut a = 0
            while a < len(i.args) {
                let e = ir_validate_temp(i.args[a], temp_count, false)
                if e != "" { return e }
                a = a + 1
            }
            return ""
        }
        .MakeArray(i) => {
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            let mut j = 0
            while j < len(i.elems) {
                let e = ir_validate_temp(i.elems[j], temp_count, false)
                if e != "" { return e }
                j = j + 1
            }
            return ""
        }
        IrInstr.Index(i) => {
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            let e2 = ir_validate_temp(i.array, temp_count, false)
            if e2 != "" { return e2 }
            return ir_validate_temp(i.index, temp_count, false)
        }
        .SetIndex(i) => {
            let e1 = ir_validate_temp(i.array, temp_count, false)
            if e1 != "" { return e1 }
            let e2 = ir_validate_temp(i.index, temp_count, false)
            if e2 != "" { return e2 }
            return ir_validate_temp(i.src, temp_count, false)
        }
        .IndexUnchecked(i) => {
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            let e2 = ir_validate_temp(i.array, temp_count, false)
            if e2 != "" { return e2 }
            return ir_validate_temp(i.index, temp_count, false)
        }
        .SetIndexUnchecked(i) => {
            let e1 = ir_validate_temp(i.array, temp_count, false)
            if e1 != "" { return e1 }
            let e2 = ir_validate_temp(i.index, temp_count, false)
            if e2 != "" { return e2 }
            return ir_validate_temp(i.src, temp_count, false)
        }
        .MakeStruct(i) => {
            if i.name == "" { return "struct name is empty" }
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            let mut fields: [String] = []
            let mut f = 0
            while f < len(i.fields) {
                let fld = i.fields[f]
                if fld.name == "" { return "struct field name is empty" }
                if ir_string_list_contains(fields, fld.name) { return "duplicate struct field '" + fld.name + "'" }
                push(&mut fields, fld.name)
                let e = ir_validate_temp(fld.src, temp_count, false)
                if e != "" { return e }
                f = f + 1
            }
            return ""
        }
        .GetField(i) => {
            if i.field == "" { return "get_field name is empty" }
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            return ir_validate_temp(i.src, temp_count, false)
        }
        .SetField(i) => {
            if i.field == "" { return "set_field name is empty" }
            let err = ir_validate_temp(i.src, temp_count, false)
            if err != "" { return err }
            return ir_validate_temp(i.value, temp_count, false)
        }
        .MakeEnum(i) => {
            if i.name == "" || i.variant == "" { return "enum name or variant is empty" }
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            return ir_validate_temp(i.payload, temp_count, true)
        }
        .EnumTag(i) => {
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            return ir_validate_temp(i.src, temp_count, false)
        }
        .EnumPayload(i) => {
            let err = ir_validate_temp(i.dst, temp_count, false)
            if err != "" { return err }
            return ir_validate_temp(i.src, temp_count, false)
        }
    }
    return "unknown instruction"
}

fn ir_validate_block(blk: IrBlock, labels: [String], temp_count: i32, declared: [String]) -> String {
    let mut i = 0
    while i < len(blk.instrs) {
        let err = ir_validate_instr(blk.instrs[i], temp_count, declared)
        if err != "" { return err }
        i = i + 1
    }
    match blk.term {
        .None(_) => { return "block '" + blk.label + "' missing terminator" }
        .Jump(t) => {
            if t.target == "" { return "jump target is empty" }
            if !ir_string_list_contains(labels, t.target) { return "jump target '" + t.target + "' not found" }
        }
        .Branch(t) => {
            let err = ir_validate_temp(t.cond, temp_count, false)
            if err != "" { return err }
            if t.then_label == "" || t.else_label == "" { return "branch target is empty" }
            if !ir_string_list_contains(labels, t.then_label) { return "branch target '" + t.then_label + "' not found" }
            if !ir_string_list_contains(labels, t.else_label) { return "branch target '" + t.else_label + "' not found" }
        }
        IrTerm.Return(t) => {
            if t.has_value {
                let err = ir_validate_temp(t.value, temp_count, false)
                if err != "" { return err }
            }
        }
    }
    return ""
}

fn ir_validate_function(f: IrFunction) -> String {
    if f.temp_count < 0 { return "invalid temp_count " + int_to_string(f.temp_count) }
    if len(f.blocks) == 0 { return "function has no blocks" }
    let mut labels: [String] = []
    let mut declared: [String] = []
    let mut p = 0
    while p < len(f.params) {
        let name = f.params[p]
        if name == "" { return "param name is empty" }
        if ir_string_list_contains(declared, name) { return "duplicate param '" + name + "'" }
        push(&mut declared, name)
        p = p + 1
    }
    let mut bi = 0
    while bi < len(f.blocks) {
        let blk = f.blocks[bi]
        let mut ii = 0
        while ii < len(blk.instrs) {
            match blk.instrs[ii] {
                .StoreVar(sv) => {
                    if sv.name != "" && !ir_string_list_contains(declared, sv.name) {
                        push(&mut declared, sv.name)
                    }
                }
                _ => {}
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    let mut i = 0
    while i < len(f.blocks) {
        let label = f.blocks[i].label
        if label == "" { return "block label is empty" }
        if ir_string_list_contains(labels, label) { return "duplicate block label '" + label + "'" }
        push(&mut labels, label)
        i = i + 1
    }
    let mut b = 0
    while b < len(f.blocks) {
        let err = ir_validate_block(f.blocks[b], labels, f.temp_count, declared)
        if err != "" { return err }
        b = b + 1
    }
    let derr = ir_validate_def_assign(f)
    if derr != "" { return derr }
    return ""
}

fn ir_validate(p: IrProgram) -> String {
    let mut version = p.version
    if version == "" { version = "v0" }
    if version != "v0" { return "unsupported IR version '" + version + "'" }
    if len(p.features) > 0 { return "unsupported IR feature '" + p.features[0] + "'" }
    let mut names: [String] = []
    let mut i = 0
    while i < len(p.functions) {
        let f = p.functions[i]
        if f.name == "" { return "function name is empty" }
        if ir_string_list_contains(names, f.name) { return "duplicate function '" + f.name + "'" }
        push(&mut names, f.name)
        let err = ir_validate_function(f)
        if err != "" { return "function '" + f.name + "': " + err }
        i = i + 1
    }
    if p.entry != "" && !ir_string_list_contains(names, p.entry) {
        return "entry function '" + p.entry + "' not found"
    }
    return ""
}

struct IrStrSet {
    items: [String],
}

fn ir_strset_new() -> IrStrSet {
    return IrStrSet { items: ir_string_list_new() }
}

fn ir_strset_contains(set: IrStrSet, name: String) -> bool {
    return ir_string_list_contains(set.items, name)
}

fn ir_strset_add(set: &mut IrStrSet, name: String) {
    if name == "" { return }
    if !ir_string_list_contains(set.items, name) {
        let mut items = set.items
        push(&mut items, name)
        set.items = items
    }
}

fn ir_strset_copy(set: IrStrSet) -> IrStrSet {
    let mut items: [String] = ir_string_list_new()
    let mut i = 0
    while i < len(set.items) {
        push(&mut items, set.items[i])
        i = i + 1
    }
    return IrStrSet { items: items }
}

fn ir_strset_union(a: IrStrSet, b: IrStrSet) -> IrStrSet {
    let mut out = ir_strset_copy(a)
    let mut i = 0
    while i < len(b.items) {
        ir_strset_add(&mut out, b.items[i])
        i = i + 1
    }
    return out
}

fn ir_strset_intersect(a: IrStrSet, b: IrStrSet) -> IrStrSet {
    let mut out = ir_strset_new()
    let mut i = 0
    while i < len(a.items) {
        let name = a.items[i]
        if ir_string_list_contains(b.items, name) {
            ir_strset_add(&mut out, name)
        }
        i = i + 1
    }
    return out
}

fn ir_strset_equal(a: IrStrSet, b: IrStrSet) -> bool {
    if len(a.items) != len(b.items) { return false }
    let mut i = 0
    while i < len(a.items) {
        if !ir_string_list_contains(b.items, a.items[i]) { return false }
        i = i + 1
    }
    return true
}

fn ir_block_store_set(blk: IrBlock) -> IrStrSet {
    let mut out = ir_strset_new()
    let mut i = 0
    while i < len(blk.instrs) {
        match blk.instrs[i] {
            .StoreVar(sv) => { ir_strset_add(&mut out, sv.name) }
            _ => {}
        }
        i = i + 1
    }
    return out
}

fn ir_validate_def_assign(f: IrFunction) -> String {
    if len(f.blocks) == 0 { return "" }
    let reachable = ir_reachable_blocks(f.blocks)
    let mut params = ir_strset_new()
    let mut p = 0
    while p < len(f.params) {
        ir_strset_add(&mut params, f.params[p])
        p = p + 1
    }
    let mut stores: [IrStrSet] = []
    let mut i = 0
    while i < len(f.blocks) {
        push(&mut stores, ir_block_store_set(f.blocks[i]))
        i = i + 1
    }
    let mut all_vars = ir_strset_copy(params)
    let mut si = 0
    while si < len(stores) {
        all_vars = ir_strset_union(all_vars, stores[si])
        si = si + 1
    }
    let mut in_sets: [IrStrSet] = []
    let mut out_sets: [IrStrSet] = []
    let mut bi_init = 0
    while bi_init < len(f.blocks) {
        push(&mut in_sets, ir_strset_copy(all_vars))
        push(&mut out_sets, ir_strset_copy(all_vars))
        bi_init = bi_init + 1
    }
    let entry_label = f.blocks[0].label
    let mut changed = true
    while changed {
        changed = false
        let mut bi = 0
        while bi < len(f.blocks) {
            if reachable[bi] {
                let blk = f.blocks[bi]
                let mut in_set = ir_strset_new()
                if blk.label == entry_label {
                    in_set = ir_strset_copy(params)
                } else {
                    let mut first = true
                    let mut pj = 0
                    while pj < len(f.blocks) {
                        if reachable[pj] {
                            let pred = f.blocks[pj]
                            let mut is_pred = false
                            match pred.term {
                                .Jump(t) => { if t.target == blk.label { is_pred = true } }
                                .Branch(t) => {
                                    if t.then_label == blk.label || t.else_label == blk.label { is_pred = true }
                                }
                                _ => {}
                            }
                            if is_pred {
                                if first {
                                    in_set = ir_strset_copy(out_sets[pj])
                                    first = false
                                } else {
                                    in_set = ir_strset_intersect(in_set, out_sets[pj])
                                }
                            }
                        }
                        pj = pj + 1
                    }
                    if first {
                        in_set = ir_strset_new()
                    }
                }
                let out_set = ir_strset_union(in_set, stores[bi])
                if !ir_strset_equal(out_sets[bi], out_set) {
                    out_sets[bi] = out_set
                    changed = true
                }
                in_sets[bi] = in_set
            }
            bi = bi + 1
        }
    }
    let mut bi2 = 0
    while bi2 < len(f.blocks) {
        if reachable[bi2] {
            let blk = f.blocks[bi2]
            let mut cur = ir_strset_copy(in_sets[bi2])
            let mut ii = 0
            while ii < len(blk.instrs) {
                match blk.instrs[ii] {
                    .LoadVar(l) => {
                        if !ir_strset_contains(cur, l.name) {
                            return "use of possibly uninitialized variable '" + l.name + "'"
                        }
                    }
                    .AddrOf(a) => {
                        if !ir_strset_contains(cur, a.name) {
                            return "use of possibly uninitialized variable '" + a.name + "'"
                        }
                    }
                    .StoreVar(s) => { ir_strset_add(&mut cur, s.name) }
                    _ => {}
                }
                ii = ii + 1
            }
        }
        bi2 = bi2 + 1
    }
    return ""
}

struct IrFoldResult {
    ok: bool,
    value: IrValue,
}

struct IrConstMap {
    known: [bool],
    values: [IrValue],
}

struct IrVarConstMap {
    names: [String],
    values: [IrValue],
}

struct IrArraySafety {
    lens: [i32],
    safe: [bool],
}

fn ir_const_map_new(n: i32) -> IrConstMap {
    let mut known: [bool] = []
    let mut values: [IrValue] = []
    let mut i = 0
    while i < n {
        push(&mut known, false)
        push(&mut values, ir_value_unit())
        i = i + 1
    }
    return IrConstMap { known: known, values: values }
}

fn ir_varconst_new() -> IrVarConstMap {
    let mut names: [String] = []
    let mut values: [IrValue] = []
    return IrVarConstMap { names: names, values: values }
}

fn ir_varconst_index(map: IrVarConstMap, name: String) -> i32 {
    let mut i = 0
    while i < len(map.names) {
        if map.names[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn ir_varconst_has(map: IrVarConstMap, name: String) -> bool {
    return ir_varconst_index(map, name) >= 0
}

fn ir_varconst_get(map: IrVarConstMap, name: String) -> IrValue {
    let idx = ir_varconst_index(map, name)
    if idx < 0 { return ir_value_unit() }
    return map.values[idx]
}

fn ir_varconst_set(map: &mut IrVarConstMap, name: String, v: IrValue) {
    let idx = ir_varconst_index(*map, name)
    if idx >= 0 {
        let mut values = map.values
        values[idx] = v
        map.values = values
        return
    }
    let mut names = map.names
    let mut values = map.values
    push(&mut names, name)
    push(&mut values, v)
    map.names = names
    map.values = values
}

fn ir_varconst_clear(map: &mut IrVarConstMap, name: String) {
    let idx = ir_varconst_index(*map, name)
    if idx < 0 { return }
    let mut names = map.names
    let mut values = map.values
    names[idx] = ""
    values[idx] = ir_value_unit()
    map.names = names
    map.values = values
}

fn ir_varconst_clear_all(map: &mut IrVarConstMap) {
    let mut names: [String] = []
    let mut values: [IrValue] = []
    map.names = names
    map.values = values
}

fn ir_array_safety_new(temp_count: i32) -> IrArraySafety {
    let mut lens: [i32] = []
    let mut safe: [bool] = []
    let mut i = 0
    while i < temp_count {
        push(&mut lens, 0)
        push(&mut safe, false)
        i = i + 1
    }
    return IrArraySafety { lens: lens, safe: safe }
}

fn ir_scan_array_safety(blk: IrBlock, temp_count: i32) -> IrArraySafety {
    let mut out = ir_array_safety_new(temp_count)
    let mut i = 0
    while i < len(blk.instrs) {
        match blk.instrs[i] {
            .MakeArray(mk) => {
                let mut lens = out.lens
                let mut safe = out.safe
                lens[mk.dst] = len(mk.elems)
                safe[mk.dst] = true
                out.lens = lens
                out.safe = safe
            }
            _ => {}
        }
        i = i + 1
    }
    let mut j = 0
    while j < len(blk.instrs) {
        let inst = blk.instrs[j]
        match inst {
            .MakeArray(_) => {}
            IrInstr.Index(_) => {}
            .SetIndex(_) => {}
            .IndexUnchecked(_) => {}
            .SetIndexUnchecked(_) => {}
            _ => {
                let temps = ir_instr_temps(inst)
                let mut k = 0
                while k < len(temps) {
                    let t = temps[k]
                    if t >= 0 && t < len(out.safe) {
                        if out.safe[t] {
                            let mut safe = out.safe
                            safe[t] = false
                            out.safe = safe
                        }
                    }
                    k = k + 1
                }
            }
        }
        j = j + 1
    }
    return out
}

fn ir_instr_temps(inst: IrInstr) -> [i32] {
    let mut out: [i32] = []
    match inst {
        IrInstr.Const(i) => { push(&mut out, i.dst) }
        .LoadVar(i) => { push(&mut out, i.dst) }
        .StoreVar(i) => { push(&mut out, i.src) }
        .AddrOf(i) => { push(&mut out, i.dst) }
        .LoadRef(i) => { push(&mut out, i.dst); push(&mut out, i.src) }
        .StoreRef(i) => { push(&mut out, i.ref); push(&mut out, i.src) }
        .BinOp(i) => { push(&mut out, i.dst); push(&mut out, i.lhs); push(&mut out, i.rhs) }
        .UnaryOp(i) => { push(&mut out, i.dst); push(&mut out, i.src) }
        IrInstr.Call(i) => {
            if i.dst >= 0 { push(&mut out, i.dst) }
            let mut j = 0
            while j < len(i.args) {
                push(&mut out, i.args[j])
                j = j + 1
            }
        }
        .MakeArray(i) => {
            push(&mut out, i.dst)
            let mut j = 0
            while j < len(i.elems) {
                push(&mut out, i.elems[j])
                j = j + 1
            }
        }
        IrInstr.Index(i) => { push(&mut out, i.dst); push(&mut out, i.array); push(&mut out, i.index) }
        .SetIndex(i) => { push(&mut out, i.array); push(&mut out, i.index); push(&mut out, i.src) }
        .IndexUnchecked(i) => { push(&mut out, i.dst); push(&mut out, i.array); push(&mut out, i.index) }
        .SetIndexUnchecked(i) => { push(&mut out, i.array); push(&mut out, i.index); push(&mut out, i.src) }
        .MakeStruct(i) => {
            push(&mut out, i.dst)
            let mut j = 0
            while j < len(i.fields) {
                push(&mut out, i.fields[j].src)
                j = j + 1
            }
        }
        .GetField(i) => { push(&mut out, i.dst); push(&mut out, i.src) }
        .SetField(i) => { push(&mut out, i.src); push(&mut out, i.value) }
        .MakeEnum(i) => {
            push(&mut out, i.dst)
            if i.payload >= 0 { push(&mut out, i.payload) }
        }
        .EnumTag(i) => { push(&mut out, i.dst); push(&mut out, i.src) }
        .EnumPayload(i) => { push(&mut out, i.dst); push(&mut out, i.src) }
    }
    return out
}

fn ir_const_map_has(map: &IrConstMap, idx: i32) -> bool {
    if idx < 0 { return false }
    if idx >= len(map.known) { return false }
    return map.known[idx]
}

fn ir_const_map_get(map: &IrConstMap, idx: i32) -> IrValue {
    return map.values[idx]
}

fn ir_const_map_set(map: &mut IrConstMap, idx: i32, v: IrValue) {
    if idx < 0 { return }
    if idx >= len(map.known) { return }
    let mut known = map.known
    let mut values = map.values
    known[idx] = true
    values[idx] = v
    map.known = known
    map.values = values
}

fn ir_const_map_clear(map: &mut IrConstMap, idx: i32) {
    if idx < 0 { return }
    if idx >= len(map.known) { return }
    let mut known = map.known
    known[idx] = false
    map.known = known
}

fn ir_fold_unary(op: String, v: IrValue) -> IrFoldResult {
    if op == "-" && v.kind == ir_kind_int() {
        return IrFoldResult { ok: true, value: ir_value_int_t(-v.int, v.int_type) }
    }
    if op == "!" && v.kind == ir_kind_bool() {
        return IrFoldResult { ok: true, value: ir_value_bool(!v.bool) }
    }
    return IrFoldResult { ok: false, value: ir_value_unit() }
}

fn ir_fold_binary(op: String, a: IrValue, b: IrValue) -> IrFoldResult {
    if op == "+" {
        if a.kind == ir_kind_int() && b.kind == ir_kind_int() {
            return IrFoldResult { ok: true, value: ir_value_int_t(a.int + b.int, ir_pick_int_type(a, b)) }
        }
        if a.kind == ir_kind_string() && b.kind == ir_kind_string() {
            return IrFoldResult { ok: true, value: ir_value_string(a.str + b.str) }
        }
    }
    if op == "-" && a.kind == ir_kind_int() && b.kind == ir_kind_int() {
        return IrFoldResult { ok: true, value: ir_value_int_t(a.int - b.int, ir_pick_int_type(a, b)) }
    }
    if op == "*" && a.kind == ir_kind_int() && b.kind == ir_kind_int() {
        return IrFoldResult { ok: true, value: ir_value_int_t(a.int * b.int, ir_pick_int_type(a, b)) }
    }
    if op == "/" && a.kind == ir_kind_int() && b.kind == ir_kind_int() && b.int != 0 {
        return IrFoldResult { ok: true, value: ir_value_int_t(a.int / b.int, ir_pick_int_type(a, b)) }
    }
    if op == "%" && a.kind == ir_kind_int() && b.kind == ir_kind_int() && b.int != 0 {
        return IrFoldResult { ok: true, value: ir_value_int_t(a.int % b.int, ir_pick_int_type(a, b)) }
    }
    if op == "==" {
        if a.kind == ir_kind_int() && b.kind == ir_kind_int() {
            return IrFoldResult { ok: true, value: ir_value_bool(a.int == b.int) }
        }
        if a.kind == ir_kind_bool() && b.kind == ir_kind_bool() {
            return IrFoldResult { ok: true, value: ir_value_bool(a.bool == b.bool) }
        }
        if a.kind == ir_kind_string() && b.kind == ir_kind_string() {
            return IrFoldResult { ok: true, value: ir_value_bool(a.str == b.str) }
        }
    }
    if op == "!=" {
        if a.kind == ir_kind_int() && b.kind == ir_kind_int() {
            return IrFoldResult { ok: true, value: ir_value_bool(a.int != b.int) }
        }
        if a.kind == ir_kind_bool() && b.kind == ir_kind_bool() {
            return IrFoldResult { ok: true, value: ir_value_bool(a.bool != b.bool) }
        }
        if a.kind == ir_kind_string() && b.kind == ir_kind_string() {
            return IrFoldResult { ok: true, value: ir_value_bool(a.str != b.str) }
        }
    }
    if op == "<" && a.kind == ir_kind_int() && b.kind == ir_kind_int() {
        return IrFoldResult { ok: true, value: ir_value_bool(a.int < b.int) }
    }
    if op == "<=" && a.kind == ir_kind_int() && b.kind == ir_kind_int() {
        return IrFoldResult { ok: true, value: ir_value_bool(a.int <= b.int) }
    }
    if op == ">" && a.kind == ir_kind_int() && b.kind == ir_kind_int() {
        return IrFoldResult { ok: true, value: ir_value_bool(a.int > b.int) }
    }
    if op == ">=" && a.kind == ir_kind_int() && b.kind == ir_kind_int() {
        return IrFoldResult { ok: true, value: ir_value_bool(a.int >= b.int) }
    }
    if op == "&&" && a.kind == ir_kind_bool() && b.kind == ir_kind_bool() {
        return IrFoldResult { ok: true, value: ir_value_bool(a.bool && b.bool) }
    }
    if op == "||" && a.kind == ir_kind_bool() && b.kind == ir_kind_bool() {
        return IrFoldResult { ok: true, value: ir_value_bool(a.bool || b.bool) }
    }
    return IrFoldResult { ok: false, value: ir_value_unit() }
}

fn ir_pick_int_type(a: IrValue, b: IrValue) -> String {
    if a.int_type != "" { return a.int_type }
    if b.int_type != "" { return b.int_type }
    return ""
}

fn ir_fold_block(blk: IrBlock, temp_count: i32) -> IrBlock {
    let mut consts = ir_const_map_new(temp_count)
    let mut var_consts = ir_varconst_new()
    let safety = ir_scan_array_safety(blk, temp_count)
    let mut instrs: [IrInstr] = []
    let mut i = 0
    while i < len(blk.instrs) {
        let inst = blk.instrs[i]
        match inst {
            IrInstr.Const(c) => {
                push(&mut instrs, inst)
                ir_const_map_set(&mut consts, c.dst, c.value)
            }
            .LoadVar(c) => {
                if ir_varconst_has(var_consts, c.name) {
                    let v = ir_varconst_get(var_consts, c.name)
                    let ni = IrInstr.Const(IrConst { dst: c.dst, value: v })
                    push(&mut instrs, ni)
                    ir_const_map_set(&mut consts, c.dst, v)
                } else {
                    push(&mut instrs, inst)
                    ir_const_map_clear(&mut consts, c.dst)
                }
            }
            .StoreVar(c) => {
                push(&mut instrs, inst)
                if ir_const_map_has(&consts, c.src) {
                    let v = ir_const_map_get(&consts, c.src)
                    ir_varconst_set(&mut var_consts, c.name, v)
                } else {
                    ir_varconst_clear(&mut var_consts, c.name)
                }
            }
            .AddrOf(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
                ir_varconst_clear(&mut var_consts, c.name)
            }
            .LoadRef(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
            }
            .StoreRef(_) => {
                push(&mut instrs, inst)
                ir_varconst_clear_all(&mut var_consts)
            }
            .UnaryOp(c) => {
                let mut folded = false
                if ir_const_map_has(&consts, c.src) {
                    let v = ir_const_map_get(&consts, c.src)
                    let res = ir_fold_unary(c.op, v)
                    if res.ok {
                        let ni = IrInstr.Const(IrConst { dst: c.dst, value: res.value })
                        push(&mut instrs, ni)
                        ir_const_map_set(&mut consts, c.dst, res.value)
                        folded = true
                    }
                }
                if !folded {
                    push(&mut instrs, inst)
                    ir_const_map_clear(&mut consts, c.dst)
                }
            }
            .BinOp(c) => {
                let mut folded = false
                if ir_const_map_has(&consts, c.lhs) && ir_const_map_has(&consts, c.rhs) {
                    let l = ir_const_map_get(&consts, c.lhs)
                    let r = ir_const_map_get(&consts, c.rhs)
                    let res = ir_fold_binary(c.op, l, r)
                    if res.ok {
                        let ni = IrInstr.Const(IrConst { dst: c.dst, value: res.value })
                        push(&mut instrs, ni)
                        ir_const_map_set(&mut consts, c.dst, res.value)
                        folded = true
                    }
                }
                if !folded {
                    push(&mut instrs, inst)
                    ir_const_map_clear(&mut consts, c.dst)
                }
            }
            IrInstr.Call(c) => {
                push(&mut instrs, inst)
                if c.dst >= 0 {
                    ir_const_map_clear(&mut consts, c.dst)
                }
                ir_varconst_clear_all(&mut var_consts)
            }
            .MakeArray(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
            }
            IrInstr.Index(c) => {
                let mut replaced = false
                if ir_const_map_has(&consts, c.index) {
                    let idx = ir_const_map_get(&consts, c.index)
                    if idx.kind == ir_kind_int() && c.array >= 0 && c.array < len(safety.safe) {
                        if safety.safe[c.array] {
                            if idx.int >= 0 && idx.int < safety.lens[c.array] {
                                let ni = IrInstr.IndexUnchecked(IrIndexUnchecked { dst: c.dst, array: c.array, index: c.index })
                                push(&mut instrs, ni)
                                replaced = true
                            }
                        }
                    }
                }
                if !replaced { push(&mut instrs, inst) }
                ir_const_map_clear(&mut consts, c.dst)
            }
            .SetIndex(c) => {
                let mut replaced = false
                if ir_const_map_has(&consts, c.index) {
                    let idx = ir_const_map_get(&consts, c.index)
                    if idx.kind == ir_kind_int() && c.array >= 0 && c.array < len(safety.safe) {
                        if safety.safe[c.array] {
                            if idx.int >= 0 && idx.int < safety.lens[c.array] {
                                let ni = IrInstr.SetIndexUnchecked(IrSetIndexUnchecked { array: c.array, index: c.index, src: c.src })
                                push(&mut instrs, ni)
                                replaced = true
                            }
                        }
                    }
                }
                if !replaced { push(&mut instrs, inst) }
            }
            .IndexUnchecked(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
            }
            .SetIndexUnchecked(_) => {
                push(&mut instrs, inst)
            }
            .MakeStruct(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
            }
            .GetField(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
            }
            .SetField(c) => {
                push(&mut instrs, inst)
            }
            .MakeEnum(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
            }
            .EnumTag(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
            }
            .EnumPayload(c) => {
                push(&mut instrs, inst)
                ir_const_map_clear(&mut consts, c.dst)
            }
        }
        i = i + 1
    }
    let mut term = blk.term
    match blk.term {
        .Branch(t) => {
            if ir_const_map_has(&consts, t.cond) {
                let v = ir_const_map_get(&consts, t.cond)
                if v.kind == ir_kind_bool() {
                    let mut target = t.then_label
                    if !v.bool {
                        target = t.else_label
                    }
                    term = IrTerm.Jump(IrJump { target: target })
                }
            }
        }
        _ => {}
    }
    return IrBlock { label: blk.label, instrs: instrs, term: term }
}

fn ir_find_block_index(blocks: [IrBlock], label: String) -> i32 {
    let mut i = 0
    while i < len(blocks) {
        if blocks[i].label == label { return i }
        i = i + 1
    }
    return -1
}

fn ir_reachable_blocks(blocks: [IrBlock]) -> [bool] {
    let mut marks: [bool] = []
    let mut i = 0
    while i < len(blocks) {
        push(&mut marks, false)
        i = i + 1
    }
    if len(blocks) == 0 { return marks }
    let mut work: [String] = []
    push(&mut work, blocks[0].label)
    while len(work) > 0 {
        let label = pop(&mut work)
        let idx = ir_find_block_index(blocks, label)
        if idx < 0 { }
        else if !marks[idx] {
            marks[idx] = true
            match blocks[idx].term {
                .Jump(t) => { push(&mut work, t.target) }
                .Branch(t) => {
                    push(&mut work, t.then_label)
                    push(&mut work, t.else_label)
                }
                _ => {}
            }
        }
    }
    return marks
}

struct IrInlineCandidate {
    valid: bool,
    name: String,
    func: IrFunction,
    has_ret: bool,
    ret_temp: i32,
}

struct IrInlineResult {
    instrs: [IrInstr],
    next_temp: i32,
}

fn ir_inline_candidate(f: IrFunction) -> IrInlineCandidate {
    if len(f.blocks) != 1 { return IrInlineCandidate { valid: false, name: "", func: f, has_ret: false, ret_temp: -1 } }
    let blk = f.blocks[0]
    let mut has_call = false
    let mut i = 0
    while i < len(blk.instrs) {
        match blk.instrs[i] {
            IrInstr.Call(_) => { has_call = true }
            _ => {}
        }
        i = i + 1
    }
    if has_call { return IrInlineCandidate { valid: false, name: "", func: f, has_ret: false, ret_temp: -1 } }
    match blk.term {
        IrTerm.Return(t) => {
            if t.has_value {
                return IrInlineCandidate { valid: true, name: f.name, func: f, has_ret: true, ret_temp: t.value }
            }
            return IrInlineCandidate { valid: true, name: f.name, func: f, has_ret: false, ret_temp: -1 }
        }
        _ => {}
    }
    return IrInlineCandidate { valid: false, name: "", func: f, has_ret: false, ret_temp: -1 }
}

fn ir_collect_inline_candidates(p: IrProgram) -> [IrInlineCandidate] {
    let mut out: [IrInlineCandidate] = []
    let mut i = 0
    while i < len(p.functions) {
        let cand = ir_inline_candidate(p.functions[i])
        if cand.valid { push(&mut out, cand) }
        i = i + 1
    }
    return out
}

fn ir_find_inline(cands: [IrInlineCandidate], name: String) -> IrInlineCandidate {
    let mut i = 0
    while i < len(cands) {
        if cands[i].name == name {
            return cands[i]
        }
        i = i + 1
    }
    return IrInlineCandidate { valid: false, name: "", func: IrFunction { name: "", params: string_list_new(), param_types: string_list_new(), return_type: "", blocks: ir_block_list_new(), temp_count: 0 }, has_ret: false, ret_temp: -1 }
}

fn ir_inline_program(p: IrProgram) -> IrProgram {
    let cands = ir_collect_inline_candidates(p)
    let mut funcs: [IrFunction] = []
    let mut i = 0
    while i < len(p.functions) {
        push(&mut funcs, ir_inline_function(p.functions[i], cands))
        i = i + 1
    }
    return IrProgram { version: p.version, features: p.features, functions: funcs, entry: p.entry }
}

fn ir_inline_function(f: IrFunction, cands: [IrInlineCandidate]) -> IrFunction {
    let mut blocks: [IrBlock] = []
    let mut next_temp = f.temp_count
    let mut inline_id = 0
    let mut b = 0
    while b < len(f.blocks) {
        let blk = f.blocks[b]
        let mut instrs: [IrInstr] = []
        let mut i = 0
        while i < len(blk.instrs) {
            match blk.instrs[i] {
                IrInstr.Call(c) => {
                    let cand = ir_find_inline(cands, c.callee)
                    if cand.valid && cand.name != f.name {
                        let res = ir_inline_call(c, cand, next_temp, inline_id)
                        instrs = ir_instr_list_concat(instrs, res.instrs)
                        next_temp = res.next_temp
                        inline_id = inline_id + 1
                    } else {
                        push(&mut instrs, blk.instrs[i])
                    }
                }
                _ => { push(&mut instrs, blk.instrs[i]) }
            }
            i = i + 1
        }
        push(&mut blocks, IrBlock { label: blk.label, instrs: instrs, term: blk.term })
        b = b + 1
    }
    return IrFunction { name: f.name, params: f.params, param_types: f.param_types, return_type: f.return_type, blocks: blocks, temp_count: next_temp }
}

fn ir_instr_list_concat(a: [IrInstr], b: [IrInstr]) -> [IrInstr] {
    let mut out: [IrInstr] = []
    let mut i = 0
    while i < len(a) {
        push(&mut out, a[i])
        i = i + 1
    }
    let mut j = 0
    while j < len(b) {
        push(&mut out, b[j])
        j = j + 1
    }
    return out
}

fn ir_inline_call(call: IrCall, cand: IrInlineCandidate, next_temp: i32, inline_id: i32) -> IrInlineResult {
    let mut temp_map: [i32] = []
    let mut t = 0
    while t < cand.func.temp_count {
        push(&mut temp_map, -1)
        t = t + 1
    }
    let mut cur = next_temp
    let mut ti = 0
    while ti < cand.func.temp_count {
        if cand.has_ret && call.dst >= 0 && ti == cand.ret_temp {
            temp_map[ti] = call.dst
        } else {
            temp_map[ti] = cur
            cur = cur + 1
        }
        ti = ti + 1
    }
    let mut var_names: [String] = []
    let mut var_vals: [String] = []
    let prefix = "_inl" + int_to_string(inline_id) + "_"
    let mut out: [IrInstr] = []
    let mut p = 0
    while p < len(cand.func.params) {
        if p < len(call.args) {
            let new_name = ir_inline_map_var(cand.func.params[p], &mut var_names, &mut var_vals, prefix)
            push(&mut out, IrInstr.StoreVar(IrStoreVar { name: new_name, src: call.args[p] }))
        }
        p = p + 1
    }
    let blk = cand.func.blocks[0]
    let mut i = 0
    while i < len(blk.instrs) {
        let inst = blk.instrs[i]
        push(&mut out, ir_inline_remap_instr(inst, temp_map, &mut var_names, &mut var_vals, prefix))
        i = i + 1
    }
    if !cand.has_ret && call.dst >= 0 {
        push(&mut out, IrInstr.Const(IrConst { dst: call.dst, value: ir_value_unit() }))
    }
    return IrInlineResult { instrs: out, next_temp: cur }
}

fn ir_inline_map_var(name: String, names: &mut [String], vals: &mut [String], prefix: String) -> String {
    let mut i = 0
    while i < len(*names) {
        if (*names)[i] == name {
            return (*vals)[i]
        }
        i = i + 1
    }
    let mapped = prefix + name
    push(names, name)
    push(vals, mapped)
    return mapped
}

fn ir_inline_remap_temp(map: [i32], idx: i32) -> i32 {
    if idx < 0 { return idx }
    if idx >= len(map) { return idx }
    return map[idx]
}

fn ir_inline_remap_instr(inst: IrInstr, temp_map: [i32], names: &mut [String], vals: &mut [String], prefix: String) -> IrInstr {
    match inst {
        IrInstr.Const(i) => {
            return IrInstr.Const(IrConst { dst: ir_inline_remap_temp(temp_map, i.dst), value: i.value })
        }
        .LoadVar(i) => {
            let nm = ir_inline_map_var(i.name, names, vals, prefix)
            return IrInstr.LoadVar(IrLoadVar { dst: ir_inline_remap_temp(temp_map, i.dst), name: nm })
        }
        .StoreVar(i) => {
            let nm = ir_inline_map_var(i.name, names, vals, prefix)
            return IrInstr.StoreVar(IrStoreVar { name: nm, src: ir_inline_remap_temp(temp_map, i.src) })
        }
        .AddrOf(i) => {
            let nm = ir_inline_map_var(i.name, names, vals, prefix)
            return IrInstr.AddrOf(IrAddrOf { dst: ir_inline_remap_temp(temp_map, i.dst), name: nm })
        }
        .LoadRef(i) => {
            return IrInstr.LoadRef(IrLoadRef { dst: ir_inline_remap_temp(temp_map, i.dst), src: ir_inline_remap_temp(temp_map, i.src) })
        }
        .StoreRef(i) => {
            return IrInstr.StoreRef(IrStoreRef { ref: ir_inline_remap_temp(temp_map, i.ref), src: ir_inline_remap_temp(temp_map, i.src) })
        }
        .BinOp(i) => {
            return IrInstr.BinOp(IrBinOp { dst: ir_inline_remap_temp(temp_map, i.dst), op: i.op, lhs: ir_inline_remap_temp(temp_map, i.lhs), rhs: ir_inline_remap_temp(temp_map, i.rhs) })
        }
        .UnaryOp(i) => {
            return IrInstr.UnaryOp(IrUnaryOp { dst: ir_inline_remap_temp(temp_map, i.dst), op: i.op, src: ir_inline_remap_temp(temp_map, i.src) })
        }
        IrInstr.Call(i) => {
            let mut args: [i32] = []
            let mut j = 0
            while j < len(i.args) {
                push(&mut args, ir_inline_remap_temp(temp_map, i.args[j]))
                j = j + 1
            }
            return IrInstr.Call(IrCall { dst: ir_inline_remap_temp(temp_map, i.dst), callee: i.callee, args: args })
        }
        .MakeArray(i) => {
            let mut elems: [i32] = []
            let mut j = 0
            while j < len(i.elems) {
                push(&mut elems, ir_inline_remap_temp(temp_map, i.elems[j]))
                j = j + 1
            }
            return IrInstr.MakeArray(IrMakeArray { dst: ir_inline_remap_temp(temp_map, i.dst), elems: elems })
        }
        IrInstr.Index(i) => {
            return IrInstr.Index(IrIndex { dst: ir_inline_remap_temp(temp_map, i.dst), array: ir_inline_remap_temp(temp_map, i.array), index: ir_inline_remap_temp(temp_map, i.index) })
        }
        .SetIndex(i) => {
            return IrInstr.SetIndex(IrSetIndex { array: ir_inline_remap_temp(temp_map, i.array), index: ir_inline_remap_temp(temp_map, i.index), src: ir_inline_remap_temp(temp_map, i.src) })
        }
        .IndexUnchecked(i) => {
            return IrInstr.IndexUnchecked(IrIndexUnchecked { dst: ir_inline_remap_temp(temp_map, i.dst), array: ir_inline_remap_temp(temp_map, i.array), index: ir_inline_remap_temp(temp_map, i.index) })
        }
        .SetIndexUnchecked(i) => {
            return IrInstr.SetIndexUnchecked(IrSetIndexUnchecked { array: ir_inline_remap_temp(temp_map, i.array), index: ir_inline_remap_temp(temp_map, i.index), src: ir_inline_remap_temp(temp_map, i.src) })
        }
        .MakeStruct(i) => {
            let mut fields: [IrStructFieldInit] = []
            let mut j = 0
            while j < len(i.fields) {
                let f = i.fields[j]
                push(&mut fields, IrStructFieldInit { name: f.name, src: ir_inline_remap_temp(temp_map, f.src) })
                j = j + 1
            }
            return IrInstr.MakeStruct(IrMakeStruct { dst: ir_inline_remap_temp(temp_map, i.dst), name: i.name, fields: fields })
        }
        .GetField(i) => {
            return IrInstr.GetField(IrGetField { dst: ir_inline_remap_temp(temp_map, i.dst), src: ir_inline_remap_temp(temp_map, i.src), field: i.field })
        }
        .SetField(i) => {
            return IrInstr.SetField(IrSetField { src: ir_inline_remap_temp(temp_map, i.src), field: i.field, value: ir_inline_remap_temp(temp_map, i.value) })
        }
        .MakeEnum(i) => {
            return IrInstr.MakeEnum(IrMakeEnum { dst: ir_inline_remap_temp(temp_map, i.dst), name: i.name, variant: i.variant, tag: i.tag, tag_type: i.tag_type, payload: ir_inline_remap_temp(temp_map, i.payload) })
        }
        .EnumTag(i) => {
            return IrInstr.EnumTag(IrEnumTag { dst: ir_inline_remap_temp(temp_map, i.dst), src: ir_inline_remap_temp(temp_map, i.src) })
        }
        .EnumPayload(i) => {
            return IrInstr.EnumPayload(IrEnumPayload { dst: ir_inline_remap_temp(temp_map, i.dst), src: ir_inline_remap_temp(temp_map, i.src) })
        }
    }
    return inst
}

fn ir_opt_function(f: IrFunction) -> IrFunction {
    let mut blocks: [IrBlock] = []
    let mut i = 0
    while i < len(f.blocks) {
        push(&mut blocks, ir_fold_block(f.blocks[i], f.temp_count))
        i = i + 1
    }
    let marks = ir_reachable_blocks(blocks)
    let mut out_blocks: [IrBlock] = []
    let mut j = 0
    while j < len(blocks) {
        if marks[j] { push(&mut out_blocks, blocks[j]) }
        j = j + 1
    }
    return IrFunction { name: f.name, params: f.params, param_types: f.param_types, return_type: f.return_type, blocks: out_blocks, temp_count: f.temp_count }
}

fn ir_opt_program(p: IrProgram) -> IrProgram {
    let inlined = ir_inline_program(p)
    let mut funcs: [IrFunction] = []
    let mut i = 0
    while i < len(inlined.functions) {
        push(&mut funcs, ir_opt_function(inlined.functions[i]))
        i = i + 1
    }
    return IrProgram { version: inlined.version, features: inlined.features, functions: funcs, entry: inlined.entry }
}
