// Option type - represents an optional value
// Intrinsic methods provided by runtime

pub enum Option[T] {
    Some(T),
    None,
}

impl[T] Option[T] {
    pub fn is_some(self: &Self) -> bool {
        match *self {
            .Some(_) => { return true }
            .None(_) => { return false }
        }
    }

    pub fn is_none(self: &Self) -> bool {
        match *self {
            .Some(_) => { return false }
            .None(_) => { return true }
        }
    }

    pub fn unwrap(self: Self) -> T {
        match self {
            .Some(v) => { return v }
            .None(_) => {
                // Runtime panic - intrinsic
                panic("called unwrap on None")
            }
        }
    }

    pub fn unwrap_or(self: Self, default: T) -> T {
        match self {
            .Some(v) => { return v }
            .None(_) => { return default }
        }
    }
}
