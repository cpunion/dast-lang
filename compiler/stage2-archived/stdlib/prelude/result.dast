// Result type - represents success or failure
// Intrinsic methods provided by runtime

pub enum Result[T, E] {
    Ok(T),
    Err(E),
}

impl[T, E] Result[T, E] {
    pub fn is_ok(self: &Self) -> bool {
        match *self {
            .Ok(_) => { return true }
            .Err(_) => { return false }
        }
    }

    pub fn is_err(self: &Self) -> bool {
        match *self {
            .Ok(_) => { return false }
            .Err(_) => { return true }
        }
    }

    pub fn unwrap(self: Self) -> T {
        match self {
            .Ok(v) => { return v }
            .Err(_) => {
                // Runtime panic - intrinsic
                panic("called unwrap on Err")
            }
        }
    }

    pub fn unwrap_err(self: Self) -> E {
        match self {
            .Ok(_) => {
                panic("called unwrap_err on Ok")
            }
            .Err(e) => { return e }
        }
    }

    pub fn ok(self: Self) -> Option[T] {
        match self {
            .Ok(v) => { return .Some(v) }
            .Err(_) => { return .None }
        }
    }

    pub fn err(self: Self) -> Option[E] {
        match self {
            .Ok(_) => { return .None }
            .Err(e) => { return .Some(e) }
        }
    }
}
