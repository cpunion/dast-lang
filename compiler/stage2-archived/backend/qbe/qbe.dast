                if len(types) > 1 {
                    let mut pt = qbe_operand_def_type(&i.value, &ctx.infer)
                    if pt == "" && len(types) > 0 { pt = types[0] }
                    field_name = cg_env_field_name(i.field, string_clone(&pt), &ctx.env_field_types)
                    ft = pt
                } else {
                    field_name = cg_mangle_ident(i.field)
                }
            } else if !is_enum {
                field_name = cg_mangle_ident(i.field)
            }
            let field = qbe_layout_field(&layout, &field_name)
            let mut field_ptr = string_clone(&recv)
            if field.offset != 0 {
                let t = qbe_new_temp(e)
                push(&mut out, qbe_temp_name_raw(t) + " =l add " + recv + ", " + int_to_string(field.offset))
                field_ptr = qbe_temp_name_raw(t)
            }
            let val_cast = qbe_cast_operand(e, ctx, &i.value, string_clone(&ft))
            let mut k = 0
            while k < len(val_cast.lines) { push(&mut out, val_cast.lines[k]); k = k + 1 }
            let q = qbe_type(ft, &ctx.enum_names,  &ctx.struct_fields)
            push(&mut out, "store" + q + " " + val_cast.expr + ", " + field_ptr)
            return out
        }
    }
    return qbe_string_list_new()
}

fn qbe_emit_term(e: &mut QbeEmitter, ctx: &QbeFuncCtx, ret_type: String, term: IrTerm) -> [String] {
    qbe_prof_inc(e, "qbe.qbe_emit_term")
    match term {
        IrTerm.None(_) => {
            let mut out: [String] = []
            return out
        }
        IrTerm.Jump(t) => {
            let mut out: [String] = []
            push(&mut out, "jmp @" + qbe_mangle_label(t.target))
            return out
        }
        IrTerm.Branch(t) => {
            let mut out: [String] = []
            let cond_cast = qbe_cast_operand(e, ctx, &t.cond, "bool")
            let mut k = 0
            while k < len(cond_cast.lines) { push(&mut out, cond_cast.lines[k]); k = k + 1 }
            push(&mut out, "jnz " + cond_cast.expr + ", @" + qbe_mangle_label(t.then_label) + ", @" + qbe_mangle_label(t.else_label))
            return out
        }
        IrTerm.Return(t) => {
            let mut out: [String] = []
            if !t.has_value {
                push(&mut out, "ret")
            } else {
                let ret_cast = qbe_cast_operand(e, ctx, &t.value, ret_type)
                let mut k = 0
                while k < len(ret_cast.lines) { push(&mut out, ret_cast.lines[k]); k = k + 1 }
                push(&mut out, "ret " + ret_cast.expr)
            }
            return out
        }
        _ => {
            let mut out: [String] = []
            push(&mut out, "ret")
            return out
        }
    }
    return qbe_string_list_new()
}

fn qbe_emit_function(e: &mut QbeEmitter, base_ctx: &QbeFuncCtx, f: IrFunction) -> String {
    qbe_prof_inc(e, "qbe.qbe_emit_function")
    let infer = cg_infer_function_types(base_ctx.prog, &f, &base_ctx.field_types, &base_ctx.struct_fields, &base_ctx.enum_names, &base_ctx.enum_tag_payloads)
    let ctx = QbeFuncCtx {
        prog: base_ctx.prog,
        infer: infer,
        field_types: base_ctx.field_types,
        struct_fields: base_ctx.struct_fields,
        env_field_types: base_ctx.env_field_types,
        enum_names: base_ctx.enum_names,
        enum_tag_payloads: base_ctx.enum_tag_payloads,
        layouts: base_ctx.layouts,
        inst_map: base_ctx.inst_map,
        closure_funcs: base_ctx.closure_funcs,
    }
    let param_count = len(f.params)
    // Temps are not SSA; keep a per-function rename map and start after known temps.
    qbe_temp_reset(e, param_count)
    let mut start_temp = f.temp_count
    let infer_count = len(ctx.infer.temp_types)
    if infer_count > start_temp { start_temp = infer_count }
    if param_count > start_temp { start_temp = param_count }
    e.temp_id = start_temp

    let mut out = ""
    let ret_q = qbe_type(string_clone(&f.return_type), &ctx.enum_names,  &ctx.struct_fields)
    out = out + "export function " + ret_q + " $" + qbe_mangle_func(f.name) + "("
    let mut params = ""
    let mut i = 0
    while i < len(f.params) {
        if i > 0 { params = params + ", " }
        let mut pt = ""
        if i < len(f.param_types) { pt = f.param_types[i] }
        if pt == "" && i < len(ctx.infer.temp_types) { pt = ctx.infer.temp_types[i] }
        let pq = qbe_type(pt, &ctx.enum_names,  &ctx.struct_fields)
        params = params + pq + " %t" + int_to_string(i)
        i = i + 1
    }
    out = out + params + ") {\n"

    out = out + "@entry\n"
    let vars = qbe_collect_vars(&f)
    let mut vi = 0
    while vi < len(vars) {
        let name = vars[vi]
        let mut vt = string_map_get(&ctx.infer.var_types, &name)
        if vt == "" { vt = "int" }
        let q = qbe_type(string_clone(&vt), &ctx.enum_names,  &ctx.struct_fields)
        let size = qbe_type_size(vt, &ctx.enum_names,  &ctx.struct_fields)
        out = out + "  %" + qbe_var_slot(name) + " =l " + qbe_make_alloc(size, q) + "\n"
        vi = vi + 1
    }
    i = 0
    while i < len(f.params) {
        let name = f.params[i]
        if !cg_string_list_contains(&vars, string_clone(&name)) { i = i + 1; continue }
        let mut pt = ""
        if i < len(f.param_types) { pt = f.param_types[i] }
        if pt == "" && i < len(ctx.infer.temp_types) { pt = ctx.infer.temp_types[i] }
        if pt == "" { pt = "int" }
        let pq = qbe_type(pt, &ctx.enum_names,  &ctx.struct_fields)
        out = out + "  store" + pq + " %t" + int_to_string(i) + ", %" + qbe_var_slot(name) + "\n"
        i = i + 1
    }
    out = out + "\n"

    let mut b = 0
    while b < len(f.blocks) {
        let blk = f.blocks[b]
        out = out + "@" + qbe_mangle_label(blk.label) + "\n"
        let mut j = 0
        while j < len(blk.instrs) {
            let lines = qbe_emit_instr(e, &ctx, blk.instrs[j])
            let mut k = 0
            while k < len(lines) {
                out = out + "  " + lines[k] + "\n"
                k = k + 1
            }
            j = j + 1
        }
        let term_lines = qbe_emit_term(e, &ctx, string_clone(&f.return_type), blk.term)
        let mut k = 0
        while k < len(term_lines) {
            out = out + "  " + term_lines[k] + "\n"
            k = k + 1
        }
        out = out + "\n"
        b = b + 1
    }

    out = out + "}\n"
    return out
}

fn qbe_emit_dispatch_helper(e: &mut QbeEmitter, base_ctx: QbeFuncCtx, helper: QbeDispatchHelper) -> String {
    let mut out = ""
    let ret_q = qbe_type(helper.ret_type, &base_ctx.enum_names,  &base_ctx.struct_fields)
    out = out + "export function " + ret_q + " $" + helper.name + "(l %t0"
    let mut i = 0
    while i < len(helper.arg_types) {
        let qt = qbe_type(helper.arg_types[i], &base_ctx.enum_names,  &base_ctx.struct_fields)
        out = out + ", " + qt + " %t" + int_to_string(i + 1)
        i = i + 1
    }
    out = out + ") {\n"

    let closure_name = "Closure"
    let layout = qbe_layout_find(&base_ctx.layouts, &closure_name)
    let func_name = cg_mangle_ident("func")
    let env_name = cg_mangle_ident("env")
    let func_field = qbe_layout_field(&layout, &func_name)
    let env_field = qbe_layout_field(&layout, &env_name)

    out = out + "@entry\n"
    let mut func_ptr = "%t0"
    if func_field.offset != 0 {
        out = out + "  %d0 =l add %t0, " + int_to_string(func_field.offset) + "\n"
        func_ptr = "%d0"
    }
    out = out + "  %d1 =l load " + func_ptr + "\n"
    let mut env_ptr = "%t0"
    if env_field.offset != 0 {
        out = out + "  %d2 =l add %t0, " + int_to_string(env_field.offset) + "\n"
        env_ptr = "%d2"
    }
    out = out + "  %d3 =l load " + env_ptr + "\n"
    out = out + "  jmp @check0\n\n"

    let mut idx = 0
    while idx < len(base_ctx.closure_funcs) {
        let fname = base_ctx.closure_funcs[idx]
        let lbl_check = "check" + int_to_string(idx)
        let lbl_call = "call" + int_to_string(idx)
        let lbl_next = "check" + int_to_string(idx + 1)
        out = out + "@" + lbl_check + "\n"
        let cstr = qbe_string_data_label(e, string_clone(&fname))
        out = out + "  %d4 =w call $dast_string_eq_cstr_ptr(l %d1, l $" + cstr + ")\n"
        out = out + "  jnz %d4, @" + lbl_call + ", @" + lbl_next + "\n\n"
        out = out + "@" + lbl_call + "\n"
        let fidx = cg_find_function_index(base_ctx.prog, string_clone(&fname))
        let mut f = IrFunction { name: "", params: qbe_string_list_new(), param_types: qbe_string_list_new(), return_type: "", blocks: ir_block_list_new(), temp_count: 0 }
        if fidx >= 0 { f = base_ctx.prog.functions[fidx] }
        let mut args = "l %d3"
        let mut j = 0
        while j < len(helper.arg_types) {
            let qt = qbe_type(helper.arg_types[j], &base_ctx.enum_names,  &base_ctx.struct_fields)
            args = args + ", " + qt + " %t" + int_to_string(j + 1)
            j = j + 1
        }
        let call = "$" + qbe_mangle_func(string_clone(&fname)) + "(" + args + ")"
        if helper.ret_type == "" || qbe_is_unit_type(helper.ret_type) {
            out = out + "  call " + call + "\n"
            out = out + "  ret 0\n\n"
        } else {
            out = out + "  %d5 =" + ret_q + " call " + call + "\n"
            out = out + "  ret %d5\n\n"
        }
        idx = idx + 1
    }
    out = out + "@check" + int_to_string(len(base_ctx.closure_funcs)) + "\n"
    let panic_msg = qbe_string_struct_label(e, "invalid closure")
    out = out + "  call $dast_panic_ptr(l $" + panic_msg + ")\n"
    if helper.ret_type == "" || qbe_is_unit_type(helper.ret_type) {
        out = out + "  ret 0\n"
    } else {
        out = out + "  ret 0\n"
    }
    out = out + "}\n"
    return out
}

fn qbe_emit_dispatch_helpers(e: &mut QbeEmitter, base_ctx: QbeFuncCtx) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(e.dispatch_helpers) {
        out = out + qbe_emit_dispatch_helper(e, base_ctx, e.dispatch_helpers[i]) + "\n"
        i = i + 1
    }
    return out
}

fn qbe_emit_main(entry_name: String) -> String {
    let mut out = ""
    out = out + "export function w $main(w %argc, l %argv) {\n"
    out = out + "@entry\n"
    out = out + "  call $dast_runtime_init(w %argc, l %argv)\n"
    if entry_name != "" {
        out = out + "  call $" + qbe_mangle_func(entry_name) + "()\n"
    }
    out = out + "  call $dast_runtime_cleanup()\n"
    out = out + "  ret 0\n"
    out = out + "}\n"
    return out
}

fn qbe_prof_count_ir(e: &mut QbeEmitter, p: &IrProgram) {
    if !e.prof_enabled { return }
    qbe_prof_inc(e, "ir.program")
    let mut fi = 0
    while fi < len(p.functions) {
        qbe_prof_inc(e, "ir.func")
        let f = ir_function_clone(&p.functions[fi])
        let mut bi = 0
        while bi < len(f.blocks) {
            qbe_prof_inc(e, "ir.block")
            let blk = ir_block_clone(&f.blocks[bi])
            let mut ii = 0
            while ii < len(blk.instrs) {
                match blk.instrs[ii] {
                    IrInstr.LoadVar(_) => { qbe_prof_inc(e, "ir.instr.LoadVar") }
                    IrInstr.StoreVar(_) => { qbe_prof_inc(e, "ir.instr.StoreVar") }
                    IrInstr.BinOp(_) => { qbe_prof_inc(e, "ir.instr.BinOp") }
                    IrInstr.Call(_) => { qbe_prof_inc(e, "ir.instr.Call") }
                    IrInstr.CallClosure(_) => { qbe_prof_inc(e, "ir.instr.CallClosure") }
                    IrInstr.MakeArray(_) => { qbe_prof_inc(e, "ir.instr.MakeArray") }
                    IrInstr.Index(_) => { qbe_prof_inc(e, "ir.instr.Index") }
                    IrInstr.SetIndex(_) => { qbe_prof_inc(e, "ir.instr.SetIndex") }
                    IrInstr.MakeStruct(_) => { qbe_prof_inc(e, "ir.instr.MakeStruct") }
                    IrInstr.GetField(_) => { qbe_prof_inc(e, "ir.instr.GetField") }
                    IrInstr.SetField(_) => { qbe_prof_inc(e, "ir.instr.SetField") }
                }
                ii = ii + 1
            }
            match blk.term {
                IrTerm.None(_) => { qbe_prof_inc(e, "ir.term.None") }
                IrTerm.Jump(_) => { qbe_prof_inc(e, "ir.term.Jump") }
                IrTerm.Branch(_) => { qbe_prof_inc(e, "ir.term.Branch") }
                IrTerm.Return(_) => { qbe_prof_inc(e, "ir.term.Return") }
            }
            bi = bi + 1
        }
        fi = fi + 1
    }
}

fn ir_program_to_qbe(p: &IrProgram, debug: bool) -> String {
    let prof_flag = read_file("/tmp/dast-qbe-prof")
    let prof = prof_flag != ""
    let mut stop_stage = ""
    if prof {
        let tag = "stop:"
        let tag_len = len(tag)
        let flag_len = len(string_clone(&prof_flag))
        if flag_len > tag_len {
            let prefix = substr(string_clone(&prof_flag), 0, tag_len)
            if prefix == tag {
                stop_stage = substr(string_clone(&prof_flag), tag_len, flag_len - tag_len)
            }
        }
    }
    if prof && stop_stage != "" {
        println("[qbe-prof] stop_stage", string_clone(&stop_stage))
    }
    let mut out = ""
    let empty_structs = string_list_map_new()
    let enum_names = cg_enum_names(p)
    if prof { println("[qbe-prof] step", "enum_names") }
    if prof {
        println("[qbe-prof] enum_names.len", len(cg_string_list_clone(&enum_names)))
    }
    if string_clone(&stop_stage) == "enum_names" { exit(0) }
    let mut seed_fields = cg_seed_field_types()
    let enum_tag_payloads0 = cg_collect_enum_tag_payloads(p, ir_function_list_clone(&p.functions), &empty_structs, &seed_fields)
    if prof { println("[qbe-prof] step", "enum_tag_payloads0") }
    if string_clone(&stop_stage) == "enum_tag_payloads0" { exit(0) }
    let funcs0 = ir_function_list_clone(&p.functions)
    let mut struct_fields0 = cg_collect_struct_fields(p, funcs0, &seed_fields, &empty_structs, &enum_names, &enum_tag_payloads0)
    cg_add_seed_struct_fields(&mut struct_fields0)
    cg_add_enum_struct_fields(p, ir_function_list_clone(&p.functions), &mut struct_fields0, &seed_fields)
    if prof { println("[qbe-prof] step", "struct_fields0") }
    if prof {
        println("[qbe-prof] struct_fields0.keys.len", len(cg_string_list_clone(&struct_fields0.keys)))
        println("[qbe-prof] seed_fields.keys.len", len(cg_string_list_clone(&seed_fields.keys)))
    }
    if string_clone(&stop_stage) == "struct_fields0" { exit(0) }
    let enum_seed = cg_enum_seed_fields(p, ir_function_list_clone(&p.functions), &struct_fields0)
    cg_merge_field_types(&mut seed_fields, enum_seed)
    string_map_sort(&mut seed_fields)
    let inst_res = cg_build_func_instances(p, &seed_fields, &struct_fields0, &enum_names, &enum_tag_payloads0)
    if prof { println("[qbe-prof] step", "build_instances") }
    if prof {
        println("[qbe-prof] instances.len", len(cg_func_instance_list_clone(&inst_res.items)))
    }
    if string_clone(&stop_stage) == "build_instances" { exit(0) }
    let inst_items = cg_func_instance_list_clone(&inst_res.items)
    let inst_funcs0 = cg_instance_functions(p, inst_items, &struct_fields0)
    let closure_funcs0 = cg_collect_closure_funcs(ir_function_list_clone(&inst_funcs0))
    let reachable_src = ir_function_list_clone(&inst_funcs0)
    let closure_src = cg_string_list_clone(&closure_funcs0)
    let inst_funcs = cg_reachable_functions(reachable_src, p.entry, closure_src)
    if prof { println("[qbe-prof] step", "reachable") }
    if prof {
        println("[qbe-prof] inst_funcs0.len", len(ir_function_list_clone(&inst_funcs0)))
        println("[qbe-prof] closure_funcs0.len", len(cg_string_list_clone(&closure_funcs0)))
        println("[qbe-prof] inst_funcs.len", len(ir_function_list_clone(&inst_funcs)))
    }
    if string_clone(&stop_stage) == "reachable" { exit(0) }
    let inst_funcs_for_fields = ir_function_list_clone(&inst_funcs)
    let mut struct_fields = cg_collect_struct_fields(p, inst_funcs_for_fields, &seed_fields, &struct_fields0, &enum_names, &enum_tag_payloads0)
    cg_add_seed_struct_fields(&mut struct_fields)
    cg_add_enum_struct_fields(p, ir_function_list_clone(&inst_funcs), &mut struct_fields, &seed_fields)
    let enum_tag_payloads1 = cg_collect_enum_tag_payloads(p, ir_function_list_clone(&inst_funcs), &struct_fields, &seed_fields)
    let mut field_types = cg_collect_field_types(p, ir_function_list_clone(&inst_funcs), &struct_fields, seed_fields, &enum_names, &enum_tag_payloads1, "field_types", debug)
    string_map_sort(&mut field_types)
    let enum_tag_payloads = cg_collect_enum_tag_payloads(p, ir_function_list_clone(&inst_funcs), &struct_fields, &field_types)
    let env_field_types = cg_collect_env_field_types(p, ir_function_list_clone(&inst_funcs), &field_types, &struct_fields, &enum_names, &enum_tag_payloads)
    let closure_funcs = cg_collect_closure_funcs(ir_function_list_clone(&inst_funcs))
    if prof { println("[qbe-prof] step", "field_types") }
    if prof {
        println("[qbe-prof] struct_fields.keys.len", len(cg_string_list_clone(&struct_fields.keys)))
        println("[qbe-prof] field_types.keys.len", len(cg_string_list_clone(&field_types.keys)))
        println("[qbe-prof] env_field_types.keys.len", len(cg_string_list_clone(&env_field_types.keys)))
        println("[qbe-prof] closure_funcs.len", len(cg_string_list_clone(&closure_funcs)))
    }
    if string_clone(&stop_stage) == "field_types" { exit(0) }
    let inst_map = inst_res.name_map
    let entry_name = inst_res.entry_name

    let layouts = qbe_build_layouts(p, &struct_fields, &field_types, &env_field_types, &enum_names)
    if prof { println("[qbe-prof] step", "layouts") }
    if prof {
        let mut lay_clone: [QbeStructLayout] = []
        let mut li = 0
        while li < len(layouts) {
            push(&mut lay_clone, qbe_struct_layout_clone(&layouts[li]))
            li = li + 1
        }
        println("[qbe-prof] layouts.len", len(lay_clone))
    }
    if string_clone(&stop_stage) == "layouts" { exit(0) }

    let mut e = qbe_emitter_new()
    qbe_prof_inc(&mut e, "qbe.ir_program_to_qbe")
    qbe_prof_count_ir(&mut e, p)
    let mut i = 0
    while i < len(inst_funcs) {
        qbe_collect_strings_from_func(&mut e, &inst_funcs[i])
        i = i + 1
    }
    if prof { println("[qbe-prof] step", "collect_strings") }
    if string_clone(&stop_stage) == "collect_strings" { exit(0) }
    i = 0
    while i < len(closure_funcs) {
        let _ = qbe_string_id(&mut e, closure_funcs[i])
        i = i + 1
    }
    let _ = qbe_string_id(&mut e, " ")
    let _ = qbe_string_id(&mut e, "<struct>")
    let _ = qbe_string_id(&mut e, "<value>")
    let _ = qbe_string_id(&mut e, "invalid closure")

    out = out + qbe_emit_data_section(&mut e)

    let base_infer = CgInfer {
        func_name: "",
        temp_types: qbe_string_list_new(),
        var_types: string_map_new(),
        seed_fields: string_map_new(),
        field_types: string_map_new(),
        temp_field_types: string_map_new(),
        var_field_types: string_map_new(),
        temp_closure_funcs: qbe_string_list_new(),
        var_closure_funcs: string_map_new(),
    }
    let base_ctx = QbeFuncCtx {
        prog: p,
        infer: base_infer,
        field_types: field_types,
        struct_fields: struct_fields,
        env_field_types: env_field_types,
        enum_names: enum_names,
        enum_tag_payloads: enum_tag_payloads,
        layouts: layouts,
        inst_map: inst_map,
        closure_funcs: closure_funcs,
    }

    i = 0
    while i < len(inst_funcs) {
        out = out + qbe_emit_function(&mut e, &base_ctx, inst_funcs[i]) + "\n"
        i = i + 1
    }
    if prof { println("[qbe-prof] step", "emit_functions") }
    if string_clone(&stop_stage) == "emit_functions" { exit(0) }

    out = out + qbe_emit_dispatch_helpers(&mut e, base_ctx)
    out = out + qbe_emit_main(entry_name)

    qbe_prof_dump(&e)
    return out
}
