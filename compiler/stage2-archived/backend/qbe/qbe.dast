// QBE backend for stage2 (pointer-based representation)

struct QbeStringConst {
    text: String,
    data_label: String,
    struct_label: String,
    len: i32,
}

struct QbeDispatchHelper {
    name: String,
    ret_type: String,
    arg_types: [String],
}

struct QbeStructField {
    name: String,
    typ: String,
    offset: i32,
    size: i32,
    align: i32,
}

struct QbeStructLayout {
    name: String,
    size: i32,
    align: i32,
    fields: [QbeStructField],
    is_enum: bool,
    payload_size: i32,
    payload_align: i32,
}

struct QbeExprLines {
    expr: String,
    lines: [String],
}

struct QbeDerefResult {
    expr: String,
    lines: [String],
    base_type: String,
}

struct QbeCallArg {
    text: String,
    lines: [String],
}

struct QbeEmitter {
    strings: [QbeStringConst],
    string_ids: StringMap,
    temp_id: i32,
    temp_keys: [i32],
    temp_vals: [i32],
    dispatch_helpers: [QbeDispatchHelper],
    dispatch_map: StringMap,
    prof_enabled: bool,
    prof_keys: [String],
    prof_vals: [i64],
}

struct QbeFuncCtx {
    prog: &IrProgram,
    infer: CgInfer,
    field_types: StringMap,
    struct_fields: StringListMap,
    env_field_types: StringListMap,
    enum_names: [String],
    enum_tag_payloads: StringMap,
    layouts: [QbeStructLayout],
    inst_map: StringMap,
    closure_funcs: [String],
}

fn qbe_string_list_new() -> [String] {
    let mut items: [String] = []
    return items
}

fn qbe_i32_list_new() -> [i32] {
    let mut items: [i32] = []
    return items
}

fn qbe_i64_list_new() -> [i64] {
    let mut items: [i64] = []
    return items
}

fn qbe_string_const_list_new() -> [QbeStringConst] {
    let mut items: [QbeStringConst] = []
    return items
}

fn qbe_dispatch_list_new() -> [QbeDispatchHelper] {
    let mut items: [QbeDispatchHelper] = []
    return items
}

fn qbe_struct_field_list_new() -> [QbeStructField] {
    let mut items: [QbeStructField] = []
    return items
}

fn qbe_struct_layout_list_new() -> [QbeStructLayout] {
    let mut items: [QbeStructLayout] = []
    return items
}

fn qbe_prof_inc(e: &mut QbeEmitter, key: &str) {
    if !e.prof_enabled { return }
    let mut keys = e.prof_keys
    let mut vals = e.prof_vals
    let mut i = 0
    while i < len(keys) {
        if keys[i] == key {
            vals[i] = vals[i] + 1
            e.prof_keys = keys
            e.prof_vals = vals
            return
        }
        i = i + 1
    }
    push(&mut keys, string_clone(key))
    push(&mut vals, 1)
    e.prof_keys = keys
    e.prof_vals = vals
}

fn qbe_prof_dump(e: &QbeEmitter) {
    if !e.prof_enabled { return }
    println("[qbe-prof] counters", len(e.prof_keys))
    let mut i = 0
    while i < len(e.prof_keys) {
        println("[qbe-prof]", e.prof_keys[i], e.prof_vals[i])
        i = i + 1
    }
}

fn qbe_struct_field_clone(f: &QbeStructField) -> QbeStructField {
    return QbeStructField { name: string_clone(&f.name), typ: string_clone(&f.typ), offset: f.offset, size: f.size, align: f.align }
}

fn qbe_struct_field_list_clone(items: & [QbeStructField]) -> [QbeStructField] {
    let mut out: [QbeStructField] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, qbe_struct_field_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn qbe_struct_layout_clone(l: &QbeStructLayout) -> QbeStructLayout {
    return QbeStructLayout {
        name: string_clone(&l.name),
        size: l.size,
        align: l.align,
        fields: qbe_struct_field_list_clone(&l.fields),
        is_enum: l.is_enum,
        payload_size: l.payload_size,
        payload_align: l.payload_align,
    }
}

fn qbe_enum_variant_clone(v: &IrEnumVariant) -> IrEnumVariant {
    return IrEnumVariant { name: string_clone(&v.name), tag: v.tag, payload_type: string_clone(&v.payload_type) }
}

fn qbe_enum_variant_list_clone(items: & [IrEnumVariant]) -> [IrEnumVariant] {
    let mut out: [IrEnumVariant] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, qbe_enum_variant_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn qbe_enum_decl_clone(d: &IrEnumDecl) -> IrEnumDecl {
    return IrEnumDecl {
        name: string_clone(&d.name),
        type_params: cg_string_list_clone(&d.type_params),
        tag_type: string_clone(&d.tag_type),
        variants: qbe_enum_variant_list_clone(&d.variants),
    }
}

fn qbe_emitter_new() -> QbeEmitter {
    let prof_flag = read_file("/tmp/dast-qbe-prof")
    return QbeEmitter {
        strings: qbe_string_const_list_new(),
        string_ids: string_map_new(),
        temp_id: 0,
        temp_keys: qbe_i32_list_new(),
        temp_vals: qbe_i32_list_new(),
        dispatch_helpers: qbe_dispatch_list_new(),
        dispatch_map: string_map_new(),
        prof_enabled: prof_flag != "",
        prof_keys: qbe_string_list_new(),
        prof_vals: qbe_i64_list_new(),
    }
}

fn qbe_escape_string(s: String) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == '\n' { out = out + "\\n" }
        else if c == '\t' { out = out + "\\t" }
        else if c == '\r' { out = out + "\\r" }
        else if c == '\\' { out = out + "\\\\" }
        else if c == '"' { out = out + "\\\"" }
        else { out = out + substr(s, i, 1) }
        i = i + 1
    }
    return out
}

fn qbe_string_id(e: &mut QbeEmitter, s: String) -> i32 {
    let mut ids = e.string_ids
    let existing = string_map_get(&ids, &s)
    if existing != "" {
        e.string_ids = ids
        return parse_int(existing)
    }
    let id = len(e.strings)
    let data_label = "str_data_" + int_to_string(id)
    let struct_label = "str_" + int_to_string(id)
    let text_key = string_clone(&s)
    let text_len = len(string_clone(&s))
    let entry = QbeStringConst { text: s, data_label: data_label, struct_label: struct_label, len: text_len }
    let mut items = e.strings
    push(&mut items, entry)
    e.strings = items
    let _ = string_map_set(&mut ids, text_key, int_to_string(id))
    e.string_ids = ids
    return id
}

fn qbe_string_data_label(e: &mut QbeEmitter, s: String) -> String {
    let id = qbe_string_id(e, s)
    return "str_data_" + int_to_string(id)
}

fn qbe_string_struct_label(e: &mut QbeEmitter, s: String) -> String {
    let id = qbe_string_id(e, s)
    return "str_" + int_to_string(id)
}

fn qbe_is_ref_type(t: String) -> bool { return cg_is_ref_type(t) }
fn qbe_ref_base_type(t: String) -> String { return cg_ref_base_type(t) }
fn qbe_is_array_type(t: String) -> bool { return cg_is_array_type(t) }
fn qbe_array_elem_type(t: String) -> String { return cg_array_elem_type(t) }

fn qbe_is_string_type(t: String) -> bool { return cg_is_string_type(t) }
fn qbe_is_bool_type(t: String) -> bool { return cg_is_bool_type(t) }
fn qbe_is_unit_type(t: String) -> bool { return cg_is_unit_type(t) }
fn qbe_is_int_type(t: String) -> bool { return cg_is_int_type(t) }
fn qbe_is_struct_type(t: String) -> bool { return cg_is_struct_type(t) }

fn qbe_type(t: String, enum_names: & [String], struct_fields: &StringListMap) -> String {
    let s = cg_normalize_type(t)
    if s == "" || qbe_is_unit_type(string_clone(&s)) { return "w" }
    if qbe_is_ref_type(string_clone(&s)) { return "l" }
    if qbe_is_array_type(string_clone(&s)) { return "l" }
    if qbe_is_string_type(string_clone(&s)) { return "l" }
    if qbe_is_struct_type(string_clone(&s)) || cg_struct_is_enum(enum_names, string_clone(&s)) { return "l" }
    if qbe_is_bool_type(string_clone(&s)) { return "w" }
    if qbe_is_int_type(string_clone(&s)) {
        if s == "i8" || s == "u8" { return "b" }
        if s == "i16" || s == "u16" { return "h" }
        if s == "i32" || s == "u32" || s == "char" { return "w" }
        return "l"
    }
    if cg_is_value_type(string_clone(&s)) || cg_is_type_var(string_clone(&s), struct_fields) { return "l" }
    return "l"
}

fn qbe_type_size(t: String, enum_names: & [String], struct_fields: &StringListMap) -> i32 {
    let qt = qbe_type(t, enum_names, struct_fields)
    if qt == "b" { return 1 }
    if qt == "h" { return 2 }
    if qt == "w" { return 4 }
    return 8
}

fn qbe_type_align(t: String, enum_names: & [String], struct_fields: &StringListMap) -> i32 {
    let s = qbe_type_size(t, enum_names, struct_fields)
    if s <= 1 { return 1 }
    if s == 2 { return 2 }
    if s == 4 { return 4 }
    return 8
}

fn qbe_var_slot(name: String) -> String {
    return "v_" + cg_mangle_ident(name)
}

fn qbe_mangle_label(name: String) -> String {
    return "L_" + cg_mangle_ident(name)
}

fn qbe_mangle_func(name: String) -> String {
    return "dast_user_" + cg_mangle_ident(name)
}

fn qbe_is_compare_op(op: String) -> bool {
    if op == "==" || op == "!=" { return true }
    if op == "<" || op == "<=" || op == ">" || op == ">=" { return true }
    return false
}

fn qbe_cmp_op(op: String, qt: String) -> String {
    let mut suffix = qt
    if suffix == "" { suffix = "l" }
    if op == "==" { return "ceq" + suffix }
    if op == "!=" { return "cne" + suffix }
    if op == "<" { return "cslt" + suffix }
    if op == "<=" { return "csle" + suffix }
    if op == ">" { return "csgt" + suffix }
    if op == ">=" { return "csge" + suffix }
    return "ceq" + suffix
}

fn qbe_arith_op(op: String) -> String {
    if op == "+" { return "add" }
    if op == "-" { return "sub" }
    if op == "*" { return "mul" }
    if op == "/" { return "div" }
    if op == "%" { return "rem" }
    return "add"
}

fn qbe_int_rank(t: String) -> i32 {
    let s = cg_normalize_type(t)
    if s == "i8" || s == "u8" { return 8 }
    if s == "i16" || s == "u16" { return 16 }
    if s == "i32" || s == "u32" || s == "char" { return 32 }
    if s == "i64" || s == "int" || s == "isize" || s == "usize" { return 64 }
    return 0
}

fn qbe_unify_type(a: String, b: String) -> String {
    let a2 = cg_normalize_type(a)
    let b2 = cg_normalize_type(b)
    if a2 == "" { return b2 }
    if b2 == "" { return a2 }
    if a2 == b2 { return a2 }
    if qbe_is_bool_type(string_clone(&a2)) && qbe_is_bool_type(string_clone(&b2)) { return "bool" }
    if qbe_is_int_type(string_clone(&a2)) && qbe_is_int_type(string_clone(&b2)) {
        let ra = qbe_int_rank(string_clone(&a2))
        let rb = qbe_int_rank(string_clone(&b2))
        if ra >= rb { return a2 }
        return b2
    }
    if qbe_is_int_type(string_clone(&a2)) && qbe_is_bool_type(string_clone(&b2)) { return a2 }
    if qbe_is_bool_type(string_clone(&a2)) && qbe_is_int_type(string_clone(&b2)) { return b2 }
    return a2
}

fn qbe_collect_vars(f: &IrFunction) -> [String] {
    let mut out: [String] = []
    let mut i = 0
    while i < len(f.params) {
        if !cg_string_list_contains(&out, string_clone(&f.params[i])) {
            push(&mut out, f.params[i])
        }
        i = i + 1
    }
    let mut b = 0
    while b < len(f.blocks) {
        let blk = f.blocks[b]
        let mut j = 0
        while j < len(blk.instrs) {
            match blk.instrs[j] {
                IrInstr.LoadVar(i2) => {
                    if i2.name != "" && !cg_string_list_contains(&out, string_clone(&i2.name)) { push(&mut out, i2.name) }
                }
                IrInstr.StoreVar(i2) => {
                    if i2.name != "" && !cg_string_list_contains(&out, string_clone(&i2.name)) { push(&mut out, i2.name) }
                }
                _ => {}
            }
            j = j + 1
        }
        b = b + 1
    }
    return out
}

fn qbe_layout_find(layouts: & [QbeStructLayout], name: &str) -> QbeStructLayout {
    let mut i = 0
    while i < len(layouts) {
        if layouts[i].name == string_clone(name) { return layouts[i] }
        i = i + 1
    }
    return QbeStructLayout { name: string_clone(name), size: 0, align: 1, fields: qbe_struct_field_list_new(), is_enum: false, payload_size: 0, payload_align: 1 }
}

fn qbe_layout_field(layout: &QbeStructLayout, field: &str) -> QbeStructField {
    let mut i = 0
    while i < len(layout.fields) {
        if layout.fields[i].name == string_clone(field) { return layout.fields[i] }
        i = i + 1
    }
    return QbeStructField { name: string_clone(field), typ: "", offset: 0, size: 0, align: 1 }
}

fn qbe_align_up(x: i32, align: i32) -> i32 {
    if align <= 1 { return x }
    let rem = x % align
    if rem == 0 { return x }
    return x + (align - rem)
}

fn qbe_enum_decl(p: &IrProgram, name: String) -> IrEnumDecl {
    let mut i = 0
    while i < len(p.enums) {
        if p.enums[i].name == name { return p.enums[i] }
        i = i + 1
    }
    let mut vars: [IrEnumVariant] = []
    return IrEnumDecl { name: name, type_params: qbe_string_list_new(), tag_type: "int", variants: vars }
}

fn qbe_build_layouts(p: &IrProgram, struct_fields: &StringListMap, field_types: &StringMap, env_field_types: &StringListMap, enum_names: & [String]) -> [QbeStructLayout] {
    let mut out = qbe_struct_layout_list_new()
    let mut i = 0
    while i < len(struct_fields.keys) {
        let name = struct_fields.keys[i]
        let fields = string_list_map_get(struct_fields, &name)
        let is_enum = cg_struct_is_enum(enum_names, string_clone(&name))
        let mut layout_fields = qbe_struct_field_list_new()
        let mut size = 0
        let mut align = 1
        let mut payload_size = 0
        let mut payload_align = 1
        if is_enum {
            let decl = qbe_enum_decl(p, string_clone(&name))
            let tag_type = decl.tag_type
            let tag_size = qbe_type_size(string_clone(&tag_type), enum_names, struct_fields)
            let tag_align = qbe_type_align(string_clone(&tag_type), enum_names, struct_fields)
            let mut max_size = 0
            let mut max_align = 1
            let mut v = 0
            while v < len(decl.variants) {
                let pt = decl.variants[v].payload_type
                let mut pt_name = pt
                if pt_name == "" { pt_name = "unit" }
                let ps = qbe_type_size(string_clone(&pt_name), enum_names, struct_fields)
                let pa = qbe_type_align(string_clone(&pt_name), enum_names, struct_fields)
                if ps > max_size { max_size = ps }
                if pa > max_align { max_align = pa }
                v = v + 1
            }
            if max_size == 0 { max_size = 4 }
            if max_align == 0 { max_align = 1 }
            payload_size = max_size
            payload_align = max_align
            // _tag
            size = qbe_align_up(size, tag_align)
            let tag_field = QbeStructField { name: "_tag", typ: tag_type, offset: size, size: tag_size, align: tag_align }
            push(&mut layout_fields, tag_field)
            size = size + tag_size
            if tag_align > align { align = tag_align }
            // _payload
            size = qbe_align_up(size, max_align)
            let payload_field = QbeStructField { name: "_payload", typ: "<payload>", offset: size, size: max_size, align: max_align }
            push(&mut layout_fields, payload_field)
            size = size + max_size
            if max_align > align { align = max_align }
        } else if cg_struct_key_name(string_clone(&name)) == "$Env" {
            let mut f = 0
            while f < len(fields) {
                let fname = fields[f]
                let types = string_list_map_get(env_field_types, &fname)
                if len(types) > 1 {
                    let mut ti = 0
                    while ti < len(types) {
                        let t = types[ti]
                        let field_id = cg_env_field_name(fname, string_clone(&t), env_field_types)
                        let fs = qbe_type_size(string_clone(&t), enum_names, struct_fields)
                        let fa = qbe_type_align(string_clone(&t), enum_names, struct_fields)
                        size = qbe_align_up(size, fa)
                        push(&mut layout_fields, QbeStructField { name: field_id, typ: t, offset: size, size: fs, align: fa })
                        size = size + fs
                        if fa > align { align = fa }
                        ti = ti + 1
                    }
                } else {
                    let key = cg_field_key(string_clone(&name), string_clone(&fname))
                    let mut ft = string_map_get(field_types, &key)
                    if ft == "" && len(types) == 1 { ft = types[0] }
                    if ft == "" { ft = "unit" }
                    let fs = qbe_type_size(string_clone(&ft), enum_names, struct_fields)
                    let fa = qbe_type_align(string_clone(&ft), enum_names, struct_fields)
                    size = qbe_align_up(size, fa)
                    push(&mut layout_fields, QbeStructField { name: cg_mangle_ident(fname), typ: ft, offset: size, size: fs, align: fa })
                    size = size + fs
                    if fa > align { align = fa }
                }
                f = f + 1
            }
        } else {
            let mut f = 0
            while f < len(fields) {
                let fname = fields[f]
                let key = cg_field_key(string_clone(&name), string_clone(&fname))
                let mut ft = string_map_get(field_types, &key)
                if ft == "" { ft = "unit" }
                let fs = qbe_type_size(string_clone(&ft), enum_names, struct_fields)
                let fa = qbe_type_align(string_clone(&ft), enum_names, struct_fields)
                size = qbe_align_up(size, fa)
                push(&mut layout_fields, QbeStructField { name: cg_mangle_ident(fname), typ: ft, offset: size, size: fs, align: fa })
                size = size + fs
                if fa > align { align = fa }
                f = f + 1
            }
        }
        size = qbe_align_up(size, align)
        if size == 0 { size = 1 }
        let layout = QbeStructLayout { name: name, size: size, align: align, fields: layout_fields, is_enum: is_enum, payload_size: payload_size, payload_align: payload_align }
        push(&mut out, layout)
        i = i + 1
    }
    return out
}

fn qbe_operand_def_type(op: &IrOperand, infer: &CgInfer) -> String {
    if op.is_const {
        return cg_operand_type(op, &infer.temp_types)
    }
    if op.temp < 0 || op.temp >= len(infer.temp_types) { return "" }
    return infer.temp_types[op.temp]
}

fn qbe_operand_expr(e: &mut QbeEmitter, op: &IrOperand) -> String {
    qbe_prof_inc(e, "qbe.qbe_operand_expr")
    if op.is_const {
        let v = op.value
        if v.kind == ir_kind_int() { return int_to_string(v.int) }
        if v.kind == ir_kind_bool() { if v.bool { return "1" } return "0" }
        if v.kind == ir_kind_string() {
            let label = qbe_string_struct_label(e, v.str)
            return "$" + label
        }
        return "0"
    }
    let qid = qbe_temp_get(e, op.temp)
    return "%t" + int_to_string(qid)
}

fn qbe_cast_operand(e: &mut QbeEmitter, ctx: &QbeFuncCtx, op: &IrOperand, target_type: String) -> QbeExprLines {
    qbe_prof_inc(e, "qbe.qbe_cast_operand")
    let expr = qbe_operand_expr(e, op)
    if op.is_const { return QbeExprLines { expr: expr, lines: qbe_string_list_new() } }
    let src_type = qbe_operand_def_type(op, &ctx.infer)
    if src_type == "" || target_type == "" { return QbeExprLines { expr: expr, lines: qbe_string_list_new() } }
    let src_q = qbe_type(src_type, &ctx.enum_names,  &ctx.struct_fields)
    let dst_q = qbe_type(target_type, &ctx.enum_names,  &ctx.struct_fields)
    if src_q == dst_q { return QbeExprLines { expr: expr, lines: qbe_string_list_new() } }
    let tmp = e.temp_id
    e.temp_id = e.temp_id + 1
    let mut lines: [String] = []
    if dst_q == "l" && src_q == "w" {
        push(&mut lines, "%t" + int_to_string(tmp) + " =l extsw " + expr)
        return QbeExprLines { expr: "%t" + int_to_string(tmp), lines: lines }
    }
    push(&mut lines, "%t" + int_to_string(tmp) + " =" + dst_q + " copy " + expr)
    return QbeExprLines { expr: "%t" + int_to_string(tmp), lines: lines }
}

fn qbe_cast_expr(e: &mut QbeEmitter, ctx: &QbeFuncCtx, expr: String, src_type: String, target_type: String) -> QbeExprLines {
    if src_type == "" || target_type == "" { return QbeExprLines { expr: expr, lines: qbe_string_list_new() } }
    let src_q = qbe_type(src_type, &ctx.enum_names,  &ctx.struct_fields)
    let dst_q = qbe_type(target_type, &ctx.enum_names,  &ctx.struct_fields)
    if src_q == dst_q { return QbeExprLines { expr: expr, lines: qbe_string_list_new() } }
    let tmp = e.temp_id
    e.temp_id = e.temp_id + 1
    let mut lines: [String] = []
    if dst_q == "l" && src_q == "w" {
        push(&mut lines, "%t" + int_to_string(tmp) + " =l extsw " + expr)
        return QbeExprLines { expr: "%t" + int_to_string(tmp), lines: lines }
    }
    push(&mut lines, "%t" + int_to_string(tmp) + " =" + dst_q + " copy " + expr)
    return QbeExprLines { expr: "%t" + int_to_string(tmp), lines: lines }
}

fn qbe_deref_operand(e: &mut QbeEmitter, ctx: &QbeFuncCtx, op: &IrOperand) -> QbeDerefResult {
    qbe_prof_inc(e, "qbe.qbe_deref_operand")
    let typ = qbe_operand_def_type(op, &ctx.infer)
    if !qbe_is_ref_type(string_clone(&typ)) { return QbeDerefResult { expr: qbe_operand_expr(e, op), lines: qbe_string_list_new(), base_type: typ } }
    let base = qbe_ref_base_type(typ)
    if qbe_is_string_type(string_clone(&base)) {
        return QbeDerefResult { expr: qbe_operand_expr(e, op), lines: qbe_string_list_new(), base_type: base }
    }
    let tmp = e.temp_id
    e.temp_id = e.temp_id + 1
    let q = qbe_type(string_clone(&base), &ctx.enum_names,  &ctx.struct_fields)
    let line = "%t" + int_to_string(tmp) + " =" + q + " load " + qbe_operand_expr(e, op)
    let mut lines: [String] = []
    push(&mut lines, line)
    return QbeDerefResult { expr: "%t" + int_to_string(tmp), lines: lines, base_type: base }
}

fn qbe_call_arg(e: &mut QbeEmitter, ctx: &QbeFuncCtx, op: &IrOperand, expected: String) -> QbeCallArg {
    qbe_prof_inc(e, "qbe.qbe_call_arg")
    let mut target = expected
    if target == "" {
        target = qbe_operand_def_type(op, &ctx.infer)
    }
    target = cg_normalize_type(target)
    let op_type = cg_normalize_type(qbe_operand_def_type(op, &ctx.infer))
    if qbe_is_ref_type(string_clone(&op_type)) && !qbe_is_ref_type(string_clone(&target)) {
        let deref = qbe_deref_operand(e, ctx, op)
        let mut cast_target = string_clone(&target)
        if cast_target == "" { cast_target = deref.base_type }
        let casted = qbe_cast_expr(e, ctx, deref.expr, deref.base_type, string_clone(&cast_target))
        let mut lines: [String] = []
        let mut k = 0
        while k < len(deref.lines) { push(&mut lines, deref.lines[k]); k = k + 1 }
        k = 0
        while k < len(casted.lines) { push(&mut lines, casted.lines[k]); k = k + 1 }
        let qt = qbe_type(cast_target, &ctx.enum_names,  &ctx.struct_fields)
        return QbeCallArg { text: qt + " " + casted.expr, lines: lines }
    }
    let casted = qbe_cast_operand(e, ctx, op, string_clone(&target))
    let qt = qbe_type(target, &ctx.enum_names,  &ctx.struct_fields)
    return QbeCallArg { text: qt + " " + casted.expr, lines: casted.lines }
}

fn qbe_temp_get(e: &QbeEmitter, id: i32) -> i32 {
    let mut i = 0
    while i < len(e.temp_keys) {
        if e.temp_keys[i] == id { return e.temp_vals[i] }
        i = i + 1
    }
    return id
}

fn qbe_temp_set(e: &mut QbeEmitter, id: i32, qid: i32) {
    let mut keys = e.temp_keys
    let mut vals = e.temp_vals
    let mut i = 0
    while i < len(keys) {
        if keys[i] == id {
            vals[i] = qid
            e.temp_keys = keys
            e.temp_vals = vals
            return
        }
        i = i + 1
    }
    push(&mut keys, id)
    push(&mut vals, qid)
    e.temp_keys = keys
    e.temp_vals = vals
}

fn qbe_temp_reset(e: &mut QbeEmitter, param_count: i32) {
    e.temp_keys = qbe_i32_list_new()
    e.temp_vals = qbe_i32_list_new()
    let mut i = 0
    while i < param_count {
        qbe_temp_set(e, i, i)
        i = i + 1
    }
}

fn qbe_temp_name_raw(id: i32) -> String {
    return "%t" + int_to_string(id)
}

fn qbe_temp_name_ir(e: &QbeEmitter, id: i32) -> String {
    return qbe_temp_name_raw(qbe_temp_get(e, id))
}

fn qbe_bind_dst(e: &mut QbeEmitter, dst: i32) -> i32 {
    if dst < 0 { return -1 }
    let qid = qbe_new_temp(e)
    qbe_temp_set(e, dst, qid)
    return qid
}

fn qbe_new_temp(e: &mut QbeEmitter) -> i32 {
    let id = e.temp_id
    e.temp_id = e.temp_id + 1
    return id
}

fn qbe_make_alloc(size: i32, qtype: String) -> String {
    if qtype == "l" {
        return "alloc8 " + int_to_string(size)
    }
    if qtype == "w" || qtype == "h" || qtype == "b" {
        return "alloc4 " + int_to_string(size)
    }
    return "alloc8 " + int_to_string(size)
}

fn qbe_collect_strings_from_operand(e: &mut QbeEmitter, op: IrOperand) {
    if op.is_const {
        let v = op.value
        if v.kind == ir_kind_string() {
            let _ = qbe_string_id(e, v.str)
        }
    }
}

fn qbe_collect_strings_from_instr(e: &mut QbeEmitter, inst: IrInstr) {
    match inst {
        IrInstr.LoadVar(_) => {}
        IrInstr.StoreVar(i) => { qbe_collect_strings_from_operand(e, i.src) }
        IrInstr.BinOp(i) => { qbe_collect_strings_from_operand(e, i.lhs); qbe_collect_strings_from_operand(e, i.rhs) }
        IrInstr.Call(i) => {
            let mut j = 0
            while j < len(i.args) { qbe_collect_strings_from_operand(e, i.args[j]); j = j + 1 }
        }
        IrInstr.CallClosure(i) => {
            qbe_collect_strings_from_operand(e, i.closure)
            let mut j = 0
            while j < len(i.args) { qbe_collect_strings_from_operand(e, i.args[j]); j = j + 1 }
        }
        IrInstr.MakeArray(i) => {
            let mut j = 0
            while j < len(i.elems) { qbe_collect_strings_from_operand(e, i.elems[j]); j = j + 1 }
        }
        IrInstr.Index(i) => { qbe_collect_strings_from_operand(e, i.array); qbe_collect_strings_from_operand(e, i.index) }
        IrInstr.SetIndex(i) => { qbe_collect_strings_from_operand(e, i.array); qbe_collect_strings_from_operand(e, i.index); qbe_collect_strings_from_operand(e, i.src) }
        IrInstr.MakeStruct(i) => {
            let mut j = 0
            while j < len(i.fields) { qbe_collect_strings_from_operand(e, i.fields[j].src); j = j + 1 }
        }
        IrInstr.GetField(_) => {}
        IrInstr.SetField(i) => { qbe_collect_strings_from_operand(e, i.value) }
    }
}

fn qbe_collect_strings_from_term(e: &mut QbeEmitter, term: IrTerm) {
    match term {
        IrTerm.Return(t) => { if t.has_value { qbe_collect_strings_from_operand(e, t.value) } }
        .Branch(t) => { qbe_collect_strings_from_operand(e, t.cond) }
        _ => {}
    }
}

fn qbe_collect_strings_from_func(e: &mut QbeEmitter, f: &IrFunction) {
    qbe_prof_inc(e, "qbe.qbe_collect_strings_from_func")
    let mut b = 0
    while b < len(f.blocks) {
        let blk = f.blocks[b]
        let mut j = 0
        while j < len(blk.instrs) {
            qbe_collect_strings_from_instr(e, blk.instrs[j])
            j = j + 1
        }
        qbe_collect_strings_from_term(e, blk.term)
        b = b + 1
    }
}

fn qbe_dispatch_key(ret_type: &str, arg_types: & [String]) -> String {
    let mut out = string_clone(ret_type) + "("
    let mut i = 0
    while i < len(arg_types) {
        if i > 0 { out = out + "," }
        out = out + string_clone(&arg_types[i])
        i = i + 1
    }
    return out + ")"
}

fn qbe_dispatch_helper_name(e: &mut QbeEmitter, ret_type: String, arg_types: [String]) -> String {
    let key = qbe_dispatch_key(&ret_type, &arg_types)
    let existing = string_map_get(&e.dispatch_map, &key)
    if existing != "" { return existing }
    let name = "__dast_closure_dispatch_" + int_to_string(len(e.dispatch_helpers))
    let mut items = e.dispatch_helpers
    push(&mut items, QbeDispatchHelper { name: string_clone(&name), ret_type: ret_type, arg_types: arg_types })
    let mut map = e.dispatch_map
    let _ = string_map_set(&mut map, key, string_clone(&name))
    e.dispatch_helpers = items
    e.dispatch_map = map
    return name
}

fn qbe_emit_data_section(e: &mut QbeEmitter) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(e.strings) {
        let s = e.strings[i]
        out = out + "data $" + s.data_label + " = { b \"" + qbe_escape_string(s.text) + "\", b 0 }\n"
        out = out + "data $" + s.struct_label + " = { l $" + s.data_label + ", l " + int_to_string(s.len) + ", l " + int_to_string(s.len + 1) + " }\n"
        i = i + 1
    }
    if out != "" { out = out + "\n" }
    return out
}

fn qbe_emit_instr(e: &mut QbeEmitter, ctx_in: &QbeFuncCtx, inst: IrInstr) -> [String] {
    let ctx = ctx_in
    match inst {
        IrInstr.LoadVar(i) => {
            let mut out: [String] = []
            let dst_qid = qbe_bind_dst(e, i.dst)
            if i.addr {
                push(&mut out, qbe_temp_name_raw(dst_qid) + " =l copy %" + qbe_var_slot(i.name))
                return out
            }
            if i.ref {
                let mut base = ""
                if i.ref_temp >= 0 && i.ref_temp < len(ctx.infer.temp_types) {
                    let rt = ctx.infer.temp_types[i.ref_temp]
                    if qbe_is_ref_type(string_clone(&rt)) { base = qbe_ref_base_type(rt) }
                }
                if base == "" && i.dst >= 0 && i.dst < len(ctx.infer.temp_types) { base = ctx.infer.temp_types[i.dst] }
                if base == "" { base = "int" }
                let q = qbe_type(base, &ctx.enum_names,  &ctx.struct_fields)
                push(&mut out, qbe_temp_name_raw(dst_qid) + " =" + q + " load " + qbe_temp_name_ir(e, i.ref_temp))
                return out
            }
            let mut vt = ""
            if i.name != "" { vt = string_map_get(&ctx.infer.var_types, &i.name) }
            if vt == "" { vt = "int" }
            let q = qbe_type(vt, &ctx.enum_names,  &ctx.struct_fields)
            push(&mut out, qbe_temp_name_raw(dst_qid) + " =" + q + " load %" + qbe_var_slot(i.name))
            return out
        }
        IrInstr.StoreVar(i) => {
            let mut out: [String] = []
            let mut vt = ""
            if i.name != "" { vt = string_map_get(&ctx.infer.var_types, &i.name) }
            let src_t = qbe_operand_def_type(&i.src, &ctx.infer)
            if vt == "" { vt = src_t }
            if vt == "" { vt = "int" }
            let casted = qbe_cast_operand(e, ctx, &i.src, string_clone(&vt))
            let mut k = 0
            while k < len(casted.lines) { push(&mut out, casted.lines[k]); k = k + 1 }
            let q = qbe_type(vt, &ctx.enum_names,  &ctx.struct_fields)
            if i.ref {
                push(&mut out, "store" + q + " " + casted.expr + ", " + qbe_temp_name_ir(e, i.ref_temp))
            } else {
                push(&mut out, "store" + q + " " + casted.expr + ", %" + qbe_var_slot(i.name))
            }
            return out
        }
        IrInstr.BinOp(i) => {
            let mut out: [String] = []
            let dst_qid = qbe_bind_dst(e, i.dst)
            let lt = qbe_operand_def_type(&i.lhs, &ctx.infer)
            let rt = qbe_operand_def_type(&i.rhs, &ctx.infer)
            if qbe_is_string_type(string_clone(&lt)) || qbe_is_string_type(string_clone(&rt)) {
                if i.op == "+" {
                    let lhs = qbe_cast_operand(e, ctx, &i.lhs, "String")
                    let rhs = qbe_cast_operand(e, ctx, &i.rhs, "String")
                    let mut k = 0
                    while k < len(lhs.lines) { push(&mut out, lhs.lines[k]); k = k + 1 }
                    k = 0
                    while k < len(rhs.lines) { push(&mut out, rhs.lines[k]); k = k + 1 }
                    push(&mut out, qbe_temp_name_raw(dst_qid) + " =l call $dast_string_concat_ptr(l " + lhs.expr + ", l " + rhs.expr + ")")
                    return out
                }
                if i.op == "==" || i.op == "!=" {
                    let lhs = qbe_cast_operand(e, ctx, &i.lhs, "String")
                    let rhs = qbe_cast_operand(e, ctx, &i.rhs, "String")
                    let mut k = 0
                    while k < len(lhs.lines) { push(&mut out, lhs.lines[k]); k = k + 1 }
                    k = 0
                    while k < len(rhs.lines) { push(&mut out, rhs.lines[k]); k = k + 1 }
                    let tmp = dst_qid
                    if i.op == "!=" {
                        let t2 = qbe_new_temp(e)
                        push(&mut out, qbe_temp_name_raw(t2) + " =w call $dast_string_eq_ptr(l " + lhs.expr + ", l " + rhs.expr + ")")
                        push(&mut out, qbe_temp_name_raw(tmp) + " =w xor " + qbe_temp_name_raw(t2) + ", 1")
                    } else {
                        push(&mut out, qbe_temp_name_raw(tmp) + " =w call $dast_string_eq_ptr(l " + lhs.expr + ", l " + rhs.expr + ")")
                    }
                    return out
                }
            }
            let mut typ = qbe_unify_type(lt, rt)
            if typ == "" { typ = "int" }
            if qbe_is_compare_op(i.op) {
                let lhs = qbe_cast_operand(e, ctx, &i.lhs, string_clone(&typ))
                let rhs = qbe_cast_operand(e, ctx, &i.rhs, string_clone(&typ))
                let mut k = 0
                while k < len(lhs.lines) { push(&mut out, lhs.lines[k]); k = k + 1 }
                k = 0
                while k < len(rhs.lines) { push(&mut out, rhs.lines[k]); k = k + 1 }
                let qt = qbe_type(typ, &ctx.enum_names,  &ctx.struct_fields)
                let op = qbe_cmp_op(i.op, qt)
                push(&mut out, qbe_temp_name_raw(dst_qid) + " =w " + op + " " + lhs.expr + ", " + rhs.expr)
                return out
            }
            let lhs = qbe_cast_operand(e, ctx, &i.lhs, string_clone(&typ))
            let rhs = qbe_cast_operand(e, ctx, &i.rhs, string_clone(&typ))
            let mut k = 0
            while k < len(lhs.lines) { push(&mut out, lhs.lines[k]); k = k + 1 }
            k = 0
            while k < len(rhs.lines) { push(&mut out, rhs.lines[k]); k = k + 1 }
            let qt = qbe_type(typ, &ctx.enum_names,  &ctx.struct_fields)
            let op = qbe_arith_op(i.op)
            push(&mut out, qbe_temp_name_raw(dst_qid) + " =" + qt + " " + op + " " + lhs.expr + ", " + rhs.expr)
            return out
        }
        IrInstr.Call(i) => {
            let mut out: [String] = []
            let dst_qid = qbe_bind_dst(e, i.dst)
            let name = i.callee
            if name == "print" || name == "println" || name == "eprint" || name == "eprintln" {
                let mut use_err = false
                if name == "eprint" || name == "eprintln" { use_err = true }
                let mut fn_print = "dast_print_ptr"
                let mut fn_print_cstr = "dast_print_cstr"
                let mut fn_print_int = "dast_print_int"
                let mut fn_print_bool = "dast_print_bool"
                let mut fn_print_newline = "dast_print_newline"
                let mut fn_print_array = "dast_print_array"
                if use_err {
                    fn_print = "dast_eprint_ptr"
                    fn_print_cstr = "dast_eprint_cstr"
                    fn_print_int = "dast_eprint_int"
                    fn_print_bool = "dast_eprint_bool"
                    fn_print_newline = "dast_eprint_newline"
                    fn_print_array = "dast_eprint_array"
                }
                let mut j = 0
                while j < len(i.args) {
                    if j > 0 {
                        let label = qbe_string_data_label(e, " ")
                        push(&mut out, "call $" + fn_print_cstr + "(l $" + label + ")")
                    }
                    let t = qbe_operand_def_type(&i.args[j], &ctx.infer)
                    if qbe_is_string_type(string_clone(&t)) {
                        let casted = qbe_cast_operand(e, ctx, &i.args[j], "String")
                        let mut k = 0
                        while k < len(casted.lines) { push(&mut out, casted.lines[k]); k = k + 1 }
                        push(&mut out, "call $" + fn_print + "(l " + casted.expr + ")")
                    } else if qbe_is_bool_type(string_clone(&t)) {
                        let casted = qbe_cast_operand(e, ctx, &i.args[j], "bool")
                        let mut k = 0
                        while k < len(casted.lines) { push(&mut out, casted.lines[k]); k = k + 1 }
                        push(&mut out, "call $" + fn_print_bool + "(w " + casted.expr + ")")
                    } else if qbe_is_int_type(string_clone(&t)) {
                        let casted = qbe_cast_operand(e, ctx, &i.args[j], "int")
                        let mut k = 0
                        while k < len(casted.lines) { push(&mut out, casted.lines[k]); k = k + 1 }
                        push(&mut out, "call $" + fn_print_int + "(l " + casted.expr + ")")
                    } else if qbe_is_array_type(string_clone(&t)) {
                        let casted = qbe_cast_operand(e, ctx, &i.args[j], string_clone(&t))
                        let mut k = 0
                        while k < len(casted.lines) { push(&mut out, casted.lines[k]); k = k + 1 }
                        push(&mut out, "call $" + fn_print_array + "(l " + casted.expr + ")")
                    } else if qbe_is_struct_type(string_clone(&t)) || cg_struct_is_enum(&ctx.enum_names, string_clone(&t)) {
                        let label = qbe_string_data_label(e, "<struct>")
                        push(&mut out, "call $" + fn_print_cstr + "(l $" + label + ")")
                    } else {
                        let label = qbe_string_data_label(e, "<value>")
                        push(&mut out, "call $" + fn_print_cstr + "(l $" + label + ")")
                    }
                    j = j + 1
                }
                if name == "println" || name == "eprintln" {
                    push(&mut out, "call $" + fn_print_newline + "()")
                }
                if i.dst >= 0 {
                    push(&mut out, qbe_temp_name_raw(dst_qid) + " =w copy 0")
                }
                return out
            }
            if name == "len" {
                if len(i.args) > 0 {
                    let deref = qbe_deref_operand(e, ctx, &i.args[0])
                    let mut k = 0
                    while k < len(deref.lines) { push(&mut out, deref.lines[k]); k = k + 1 }
                    if qbe_is_string_type(deref.base_type) {
                        if i.dst >= 0 {
                            push(&mut out, qbe_temp_name_raw(dst_qid) + " =l call $dast_string_len_ptr(l " + deref.expr + ")")
                        } else {
                            push(&mut out, "call $dast_string_len_ptr(l " + deref.expr + ")")
                        }
                    } else {
                        if i.dst >= 0 {
                            push(&mut out, qbe_temp_name_raw(dst_qid) + " =l call $dast_array_len_ptr(l " + deref.expr + ")")
                        } else {
                            push(&mut out, "call $dast_array_len_ptr(l " + deref.expr + ")")
                        }
                    }
                }
                return out
            }
            if name == "push" {
                if len(i.args) >= 2 {
                    let deref = qbe_deref_operand(e, ctx, &i.args[0])
                    let mut k = 0
                    while k < len(deref.lines) { push(&mut out, deref.lines[k]); k = k + 1 }
                    let elem = qbe_array_elem_type(deref.base_type)
                    let elem_size = qbe_type_size(string_clone(&elem), &ctx.enum_names,  &ctx.struct_fields)
                    let q = qbe_type(string_clone(&elem), &ctx.enum_names,  &ctx.struct_fields)
                    let casted = qbe_cast_operand(e, ctx, &i.args[1], string_clone(&elem))
                    k = 0
                    while k < len(casted.lines) { push(&mut out, casted.lines[k]); k = k + 1 }
                    let slot = qbe_new_temp(e)
                    push(&mut out, qbe_temp_name_raw(slot) + " =l " + qbe_make_alloc(elem_size, string_clone(&q)))
                    push(&mut out, "store" + q + " " + casted.expr + ", " + qbe_temp_name_raw(slot))
                    push(&mut out, "call $dast_array_push_ptr(l " + deref.expr + ", l " + qbe_temp_name_raw(slot) + ")")
                }
                if i.dst >= 0 { push(&mut out, qbe_temp_name_raw(dst_qid) + " =w copy 0") }
                return out
            }
            if name == "pop" {
                if len(i.args) >= 1 {
                    let deref = qbe_deref_operand(e, ctx, &i.args[0])
                    let mut k = 0
                    while k < len(deref.lines) { push(&mut out, deref.lines[k]); k = k + 1 }
                    let elem = qbe_array_elem_type(deref.base_type)
                    let elem_size = qbe_type_size(string_clone(&elem), &ctx.enum_names,  &ctx.struct_fields)
                    let q = qbe_type(string_clone(&elem), &ctx.enum_names,  &ctx.struct_fields)
                    let slot = qbe_new_temp(e)
                    push(&mut out, qbe_temp_name_raw(slot) + " =l " + qbe_make_alloc(elem_size, string_clone(&q)))
                    push(&mut out, "call $dast_array_pop_ptr(l " + deref.expr + ", l " + qbe_temp_name_raw(slot) + ")")
                    if i.dst >= 0 {
                        push(&mut out, qbe_temp_name_raw(dst_qid) + " =" + q + " load " + qbe_temp_name_raw(slot))
                    }
                }
                return out
            }
            if name == "read_file" {
                let arg0 = qbe_call_arg(e, ctx, &i.args[0], "&str")
                let mut k = 0
                while k < len(arg0.lines) { push(&mut out, arg0.lines[k]); k = k + 1 }
                if i.dst >= 0 {
                    push(&mut out, qbe_temp_name_raw(dst_qid) + " =l call $dast_read_file_ptr(" + arg0.text + ")")
                } else {
                    push(&mut out, "call $dast_read_file_ptr(" + arg0.text + ")")
                }
                return out
            }
            if name == "read_dir" {
                let arg0 = qbe_call_arg(e, ctx, &i.args[0], "&str")
                let mut k = 0
                while k < len(arg0.lines) { push(&mut out, arg0.lines[k]); k = k + 1 }
                if i.dst >= 0 {
                    push(&mut out, qbe_temp_name_raw(dst_qid) + " =l call $dast_read_dir_ptr(" + arg0.text + ")")
                } else {
                    push(&mut out, "call $dast_read_dir_ptr(" + arg0.text + ")")
                }
                return out
            }
            if name == "write_file" {
                let arg0 = qbe_call_arg(e, ctx, &i.args[0], "&str")
                let arg1 = qbe_call_arg(e, ctx, &i.args[1], "&str")
                let mut k = 0
                while k < len(arg0.lines) { push(&mut out, arg0.lines[k]); k = k + 1 }
                k = 0
                while k < len(arg1.lines) { push(&mut out, arg1.lines[k]); k = k + 1 }
                push(&mut out, "call $dast_write_file_ptr(" + arg0.text + ", " + arg1.text + ")")
                if i.dst >= 0 { push(&mut out, qbe_temp_name_raw(dst_qid) + " =w copy 0") }
                return out
            }
