struct MacroSite {
    id: i32,
    kind: i32,
    pos: i32,
    module: String,
    file: String,
    expr: Expr,
}

fn site_kind_expr() -> i32 { return 0 }
fn site_kind_stmt() -> i32 { return 1 }
fn site_kind_item() -> i32 { return 2 }

struct MacroExpandResult {
    prog: Program,
    errors: [ParseError],
}

struct MacroExpander {
    sites: [MacroSite],
    next_id: i32,
    errors: [ParseError],
    debug: bool,
}

fn param_list_new() -> [Param] {
    let mut items: [Param] = []
    return items
}

fn field_list_new() -> [Field] {
    let mut items: [Field] = []
    return items
}

fn variant_list_new() -> [Variant] {
    let mut items: [Variant] = []
    return items
}

fn assoc_type_list_new() -> [AssociatedType] {
    let mut items: [AssociatedType] = []
    return items
}

fn trait_method_list_new() -> [TraitMethod] {
    let mut items: [TraitMethod] = []
    return items
}

fn stmt_list_new() -> [Stmt] {
    let mut items: [Stmt] = []
    return items
}

fn macro_site_list_new() -> [MacroSite] {
    let mut items: [MacroSite] = []
    return items
}

fn macro_add_error(exp: &mut MacroExpander, pos: i32, file: &str, msg: String) {
    let mut errs = exp.errors
    push(&mut errs, ParseError { pos: pos, file: string_clone(file), line: 0, col: 0, msg: msg })
    exp.errors = errs
}

fn macro_site_dummy() -> MacroSite {
    return MacroSite { id: -1, kind: site_kind_expr(), pos: 0, module: "", file: "", expr: Expr.IntLit(IntLit { pos: 0, value: "0" }) }
}

fn macro_add_site(exp: &mut MacroExpander, kind: i32, pos: i32, module: &str, file: &str, expr: Expr) -> i32 {
    let id = exp.next_id
    exp.next_id = exp.next_id + 1
    let mut sites = exp.sites
    push(&mut sites, MacroSite { id: id, kind: kind, pos: pos, module: string_clone(module), file: string_clone(file), expr: expr })
    exp.sites = sites
    return id
}

fn macro_wrapper_name(id: i32) -> String {
    return "__dast_compile_eval_" + int_to_string(id)
}

fn macro_vis_private() -> Visibility {
    return Visibility { kind: vis_private() }
}

fn clone_visibility(v: &Visibility) -> Visibility {
    return Visibility { kind: v.kind }
}

fn clone_const_value(v: &ConstValue) -> ConstValue {
    return ConstValue {
        kind: v.kind,
        int_value: string_clone(&v.int_value),
        str_value: string_clone(&v.str_value),
        bool_value: v.bool_value,
    }
}

fn clone_trait_bound(b: &TraitBound) -> TraitBound {
    return TraitBound { pos: b.pos, trait_name: string_clone(&b.trait_name) }
}

fn clone_trait_bound_list(items: & [TraitBound]) -> [TraitBound] {
    let mut out: [TraitBound] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, clone_trait_bound(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn clone_generic_param(p: &GenericParam) -> GenericParam {
    return GenericParam { pos: p.pos, name: string_clone(&p.name), bounds: clone_trait_bound_list(&p.bounds) }
}

