fn clone_pattern(p: &Pattern) -> Pattern {
    match *p {
        Pattern.Wildcard(_) => { return Pattern.Wildcard(WildcardPattern {}) }
        Pattern.Bind(b) => { return Pattern.Bind(BindPattern { pos: b.pos, name: string_clone(&b.name) }) }
        Pattern.Variant(v) => {
            return Pattern.Variant(VariantPattern {
                pos: v.pos,
                enum_name: string_clone(&v.enum_name),
                variant: string_clone(&v.variant),
                has_binding: v.has_binding,
                binding: string_clone(&v.binding),
            })
        }
        Pattern.Struct(s) => {
            return Pattern.Struct(StructPattern {
                pos: s.pos,
                name: string_clone(&s.name),
                fields: clone_struct_pattern_field_list(&s.fields),
                has_rest: s.has_rest,
            })
        }
        Pattern.Range(r) => {
            return Pattern.Range(RangePattern { pos: r.pos, start: clone_const_value(&r.start), end: clone_const_value(&r.end), inclusive: r.inclusive })
        }
        Pattern.Literal(l) => {
            return Pattern.Literal(LiteralPattern { pos: l.pos, value: clone_const_value(&l.value) })
        }
    }
}

fn clone_struct_pattern_field(f: &StructPatternField) -> StructPatternField {
    return StructPatternField {
        pos: f.pos,
        name: string_clone(&f.name),
        bind: f.bind,
        has_pattern: f.has_pattern,
        pattern: clone_pattern(&f.pattern),
    }
}

