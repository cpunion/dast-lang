    }
    return out
}

fn clone_stmt(s: &Stmt) -> Stmt {
    match *s {
        Stmt.Let(v) => {
            return Stmt.Let(LetStmt { pos: v.pos, name: string_clone(&v.name), mutable: v.mutable, has_type: v.has_type, typ: string_clone(&v.typ), has_init: v.has_init, init: clone_expr(&v.init) })
        }
        Stmt.Return(v) => {
            return Stmt.Return(ReturnStmt { pos: v.pos, has_value: v.has_value, value: clone_expr(&v.value) })
        }
        Stmt.Expr(v) => {
            return Stmt.Expr(ExprStmt { pos: v.pos, expr: clone_expr(&v.expr) })
        }
        Stmt.If(v) => {
            return Stmt.If(IfStmt { pos: v.pos, cond: clone_expr(&v.cond), then_block: clone_block(&v.then_block), has_else: v.has_else, else_block: clone_block(&v.else_block) })
        }
        Stmt.Assign(v) => {
            return Stmt.Assign(AssignStmt { pos: v.pos, target: clone_expr(&v.target), value: clone_expr(&v.value) })
        }
        Stmt.While(v) => {
            return Stmt.While(WhileStmt { pos: v.pos, cond: clone_expr(&v.cond), body: clone_block(&v.body) })
        }
        Stmt.Match(v) => {
            return Stmt.Match(MatchStmt { pos: v.pos, expr: clone_expr(&v.expr), arms: clone_match_arm_list(&v.arms) })
        }
        Stmt.Break(v) => { return Stmt.Break(BreakStmt { pos: v.pos }) }
        Stmt.Continue(v) => { return Stmt.Continue(ContinueStmt { pos: v.pos }) }
    }
}

fn clone_expr(e: &Expr) -> Expr {
    match *e {
        Expr.Ident(v) => { return Expr.Ident(IdentExpr { pos: v.pos, name: string_clone(&v.name) }) }
        Expr.IntLit(v) => { return Expr.IntLit(IntLit { pos: v.pos, value: string_clone(&v.value) }) }
        Expr.StringLit(v) => { return Expr.StringLit(StringLit { pos: v.pos, value: string_clone(&v.value) }) }
        Expr.BoolLit(v) => { return Expr.BoolLit(BoolLit { pos: v.pos, value: v.value }) }
        Expr.Unary(v) => { return Expr.Unary(UnaryExpr { pos: v.pos, op: v.op, expr: clone_expr(&v.expr) }) }
        Expr.Binary(v) => { return Expr.Binary(BinaryExpr { pos: v.pos, op: v.op, left: clone_expr(&v.left), right: clone_expr(&v.right) }) }
        Expr.Call(v) => { return Expr.Call(CallExpr { pos: v.pos, callee: clone_expr(&v.callee), type_args: clone_string_list(&v.type_args), args: clone_expr_list(&v.args) }) }
        Expr.MethodCall(v) => {
            return Expr.MethodCall(MethodCallExpr {
                pos: v.pos,
                recv: clone_expr(&v.recv),
                method: string_clone(&v.method),
                args: clone_expr_list(&v.args),
                resolved_name: string_clone(&v.resolved_name),
                resolved_self: v.resolved_self,
                enum_name: string_clone(&v.enum_name),
            })
        }
        Expr.MacroCall(v) => { return Expr.MacroCall(MacroCallExpr { pos: v.pos, callee: clone_expr(&v.callee), args: clone_expr_list(&v.args) }) }
        Expr.Index(v) => { return Expr.Index(IndexExpr { pos: v.pos, recv: clone_expr(&v.recv), index: clone_expr(&v.index) }) }
        Expr.Field(v) => { return Expr.Field(FieldExpr { pos: v.pos, recv: clone_expr(&v.recv), name: string_clone(&v.name) }) }
        Expr.StructLit(v) => { return Expr.StructLit(StructLit { pos: v.pos, name: string_clone(&v.name), fields: clone_field_init_list(&v.fields) }) }
        Expr.ArrayLit(v) => { return Expr.ArrayLit(ArrayLit { pos: v.pos, elems: clone_expr_list(&v.elems) }) }
        Expr.Ref(v) => { return Expr.Ref(RefExpr { pos: v.pos, mutable: v.mutable, expr: clone_expr(&v.expr) }) }
        Expr.Deref(v) => { return Expr.Deref(DerefExpr { pos: v.pos, expr: clone_expr(&v.expr) }) }
        Expr.IfLet(v) => {
            return Expr.IfLet(IfLetExpr {
                pos: v.pos,
                pattern: clone_pattern(&v.pattern),
                expr: clone_expr(&v.expr),
                then_block: clone_block(&v.then_block),
                has_else: v.has_else,
                else_block: clone_block(&v.else_block),
            })
        }
        Expr.Closure(v) => {
            return Expr.Closure(ClosureExpr {
                pos: v.pos,
                params: clone_closure_param_list(&v.params),
                has_ret_type: v.has_ret_type,
                ret_type: string_clone(&v.ret_type),
                body: clone_expr(&v.body),
            })
        }
        Expr.Block(v) => {
            return Expr.Block(BlockExpr {
                pos: v.pos,
                stmts: clone_stmt_list(&v.stmts),
                has_result: v.has_result,
                result: clone_expr(&v.result),
            })
        }
        Expr.Quote(v) => { return Expr.Quote(QuoteExpr { pos: v.pos, kind: v.kind, parts: clone_quote_part_list(&v.parts) }) }
        Expr.Compile(v) => { return Expr.Compile(CompileExpr { pos: v.pos, id: v.id, expr: clone_expr(&v.expr) }) }
    }
}

fn clone_stmt_list(items: & [Stmt]) -> [Stmt] {
    let mut out: [Stmt] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, clone_stmt(&(*items)[i]))
        i = i + 1
    }
    return out
}

