// Test that trait bounds are verified at generic instantiation

trait Cloneable {
    fn clone(&self) -> int;
}

struct HasClone {
    v: int,
}

impl Cloneable for HasClone {
    fn clone(&self) -> int {
        return self.v
    }
}

struct NoClone {
    x: int,
}

// Generic function with trait bound
fn copy_value[T: Cloneable](x: int) -> int {
    return x
}

fn main() {
    // This should fail: NoClone does not implement Cloneable
    let result = copy_value::[NoClone](42)
    println("should not reach here", result)
}
