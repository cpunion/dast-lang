// Test associated types in traits
import "std/testing" as t

trait Container {
    type Item;
    fn get(&self) -> int;
}

struct IntVec {
    data: int,
}

impl Container for IntVec {
    type Item = int;
    fn get(&self) -> int {
        return self.data
    }
}

fn test_main() {
    let v = IntVec { data: 42 }
    let result = v.get()
    t.assert_eq!(result, 42)
}
