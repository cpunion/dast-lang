// Test generic trait bounds parsing
import "std/testing" as t

trait Cloneable {
    fn clone(&self) -> int;
}

struct Value {
    data: int,
}

impl Cloneable for Value {
    fn clone(&self) -> int {
        return self.data
    }
}

// Generic function with trait bound - parsing test
// Note: Full trait bound enforcement during instantiation is not yet implemented
fn with_bound[T: Cloneable](x: int) -> int {
    return x
}

// Multiple trait bounds
fn with_multi_bounds[T: Cloneable + Cloneable](x: int) -> int {
    return x
}

fn test_main() {
    let v = Value { data: 42 }
    let result = v.clone()
    t.assert_eq!(result, 42)
}
