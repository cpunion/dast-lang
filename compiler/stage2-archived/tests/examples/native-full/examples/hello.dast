import "native_full" as nf

fn main() {
    let mut c = nf.counter_new(1)
    let v = (&mut c).add(2)
    let g = (&c).get()
    println("counter", v, g)

    let p = nf.make_point(3, 4)
    let psum = (&p).sum()
    let px = nf.point_x(&p)
    let py = nf.point_y(&p)
    println("point", px, py, psum)

    let m = nf.maybe_add(3, 4)
    let u = nf.unwrap_or(m, 0)
    println("maybe", u)

    let arr = [1, 2, 3]
    let s = nf.sum_array(arr)
    println("sum", s)

    let mut a = [1, 2, 3]
    push(&mut a, 4)
    let last = pop(&mut a)
    println("last", last)
    let idx = a[1]
    println("idx", idx)
    a[0] = 9
    println("a0", a[0])

    let mut x = 10
    nf.inc_ref(&mut x, 5)
    println("x", x)

    let text = "hello"
    let ch = char_at(text, 1)
    let sub = substr(text, 1, 3)
    println("str", ch, sub, len(text))

    let mut n = 0
    let mut acc = 0
    loop {
        if n == 5 { break }
        if n % 2 == 0 { n = n + 1; continue }
        acc = acc + n
        n = n + 1
    }
    println("acc", acc)

    let t = nf.classify(-1)
    println("class", t)
}
