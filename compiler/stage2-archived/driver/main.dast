struct ArgSplit {
    files: [String],
    rest: [String],
}

struct ArgSplitPkg {
    files: [String],
    rest: [String],
    package: String,
    example: String,
    debug: bool,
    emit_ir: bool,
    bootstrap: bool,
}

struct LineCol {
    line: i32,
    col: i32,
}

struct ParseResult {
    prog: Program,
    errors: [ParseError],
}

struct TestCollect {
    tests: [String],
    errors: [ParseError],
}

fn parse_error_clone(e: &ParseError) -> ParseError {
    return ParseError {
        pos: e.pos,
        file: string_clone(&e.file),
        line: e.line,
        col: e.col,
        msg: string_clone(&e.msg),
    }
}

struct Manifest {
    has_package: bool,
    package_line: i32,
    name: String,
    version: String,
    edition: String,
    has_workspace: bool,
    workspace_line: i32,
    workspace_members: [String],
    deps: [String],
    dev_deps: [String],
    build_deps: [String],
}

struct ManifestResult {
    manifest: Manifest,
    errors: [ParseError],
}

fn struct_list_new() -> [StructDecl] {
    let mut items: [StructDecl] = []
    return items
}

fn enum_list_new() -> [EnumDecl] {
    let mut items: [EnumDecl] = []
    return items
}

fn const_list_new() -> [ConstDecl] {
    let mut items: [ConstDecl] = []
    return items
}

fn impl_list_new() -> [ImplDecl] {
    let mut items: [ImplDecl] = []
    return items
}

fn import_list_new() -> [ImportDecl] {
    let mut items: [ImportDecl] = []
    return items
}

fn driver_string_list_new() -> [String] {
    let mut items: [String] = []
    return items
}

fn manifest_empty() -> Manifest {
    return Manifest {
        has_package: false,
        package_line: 0,
        name: "",
        version: "",
        edition: "",
        has_workspace: false,
        workspace_line: 0,
        workspace_members: driver_string_list_new(),
        deps: driver_string_list_new(),
        dev_deps: driver_string_list_new(),
        build_deps: driver_string_list_new(),
    }
}

fn program_empty() -> Program {
    return Program {
        imports: import_list_new(),
        structs: struct_list_new(),
        enums: enum_list_new(),
        consts: const_list_new(),
        traits: trait_list_new(),
        type_aliases: type_alias_list_new(),
        functions: func_list_new(),
        impls: impl_list_new(),
        impl_traits: impl_trait_list_new(),
        compile_items: compile_item_list_new(),
    }
}

fn driver_qualify_name(module: &str, name: &str) -> String {
    if *module == "" { return string_clone(name) }
    return string_clone(module) + "::" + string_clone(name)
}

fn usage() {
    println("usage:")
    println("  dast build [--bootstrap] [-c|--emit-ir] [--package name] [--example name] <file.dast|dir> [more ...]")
    println("  dast run [--package name] [--example name] <file.dast|dir> [more ...] [-- args...]")
    println("  dast ir [--package name] [--example name] <file.dast|dir> [more ...]")
    println("  dast test [--package name] <file.dast|dir> [more ...]")
    // ir-run disabled while interp backend is not built
    println("  dast ir-verify <file.ir>")
    println("  dast ir-opt <file.ir>")
}

fn die_usage() {
    usage()
    exit(1)
}

fn die_error(msg: String) {
    print_error_line("", 0, 0, msg)
    exit(1)
}

fn die_parse(file: String, line: i32, msg: String) {
    print_error_line(file, line, 1, msg)
    exit(1)
}

fn die_errors(errors: & [ParseError]) {
    print_errors(errors)
    exit(1)
}

fn handle_runtime_error(err: String) {
    if err == "" { return }
    let exit_prefix = "exit "
    if driver_string_starts_with(&err, &exit_prefix) {
        let err_len = len(string_clone(&err))
        let code = parse_int(substr(err, 5, err_len - 5))
        exit(code)
    }
    print_error_line("<runtime>", 0, 0, err)
    exit(1)
}

fn split_args(args: [String], start: i32) -> ArgSplit {
    let mut files: [String] = []
    let mut rest: [String] = []
    let mut i = start
    let mut done = false
    while i < len(args) && !done {
        if args[i] == "--" {
            i = i + 1
            done = true
        } else {
            push(&mut files, string_clone(&args[i]))
            i = i + 1
        }
    }
    while i < len(args) {
        push(&mut rest, string_clone(&args[i]))
        i = i + 1
    }
    return ArgSplit { files: files, rest: rest }
}

fn split_args_with_pkg(args: [String], start: i32, include_tests: bool) -> ArgSplitPkg {
    let mut files: [String] = []
    let mut rest: [String] = []
    let mut pkg = ""
    let mut example = ""
    let mut debug = false
    let mut emit_ir = false
    let mut bootstrap = false
    let mut i = start
    let mut done = false
    while i < len(args) && !done {
        if args[i] == "--" {
            i = i + 1
            done = true
        } else if args[i] == "--debug" {
            debug = true
            i = i + 1
        } else if args[i] == "--bootstrap" {
            bootstrap = true
            i = i + 1
        } else if args[i] == "--emit-ir" {
            emit_ir = true
            i = i + 1
        } else if args[i] == "-c" {
            emit_ir = true
            i = i + 1
        } else if args[i] == "--package" || args[i] == "-p" {
            if i + 1 >= len(args) {
                die_usage()
            }
            pkg = string_clone(&args[i + 1])
            i = i + 2
        } else if args[i] == "--example" || args[i] == "-e" {
            if i + 1 >= len(args) {
                die_usage()
            }
            example = string_clone(&args[i + 1])
            i = i + 2
        } else {
            // Expand path (directory or file) to file list
            let expanded = expand_path_to_files(string_clone(&args[i]), include_tests)
            let mut j = 0
            while j < len(expanded) {
                push(&mut files, string_clone(&expanded[j]))
                j = j + 1
            }
            i = i + 1
        }
    }
    while i < len(args) {
        push(&mut rest, string_clone(&args[i]))
        i = i + 1
    }
    return ArgSplitPkg { files: files, rest: rest, package: pkg, example: example, debug: debug, emit_ir: emit_ir, bootstrap: bootstrap }
}

fn expand_path_to_files(path: String, include_tests: bool) -> [String] {
    let clean = driver_trim_space(&path)
    let dast_ext = ".dast"
    if driver_string_ends_with(&clean, &dast_ext) || driver_string_contains(&clean, &dast_ext) {
        let mut result: [String] = []
        push(&mut result, clean)
        return result
    }
    // Try to read as directory
    let names = read_dir(string_clone(&clean))
    if len(names) > 0 {
        // Check if this is a package/workspace directory (has dast.toml)
        let toml_name = "dast.toml"
        if driver_dir_has_entry(&clean, &toml_name) {
            // Check for src/ directory (package)
            let src_dir = "src"
            let src_path = driver_path_join(&clean, &src_dir)
            let src_names = read_dir(string_clone(&src_path))
            if len(src_names) > 0 {
                // It's a package - scan src/ directory recursively
                return driver_list_dast_files_recursive(src_path, include_tests)
            }
            // It's a workspace or package without src - return path itself
            // to allow workspace detection in main()
            let mut result: [String] = []
            push(&mut result, clean)
            return result
        }
        // It's a regular directory - scan for .dast files
        return driver_list_dast_files(clean, include_tests)
    }
    // It's a file - return as single-item list
    let mut result: [String] = []
    push(&mut result, clean)
    return result
}



fn parse_files(files: [String]) -> ParseResult {
    let mut merged = program_empty()
    let mut errs: [ParseError] = []
    let mut i = 0
    while i < len(files) {
        let src = read_file(files[i])
        let mut lex = lexer_new(string_clone(&src))
        let mut local_errs: [ParseError] = []
        let mut prog = parse_program(&src, &files[i], &mut lex, &mut local_errs)
        program_set_file(&mut prog, string_clone(&files[i]))
        append_program(&mut merged, prog)
        let mut j = 0
        while j < len(local_errs) {
            let e = local_errs[j]
            let mut line = 0
            let mut col = 0
            if e.pos >= 0 {
                let mut offset = 0
                if e.pos < len(lex.toks.items) {
                    offset = tok_start(&lex.toks, e.pos)
                } else {
                    offset = len(string_clone(&src))
                }
                let lc = line_col_from_offset(string_clone(&src), offset)
                line = lc.line
                col = lc.col
            }
            push(&mut errs, ParseError { pos: e.pos, file: string_clone(&files[i]), line: line, col: col, msg: e.msg })
            j = j + 1
        }
        i = i + 1
    }
    return ParseResult { prog: merged, errors: errs }
}

fn append_program(dst: &mut Program, src: Program) {
    let mut imports = dst.imports
    let mut i = 0
    while i < len(src.imports) {
        push(&mut imports, src.imports[i])
        i = i + 1
    }
    dst.imports = imports
    let mut structs = dst.structs
    i = 0
    while i < len(src.structs) {
        push(&mut structs, src.structs[i])
        i = i + 1
    }
    dst.structs = structs
    let mut enums = dst.enums
    i = 0
    while i < len(src.enums) {
        push(&mut enums, src.enums[i])
        i = i + 1
    }
    dst.enums = enums
    let mut consts = dst.consts
    i = 0
    while i < len(src.consts) {
        push(&mut consts, src.consts[i])
        i = i + 1
    }
    dst.consts = consts
    let mut traits_list = dst.traits
    i = 0
    while i < len(src.traits) {
        push(&mut traits_list, src.traits[i])
        i = i + 1
    }
    dst.traits = traits_list
    let mut impl_traits_list = dst.impl_traits
    i = 0
    while i < len(src.impl_traits) {
        push(&mut impl_traits_list, src.impl_traits[i])
        i = i + 1
    }
    dst.impl_traits = impl_traits_list
    let mut type_aliases_list = dst.type_aliases
    i = 0
    while i < len(src.type_aliases) {
        push(&mut type_aliases_list, src.type_aliases[i])
        i = i + 1
    }
    dst.type_aliases = type_aliases_list
    let mut funcs = dst.functions
    i = 0
    while i < len(src.functions) {
        push(&mut funcs, src.functions[i])
        i = i + 1
    }
    dst.functions = funcs
    let mut impls = dst.impls
    i = 0
    while i < len(src.impls) {
        push(&mut impls, src.impls[i])
        i = i + 1
    }
    dst.impls = impls

    let mut compile_items = dst.compile_items
    i = 0
    while i < len(src.compile_items) {
        push(&mut compile_items, src.compile_items[i])
        i = i + 1
    }
    dst.compile_items = compile_items
}

fn driver_list_contains(list: & [String], value: &str) -> bool {
    let mut i = 0
    while i < len(*list) {
        if (*list)[i] == string_clone(value) {
            return true
        }
        i = i + 1
    }
    return false
}

fn driver_list_index(list: & [String], value: &str) -> i32 {
    let mut i = 0
    while i < len(*list) {
        if (*list)[i] == string_clone(value) {
            return i
        }
        i = i + 1
    }
    return -1
}

fn driver_string_list_clone(items: & [String]) -> [String] {
    let mut out: [String] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, string_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn driver_path_dir(path: &str) -> String {
    let mut last = -1
    let mut i = 0
    let path_len = len(path)
    while i < path_len {
        if char_at(path, i) == 47 { last = i }
        i = i + 1
    }
    if last < 0 {
        return "."
    }
    if last == 0 {
        return "/"
    }
    return substr(path, 0, last)
}

fn driver_path_join(dir: &str, rel: &str) -> String {
    if *dir == "" || *dir == "." {
        return string_clone(rel)
    }
    let dir_len = len(dir)
    if char_at(dir, dir_len - 1) == 47 {
        return string_clone(dir) + string_clone(rel)
    }
    return string_clone(dir) + "/" + string_clone(rel)
}

fn driver_replace_dots(path: &str) -> String {
    let mut out = ""
    let mut i = 0
    let path_len = len(path)
    while i < path_len {
        let c = char_at(path, i)
        if c == 46 {
            out = out + "/"
        } else {
            out = out + substr(path, i, 1)
        }
        i = i + 1
    }
    return out
}

fn driver_module_path_to_dir(base_dir: &str, mod_path: &str) -> String {
    let rel = driver_replace_dots(mod_path)
    return driver_path_join(base_dir, &rel)
}

fn driver_string_ends_with(text: &str, suffix: &str) -> bool {
    let t_len = len(text)
    let s_len = len(suffix)
    if t_len < s_len { return false }
    let start = t_len - s_len
    let mut i = 0
    while i < s_len {
        if char_at(text, start + i) != char_at(suffix, i) { return false }
        i = i + 1
    }
    return true
}

fn driver_string_starts_with(text: &str, prefix: &str) -> bool {
    let t_len = len(text)
    let p_len = len(prefix)
    if t_len < p_len { return false }
    let mut i = 0
    while i < p_len {
        if char_at(text, i) != char_at(prefix, i) { return false }
        i = i + 1
    }
    return true
}

fn driver_string_contains(text: &str, needle: &str) -> bool {
    if len(needle) == 0 { return true }
    let mut i = 0
    let t_len = len(text)
    let n_len = len(needle)
    while i + n_len <= t_len {
        let mut j = 0
        let mut ok = true
        while j < n_len && ok {
            if char_at(text, i + j) != char_at(needle, j) { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

fn driver_string_is_empty(text: &str) -> bool {
    return len(text) == 0
}

fn driver_string_eq(a: &str, b: &str) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    let n = len(a)
    while i < n {
        if char_at(a, i) != char_at(b, i) { return false }
        i = i + 1
    }
    return true
}

fn driver_trim_space(text: &str) -> String {
    let mut start = 0
    let mut end = len(text)
    let mut done = false
    while start < end && !done {
        let c = char_at(text, start)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            start = start + 1
        } else {
            done = true
        }
    }
    done = false
    while end > start && !done {
        let c = char_at(text, end - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            end = end - 1
        } else {
            done = true
        }
    }
    if end <= start { return "" }
    return substr(text, start, end - start)
}

fn driver_split_lines(text: &str) -> [String] {
    let mut lines: [String] = []
    let mut i = 0
    let mut start = 0
    let text_len = len(text)
    while i < text_len {
        let c = char_at(text, i)
        if c == 10 {
            push(&mut lines, substr(text, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    if start <= text_len {
        push(&mut lines, substr(text, start, text_len - start))
    }
    return lines
}

fn driver_split_path(path: &str) -> [String] {
    let mut parts: [String] = []
    let mut i = 0
    let mut start = 0
    let path_len = len(path)
    while i < path_len {
        if char_at(path, i) == 47 {
            push(&mut parts, substr(path, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(&mut parts, substr(path, start, path_len - start))
    return parts
}

fn driver_path_clean(path: &str) -> String {
    let mut abs = false
    if len(path) > 0 && char_at(path, 0) == 47 {
        abs = true
    }
    let parts = driver_split_path(path)
    let mut stack: [String] = []
    let mut i = 0
    while i < len(parts) {
        let seg = string_clone(&parts[i])
        if seg == "" || seg == "." {
            // skip
        } else if seg == ".." {
            if len(stack) > 0 {
                let _ = pop(&mut stack)
            }
        } else {
            push(&mut stack, seg)
        }
        i = i + 1
    }
    let mut out = ""
    if abs { out = "/" }
    let mut j = 0
    while j < len(stack) {
        if j > 0 || abs {
            if out != "/" && out != "" { out = out + "/" }
        }
        out = out + string_clone(&stack[j])
        j = j + 1
    }
    if out == "" {
        if abs { return "/" }
        return "."
    }
    return out
}

fn driver_is_test_file(name: &str) -> bool {
    let suffix = "_test.dast"
    return driver_string_ends_with(name, &suffix)
}

fn driver_is_dast_file(name: &str) -> bool {
    let suffix = ".dast"
    return driver_string_ends_with(name, &suffix)
}

fn driver_list_dast_files(dir: &str, include_tests: bool) -> [String] {
    let mut files: [String] = []
    let names = read_dir(dir)
    let mut i = 0
    while i < len(names) {
        let name = string_clone(&names[i])
        let mut take = false
        if driver_is_dast_file(&name) {
            take = true
            if !include_tests && driver_is_test_file(&name) {
                take = false
            }
        }
        if take {
            let full = driver_path_join(dir, &name)
            push(&mut files, full)
        }
        i = i + 1
    }
    return driver_sort_strings(files)
}

fn driver_list_dast_files_recursive(dir: &str, include_tests: bool) -> [String] {
    let mut files: [String] = []
    let names = read_dir(dir)
    let mut i = 0
    while i < len(names) {
        let name = string_clone(&names[i])
        let full = driver_path_join(dir, &name)
        // Check if it's a subdirectory
        let sub_names = read_dir(&full)
        if len(sub_names) > 0 {
            // Recurse into subdirectory
            let sub_files = driver_list_dast_files_recursive(&full, include_tests)
            let mut j = 0
            while j < len(sub_files) {
                push(&mut files, string_clone(&sub_files[j]))
                j = j + 1
            }
        } else {
            // It's a file - check if it's a .dast file
            let mut take = false
            if driver_is_dast_file(&name) {
                take = true
                if !include_tests && driver_is_test_file(&name) {
                    take = false
                }
            }
            if take {
                push(&mut files, full)
            }
        }
        i = i + 1
    }
    return driver_sort_strings(files)
}

fn driver_debug_enabled() -> bool {
    // Opt-in debug via marker file to avoid spamming normal runs.
    let flag = read_file("/tmp/dast-driver-debug")
    return flag != ""
}

fn driver_debug_loaded(state: &LoadState, path: &str) {
    let count = len(state.loaded)
    if count > 0 && count % 50 == 0 && driver_debug_enabled() {
        println("[driver-load]", count, path)
    }
}


fn driver_string_lt(a: &str, b: &str) -> bool {
    let mut i = 0
    let alen = len(a)
    let blen = len(b)
    while i < alen && i < blen {
        let ca = char_at(a, i)
        let cb = char_at(b, i)
        if ca < cb { return true }
        if ca > cb { return false }
        i = i + 1
    }
    return alen < blen
}

fn driver_sort_strings(items: [String]) -> [String] {
    let mut out = items
    let n = len(out)
    if n <= 1 { return out }
    let mut i = 0
    while i < n {
        let mut j = 0
        while j + 1 < n - i {
            if driver_string_lt(&out[j + 1], &out[j]) {
                let tmp = out[j]
                out[j] = out[j + 1]
                out[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    return out
}

fn driver_replace_slash(path: &str) -> String {
    let mut out = ""
    let mut i = 0
    let path_len = len(path)
    while i < path_len {
        let c = char_at(path, i)
        if c == 47 {
            out = out + "."
        } else {
            out = out + substr(path, i, 1)
        }
        i = i + 1
    }
    return out
}

fn driver_path_rel(base: &str, path: &str) -> String {
    if *base == "" || *base == "." {
        return string_clone(path)
    }
    if *path == *base {
        return ""
    }
    let mut prefix = string_clone(base)
    if char_at(&prefix, len(&prefix) - 1) != 47 {
        prefix = prefix + "/"
    }
    if driver_string_starts_with(path, &prefix) {
        let prefix_len = len(&prefix)
        let path_len = len(path)
        return substr(path, prefix_len, path_len - prefix_len)
    }
    return string_clone(path)
}

fn driver_path_is_within(root: &str, path: &str) -> bool {
    if *root == "" || *root == "." { return true }
    let clean_root = driver_path_clean(root)
    let clean_path = driver_path_clean(path)
    if clean_path == clean_root { return true }
    let mut prefix = clean_root
    if len(&prefix) > 0 && char_at(&prefix, len(&prefix) - 1) != 47 {
        prefix = prefix + "/"
    }
    return driver_string_starts_with(&clean_path, &prefix)
}

fn driver_module_path_from_dir(root_dir: &str, dir: &str) -> String {
    let rel = driver_path_rel(root_dir, dir)
    if rel == "" || rel == "." {
        return ""
    }
    return driver_replace_slash(&rel)
}

fn driver_dir_has_entry(dir: &str, name: &str) -> bool {
    let names = read_dir(string_clone(dir))
    let mut i = 0
    while i < len(names) {
        if names[i] == string_clone(name) { return true }
        i = i + 1
    }
    return false
}

fn driver_find_package_root(path: String) -> String {
    let mut dir = path
    if driver_is_dast_file(&dir) {
        dir = driver_path_dir(&dir)
    }
    let mut cur = dir
    let mut done = false
    let toml_name = "dast.toml"
    while !driver_string_is_empty(&cur) && !done {
        if driver_dir_has_entry(&cur, &toml_name) {
            return cur
        }
        let parent = driver_path_dir(&cur)
        if driver_string_eq(&parent, &cur) || driver_string_is_empty(&parent) {
            done = true
        } else {
            cur = parent
        }
    }
    return ""
}

fn driver_find_workspace_root(path: String, dbg: bool) -> String {
    let mut dir = path
    if dbg { println("stage2: ws_root path", string_clone(&dir)) }
    if driver_is_dast_file(&dir) {
        dir = driver_path_dir(&dir)
    }
    if dbg { println("stage2: ws_root dir", string_clone(&dir)) }
    let mut cur = dir
    let mut done = false
    let toml_name = "dast.toml"
    while !driver_string_is_empty(&cur) && !done {
        if dbg { println("stage2: ws_root cur", string_clone(&cur)) }
        if driver_dir_has_entry(&cur, &toml_name) {
            if dbg { println("stage2: ws_root toml", string_clone(&cur)) }
            let res = driver_load_manifest(string_clone(&cur))
            if res.manifest.has_workspace {
                return cur
            }
        }
        let parent = driver_path_dir(&cur)
        if driver_string_eq(&parent, &cur) || driver_string_is_empty(&parent) {
            done = true
        } else {
            cur = parent
        }
    }
    return ""
}

fn driver_code_root(pkg_root: &str) -> String {
    if *pkg_root == "" { return "" }
    let src_dir = "src"
    if driver_dir_has_entry(pkg_root, &src_dir) {
        return driver_path_join(pkg_root, &src_dir)
    }
    return string_clone(pkg_root)
}

fn driver_examples_root(pkg_root: &str) -> String {
    if *pkg_root == "" { return "" }
    let examples_dir = "examples"
    if driver_dir_has_entry(pkg_root, &examples_dir) {
        return driver_path_join(pkg_root, &examples_dir)
    }
    return ""
}

fn driver_find_stdlib_root(start_dir: &str) -> String {
    let mut cur = string_clone(start_dir)
    let mut done = false
    let stdlib_dir = "compiler/stage2/stdlib"
    let prelude_dir = "prelude"
    while !done {
        let cand = driver_path_join(&cur, &stdlib_dir)
        if driver_dir_has_entry(&cand, &prelude_dir) {
            return cand
        }
        let parent = driver_path_dir(&cur)
        if parent == cur || parent == "" {
            done = true
        } else {
            cur = parent
        }
    }
    return ""
}

fn driver_stdlib_prelude_files(std_root: &str) -> [String] {
    let mut files: [String] = []
    if *std_root == "" { return files }
    let prelude_dir = driver_path_join(std_root, "prelude")
    let names = read_dir(string_clone(&prelude_dir))
    let skip_option = "option.dast"
    let skip_result = "result.dast"
    let skip_traits = "traits.dast"
    let mut i = 0
    while i < len(names) {
        let name = string_clone(&names[i])
        let skip = name == string_clone(&skip_option) ||
            name == string_clone(&skip_result) ||
            name == string_clone(&skip_traits)
        if !skip && driver_string_ends_with(&name, ".dast") {
            push(&mut files, driver_path_join(&prelude_dir, &name))
        }
        i = i + 1
    }
    return driver_sort_strings(files)
}

fn driver_load_stdlib(state: &mut LoadState, code_root: &str, include_tests: bool) {
    let std_root = driver_find_stdlib_root(code_root)
    if std_root == "" { return }
    let prelude_files = driver_stdlib_prelude_files(&std_root)
    let mut i = 0
    while i < len(prelude_files) {
        // Prelude items are injected into the root module for now.
        let stack = driver_string_list_new()
        load_file_recursive(
            string_clone(&prelude_files[i]),
            string_clone(&std_root),
            "",
            state,
            false,
            string_clone(&std_root),
            string_clone(&std_root),
            "",
            stack
        )
        i = i + 1
    }
    if include_tests {
        let testing_dir = driver_path_join(&std_root, "testing")
        let testing_file = "lib.dast"
        if driver_dir_has_entry(&testing_dir, &testing_file) {
            let stack = driver_string_list_new()
            load_file_recursive(
                driver_path_join(&testing_dir, &testing_file),
                string_clone(&std_root),
                "",
                state,
                false,
                string_clone(&std_root),
                string_clone(&std_root),
                "",
                stack
            )
        }
    }
}

fn driver_module_root_for_dir(dir: String, code_root: String, examples_root: String) -> String {
    if examples_root != "" && driver_path_is_within(&examples_root, &dir) {
        return examples_root
    }
    return code_root
}

fn driver_parse_package_name(toml: String) -> String {
    let lines = driver_split_lines(&toml)
    let hash = "#"
    let lbracket = "["
    let name_key = "name"
    let pkg_header = "[package]"
    let mut in_pkg = false
    let mut i = 0
    while i < len(lines) {
        let line = driver_trim_space(&lines[i])
        if !(line == "" || driver_string_starts_with(&line, &hash)) {
            if driver_string_starts_with(&line, &lbracket) {
                in_pkg = line == string_clone(&pkg_header)
            } else if in_pkg && driver_string_starts_with(&line, &name_key) {
                let eq = find_char(string_clone(&line), 61, 0)
                if eq >= 0 {
                    let line_len = len(string_clone(&line))
                    let raw_text = substr(string_clone(&line), eq + 1, line_len - eq - 1)
                    let raw = driver_trim_space(&raw_text)
                    if len(raw) >= 2 && char_at(raw, 0) == 34 {
                        return parse_string_lit_token(raw)
                    }
                }
            }
        }
        i = i + 1
    }
    return ""
}

fn driver_strip_inline_comment(line: String) -> String {
    let mut out = ""
    let mut i = 0
    let mut in_str = false
    while i < len(line) {
        let c = char_at(line, i)
        if c == '"' {
            in_str = !in_str
        }
        if c == '#' && !in_str {
            return out
        }
        out = out + substr(line, i, 1)
        i = i + 1
    }
    return out
}

fn driver_manifest_add_error(errors: &mut [ParseError], line: i32, msg: String) {
    push(errors, ParseError { pos: 0, file: "", line: line, col: 1, msg: msg })
}

struct StringArrayParse {
    items: [String],
    end_idx: i32,
    ok: bool,
}

fn driver_collect_string_literals(text: String) -> [String] {
    let mut out: [String] = []
    let mut i = 0
    let n = len(text)
    while i < n {
        let c = char_at(text, i)
        if c == '"' {
            let start = i
            i = i + 1
            let mut done = false
            while i < n && !done {
                let ch = char_at(text, i)
                if ch == '\\' {
                    if i + 1 < n {
                        i = i + 2
                    } else {
                        i = i + 1
                    }
                } else if ch == '"' {
                    done = true
                    i = i + 1
                } else {
                    i = i + 1
                }
            }
            let raw = substr(text, start, i - start)
            if raw != "" {
                push(&mut out, parse_string_lit_token(raw))
            }
        } else {
            i = i + 1
        }
    }
    return out
}

fn driver_parse_string_array(lines: [String], start_idx: i32, first_value: String) -> StringArrayParse {
    let mut combined = first_value
    let mut idx = start_idx
    let lbracket = "["
    let rbracket = "]"
    let mut ok = driver_string_contains(&combined, &lbracket)
    if !ok {
        return StringArrayParse { items: driver_string_list_new(), end_idx: start_idx, ok: false }
    }
    if !driver_string_contains(&combined, &rbracket) {
        let mut done = false
        while idx + 1 < len(lines) && !done {
            idx = idx + 1
            let mut line = driver_trim_space(&lines[idx])
            let stripped = driver_strip_inline_comment(line)
            line = driver_trim_space(&stripped)
            let line_check = string_clone(&line)
            combined = combined + "\n" + line
            if driver_string_contains(&line_check, &rbracket) {
                done = true
            }
        }
        if !done {
            ok = false
        }
    }
    let items = driver_collect_string_literals(combined)
    return StringArrayParse { items: items, end_idx: idx, ok: ok }
}

fn driver_parse_manifest(toml: String) -> ManifestResult {
    let mut manifest = manifest_empty()
    let mut errors: [ParseError] = []
    let lines = driver_split_lines(&toml)
    let hash = "#"
    let lbracket = "["
    let rbracket = "]"
    let mut section = ""
    let mut i = 0
    while i < len(lines) {
        let line_no = i + 1
        let mut line = driver_trim_space(&lines[i])
        let mut handled = false
        if line == "" || driver_string_starts_with(&line, &hash) {
            handled = true
        } else {
            let stripped = driver_strip_inline_comment(line)
            line = driver_trim_space(&stripped)
            if line == "" {
                handled = true
            }
        }
        if !handled && driver_string_starts_with(&line, &lbracket) && driver_string_ends_with(&line, &rbracket) {
            if line == "[package]" {
                section = "package"
                manifest.has_package = true
                manifest.package_line = line_no
            } else if line == "[workspace]" {
                section = "workspace"
                manifest.has_workspace = true
                manifest.workspace_line = line_no
            } else if line == "[dependencies]" {
                section = "dependencies"
            } else if line == "[dev-dependencies]" {
                section = "dev-dependencies"
            } else if line == "[build-dependencies]" {
                section = "build-dependencies"
            } else {
                section = ""
            }
            handled = true
        }
        if !handled {
            let eq = find_char(string_clone(&line), 61, 0)
            if eq >= 0 {
                let line_len = len(string_clone(&line))
                let key_text = substr(string_clone(&line), 0, eq)
                let value_text = substr(string_clone(&line), eq + 1, line_len - eq - 1)
                let key = driver_trim_space(&key_text)
                let value = driver_trim_space(&value_text)
                if section == "package" {
                    if key == "name" {
                        if manifest.name != "" {
                            driver_manifest_add_error(&mut errors, line_no, "duplicate package.name")
                        } else if len(value) < 2 || char_at(value, 0) != '"' {
                            driver_manifest_add_error(&mut errors, line_no, "package.name must be String")
                        } else {
                            manifest.name = parse_string_lit_token(value)
                        }
                    } else if key == "version" {
                        if manifest.version != "" {
                            driver_manifest_add_error(&mut errors, line_no, "duplicate package.version")
                        } else if len(value) < 2 || char_at(value, 0) != '"' {
                            driver_manifest_add_error(&mut errors, line_no, "package.version must be String")
                        } else {
                            manifest.version = parse_string_lit_token(value)
                        }
                    } else if key == "edition" {
                        if manifest.edition != "" {
                            driver_manifest_add_error(&mut errors, line_no, "duplicate package.edition")
                        } else if len(value) < 2 || char_at(value, 0) != '"' {
                            driver_manifest_add_error(&mut errors, line_no, "package.edition must be String")
                        } else {
                            manifest.edition = parse_string_lit_token(value)
                        }
                    }
                } else if section == "workspace" {
                    if key == "members" {
                        if len(manifest.workspace_members) > 0 {
                            driver_manifest_add_error(&mut errors, line_no, "duplicate workspace.members")
                        } else {
                            let parsed = driver_parse_string_array(lines, i, value)
                            if !parsed.ok {
                                driver_manifest_add_error(&mut errors, line_no, "workspace.members must be array of strings")
                            } else {
                                manifest.workspace_members = parsed.items
                                i = parsed.end_idx
                            }
                        }
                    }
                } else if section == "dependencies" || section == "dev-dependencies" || section == "build-dependencies" {
                    if key != "" {
                        if section == "dependencies" {
                            let mut deps = manifest.deps
                            push(&mut deps, key)
                            manifest.deps = deps
                        } else if section == "dev-dependencies" {
                            let mut deps = manifest.dev_deps
                            push(&mut deps, key)
                            manifest.dev_deps = deps
                        } else {
                            let mut deps = manifest.build_deps
                            push(&mut deps, key)
                            manifest.build_deps = deps
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if manifest.has_package && manifest.name == "" {
        let line_no = manifest.package_line
        driver_manifest_add_error(&mut errors, line_no, "package.name is required")
    }
    if manifest.has_workspace && len(manifest.workspace_members) == 0 {
        let line_no = manifest.workspace_line
        driver_manifest_add_error(&mut errors, line_no, "workspace.members is required")
    }
    return ManifestResult { manifest: manifest, errors: errors }
}

fn driver_manifest_with_file(res: ManifestResult, file: String) -> ManifestResult {
    let mut errs: [ParseError] = []
    let file_name = string_clone(&file)
    let mut i = 0
    while i < len(res.errors) {
        let e = parse_error_clone(&res.errors[i])
        push(&mut errs, ParseError { pos: e.pos, file: string_clone(&file_name), line: e.line, col: e.col, msg: string_clone(&e.msg) })
        i = i + 1
    }
    return ManifestResult { manifest: res.manifest, errors: errs }
}

fn driver_load_manifest(pkg_root: String) -> ManifestResult {
    let toml_name = "dast.toml"
    let path = driver_path_join(&pkg_root, &toml_name)
    let text = read_file(string_clone(&path))
    let res = driver_parse_manifest(text)
    return driver_manifest_with_file(res, path)
}

fn driver_package_name(pkg_root: String) -> String {
    if pkg_root == "" { return "" }
    let res = driver_load_manifest(pkg_root)
    return string_clone(&res.manifest.name)
}

fn driver_is_relative_import(path: &str) -> bool {
    let cur = "./"
    let up = "../"
    if driver_string_starts_with(path, &cur) { return true }
    if driver_string_starts_with(path, &up) { return true }
    return false
}

fn driver_import_rel_to_path(rel: &str) -> String {
    let slash = "/"
    if driver_string_contains(rel, &slash) {
        return string_clone(rel)
    }
    return driver_replace_dots(rel)
}

fn driver_import_path_to_dir(base_dir: &str, path: &str, is_string: bool, pkg_name: &str, code_root: &str) -> String {
    let mut rel = string_clone(path)
    let mut from_dir = string_clone(base_dir)
    let std_slash = "std/"
    let std_dot = "std."
    let std_name = "std"
    if is_string {
        if !driver_is_relative_import(path) {
            let mut handled = false
            if driver_string_starts_with(path, &std_slash) || driver_string_starts_with(path, &std_dot) || *path == std_name {
                let std_root = driver_find_stdlib_root(code_root)
                if std_root != "" {
                    from_dir = std_root
                    handled = true
                    if *path == std_name {
                        rel = ""
                    } else {
                        let path_len = len(string_clone(path))
                        rel = substr(string_clone(path), 4, path_len - 4)
                    }
                }
            }
            if !handled {
                if *pkg_name != "" && *path == *pkg_name {
                    return string_clone(code_root)
                }
                from_dir = string_clone(code_root)
            }
        }
        let cur = "./"
        if driver_string_starts_with(&rel, &cur) {
            let rel_len = len(string_clone(&rel))
            rel = substr(string_clone(&rel), 2, rel_len - 2)
        }
        rel = driver_import_rel_to_path(&rel)
    } else {
        rel = driver_replace_dots(&rel)
    }
    let joined = driver_path_join(&from_dir, &rel)
    return driver_path_clean(&joined)
}

fn program_set_module(prog: &mut Program, module: String) {
    let module_copy = string_clone(&module)
    let mut imports: [ImportDecl] = []
    let mut i = 0
    while i < len(prog.imports) {
        let mut imp = clone_import_decl(&prog.imports[i])
        imp.module = string_clone(&module_copy)
        push(&mut imports, imp)
        i = i + 1
    }
    prog.imports = imports

    let mut structs: [StructDecl] = []
    i = 0
    while i < len(prog.structs) {
        let mut st = clone_struct_decl(&prog.structs[i])
        st.module = string_clone(&module_copy)
        push(&mut structs, st)
        i = i + 1
    }
    prog.structs = structs

    let mut enums: [EnumDecl] = []
    i = 0
    while i < len(prog.enums) {
        let mut en = clone_enum_decl(&prog.enums[i])
        en.module = string_clone(&module_copy)
        push(&mut enums, en)
        i = i + 1
    }
    prog.enums = enums

    let mut consts: [ConstDecl] = []
    i = 0
    while i < len(prog.consts) {
        let mut c = clone_const_decl(&prog.consts[i])
        c.module = string_clone(&module_copy)
        push(&mut consts, c)
        i = i + 1
    }
    prog.consts = consts

    let mut funcs: [FunctionDecl] = []
    i = 0
    while i < len(prog.functions) {
        let mut f = clone_function_decl(&prog.functions[i])
        f.module = string_clone(&module_copy)
        push(&mut funcs, f)
        i = i + 1
    }
    prog.functions = funcs

    let mut type_aliases: [TypeAlias] = []
    i = 0
    while i < len(prog.type_aliases) {
        let mut ta = clone_type_alias(&prog.type_aliases[i])
        ta.module = string_clone(&module_copy)
        push(&mut type_aliases, ta)
        i = i + 1
    }
    prog.type_aliases = type_aliases

    let mut impls: [ImplDecl] = []
    i = 0
    while i < len(prog.impls) {
        let imp = &prog.impls[i]
        let mut methods: [FunctionDecl] = []
        let mut j = 0
        while j < len(imp.methods) {
            let mut m = clone_function_decl(&imp.methods[j])
            m.module = string_clone(&module_copy)
            push(&mut methods, m)
            j = j + 1
        }
        let mut imp_out = clone_impl_decl(imp)
        imp_out.module = string_clone(&module_copy)
        imp_out.methods = methods
        push(&mut impls, imp_out)
        i = i + 1
    }
    prog.impls = impls

    let mut compile_items: [CompileItem] = []
    i = 0
    while i < len(prog.compile_items) {
        let mut ci = clone_compile_item(&prog.compile_items[i])
        ci.module = string_clone(&module_copy)
        push(&mut compile_items, ci)
        i = i + 1
    }
    prog.compile_items = compile_items
}

fn program_set_file(prog: &mut Program, file: String) {
    let file_copy = string_clone(&file)
    let mut imports: [ImportDecl] = []
    let mut i = 0
    while i < len(prog.imports) {
        let mut imp = clone_import_decl(&prog.imports[i])
        imp.file = string_clone(&file_copy)
        push(&mut imports, imp)
        i = i + 1
    }
    prog.imports = imports

    let mut structs: [StructDecl] = []
    i = 0
    while i < len(prog.structs) {
        let mut st = clone_struct_decl(&prog.structs[i])
        st.file = string_clone(&file_copy)
        push(&mut structs, st)
        i = i + 1
    }
    prog.structs = structs

    let mut enums: [EnumDecl] = []
    i = 0
    while i < len(prog.enums) {
        let mut en = clone_enum_decl(&prog.enums[i])
        en.file = string_clone(&file_copy)
        push(&mut enums, en)
        i = i + 1
    }
    prog.enums = enums

    let mut consts: [ConstDecl] = []
    i = 0
    while i < len(prog.consts) {
        let mut c = clone_const_decl(&prog.consts[i])
        c.file = string_clone(&file_copy)
        push(&mut consts, c)
        i = i + 1
    }
    prog.consts = consts

    let mut funcs: [FunctionDecl] = []
    i = 0
    while i < len(prog.functions) {
        let mut f = clone_function_decl(&prog.functions[i])
        f.file = string_clone(&file_copy)
        push(&mut funcs, f)
        i = i + 1
    }
    prog.functions = funcs

    let mut type_aliases: [TypeAlias] = []
    i = 0
    while i < len(prog.type_aliases) {
        let mut ta = clone_type_alias(&prog.type_aliases[i])
        ta.file = string_clone(&file_copy)
        push(&mut type_aliases, ta)
        i = i + 1
    }
    prog.type_aliases = type_aliases

    let mut impls: [ImplDecl] = []
    i = 0
    while i < len(prog.impls) {
        let imp = &prog.impls[i]
        let mut methods: [FunctionDecl] = []
        let mut j = 0
        while j < len(imp.methods) {
            let mut m = clone_function_decl(&imp.methods[j])
            m.file = string_clone(&file_copy)
            push(&mut methods, m)
            j = j + 1
        }
        let mut imp_out = clone_impl_decl(imp)
        imp_out.file = string_clone(&file_copy)
        imp_out.methods = methods
        push(&mut impls, imp_out)
        i = i + 1
    }
    prog.impls = impls

    let mut compile_items: [CompileItem] = []
    i = 0
    while i < len(prog.compile_items) {
        let mut ci = clone_compile_item(&prog.compile_items[i])
        ci.file = string_clone(&file_copy)
        push(&mut compile_items, ci)
        i = i + 1
    }
    prog.compile_items = compile_items
}

struct LoadState {
    merged: Program,
    errors: [ParseError],
    loaded: [String],
    sources: [String],
}

struct ImportLoad {
    dir: String,
    file: String,
    pos: i32,
    path: String,
}

fn clone_parse_error(e: &ParseError) -> ParseError {
    return ParseError { pos: e.pos, file: string_clone(&e.file), line: e.line, col: e.col, msg: string_clone(&e.msg) }
}

fn clone_import_load(i: &ImportLoad) -> ImportLoad {
    return ImportLoad { dir: string_clone(&i.dir), file: string_clone(&i.file), pos: i.pos, path: string_clone(&i.path) }
}

fn load_state_new() -> LoadState {
    return LoadState { merged: program_empty(), errors: parse_error_list_new(), loaded: driver_string_list_new(), sources: driver_string_list_new() }
}

fn load_file_recursive(path: String, root_dir: String, module_path: String, state: &mut LoadState, include_tests: bool, pkg_name_in: String, code_root_in: String, examples_root_in: String, stack: [String]) {
    let pkg_name = pkg_name_in
    let code_root = code_root_in
    let examples_root = examples_root_in
    let mut st = state
    let clean_path = driver_path_clean(&path)
    if driver_list_contains(&state.loaded, &clean_path) {
        return
    }
    let src = read_file(string_clone(&clean_path))
    if driver_debug_enabled() {
        println("[driver-src-len]", clean_path, len(string_clone(&src)))
    }
    push(&mut st.loaded, string_clone(&clean_path))
    driver_debug_loaded(st, &clean_path)
    push(&mut st.sources, string_clone(&src))
    let mut lex = lexer_new(string_clone(&src))
    if driver_debug_enabled() {
        println("[driver-tok-count]", clean_path, len(lex.toks.items))
        let t0 = lexer_peek(&lex)
        println("[driver-tok0]", t0.kind, t0.start, t0.len)
        println("[driver-tok0-is-fn]", t0.kind == TokenKind.Fn)
        println("[driver-tok0-is-ident]", t0.kind == TokenKind.Ident)
        println("[driver-tok0-is-eof]", t0.kind == TokenKind.Eof)
    }
    let mut local_errs: [ParseError] = []
    let mut prog = parse_program(&src, &clean_path, &mut lex, &mut local_errs)
    if len(local_errs) > 1000 {
        println("stage2: parse flood in", clean_path, len(local_errs))
        let mut ei = 0
        while ei < len(local_errs) && ei < 5 {
            let pe = clone_parse_error(&local_errs[ei])
            println("[parse-err]", pe.pos, pe.msg)
            ei = ei + 1
        }
        exit(2)
    }
    program_set_file(&mut prog, string_clone(&clean_path))
    program_set_module(&mut prog, module_path)

    let base = driver_path_dir(&clean_path)
    let std_root = driver_find_stdlib_root(&code_root)
    let mut imports: [ImportDecl] = []
    let mut child_dirs: [ImportLoad] = []
    let mut j = 0
    while j < len(prog.imports) {
        let imp = clone_import_decl(&prog.imports[j])
        let imp_path = string_clone(&imp.path)
        if imp_path != "" {
            let orig_path = string_clone(&imp_path)
            let mut pkg_import = false
            if imp.path_is_string && !driver_is_relative_import(&imp_path) && pkg_name != "" && string_clone(&imp_path) == pkg_name {
                pkg_import = true
            }
            let child_dir = driver_import_path_to_dir(&base, &imp_path, imp.path_is_string, &pkg_name, &code_root)
            let mut allowed = driver_path_is_within(&root_dir, &child_dir)
            if !allowed && string_clone(&root_dir) != string_clone(&code_root) {
                allowed = driver_path_is_within(&code_root, &child_dir)
            }
            if !allowed && std_root != "" {
                allowed = driver_path_is_within(&std_root, &child_dir)
            }
            if !allowed {
                push(&mut local_errs, ParseError { pos: imp.pos, file: "", line: 0, col: 0, msg: "import path escapes package root: " + imp_path })
            } else {
                let child_root = driver_module_root_for_dir(string_clone(&child_dir), string_clone(&code_root), string_clone(&examples_root))
                let child_mod = driver_module_path_from_dir(child_root, string_clone(&child_dir))
                let mut new_path = ""
                if pkg_import {
                    new_path = "::"
                } else if string_clone(&child_mod) != "" {
                    new_path = "::" + string_clone(&child_mod)
                } else {
                    new_path = child_mod
                }
                let mut has_alias = imp.has_alias
                let mut alias = string_clone(&imp.alias)
                if pkg_import && !has_alias {
                    has_alias = true
                    alias = string_clone(&pkg_name)
                }
                push(&mut imports, ImportDecl {
                    vis: clone_visibility(&imp.vis),
                    module: string_clone(&imp.module),
                    file: string_clone(&imp.file),
                    pos: imp.pos,
                    has_items: imp.has_items,
                    items: clone_import_item_spec_list(&imp.items),
                    path: string_clone(&new_path),
                    path_is_string: false,
                    has_alias: has_alias,
                    alias: string_clone(&alias),
                })
                push(&mut child_dirs, ImportLoad { dir: string_clone(&child_dir), file: string_clone(&clean_path), pos: imp.pos, path: string_clone(&orig_path) })
            }
        } else {
            push(&mut imports, clone_import_decl(&imp))
        }
        j = j + 1
    }
    prog.imports = imports

    append_program(&mut st.merged, prog)
    let mut i = 0
    while i < len(local_errs) {
        let e = clone_parse_error(&local_errs[i])
        let mut line = 0
        let mut col = 0
        if e.pos >= 0 {
            let mut offset = 0
            if e.pos < len(lex.toks.items) {
                offset = tok_start(&lex.toks, e.pos)
            } else {
                offset = len(string_clone(&src))
            }
            let lc = line_col_from_offset(string_clone(&src), offset)
            line = lc.line
            col = lc.col
        }
        push(&mut st.errors, ParseError { pos: e.pos, file: string_clone(&clean_path), line: line, col: col, msg: e.msg })
        i = i + 1
    }

    j = 0
    while j < len(child_dirs) {
        let child_dir = string_clone(&child_dirs[j].dir)
        let child_root = driver_module_root_for_dir(child_dir, string_clone(&code_root), string_clone(&examples_root))
        let mut child_stack: [String] = []
        let mut si = 0
        while si < len(stack) {
            push(&mut child_stack, string_clone(&stack[si]))
            si = si + 1
        }
        load_dir_recursive(clone_import_load(&child_dirs[j]), child_root, st, false, string_clone(&pkg_name), string_clone(&code_root), string_clone(&examples_root), child_stack)
        j = j + 1
    }
}

fn load_dir_recursive(req: ImportLoad, root_dir: String, state: &mut LoadState, include_tests: bool, pkg_name_in: String, code_root_in: String, examples_root_in: String, stack: [String]) {
    let pkg_name = pkg_name_in
    let code_root = code_root_in
    let examples_root = examples_root_in
    let mut st = state
    let clean_root_dir = driver_path_clean(&root_dir)
    let req_dir = driver_path_clean(&req.dir)
    let req_file = string_clone(&req.file)
    let req_path = string_clone(&req.path)
    let mut cycle_idx = -1
    let mut ci = 0
    while ci < len(stack) {
        if stack[ci] == req_dir {
            cycle_idx = ci
            break
        }
        ci = ci + 1
    }
    if cycle_idx >= 0 {
        let mut msg = "circular import: "
        let mut i = cycle_idx
        while i < len(stack) {
            let stack_root = driver_module_root_for_dir(string_clone(&stack[i]), string_clone(&code_root), string_clone(&examples_root))
            let mut name = driver_module_path_from_dir(stack_root, string_clone(&stack[i]))
            if name == "" { name = "<root>" }
            if i > cycle_idx {
                msg = msg + " -> "
            }
            msg = msg + name
            i = i + 1
        }
        let req_root = driver_module_root_for_dir(string_clone(&req_dir), string_clone(&code_root), string_clone(&examples_root))
        let mut last = driver_module_path_from_dir(req_root, string_clone(&req_dir))
        if last == "" { last = "<root>" }
        msg = msg + " -> " + last
        if req_file != "" {
            push(&mut st.errors, ParseError { pos: req.pos, file: req_file, line: 0, col: 0, msg: msg })
        } else {
            push(&mut st.errors, ParseError { pos: 0, file: req_dir, line: 1, col: 1, msg: msg })
        }
        return
    }
    let module_path = driver_module_path_from_dir(string_clone(&clean_root_dir), string_clone(&req_dir))
    let files = driver_list_dast_files(string_clone(&req_dir), include_tests)
    if len(files) == 0 {
        if req_file != "" {
            push(&mut st.errors, ParseError { pos: req.pos, file: req_file, line: 0, col: 0, msg: "import path has no .dast files: " + req_path })
        } else {
            push(&mut st.errors, ParseError { pos: 0, file: req_dir, line: 1, col: 1, msg: "no .dast files in directory" })
        }
        return
    }
    let mut next_stack: [String] = []
    let mut si = 0
    while si < len(stack) {
        push(&mut next_stack, string_clone(&stack[si]))
        si = si + 1
    }
    push(&mut next_stack, string_clone(&req_dir))
    let mut i = 0
    while i < len(files) {
        let mut child_stack: [String] = []
        let mut si = 0
        while si < len(next_stack) {
            push(&mut child_stack, string_clone(&next_stack[si]))
            si = si + 1
        }
        load_file_recursive(string_clone(&files[i]), string_clone(&clean_root_dir), string_clone(&module_path), st, include_tests, string_clone(&pkg_name), string_clone(&code_root), string_clone(&examples_root), child_stack)
        i = i + 1
    }
}

fn print_errors(errors: & [ParseError]) {
    let mut i = 0
    while i < len(*errors) {
        let e = parse_error_clone(&(*errors)[i])
        print_error_line(e.file, e.line, e.col, e.msg)
        i = i + 1
    }
}

fn driver_source_for(state: &LoadState, path: String) -> String {
    let idx = driver_list_index(&state.loaded, &path)
    if idx >= 0 && idx < len(state.sources) {
        return string_clone(&state.sources[idx])
    }
    return ""
}

fn attach_error_locations(errors: & [ParseError], state: &LoadState) -> [ParseError] {
    let mut out: [ParseError] = []
    let mut i = 0
    while i < len(*errors) {
        let e = parse_error_clone(&(*errors)[i])
        let e_copy = parse_error_clone(&e)
        let mut handled = false
        if e.file != "" && e.pos >= 0 && (e.line == 0 || e.col == 0) {
            let file_name = string_clone(&e.file)
            let src = driver_source_for(state, string_clone(&file_name))
            if src != "" {
                let mut offset = 0
                let mut lex = lexer_new(string_clone(&src))
                let toks = lex.toks
                let tok_count = len(toks.items)
                if e.pos < tok_count {
                    offset = tok_start(&toks, e.pos)
                } else {
                    offset = len(string_clone(&src))
                }
                let lc = line_col_from_offset(string_clone(&src), offset)
                push(&mut out, ParseError { pos: e.pos, file: file_name, line: lc.line, col: lc.col, msg: string_clone(&e.msg) })
                handled = true
            }
        }
        if !handled {
            push(&mut out, e_copy)
        }
        i = i + 1
    }
    return out
}

fn line_col_from_offset(src: String, offset: i32) -> LineCol {
    let mut line = 1
    let mut col = 1
    let mut i = 0
    let mut limit = offset
    if limit < 0 { limit = 0 }
    if limit > len(src) { limit = len(src) }
    while i < limit {
        let ch = char_at(src, i)
        if ch == '\n' {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return LineCol { line: line, col: col }
}

fn print_error_line(file: String, line: i32, col: i32, msg: String) {
    let mut fname = file
    if fname == "" { fname = "<unknown>" }
    let loc = fname + ":" + int_to_string(line) + ":" + int_to_string(col)
    println("stage2: " + loc + ": error " + msg)
}

fn collect_tests(prog: Program) -> TestCollect {
    let mut out: [String] = []
    let mut errs: [ParseError] = []
    let test_prefix = "test_"
    let mut i = 0
    while i < len(prog.functions) {
        let f = &prog.functions[i]
        if f.name == "__dast_test_main" {
            push(&mut errs, ParseError { pos: f.pos, file: string_clone(&f.file), line: 0, col: 0, msg: "test entry function already defined" })
        }
        if !driver_string_starts_with(&f.name, &test_prefix) {
            i = i + 1
            continue
        }
        if !driver_is_test_file(&f.file) {
            i = i + 1
            continue
        }
        if len(f.params) != 0 {
            push(&mut errs, ParseError { pos: f.pos, file: string_clone(&f.file), line: 0, col: 0, msg: "test function must not accept parameters" })
            i = i + 1
            continue
        }
        push(&mut out, driver_qualify_name(&f.module, &f.name))
        i = i + 1
    }
    out = driver_sort_strings(out)
    return TestCollect { tests: out, errors: errs }
}

fn driver_output_name(pkg_has_toml: bool, pkg_name: String, example: String) -> String {
    let mut name = "main"
    if example != "" {
        name = example
    } else if pkg_has_toml {
        if pkg_name != "" { name = pkg_name }
    }
    return name
}

fn driver_emit_ir_file(target_dir: &str, name: &str, prog: IrProgram) -> String {
    let out_name = string_clone(name) + ".ir"
    let out_path = driver_path_join(target_dir, &out_name)
    write_file(string_clone(&out_path), ir_program_format(prog))
    return out_path
}

fn driver_emit_qbe_file(target_dir: &str, name: &str, prog: IrProgram, debug: bool) -> String {
    let opt = ir_opt_program_no_inline(prog)
    let qbe_code = ir_program_to_qbe(&opt, debug)
    let out_name = string_clone(name) + ".qbe"
    let out_path = driver_path_join(target_dir, &out_name)
    write_file(string_clone(&out_path), qbe_code)
    return out_path
}

fn driver_build_native(target_dir: String, name: String, prog: IrProgram, debug: bool) -> String {
    let qbe_file = driver_emit_qbe_file(&target_dir, &name, prog, debug)
    let asm_name = string_clone(&name) + ".s"
    let asm_file = driver_path_join(&target_dir, &asm_name)
    let mut qargs: [String] = []
    push(&mut qargs, "-o")
    push(&mut qargs, string_clone(&asm_file))
    push(&mut qargs, string_clone(&qbe_file))
    let qcode = exec("qbe", qargs)
    if qcode != 0 {
        die_error("qbe failed")
    }
    let out_path = driver_path_join(&target_dir, &name)
    let mut args: [String] = []
    push(&mut args, "-O2")
    push(&mut args, "-std=c11")
    push(&mut args, string_clone(&asm_file))
    push(&mut args, "compiler/stage2/backend/codegen-c/c_runtime.c")
    push(&mut args, "compiler/stage2/backend/qbe/qbe_runtime.c")
    push(&mut args, "-I")
    push(&mut args, "compiler/stage2/backend/codegen-c")
    push(&mut args, "-o")
    push(&mut args, string_clone(&out_path))
    let code = exec("cc", args)
    if code != 0 {
        let code2 = exec("clang", args)
        if code2 != 0 {
            die_error("cc/clang failed")
        }
    }
    return out_path
}

fn driver_make_test_program(prog: IrProgram, tests: [String]) -> IrProgram {
    let mut instrs: [IrInstr] = []
    let mut i = 0
    while i < len(tests) {
        let mut args: [IrOperand] = []
        push(&mut instrs, IrInstr.Call(IrCall { dst: -1, callee: string_clone(&tests[i]), args: args }))
        i = i + 1
    }
    let mut ok_args: [IrOperand] = []
    push(&mut ok_args, ir_operand_const(ir_value_string("ok")))
    push(&mut ok_args, ir_operand_const(ir_value_int(len(tests))))
    push(&mut instrs, IrInstr.Call(IrCall { dst: -1, callee: "println", args: ok_args }))
    let term = IrTerm.Return(IrReturn { has_value: false, value: ir_operand_const(ir_value_unit()) })
    let mut blocks: [IrBlock] = []
    push(&mut blocks, IrBlock { label: "entry", instrs: instrs, term: term })
    let test_fn = IrFunction {
        name: "__dast_test_main",
        params: driver_string_list_new(),
        param_types: driver_string_list_new(),
        return_type: "unit",
        blocks: blocks,
        temp_count: 0,
    }
    let mut funcs = prog.functions
    push(&mut funcs, test_fn)
    let mut out = prog
    out.functions = funcs
    out.entry = "__dast_test_main"
    return out
}

fn driver_execute(cmd: String, files: [String], rest: [String], debug: bool, example: String, emit_ir: bool, bootstrap: bool, target_root: String) {
    let file0 = string_clone(&files[0])
    let mut pkg_root = driver_find_package_root(string_clone(&file0))
    let mut pkg_has_toml = pkg_root != ""
    if !pkg_has_toml {
        pkg_root = string_clone(&file0)
        if driver_is_dast_file(&pkg_root) {
            pkg_root = driver_path_dir(&pkg_root)
        }
    }
    let code_root = driver_code_root(&pkg_root)
    let examples_root = driver_examples_root(&pkg_root)
    let mut pkg_name = ""
    if pkg_has_toml {
        let manifest = driver_load_manifest(string_clone(&pkg_root))
        if len(manifest.errors) > 0 {
            die_errors(&manifest.errors)
        }
        pkg_name = string_clone(&manifest.manifest.name)
    }
    if debug {
        let mut has_toml = "false"
        if pkg_has_toml { has_toml = "true" }
        println("stage2: exec pkg", string_clone(&pkg_root), "has_toml", has_toml)
    }

    let mut entry_files = files
    let mut module_root = string_clone(&code_root)
    if example != "" {
        if len(entry_files) != 1 {
            die_error("example expects single package path")
        }
        if cmd == "test" {
            die_error("example flag not supported for test")
        }
        if examples_root == "" {
            die_error("examples directory not found")
        }
        let mut ex_path = ""
        if driver_dir_has_entry(&examples_root, &example) {
            ex_path = driver_path_join(&examples_root, &example)
        } else {
            let file_name = string_clone(&example) + ".dast"
            if driver_dir_has_entry(&examples_root, &file_name) {
                ex_path = driver_path_join(&examples_root, &file_name)
            }
        }
        if ex_path == "" {
            die_error("example not found: " + string_clone(&example))
        }
        let mut only: [String] = []
        push(&mut only, ex_path)
        entry_files = only
        module_root = string_clone(&examples_root)
    }

    let include_tests = cmd == "test"
    let mut state = load_state_new()
    // Load stdlib prelude/testing into the compiler itself.
    driver_load_stdlib(&mut state, &code_root, include_tests)
    let mut i = 0
    while i < len(entry_files) {
        let path = string_clone(&entry_files[i])
        let entry_is_file = driver_is_dast_file(&path)
        if debug { println("stage2: load entry", string_clone(&path)) }
        let mut dir = string_clone(&path)
        if driver_is_dast_file(&dir) {
            if debug { println("stage2: entry is file", string_clone(&dir)) }
            dir = driver_path_dir(&dir)
        }
        if debug { println("stage2: entry dir", string_clone(&dir)) }
        if pkg_has_toml {
            let other_root = driver_find_package_root(string_clone(&dir))
            if debug { println("stage2: pkg other_root", string_clone(&other_root)) }
            if other_root != pkg_root {
                die_error("multiple package roots not supported")
            }
        } else {
            let other_root = driver_find_package_root(string_clone(&dir))
            if debug { println("stage2: pkg other_root", string_clone(&other_root)) }
            if other_root != "" && other_root != pkg_root {
                die_error("multiple package roots not supported")
            }
            if !driver_path_is_within(&pkg_root, &dir) {
                die_error("multiple package roots not supported")
            }
        }
        if dir == pkg_root {
            dir = string_clone(&code_root)
        }
        if debug { println("stage2: load dir", string_clone(&dir)) }
        if !driver_path_is_within(&module_root, &dir) {
            die_error("path outside module root: " + string_clone(&path))
        }
        let stack = driver_string_list_new()
        if entry_is_file {
            let mod_path = driver_module_path_from_dir(string_clone(&module_root), string_clone(&dir))
            load_file_recursive(string_clone(&path), string_clone(&module_root), mod_path, &mut state, include_tests, string_clone(&pkg_name), string_clone(&code_root), string_clone(&examples_root), stack)
        } else {
            load_dir_recursive(ImportLoad { dir: string_clone(&dir), file: "", pos: -1, path: string_clone(&dir) }, string_clone(&module_root), &mut state, include_tests, string_clone(&pkg_name), string_clone(&code_root), string_clone(&examples_root), stack)
        }
        i = i + 1
    }

    if debug {
        let mut di = 0
        while di < len(state.loaded) {
            println("stage2: loaded", state.loaded[di])
            di = di + 1
        }
    }
    let parse_res = ParseResult { prog: state.merged, errors: state.errors }
    if len(parse_res.errors) > 0 {
        let perrs = attach_error_locations(&parse_res.errors, &state)
        die_errors(&perrs)
    }
    if debug { println("stage2: parsed") }
    if debug {
        let mut ii = 0
        while ii < len(parse_res.prog.imports) {
            let imp = parse_res.prog.imports[ii]
            println("stage2: import", imp.module, imp.path, imp.alias)
            ii = ii + 1
        }
        let mut fi = 0
        while fi < len(parse_res.prog.functions) {
            let f = parse_res.prog.functions[fi]
            println("stage2: func", f.name, "module", f.module, "file", f.file)
            fi = fi + 1
        }
    }
    let expand_res = macro_expand(parse_res.prog, debug)
    if len(expand_res.errors) > 0 {
        let merrs = attach_error_locations(&expand_res.errors, &state)
        die_errors(&merrs)
    }
    let tctx = check_program(expand_res.prog, debug, false, false)
    if debug { println("stage2: typecheck errors raw", len(tctx.errors)) }
    let terrs = attach_error_locations(&tctx.errors, &state)
    if debug { println("stage2: typecheck errors loc", len(terrs)) }
    if len(terrs) > 0 { die_errors(&terrs) }
    if debug { println("stage2: typechecked") }
    let comp = compile_program(expand_res.prog, tctx, debug)
    let cerrs = attach_error_locations(&comp.errors, &state)
    if len(cerrs) > 0 { die_errors(&cerrs) }
    if debug { println("stage2: compiled") }
    let verr = ir_validate(comp.prog)
    if verr != "" {
        die_error(verr)
    }
    if cmd != "build" && emit_ir {
        die_error("emit flags only supported for build")
    }
    if cmd == "ir" {
        print(ir_program_format(comp.prog))
        return
    }
    if cmd == "build" || cmd == "run" || cmd == "test" {
        let mut name = driver_output_name(pkg_has_toml, string_clone(&pkg_name), string_clone(&example))
        let mut out_root = string_clone(&pkg_root)
        if target_root != "" {
            out_root = target_root
        }
        let target_name = "target"
        let target_dir = driver_path_join(&out_root, &target_name)
        mkdir(string_clone(&target_dir))
        if bootstrap {
            if cmd == "build" {
                let _ = driver_emit_ir_file(&target_dir, &name, comp.prog)
                return
            }
            die_error("bootstrap run/test disabled (interp backend not built)")
        }
        if cmd == "build" {
            if emit_ir {
                let _ = driver_emit_ir_file(&target_dir, &name, comp.prog)
                return
            }
            let _ = driver_build_native(string_clone(&target_dir), string_clone(&name), comp.prog, debug)
            return
        }
        if cmd == "test" {
            let tests = collect_tests(parse_res.prog)
            if len(tests.errors) > 0 {
                let perrs = attach_error_locations(&tests.errors, &state)
                die_errors(&perrs)
            }
            if len(tests.tests) == 0 {
                println("ok 0")
                return
            }
            name = name + "_test"
            let test_prog = driver_make_test_program(comp.prog, tests.tests)
            let out_path = driver_build_native(string_clone(&target_dir), string_clone(&name), test_prog, debug)
            let code = exec(out_path, driver_string_list_new())
            if code != 0 { exit(code) }
            return
        }
        // run
        let out_path = driver_build_native(string_clone(&target_dir), string_clone(&name), comp.prog, debug)
        let code = exec(out_path, rest)
        if code != 0 { exit(code) }
        return
    }
    die_usage()
}

fn main() {
    let argv = args()
    if len(argv) < 1 {
        die_usage()
    }
    let mut dbg = false
    let mut di = 0
    while di < len(argv) {
        if argv[di] == "--debug" { dbg = true; break }
        di = di + 1
    }
    if dbg { println("stage2: argv ok") }
    let cmd = string_clone(&argv[0])
    if cmd != "build" && cmd != "run" && cmd != "ir" && cmd != "ir-verify" && cmd != "ir-opt" && cmd != "test" {
        die_usage()
    }
    if dbg { println("stage2: pre-split") }
    if dbg {
        let tmp_files: [String] = []
        let tmp_rest: [String] = []
        let tmp = ArgSplitPkg { files: tmp_files, rest: tmp_rest, package: "", example: "", debug: false, emit_ir: false, bootstrap: false }
        println("stage2: tmp split", tmp)
    }
    let split = split_args_with_pkg(argv, 1, cmd == "test")
    if dbg { println("stage2: split raw", split) }
    let debug = split.debug
    if debug { println("stage2: start") }
    if dbg { println("stage2: post-split") }
    if dbg && len(split.files) > 0 {
        let file0 = string_clone(&split.files[0])
        println("stage2: split file0", file0)
    }
    if len(split.files) == 0 {
        die_usage()
    }
    if cmd == "test" && split.example != "" {
        die_error("example flag not supported for test")
    }

    if cmd == "ir-verify" {
        if len(split.files) != 1 {
            die_usage()
        }
        let file_path = string_clone(&split.files[0])
        let text = read_file(string_clone(&file_path))
        let parsed = ir_parse_program(text, debug)
        if !parsed.ok {
            die_parse(file_path, parsed.line, parsed.error)
        }
        let verr = ir_validate(parsed.prog)
        if verr != "" {
            die_error(verr)
        }
        return
    }
    if cmd == "ir-opt" {
        if len(split.files) != 1 {
            die_usage()
        }
        let file_path = string_clone(&split.files[0])
        let text = read_file(string_clone(&file_path))
        let parsed = ir_parse_program(text, debug)
        if !parsed.ok {
            die_parse(file_path, parsed.line, parsed.error)
        }
        let verr = ir_validate(parsed.prog)
        if verr != "" {
            die_error(verr)
        }
        let opt = ir_opt_program(parsed.prog)
        let verr2 = ir_validate(ir_program_clone(&opt))
        if verr2 != "" {
            die_error(verr2)
        }
        print(ir_program_format(opt))
        return
    }
    let mut use_workspace = false
    if dbg { println("stage2: ws_root begin") }
    let ws_root = driver_find_workspace_root(string_clone(&split.files[0]), dbg)
    if dbg { println("stage2: ws_root end", string_clone(&ws_root)) }
    if cmd == "build" || cmd == "run" || cmd == "test" {
        if ws_root != "" && len(split.files) == 1 {
            let in_path = driver_path_clean(&split.files[0])
            let root_path = driver_path_clean(&ws_root)
            if in_path == root_path {
                use_workspace = true
            }
        }
    }
    if use_workspace {
        let manifest = driver_load_manifest(string_clone(&ws_root))
        if len(manifest.errors) > 0 {
            die_errors(&manifest.errors)
        }
        let members = driver_string_list_clone(&manifest.manifest.workspace_members)
        let mut member_paths: [String] = []
        let mut i = 0
        while i < len(members) {
            let member = string_clone(&members[i])
            let joined = driver_path_join(&ws_root, &member)
            let mpath = driver_path_clean(&joined)
            push(&mut member_paths, mpath)
            i = i + 1
        }
        if split.package != "" {
            let mut filtered: [String] = []
            let mut j = 0
            while j < len(member_paths) {
                let mroot = string_clone(&member_paths[j])
                let res = driver_load_manifest(string_clone(&mroot))
                if len(res.errors) > 0 {
                    die_errors(&res.errors)
                }
                if string_clone(&res.manifest.name) == split.package {
                    push(&mut filtered, mroot)
                }
                j = j + 1
            }
            if len(filtered) == 0 {
                die_error("package not found: " + string_clone(&split.package))
            }
            member_paths = filtered
        } else if cmd == "run" && len(member_paths) > 1 {
            die_error("multiple packages in workspace, use --package")
        }
        if split.example != "" && split.package == "" && len(member_paths) > 1 {
            die_error("example requires --package in workspace")
        }
        let mut k = 0
        while k < len(member_paths) {
            if debug { println("stage2: workspace", string_clone(&member_paths[k])) }
            let mut files: [String] = []
            push(&mut files, string_clone(&member_paths[k]))
            driver_execute(cmd, files, split.rest, debug, split.example, split.emit_ir, split.bootstrap, string_clone(&ws_root))
            k = k + 1
        }
        return
    }
    if split.package != "" {
        die_error("package flag only valid for workspace root")
    }
    if dbg { println("stage2: exec begin") }
    driver_execute(cmd, split.files, split.rest, debug, split.example, split.emit_ir, split.bootstrap, "")
    if dbg { println("stage2: exec end") }
}
