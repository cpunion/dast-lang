    let _add: i16 = a[0] + b[0]
    let _sub: i16 = a[0] - b[0]
    let _mul: i16 = a[0] * b[0]
    let _div: i16 = a[0] / b[0]
    let _rem: i16 = a[0] % b[0]
    let _and: i16 = a[0] & b[0]
    let _or: i16 = a[0] | b[0]
    let _xor: i16 = a[0] ^ b[0]
    let _shl: i16 = a[0] << sh[0]
    let _shr: i16 = a[0] >> sh[0]
    let _lt: bool = c[0] < d[0]
    let _le: bool = c[0] <= d[0]
    let _gt: bool = c[0] > d[0]
    let _ge: bool = c[0] >= d[0]
    let _eq: bool = c[0] == d[0]
    let _ne: bool = c[0] != d[0]
