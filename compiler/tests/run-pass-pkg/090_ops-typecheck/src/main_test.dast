        t.assert_eq!(x + y, exp_add[i])
        t.assert_eq!(x - y, exp_sub[i])
        t.assert_eq!(x * y, exp_mul[i])
        t.assert_eq!(x / y, exp_div[i])
        t.assert_eq!(x % y, exp_rem[i])
        t.assert_eq!(x & y, exp_and[i])
        t.assert_eq!(x | y, exp_or[i])
        t.assert_eq!(x ^ y, exp_xor[i])
        t.assert_eq!(x << y, exp_shl[i])
        t.assert_eq!(x >> y, exp_shr[i])
        i = i + 1
    }
    let c: [u64] = [1, 2, 3]
    let d: [u64] = [1, 3, 2]
    let exp_eq: [bool] = [true, false, false]
    let exp_ne: [bool] = [false, true, true]
    let exp_lt: [bool] = [false, true, false]
    let exp_le: [bool] = [true, true, false]
    let exp_gt: [bool] = [false, false, true]
    let exp_ge: [bool] = [true, false, true]
    let mut j = 0
    while j < len(&c) {
        let x = c[j]
        let y = d[j]
        t.assert_eq!(x == y, exp_eq[j])
        t.assert_eq!(x != y, exp_ne[j])
        t.assert_eq!(x < y, exp_lt[j])
        t.assert_eq!(x <= y, exp_le[j])
        t.assert_eq!(x > y, exp_gt[j])
        t.assert_eq!(x >= y, exp_ge[j])
        j = j + 1
    }
    let _add: u64 = a[0] + b[0]
    let _sub: u64 = a[0] - b[0]
    let _mul: u64 = a[0] * b[0]
    let _div: u64 = a[0] / b[0]
    let _rem: u64 = a[0] % b[0]
    let _and: u64 = a[0] & b[0]
    let _or: u64 = a[0] | b[0]
    let _xor: u64 = a[0] ^ b[0]
    let _shl: u64 = a[0] << b[0]
    let _shr: u64 = a[0] >> b[0]
    let _lt: bool = c[0] < d[0]
    let _le: bool = c[0] <= d[0]
    let _gt: bool = c[0] > d[0]
    let _ge: bool = c[0] >= d[0]
    let _eq: bool = c[0] == d[0]
    let _ne: bool = c[0] != d[0]
}

fn test_ops_isize() {
    let a: [isize] = [6, 7, 8]
    let b: [isize] = [3, 2, 1]
    let sh: [usize] = [3, 2, 1]
    let exp_add: [isize] = [9, 9, 9]
    let exp_sub: [isize] = [3, 5, 7]
    let exp_mul: [isize] = [18, 14, 8]
    let exp_div: [isize] = [2, 3, 8]
    let exp_rem: [isize] = [0, 1, 0]
    let exp_and: [isize] = [2, 2, 0]
    let exp_or: [isize] = [7, 7, 9]
    let exp_xor: [isize] = [5, 5, 9]
    let exp_shl: [isize] = [48, 28, 16]
    let exp_shr: [isize] = [0, 1, 4]
    let mut i = 0
    while i < len(&a) {
        let x = a[i]
        let y = b[i]
        t.assert_eq!(x + y, exp_add[i])
        t.assert_eq!(x - y, exp_sub[i])
        t.assert_eq!(x * y, exp_mul[i])
        t.assert_eq!(x / y, exp_div[i])
        t.assert_eq!(x % y, exp_rem[i])
        t.assert_eq!(x & y, exp_and[i])
        t.assert_eq!(x | y, exp_or[i])
        t.assert_eq!(x ^ y, exp_xor[i])
        t.assert_eq!(x << sh[i], exp_shl[i])
        t.assert_eq!(x >> sh[i], exp_shr[i])
        i = i + 1
    }
    let c: [isize] = [1, 2, 3]
    let d: [isize] = [1, 3, 2]
    let exp_eq: [bool] = [true, false, false]
    let exp_ne: [bool] = [false, true, true]
    let exp_lt: [bool] = [false, true, false]
    let exp_le: [bool] = [true, true, false]
    let exp_gt: [bool] = [false, false, true]
    let exp_ge: [bool] = [true, false, true]
    let mut j = 0
    while j < len(&c) {
        let x = c[j]
        let y = d[j]
        t.assert_eq!(x == y, exp_eq[j])
        t.assert_eq!(x != y, exp_ne[j])
        t.assert_eq!(x < y, exp_lt[j])
        t.assert_eq!(x <= y, exp_le[j])
        t.assert_eq!(x > y, exp_gt[j])
        t.assert_eq!(x >= y, exp_ge[j])
        j = j + 1
    }
    let _add: isize = a[0] + b[0]
    let _sub: isize = a[0] - b[0]
    let _mul: isize = a[0] * b[0]
    let _div: isize = a[0] / b[0]
    let _rem: isize = a[0] % b[0]
    let _and: isize = a[0] & b[0]
    let _or: isize = a[0] | b[0]
    let _xor: isize = a[0] ^ b[0]
    let _shl: isize = a[0] << sh[0]
    let _shr: isize = a[0] >> sh[0]
    let _lt: bool = c[0] < d[0]
    let _le: bool = c[0] <= d[0]
    let _gt: bool = c[0] > d[0]
    let _ge: bool = c[0] >= d[0]
    let _eq: bool = c[0] == d[0]
    let _ne: bool = c[0] != d[0]
}

