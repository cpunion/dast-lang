fn test_ops_int() {
    let a: [int] = [6, 7, 8]
    let b: [int] = [3, 2, 1]
    let sh: [u64] = [3, 2, 1]
    let exp_add: [int] = [9, 9, 9]
    let exp_sub: [int] = [3, 5, 7]
    let exp_mul: [int] = [18, 14, 8]
    let exp_div: [int] = [2, 3, 8]
    let exp_rem: [int] = [0, 1, 0]
    let exp_and: [int] = [2, 2, 0]
    let exp_or: [int] = [7, 7, 9]
    let exp_xor: [int] = [5, 5, 9]
    let exp_shl: [int] = [48, 28, 16]
    let exp_shr: [int] = [0, 1, 4]
    let mut i = 0
    while i < len(&a) {
        let x = a[i]
        let y = b[i]
        t.assert_eq!(x + y, exp_add[i])
        t.assert_eq!(x - y, exp_sub[i])
        t.assert_eq!(x * y, exp_mul[i])
        t.assert_eq!(x / y, exp_div[i])
        t.assert_eq!(x % y, exp_rem[i])
        t.assert_eq!(x & y, exp_and[i])
        t.assert_eq!(x | y, exp_or[i])
        t.assert_eq!(x ^ y, exp_xor[i])
        t.assert_eq!(x << sh[i], exp_shl[i])
        t.assert_eq!(x >> sh[i], exp_shr[i])
        i = i + 1
    }
    let c: [int] = [1, 2, 3]
    let d: [int] = [1, 3, 2]
    let exp_eq: [bool] = [true, false, false]
    let exp_ne: [bool] = [false, true, true]
    let exp_lt: [bool] = [false, true, false]
    let exp_le: [bool] = [true, true, false]
    let exp_gt: [bool] = [false, false, true]
    let exp_ge: [bool] = [true, false, true]
    let mut j = 0
    while j < len(&c) {
        let x = c[j]
        let y = d[j]
        t.assert_eq!(x == y, exp_eq[j])
        t.assert_eq!(x != y, exp_ne[j])
        t.assert_eq!(x < y, exp_lt[j])
        t.assert_eq!(x <= y, exp_le[j])
        t.assert_eq!(x > y, exp_gt[j])
        t.assert_eq!(x >= y, exp_ge[j])
        j = j + 1
    }
    let _add: int = a[0] + b[0]
    let _sub: int = a[0] - b[0]
    let _mul: int = a[0] * b[0]
    let _div: int = a[0] / b[0]
    let _rem: int = a[0] % b[0]
    let _and: int = a[0] & b[0]
    let _or: int = a[0] | b[0]
    let _xor: int = a[0] ^ b[0]
    let _shl: int = a[0] << sh[0]
    let _shr: int = a[0] >> sh[0]
    let _lt: bool = c[0] < d[0]
    let _le: bool = c[0] <= d[0]
    let _gt: bool = c[0] > d[0]
    let _ge: bool = c[0] >= d[0]
    let _eq: bool = c[0] == d[0]
    let _ne: bool = c[0] != d[0]
}

fn test_bool_ops() {
    let a: [bool] = [true, false, true]
    let b: [bool] = [true, true, false]
    let exp_and: [bool] = [true, false, false]
    let exp_or: [bool] = [true, true, true]
    let exp_eq: [bool] = [true, false, false]
    let exp_ne: [bool] = [false, true, true]
    let mut i = 0
    while i < len(&a) {
        let x = a[i]
        let y = b[i]
        t.assert_eq!(x && y, exp_and[i])
        t.assert_eq!(x || y, exp_or[i])
        t.assert_eq!(x == y, exp_eq[i])
        t.assert_eq!(x != y, exp_ne[i])
        i = i + 1
    }
    let _and: bool = a[0] && b[0]
    let _or: bool = a[0] || b[0]
    let _eq: bool = a[0] == b[0]
    let _ne: bool = a[0] != b[0]
}

fn test_char_cmp() {
    let a: [char] = ['a', 'b', 'c']
    let b: [char] = ['a', 'c', 'b']
    let exp_eq: [bool] = [true, false, false]
    let exp_ne: [bool] = [false, true, true]
    let exp_lt: [bool] = [false, true, false]
    let exp_le: [bool] = [true, true, false]
    let exp_gt: [bool] = [false, false, true]
    let exp_ge: [bool] = [true, false, true]
    let mut i = 0
    while i < len(&a) {
        let x = a[i]
        let y = b[i]
        t.assert_eq!(x == y, exp_eq[i])
        t.assert_eq!(x != y, exp_ne[i])
        t.assert_eq!(x < y, exp_lt[i])
        t.assert_eq!(x <= y, exp_le[i])
        t.assert_eq!(x > y, exp_gt[i])
        t.assert_eq!(x >= y, exp_ge[i])
        i = i + 1
    }
    let _eq: bool = a[0] == b[0]
    let _ne: bool = a[0] != b[0]
    let _lt: bool = a[0] < b[0]
    let _le: bool = a[0] <= b[0]
    let _gt: bool = a[0] > b[0]
    let _ge: bool = a[0] >= b[0]
}

fn test_string_ops() {
    let a = "ab"
    let b = "c"
    let s: String = a + b
    t.assert_eq!(s, "abc")
    let r = &a
    let s2: String = r + "d"
    t.assert_eq!(s2, "abd")
    let s3: String = "x" + r
    t.assert_eq!(s3, "xab")
    let eq: bool = r == &a
    let ne: bool = a != b
    t.assert_eq!(eq, true)
    t.assert_eq!(ne, true)
}

fn test_main() {
    test_ops_i8()
    test_ops_i16()
    test_ops_i32()
    test_ops_i64()
    test_ops_u8()
    test_ops_u16()
    test_ops_u32()
    test_ops_u64()
    test_ops_isize()
    test_ops_usize()
    test_ops_int()
    test_bool_ops()
    test_char_cmp()
    test_string_ops()
}
