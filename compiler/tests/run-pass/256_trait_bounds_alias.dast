trait Cloneable {
    fn clone(self: &Self) -> Self;
}

struct Point {
    x: i32,
}
type P = Point

impl Cloneable for Point {
    fn clone(self: &Self) -> Self {
        return Point { x: self.x }
    }
}

fn use_bound[T: Cloneable](x: T) -> i32 {
    return 1
}

fn main() {
    let p = P{ x: 1 }
    let v = use_bound(p)
    println("v", v)
}
