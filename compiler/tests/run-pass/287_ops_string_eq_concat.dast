fn main() {
    let a = "ab"
    let b = "a" + "b"
    if b != "ab" { exit(1) }

    let c = string_clone(&b)
    if c != b { exit(1) }

    if a == "ac" { exit(1) }

    let d = a + "c"
    if d != "abc" { exit(1) }

    let e = "x" + a
    if e != "xab" { exit(1) }

    let g = a == "ab"
    if g != true { exit(1) }
}
