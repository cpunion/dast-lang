enum OptionI32 {
    Some(i32),
    None,
}

fn main() {
    let opt = OptionI32.Some(7)
    if let .Some(v) = opt {
        println("v", v)
    } else {
        println("none")
    }

    let mut cur = OptionI32.Some(1)
    let mut count = 0
    while true {
        match cur {
            .Some(x) => {
                println("x", x)
                count = count + 1
                if count == 1 {
                    cur = OptionI32.None
                }
            }
            .None => { break }
        }
    }
}
