fn main() {
    let a: i8 = -1
    let b = a & 1
    if b != 1 { exit(1) }

    let c = a ^ 0
    if c != -1 { exit(1) }

    let d: i8 = -2
    let e = d << 1
    if e != -4 { exit(1) }

    let f: i32 = -7
    let g: i32 = 2
    let q = f / g
    let r = f % g
    if q != -3 { exit(1) }
    if r != -1 { exit(1) }
}
