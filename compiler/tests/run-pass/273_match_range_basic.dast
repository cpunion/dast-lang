fn main() {
    let v = 3
    match v {
        1..=3 => {
            println("in", v)
        }
        _ => {
            println("out", v)
        }
    }

    let w = 4
    match w {
        1..3 => {
            println("in", w)
        }
        _ => {
            println("out", w)
        }
    }
}
