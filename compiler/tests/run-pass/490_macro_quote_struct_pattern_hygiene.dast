struct Point { x: i64 }

macro fn add_field(p: AstExpr, body: AstExpr) -> AstExpr {
    quote expr { match $p { Point { x } => $body + x } }
}

fn main() {
    let x = 100
    let p = Point { x: 1 }
    let v = add_field!(quote expr { p }, quote expr { x })
    if v == 101 {
    } else {
        exit(1)
    }
}
