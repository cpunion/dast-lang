import "std/testing" as t

fn test_math() {
    t.assert_eq!(add(1, 2), 3)
    t.assert_eq!(mul(2, 3), 6)
    t.assert_eq!(sub.add10(5), 15)
    t.assert_eq!(local_value(), 7)
    t.assert_eq!(inc(9), 10)
}

fn test_mutation() {
    let mut c = Counter { value: 1 }
    c.value = c.value + 2
    t.assert_eq!(c.value, 3)

    let mut xs = [1, 2]
    push(&mut xs, 3)
    t.assert_eq!(len(&xs), 3)
    let v = pop(&mut xs)
    t.assert_eq!(v, 3)
    t.assert_eq!(len(&xs), 2)
}
