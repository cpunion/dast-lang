ir v0
type $Env = { count: *i64 }
type Closure = { func: usize, env: $Env }

fn __drop_Closure(v: Closure) -> unit
  block entry0:
    t0: i64 = + 0, 0
    t1: bool = == v, t0
    branch t1, done2, drop1
  block drop1:
    t2:  = v.env
    call __drop__Env(t2)
    call struct_free(v)
    jump done2
  block done2:
    return

fn __drop__Env(v: $Env) -> unit
  block entry0:
    t0: i64 = + 0, 0
    t1: bool = == v, t0
    branch t1, done2, drop1
  block drop1:
    call struct_free(v)
    jump done2
  block done2:
    return

fn add(a: int, b: int) -> int
  block entry0:
    t0: i64 = + a, b
    return t0

fn main() -> unit
  block entry0:
    store count, 0
    t0: *i64 = load_addr count
    t1:  = struct $Env { count: t0 }
    t2: Closure = struct Closure { func: "main$0", env: t1 }
    store incr, t2
    t3: Closure = load incr
    t4: unit = call_closure t3()
    t5: int = call add(1, 2)
    store v, t5
    t6: int = load v
    t7: unit = call println("v", t6)
    t8: Closure = load incr
    call __drop_Closure(t8)
    return t7

fn main$0($env: $Env) -> unit
  block entry0:
    t0 = $env.count
    t1 = load_ref t0
    t2 = + t1, 1
    store_ref t0, t2
    return unit

