fn emit_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if expr.kind == EXPR_REF || expr.kind == EXPR_DEREF || expr.kind == EXPR_FIELD || expr.kind == EXPR_MATCH || expr.kind == EXPR_UNARY {
        if len(&expr.args) < 1 {
            println("stage2: bad expr args", expr.kind, "len", len(&expr.args), expr.name)
            exit(1)
        }
    }
    if expr.kind == EXPR_INDEX || expr.kind == EXPR_BINARY {
        if len(&expr.args) < 2 {
            println("stage2: bad expr args", expr.kind, "len", len(&expr.args), expr.name)
            exit(1)
        }
    }
    if expr.kind == EXPR_CALL && len(&expr.args) == 0 {
        if expr.name == "" {
            println("stage2: empty callee for call")
            exit(1)
        }
    }
    match expr.kind {
        EXPR_INT => { return qbe_value("i64", int_to_string(expr.int_value)) }
        EXPR_CHAR => { return qbe_value("char", int_to_string(expr.int_value)) }
        EXPR_FLOAT => { return qbe_value("f64", "d_" + string_clone(&expr.float_text)) }
        EXPR_BOOL => {
            if expr.bool_value { return qbe_value("bool", "1") }
            return qbe_value("bool", "0")
        }
        EXPR_STRING => {
            let id = ensure_string(e, string_clone(&expr.name))
            return qbe_value("&str", "$" + str_ref_label(id))
        }
        EXPR_BLOCK => { return emit_block_expr(e, &expr.block) }
        EXPR_MATCH => { return emit_match_expr(e, expr) }
        EXPR_MACRO_CALL => {
            println("stage2: unexpanded macro call")
            exit(1)
            return qbe_value("i64", "0")
        }
        EXPR_QUOTE => {
            println("stage2: unexpanded quote")
            exit(1)
            return qbe_value("i64", "0")
        }
        EXPR_IDENT => {
            let ci = const_index(e, &expr.name)
            if ci >= 0 {
                if ci >= len(&e.const_exprs) {
                    println("stage2: const expr missing", expr.name, "idx", ci, "names", len(&e.const_names), "exprs", len(&e.const_exprs))
                    exit(1)
                }
                return emit_const_expr(e, &e.const_exprs[ci])
            }
            let vt = var_type(e, &expr.name)
            if vt != "" {
                return emit_load_var(e, &expr.name, &vt)
            }
            if var_index(e, &expr.name) >= 0 {
                let default_t = "i64"
                return emit_load_var(e, &expr.name, default_t)
            }
            return qbe_value("i64", "0")
        }
        EXPR_REF => {
            if len(&expr.args) == 0 { return qbe_value("&i64", "0") }
            let inner = expr_arg_ref(expr, 0, "emit_ref")
            let base_t = expr_type(e, inner)
            let mut ref_t = string_clone("&") + string_clone(&base_t)
            if expr.ref_mut {
                ref_t = "&mut " + string_clone(&base_t)
            }
            check_ref_target(e, inner, expr.ref_mut)
            if inner.kind == EXPR_IDENT {
                let name = string_clone(&inner.name)
                if var_index(e, &name) >= 0 {
                    return qbe_value(ref_t, "%" + var_slot(&name))
                }
            }
            let v = emit_typed_value(e, inner, &base_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            let size = type_size(e, &base_t)
            let align = type_align(e, &base_t)
            let alloc = if align > 4 { "alloc8" } else { "alloc4" }
            emit_line(e, "  " + tn + " =l " + alloc + " " + int_to_string(size))
            let casted = cast_to_type(e, v, &base_t)
            let op = store_op_for_type(e, &base_t)
            emit_line(e, "  " + op + " " + casted + ", " + tn)
            return qbe_value(ref_t, tn)
        }
        EXPR_DEREF => {
            if len(&expr.args) == 0 { return qbe_value("i64", "0") }
            let ptr = emit_expr(e, expr_arg_ref(expr, 0, "emit_deref"))
            if !type_is_ref(e, &ptr.typ) {
                println("stage2: deref requires reference")
                exit(1)
            }
            let base_t = expr_type(e, expr)
            let op = load_op_for_type(e, &base_t)
            let q = qbe_type(e, &base_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " " + op + " " + ptr.expr)
            return qbe_value(base_t, tn)
        }
        EXPR_ARRAY => {
            let arr_t = expr_type(e, expr)
            let mut elem_t = type_array_elem(e, &arr_t)
            let mut arr_name = arr_t
            if elem_t == "untyped-int" {
                elem_t = "i64"
                arr_name = "[" + string_clone(&elem_t) + "]"
            }
            if elem_t == "untyped-float" {
                elem_t = "f64"
                arr_name = "[" + string_clone(&elem_t) + "]"
            }
            let elem_size = type_size(e, &elem_t)
            let elem_align = type_align(e, &elem_t)
            let cap = len(&expr.args)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_array_new(l " + int_to_string(elem_size) + ", l " + int_to_string(elem_align) + ", l " + int_to_string(cap) + ")")
            let mut i = 0
            while i < len(&expr.args) {
                let v = emit_typed_value(e, expr_arg_ref(expr, i, "emit_array_elem"), &elem_t)
                let casted = cast_to_type(e, v, &elem_t)
                if type_is_float(e, &elem_t) {
                    emit_line(e, "  call $dast_array_push(l " + tn + ", l 0)")
                    let addr_tmp = new_temp(e)
                    let addr_tn = temp_name(addr_tmp)
                    emit_line(e, "  " + addr_tn + " =l call $dast_array_index_addr(l " + tn + ", l " + int_to_string(i) + ")")
                    let op = store_op_for_type(e, &elem_t)
                    emit_line(e, "  " + op + " " + casted + ", " + addr_tn)
                } else {
                    let as_l = cast_to_l(e, qbe_value(string_clone(&elem_t), casted))
                    emit_line(e, "  call $dast_array_push(l " + tn + ", l " + as_l + ")")
                }
                i = i + 1
            }
            return qbe_value(arr_name, tn)
        }
        EXPR_INDEX => {
            if len(&expr.args) < 2 { return qbe_value("i64", "0") }
            let recv = emit_expr(e, expr_arg_ref(expr, 0, "emit_index_recv"))
            let idxv = emit_expr(e, expr_arg_ref(expr, 1, "emit_index_idx"))
            let idx = cast_to_l(e, idxv)
            let elem_t = expr_type(e, expr)
            if type_is_float(e, &elem_t) {
                let addr_tmp = new_temp(e)
                let addr_tn = temp_name(addr_tmp)
                emit_line(e, "  " + addr_tn + " =l call $dast_array_index_addr(l " + recv.expr + ", l " + idx + ")")
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                let op = load_op_for_type(e, &elem_t)
                let q = qbe_type(e, &elem_t)
                emit_line(e, "  " + tn + " =" + q + " " + op + " " + addr_tn)
                return qbe_value(elem_t, tn)
            }
            let get_fn = array_get_fn_for_type(e, &elem_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $" + get_fn + "(l " + recv.expr + ", l " + idx + ")")
            return qbe_value(elem_t, tn)
        }
        EXPR_STRUCT_LIT => {
            let st_name = string_clone(&expr.name)
            if struct_index(e, &st_name) < 0 {
                println("stage2: unknown struct", st_name)
                exit(1)
            }
            let name_ptr = string_data_ptr(e, &st_name)
            let size = struct_layout_size(e, &st_name)
            let align = struct_layout_align(e, &st_name)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_alloc(l " + name_ptr + ", l " + int_to_string(size) + ", l " + int_to_string(align) + ")")
            let mut i = 0
            while i < len(&expr.fields) {
                let f = &expr.fields[i]
                let fname = string_clone(&f.name)
                let ftyp = struct_field_type(e, &st_name, &fname)
                if ftyp == "" {
                    println("stage2: unknown struct field", fname)
                    exit(1)
                }
                let v = emit_typed_value(e, &f.value, &ftyp)
                let casted = cast_to_type(e, v, &ftyp)
                let off = struct_field_offset(e, &st_name, &fname)
                emit_mem_store_value(e, &tn, off, &ftyp, casted)
                i = i + 1
            }
            return qbe_value(st_name, tn)
        }
        EXPR_FIELD => {
            if len(&expr.args) == 0 {
                println("stage2: field access missing receiver")
                exit(1)
            }
            if is_digit_str(&expr.name) {
                let idx = parse_int_simple(&expr.name)
                let idx_expr = expr_int(idx)
                let at = expr_index(expr_clone(expr_arg_ref(expr, 0, "emit_field_digit")), idx_expr)
                return emit_expr(e, &at)
            }
            let recv_expr = expr_arg_ref(expr, 0, "emit_field_recv_expr")
            if recv_expr.kind == EXPR_IDENT {
                let recv_name = type_resolve(e, &recv_expr.name)
                let ct = const_type(e, &recv_name)
                let vt = var_type(e, &recv_name)
                if ct == "" && vt == "" && type_is_enum(e, &recv_name) {
                    let dummy = qbe_value("i64", "0")
                    return enum_construct(e, &recv_name, &expr.name, dummy, false)
                }
            }
            let recv = emit_expr(e, expr_arg_ref(expr, 0, "emit_field_recv"))
            let mut recv_expr = recv.expr
            let mut recv_type = recv.typ
            if type_is_ref(e, &recv_type) {
                let base_t = type_ref_base(e, &recv_type)
                let op = load_op_for_type(e, &base_t)
                let q = qbe_type(e, &base_t)
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =" + q + " " + op + " " + recv_expr)
                recv_expr = tn
                recv_type = base_t
            }
            let recv_base = type_strip_ref(e, &recv_type)
            let fname = string_clone(&expr.name)
            let ftyp = struct_field_type(e, &recv_base, &fname)
            if ftyp == "" {
                println("stage2: unknown field", fname, "in", recv_base)
                exit(1)
            }
            let off = struct_field_offset(e, &recv_base, &fname)
            if type_is_struct(e, &ftyp) {
                return emit_mem_load_value_owned(e, &recv_expr, off, &ftyp)
            }
            return emit_mem_load_value(e, &recv_expr, off, &ftyp)
        }
        EXPR_UNARY => { return emit_unary_expr(e, expr) }
        EXPR_BINARY => {
            return emit_binary_expr(e, expr)
        }
        EXPR_CALL => {
            let ci = closure_index(e, &expr.name)
            if ci >= 0 {
                if len(&expr.args) > 0 {
                    println("stage2: closure args not supported yet")
                    exit(1)
                }
                emit_block(e, &e.closure_blocks[ci])
                return qbe_value("unit", "0")
            }
            if expr.name == "print" || expr.name == "println" {
                emit_print_call(e, expr)
                return qbe_value("unit", "0")
            }
            if expr.name == "len" {
                if len(&expr.args) < 1 { return qbe_value("i64", "0") }
                let mut v = emit_expr(e, expr_arg_ref(expr, 0, "emit_len"))
                if type_is_ref(e, &v.typ) {
                    let base = type_ref_base(e, &v.typ)
                    if type_is_string(e, &v.typ) || type_is_array(e, &base) {
                        v = emit_deref_value(e, v)
                    }
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                let fn_name = if type_is_string(e, &v.typ) { "dast_string_len" } else { "dast_array_len" }
                emit_line(e, "  " + tn + " =l call $" + fn_name + "(l " + v.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "string_clone" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let mut v = emit_expr(e, expr_arg_ref(expr, 0, "emit_string_clone"))
                if type_is_string(e, &v.typ) && type_is_ref(e, &v.typ) {
                    v = emit_deref_value(e, v)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_string_clone(l " + v.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "char_at" {
                if len(&expr.args) < 2 { return qbe_value("i64", "0") }
                let mut s = emit_expr(e, expr_arg_ref(expr, 0, "emit_char_at_s"))
                if type_is_string(e, &s.typ) && type_is_ref(e, &s.typ) {
                    s = emit_deref_value(e, s)
                }
                let idx = emit_expr(e, expr_arg_ref(expr, 1, "emit_char_at_idx"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_char_at(l " + s.expr + ", l " + idx.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "substr" {
                if len(&expr.args) < 3 { return qbe_value("String", "0") }
                let mut s = emit_expr(e, expr_arg_ref(expr, 0, "emit_substr_s"))
                if type_is_string(e, &s.typ) && type_is_ref(e, &s.typ) {
                    s = emit_deref_value(e, s)
                }
                let start = emit_expr(e, expr_arg_ref(expr, 1, "emit_substr_start"))
                let count = emit_expr(e, expr_arg_ref(expr, 2, "emit_substr_count"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_substr(l " + s.expr + ", l " + start.expr + ", l " + count.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "read_file" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_file"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_file(l " + path.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "read_dir" {
                if len(&expr.args) < 1 { return qbe_value("[String]", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_dir"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_dir(l " + path.expr + ")")
                return qbe_value("[String]", tn)
            }
            if expr.name == "write_file" {
                if len(&expr.args) < 2 { return qbe_value("unit", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_write_file_path"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let mut data = emit_expr(e, expr_arg_ref(expr, 1, "emit_write_file_data"))
                if type_is_string(e, &data.typ) && type_is_ref(e, &data.typ) {
                    data = emit_deref_value(e, data)
                }
                emit_line(e, "  call $dast_write_file(l " + path.expr + ", l " + data.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "mkdir" {
                if len(&expr.args) < 1 { return qbe_value("unit", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_mkdir"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                emit_line(e, "  call $dast_mkdir(l " + path.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "exec" {
                if len(&expr.args) < 2 { return qbe_value("i64", "0") }
                let mut cmd = emit_expr(e, expr_arg_ref(expr, 0, "emit_exec_cmd"))
                if type_is_string(e, &cmd.typ) && type_is_ref(e, &cmd.typ) {
                    cmd = emit_deref_value(e, cmd)
                }
                let args = emit_expr(e, expr_arg_ref(expr, 1, "emit_exec_args"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_exec(l " + cmd.expr + ", l " + args.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "exit" {
                if len(&expr.args) < 1 { return qbe_value("unit", "0") }
                let code = emit_expr(e, expr_arg_ref(expr, 0, "emit_exit"))
                emit_line(e, "  call $dast_exit(l " + code.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "args" {
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_args()")
                return qbe_value("[String]", tn)
            }
            if expr.name == "getenv" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let v = emit_expr(e, expr_arg_ref(expr, 0, "emit_getenv_arg"))
                let target = "&str"
                let arg = cast_to_type(e, v, target)
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_getenv(l " + arg + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "read_line" {
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_line()")
                return qbe_value("String", tn)
            }
            if expr.name == "read_bytes" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let count = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_bytes"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_bytes(l " + count.expr + ")")
                return qbe_value("String", tn)
            }
            let ec = enum_call_parse(&expr.name)
            if ec.ok && type_is_enum(e, &ec.enum_name) {
                let mut payload = qbe_value("i64", "0")
                let mut has_payload_arg = false
                if len(&expr.args) > 0 {
                    let payload_t = enum_variant_payload_type(e, &ec.enum_name, &ec.variant)
                    payload = emit_typed_value(e, expr_arg_ref(expr, 0, "emit_enum_payload"), &payload_t)
                    has_payload_arg = true
                }
                return enum_construct(e, &ec.enum_name, &ec.variant, payload, has_payload_arg)
            }
            let mut call_name = string_clone(&expr.name)
            let mut rt = func_ret_type_for_call(e, &expr.name, &expr.args)
            let di = func_decl_index(e, &expr.name)
            let mut param_types: [String] = []
            let mut call_type_params: [String] = []
            if di >= 0 {
                let f = &e.func_decls[di]
                if len(&f.type_params) > 0 {
                    call_type_params = func_type_param_names(f)
                }
                if len(&f.type_params) > 0 {
                    let values = func_type_args_for_call(e, f, &expr.args)
                    let mut ok = true
                    let mut vi = 0
                    while vi < len(&values) {
                        if values[vi] == "" { ok = false }
                        vi = vi + 1
                    }
                    if ok {
                        let params = func_type_param_names(f)
                        call_name = ensure_inst_func(e, f, &values)
                        let rt_sub = type_subst(e, &f.ret_type, &params, &values)
                        rt = type_resolve(e, &rt_sub)
                        param_types = func_param_types_for_call(e, f, &values)
                    } else {
                        let mut empty_vals: [String] = []
                        param_types = func_param_types_for_call(e, f, &empty_vals)
                    }
                } else {
                    let mut empty_vals: [String] = []
                    param_types = func_param_types_for_call(e, f, &empty_vals)
                }
            }
            let callee = "dast_user_" + mangle_name(&call_name)
            let ret_t = type_resolve(e, &rt)
            let ret_q = qbe_type(e, &ret_t)
            let mut args_text = string_clone("")
            let mut i = 0
            while i < len(&expr.args) {
                if i > 0 { args_text = args_text + ", " }
                let mut has_param = false
                if i < len(&param_types) { has_param = true }
                if has_param {
                    let pt = string_clone(&param_types[i])
                    if pt != "" && !type_is_ref(e, &pt) {
                        let arg_expr = expr_arg_ref(expr, i, "emit_call_arg_type")
                        if arg_expr.kind == EXPR_IDENT {
                            let src_t = expr_type(e, arg_expr)
                            if drop_needs_drop_type_env(e, &src_t) {
                                drop_live_remove(e, &arg_expr.name)
                            }
                        }
                    }
                }
                let mut v = qbe_value("i64", "0")
                let arg_expr = expr_arg_ref(expr, i, "emit_call_arg_val")
                if has_param {
                    let pt = string_clone(&param_types[i])
                    if pt != "" && type_is_ref(e, &pt) {
                        let arg_t = expr_type(e, arg_expr)
                        if type_is_ref(e, &arg_t) {
                            if !type_compatible(e, &pt, &arg_t) {
                                let ok_generic = type_matches_generic(e, &pt, &arg_t)
                                let ok_params = len(&call_type_params) > 0 && type_matches_pattern(e, &pt, &arg_t, &call_type_params)
                                let ok_base = type_base_match(e, &pt, &arg_t)
                                if !ok_generic && !ok_params && !ok_base {
                                    println("stage2: call arg type mismatch expected", pt, "got", arg_t)
                                    exit(1)
                                }
                            }
                            v = emit_expr(e, arg_expr)
                        } else {
                            let base_t = type_ref_base(e, &pt)
                            if !type_compatible_expr(e, &base_t, arg_expr) {
                                let actual = expr_type(e, arg_expr)
                                let ok_generic = type_matches_generic(e, &base_t, &actual)
                                let ok_params = len(&call_type_params) > 0 && type_matches_pattern(e, &base_t, &actual, &call_type_params)
                                let ok_base = type_base_match(e, &base_t, &actual)
                                if !ok_generic && !ok_params && !ok_base {
                                    println("stage2: call arg type mismatch expected", base_t, "got", actual)
                                    exit(1)
                                }
                            }
                            v = emit_auto_borrow(e, arg_expr, &pt)
                        }
                    } else if pt != "" {
                        if !type_compatible_expr(e, &pt, arg_expr) {
                            let actual = expr_type(e, arg_expr)
                            let ok_generic = type_matches_generic(e, &pt, &actual)
                            let ok_params = len(&call_type_params) > 0 && type_matches_pattern(e, &pt, &actual, &call_type_params)
                            let ok_base = type_base_match(e, &pt, &actual)
                            if !ok_generic && !ok_params && !ok_base {
                                println("stage2: call arg type mismatch expected", pt, "got", actual)
                                exit(1)
                            }
                        }
                        v = emit_typed_value(e, arg_expr, &pt)
                    } else {
                        v = emit_expr(e, arg_expr)
                    }
                } else {
                    v = emit_expr(e, arg_expr)
                }
                let qt = qbe_type(e, &v.typ)
                args_text = args_text + qt + " " + v.expr
                i = i + 1
            }
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + ret_q + " call $" + callee + "(" + args_text + ")")
            return qbe_value(ret_t, tn)
        }
        _ => {
            println("stage2: unsupported expr kind", expr.kind)
            exit(1)
            return qbe_value("i64", "0")
        }
    }
}

fn print_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return string_clone("dast_print_bool") }
    if type_is_string(e, t) { return string_clone("dast_print_string") }
    if type_is_struct(e, t) { return string_clone("dast_print_struct") }
    return string_clone("dast_print_i64")
}

fn emit_print_arg(e: &mut Emitter, v: &QbeValue) {
    // Emit any prerequisite lines (for loads).
    let mut i = 0
    while i < len(&v.lines) {
        emit_line(e, string_clone(&v.lines[i]))
        i = i + 1
    }
    let mut arg = QbeValue { typ: string_clone(&v.typ), expr: string_clone(&v.expr), lines: qbe_lines_empty() }
    if type_is_string(e, &arg.typ) && type_is_ref(e, &arg.typ) {
        arg = emit_deref_value(e, arg)
    }
    let fn_name = print_fn_for_type(e, &arg.typ)
    let qt = qbe_type(e, &arg.typ)
    emit_line(e, "  call $" + fn_name + "(" + qt + " " + arg.expr + ")")
}

fn emit_print_call(e: &mut Emitter, call: &Expr) {
    let newline = call.name == "println"
    let mut i = 0
    while i < len(&call.args) {
        if i > 0 {
            emit_line(e, "  call $dast_print_space()")
        }
        let v = emit_expr(e, expr_arg_ref(call, i, "emit_print_arg"))
        emit_print_arg(e, &v)
        i = i + 1
    }
    if newline {
        emit_line(e, "  call $dast_print_newline()")
    }
}
