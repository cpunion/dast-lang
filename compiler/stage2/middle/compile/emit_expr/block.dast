fn emit_store_let(e: &mut Emitter, name: &str, expr: &Expr) {
    let typ = var_type(e, name)
    let declared = type_resolve(e, &typ)
    if declared == "" {
        println("stage2: let missing type for", name)
        exit(1)
    }
    if expr.kind == EXPR_CLOSURE {
        closure_add(e, name, &expr.block)
        return
    }
    // Moves from non-copy identifiers should transfer drop ownership.
    if expr.kind == EXPR_IDENT {
        let src_t = expr_type(e, expr)
        if drop_needs_drop_type_env(e, &src_t) {
            drop_live_remove(e, &expr.name)
        }
    }
    let mut v = qbe_value("i64", "0")
    if expr.kind == EXPR_STRUCT_LIT {
        let actual = type_resolve(e, &expr.name)
        let db = type_strip_args(e, &declared)
        let ab = type_strip_args(e, &actual)
        if db != "" && db == ab && declared != actual {
            let mut lit = expr_clone(expr)
            lit.name = string_clone(&declared)
            v = emit_typed_value(e, &lit, &declared)
        } else {
            v = emit_typed_value(e, expr, &declared)
        }
    } else {
        v = emit_typed_value(e, expr, &declared)
    }
    drop_live_drop_existing(e, name)
    let op = store_op_for_type(e, &typ)
    emit_line(e, "  " + op + " " + v.expr + ", %" + var_slot(name))
    drop_live_set(e, name, &typ)
}

fn emit_block(e: &mut Emitter, b: &Block) {
    let mut i = 0
    while i < len(&b.stmts) {
        emit_stmt(e, &b.stmts[i])
        i = i + 1
    }
}

fn block_ends_with_terminator(b: &Block) -> bool {
    let n = len(&b.stmts)
    if n == 0 { return false }
    let last = stmt_clone(&b.stmts[n - 1])
    return last.kind == STMT_BREAK || last.kind == STMT_CONTINUE || last.kind == STMT_RETURN
}

fn emit_store_assign(e: &mut Emitter, lhs: &Expr, expr: &Expr) {
    if lhs.kind == EXPR_IDENT {
        if !var_is_mut(e, &lhs.name) {
            println("stage2: cannot assign to immutable value", lhs.name)
            exit(1)
        }
        emit_store_let(e, &lhs.name, expr)
        return
    }
    if lhs.kind == EXPR_FIELD {
        let base_name = expr_lvalue_base(lhs)
        let base_t = var_type(e, &base_name)
        if base_name != "" && !var_is_mut(e, &base_name) && !type_is_mut_ref(e, &base_t) {
            println("stage2: cannot assign to immutable value", base_name)
            exit(1)
        }
        if len(&lhs.args) == 0 {
            println("stage2: field assignment missing receiver")
            exit(1)
        }
        let recv = emit_expr(e, expr_arg_ref(lhs, 0, "assign_field_recv"))
        let mut recv_expr = recv.expr
        let mut recv_base = recv.typ
        if type_is_ref(e, &recv_base) {
            let base_t = type_ref_base(e, &recv_base)
            let op = load_op_for_type(e, &base_t)
            let q = qbe_type(e, &base_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " " + op + " " + recv_expr)
            recv_expr = tn
            recv_base = base_t
        }
        recv_base = type_strip_ref(e, &recv_base)
        let fname = string_clone(&lhs.name)
        let ftyp = struct_field_type(e, &recv_base, &fname)
        if ftyp == "" {
            println("stage2: unknown field", fname)
            exit(1)
        }
        let v = emit_typed_value(e, expr, &ftyp)
        let casted = cast_to_type(e, v, &ftyp)
        let off = struct_field_offset(e, &recv_base, &fname)
        emit_mem_store_value(e, &recv_expr, off, &ftyp, casted)
        return
    }
    if lhs.kind == EXPR_INDEX {
        let base_name = expr_lvalue_base(lhs)
        let base_t = var_type(e, &base_name)
        if base_name != "" && !var_is_mut(e, &base_name) && !type_is_mut_ref(e, &base_t) {
            println("stage2: cannot assign to immutable value", base_name)
            exit(1)
        }
        if len(&lhs.args) < 2 {
            println("stage2: index assignment missing args")
            exit(1)
        }
        let recv = emit_expr(e, expr_arg_ref(lhs, 0, "assign_index_recv"))
        let idxv = emit_expr(e, expr_arg_ref(lhs, 1, "assign_index_idx"))
        let idx = cast_to_l(e, idxv)
        let elem_t = expr_type(e, lhs)
        let v = emit_typed_value(e, expr, &elem_t)
        let casted = cast_to_type(e, v, &elem_t)
        if type_is_float(e, &elem_t) {
            let addr_tmp = new_temp(e)
            let addr_tn = temp_name(addr_tmp)
            emit_line(e, "  " + addr_tn + " =l call $dast_array_index_addr(l " + recv.expr + ", l " + idx + ")")
            let op = store_op_for_type(e, &elem_t)
            emit_line(e, "  " + op + " " + casted + ", " + addr_tn)
        } else {
            let as_l = cast_to_l(e, qbe_value(string_clone(&elem_t), casted))
            emit_line(e, "  call $dast_array_set(l " + recv.expr + ", l " + idx + ", l " + as_l + ")")
        }
        return
    }
    if lhs.kind == EXPR_DEREF && len(&lhs.args) > 0 {
        let ptr = emit_expr(e, expr_arg_ref(lhs, 0, "assign_deref_ptr"))
        if !type_is_mut_ref(e, &ptr.typ) {
            println("stage2: assignment through & requires &mut")
            exit(1)
        }
        let target_t = expr_type(e, lhs)
        let v = emit_typed_value(e, expr, &target_t)
        let casted = cast_to_type(e, v, &target_t)
        let op = store_op_for_type(e, &target_t)
        emit_line(e, "  " + op + " " + casted + ", " + ptr.expr)
        return
    }
    println("stage2: unsupported assignment target")
    exit(1)
}

fn emit_if(e: &mut Emitter, stmt: &Stmt) {
    let cond_val = emit_expr(e, &stmt.expr)
    let cond_expr = ensure_bool_expr(e, cond_val)
    let then_label = new_label(e, "if_then_")
    let else_label = new_label(e, "if_else_")
    let end_label = new_label(e, "if_end_")
    emit_line(e, "  jnz " + cond_expr + ", @" + string_clone(&then_label) + ", @" + string_clone(&else_label))
    emit_label(e, &then_label)
    emit_block(e, &stmt.block)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &else_label)
    if stmt.has_else { emit_block(e, &stmt.else_block) }
    if !stmt.has_else || !block_ends_with_terminator(&stmt.else_block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &end_label)
}

fn emit_store_value(e: &mut Emitter, name: &str, typ: &str, value_expr: &str) {
    if name == "" { return }
    drop_live_drop_existing(e, name)
    let op = store_op_for_type(e, typ)
    emit_line(e, "  " + op + " " + string_clone(value_expr) + ", %" + var_slot(name))
    drop_live_set(e, name, typ)
}

fn emit_iflet(e: &mut Emitter, stmt: &Stmt) {
    let scrut = emit_expr(e, &stmt.expr)
    let mut enum_t = expr_type(e, &stmt.expr)
    if !type_is_enum(e, &enum_t) && stmt.expr.kind == EXPR_IDENT {
        let hint = enum_var_hint(e, &stmt.expr.name)
        if hint != "" { enum_t = hint }
    }
    if !type_is_enum(e, &enum_t) && enum_t == "" {
        let guess = enum_name_for_variant(e, &stmt.pat_variant)
        if guess != "" { enum_t = guess }
    }
    if !type_is_enum(e, &enum_t) {
        println("stage2: if let requires enum expression")
        exit(1)
    }
    let tag_t = enum_tag_type(e, &enum_t)
    let tagv = enum_tag_from_value(e, &scrut, &enum_t)
    let tag_val = enum_variant_value(e, &enum_t, &stmt.pat_variant)
    let cond_tmp = new_temp(e)
    let cond_tn = temp_name(cond_tmp)
    let cmp = qbe_cmp_op(e, "==", string_clone(&tag_t))
    emit_line(e, "  " + cond_tn + " =w " + cmp + " " + tagv.expr + ", " + int_to_string(tag_val))
    let then_label = new_label(e, "iflet_then_")
    let else_label = new_label(e, "iflet_else_")
    let end_label = new_label(e, "iflet_end_")
    emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&then_label) + ", @" + string_clone(&else_label))
    emit_label(e, &then_label)
    if stmt.pat_has_binding {
        let payload_t = enum_variant_payload_type(e, &enum_t, &stmt.pat_variant)
        let payload_v = enum_payload_from_value(e, &scrut, &enum_t, &stmt.pat_variant)
        let mut bind_t = var_type(e, &stmt.pat_binding)
        if bind_t == "" { bind_t = payload_t }
        if type_is_struct(e, &bind_t) {
            let copy_ptr = emit_struct_copy_from_addr(e, &payload_v.expr, &bind_t)
            emit_store_value(e, &stmt.pat_binding, &bind_t, &copy_ptr)
        } else {
            let casted = cast_to_type(e, payload_v, &bind_t)
            emit_store_value(e, &stmt.pat_binding, &bind_t, &casted)
        }
    }
    emit_block(e, &stmt.block)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &else_label)
    if stmt.has_else { emit_block(e, &stmt.else_block) }
    if !stmt.has_else || !block_ends_with_terminator(&stmt.else_block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &end_label)
}

fn emit_match(e: &mut Emitter, stmt: &Stmt) {
    let scrut = emit_expr(e, &stmt.expr)
    let mut scrut_t = expr_type(e, &stmt.expr)
    if stmt.expr.kind == EXPR_IDENT {
        let hint = enum_var_hint(e, &stmt.expr.name)
        if hint != "" { scrut_t = hint }
    }
    let mut is_enum = type_is_enum(e, &scrut_t)
    if !is_enum {
        let mut guess = string_clone("")
        let mut ai = 0
        while ai < len(&stmt.arms) {
            if stmt.arms[ai].pattern.kind == PAT_VARIANT {
                guess = enum_name_for_variant(e, &stmt.arms[ai].pattern.variant)
                break
            }
            ai = ai + 1
        }
        if guess != "" { scrut_t = guess; is_enum = true }
    }
    let end_label = new_label(e, "match_end_")
    let mut i = 0
    let mut next_label = new_label(e, "match_next_")
    while i < len(&stmt.arms) {
        let arm = &stmt.arms[i]
        emit_pattern_check(e, &arm.pattern, &scrut, &scrut_t, &next_label)
        emit_pattern_bind(e, &arm.pattern, &scrut, &scrut_t)
        if arm.has_guard {
            let gt = expr_type(e, &arm.guard)
            if !type_is_bool(e, &gt) {
                println("stage2: match guard must be bool")
                exit(1)
            }
            let gv = emit_expr(e, &arm.guard)
            let cond = ensure_bool_expr(e, gv)
            let guard_label = new_label(e, "match_guard_")
            emit_line(e, "  jnz " + cond + ", @" + string_clone(&guard_label) + ", @" + string_clone(&next_label))
            emit_label(e, &guard_label)
        }
        emit_block(e, &arm.block)
        if !block_ends_with_terminator(&arm.block) {
            emit_line(e, "  jmp @" + string_clone(&end_label))
        }
        emit_label(e, &next_label)
        next_label = new_label(e, "match_next_")
        i = i + 1
    }
    emit_label(e, &end_label)
}
