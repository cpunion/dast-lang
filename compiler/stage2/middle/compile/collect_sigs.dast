fn collect_type_aliases(e: &mut Emitter, prog: &Program) {
    let mut names = string_list_empty()
    let mut targets = string_list_empty()
    let mut i = 0
    while i < len(&prog.type_aliases) {
        let a = &prog.type_aliases[i]
        push(&mut names, string_clone(&a.name))
        push(&mut targets, string_clone(&a.target))
        i = i + 1
    }
    e.type_alias_names = names
    e.type_alias_targets = targets
    // Resolve alias targets after the table is populated.
    let mut j = 0
    while j < len(&e.type_alias_targets) {
        e.type_alias_targets[j] = type_resolve(e, &e.type_alias_targets[j])
        type_check_valid(e, &e.type_alias_targets[j])
        j = j + 1
    }
}

fn collect_structs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.structs) {
        let s = &prog.structs[i]
        let mut tparams: [String] = []
        let mut tp = 0
        while tp < len(&s.type_params) {
            push(&mut tparams, string_clone(&s.type_params[tp].name))
            tp = tp + 1
        }
        let mut fields = struct_field_sig_list_empty()
        let mut fi = 0
        while fi < len(&s.fields) {
            let f = &s.fields[fi]
            let ft = type_resolve(e, &f.typ)
            type_check_valid(e, &ft)
            push(&mut fields, StructFieldSig { name: string_clone(&f.name), typ: ft })
            fi = fi + 1
        }
        let mut sigs = e.struct_sigs
        push(&mut sigs, StructSig { name: string_clone(&s.name), type_params: tparams, fields: fields })
        e.struct_sigs = sigs
        i = i + 1
    }
}

fn collect_enums(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.enums) {
        let en = &prog.enums[i]
        let mut tparams: [String] = []
        let mut tp = 0
        while tp < len(&en.type_params) {
            push(&mut tparams, string_clone(&en.type_params[tp].name))
            tp = tp + 1
        }
        let mut variants = enum_variant_sig_list_empty()
        let mut vi = 0
        while vi < len(&en.variants) {
            let v = &en.variants[vi]
            let pt = type_resolve(e, &v.payload_type)
            type_check_valid(e, &pt)
            push(&mut variants, EnumVariantSig { name: string_clone(&v.name), value: vi, has_payload: v.has_payload, payload_type: pt })
            vi = vi + 1
        }
        let mut sigs = e.enum_sigs
        let tag_t = type_resolve(e, &en.tag_type)
        type_check_valid(e, &tag_t)
        push(&mut sigs, EnumSig { name: string_clone(&en.name), type_params: tparams, tag_type: tag_t, variants: variants })
        e.enum_sigs = sigs
        i = i + 1
    }
}

fn collect_funcs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.functions) {
        let f = &prog.functions[i]
        if f.is_macro { i = i + 1; continue }
        let mut pi = 0
        while pi < len(&f.params) {
            let p = &f.params[pi]
            if p.has_type {
                let pt = type_resolve(e, &p.typ)
                type_check_valid(e, &pt)
            }
            pi = pi + 1
        }
        let mut sigs = e.func_sigs
        let mut decls = e.func_decls
        let rt = effective_ret_type(e, f)
        if rt != "" { type_check_valid(e, &rt) }
        push(&mut sigs, FuncSig { name: string_clone(&f.name), ret_type: rt })
        push(&mut decls, function_clone(f))
        e.func_sigs = sigs
        e.func_decls = decls
        i = i + 1
    }
}

fn collect_impls(e: &mut Emitter, prog: &Program) {
    e.impls = impl_decl_list_clone(&prog.impls)
}

fn collect_traits(e: &mut Emitter, prog: &Program) {
    e.traits = trait_decl_list_clone(&prog.traits)
}

fn collect_consts(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.consts) {
        let c = &prog.consts[i]
        let mut ct = expr_type(e, &c.expr)
        if c.has_type { ct = string_clone(&c.typ) }
        let mut names = e.const_names
        let mut exprs = e.const_exprs
        let mut types = e.const_types
        push(&mut names, string_clone(&c.name))
        push(&mut exprs, expr_clone(&c.expr))
        push(&mut types, ct)
        e.const_names = names
        e.const_exprs = exprs
        e.const_types = types
        i = i + 1
    }
}
