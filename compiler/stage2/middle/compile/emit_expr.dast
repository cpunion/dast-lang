fn emit_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if expr.kind == EXPR_REF || expr.kind == EXPR_DEREF || expr.kind == EXPR_FIELD || expr.kind == EXPR_MATCH {
        if len(&expr.args) < 1 {
            println("stage2: bad expr args", expr.kind, "len", len(&expr.args), expr.name)
            exit(1)
        }
    }
    if expr.kind == EXPR_INDEX || expr.kind == EXPR_BINARY {
        if len(&expr.args) < 2 {
            println("stage2: bad expr args", expr.kind, "len", len(&expr.args), expr.name)
            exit(1)
        }
    }
    if expr.kind == EXPR_CALL && len(&expr.args) == 0 {
        if expr.name == "" {
            println("stage2: empty callee for call")
            exit(1)
        }
    }
    match expr.kind {
        EXPR_INT => { return qbe_value("i64", int_to_string(expr.int_value)) }
        EXPR_CHAR => { return qbe_value("i64", int_to_string(expr.int_value)) }
        EXPR_BOOL => {
            if expr.bool_value { return qbe_value("bool", "1") }
            return qbe_value("bool", "0")
        }
        EXPR_STRING => {
            let id = ensure_string(e, string_clone(&expr.name))
            return qbe_value("String", "$" + str_struct_label(id))
        }
        EXPR_BLOCK => { return emit_block_expr(e, &expr.block) }
        EXPR_MATCH => { return emit_match_expr(e, expr) }
        EXPR_MACRO_CALL => {
            println("stage2: unexpanded macro call")
            exit(1)
            return qbe_value("i64", "0")
        }
        EXPR_QUOTE => {
            println("stage2: unexpanded quote")
            exit(1)
            return qbe_value("i64", "0")
        }
        EXPR_IDENT => {
            let ci = const_index(e, &expr.name)
            if ci >= 0 {
                if ci >= len(&e.const_exprs) {
                    println("stage2: const expr missing", expr.name, "idx", ci, "names", len(&e.const_names), "exprs", len(&e.const_exprs))
                    exit(1)
                }
                return emit_const_expr(e, &e.const_exprs[ci])
            }
            let vt = var_type(e, &expr.name)
            if vt != "" {
                return emit_load_var(e, &expr.name, &vt)
            }
            if var_index(e, &expr.name) >= 0 {
                return emit_load_var(e, &expr.name, "i64")
            }
            return qbe_value("i64", "0")
        }
        EXPR_REF => {
            if len(&expr.args) == 0 { return qbe_value("&i64", "0") }
            let inner = expr_arg_ref(expr, 0, "emit_ref")
            let base_t = expr_type(e, inner)
            let mut ref_t = "&" + string_clone(&base_t)
            if expr.ref_mut {
                ref_t = "&mut " + string_clone(&base_t)
            }
            check_ref_target(e, inner, expr.ref_mut)
            if inner.kind == EXPR_IDENT {
                let name = string_clone(&inner.name)
                if var_index(e, &name) >= 0 {
                    return qbe_value(ref_t, "%" + var_slot(&name))
                }
            }
            let v = emit_expr(e, inner)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l alloc8 8")
            let casted = cast_to_type(e, v, &base_t)
            let op = store_op_for_type(e, &base_t)
            emit_line(e, "  " + op + " " + casted + ", " + tn)
            return qbe_value(ref_t, tn)
        }
        EXPR_DEREF => {
            if len(&expr.args) == 0 { return qbe_value("i64", "0") }
            let ptr = emit_expr(e, expr_arg_ref(expr, 0, "emit_deref"))
            if !type_is_ref(e, &ptr.typ) {
                println("stage2: deref requires reference")
                exit(1)
            }
            let base_t = expr_type(e, expr)
            let op = load_op_for_type(e, &base_t)
            let q = qbe_type(e, &base_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " " + op + " " + ptr.expr)
            return qbe_value(base_t, tn)
        }
        EXPR_ARRAY => {
            let arr_t = expr_type(e, expr)
            let cap = len(&expr.args)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_array_new(l " + int_to_string(cap) + ")")
            let mut i = 0
            while i < len(&expr.args) {
                let v = emit_expr(e, expr_arg_ref(expr, i, "emit_array_elem"))
                let casted = cast_to_l(e, v)
                emit_line(e, "  call $dast_array_push(l " + tn + ", l " + casted + ")")
                i = i + 1
            }
            return qbe_value(arr_t, tn)
        }
        EXPR_INDEX => {
            if len(&expr.args) < 2 { return qbe_value("i64", "0") }
            let recv = emit_expr(e, expr_arg_ref(expr, 0, "emit_index_recv"))
            let idxv = emit_expr(e, expr_arg_ref(expr, 1, "emit_index_idx"))
            let idx = cast_to_l(e, idxv)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_array_get(l " + recv.expr + ", l " + idx + ")")
            let t = expr_type(e, expr)
            return qbe_value(t, tn)
        }
        EXPR_STRUCT_LIT => {
            let st_name = string_clone(&expr.name)
            if struct_index(e, &st_name) < 0 {
                println("stage2: unknown struct", st_name)
                exit(1)
            }
            let name_ptr = string_data_ptr(e, &st_name)
            let field_count = struct_field_count(e, &st_name)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_struct_new(l " + name_ptr + ", l " + int_to_string(field_count) + ")")
            let mut i = 0
            while i < len(&expr.fields) {
                let f = &expr.fields[i]
                let fname = string_clone(&f.name)
                let ftyp = struct_field_type(e, &st_name, &fname)
                if ftyp == "" {
                    println("stage2: unknown struct field", fname)
                    exit(1)
                }
                let v = emit_expr(e, &f.value)
                let casted = cast_to_type(e, v, &ftyp)
                let fname_ptr = string_data_ptr(e, &fname)
                let set_fn = struct_set_fn_for_type(e, &ftyp)
                let q = qbe_type(e, &ftyp)
                emit_line(e, "  call $" + set_fn + "(l " + tn + ", l " + fname_ptr + ", " + q + " " + casted + ")")
                i = i + 1
            }
            return qbe_value(st_name, tn)
        }
        EXPR_FIELD => {
            if len(&expr.args) == 0 {
                println("stage2: field access missing receiver")
                exit(1)
            }
            if is_digit_str(&expr.name) {
                let idx = parse_int_simple(&expr.name)
                let idx_expr = expr_int(idx)
                let at = expr_index(expr_clone(expr_arg_ref(expr, 0, "emit_field_digit")), idx_expr)
                return emit_expr(e, &at)
            }
            let recv_expr = expr_arg_ref(expr, 0, "emit_field_recv_expr")
            if recv_expr.kind == EXPR_IDENT {
                let recv_name = type_resolve(e, &recv_expr.name)
                let ct = const_type(e, &recv_name)
                let vt = var_type(e, &recv_name)
                if ct == "" && vt == "" && type_is_enum(e, &recv_name) {
                    let dummy = qbe_value("i64", "0")
                    return enum_construct(e, &recv_name, &expr.name, dummy, false)
                }
            }
            let recv = emit_expr(e, expr_arg_ref(expr, 0, "emit_field_recv"))
            let mut recv_expr = recv.expr
            let mut recv_type = recv.typ
            if type_is_ref(e, &recv_type) {
                let base_t = type_ref_base(e, &recv_type)
                let op = load_op_for_type(e, &base_t)
                let q = qbe_type(e, &base_t)
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =" + q + " " + op + " " + recv_expr)
                recv_expr = tn
                recv_type = base_t
            }
            let recv_base = type_strip_ref(e, &recv_type)
            let fname = string_clone(&expr.name)
            let ftyp = struct_field_type(e, &recv_base, &fname)
            if ftyp == "" {
                println("stage2: unknown field", fname)
                exit(1)
            }
            let fname_ptr = string_data_ptr(e, &fname)
            let get_fn = struct_get_fn_for_type(e, &ftyp)
            let q = qbe_type(e, &ftyp)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " call $" + get_fn + "(l " + recv_expr + ", l " + fname_ptr + ")")
            return qbe_value(ftyp, tn)
        }
        EXPR_BINARY => {
            return emit_binary_expr(e, expr)
        }
        EXPR_CALL => {
            let ci = closure_index(e, &expr.name)
            if ci >= 0 {
                if len(&expr.args) > 0 {
                    println("stage2: closure args not supported yet")
                    exit(1)
                }
                emit_block(e, &e.closure_blocks[ci])
                return qbe_value("unit", "0")
            }
            if expr.name == "print" || expr.name == "println" {
                emit_print_call(e, expr)
                return qbe_value("unit", "0")
            }
            if expr.name == "len" {
                if len(&expr.args) < 1 { return qbe_value("i64", "0") }
                let mut v = emit_expr(e, expr_arg_ref(expr, 0, "emit_len"))
                if type_is_ref(e, &v.typ) {
                    let base = type_ref_base(e, &v.typ)
                    if type_is_string(e, &v.typ) || type_is_array(e, &base) {
                        v = emit_deref_value(e, v)
                    }
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                let fn_name = if type_is_string(e, &v.typ) { "dast_string_len" } else { "dast_array_len" }
                emit_line(e, "  " + tn + " =l call $" + fn_name + "(l " + v.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "string_clone" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let mut v = emit_expr(e, expr_arg_ref(expr, 0, "emit_string_clone"))
                if type_is_string(e, &v.typ) && type_is_ref(e, &v.typ) {
                    v = emit_deref_value(e, v)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_string_clone(l " + v.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "char_at" {
                if len(&expr.args) < 2 { return qbe_value("i64", "0") }
                let mut s = emit_expr(e, expr_arg_ref(expr, 0, "emit_char_at_s"))
                if type_is_string(e, &s.typ) && type_is_ref(e, &s.typ) {
                    s = emit_deref_value(e, s)
                }
                let idx = emit_expr(e, expr_arg_ref(expr, 1, "emit_char_at_idx"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_char_at(l " + s.expr + ", l " + idx.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "substr" {
                if len(&expr.args) < 3 { return qbe_value("String", "0") }
                let mut s = emit_expr(e, expr_arg_ref(expr, 0, "emit_substr_s"))
                if type_is_string(e, &s.typ) && type_is_ref(e, &s.typ) {
                    s = emit_deref_value(e, s)
                }
                let start = emit_expr(e, expr_arg_ref(expr, 1, "emit_substr_start"))
                let count = emit_expr(e, expr_arg_ref(expr, 2, "emit_substr_count"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_substr(l " + s.expr + ", l " + start.expr + ", l " + count.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "read_file" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_file"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_file(l " + path.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "read_dir" {
                if len(&expr.args) < 1 { return qbe_value("[String]", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_dir"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_dir(l " + path.expr + ")")
                return qbe_value("[String]", tn)
            }
            if expr.name == "write_file" {
                if len(&expr.args) < 2 { return qbe_value("unit", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_write_file_path"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let mut data = emit_expr(e, expr_arg_ref(expr, 1, "emit_write_file_data"))
                if type_is_string(e, &data.typ) && type_is_ref(e, &data.typ) {
                    data = emit_deref_value(e, data)
                }
                emit_line(e, "  call $dast_write_file(l " + path.expr + ", l " + data.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "mkdir" {
                if len(&expr.args) < 1 { return qbe_value("unit", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_mkdir"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                emit_line(e, "  call $dast_mkdir(l " + path.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "exec" {
                if len(&expr.args) < 2 { return qbe_value("i64", "0") }
                let mut cmd = emit_expr(e, expr_arg_ref(expr, 0, "emit_exec_cmd"))
                if type_is_string(e, &cmd.typ) && type_is_ref(e, &cmd.typ) {
                    cmd = emit_deref_value(e, cmd)
                }
                let args = emit_expr(e, expr_arg_ref(expr, 1, "emit_exec_args"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_exec(l " + cmd.expr + ", l " + args.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "exit" {
                if len(&expr.args) < 1 { return qbe_value("unit", "0") }
                let code = emit_expr(e, expr_arg_ref(expr, 0, "emit_exit"))
                emit_line(e, "  call $dast_exit(l " + code.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "args" {
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_args()")
                return qbe_value("[String]", tn)
            }
            if expr.name == "read_line" {
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_line()")
                return qbe_value("String", tn)
            }
            if expr.name == "read_bytes" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let count = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_bytes"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_bytes(l " + count.expr + ")")
                return qbe_value("String", tn)
            }
            let ec = enum_call_parse(&expr.name)
            if ec.ok && type_is_enum(e, &ec.enum_name) {
                let mut payload = qbe_value("i64", "0")
                let mut has_payload_arg = false
                if len(&expr.args) > 0 {
                    payload = emit_expr(e, expr_arg_ref(expr, 0, "emit_enum_payload"))
                    has_payload_arg = true
                }
                return enum_construct(e, &ec.enum_name, &ec.variant, payload, has_payload_arg)
            }
            let mut call_name = string_clone(&expr.name)
            let mut rt = func_ret_type_for_call(e, &expr.name, &expr.args)
            let di = func_decl_index(e, &expr.name)
            let mut param_types: [String] = []
            if di >= 0 {
                let f = &e.func_decls[di]
                if len(&f.type_params) > 0 {
                    let values = func_type_args_for_call(e, f, &expr.args)
                    let mut ok = true
                    let mut vi = 0
                    while vi < len(&values) {
                        if values[vi] == "" { ok = false }
                        vi = vi + 1
                    }
                    if ok {
                        let params = func_type_param_names(f)
                        call_name = ensure_inst_func(e, f, &values)
                        let rt_sub = type_subst(e, &f.ret_type, &params, &values)
                        rt = type_resolve(e, &rt_sub)
                        param_types = func_param_types_for_call(e, f, &values)
                    } else {
                        let mut empty_vals: [String] = []
                        param_types = func_param_types_for_call(e, f, &empty_vals)
                    }
                } else {
                    let mut empty_vals: [String] = []
                    param_types = func_param_types_for_call(e, f, &empty_vals)
                }
            }
            let callee = "dast_user_" + mangle_name(&call_name)
            let ret_t = type_resolve(e, &rt)
            let ret_q = qbe_type(e, &ret_t)
            let mut args_text = ""
            let mut i = 0
            while i < len(&expr.args) {
                if i > 0 { args_text = args_text + ", " }
                if i < len(&param_types) && param_types[i] != "" && !type_is_ref(e, &param_types[i]) {
                    let arg_expr = expr_arg_ref(expr, i, "emit_call_arg_type")
                    if arg_expr.kind == EXPR_IDENT {
                        let src_t = expr_type(e, arg_expr)
                        if drop_needs_drop_type_env(e, &src_t) {
                            drop_live_remove(e, &arg_expr.name)
                        }
                    }
                }
                let mut v = qbe_value("i64", "0")
                let arg_expr = expr_arg_ref(expr, i, "emit_call_arg_val")
                if i < len(&param_types) && param_types[i] != "" && type_is_ref(e, &param_types[i]) {
                    let arg_t = expr_type(e, arg_expr)
                    if !type_is_ref(e, &arg_t) {
                        v = emit_auto_borrow(e, arg_expr, &param_types[i])
                    } else {
                        v = emit_expr(e, arg_expr)
                    }
                } else {
                    v = emit_expr(e, arg_expr)
                }
                let qt = qbe_type(e, &v.typ)
                args_text = args_text + qt + " " + v.expr
                i = i + 1
            }
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + ret_q + " call $" + callee + "(" + args_text + ")")
            return qbe_value(ret_t, tn)
        }
        _ => {
            println("stage2: unsupported expr kind", expr.kind)
            exit(1)
            return qbe_value("i64", "0")
        }
    }
}

fn print_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "dast_print_bool" }
    if type_is_string(e, t) { return "dast_print_string" }
    if type_is_struct(e, t) { return "dast_print_struct" }
    return "dast_print_i64"
}

fn emit_print_arg(e: &mut Emitter, v: &QbeValue) {
    // Emit any prerequisite lines (for loads).
    let mut i = 0
    while i < len(&v.lines) {
        emit_line(e, string_clone(&v.lines[i]))
        i = i + 1
    }
    let mut arg = QbeValue { typ: string_clone(&v.typ), expr: string_clone(&v.expr), lines: qbe_lines_empty() }
    if type_is_string(e, &arg.typ) && type_is_ref(e, &arg.typ) {
        arg = emit_deref_value(e, arg)
    }
    let fn_name = print_fn_for_type(e, &arg.typ)
    let qt = qbe_type(e, &arg.typ)
    emit_line(e, "  call $" + fn_name + "(" + qt + " " + arg.expr + ")")
}

fn emit_print_call(e: &mut Emitter, call: &Expr) {
    let newline = call.name == "println"
    let mut i = 0
    while i < len(&call.args) {
        if i > 0 {
            emit_line(e, "  call $dast_print_space()")
        }
        let v = emit_expr(e, expr_arg_ref(call, i, "emit_print_arg"))
        emit_print_arg(e, &v)
        i = i + 1
    }
    if newline {
        emit_line(e, "  call $dast_print_newline()")
    }
}

fn emit_store_let(e: &mut Emitter, name: &str, expr: &Expr) {
    let typ = var_type(e, name)
    if expr.kind == EXPR_CLOSURE {
        closure_add(e, name, &expr.block)
        return
    }
    // Moves from non-copy identifiers should transfer drop ownership.
    if expr.kind == EXPR_IDENT {
        let src_t = expr_type(e, expr)
        if drop_needs_drop_type_env(e, &src_t) {
            drop_live_remove(e, &expr.name)
        }
    }
    let mut v = qbe_value("i64", "0")
    if expr.kind == EXPR_STRUCT_LIT {
        let declared = type_resolve(e, &typ)
        let actual = type_resolve(e, &expr.name)
        let db = type_strip_args(e, &declared)
        let ab = type_strip_args(e, &actual)
        if db != "" && db == ab && declared != actual {
            let mut lit = expr_clone(expr)
            lit.name = string_clone(&declared)
            v = emit_expr(e, &lit)
        } else {
            v = emit_expr(e, expr)
        }
    } else {
        v = emit_expr(e, expr)
    }
    drop_live_drop_existing(e, name)
    let op = store_op_for_type(e, &typ)
    emit_line(e, "  " + op + " " + v.expr + ", %" + var_slot(name))
    drop_live_set(e, name, &typ)
}

fn emit_block(e: &mut Emitter, b: &Block) {
    let mut i = 0
    while i < len(&b.stmts) {
        emit_stmt(e, &b.stmts[i])
        i = i + 1
    }
}

fn block_ends_with_terminator(b: &Block) -> bool {
    let n = len(&b.stmts)
    if n == 0 { return false }
    let last = stmt_clone(&b.stmts[n - 1])
    return last.kind == STMT_BREAK || last.kind == STMT_CONTINUE || last.kind == STMT_RETURN
}

fn emit_store_assign(e: &mut Emitter, lhs: &Expr, expr: &Expr) {
    if lhs.kind == EXPR_IDENT {
        if !var_is_mut(e, &lhs.name) {
            println("stage2: cannot assign to immutable value", lhs.name)
            exit(1)
        }
        emit_store_let(e, &lhs.name, expr)
        return
    }
    if lhs.kind == EXPR_FIELD {
        let base_name = expr_lvalue_base(lhs)
        let base_t = var_type(e, &base_name)
        if base_name != "" && !var_is_mut(e, &base_name) && !type_is_mut_ref(e, &base_t) {
            println("stage2: cannot assign to immutable value", base_name)
            exit(1)
        }
        if len(&lhs.args) == 0 {
            println("stage2: field assignment missing receiver")
            exit(1)
        }
        let recv = emit_expr(e, expr_arg_ref(lhs, 0, "assign_field_recv"))
        let mut recv_expr = recv.expr
        let mut recv_base = recv.typ
        if type_is_ref(e, &recv_base) {
            let base_t = type_ref_base(e, &recv_base)
            let op = load_op_for_type(e, &base_t)
            let q = qbe_type(e, &base_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " " + op + " " + recv_expr)
            recv_expr = tn
            recv_base = base_t
        }
        recv_base = type_strip_ref(e, &recv_base)
        let fname = string_clone(&lhs.name)
        let ftyp = struct_field_type(e, &recv_base, &fname)
        if ftyp == "" {
            println("stage2: unknown field", fname)
            exit(1)
        }
        let v = emit_expr(e, expr)
        let casted = cast_to_type(e, v, &ftyp)
        let fname_ptr = string_data_ptr(e, &fname)
        let set_fn = struct_set_fn_for_type(e, &ftyp)
        let q = qbe_type(e, &ftyp)
        emit_line(e, "  call $" + set_fn + "(l " + recv_expr + ", l " + fname_ptr + ", " + q + " " + casted + ")")
        return
    }
    if lhs.kind == EXPR_INDEX {
        let base_name = expr_lvalue_base(lhs)
        let base_t = var_type(e, &base_name)
        if base_name != "" && !var_is_mut(e, &base_name) && !type_is_mut_ref(e, &base_t) {
            println("stage2: cannot assign to immutable value", base_name)
            exit(1)
        }
        if len(&lhs.args) < 2 {
            println("stage2: index assignment missing args")
            exit(1)
        }
        let recv = emit_expr(e, expr_arg_ref(lhs, 0, "assign_index_recv"))
        let idxv = emit_expr(e, expr_arg_ref(lhs, 1, "assign_index_idx"))
        let idx = cast_to_l(e, idxv)
        let elem_t = expr_type(e, lhs)
        let v = emit_expr(e, expr)
        let casted = cast_to_type(e, v, &elem_t)
        emit_line(e, "  call $dast_array_set(l " + recv.expr + ", l " + idx + ", l " + casted + ")")
        return
    }
    if lhs.kind == EXPR_DEREF && len(&lhs.args) > 0 {
        let ptr = emit_expr(e, expr_arg_ref(lhs, 0, "assign_deref_ptr"))
        if !type_is_mut_ref(e, &ptr.typ) {
            println("stage2: assignment through & requires &mut")
            exit(1)
        }
        let target_t = expr_type(e, lhs)
        let v = emit_expr(e, expr)
        let casted = cast_to_type(e, v, &target_t)
        let op = store_op_for_type(e, &target_t)
        emit_line(e, "  " + op + " " + casted + ", " + ptr.expr)
        return
    }
    println("stage2: unsupported assignment target")
    exit(1)
}

fn emit_if(e: &mut Emitter, stmt: &Stmt) {
    let cond_val = emit_expr(e, &stmt.expr)
    let cond_expr = ensure_bool_expr(e, cond_val)
    let then_label = new_label(e, "if_then_")
    let else_label = new_label(e, "if_else_")
    let end_label = new_label(e, "if_end_")
    emit_line(e, "  jnz " + cond_expr + ", @" + string_clone(&then_label) + ", @" + string_clone(&else_label))
    emit_label(e, &then_label)
    emit_block(e, &stmt.block)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &else_label)
    if stmt.has_else { emit_block(e, &stmt.else_block) }
    if !stmt.has_else || !block_ends_with_terminator(&stmt.else_block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &end_label)
}

fn emit_store_value(e: &mut Emitter, name: &str, typ: &str, value_expr: &str) {
    if name == "" { return }
    drop_live_drop_existing(e, name)
    let op = store_op_for_type(e, typ)
    emit_line(e, "  " + op + " " + string_clone(value_expr) + ", %" + var_slot(name))
    drop_live_set(e, name, typ)
}

fn emit_iflet(e: &mut Emitter, stmt: &Stmt) {
    let scrut = emit_expr(e, &stmt.expr)
    let mut enum_t = expr_type(e, &stmt.expr)
    if !type_is_enum(e, &enum_t) && stmt.expr.kind == EXPR_IDENT {
        let hint = enum_var_hint(e, &stmt.expr.name)
        if hint != "" { enum_t = hint }
    }
    if !type_is_enum(e, &enum_t) && enum_t == "" {
        let guess = enum_name_for_variant(e, &stmt.pat_variant)
        if guess != "" { enum_t = guess }
    }
    if !type_is_enum(e, &enum_t) {
        println("stage2: if let requires enum expression")
        exit(1)
    }
    let tag_t = enum_tag_type(e, &enum_t)
    let tagv = enum_tag_from_value(e, &scrut, &enum_t)
    let tag_val = enum_variant_value(e, &enum_t, &stmt.pat_variant)
    let cond_tmp = new_temp(e)
    let cond_tn = temp_name(cond_tmp)
    let cmp = if type_is_bool(e, &tag_t) || type_is_i32(e, &tag_t) { "ceqw" } else { "ceql" }
    emit_line(e, "  " + cond_tn + " =w " + cmp + " " + tagv.expr + ", " + int_to_string(tag_val))
    let then_label = new_label(e, "iflet_then_")
    let else_label = new_label(e, "iflet_else_")
    let end_label = new_label(e, "iflet_end_")
    emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&then_label) + ", @" + string_clone(&else_label))
    emit_label(e, &then_label)
    if stmt.pat_has_binding {
        let payload_t = enum_variant_payload_type(e, &enum_t, &stmt.pat_variant)
        let payload_v = enum_payload_from_value(e, &scrut, &enum_t, &stmt.pat_variant)
        let casted = cast_to_type(e, payload_v, &payload_t)
        let mut bind_t = var_type(e, &stmt.pat_binding)
        if bind_t == "" { bind_t = payload_t }
        emit_store_value(e, &stmt.pat_binding, &bind_t, &casted)
    }
    emit_block(e, &stmt.block)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &else_label)
    if stmt.has_else { emit_block(e, &stmt.else_block) }
    if !stmt.has_else || !block_ends_with_terminator(&stmt.else_block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &end_label)
}

fn emit_match(e: &mut Emitter, stmt: &Stmt) {
    let scrut = emit_expr(e, &stmt.expr)
    let mut scrut_t = expr_type(e, &stmt.expr)
    let mut is_enum = type_is_enum(e, &scrut_t)
    if !is_enum {
        let mut guess = ""
        let mut ai = 0
        while ai < len(&stmt.arms) {
            if stmt.arms[ai].pat_kind == PAT_VARIANT {
                guess = enum_name_for_variant(e, &stmt.arms[ai].variant)
                break
            }
            ai = ai + 1
        }
        if guess != "" { scrut_t = guess; is_enum = true }
    }
    let mut tag_t = string_clone(&scrut.typ)
    let mut tag_expr = string_clone(&scrut.expr)
    if is_enum {
        let tagv = enum_tag_from_value(e, &scrut, &scrut_t)
        tag_t = enum_tag_type(e, &scrut_t)
        tag_expr = string_clone(&tagv.expr)
    }
    let cmp = if type_is_bool(e, &tag_t) || type_is_i32(e, &tag_t) { "ceqw" } else { "ceql" }
    let end_label = new_label(e, "match_end_")
    let mut i = 0
    let mut next_label = new_label(e, "match_next_")
    while i < len(&stmt.arms) {
        let arm = &stmt.arms[i]
        let arm_label = new_label(e, "match_arm_")
        if arm.pat_kind == PAT_WILDCARD || arm.pat_kind == PAT_STRUCT {
            emit_line(e, "  jmp @" + string_clone(&arm_label))
        } else {
            let cond_tmp = new_temp(e)
            let cond_tn = temp_name(cond_tmp)
            if arm.pat_kind == PAT_VARIANT {
                let tag_val = enum_variant_value(e, &scrut_t, &arm.variant)
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(tag_val))
            } else if arm.pat_kind == PAT_INT {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(arm.int_value))
            } else {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(arm.int_value))
            }
            emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&arm_label) + ", @" + string_clone(&next_label))
        }
        emit_label(e, &arm_label)
        if arm.has_binding && arm.pat_kind == PAT_VARIANT && is_enum {
            let payload_t = enum_variant_payload_type(e, &scrut_t, &arm.variant)
            let payload_v = enum_payload_from_value(e, &scrut, &scrut_t, &arm.variant)
            let casted = cast_to_type(e, payload_v, &payload_t)
            let mut bind_t = var_type(e, &arm.binding)
            if bind_t == "" { bind_t = payload_t }
            emit_store_value(e, &arm.binding, &bind_t, &casted)
        } else if arm.pat_kind == PAT_STRUCT {
            let st_name = type_strip_ref(e, &scrut_t)
            if !type_is_struct(e, &st_name) {
                println("stage2: struct pattern requires struct scrutinee")
                exit(1)
            }
            if arm.struct_name != "" && arm.struct_name != st_name {
                println("stage2: struct pattern type mismatch", arm.struct_name, "vs", st_name)
                exit(1)
            }
            let mut fi = 0
            while fi < len(&arm.struct_fields) {
                let f = &arm.struct_fields[fi]
                if f.has_binding {
                    let ftyp = struct_field_type(e, &st_name, &f.name)
                    if ftyp == "" {
                        println("stage2: unknown struct field", f.name)
                        exit(1)
                    }
                    let fname_ptr = string_data_ptr(e, &f.name)
                    let get_fn = struct_get_fn_for_type(e, &ftyp)
                    let q = qbe_type(e, &ftyp)
                    let tmp = new_temp(e)
                    let tn = temp_name(tmp)
                    emit_line(e, "  " + tn + " =" + q + " call $" + get_fn + "(l " + scrut.expr + ", l " + fname_ptr + ")")
                    let mut bind_t = var_type(e, &f.binding)
                    if bind_t == "" { bind_t = ftyp }
                    emit_store_value(e, &f.binding, &bind_t, &tn)
                }
                fi = fi + 1
            }
        }
        emit_block(e, &arm.block)
        if !block_ends_with_terminator(&arm.block) {
            emit_line(e, "  jmp @" + string_clone(&end_label))
        }
        emit_label(e, &next_label)
        next_label = new_label(e, "match_next_")
        i = i + 1
    }
    emit_label(e, &end_label)
}

