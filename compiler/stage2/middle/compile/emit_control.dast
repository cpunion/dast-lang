fn emit_match_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if len(&expr.args) == 0 { return qbe_value("unit", "0") }
    let scrut_expr = expr_clone(expr_arg_ref(expr, 0, "emit_match_scrut"))
    let scrut = emit_expr(e, &scrut_expr)
    let mut scrut_t = expr_type(e, &scrut_expr)
    if scrut_expr.kind == EXPR_IDENT {
        let hint = enum_var_hint(e, &scrut_expr.name)
        if hint != "" { scrut_t = hint }
    }
    let mut is_enum = type_is_enum(e, &scrut_t)
    if !is_enum {
        let mut guess = string_clone("")
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            let a = &expr.match_arms[ai]
            if a.pattern.kind == PAT_VARIANT {
                guess = enum_name_for_variant(e, &a.pattern.variant)
                break
            }
            ai = ai + 1
        }
        if guess != "" { scrut_t = guess; is_enum = true }
    }
    let end_label = new_label(e, "match_end_")
    let ret0 = expr_type(e, expr)
    let ret_t = type_resolve(e, &ret0)
    let mut res_ptr = string_clone("")
    let need_res = !type_is_unit(e, &ret_t)
    if need_res {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l alloc8 8")
        res_ptr = tn
    }
    let mut i = 0
    let mut next_label = new_label(e, "match_next_")
    while i < len(&expr.match_arms) {
        let arm = &expr.match_arms[i]
        emit_pattern_check(e, &arm.pattern, &scrut, &scrut_t, &next_label)
        emit_pattern_bind(e, &arm.pattern, &scrut, &scrut_t)
        if arm.has_guard {
            let gt = expr_type(e, &arm.guard)
            if !type_is_bool(e, &gt) {
                println("stage2: match guard must be bool")
                exit(1)
            }
            let gv = emit_expr(e, &arm.guard)
            let cond = ensure_bool_expr(e, gv)
            let guard_label = new_label(e, "match_guard_")
            emit_line(e, "  jnz " + cond + ", @" + string_clone(&guard_label) + ", @" + string_clone(&next_label))
            emit_label(e, &guard_label)
        }
        let arm_val = emit_block_expr_typed(e, &arm.block, &ret_t)
        if !block_ends_with_terminator(&arm.block) {
            if need_res {
                let casted = cast_to_type(e, arm_val, &ret_t)
                let op = store_op_for_type(e, &ret_t)
                emit_line(e, "  " + op + " " + casted + ", " + res_ptr)
            }
            emit_line(e, "  jmp @" + string_clone(&end_label))
        }
        emit_label(e, &next_label)
        next_label = new_label(e, "match_next_")
        i = i + 1
    }
    emit_label(e, &end_label)
    if !need_res { return qbe_value("unit", "0") }
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, &ret_t)
    let q = qbe_type(e, &ret_t)
    emit_line(e, "  " + tn + " =" + q + " " + op + " " + res_ptr)
    return qbe_value(ret_t, tn)
}

fn emit_while(e: &mut Emitter, stmt: &Stmt) {
    let cond_label = new_label(e, "while_cond_")
    let body_label = new_label(e, "while_body_")
    let end_label = new_label(e, "while_end_")
    emit_line(e, "  jmp @" + string_clone(&cond_label))
    emit_label(e, &cond_label)
    let cond_val = emit_expr(e, &stmt.expr)
    let cond_expr = ensure_bool_expr(e, cond_val)
    emit_line(e, "  jnz " + cond_expr + ", @" + string_clone(&body_label) + ", @" + string_clone(&end_label))
    emit_label(e, &body_label)
    push_break_label(e, string_clone(&end_label))
    push_continue_label(e, string_clone(&cond_label))
    emit_block(e, &stmt.block)
    pop_continue_label(e)
    pop_break_label(e)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&cond_label))
    }
    emit_label(e, &end_label)
}

fn emit_loop(e: &mut Emitter, stmt: &Stmt) {
    let body_label = new_label(e, "loop_body_")
    let end_label = new_label(e, "loop_end_")
    emit_line(e, "  jmp @" + string_clone(&body_label))
    emit_label(e, &body_label)
    push_break_label(e, string_clone(&end_label))
    push_continue_label(e, string_clone(&body_label))
    emit_block(e, &stmt.block)
    pop_continue_label(e)
    pop_break_label(e)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&body_label))
    }
    emit_label(e, &end_label)
}

fn emit_break(e: &mut Emitter) {
    let target = top_break_label(e)
    if target == "" {
        println("stage2: break outside loop")
        exit(1)
    }
    emit_line(e, "  jmp @" + target)
}

fn emit_continue(e: &mut Emitter) {
    let target = top_continue_label(e)
    if target == "" {
        println("stage2: continue outside loop")
        exit(1)
    }
    emit_line(e, "  jmp @" + target)
}

fn emit_return(e: &mut Emitter, stmt: &Stmt) {
    let target_t = string_clone(&e.cur_ret_type)
    let mut rexpr = string_clone("0")
    if stmt.ret_has_value {
        let v = emit_typed_value(e, &stmt.expr, &target_t)
        rexpr = cast_to_type(e, v, &target_t)
        drop_live_remove_returned_expr(e, &stmt.expr)
    }
    drop_live_drop_all(e)
    emit_line(e, "  ret " + rexpr)
}

fn emit_stmt(e: &mut Emitter, stmt: &Stmt) {
    if stmt.kind == STMT_LET {
        emit_store_let(e, &stmt.name, &stmt.expr)
        return
    }
    if stmt.kind == STMT_ASSIGN {
        emit_store_assign(e, &stmt.lhs, &stmt.expr)
        return
    }
    if stmt.kind == STMT_IF {
        emit_if(e, stmt)
        return
    }
    if stmt.kind == STMT_IFLET {
        emit_iflet(e, stmt)
        return
    }
    if stmt.kind == STMT_MATCH {
        emit_match(e, stmt)
        return
    }
    if stmt.kind == STMT_WHILE {
        emit_while(e, stmt)
        return
    }
    if stmt.kind == STMT_LOOP {
        emit_loop(e, stmt)
        return
    }
    if stmt.kind == STMT_BREAK {
        emit_break(e)
        return
    }
    if stmt.kind == STMT_BREAK_VALUE {
        println("stage2: break value only allowed in loop expression desugar")
        exit(1)
    }
    if stmt.kind == STMT_CONTINUE {
        emit_continue(e)
        return
    }
    if stmt.kind == STMT_RETURN {
        emit_return(e, stmt)
        return
    }
    let _ = emit_expr(e, &stmt.expr)
}

fn emit_var_allocs(e: &Emitter) -> String {
    let mut out = string_clone("")
    let mut i = 0
    while i < len(&e.var_names) {
        let name = &e.var_names[i]
        let typ = &e.var_types[i]
        let size = type_size(e, typ)
        let align = type_align(e, typ)
        let alloc = if align > 4 { "alloc8" } else { "alloc4" }
        out = out + "  %" + var_slot(name) + " =l " + alloc + " " + int_to_string(size) + "\n"
        i = i + 1
    }
    return out
}

fn func_param_sig(e: &Emitter, params: & [Param]) -> String {
    let mut out = string_clone("")
    let mut i = 0
    while i < len(params) {
        if i > 0 { out = out + ", " }
        let p = &(*params)[i]
        let mut ptyp = string_clone("i64")
        if p.has_type { ptyp = type_resolve(e, &p.typ) }
        let qt = qbe_type(e, &ptyp)
        out = out + qt + " %p" + int_to_string(i)
        i = i + 1
    }
    return out
}

fn body_ends_with_ret_line(e: &Emitter) -> bool {
    let n = len(&e.body)
    if n == 0 { return false }
    let mut i = n - 1
    let label_prefix = "@"
    let ret_prefix = "  ret "
    while i >= 0 {
        let line = string_clone(&e.body[i])
        if string_has_prefix(&line, label_prefix) {
            i = i - 1
        } else {
            return string_has_prefix(&line, ret_prefix)
        }
    }
    return false
}

fn emit_param_store_lines(e: &Emitter, params: & [Param]) -> String {
    let mut out = string_clone("")
    let mut i = 0
    while i < len(params) {
        let p = &(*params)[i]
        let pname = &p.name
        let mut ptyp = string_clone("i64")
        if p.has_type { ptyp = type_resolve(e, &p.typ) }
        let ptemp = "%p" + int_to_string(i)
        let op = store_op_for_type(e, &ptyp)
        out = out + "  " + op + " " + ptemp + ", %" + var_slot(pname) + "\n"
        i = i + 1
    }
    return out
}

fn effective_ret_type(e: &Emitter, f: &Function) -> String {
    if f.ret_type == "" { return string_clone("unit") }
    return type_resolve(e, &f.ret_type)
}

fn emit_function_text(e: &Emitter, f: &Function) -> String {
    let mut out = string_clone("")
    let export_kw = if f.name == "main" { string_clone("export ") } else { string_clone("") }
    let fname = "dast_user_" + mangle_name(&f.name)
    let sig = func_param_sig(e, &f.params)
    let ret_t = effective_ret_type(e, f)
    let ret_q = qbe_type(e, &ret_t)
    out = out + export_kw + "function " + ret_q + " $" + fname + "(" + sig + ") {\n"
    out = out + "@entry\n"
    out = out + emit_var_allocs(e)
    out = out + emit_param_store_lines(e, &f.params)
    out = out + "\n@L_entry\n"
    let mut i = 0
    while i < len(&e.body) {
        out = out + string_clone(&e.body[i]) + "\n"
        i = i + 1
    }
    if !block_ends_with_terminator(&f.body) && !body_ends_with_ret_line(e) {
        out = out + "  ret 0\n\n}\n"
    } else {
        out = out + "\n}\n"
    }
    return out
}

struct FuncEmitResult {
    text: String,
    lines: i64,
}

fn emit_compiled_function(glob: &mut Emitter, f: &Function) -> FuncEmitResult {
    let mut e = emitter_with_globals(glob)
    let eff_rt = effective_ret_type(&e, f)
    e.cur_ret_type = string_clone(&eff_rt)
    validate_block_args(&f.body, &f.name)
    collect_vars(&mut e, f)
    infer_untyped_vars(&mut e, f, &eff_rt)
    let stmt_count = len(&f.body.stmts)
    if stmt_count > 0 {
        let last = stmt_clone(&f.body.stmts[stmt_count - 1])
        if last.kind == STMT_EXPR && !block_ends_with_terminator(&f.body) && eff_rt != "unit" {
            let mut i = 0
            while i + 1 < stmt_count {
                emit_stmt(&mut e, &f.body.stmts[i])
                i = i + 1
            }
            let ret_stmt = stmt_return(last.expr)
            emit_return(&mut e, &ret_stmt)
        } else {
            emit_block(&mut e, &f.body)
        }
    } else {
        emit_block(&mut e, &f.body)
    }
    let has_term = block_ends_with_terminator(&f.body)
    let has_ret = body_ends_with_ret_line(&e)
    if !has_term && !has_ret {
        drop_live_drop_all(&mut e)
    }
    let text = emit_function_text(&e, f)
    glob.strings = ast_string_list_clone(&e.strings)
    glob.inst_func_names = ast_string_list_clone(&e.inst_func_names)
    glob.inst_funcs = function_list_clone(&e.inst_funcs)
    return FuncEmitResult { text: text, lines: e.emit_lines }
}

struct CompileStats {
    func_count: i64,
    total_lines: i64,
    max_lines: i64,
    max_func: String,
    string_count: i64,
    const_count: i64,
}

fn compile_stats_new() -> CompileStats {
    return CompileStats { func_count: 0, total_lines: 0, max_lines: 0, max_func: "", string_count: 0, const_count: 0 }
}

fn compile_to_qbe(prog: Program, ptr_width: i64) -> String {
    let mut stats = compile_stats_new()
    return compile_to_qbe_with_stats(prog, ptr_width, &mut stats)
}

fn compile_to_qbe_with_stats(prog: Program, ptr_width: i64, stats: &mut CompileStats) -> String {
    let mut glob = emitter_new_with_target(ptr_width)
    collect_type_aliases(&mut glob, &prog)
    collect_structs(&mut glob, &prog)
    collect_enums(&mut glob, &prog)
    collect_funcs(&mut glob, &prog)
    collect_traits(&mut glob, &prog)
    collect_impls(&mut glob, &prog)
    validate_trait_impls(&glob)
    collect_consts(&mut glob, &prog)
    collect_strings(&mut glob, &prog)
    stats.string_count = len(&glob.strings)
    stats.const_count = len(&glob.const_names)

    let mut out_funcs = string_clone("")
    let mut i = 0
    while i < len(&prog.functions) {
        let f = &prog.functions[i]
        if !f.is_macro {
            let res = emit_compiled_function(&mut glob, f)
            out_funcs = out_funcs + res.text + "\n"
            stats.func_count = stats.func_count + 1
            stats.total_lines = stats.total_lines + res.lines
            if res.lines > stats.max_lines {
                stats.max_lines = res.lines
                stats.max_func = f.name
            }
        }
        i = i + 1
    }
    let mut inst_i = 0
    while inst_i < len(&glob.inst_funcs) {
        let res = emit_compiled_function(&mut glob, &glob.inst_funcs[inst_i])
        out_funcs = out_funcs + res.text + "\n"
        stats.func_count = stats.func_count + 1
        stats.total_lines = stats.total_lines + res.lines
        if res.lines > stats.max_lines {
            stats.max_lines = res.lines
            stats.max_func = glob.inst_funcs[inst_i].name
        }
        inst_i = inst_i + 1
    }
    let data = emit_string_data(&glob)
    return data + out_funcs
}

fn c_ret_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return string_clone("int32_t") }
    return string_clone("int64_t")
}

fn main_ret_type(prog: &Program) -> String {
    let mut e = emitter_new()
    collect_type_aliases(&mut e, prog)
    let mut i = 0
    while i < len(&prog.functions) {
        let f = &prog.functions[i]
        if !f.is_macro && f.name == "main" { return effective_ret_type(&e, f) }
        i = i + 1
    }
    return string_clone("unit")
}

fn program_has_main(prog: &Program) -> bool {
    let mut i = 0
    while i < len(&prog.functions) {
        let f = &prog.functions[i]
        if !f.is_macro && f.name == "main" { return true }
        i = i + 1
    }
    return false
}

fn build_entry_c(e: &Emitter, main_ret_t: &str) -> String {
    // Keep it tiny; args() is rarely needed in early tests.
    let mut out = string_clone("")
    out = out + "#include <stdint.h>\n\n"
    out = out + "void dast_set_args(int argc, char **argv);\n"
    let c_rt = c_ret_type(e, main_ret_t)
    out = out + c_rt + " dast_user_main(void);\n\n"
    out = out + "int main(int argc, char **argv) {\n"
    out = out + "    dast_set_args(argc - 1, argv + 1);\n"
    out = out + "    " + c_rt + " r = dast_user_main();\n"
    out = out + "    return (int)r;\n"
    out = out + "}\n"
    return out
}

fn run_exec(cmd: &str, args: [&str]) {
    let code = exec(cmd, args)
    if code != 0 {
        println("exec failed", code)
        exit(code)
    }
}

fn load_prelude_dir(dir: String) -> String {
    let names0 = read_dir(string_clone(&dir))
    let names = string_list_sorted(&names0)
    let mut out = string_clone("")
    let mut i = 0
    while i < len(&names) {
        let name = names[i]
        let suffix = ".dast"
        if str_has_suffix(&name, suffix) {
            let path = string_clone(&dir) + "/" + name
            let text = read_file(path)
            out = out + text + "\n"
        }
        i = i + 1
    }
    return out
}

struct ImportLoad {
    ok: bool,
    imports: String,
    source: String,
    err: String,
}

fn compile_native_single(src_path: String, out_bin: String, ptr_width: i64) {
    let prelude_dir = "compiler/stage2/stdlib/prelude"
    let prelude = load_prelude_dir(string_clone(prelude_dir))
    let prelude_prog = parse_program_loose_or_exit(&prelude)
    let load = load_program_from_path(&src_path, false)
    if !load.ok {
        println("stage2:", load.err)
        exit(1)
        return
    }
    let mut prog = program_clone(&prelude_prog)
    program_merge(&mut prog, &load.prog)
    prog = macro_expand_program(prog)
    if !program_has_main(&prog) {
        println("parse error: missing fn main")
        exit(1)
        return
    }
    let mut alias_e = emitter_new_with_target(ptr_width)
    collect_type_aliases(&mut alias_e, &prog)
    let main_rt = main_ret_type(&prog)
    let qbe = compile_to_qbe(prog, ptr_width)

    // Use a deterministic target directory.
    let target_dir = "compiler/stage2/target/min"
    mkdir(target_dir)
    let qbe_path = target_dir + "/main.qbe"
    let asm_path = target_dir + "/main.s"
    let entry_path = target_dir + "/entry.c"
    let runtime_path = "compiler/stage0/runtime/c_runtime.c"

    write_file(qbe_path, qbe)
    write_file(entry_path, build_entry_c(&alias_e, &main_rt))

    run_exec("qbe", ["-o", &asm_path, &qbe_path])
    run_exec("cc", [
        "-O2",
        "-std=c99",
        &asm_path,
        runtime_path,
        &entry_path,
        "-o",
        &out_bin
    ])
}

fn compile_native_single_stats(src_path: String, out_bin: String, ptr_width: i64) {
    let prelude_dir = "compiler/stage2/stdlib/prelude"
    let prelude = load_prelude_dir(string_clone(prelude_dir))
    let prelude_prog = parse_program_loose_or_exit(&prelude)
    let load = load_program_from_path(&src_path, false)
    if !load.ok {
        println("stage2:", load.err)
        exit(1)
        return
    }
    let mut prog = program_clone(&prelude_prog)
    program_merge(&mut prog, &load.prog)
    prog = macro_expand_program(prog)
    if !program_has_main(&prog) {
        println("parse error: missing fn main")
        exit(1)
        return
    }
    let mut alias_e = emitter_new_with_target(ptr_width)
    collect_type_aliases(&mut alias_e, &prog)
    let main_rt = main_ret_type(&prog)
    let mut stats = compile_stats_new()
    let qbe = compile_to_qbe_with_stats(prog, ptr_width, &mut stats)

    println("stats", "funcs", stats.func_count, "lines", stats.total_lines, "strings", stats.string_count, "consts", stats.const_count)
    if stats.max_func != "" {
        println("stats-max-func", stats.max_func, stats.max_lines)
    }

    let target_dir = "compiler/stage2/target/min"
    mkdir(target_dir)
    let qbe_path = target_dir + "/main.qbe"
    let asm_path = target_dir + "/main.s"
    let entry_path = target_dir + "/entry.c"
    let runtime_path = "compiler/stage0/runtime/c_runtime.c"

    write_file(qbe_path, qbe)
    write_file(entry_path, build_entry_c(&alias_e, &main_rt))

    run_exec("qbe", ["-o", &asm_path, &qbe_path])
    run_exec("cc", [
        "-O2",
        "-std=c99",
        &asm_path,
        runtime_path,
        &entry_path,
        "-o",
        &out_bin
    ])
}

fn compile_and_run_single(src_path: String, run_args: [String], ptr_width: i64) {
    let out_bin = "compiler/stage2/target/min/main"
    compile_native_single(src_path, string_clone(out_bin), ptr_width)
    let mut refs: [&str] = []
    let mut i = 0
    while i < len(&run_args) {
        push(&mut refs, &run_args[i])
        i = i + 1
    }
    let _ = exec(out_bin, refs)
}
