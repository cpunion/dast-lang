// Unit tests for expr_type / integer type rules.

fn assert_str_eq(got: &str, exp: &str) {
    if got != exp {
        println("assert_str_eq failed", got, exp)
        exit(1)
    }
}

fn int_type_list() -> [String] {
    let mut out: [String] = []
    push(&mut out, "i8")
    push(&mut out, "i16")
    push(&mut out, "i32")
    push(&mut out, "i64")
    push(&mut out, "u8")
    push(&mut out, "u16")
    push(&mut out, "u32")
    push(&mut out, "u64")
    push(&mut out, "isize")
    push(&mut out, "usize")
    push(&mut out, "int")
    push(&mut out, "char")
    return out
}

fn setup_emitter(t1: &str, t2: &str) -> Emitter {
    let mut e = emitter_new()
    let mut names: [String] = []
    let mut types: [String] = []
    let mut muts: [bool] = []
    push(&mut names, "a")
    push(&mut names, "b")
    push(&mut types, string_clone(t1))
    push(&mut types, string_clone(t2))
    push(&mut muts, false)
    push(&mut muts, false)
    e.var_names = names
    e.var_types = types
    e.var_mut = muts
    return e
}

fn bin_expr(op: &str) -> Expr {
    let mut args: [Expr] = []
    push(&mut args, expr_ident("a"))
    push(&mut args, expr_ident("b"))
    return expr_binary(string_clone(op), args)
}

fn test_int_op_result_types() {
    let types = int_type_list()
    let mut i = 0
    while i < len(&types) {
        let mut j = 0
        while j < len(&types) {
            let t1 = &types[i]
            let t2 = &types[j]
            let mut e = setup_emitter(t1, t2)
            let pt = int_peer_type(&e, t1, t2)
            if pt != "" {
                let add = bin_expr("+")
                let sub = bin_expr("-")
                let mul = bin_expr("*")
                let div = bin_expr("/")
                let rem = bin_expr("%")
                let band = bin_expr("&")
                let bor = bin_expr("|")
                let bxor = bin_expr("^")
                assert_str_eq(&expr_type(&e, &add), &pt)
                assert_str_eq(&expr_type(&e, &sub), &pt)
                assert_str_eq(&expr_type(&e, &mul), &pt)
                assert_str_eq(&expr_type(&e, &div), &pt)
                assert_str_eq(&expr_type(&e, &rem), &pt)
                assert_str_eq(&expr_type(&e, &band), &pt)
                assert_str_eq(&expr_type(&e, &bor), &pt)
                assert_str_eq(&expr_type(&e, &bxor), &pt)
                let lt = bin_expr("<")
                let le = bin_expr("<=")
                let gt = bin_expr(">")
                let ge = bin_expr(">=")
                let eq = bin_expr("==")
                let ne = bin_expr("!=")
                assert_str_eq(&expr_type(&e, &lt), "bool")
                assert_str_eq(&expr_type(&e, &le), "bool")
                assert_str_eq(&expr_type(&e, &gt), "bool")
                assert_str_eq(&expr_type(&e, &ge), "bool")
                assert_str_eq(&expr_type(&e, &eq), "bool")
                assert_str_eq(&expr_type(&e, &ne), "bool")
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn test_shift_rules() {
    let types = int_type_list()
    let mut i = 0
    while i < len(&types) {
        let mut j = 0
        while j < len(&types) {
            let t1 = &types[i]
            let t2 = &types[j]
            let mut e = setup_emitter(t1, t2)
            let lhs = expr_ident("a")
            let rhs = expr_ident("b")
            let st = shift_result_type(&e, &lhs, &rhs)
            if st != "" {
                let shl = bin_expr("<<")
                let shr = bin_expr(">>")
                assert_str_eq(&expr_type(&e, &shl), &st)
                assert_str_eq(&expr_type(&e, &shr), &st)
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn test_literal_coercion() {
    let mut e = setup_emitter("u8", "u8")
    let mut args: [Expr] = []
    push(&mut args, expr_int(255))
    push(&mut args, expr_ident("b"))
    let add = expr_binary(string_clone("+"), args)
    assert_str_eq(&expr_type(&e, &add), "u8")

    let mut args2: [Expr] = []
    push(&mut args2, expr_ident("a"))
    push(&mut args2, expr_int(1))
    let shl = expr_binary(string_clone("<<"), args2)
    assert_str_eq(&expr_type(&e, &shl), "u8")
}
