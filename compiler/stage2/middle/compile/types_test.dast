// Unit tests for expr_type / integer type rules.

fn assert_str_eq(got: String, exp: String) {
    if got != exp {
        println("assert_str_eq failed", got, exp)
        exit(1)
    }
}

fn int_type_list() -> [String] {
    let mut out: [String] = []
    push(&mut out, string_clone("i8"))
    push(&mut out, string_clone("i16"))
    push(&mut out, string_clone("i32"))
    push(&mut out, string_clone("i64"))
    push(&mut out, string_clone("u8"))
    push(&mut out, string_clone("u16"))
    push(&mut out, string_clone("u32"))
    push(&mut out, string_clone("u64"))
    push(&mut out, string_clone("isize"))
    push(&mut out, string_clone("usize"))
    push(&mut out, string_clone("int"))
    return out
}

fn setup_emitter_types(t1: String, t2: String) -> Emitter {
    let mut e = emitter_new()
    let mut names: [String] = []
    let mut types: [String] = []
    let mut muts: [bool] = []
    push(&mut names, string_clone("a"))
    push(&mut names, string_clone("b"))
    push(&mut types, t1)
    push(&mut types, t2)
    push(&mut muts, false)
    push(&mut muts, false)
    e.var_names = names
    e.var_types = types
    e.var_mut = muts
    return e
}

fn bin_expr_types(op: String) -> Expr {
    return expr_binary(op, expr_ident("a"), expr_ident("b"))
}

fn test_int_op_result_types() {
    let types = int_type_list()
    let mut i = 0
    while i < len(&types) {
        let mut j = 0
        while j < len(&types) {
            let t1 = string_clone(&types[i])
            let t2 = string_clone(&types[j])
            let mut e = setup_emitter_types(string_clone(&t1), string_clone(&t2))
            let pt = int_peer_type(&e, &t1, &t2)
            if pt != "" {
                let add = bin_expr_types("+")
                let sub = bin_expr_types("-")
                let mul = bin_expr_types("*")
                let div = bin_expr_types("/")
                let rem = bin_expr_types("%")
                let band = bin_expr_types("&")
                let bor = bin_expr_types("|")
                let bxor = bin_expr_types("^")
                assert_str_eq(expr_type(&e, &add), string_clone(&pt))
                assert_str_eq(expr_type(&e, &sub), string_clone(&pt))
                assert_str_eq(expr_type(&e, &mul), string_clone(&pt))
                assert_str_eq(expr_type(&e, &div), string_clone(&pt))
                assert_str_eq(expr_type(&e, &rem), string_clone(&pt))
                assert_str_eq(expr_type(&e, &band), string_clone(&pt))
                assert_str_eq(expr_type(&e, &bor), string_clone(&pt))
                assert_str_eq(expr_type(&e, &bxor), string_clone(&pt))
                let lt = bin_expr_types("<")
                let le = bin_expr_types("<=")
                let gt = bin_expr_types(">")
                let ge = bin_expr_types(">=")
                let eq = bin_expr_types("==")
                let ne = bin_expr_types("!=")
                assert_str_eq(expr_type(&e, &lt), "bool")
                assert_str_eq(expr_type(&e, &le), "bool")
                assert_str_eq(expr_type(&e, &gt), "bool")
                assert_str_eq(expr_type(&e, &ge), "bool")
                assert_str_eq(expr_type(&e, &eq), "bool")
                assert_str_eq(expr_type(&e, &ne), "bool")
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn test_shift_rules() {
    let types = int_type_list()
    let mut i = 0
    while i < len(&types) {
        let mut j = 0
        while j < len(&types) {
            let t1 = string_clone(&types[i])
            let t2 = string_clone(&types[j])
            let mut e = setup_emitter_types(string_clone(&t1), string_clone(&t2))
            let lhs = expr_ident("a")
            let rhs = expr_ident("b")
            let st = shift_result_type(&e, &lhs, &rhs)
            if st != "" {
                let shl = bin_expr_types("<<")
                let shr = bin_expr_types(">>")
                assert_str_eq(expr_type(&e, &shl), string_clone(&st))
                assert_str_eq(expr_type(&e, &shr), string_clone(&st))
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn test_int_bin_cross_type_reject() {
    let types = int_type_list()
    let mut i = 0
    while i < len(&types) {
        let mut j = 0
        while j < len(&types) {
            let t1 = string_clone(&types[i])
            let t2 = string_clone(&types[j])
            let mut e = setup_emitter_types(string_clone(&t1), string_clone(&t2))
            let r1 = type_resolve(&e, &t1)
            let r2 = type_resolve(&e, &t2)
            if r1 != r2 {
                let lhs = expr_ident("a")
                let rhs = expr_ident("b")
                let res = int_bin_result_type(&e, &lhs, &rhs)
                if res != "" {
                    println("expected int_bin_result_type reject", t1, t2, res)
                    exit(1)
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn test_shift_result_reject_signed_rhs() {
    let signed = [string_clone("i8"), string_clone("i16"), string_clone("i32"), string_clone("i64"), string_clone("isize"), string_clone("int")]
    let all = int_type_list()
    let mut i = 0
    while i < len(&all) {
        let mut j = 0
        while j < len(&signed) {
            let lhs_t = string_clone(&all[i])
            let rhs_t = string_clone(&signed[j])
            let mut e = setup_emitter_types(lhs_t, rhs_t)
            let lhs = expr_ident("a")
            let rhs = expr_ident("b")
            let st = shift_result_type(&e, &lhs, &rhs)
            if st != "" {
                println("expected shift_result_type reject signed rhs", all[i], signed[j], st)
                exit(1)
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn test_literal_coercion() {
    let mut e = setup_emitter_types("u8", "u8")
    let mut args: [Expr] = []
    push(&mut args, expr_int(255))
    push(&mut args, expr_ident("b"))
    let add = expr_binary(string_clone("+"), expr_int(255), expr_ident("b"))
    assert_str_eq(expr_type(&e, &add), "u8")

    let shl = expr_binary(string_clone("<<"), expr_ident("a"), expr_int(1))
    assert_str_eq(expr_type(&e, &shl), "u8")
}

fn test_bool_ops() {
    let mut e = setup_emitter_types("bool", "bool")
    let eq = bin_expr_types("==")
    let ne = bin_expr_types("!=")
    let land = bin_expr_types("&&")
    let lor = bin_expr_types("||")
    assert_str_eq(expr_type(&e, &eq), "bool")
    assert_str_eq(expr_type(&e, &ne), "bool")
    assert_str_eq(expr_type(&e, &land), "bool")
    assert_str_eq(expr_type(&e, &lor), "bool")
}

fn test_binop_try_rejects_mixed_kinds() {
    let mut e1 = setup_emitter_types("i32", "bool")
    let lhs1 = expr_ident("a")
    let rhs1 = expr_ident("b")
    let r1 = binary_op_result_type_try(&e1, "&&", &lhs1, &rhs1)
    if r1 != "" { println("expected && reject i32/bool", r1); exit(1) }
    let r2 = binary_op_result_type_try(&e1, "==", &lhs1, &rhs1)
    if r2 != "" { println("expected == reject i32/bool", r2); exit(1) }

    let mut e2 = setup_emitter_types("String", "i32")
    let lhs2 = expr_ident("a")
    let rhs2 = expr_ident("b")
    let r3 = binary_op_result_type_try(&e2, "+", &lhs2, &rhs2)
    if r3 != "" { println("expected + reject String/i32", r3); exit(1) }

    let mut e3 = setup_emitter_types("char", "char")
    let lhs3 = expr_ident("a")
    let rhs3 = expr_ident("b")
    let r4 = binary_op_result_type_try(&e3, "+", &lhs3, &rhs3)
    if r4 != "" { println("expected + reject char/char", r4); exit(1) }

    let mut e4 = setup_emitter_types("f32", "i32")
    let lhs4 = expr_ident("a")
    let rhs4 = expr_ident("b")
    let r5 = binary_op_result_type_try(&e4, "+", &lhs4, &rhs4)
    if r5 != "" { println("expected + reject f32/i32", r5); exit(1) }
}

fn test_string_ops() {
    let mut e = setup_emitter_types("String", "String")
    let add = bin_expr_types("+")
    let eq = bin_expr_types("==")
    let ne = bin_expr_types("!=")
    assert_str_eq(expr_type(&e, &add), "String")
    assert_str_eq(expr_type(&e, &eq), "bool")
    assert_str_eq(expr_type(&e, &ne), "bool")
}

fn test_string_ref_ops() {
    let mut e1 = setup_emitter_types("&str", "&str")
    let lhs1 = expr_ident("a")
    let rhs1 = expr_ident("b")
    assert_str_eq(binary_op_result_type_try(&e1, "+", &lhs1, &rhs1), "String")
    assert_str_eq(binary_op_result_type_try(&e1, "==", &lhs1, &rhs1), "bool")
    if binary_op_result_type_try(&e1, "<", &lhs1, &rhs1) != "" {
        println("expected < to reject &str")
        exit(1)
    }

    let mut e2 = setup_emitter_types("String", "&str")
    let lhs2 = expr_ident("a")
    let rhs2 = expr_ident("b")
    assert_str_eq(binary_op_result_type_try(&e2, "+", &lhs2, &rhs2), "String")
    assert_str_eq(binary_op_result_type_try(&e2, "==", &lhs2, &rhs2), "bool")
}

fn test_string_literal_type() {
    let mut e = emitter_new()
    let lit = expr_string(string_clone("hi"))
    assert_str_eq(expr_type(&e, &lit), "&str")
    if !type_compatible_expr(&e, "String", &lit) {
        println("expected string literal to coerce to String when required")
        exit(1)
    }
}

fn test_char_ops() {
    let mut e = setup_emitter_types("char", "char")
    let eq = bin_expr_types("==")
    let ne = bin_expr_types("!=")
    let lt = bin_expr_types("<")
    let le = bin_expr_types("<=")
    let gt = bin_expr_types(">")
    let ge = bin_expr_types(">=")
    assert_str_eq(expr_type(&e, &eq), "bool")
    assert_str_eq(expr_type(&e, &ne), "bool")
    assert_str_eq(expr_type(&e, &lt), "bool")
    assert_str_eq(expr_type(&e, &le), "bool")
    assert_str_eq(expr_type(&e, &gt), "bool")
    assert_str_eq(expr_type(&e, &ge), "bool")

    let lhs = expr_ident("a")
    let rhs = expr_ident("b")
    if int_bin_result_type(&e, &lhs, &rhs) != "" {
        println("expected char arithmetic to be rejected")
        exit(1)
    }
}

fn test_float_ops() {
    let mut e1 = setup_emitter_types("f32", "f32")
    let add1 = bin_expr_types("+")
    let sub1 = bin_expr_types("-")
    let mul1 = bin_expr_types("*")
    let div1 = bin_expr_types("/")
    let eq1 = bin_expr_types("==")
    let lt1 = bin_expr_types("<")
    assert_str_eq(expr_type(&e1, &add1), "f32")
    assert_str_eq(expr_type(&e1, &sub1), "f32")
    assert_str_eq(expr_type(&e1, &mul1), "f32")
    assert_str_eq(expr_type(&e1, &div1), "f32")
    assert_str_eq(expr_type(&e1, &eq1), "bool")
    assert_str_eq(expr_type(&e1, &lt1), "bool")

    let mut e2 = setup_emitter_types("f64", "f64")
    let add2 = bin_expr_types("+")
    let eq2 = bin_expr_types("==")
    assert_str_eq(expr_type(&e2, &add2), "f64")
    assert_str_eq(expr_type(&e2, &eq2), "bool")
}

fn test_float_mixed_reject() {
    let mut e = setup_emitter_types("f32", "f64")
    let lhs = expr_ident("a")
    let rhs = expr_ident("b")
    let ft = float_bin_result_type(&e, &lhs, &rhs)
    assert_str_eq(ft, "")
}

fn test_char_literal_type() {
    let mut e = emitter_new()
    let c = expr_char(97)
    let t = expr_type(&e, &c)
    assert_str_eq(t, "char")
}

fn test_len_ref_depth_guard() {
    let mut e = emitter_new()
    let t_arr = string_clone("&[i64]")
    let t_str = string_clone("&str")
    if !type_is_single_ref_to_string_or_array(&e, &t_arr) {
        println("expected len to accept &[i64]")
        exit(1)
    }
    if !type_is_single_ref_to_string_or_array(&e, &t_str) {
        println("expected len to accept &str")
        exit(1)
    }
}

fn test_double_ref_rejected() {
    let mut e = emitter_new()
    let t_double = "&&i64"
    let t_single = "&i64"
    if !type_is_double_ref(&e, t_double) {
        println("expected &&i64 to be double ref")
        exit(1)
    }
    if type_is_double_ref(&e, t_single) {
        println("expected &i64 to not be double ref")
        exit(1)
    }
}

fn test_int_peer_type_zip() {
    let types = int_type_list()
    let mut e = emitter_new()
    let mut i = 0
    while i < len(&types) {
        let mut j = 0
        while j < len(&types) {
            let t1 = string_clone(&types[i])
            let t2 = string_clone(&types[j])
            let r1 = type_resolve(&e, &t1)
            let r2 = type_resolve(&e, &t2)
            let pt = int_peer_type(&e, &t1, &t2)
            if r1 == r2 {
                assert_str_eq(pt, r1)
            } else {
                if pt != "" {
                    println("expected no peer type", t1, t2, pt)
                    exit(1)
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn test_float_peer_type_zip() {
    let mut e = setup_emitter_types("f32", "f64")
    let lhs = expr_ident("a")
    let rhs = expr_ident("b")
    let pt = float_bin_result_type(&e, &lhs, &rhs)
    if pt != "" {
        println("expected no float peer type for f32/f64", pt)
        exit(1)
    }
}

fn assert_i64_eq(got: i64, exp: i64) {
    if got != exp {
        println("assert_i64_eq failed", got, exp)
        exit(1)
    }
}

fn add_struct_sig(e: &mut Emitter, name: &str, fields: [StructFieldSig]) {
    let mut sigs = e.struct_sigs
    let mut params: [String] = []
    push(&mut sigs, StructSig { name: string_clone(name), type_params: params, fields: fields })
    e.struct_sigs = sigs
}

fn add_enum_sig_simple(e: &mut Emitter, name: &str) {
    let mut variants: [EnumVariantSig] = []
    push(&mut variants, EnumVariantSig { name: "A", value: 0, has_payload: false, payload_type: "" })
    push(&mut variants, EnumVariantSig { name: "B", value: 1, has_payload: false, payload_type: "" })
    let mut params: [String] = []
    let mut sigs = e.enum_sigs
    push(&mut sigs, EnumSig { name: string_clone(name), type_params: params, tag_type: "i32", variants: variants })
    e.enum_sigs = sigs
}

fn setup_enum_emitter(t1: String, t2: String) -> Emitter {
    let mut e = emitter_new()
    add_enum_sig_simple(&mut e, "E1")
    add_enum_sig_simple(&mut e, "E2")
    let mut names: [String] = []
    let mut types: [String] = []
    let mut muts: [bool] = []
    push(&mut names, string_clone("a"))
    push(&mut names, string_clone("b"))
    push(&mut types, t1)
    push(&mut types, t2)
    push(&mut muts, false)
    push(&mut muts, false)
    e.var_names = names
    e.var_types = types
    e.var_mut = muts
    return e
}

fn test_enum_eq_ops() {
    let mut e1 = setup_enum_emitter("E1", "E1")
    let lhs = expr_ident("a")
    let rhs = expr_ident("b")
    assert_str_eq(binary_op_result_type_try(&e1, "==", &lhs, &rhs), "bool")
    assert_str_eq(binary_op_result_type_try(&e1, "!=", &lhs, &rhs), "bool")
    if binary_op_result_type_try(&e1, "<", &lhs, &rhs) != "" {
        println("expected enum < to be rejected")
        exit(1)
    }

    let mut e2 = setup_enum_emitter("E1", "E2")
    let r = binary_op_result_type_try(&e2, "==", &lhs, &rhs)
    if r != "" {
        println("expected enum eq reject for mismatched enums", r)
        exit(1)
    }
}

fn test_trait_impl_validation() {
    let mut e = emitter_new()
    let tparams = generic_param_list_empty()
    let mut mparams: [Param] = []
    push(&mut mparams, Param { name: "self", typ: "&Self", has_type: true })
    let tm = TraitMethod { name: "f", type_params: tparams, params: mparams, ret_type: "i32" }
    let mut tmethods: [TraitMethod] = []
    push(&mut tmethods, tm)
    let mut traits: [TraitDecl] = []
    push(&mut traits, TraitDecl { name: "T", type_params: generic_param_list_empty(), methods: tmethods })
    e.traits = traits

    let mut imparams: [Param] = []
    push(&mut imparams, Param { name: "self", typ: "&Foo", has_type: true })
    let im = TraitMethod { name: "f", type_params: generic_param_list_empty(), params: imparams, ret_type: "i32" }
    let mut imethods: [TraitMethod] = []
    push(&mut imethods, im)
    let mut impls: [ImplDecl] = []
    push(&mut impls, ImplDecl { trait_name: "T", for_type: "Foo", type_params: generic_param_list_empty(), methods: imethods })
    e.impls = impls
    if !validate_trait_impls_impl(&e, true) {
        println("expected trait impl validation ok")
        exit(1)
    }

    let mut e2 = emitter_new()
    e2.traits = trait_decl_list_clone(&e.traits)
    let mut bad_impls: [ImplDecl] = []
    push(&mut bad_impls, ImplDecl { trait_name: "T", for_type: "Foo", type_params: generic_param_list_empty(), methods: trait_method_list_empty() })
    e2.impls = bad_impls
    if validate_trait_impls_impl(&e2, true) {
        println("expected trait impl validation failure")
        exit(1)
    }
}

fn test_trait_impl_args_validation() {
    let mut e = emitter_new()
    let mut tparams = generic_param_list_empty()
    push(&mut tparams, GenericParam { name: "Rhs", has_bound: false, bound: "" })
    let mut tm_params: [Param] = []
    push(&mut tm_params, Param { name: "self", typ: "&Self", has_type: true })
    push(&mut tm_params, Param { name: "other", typ: "&Rhs", has_type: true })
    let tm = TraitMethod { name: "eq", type_params: generic_param_list_empty(), params: tm_params, ret_type: "bool" }
    let mut tmethods: [TraitMethod] = []
    push(&mut tmethods, tm)
    let mut traits: [TraitDecl] = []
    push(&mut traits, TraitDecl { name: "PartialEq", type_params: tparams, methods: tmethods })
    e.traits = traits

    let mut ok_params: [Param] = []
    push(&mut ok_params, Param { name: "self", typ: "&Foo", has_type: true })
    push(&mut ok_params, Param { name: "other", typ: "&i32", has_type: true })
    let ok_method = TraitMethod { name: "eq", type_params: generic_param_list_empty(), params: ok_params, ret_type: "bool" }
    let mut ok_methods: [TraitMethod] = []
    push(&mut ok_methods, ok_method)
    let mut ok_impls: [ImplDecl] = []
    push(&mut ok_impls, ImplDecl { trait_name: "PartialEq[i32]", for_type: "Foo", type_params: generic_param_list_empty(), methods: ok_methods })
    e.impls = ok_impls
    if !validate_trait_impls_impl(&e, true) {
        println("expected trait impl with args ok")
        exit(1)
    }

    let mut e2 = emitter_new()
    e2.traits = trait_decl_list_clone(&e.traits)
    let mut bad_params: [Param] = []
    push(&mut bad_params, Param { name: "self", typ: "&Foo", has_type: true })
    push(&mut bad_params, Param { name: "other", typ: "&u32", has_type: true })
    let bad_method = TraitMethod { name: "eq", type_params: generic_param_list_empty(), params: bad_params, ret_type: "bool" }
    let mut bad_methods: [TraitMethod] = []
    push(&mut bad_methods, bad_method)
    let mut bad_impls: [ImplDecl] = []
    push(&mut bad_impls, ImplDecl { trait_name: "PartialEq[i32]", for_type: "Foo", type_params: generic_param_list_empty(), methods: bad_methods })
    e2.impls = bad_impls
    if validate_trait_impls_impl(&e2, true) {
        println("expected trait impl args mismatch to fail")
        exit(1)
    }

    let mut e3 = emitter_new()
    e3.traits = trait_decl_list_clone(&e.traits)
    let mut miss_impls: [ImplDecl] = []
    let mut miss_params: [Param] = []
    push(&mut miss_params, Param { name: "self", typ: "&Foo", has_type: true })
    push(&mut miss_params, Param { name: "other", typ: "&u32", has_type: true })
    let miss_method = TraitMethod { name: "eq", type_params: generic_param_list_empty(), params: miss_params, ret_type: "bool" }
    let mut miss_methods: [TraitMethod] = []
    push(&mut miss_methods, miss_method)
    push(&mut miss_impls, ImplDecl { trait_name: "PartialEq", for_type: "Foo", type_params: generic_param_list_empty(), methods: miss_methods })
    e3.impls = miss_impls
    if validate_trait_impls_impl(&e3, true) {
        println("expected trait impl missing args to fail")
        exit(1)
    }
}

fn test_type_size_align_basic() {
    let mut e64 = emitter_new_with_target(64)
    assert_i64_eq(type_size(&e64, "bool"), 1)
    assert_i64_eq(type_align(&e64, "bool"), 1)
    assert_i64_eq(type_size(&e64, "char"), 4)
    assert_i64_eq(type_align(&e64, "char"), 4)
    assert_i64_eq(type_size(&e64, "i16"), 2)
    assert_i64_eq(type_align(&e64, "i16"), 2)
    assert_i64_eq(type_size(&e64, "i32"), 4)
    assert_i64_eq(type_align(&e64, "i32"), 4)
    assert_i64_eq(type_size(&e64, "i64"), 8)
    assert_i64_eq(type_align(&e64, "i64"), 8)
    assert_i64_eq(type_size(&e64, "isize"), 8)
    assert_i64_eq(type_align(&e64, "isize"), 8)

    let mut e32 = emitter_new_with_target(32)
    assert_i64_eq(type_size(&e32, "isize"), 4)
    assert_i64_eq(type_align(&e32, "isize"), 4)
}

fn test_struct_layout_c() {
    let mut e = emitter_new_with_target(64)
    let mut fields_s: [StructFieldSig] = []
    push(&mut fields_s, StructFieldSig { name: "a", typ: "i8" })
    push(&mut fields_s, StructFieldSig { name: "b", typ: "i32" })
    add_struct_sig(&mut e, "S", fields_s)

    let mut fields_t: [StructFieldSig] = []
    push(&mut fields_t, StructFieldSig { name: "s", typ: "S" })
    push(&mut fields_t, StructFieldSig { name: "c", typ: "u16" })
    add_struct_sig(&mut e, "T", fields_t)

    assert_i64_eq(struct_layout_align(&e, "S"), 4)
    assert_i64_eq(struct_layout_size(&e, "S"), 8)
    assert_i64_eq(struct_layout_align(&e, "T"), 4)
    assert_i64_eq(struct_layout_size(&e, "T"), 12)
}
