fn emit_string_data(e: &Emitter) -> String {
    let mut out = string_clone("")
    let mut i = 0
    while i < len(&e.strings) {
        let data = str_data_label(i)
        let st = str_struct_label(i)
        let rf = str_ref_label(i)
        let s = &e.strings[i]
        let esc = escape_qbe_string(s)
        let slen = str_len(s)
        out = out + "data $" + data + " = { b \"" + esc + "\", b 0 }\n"
        out = out + "data $" + st + " = { l $" + data + ", l " + int_to_string(slen) + ", l " + int_to_string(slen + 1) + " }\n"
        out = out + "data $" + rf + " = { l $" + st + " }\n"
        i = i + 1
    }
    if out != "" { out = out + "\n" }
    return out
}

fn expr_lvalue_base(expr: &Expr) -> String {
    if expr.kind == EXPR_IDENT { return string_clone(&expr.name) }
    if (expr.kind == EXPR_FIELD || expr.kind == EXPR_INDEX) && len(&expr.args) > 0 {
        return expr_lvalue_base(expr_arg_ref(expr, 0, "expr_lvalue_base_recv"))
    }
    return string_clone("")
}

fn expr_is_lvalue(expr: &Expr) -> bool {
    return expr_lvalue_base(expr) != ""
}

fn check_ref_target(e: &Emitter, inner: &Expr, want_mut: bool) {
    if !expr_is_lvalue(inner) {
        println("stage2: reference target must be identifier, field, or index")
        exit(1)
    }
    let base = expr_lvalue_base(inner)
    if base != "" && const_index(e, &base) >= 0 {
        println("stage2: cannot take reference to const", base)
        exit(1)
    }
    if want_mut && base != "" && !var_is_mut(e, &base) {
        println("stage2: cannot take &mut of immutable value", base)
        exit(1)
    }
}

fn emit_const_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if expr.kind == EXPR_INT || expr.kind == EXPR_CHAR {
        return qbe_value("i64", int_to_string(expr.int_value))
    }
    if expr.kind == EXPR_FLOAT {
        return qbe_value("f64", "d_" + string_clone(&expr.float_text))
    }
    if expr.kind == EXPR_BOOL {
        if expr.bool_value { return qbe_value("bool", "1") }
        return qbe_value("bool", "0")
    }
    if expr.kind == EXPR_STRING {
        let id = ensure_string(e, string_clone(&expr.name))
        return qbe_value("&str", "$" + str_ref_label(id))
    }
    if expr.kind == EXPR_IDENT {
        let idx = const_index(e, &expr.name)
        if idx >= 0 {
            if idx >= len(&e.const_exprs) {
                println("stage2: const expr missing", expr.name, "idx", idx, "names", len(&e.const_names), "exprs", len(&e.const_exprs))
                exit(1)
            }
            return emit_const_expr(e, &e.const_exprs[idx])
        }
    }
    println("stage2: unsupported const expression")
    exit(1)
    return qbe_value("i64", "0")
}

fn emit_load_var(e: &mut Emitter, name: &str, typ: &str) -> QbeValue {
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, typ)
    let qt = qbe_type(e, typ)
    emit_line(e, "  " + tn + " =" + qt + " " + op + " %" + var_slot(name))
    return qbe_value(type_resolve(e, typ), tn)
}

fn emit_deref_value(e: &mut Emitter, v: QbeValue) -> QbeValue {
    if !type_is_ref(e, &v.typ) { return v }
    let base = type_ref_base(e, &v.typ)
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, &base)
    let qt = qbe_type(e, &base)
    emit_line(e, "  " + tn + " =" + qt + " " + op + " " + v.expr)
    return qbe_value(base, tn)
}

fn ensure_bool_expr(e: &mut Emitter, v: QbeValue) -> String {
    if type_is_bool(e, &v.typ) { return v.expr }
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let cmp = qbe_cmp_op(e, "!=", string_clone(&v.typ))
    let zero = if type_is_float(e, &v.typ) { float_zero_const(&v.typ) } else { string_clone("0") }
    emit_line(e, "  " + tn + " =w " + cmp + " " + v.expr + ", " + zero)
    return tn
}

fn float_zero_const(t: &str) -> String {
    let rt = string_clone(t)
    if rt == "f32" { return string_clone("s_0") }
    return string_clone("d_0")
}

fn float_literal_const(t: &str, lit: &str) -> String {
    let rt = string_clone(t)
    if rt == "f32" { return string_clone("s_") + string_clone(lit) }
    return string_clone("d_") + string_clone(lit)
}

fn cast_to_type(e: &mut Emitter, v: QbeValue, target_t: &str) -> String {
    let rt = type_resolve(e, target_t)
    if type_is_unit(e, &rt) { return string_clone("0") }
    if type_is_bool(e, &rt) {
        if type_is_bool(e, &v.typ) { return v.expr }
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let cmp = qbe_cmp_op(e, "!=", string_clone(&v.typ))
        emit_line(e, "  " + tn + " =w " + cmp + " " + v.expr + ", 0")
        return tn
    }
    if type_is_float(e, &rt) && type_is_float(e, &v.typ) {
        let src = type_resolve(e, &v.typ)
        if src == rt { return v.expr }
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        if rt == "f64" && src == "f32" {
            emit_line(e, "  " + tn + " =d exts " + v.expr)
            return tn
        }
        if rt == "f32" && src == "f64" {
            emit_line(e, "  " + tn + " =s truncd " + v.expr)
            return tn
        }
        println("stage2: cannot implicitly cast", src, "to", rt)
        exit(1)
    }
    if type_is_int(e, &rt) && type_is_int(e, &v.typ) {
        let src = type_resolve(e, &v.typ)
        let sw = type_int_width(e, &src)
        let dw = type_int_width(e, &rt)
        if sw == 0 || dw == 0 { return v.expr }
        if sw == dw { return v.expr }
        if dw > sw {
            if dw <= 32 { return v.expr }
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            let op = if type_is_unsigned_int(e, &src) { "extuw" } else { "extsw" }
            emit_line(e, "  " + tn + " =l " + op + " " + v.expr)
            return tn
        }
        println("stage2: cannot implicitly cast", src, "to", rt)
        exit(1)
    }
    if type_is_unit(e, &v.typ) { return string_clone("0") }
    if type_is_bool(e, &v.typ) {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l extsw " + v.expr)
        return tn
    }
    return v.expr
}

fn cast_to_l(e: &mut Emitter, v: QbeValue) -> String {
    let t = "i64"
    return cast_to_type(e, v, t)
}

fn emit_typed_value(e: &mut Emitter, expr: &Expr, target_t: &str) -> QbeValue {
    let rt = type_resolve(e, target_t)
    let mut use_expr = expr
    let mut local = expr_clone(expr)
    if expr.kind == EXPR_STRUCT_LIT && type_is_struct(e, &rt) {
        let exp = type_resolve(e, &rt)
        let db = type_strip_args(e, &exp)
        let ab = type_strip_args(e, &expr.name)
        if db != "" && db == ab && exp != expr.name {
            local.name = string_clone(&exp)
            use_expr = &local
        }
    }
    let expr_t = expr_type(e, use_expr)
    let expr_rt = type_resolve(e, &expr_t)
    if use_expr.kind == EXPR_BINARY {
        if type_is_int(e, &rt) && expr_rt == "untyped-int" {
            return emit_binary_expr_typed(e, use_expr, &rt)
        }
        if type_is_float(e, &rt) && (expr_rt == "untyped-float" || expr_rt == "untyped-int") {
            return emit_binary_expr_typed(e, use_expr, &rt)
        }
    }
    if use_expr.kind == EXPR_UNARY && (expr_rt == "untyped-int" || expr_rt == "untyped-float") {
        let op = string_clone(&use_expr.name)
        if op == "-" && (type_is_int(e, &rt) || type_is_float(e, &rt)) {
            let inner = expr_arg_ref(use_expr, 0, "emit_unary_typed_inner")
            let inner_v = emit_typed_value(e, inner, &rt)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            let q = qbe_type(e, &rt)
            let zero = if type_is_float(e, &rt) { float_zero_const(&rt) } else { string_clone("0") }
            emit_line(e, "  " + tn + " =" + q + " sub " + zero + ", " + inner_v.expr)
            return qbe_value(string_clone(&rt), tn)
        }
    }
    if type_is_ref(e, &rt) && !type_is_ref(e, &expr_rt) {
        let base_t = type_ref_base(e, &rt)
        if !type_compatible_expr(e, &base_t, use_expr) {
            let actual = expr_type(e, use_expr)
            println("stage2: type mismatch expected", rt, "got", actual)
            exit(1)
        }
        return emit_auto_borrow(e, use_expr, &rt)
    }
    if expr_is_int_literal(use_expr) && type_is_int(e, &rt) {
        let v = expr_int_literal_value(use_expr)
        if !int_value_fits_type(e, v, &rt) {
            println("stage2: integer literal out of range for", rt)
            exit(1)
        }
        return qbe_value(string_clone(&rt), int_to_string(v))
    }
    if expr_is_float_literal(use_expr) && type_is_float(e, &rt) {
        return qbe_value(string_clone(&rt), float_literal_const(&rt, &use_expr.float_text))
    }
    if expr_is_int_literal(use_expr) && type_is_float(e, &rt) {
        let v = int_to_string(expr_int_literal_value(use_expr))
        return qbe_value(string_clone(&rt), float_literal_const(&rt, &v))
    }
    if use_expr.kind == EXPR_STRING && rt == "String" {
        let id = ensure_string(e, string_clone(&use_expr.name))
        return qbe_value("String", "$" + str_struct_label(id))
    }
    if use_expr.kind == EXPR_ARRAY && type_is_array(e, &rt) {
        if !type_compatible_expr(e, &rt, use_expr) {
            let actual = expr_type(e, use_expr)
            println("stage2: type mismatch expected", rt, "got", actual)
            exit(1)
        }
        let mut v = emit_expr(e, use_expr)
        // Retag empty or literal arrays to the contextual element type.
        v.typ = string_clone(&rt)
        return v
    }
    let v = emit_expr(e, use_expr)
    let at = type_resolve(e, &v.typ)
    if rt == "" {
        println("stage2: internal error: missing target type for expr", expr.kind, expr.name, "got", at)
        exit(1)
    }
    if !type_compatible(e, &rt, &at) {
        println("stage2: type mismatch expected", rt, "got", at)
        exit(1)
    }
    return v
}

fn emit_int_operand(e: &mut Emitter, expr: &Expr, v: QbeValue, int_t: &str) -> String {
    let want = type_resolve(e, int_t)
    if expr_is_int_literal(expr) {
        let val = expr_int_literal_value(expr)
        if !int_value_fits_type(e, val, &want) {
            println("stage2: integer literal out of range for", want)
            exit(1)
        }
        return int_to_string(val)
    }
    let actual = type_resolve(e, &v.typ)
    if actual != want {
        println("stage2: binary op requires matching int types got", actual, "and", want)
        exit(1)
    }
    return v.expr
}

fn emit_float_operand(e: &mut Emitter, expr: &Expr, v: QbeValue, float_t: &str) -> String {
    let want = type_resolve(e, float_t)
    if expr_is_float_literal(expr) { return float_literal_const(&want, &expr.float_text) }
    if expr_is_int_literal(expr) {
        let v = int_to_string(expr_int_literal_value(expr))
        return float_literal_const(&want, &v)
    }
    let actual = type_resolve(e, &v.typ)
    if actual != want {
        println("stage2: binary op requires matching float types got", actual, "and", want)
        exit(1)
    }
    return v.expr
}

fn emit_shift_rhs(e: &mut Emitter, expr: &Expr, v: QbeValue, lhs_t: &str) -> String {
    if expr_is_int_literal(expr) {
        let val = expr_int_literal_value(expr)
        if val < 0 {
            println("stage2: shift amount must be non-negative")
            exit(1)
        }
        return int_to_string(val)
    }
    let rhs_t = type_resolve(e, &v.typ)
    if !type_is_unsigned_int(e, &rhs_t) {
        println("stage2: shift amount must be unsigned int")
        exit(1)
    }
    return cast_to_type(e, v, lhs_t)
}

fn enum_construct(e: &mut Emitter, enum_name: &str, variant: &str, payload: QbeValue, has_payload_arg: bool) -> QbeValue {
    let tag = enum_variant_value(e, enum_name, variant)
    if tag < 0 {
        println("stage2: unknown enum variant", variant)
        exit(1)
    }
    let tag_t = enum_tag_type(e, enum_name)
    let tag_size = type_size(e, &tag_t)
    let mut tag_expr = string_clone("")
    if type_is_int(e, &tag_t) {
        if !int_value_fits_type(e, tag, &tag_t) {
            println("stage2: enum tag out of range for", tag_t)
            exit(1)
        }
        tag_expr = int_to_string(tag)
    } else if type_is_bool(e, &tag_t) {
        if tag != 0 && tag != 1 {
            println("stage2: enum tag out of range for", tag_t)
            exit(1)
        }
        tag_expr = int_to_string(tag)
    } else {
        tag_expr = cast_to_type(e, qbe_value("i64", int_to_string(tag)), &tag_t)
    }
    if enum_has_payload(e, enum_name) {
        let name_ptr = string_data_ptr(e, enum_name)
        let payload_t = enum_variant_payload_type(e, enum_name, variant)
        let payload_off = enum_payload_offset(e, enum_name)
        let size = enum_layout_size(e, enum_name)
        let align = enum_layout_align(e, enum_name)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l call $dast_alloc(l " + name_ptr + ", l " + int_to_string(size) + ", l " + int_to_string(align) + ")")
        emit_mem_store_value(e, &tn, 0, &tag_t, tag_expr)
        if enum_variant_has_payload(e, enum_name, variant) && has_payload_arg {
            let payload_expr = cast_to_type(e, payload, &payload_t)
            emit_mem_store_value(e, &tn, payload_off, &payload_t, payload_expr)
        }
        return qbe_value(string_clone(enum_name), tn)
    }
    return qbe_value(string_clone(enum_name), tag_expr)
}

fn enum_tag_from_value(e: &mut Emitter, v: &QbeValue, enum_t: &str) -> QbeValue {
    let tag_t = enum_tag_type(e, enum_t)
    if type_is_enum(e, enum_t) && enum_has_payload(e, enum_t) {
        return emit_mem_load_value(e, &v.expr, 0, &tag_t)
    }
    if type_is_int(e, &tag_t) || type_is_bool(e, &tag_t) {
        return qbe_value(string_clone(&tag_t), string_clone(&v.expr))
    }
    let casted = cast_to_type(e, qbe_value("i64", v.expr), &tag_t)
    return qbe_value(string_clone(&tag_t), casted)
}

fn enum_payload_from_value(e: &mut Emitter, v: &QbeValue, enum_t: &str, variant: &str) -> QbeValue {
    let payload_t = enum_variant_payload_type(e, enum_t, variant)
    if type_is_enum(e, enum_t) && enum_has_payload(e, enum_t) {
        let payload_off = enum_payload_offset(e, enum_t)
        return emit_mem_load_value(e, &v.expr, payload_off, &payload_t)
    }
    return qbe_value(payload_t, "0")
}

fn pattern_needs_check(pat: &Pattern) -> bool {
    if pat.kind == PAT_BIND || pat.kind == PAT_WILDCARD { return false }
    if pat.kind == PAT_ARRAY { return true }
    if pat.kind == PAT_STRUCT {
        let mut i = 0
        while i < len(&pat.struct_fields) {
            if pattern_needs_check(&pat.struct_fields[i].pattern) { return true }
            i = i + 1
        }
        return false
    }
    if pat.kind == PAT_VARIANT {
        return true
    }
    return true
}

fn pattern_enum_type(e: &Emitter, variant: &str, scrut_t: &str) -> String {
    let mut enum_t = string_clone(scrut_t)
    if !type_is_enum(e, &enum_t) {
        let guess = enum_name_for_variant(e, variant)
        if guess != "" { enum_t = guess }
    }
    return enum_t
}

fn emit_pattern_check(e: &mut Emitter, pat: &Pattern, val: &QbeValue, val_t: &str, next_label: &str) {
    if pat.kind == PAT_WILDCARD || pat.kind == PAT_BIND { return }
    if pat.kind == PAT_INT {
        let mut check_expr = string_clone(&val.expr)
        let mut check_t = type_resolve(e, val_t)
        if type_is_enum(e, &check_t) {
            let tagv = enum_tag_from_value(e, val, &check_t)
            check_expr = string_clone(&tagv.expr)
            check_t = enum_tag_type(e, &check_t)
        }
        if !type_is_int(e, &check_t) && !type_is_bool(e, &check_t) && !type_is_char(e, &check_t) {
            println("stage2: literal pattern requires int, bool, or char")
            exit(1)
        }
        let cmp = qbe_cmp_op(e, "==", string_clone(&check_t))
        let cond_tmp = new_temp(e)
        let cond_tn = temp_name(cond_tmp)
        emit_line(e, "  " + cond_tn + " =w " + cmp + " " + check_expr + ", " + int_to_string(pat.int_value))
        let ok_label = new_label(e, "match_pat_")
        emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&ok_label) + ", @" + string_clone(next_label))
        emit_label(e, &ok_label)
        return
    }
    if pat.kind == PAT_RANGE {
        let is_char = type_is_char(e, val_t)
        if type_is_enum(e, val_t) || (!type_is_int(e, val_t) && !is_char) {
            println("stage2: range pattern requires int scrutinee")
            exit(1)
        }
        let check_expr = string_clone(&val.expr)
        let check_t = type_resolve(e, val_t)
        if pat.range_has_start {
            let start_v = emit_typed_value(e, &pat.range_start, val_t)
            if is_char {
                if !type_is_char(e, &start_v.typ) {
                    println("stage2: range pattern requires char start")
                    exit(1)
                }
            } else if !type_is_int(e, &start_v.typ) {
                println("stage2: range pattern requires int start")
                exit(1)
            }
            let start_expr = start_v.expr
            let cond_tmp = new_temp(e)
            let cond_tn = temp_name(cond_tmp)
            let cmp = qbe_cmp_op(e, "<", string_clone(&check_t))
            emit_line(e, "  " + cond_tn + " =w " + cmp + " " + check_expr + ", " + start_expr)
            let ok_label = new_label(e, "match_range_")
            emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(next_label) + ", @" + string_clone(&ok_label))
            emit_label(e, &ok_label)
        }
        if pat.range_has_end {
            let end_v = emit_typed_value(e, &pat.range_end, val_t)
            if is_char {
                if !type_is_char(e, &end_v.typ) {
                    println("stage2: range pattern requires char end")
                    exit(1)
                }
            } else if !type_is_int(e, &end_v.typ) {
                println("stage2: range pattern requires int end")
                exit(1)
            }
            let end_expr = end_v.expr
            let cond_tmp = new_temp(e)
            let cond_tn = temp_name(cond_tmp)
            let cmp = qbe_cmp_op(e, "<", string_clone(&check_t))
            if pat.range_inclusive {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + end_expr + ", " + check_expr)
                let ok_label = new_label(e, "match_range_")
                emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(next_label) + ", @" + string_clone(&ok_label))
                emit_label(e, &ok_label)
            } else {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + check_expr + ", " + end_expr)
                let ok_label = new_label(e, "match_range_")
                emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&ok_label) + ", @" + string_clone(next_label))
                emit_label(e, &ok_label)
            }
        }
        return
    }
    if pat.kind == PAT_VARIANT {
        let enum_t = pattern_enum_type(e, &pat.variant, val_t)
        if !type_is_enum(e, &enum_t) {
            println("stage2: enum pattern requires enum expression")
            exit(1)
        }
        let tagv = enum_tag_from_value(e, val, &enum_t)
        let tag_t = enum_tag_type(e, &enum_t)
        let tag_val = enum_variant_value(e, &enum_t, &pat.variant)
        if tag_val < 0 {
            println("stage2: unknown enum variant", pat.variant)
            exit(1)
        }
        let cmp = qbe_cmp_op(e, "==", string_clone(&tag_t))
        let cond_tmp = new_temp(e)
        let cond_tn = temp_name(cond_tmp)
        emit_line(e, "  " + cond_tn + " =w " + cmp + " " + tagv.expr + ", " + int_to_string(tag_val))
        let ok_label = new_label(e, "match_pat_")
        emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&ok_label) + ", @" + string_clone(next_label))
        emit_label(e, &ok_label)
        if pat.has_payload && len(&pat.payload) > 0 {
            if !enum_variant_has_payload(e, &enum_t, &pat.variant) {
                println("stage2: enum variant has no payload")
                exit(1)
            }
            let payload_t = enum_variant_payload_type(e, &enum_t, &pat.variant)
            let payload_v = enum_payload_from_value(e, val, &enum_t, &pat.variant)
            let mut payload_checked = payload_v
            if type_is_struct(e, &payload_t) && pattern_needs_check(&pat.payload[0]) {
                let copy_ptr = emit_struct_copy_from_addr(e, &payload_checked.expr, &payload_t)
                payload_checked = qbe_value(string_clone(&payload_t), copy_ptr)
            }
            emit_pattern_check(e, &pat.payload[0], &payload_checked, &payload_t, next_label)
        }
        return
    }
    if pat.kind == PAT_STRUCT {
        let st_name = type_strip_ref(e, val_t)
        if !type_is_struct(e, &st_name) {
            println("stage2: struct pattern requires struct scrutinee")
            exit(1)
        }
        if pat.struct_name != "" && pat.struct_name != st_name {
            println("stage2: struct pattern type mismatch", pat.struct_name, "vs", st_name)
            exit(1)
        }
        let mut fi = 0
        while fi < len(&pat.struct_fields) {
            let f = &pat.struct_fields[fi]
            if !pattern_needs_check(&f.pattern) {
                fi = fi + 1
                continue
            }
            let ftyp = struct_field_type(e, &st_name, &f.name)
            if ftyp == "" {
                println("stage2: unknown struct field", f.name)
                exit(1)
            }
            let off = struct_field_offset(e, &st_name, &f.name)
            let mut field_val = emit_mem_load_value(e, &val.expr, off, &ftyp)
            if type_is_struct(e, &ftyp) && pattern_needs_check(&f.pattern) {
                let copy_ptr = emit_struct_copy_from_addr(e, &field_val.expr, &ftyp)
                field_val = qbe_value(string_clone(&ftyp), copy_ptr)
            }
            emit_pattern_check(e, &f.pattern, &field_val, &ftyp, next_label)
            fi = fi + 1
        }
        return
    }
    if pat.kind == PAT_ARRAY {
        let mut arr_v = qbe_value(string_clone(&val.typ), string_clone(&val.expr))
        let mut arr_t = type_resolve(e, val_t)
        if type_is_ref(e, &arr_t) {
            let base = type_ref_base(e, &arr_t)
            if type_is_array(e, &base) {
                arr_v = emit_deref_value(e, arr_v)
                arr_t = base
            }
        }
        if !type_is_array(e, &arr_t) {
            println("stage2: array pattern requires array scrutinee")
            exit(1)
        }
        let elem_t = type_array_elem(e, &arr_t)
        let len_tmp = new_temp(e)
        let len_tn = temp_name(len_tmp)
        emit_line(e, "  " + len_tn + " =l call $dast_array_len(l " + arr_v.expr + ")")
        let cond_tmp = new_temp(e)
        let cond_tn = temp_name(cond_tmp)
        emit_line(e, "  " + cond_tn + " =w ceql " + len_tn + ", " + int_to_string(len(&pat.payload)))
        let ok_label = new_label(e, "match_arr_")
        emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&ok_label) + ", @" + string_clone(next_label))
        emit_label(e, &ok_label)
        let mut i = 0
        while i < len(&pat.payload) {
            let el = &pat.payload[i]
            if pattern_needs_check(el) {
                let idx = int_to_string(i)
                let elem_val = if type_is_float(e, &elem_t) {
                    let addr_tmp = new_temp(e)
                    let addr_tn = temp_name(addr_tmp)
                    emit_line(e, "  " + addr_tn + " =l call $dast_array_index_addr(l " + arr_v.expr + ", l " + idx + ")")
                    let tmp = new_temp(e)
                    let tn = temp_name(tmp)
                    let op = load_op_for_type(e, &elem_t)
                    let q = qbe_type(e, &elem_t)
                    emit_line(e, "  " + tn + " =" + q + " " + op + " " + addr_tn)
                    qbe_value(string_clone(&elem_t), tn)
                } else {
                    let get_fn = array_get_fn_for_type(e, &elem_t)
                    let tmp = new_temp(e)
                    let tn = temp_name(tmp)
                    emit_line(e, "  " + tn + " =l call $" + get_fn + "(l " + arr_v.expr + ", l " + idx + ")")
                    qbe_value(string_clone(&elem_t), tn)
                }
                emit_pattern_check(e, el, &elem_val, &elem_t, next_label)
            }
            i = i + 1
        }
        return
    }
}

fn emit_pattern_bind(e: &mut Emitter, pat: &Pattern, val: &QbeValue, val_t: &str) {
    if pat.kind == PAT_BIND {
        if pat.name == "_" { return }
        let mut bind_t = var_type(e, &pat.name)
        if bind_t == "" { bind_t = string_clone(val_t) }
        if type_is_struct(e, &bind_t) {
            let copy_ptr = emit_struct_copy_from_addr(e, &val.expr, &bind_t)
            emit_store_value(e, &pat.name, &bind_t, &copy_ptr)
            return
        }
        let casted = cast_to_type(e, qbe_value(string_clone(&val.typ), string_clone(&val.expr)), &bind_t)
        emit_store_value(e, &pat.name, &bind_t, &casted)
        return
    }
    if pat.kind == PAT_VARIANT {
        if !pat.has_payload || len(&pat.payload) == 0 { return }
        let enum_t = pattern_enum_type(e, &pat.variant, val_t)
        if !type_is_enum(e, &enum_t) {
            println("stage2: enum pattern requires enum expression")
            exit(1)
        }
        if !enum_variant_has_payload(e, &enum_t, &pat.variant) {
            println("stage2: enum variant has no payload")
            exit(1)
        }
        let payload_t = enum_variant_payload_type(e, &enum_t, &pat.variant)
        let payload_v = enum_payload_from_value(e, val, &enum_t, &pat.variant)
        let mut payload_bind = payload_v
        if type_is_struct(e, &payload_t) && pat.payload[0].kind != PAT_WILDCARD {
            let copy_ptr = emit_struct_copy_from_addr(e, &payload_bind.expr, &payload_t)
            payload_bind = qbe_value(string_clone(&payload_t), copy_ptr)
        }
        emit_pattern_bind(e, &pat.payload[0], &payload_bind, &payload_t)
        return
    }
    if pat.kind == PAT_STRUCT {
        let st_name = type_strip_ref(e, val_t)
        if !type_is_struct(e, &st_name) {
            println("stage2: struct pattern requires struct scrutinee")
            exit(1)
        }
        if pat.struct_name != "" && pat.struct_name != st_name {
            println("stage2: struct pattern type mismatch", pat.struct_name, "vs", st_name)
            exit(1)
        }
        let mut fi = 0
        while fi < len(&pat.struct_fields) {
            let f = &pat.struct_fields[fi]
            let ftyp = struct_field_type(e, &st_name, &f.name)
            if ftyp == "" {
                println("stage2: unknown struct field", f.name)
                exit(1)
            }
            let off = struct_field_offset(e, &st_name, &f.name)
            let mut field_val = emit_mem_load_value(e, &val.expr, off, &ftyp)
            if type_is_struct(e, &ftyp) && f.pattern.kind == PAT_STRUCT {
                let copy_ptr = emit_struct_copy_from_addr(e, &field_val.expr, &ftyp)
                field_val = qbe_value(string_clone(&ftyp), copy_ptr)
            }
            emit_pattern_bind(e, &f.pattern, &field_val, &ftyp)
            fi = fi + 1
        }
        return
    }
    if pat.kind == PAT_ARRAY {
        let mut arr_v = qbe_value(string_clone(&val.typ), string_clone(&val.expr))
        let mut arr_t = type_resolve(e, val_t)
        if type_is_ref(e, &arr_t) {
            let base = type_ref_base(e, &arr_t)
            if type_is_array(e, &base) {
                arr_v = emit_deref_value(e, arr_v)
                arr_t = base
            }
        }
        if !type_is_array(e, &arr_t) {
            println("stage2: array pattern requires array scrutinee")
            exit(1)
        }
        let elem_t = type_array_elem(e, &arr_t)
        let mut i = 0
        while i < len(&pat.payload) {
            let idx = int_to_string(i)
            let elem_val = if type_is_float(e, &elem_t) {
                let addr_tmp = new_temp(e)
                let addr_tn = temp_name(addr_tmp)
                emit_line(e, "  " + addr_tn + " =l call $dast_array_index_addr(l " + arr_v.expr + ", l " + idx + ")")
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                let op = load_op_for_type(e, &elem_t)
                let q = qbe_type(e, &elem_t)
                emit_line(e, "  " + tn + " =" + q + " " + op + " " + addr_tn)
                qbe_value(string_clone(&elem_t), tn)
            } else {
                let get_fn = array_get_fn_for_type(e, &elem_t)
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $" + get_fn + "(l " + arr_v.expr + ", l " + idx + ")")
                qbe_value(string_clone(&elem_t), tn)
            }
            emit_pattern_bind(e, &pat.payload[i], &elem_val, &elem_t)
            i = i + 1
        }
        return
    }
}

fn emit_mem_field_addr(e: &mut Emitter, base_expr: &str, off: i64, size: i64) -> String {
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    emit_line(e, "  " + tn + " =l add " + string_clone(base_expr) + ", " + int_to_string(off))
    return tn
}

fn emit_mem_load_value(e: &mut Emitter, base_expr: &str, off: i64, typ: &str) -> QbeValue {
    let rt = type_resolve(e, typ)
    if rt == "unit" {
        return qbe_value("unit", "0")
    }
    let size = type_layout_size(e, typ)
    let addr = emit_mem_field_addr(e, base_expr, off, size)
    if type_is_struct(e, &rt) {
        return qbe_value(string_clone(&rt), addr)
    }
    let op = load_op_for_type(e, &rt)
    let q = qbe_type(e, &rt)
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    emit_line(e, "  " + tn + " =" + q + " " + op + " " + addr)
    return qbe_value(string_clone(&rt), tn)
}

fn emit_mem_store_value(e: &mut Emitter, base_expr: &str, off: i64, typ: &str, value_expr: String) {
    let rt = type_resolve(e, typ)
    if rt == "unit" { return }
    let size = type_layout_size(e, &rt)
    if type_is_struct(e, &rt) {
        emit_line(e, "  call $dast_mem_copy_field(l " + string_clone(base_expr) + ", l " + int_to_string(off) + ", l " + value_expr + ", l " + int_to_string(size) + ")")
        return
    }
    let addr = emit_mem_field_addr(e, base_expr, off, size)
    let op = store_op_for_type(e, &rt)
    emit_line(e, "  " + op + " " + value_expr + ", " + addr)
}

fn emit_struct_copy_from_addr(e: &mut Emitter, addr: &str, typ: &str) -> String {
    let st_name = type_strip_ref(e, typ)
    let size = struct_layout_size(e, &st_name)
    let align = struct_layout_align(e, &st_name)
    let name_ptr = string_data_ptr(e, &st_name)
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    emit_line(e, "  " + tn + " =l call $dast_alloc(l " + name_ptr + ", l " + int_to_string(size) + ", l " + int_to_string(align) + ")")
    emit_line(e, "  call $dast_mem_copy_field(l " + tn + ", l 0, l " + string_clone(addr) + ", l " + int_to_string(size) + ")")
    return tn
}

fn emit_mem_load_value_owned(e: &mut Emitter, base_expr: &str, off: i64, typ: &str) -> QbeValue {
    if !type_is_struct(e, typ) {
        return emit_mem_load_value(e, base_expr, off, typ)
    }
    let size = type_layout_size(e, typ)
    let addr = emit_mem_field_addr(e, base_expr, off, size)
    let copy_ptr = emit_struct_copy_from_addr(e, &addr, typ)
    return qbe_value(string_clone(typ), copy_ptr)
}

fn struct_load_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_enum(e, t) && !enum_has_payload(e, t) {
        let tag_t = enum_tag_type(e, t)
        return struct_load_fn_for_type(e, &tag_t)
    }
    if type_is_signed_int(e, t) { return string_clone("dast_mem_load_s") }
    return string_clone("dast_mem_load_u")
}

fn array_get_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_signed_int(e, t) { return string_clone("dast_array_get_s") }
    return string_clone("dast_array_get_u")
}

fn emit_binary_expr_typed(e: &mut Emitter, expr: &Expr, target_t: &str) -> QbeValue {
    if len(&expr.args) < 2 { return qbe_value(string_clone(target_t), "0") }
    let op = string_clone(&expr.name)
    let lhs_expr = expr_arg_ref(expr, 0, "emit_binary_typed_lhs_expr")
    let rhs_expr = expr_arg_ref(expr, 1, "emit_binary_typed_rhs_expr")
    let lhs = emit_expr(e, lhs_expr)
    let rhs = emit_expr(e, rhs_expr)
    let rt = type_resolve(e, target_t)
    if type_is_float(e, &rt) {
        if op != "+" && op != "-" && op != "*" && op != "/" {
            println("stage2: binary op", op, "requires int operands got", lhs.typ, "and", rhs.typ)
            exit(1)
        }
        let l = emit_float_operand(e, lhs_expr, lhs, &rt)
        let r = emit_float_operand(e, rhs_expr, rhs, &rt)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let q = qbe_type(e, &rt)
        if op == "+" {
            emit_line(e, "  " + tn + " =" + q + " add " + l + ", " + r)
        } else if op == "-" {
            emit_line(e, "  " + tn + " =" + q + " sub " + l + ", " + r)
        } else if op == "*" {
            emit_line(e, "  " + tn + " =" + q + " mul " + l + ", " + r)
        } else {
            emit_line(e, "  " + tn + " =" + q + " div " + l + ", " + r)
        }
        return qbe_value(string_clone(&rt), tn)
    }
    if !type_is_int(e, &rt) {
        println("stage2: binary op", op, "requires int operands got", lhs.typ, "and", rhs.typ)
        exit(1)
    }
    if op == "<<" || op == ">>" {
        let l = emit_int_operand(e, lhs_expr, lhs, &rt)
        let r = emit_shift_rhs(e, rhs_expr, rhs, &rt)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let q = qbe_type(e, &rt)
        if op == "<<" {
            emit_line(e, "  " + tn + " =" + q + " shl " + l + ", " + r)
        } else {
            let mut shift = string_clone("sar")
            if type_is_unsigned_int(e, &rt) { shift = "shr" }
            emit_line(e, "  " + tn + " =" + q + " " + shift + " " + l + ", " + r)
        }
        return qbe_value(string_clone(&rt), tn)
    }
    if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" && op != "&" && op != "|" && op != "^" {
        println("stage2: binary op", op, "requires int operands got", lhs.typ, "and", rhs.typ)
        exit(1)
    }
    let l = emit_int_operand(e, lhs_expr, lhs, &rt)
    let r = emit_int_operand(e, rhs_expr, rhs, &rt)
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let q = qbe_type(e, &rt)
    if op == "+" {
        emit_line(e, "  " + tn + " =" + q + " add " + l + ", " + r)
        return qbe_value(string_clone(&rt), tn)
    }
    if op == "-" {
        emit_line(e, "  " + tn + " =" + q + " sub " + l + ", " + r)
        return qbe_value(string_clone(&rt), tn)
    }
    if op == "*" {
        emit_line(e, "  " + tn + " =" + q + " mul " + l + ", " + r)
        return qbe_value(string_clone(&rt), tn)
    }
    if op == "/" {
        let mut divop = string_clone("div")
        if type_is_unsigned_int(e, &rt) { divop = "udiv" }
        emit_line(e, "  " + tn + " =" + q + " " + divop + " " + l + ", " + r)
        return qbe_value(string_clone(&rt), tn)
    }
    if op == "%" {
        let mut remop = string_clone("rem")
        if type_is_unsigned_int(e, &rt) { remop = "urem" }
        emit_line(e, "  " + tn + " =" + q + " " + remop + " " + l + ", " + r)
        return qbe_value(string_clone(&rt), tn)
    }
    if op == "&" {
        emit_line(e, "  " + tn + " =" + q + " and " + l + ", " + r)
        return qbe_value(string_clone(&rt), tn)
    }
    if op == "|" {
        emit_line(e, "  " + tn + " =" + q + " or " + l + ", " + r)
        return qbe_value(string_clone(&rt), tn)
    }
    emit_line(e, "  " + tn + " =" + q + " xor " + l + ", " + r)
    return qbe_value(string_clone(&rt), tn)
}

fn emit_binary_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if len(&expr.args) < 2 { return qbe_value("i64", "0") }
    let op = string_clone(&expr.name)
    let lhs_expr = expr_arg_ref(expr, 0, "emit_binary_lhs_expr")
    let rhs_expr = expr_arg_ref(expr, 1, "emit_binary_rhs_expr")
    if op == "&&" || op == "||" {
        let _ = binary_op_result_type(e, &op, lhs_expr, rhs_expr)
        let lhs = emit_expr(e, expr_arg_ref(expr, 0, "emit_binary_lhs"))
        let lhs_cond = ensure_bool_expr(e, lhs)
        let res_tmp = new_temp(e)
        let res_ptr = temp_name(res_tmp)
        emit_line(e, "  " + res_ptr + " =l alloc8 8")
        let rhs_label = new_label(e, "logic_rhs_")
        let short_label = new_label(e, "logic_short_")
        let end_label = new_label(e, "logic_end_")
        if op == "&&" {
            emit_line(e, "  jnz " + lhs_cond + ", @" + string_clone(&rhs_label) + ", @" + string_clone(&short_label))
            emit_label(e, &short_label)
            emit_line(e, "  storew 0, " + res_ptr)
            emit_line(e, "  jmp @" + string_clone(&end_label))
            emit_label(e, &rhs_label)
            let rhs = emit_expr(e, expr_arg_ref(expr, 1, "emit_binary_rhs"))
            let rhs_cond = ensure_bool_expr(e, rhs)
            emit_line(e, "  storew " + rhs_cond + ", " + res_ptr)
        } else {
            emit_line(e, "  jnz " + lhs_cond + ", @" + string_clone(&short_label) + ", @" + string_clone(&rhs_label))
            emit_label(e, &short_label)
            emit_line(e, "  storew 1, " + res_ptr)
            emit_line(e, "  jmp @" + string_clone(&end_label))
            emit_label(e, &rhs_label)
            let rhs = emit_expr(e, expr_arg_ref(expr, 1, "emit_binary_rhs"))
            let rhs_cond = ensure_bool_expr(e, rhs)
            emit_line(e, "  storew " + rhs_cond + ", " + res_ptr)
        }
        emit_label(e, &end_label)
        let out_tmp = new_temp(e)
        let out_tn = temp_name(out_tmp)
        emit_line(e, "  " + out_tn + " =w loadw " + res_ptr)
        return qbe_value("bool", out_tn)
    }
    let _ = binary_op_result_type(e, &op, lhs_expr, rhs_expr)
    let lhs = emit_expr(e, expr_arg_ref(expr, 0, "emit_binary_lhs"))
    let rhs = emit_expr(e, expr_arg_ref(expr, 1, "emit_binary_rhs"))
    let lhs_t = type_resolve(e, &lhs.typ)
    let rhs_t = type_resolve(e, &rhs.typ)
    let mut float_t = float_bin_result_type(e, lhs_expr, rhs_expr)
    if float_t == "untyped-float" { float_t = "f64" }
    if op == "+" {
        if type_is_string(e, &lhs.typ) && type_is_string(e, &rhs.typ) {
            let l = emit_deref_value(e, lhs)
            let r = emit_deref_value(e, rhs)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_string_concat(l " + l.expr + ", l " + r.expr + ")")
            return qbe_value("String", tn)
        }
        if float_t != "" {
            let l = emit_float_operand(e, lhs_expr, lhs, &float_t)
            let r = emit_float_operand(e, rhs_expr, rhs, &float_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            let q = qbe_type(e, &float_t)
            emit_line(e, "  " + tn + " =" + q + " add " + l + ", " + r)
            return qbe_value(float_t, tn)
        }
        let mut int_t = int_bin_result_type(e, lhs_expr, rhs_expr)
        if int_t == "untyped-int" { int_t = "i64" }
        if int_t == "" {
            println("stage2: binary op", op, "requires compatible int operands got", lhs_t, "and", rhs_t)
            exit(1)
        }
        let l = emit_int_operand(e, lhs_expr, lhs, &int_t)
        let r = emit_int_operand(e, rhs_expr, rhs, &int_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let q = qbe_type(e, &int_t)
        emit_line(e, "  " + tn + " =" + q + " add " + l + ", " + r)
        return qbe_value(int_t, tn)
    }
    if op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" {
        if (op == "-" || op == "*" || op == "/") && float_t != "" {
            let l = emit_float_operand(e, lhs_expr, lhs, &float_t)
            let r = emit_float_operand(e, rhs_expr, rhs, &float_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            let q = qbe_type(e, &float_t)
            if op == "-" {
                emit_line(e, "  " + tn + " =" + q + " sub " + l + ", " + r)
            } else if op == "*" {
                emit_line(e, "  " + tn + " =" + q + " mul " + l + ", " + r)
            } else {
                emit_line(e, "  " + tn + " =" + q + " div " + l + ", " + r)
            }
            return qbe_value(float_t, tn)
        }
        let mut int_t = int_bin_result_type(e, lhs_expr, rhs_expr)
        if int_t == "untyped-int" { int_t = "i64" }
        if int_t == "" {
            println("stage2: binary op", op, "requires compatible int operands got", lhs_t, "and", rhs_t)
            exit(1)
        }
        let l = emit_int_operand(e, lhs_expr, lhs, &int_t)
        let r = emit_int_operand(e, rhs_expr, rhs, &int_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let q = qbe_type(e, &int_t)
        if op == "-" {
            emit_line(e, "  " + tn + " =" + q + " sub " + l + ", " + r)
            return qbe_value(int_t, tn)
        }
        if op == "*" {
            emit_line(e, "  " + tn + " =" + q + " mul " + l + ", " + r)
            return qbe_value(int_t, tn)
        }
        if op == "/" {
            let mut divop = string_clone("div")
            if type_is_unsigned_int(e, &int_t) { divop = "udiv" }
            emit_line(e, "  " + tn + " =" + q + " " + divop + " " + l + ", " + r)
            return qbe_value(int_t, tn)
        }
        if op == "%" {
            let mut remop = string_clone("rem")
            if type_is_unsigned_int(e, &int_t) { remop = "urem" }
            emit_line(e, "  " + tn + " =" + q + " " + remop + " " + l + ", " + r)
            return qbe_value(int_t, tn)
        }
        if op == "&" {
            emit_line(e, "  " + tn + " =" + q + " and " + l + ", " + r)
            return qbe_value(int_t, tn)
        }
        if op == "|" {
            emit_line(e, "  " + tn + " =" + q + " or " + l + ", " + r)
            return qbe_value(int_t, tn)
        }
        emit_line(e, "  " + tn + " =" + q + " xor " + l + ", " + r)
        return qbe_value(int_t, tn)
    }
    if op == "<<" || op == ">>" {
        let mut int_t = shift_result_type(e, lhs_expr, rhs_expr)
        if int_t == "untyped-int" { int_t = "i64" }
        if int_t == "" {
            println("stage2: binary op", op, "requires int lhs and unsigned rhs got", lhs_t, "and", rhs_t)
            exit(1)
        }
        let l = emit_int_operand(e, lhs_expr, lhs, &int_t)
        let r = emit_shift_rhs(e, rhs_expr, rhs, &int_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let q = qbe_type(e, &int_t)
        if op == "<<" {
            emit_line(e, "  " + tn + " =" + q + " shl " + l + ", " + r)
        } else {
            let mut shift = string_clone("sar")
            if type_is_unsigned_int(e, &int_t) { shift = "shr" }
            emit_line(e, "  " + tn + " =" + q + " " + shift + " " + l + ", " + r)
        }
        return qbe_value(int_t, tn)
    }
    if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        if type_is_string(e, &lhs.typ) || type_is_string(e, &rhs.typ) {
            let l = emit_deref_value(e, lhs)
            let r = emit_deref_value(e, rhs)
            emit_line(e, "  " + tn + " =w call $dast_string_eq(l " + l.expr + ", l " + r.expr + ")")
        } else if type_is_enum(e, &lhs.typ) || type_is_enum(e, &rhs.typ) {
            let cmp = qbe_cmp_op(e, "==", string_clone(&lhs.typ))
            emit_line(e, "  " + tn + " =w " + cmp + " " + lhs.expr + ", " + rhs.expr)
        } else if type_is_bool(e, &lhs.typ) || type_is_bool(e, &rhs.typ) {
            let cmp = qbe_cmp_op(e, "==", string_clone(&lhs.typ))
            emit_line(e, "  " + tn + " =w " + cmp + " " + lhs.expr + ", " + rhs.expr)
        } else if type_is_char(e, &lhs.typ) || type_is_char(e, &rhs.typ) {
            if !type_is_char(e, &lhs.typ) || !type_is_char(e, &rhs.typ) {
                println("stage2: binary op", op, "requires both char operands got", lhs_t, "and", rhs_t)
                exit(1)
            }
            let mut cmp_op = string_clone(&op)
            if op == "!=" { cmp_op = "==" }
            let cmp = qbe_cmp_op(e, cmp_op, "char")
            emit_line(e, "  " + tn + " =w " + cmp + " " + lhs.expr + ", " + rhs.expr)
        } else if float_t != "" {
            let l = emit_float_operand(e, lhs_expr, lhs, &float_t)
            let r = emit_float_operand(e, rhs_expr, rhs, &float_t)
            let mut cmp_op = string_clone(&op)
            if op == "!=" { cmp_op = "==" }
            let cmp = qbe_cmp_op(e, cmp_op, string_clone(&float_t))
            emit_line(e, "  " + tn + " =w " + cmp + " " + l + ", " + r)
        } else {
            let mut int_t = int_bin_result_type(e, lhs_expr, rhs_expr)
            if int_t == "untyped-int" { int_t = "i64" }
            if int_t == "" {
                println("stage2: binary op", op, "requires compatible int operands got", lhs_t, "and", rhs_t)
                exit(1)
            }
            let l = emit_int_operand(e, lhs_expr, lhs, &int_t)
            let r = emit_int_operand(e, rhs_expr, rhs, &int_t)
            let mut cmp_op = string_clone(&op)
            if op == "!=" { cmp_op = "==" }
            let cmp = qbe_cmp_op(e, cmp_op, string_clone(&int_t))
            emit_line(e, "  " + tn + " =w " + cmp + " " + l + ", " + r)
        }
        if op == "!=" {
            let inv_tmp = new_temp(e)
            let inv_tn = temp_name(inv_tmp)
            emit_line(e, "  " + inv_tn + " =w ceqw " + tn + ", 0")
            return qbe_value("bool", inv_tn)
        }
        return qbe_value("bool", tn)
    }
    println("stage2: unsupported binary op", op)
    exit(1)
    return qbe_value("i64", "0")
}

fn emit_unary_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if len(&expr.args) < 1 { return qbe_value("i64", "0") }
    let inner = emit_expr(e, expr_arg_ref(expr, 0, "emit_unary_inner"))
    let op = string_clone(&expr.name)
    if op == "-" {
        if !type_is_int(e, &inner.typ) && !type_is_float(e, &inner.typ) {
            println("stage2: unary - requires int or float")
            exit(1)
        }
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let q = qbe_type(e, &inner.typ)
        let zero = if type_is_float(e, &inner.typ) { float_zero_const(&inner.typ) } else { string_clone("0") }
        emit_line(e, "  " + tn + " =" + q + " sub " + zero + ", " + inner.expr)
        return qbe_value(string_clone(&inner.typ), tn)
    }
    if op == "!" {
        let cond = ensure_bool_expr(e, inner)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =w ceqw " + cond + ", 0")
        return qbe_value("bool", tn)
    }
    println("stage2: unsupported unary op", op)
    exit(1)
    return qbe_value("i64", "0")
}

fn emit_block_expr(e: &mut Emitter, b: &Block) -> QbeValue {
    let n = len(&b.stmts)
    if n == 0 { return qbe_value("unit", "0") }
    let mut i = 0
    while i + 1 < n {
        emit_stmt(e, &b.stmts[i])
        i = i + 1
    }
    let last = &b.stmts[n - 1]
    if last.kind == STMT_EXPR {
        return emit_expr(e, &last.expr)
    }
    emit_stmt(e, last)
    return qbe_value("unit", "0")
}

fn emit_block_expr_typed(e: &mut Emitter, b: &Block, target_t: &str) -> QbeValue {
    let n = len(&b.stmts)
    if n == 0 { return qbe_value("unit", "0") }
    let mut i = 0
    while i + 1 < n {
        emit_stmt(e, &b.stmts[i])
        i = i + 1
    }
    let last = &b.stmts[n - 1]
    if last.kind == STMT_EXPR {
        return emit_typed_value(e, &last.expr, target_t)
    }
    emit_stmt(e, last)
    return qbe_value("unit", "0")
}
