fn collect_vars_from_block(e: &mut Emitter, b: &Block) {
    collect_vars_from_stmts(e, &b.stmts)
}


fn collect_vars_from_expr(e: &mut Emitter, expr: &Expr) {
    if expr.kind == EXPR_BLOCK {
        collect_vars_from_block(e, &expr.block)
        return
    }
    if expr.kind == EXPR_CLOSURE {
        return
    }
    if expr.kind == EXPR_MATCH {
        if len(&expr.args) > 0 {
            collect_vars_from_expr(e, expr_arg_ref(e, expr, 0, "collect_vars_field_recv"))
        }
        let mut scrut_t = if len(&expr.args) > 0 { expr_type(e, expr_arg_ref(e, expr, 0, "collect_vars_enum_recv")) } else { string_clone("") }
        if len(&expr.args) > 0 {
            let scrut = expr_arg_ref(e, expr, 0, "collect_vars_enum_recv_hint")
            if scrut.kind == EXPR_IDENT {
                let hint = enum_var_hint(e, &scrut.name)
                if hint != "" { scrut_t = hint }
            }
        }
        let mut is_enum = type_is_enum(e, &scrut_t)
        if !is_enum {
            let mut ai = 0
            while ai < len(&expr.match_arms) {
                let a = &expr.match_arms[ai]
                if a.pattern.kind == PAT_VARIANT {
                    let guess = enum_name_for_variant(e, &a.pattern.variant)
                    if guess != "" {
                        scrut_t = guess
                        is_enum = true
                        break
                    }
                }
                ai = ai + 1
            }
        }
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            let a = &expr.match_arms[ai]
            collect_vars_from_pattern(e, &a.pattern, &scrut_t)
            if a.has_guard {
                collect_vars_from_expr(e, &a.guard)
            }
            collect_vars_from_block(e, &a.block)
            ai = ai + 1
        }
        return
    }
    let mut i = 0
    while i < len(&expr.args) {
        collect_vars_from_expr(e, expr_arg_ref(e, expr, i, "collect_vars_arg"))
        i = i + 1
    }
    let mut fi = 0
    while fi < len(&expr.fields) {
        let f = &expr.fields[fi]
        collect_vars_from_expr(e, &f.value)
        fi = fi + 1
    }
}

fn collect_vars_from_pattern(e: &mut Emitter, pat: &Pattern, scrut_t: &str) {
    if pat.kind == PAT_BIND {
        if pat.name != "_" {
            collect_var_add(e, &pat.name, scrut_t, false)
        }
        return
    }
    if pat.kind == PAT_VARIANT {
        let mut enum_t = string_clone(scrut_t)
        if !type_is_enum(e, &enum_t) {
            let guess = enum_name_for_variant(e, &pat.variant)
            if guess != "" { enum_t = guess }
        }
        if !type_is_enum(e, &enum_t) {
            emit_fail(e, "stage2: enum pattern requires enum expression")
            return
        }
        if pat.has_payload && len(&pat.payload) > 0 {
            let payload_t = enum_variant_payload_type(e, &enum_t, &pat.variant)
            collect_vars_from_pattern(e, &pat.payload[0], &payload_t)
        }
        return
    }
    if pat.kind == PAT_STRUCT {
        let st_name = type_strip_ref(e, scrut_t)
        if !type_is_struct(e, &st_name) {
            emit_fail(e, "stage2: struct pattern requires struct scrutinee")
            return
        }
        if pat.struct_name != "" && pat.struct_name != st_name {
            let mut msg = string_clone("stage2: struct pattern type mismatch ")
            msg = msg + pat.struct_name + " vs " + st_name
            emit_fail(e, msg)
            return
        }
        let mut fi = 0
        while fi < len(&pat.struct_fields) {
            let f = &pat.struct_fields[fi]
            let ftyp = struct_field_type(e, &st_name, &f.name)
            if ftyp == "" {
                let mut msg = string_clone("stage2: unknown struct field ")
                msg = msg + f.name
                emit_fail(e, msg)
                return
            }
            collect_vars_from_pattern(e, &f.pattern, &ftyp)
            fi = fi + 1
        }
        return
    }
    if pat.kind == PAT_ARRAY {
        let arr_t = type_strip_ref(e, scrut_t)
        if !type_is_array(e, &arr_t) {
            emit_fail(e, "stage2: array pattern requires array scrutinee")
            return
        }
        let elem_t = type_array_elem(e, &arr_t)
        let mut i = 0
        while i < len(&pat.payload) {
            collect_vars_from_pattern(e, &pat.payload[i], &elem_t)
            i = i + 1
        }
        return
    }
}

fn collect_var_add(e: &mut Emitter, name: &str, typ: &str, mutable: bool) {
    if name == "" { return }
    if var_index(e, name) >= 0 { return }
    let mut names = e.var_names
    let mut types = e.var_types
    let mut muts = e.var_mut
    let mut kinds = e.var_untyped_kind
    let mut values = e.var_untyped_value
    let mut has_values = e.var_untyped_has_value
    push(&mut names, string_clone(name))
    push(&mut types, string_clone(typ))
    push(&mut muts, mutable)
    push(&mut kinds, UNTYPED_NONE)
    push(&mut values, 0)
    push(&mut has_values, false)
    e.var_names = names
    e.var_types = types
    e.var_mut = muts
    e.var_untyped_kind = kinds
    e.var_untyped_value = values
    e.var_untyped_has_value = has_values
}

fn validate_expr_args(e: &mut Emitter, expr: &Expr, ctx: &String) {
    let n = len(&expr.args)
    if expr.kind == EXPR_REF || expr.kind == EXPR_DEREF || expr.kind == EXPR_FIELD || expr.kind == EXPR_MATCH {
        if n < 1 {
            let mut msg = string_clone("stage2: bad expr args len ")
            msg = msg + int_to_string(n)
            msg = msg + " " + expr.name + " " + ctx
            emit_fail(e, msg)
            return
        }
    }
    if expr.kind == EXPR_INDEX || expr.kind == EXPR_BINARY {
        if n < 2 {
            let mut msg = string_clone("stage2: bad expr args len ")
            msg = msg + int_to_string(n)
            msg = msg + " " + expr.name + " " + ctx
            emit_fail(e, msg)
            return
        }
    }
    let mut i = 0
    while i < n {
        validate_expr_args(e, expr_arg_ref(e, expr, i, "validate_expr_arg"), ctx)
        i = i + 1
    }
    let mut fi = 0
    while fi < len(&expr.fields) {
        validate_expr_args(e, &expr.fields[fi].value, ctx)
        fi = fi + 1
    }
    if expr.kind == EXPR_BLOCK || expr.kind == EXPR_CLOSURE {
        validate_block_args(e, &expr.block, ctx)
    }
    if expr.kind == EXPR_MATCH {
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            if expr.match_arms[ai].has_guard {
                validate_expr_args(e, &expr.match_arms[ai].guard, ctx)
            }
            validate_block_args(e, &expr.match_arms[ai].block, ctx)
            ai = ai + 1
        }
    }
}

fn validate_stmt_args(e: &mut Emitter, stmt: &Stmt, ctx: &String) {
    if stmt.kind == STMT_LET || stmt.kind == STMT_EXPR || stmt.kind == STMT_RETURN || stmt.kind == STMT_ASSIGN {
        validate_expr_args(e, &stmt.expr, ctx)
        return
    }
    if stmt.kind == STMT_IF || stmt.kind == STMT_WHILE || stmt.kind == STMT_LOOP {
        validate_expr_args(e, &stmt.expr, ctx)
        validate_block_args(e, &stmt.block, ctx)
        if stmt.has_else { validate_block_args(e, &stmt.else_block, ctx) }
        return
    }
    if stmt.kind == STMT_IFLET || stmt.kind == STMT_MATCH {
        validate_expr_args(e, &stmt.expr, ctx)
        let mut ai = 0
        while ai < len(&stmt.arms) {
            if stmt.arms[ai].has_guard {
                validate_expr_args(e, &stmt.arms[ai].guard, ctx)
            }
            validate_block_args(e, &stmt.arms[ai].block, ctx)
            ai = ai + 1
        }
        if stmt.kind == STMT_IFLET && stmt.has_else { validate_block_args(e, &stmt.else_block, ctx) }
        return
    }
}

fn validate_block_args(e: &mut Emitter, b: &Block, ctx: &String) {
    let mut i = 0
    while i < len(&b.stmts) {
        validate_stmt_args(e, &b.stmts[i], ctx)
        i = i + 1
    }
}

fn collect_vars_from_stmts(e: &mut Emitter, items: & [Stmt]) {
    let mut i = 0
    while i < len(items) {
        let s = &(*items)[i]
        if s.kind == STMT_LET {
            collect_vars_from_expr(e, &s.expr)
            if s.name != "" {
                let expr = &s.expr
                let mut typ = expr_type(e, expr)
                let mut untyped_kind = UNTYPED_NONE
                let mut untyped_value = 0
                let mut untyped_has = false
                if !s.has_type && expr.kind == EXPR_CALL {
                    let ec = enum_call_parse(&expr.name)
                    if ec.ok {
                        let is_en = type_is_enum(e, &ec.enum_name)
                        if is_en { typ = string_clone(&ec.enum_name) }
                        else if typ == "i64" || typ == "" { typ = string_clone(&ec.enum_name) }
                        enum_var_set(e, &s.name, &ec.enum_name)
                    }
                }
                if s.has_type {
                    let declared = type_resolve(e, &s.typ)
                    let actual = type_resolve(e, &typ)
                    if declared != "" && actual != "" && declared != actual {
                        if !type_compatible_expr(e, &declared, expr) {
                            let mut msg = string_clone("stage2: let type mismatch expected ")
                            msg = msg + declared + " got " + actual
                            emit_fail(e, msg)
                        }
                    }
                    typ = declared
                } else if typ == "" && expr.kind == EXPR_CALL {
                    let ec = enum_call_parse(&expr.name)
                    if ec.ok {
                        typ = string_clone(&ec.enum_name)
                    } else {
                        let rt = func_ret_type_for_call(e, &expr.name, &expr.args)
                        if rt != "" { typ = type_resolve(e, &rt) }
                    }
                } else if typ == "untyped-int" {
                    untyped_kind = UNTYPED_INT
                    if expr_is_int_literal(expr) {
                        untyped_value = expr_int_literal_value(expr)
                        untyped_has = true
                    }
                } else if typ == "untyped-float" {
                    untyped_kind = UNTYPED_FLOAT
                }
                if typ == "" {
                    let mut msg = string_clone("stage2: let missing type for ")
                    msg = msg + s.name + " expr " + expr.name
                    emit_fail(e, msg)
                    i = i + 1
                    continue
                }
                collect_var_add(e, &s.name, &typ, s.mutable)
                if untyped_kind != UNTYPED_NONE {
                    var_untyped_set(e, &s.name, untyped_kind, untyped_value, untyped_has)
                }
            }
        }
        if s.kind == STMT_IF {
            collect_vars_from_expr(e, &s.expr)
            collect_vars_from_block(e, &s.block)
            if s.has_else { collect_vars_from_block(e, &s.else_block) }
        } else if s.kind == STMT_IFLET {
            collect_vars_from_expr(e, &s.expr)
            if s.pat_has_binding {
                let mut enum_t = expr_type(e, &s.expr)
                if !type_is_enum(e, &enum_t) && s.expr.kind == EXPR_IDENT {
                    let hint = enum_var_hint(e, &s.expr.name)
                    if hint != "" { enum_t = hint }
                }
                if !type_is_enum(e, &enum_t) && enum_t == "" && s.expr.kind == EXPR_CALL {
                    let ec = enum_call_parse(&s.expr.name)
                    if ec.ok { enum_t = string_clone(&ec.enum_name) }
                }
                if !type_is_enum(e, &enum_t) {
                    emit_fail(e, "stage2: if let requires enum expression")
                } else {
                    let mut bt = string_clone("i64")
                    bt = enum_variant_payload_type(e, &enum_t, &s.pat_variant)
                    collect_var_add(e, &s.pat_binding, bt, false)
                }
            }
            collect_vars_from_block(e, &s.block)
            if s.has_else { collect_vars_from_block(e, &s.else_block) }
        } else if s.kind == STMT_MATCH {
            collect_vars_from_expr(e, &s.expr)
            let mut scrut_t = expr_type(e, &s.expr)
            if s.expr.kind == EXPR_IDENT {
                let hint = enum_var_hint(e, &s.expr.name)
                if hint != "" { scrut_t = hint }
            }
            let mut is_enum = type_is_enum(e, &scrut_t)
            if !is_enum {
                let mut ai = 0
                while ai < len(&s.arms) {
                    let a = &s.arms[ai]
                    if a.pattern.kind == PAT_VARIANT {
                        let guess = enum_name_for_variant(e, &a.pattern.variant)
                        if guess != "" {
                            scrut_t = guess
                            is_enum = true
                            break
                        }
                    }
                    ai = ai + 1
                }
            }
            let mut ai = 0
            while ai < len(&s.arms) {
                let a = &s.arms[ai]
                collect_vars_from_pattern(e, &a.pattern, &scrut_t)
                if a.has_guard {
                    collect_vars_from_expr(e, &a.guard)
                }
                collect_vars_from_block(e, &a.block)
                ai = ai + 1
            }
        } else if s.kind == STMT_WHILE || s.kind == STMT_LOOP {
            collect_vars_from_expr(e, &s.expr)
            collect_vars_from_block(e, &s.block)
        } else if s.kind == STMT_ASSIGN {
            collect_vars_from_expr(e, &s.lhs)
            collect_vars_from_expr(e, &s.expr)
        } else if s.kind == STMT_RETURN && s.ret_has_value {
            collect_vars_from_expr(e, &s.expr)
        } else if s.kind == STMT_BREAK_VALUE {
            collect_vars_from_expr(e, &s.expr)
        } else if s.kind == STMT_EXPR {
            collect_vars_from_expr(e, &s.expr)
        }
        i = i + 1
    }
}

fn constrain_expr_to_type(e: &mut Emitter, expr: &Expr, expected: &String) -> bool {
    let exp = type_resolve(e, expected)
    if exp == "" { return false }
    if expr.kind == EXPR_IDENT {
        if type_is_ref(e, &exp) {
            let base = type_ref_base(e, &exp)
            return var_set_type(e, &expr.name, &base)
        }
        return var_set_type(e, &expr.name, &exp)
    }
    if (expr.kind == EXPR_REF || expr.kind == EXPR_DEREF) && len(&expr.args) > 0 {
        if type_is_ref(e, &exp) {
            let base = type_ref_base(e, &exp)
            return constrain_expr_to_type(e, expr_arg_ref(e, expr, 0, "constrain_ref_inner"), &base)
        }
    }
    if expr.kind == EXPR_BLOCK {
        let n = len(&expr.block.stmts)
        if n > 0 {
            let last = &expr.block.stmts[n - 1]
            if last.kind == STMT_EXPR {
                return constrain_expr_to_type(e, &last.expr, &exp)
            }
        }
    }
    return false
}

fn infer_untyped_call_args(e: &mut Emitter, expr: &Expr) -> bool {
    let mut changed = false
    let ec = enum_call_parse(&expr.name)
    if ec.ok && len(&expr.args) > 0 {
        let payload_t = enum_variant_payload_type(e, &ec.enum_name, &ec.variant)
        changed = constrain_expr_to_type(e, expr_arg_ref(e, expr, 0, "infer_enum_payload"), &payload_t) || changed
        return changed
    }
    let di = func_decl_index(e, &expr.name)
    if di < 0 { return false }
    let f = &e.func_decls[di]
    let mut values: [String] = []
    if len(&f.type_params) > 0 {
        values = func_type_args_for_call(e, f, &expr.args)
    }
    let param_types = func_param_types_for_call(e, f, &values)
    let params = func_type_param_names(f)
    let mut i = 0
    while i < len(&expr.args) && i < len(&param_types) {
        let pt = &param_types[i]
        if pt != "" && list_index(&params, pt) < 0 {
            if constrain_expr_to_type(e, expr_arg_ref(e, expr, i, "infer_call_arg"), pt) {
                changed = true
            }
        }
        i = i + 1
    }
    return changed
}

fn infer_untyped_expr(e: &mut Emitter, expr: &Expr) -> bool {
    let mut changed = false
    if expr.kind == EXPR_CALL {
        if expr.name != "print" && expr.name != "println" {
            if infer_untyped_call_args(e, expr) { changed = true }
        }
    }
    if expr.kind == EXPR_STRUCT_LIT {
        let st_name = string_clone(&expr.name)
        if type_is_struct(e, &st_name) {
            let mut i = 0
            while i < len(&expr.fields) {
                let f = &expr.fields[i]
                let ftyp = struct_field_type(e, &st_name, &f.name)
                if ftyp != "" {
                    if constrain_expr_to_type(e, &f.value, &ftyp) {
                        changed = true
                    }
                }
                i = i + 1
            }
        }
    }
    if expr.kind == EXPR_BINARY && len(&expr.args) >= 2 {
        let lhs = expr_arg_ref(e, expr, 0, "infer_bin_lhs")
        let rhs = expr_arg_ref(e, expr, 1, "infer_bin_rhs")
        let lt = expr_type(e, lhs)
        let rt = expr_type(e, rhs)
        if type_is_int(e, &lt) && type_is_untyped_int(e, &rt) {
            if constrain_expr_to_type(e, rhs, &lt) { changed = true }
        } else if type_is_int(e, &rt) && type_is_untyped_int(e, &lt) {
            if constrain_expr_to_type(e, lhs, &rt) { changed = true }
        }
    }
    let mut i = 0
    while i < len(&expr.args) {
        if infer_untyped_expr(e, expr_arg_ref(e, expr, i, "infer_expr_arg")) {
            changed = true
        }
        i = i + 1
    }
    let mut fi = 0
    while fi < len(&expr.fields) {
        if infer_untyped_expr(e, &expr.fields[fi].value) {
            changed = true
        }
        fi = fi + 1
    }
    if expr.kind == EXPR_BLOCK || expr.kind == EXPR_CLOSURE {
        let unit = string_clone("unit")
        if infer_untyped_block(e, &expr.block, &unit) { changed = true }
    }
    if expr.kind == EXPR_MATCH {
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            if expr.match_arms[ai].has_guard {
                if infer_untyped_expr(e, &expr.match_arms[ai].guard) { changed = true }
            }
            let unit = string_clone("unit")
            if infer_untyped_block(e, &expr.match_arms[ai].block, &unit) { changed = true }
            ai = ai + 1
        }
    }
    return changed
}

fn infer_untyped_expr_expected(e: &mut Emitter, expr: &Expr, expected: &String) -> bool {
    let mut changed = false
    if constrain_expr_to_type(e, expr, expected) { changed = true }
    if expr.kind == EXPR_BINARY && (type_is_int(e, expected) || type_is_float(e, expected)) && len(&expr.args) >= 2 {
        let lhs = expr_arg_ref(e, expr, 0, "infer_bin_lhs_exp")
        let rhs = expr_arg_ref(e, expr, 1, "infer_bin_rhs_exp")
        if constrain_expr_to_type(e, lhs, expected) { changed = true }
        if constrain_expr_to_type(e, rhs, expected) { changed = true }
    }
    if expr.kind == EXPR_UNARY && (type_is_int(e, expected) || type_is_float(e, expected)) && len(&expr.args) >= 1 {
        let inner = expr_arg_ref(e, expr, 0, "infer_unary_inner_exp")
        if constrain_expr_to_type(e, inner, expected) { changed = true }
    }
    if infer_untyped_expr(e, expr) { changed = true }
    return changed
}

fn infer_untyped_stmt(e: &mut Emitter, stmt: &Stmt, ret_t: &String) -> bool {
    let mut changed = false
    if stmt.kind == STMT_LET {
        if stmt.name != "" {
            if stmt.has_type {
                if infer_untyped_expr_expected(e, &stmt.expr, &stmt.typ) { changed = true }
            } else {
                let rhs_t = expr_type(e, &stmt.expr)
                if rhs_t != "" && !type_is_untyped_int(e, &rhs_t) && !type_is_untyped_float(e, &rhs_t) {
                    if var_set_type(e, &stmt.name, &rhs_t) { changed = true }
                }
                if infer_untyped_expr(e, &stmt.expr) { changed = true }
            }
        }
        return changed
    }
    if stmt.kind == STMT_ASSIGN {
        if stmt.lhs.kind == EXPR_IDENT {
            let mut target = var_type(e, &stmt.lhs.name)
            let rhs_t = expr_type(e, &stmt.expr)
            if target != "" && rhs_t != "" {
                if type_is_untyped_int(e, &target) || type_is_untyped_float(e, &target) || type_is_array(e, &target) || type_is_ref(e, &target) {
                    if var_set_type(e, &stmt.lhs.name, &rhs_t) { changed = true }
                    target = var_type(e, &stmt.lhs.name)
                }
            }
            if target != "" {
                if infer_untyped_expr_expected(e, &stmt.expr, &target) { changed = true }
            } else {
                if infer_untyped_expr(e, &stmt.expr) { changed = true }
            }
        } else {
            let target = expr_type(e, &stmt.lhs)
            if target != "" {
                if infer_untyped_expr_expected(e, &stmt.expr, &target) { changed = true }
            } else {
                if infer_untyped_expr(e, &stmt.expr) { changed = true }
            }
        }
        return changed
    }
    if stmt.kind == STMT_RETURN && stmt.ret_has_value {
        if ret_t != "" {
            if infer_untyped_expr_expected(e, &stmt.expr, ret_t) { changed = true }
        } else {
            if infer_untyped_expr(e, &stmt.expr) { changed = true }
        }
        return changed
    }
    if stmt.kind == STMT_IF || stmt.kind == STMT_WHILE || stmt.kind == STMT_LOOP {
        if infer_untyped_expr(e, &stmt.expr) { changed = true }
        if infer_untyped_block(e, &stmt.block, ret_t) { changed = true }
        if stmt.has_else {
            if infer_untyped_block(e, &stmt.else_block, ret_t) { changed = true }
        }
        return changed
    }
    if stmt.kind == STMT_IFLET || stmt.kind == STMT_MATCH {
        if infer_untyped_expr(e, &stmt.expr) { changed = true }
        let mut ai = 0
        while ai < len(&stmt.arms) {
            if stmt.arms[ai].has_guard {
                if infer_untyped_expr(e, &stmt.arms[ai].guard) { changed = true }
            }
            if infer_untyped_block(e, &stmt.arms[ai].block, ret_t) { changed = true }
            ai = ai + 1
        }
        if stmt.kind == STMT_IFLET && stmt.has_else {
            if infer_untyped_block(e, &stmt.else_block, ret_t) { changed = true }
        }
        return changed
    }
    if stmt.kind == STMT_EXPR {
        if infer_untyped_expr(e, &stmt.expr) { changed = true }
        return changed
    }
    if stmt.kind == STMT_BREAK_VALUE {
        if infer_untyped_expr(e, &stmt.expr) { changed = true }
        return changed
    }
    return changed
}

fn infer_untyped_block(e: &mut Emitter, b: &Block, ret_t: &String) -> bool {
    let mut changed = false
    let mut i = 0
    while i < len(&b.stmts) {
        if infer_untyped_stmt(e, &b.stmts[i], ret_t) { changed = true }
        i = i + 1
    }
    return changed
}

fn default_untyped_base(e: &Emitter, t: &str) -> String {
    if t == "untyped-int" { return string_clone("i64") }
    if t == "untyped-float" { return string_clone("f64") }
    if type_is_array(e, t) {
        let elem = type_array_elem(e, t)
        if elem == "untyped-int" { return string_clone("[i64]") }
        if elem == "untyped-float" { return string_clone("[f64]") }
    }
    return string_clone(t)
}

fn finalize_untyped_vars(e: &mut Emitter) {
    ensure_var_untyped_len(e)
    let mut i = 0
    while i < len(&e.var_types) {
        let cur = string_clone(&e.var_types[i])
        if cur == "untyped-int" {
            if e.var_untyped_kind[i] == UNTYPED_INT && e.var_untyped_has_value[i] {
                let v = e.var_untyped_value[i]
                let t = "i64"
                if !int_value_fits_type(e, v, t) {
                    emit_fail(e, "stage2: integer literal out of range for i64")
                }
            }
            e.var_types[i] = "i64"
            e.var_untyped_kind[i] = UNTYPED_NONE
            e.var_untyped_has_value[i] = false
        } else if cur == "untyped-float" {
            e.var_types[i] = "f64"
            e.var_untyped_kind[i] = UNTYPED_NONE
            e.var_untyped_has_value[i] = false
        } else {
            let def = default_untyped_type(e, &cur)
            if def != cur {
                e.var_types[i] = def
                e.var_untyped_kind[i] = UNTYPED_NONE
                e.var_untyped_has_value[i] = false
            }
        }
        i = i + 1
    }
}

fn infer_untyped_vars(e: &mut Emitter, f: &Function, ret_t: &String) {
    let mut changed = true
    let mut iter = 0
    while changed && iter < 8 {
        changed = infer_untyped_block(e, &f.body, ret_t)
        iter = iter + 1
    }
    finalize_untyped_vars(e)
}

fn collect_vars(e: &mut Emitter, f: &Function) {
    let mut pi = 0
    while pi < len(&f.params) {
        let p = &f.params[pi]
        let pname = &p.name
        let mut ptyp = string_clone("i64")
        if p.has_type { ptyp = string_clone(&p.typ) }
        if var_index(e, pname) < 0 {
            let mut names = e.var_names
            let mut types = e.var_types
            let mut muts = e.var_mut
            let mut kinds = e.var_untyped_kind
            let mut values = e.var_untyped_value
            let mut has_values = e.var_untyped_has_value
            push(&mut names, string_clone(pname))
            push(&mut types, ptyp)
            push(&mut muts, false)
            push(&mut kinds, UNTYPED_NONE)
            push(&mut values, 0)
            push(&mut has_values, false)
            e.var_names = names
            e.var_types = types
            e.var_mut = muts
            e.var_untyped_kind = kinds
            e.var_untyped_value = values
            e.var_untyped_has_value = has_values
        }
        pi = pi + 1
    }
    collect_vars_from_block(e, &f.body)
}

fn collect_strings_from_expr(e: &mut Emitter, expr: &Expr) {
    if expr.kind == EXPR_BLOCK {
        collect_strings_from_block(e, &expr.block)
        return
    }
    if expr.kind == EXPR_CLOSURE {
        collect_strings_from_block(e, &expr.block)
        return
    }
    if expr.kind == EXPR_MATCH {
        if len(&expr.args) > 0 {
            collect_strings_from_expr(e, expr_arg_ref(e, expr, 0, "collect_strings_field_recv"))
        }
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            collect_strings_from_pattern(e, &expr.match_arms[ai].pattern)
            if expr.match_arms[ai].has_guard {
                collect_strings_from_expr(e, &expr.match_arms[ai].guard)
            }
            collect_strings_from_block(e, &expr.match_arms[ai].block)
            ai = ai + 1
        }
        return
    }
    if expr.kind == EXPR_STRING {
        let _ = ensure_string(e, string_clone(&expr.name))
        return
    }
    if expr.kind == EXPR_STRUCT_LIT {
        let _ = ensure_string(e, string_clone(&expr.name))
        let mut fi = 0
        while fi < len(&expr.fields) {
            let f = &expr.fields[fi]
            let _ = ensure_string(e, string_clone(&f.name))
            collect_strings_from_expr(e, &f.value)
            fi = fi + 1
        }
        return
    }
    if expr.kind == EXPR_FIELD {
        let _ = ensure_string(e, string_clone(&expr.name))
        if len(&expr.args) > 0 {
            collect_strings_from_expr(e, expr_arg_ref(e, expr, 0, "collect_strings_enum_recv"))
        }
        return
    }
    let mut i = 0
    while i < len(&expr.args) {
        collect_strings_from_expr(e, expr_arg_ref(e, expr, i, "collect_strings_arg"))
        i = i + 1
    }
    let mut j = 0
    while j < len(&expr.fields) {
        collect_strings_from_expr(e, &expr.fields[j].value)
        j = j + 1
    }
}

fn collect_strings_from_pattern(e: &mut Emitter, pat: &Pattern) {
    if pat.kind == PAT_RANGE {
        if pat.range_has_start { collect_strings_from_expr(e, &pat.range_start) }
        if pat.range_has_end { collect_strings_from_expr(e, &pat.range_end) }
        return
    }
    if pat.kind == PAT_VARIANT {
        if pat.has_payload && len(&pat.payload) > 0 {
            collect_strings_from_pattern(e, &pat.payload[0])
        }
        return
    }
    if pat.kind == PAT_ARRAY {
        let mut i = 0
        while i < len(&pat.payload) {
            collect_strings_from_pattern(e, &pat.payload[i])
            i = i + 1
        }
        return
    }
    if pat.kind == PAT_STRUCT {
        let mut i = 0
        while i < len(&pat.struct_fields) {
            collect_strings_from_pattern(e, &pat.struct_fields[i].pattern)
            i = i + 1
        }
        return
    }
}

fn collect_strings_from_block(e: &mut Emitter, b: &Block) {
    collect_strings_from_stmts(e, &b.stmts)
}

fn collect_strings_from_stmts(e: &mut Emitter, items: & [Stmt]) {
    let mut i = 0
    while i < len(items) {
        let s = &(*items)[i]
        collect_strings_from_expr(e, &s.expr)
        if s.kind == STMT_IF {
            collect_strings_from_block(e, &s.block)
            if s.has_else { collect_strings_from_block(e, &s.else_block) }
        } else if s.kind == STMT_IFLET {
            collect_strings_from_block(e, &s.block)
            if s.has_else { collect_strings_from_block(e, &s.else_block) }
        } else if s.kind == STMT_MATCH {
            let mut ai = 0
            while ai < len(&s.arms) {
                collect_strings_from_pattern(e, &s.arms[ai].pattern)
                if s.arms[ai].has_guard {
                    collect_strings_from_expr(e, &s.arms[ai].guard)
                }
                collect_strings_from_block(e, &s.arms[ai].block)
                ai = ai + 1
            }
        } else if s.kind == STMT_WHILE || s.kind == STMT_LOOP {
            collect_strings_from_block(e, &s.block)
        } else if s.kind == STMT_BREAK_VALUE {
            collect_strings_from_expr(e, &s.expr)
        }
        i = i + 1
    }
}

fn collect_strings_structs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.structs) {
        let s = &prog.structs[i]
        let _ = ensure_string(e, string_clone(&s.name))
        let mut fi = 0
        while fi < len(&s.fields) {
            let f = &s.fields[fi]
            let _ = ensure_string(e, string_clone(&f.name))
            fi = fi + 1
        }
        i = i + 1
    }
}

fn collect_strings_enums(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.enums) {
        let en = &prog.enums[i]
        let _ = ensure_string(e, string_clone(&en.name))
        let mut has_payload = false
        let mut vi = 0
        while vi < len(&en.variants) {
            if en.variants[vi].has_payload { has_payload = true }
            vi = vi + 1
        }
        if has_payload {
            let _ = ensure_string(e, "_tag")
            let _ = ensure_string(e, "_payload")
        }
        i = i + 1
    }
}

fn collect_strings(e: &mut Emitter, prog: &Program) {
    collect_strings_structs(e, prog)
    collect_strings_enums(e, prog)
    let mut i = 0
    while i < len(&prog.consts) {
        collect_strings_from_expr(e, &prog.consts[i].expr)
        i = i + 1
    }
    let mut fi = 0
    while fi < len(&prog.functions) {
        if !prog.functions[fi].is_macro {
            collect_strings_from_block(e, &prog.functions[fi].body)
        }
        fi = fi + 1
    }
}
