// Unit tests for emit_binary_expr codegen selection.

fn assert_true(cond: bool, msg: String) {
    if !cond {
        println("assert_true failed", msg)
        exit(1)
    }
}

fn body_contains(lines: & [String], needle: String) -> bool {
    let mut i = 0
    while i < len(lines) {
        let line = &(*lines)[i]
        if str_has_substr(line, &needle) { return true }
        i = i + 1
    }
    return false
}

fn str_has_substr(s: &str, sub: &str) -> bool {
    let ns = str_len(s)
    let nsub = str_len(sub)
    if nsub == 0 { return true }
    if ns < nsub { return false }
    let mut i = 0
    while i + nsub <= ns {
        if str_substr(s, i, nsub) == sub { return true }
        i = i + 1
    }
    return false
}

fn setup_emitter_emit(t1: String, t2: String) -> Emitter {
    let mut e = emitter_new()
    let mut names: [String] = []
    let mut types: [String] = []
    let mut muts: [bool] = []
    push(&mut names, string_clone("a"))
    push(&mut names, string_clone("b"))
    push(&mut types, t1)
    push(&mut types, t2)
    push(&mut muts, false)
    push(&mut muts, false)
    e.var_names = names
    e.var_types = types
    e.var_mut = muts
    return e
}

fn bin_expr_emit(op: String) -> Expr {
    return expr_binary(op, expr_ident("a"), expr_ident("b"))
}

fn test_emit_div_ops() {
    let mut e1 = setup_emitter_emit("i32", "i32")
    let expr1 = bin_expr_emit("/")
    let v1 = emit_binary_expr(&mut e1, &expr1)
    assert_true(v1.typ == "i32", "signed div result type")
    assert_true(body_contains(&e1.body, " div "), "signed div opcode")

    let mut e2 = setup_emitter_emit("u32", "u32")
    let expr2 = bin_expr_emit("/")
    let v2 = emit_binary_expr(&mut e2, &expr2)
    assert_true(v2.typ == "u32", "unsigned div result type")
    assert_true(body_contains(&e2.body, " udiv "), "unsigned div opcode")
}

fn test_emit_cmp_ops() {
    let mut e1 = setup_emitter_emit("i16", "i16")
    let expr1 = bin_expr_emit("<")
    let _ = emit_binary_expr(&mut e1, &expr1)
    assert_true(body_contains(&e1.body, " csltw "), "signed cmp opcode")

    let mut e2 = setup_emitter_emit("u16", "u16")
    let expr2 = bin_expr_emit("<")
    let _ = emit_binary_expr(&mut e2, &expr2)
    assert_true(body_contains(&e2.body, " cultw "), "unsigned cmp opcode")
}

fn test_emit_shift_ops() {
    let mut e1 = setup_emitter_emit("i16", "u8")
    let expr1 = bin_expr_emit(">>")
    let _ = emit_binary_expr(&mut e1, &expr1)
    assert_true(body_contains(&e1.body, " sar "), "signed shift opcode")

    let mut e2 = setup_emitter_emit("u16", "u8")
    let expr2 = bin_expr_emit(">>")
    let _ = emit_binary_expr(&mut e2, &expr2)
    assert_true(body_contains(&e2.body, " shr "), "unsigned shift opcode")
}

fn test_emit_peer_type() {
    let mut e = setup_emitter_emit("i16", "i16")
    let expr = bin_expr_emit("+")
    let v = emit_binary_expr(&mut e, &expr)
    assert_true(v.typ == "i16", "peer type i16 for i16+i16")
}

fn test_emit_char_literal() {
    let mut e = emitter_new()
    let c = expr_char(97)
    let v = emit_expr(&mut e, &c)
    assert_true(v.typ == "char", "char literal type")
    assert_true(v.expr == "97", "char literal value")
}

fn test_emit_float_ops() {
    let mut e1 = setup_emitter_emit("f32", "f32")
    let expr1 = bin_expr_emit("+")
    let v1 = emit_binary_expr(&mut e1, &expr1)
    assert_true(v1.typ == "f32", "f32 add result type")
    assert_true(body_contains(&e1.body, " =s add "), "f32 add opcode")

    let mut e2 = setup_emitter_emit("f64", "f64")
    let expr2 = bin_expr_emit("<")
    let _ = emit_binary_expr(&mut e2, &expr2)
    assert_true(body_contains(&e2.body, " cltd "), "f64 cmp opcode")
}

fn test_emit_unit_field_store_skipped() {
    let mut e = emitter_new()
    let base = "%t0"
    let typ = "unit"
    emit_mem_store_value(&mut e, base, 0, typ, "0")
    assert_true(len(&e.body) == 0, "unit field store emits no code")
}

fn test_emit_unit_field_load() {
    let mut e = emitter_new()
    let base = "%t0"
    let typ = "unit"
    let v = emit_mem_load_value(&mut e, base, 0, typ)
    assert_true(v.typ == "unit", "unit field load type")
    assert_true(v.expr == "0", "unit field load value")
    assert_true(len(&e.body) == 0, "unit field load emits no code")
}
