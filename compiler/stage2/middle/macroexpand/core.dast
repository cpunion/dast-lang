// Minimal macro expansion for stage2 (macro fn, compile!, quote).

const MV_UNIT = 0
const MV_INT = 1
const MV_BOOL = 2
const MV_STRING = 3
const MV_AST_EXPR = 4
const MV_AST_STMT = 5
const MV_AST_ITEM = 6
const MV_AST_BLOCK = 7
const MV_BIND = 8

struct MacroValue {
    kind: i32,
    int_value: i64,
    bool_value: bool,
    str_value: String,
    expr: Expr,
    stmt: Stmt,
    block: Block,
    prog: Program,
    ast_src: String,
}

fn program_empty() -> Program {
    let mut imports: [ImportDecl] = []
    let mut structs: [StructDecl] = []
    let mut enums: [EnumDecl] = []
    let mut type_aliases: [TypeAlias] = []
    let mut consts: [ConstDecl] = []
    let mut functions: [Function] = []
    let mut traits: [TraitDecl] = []
    let mut impls: [ImplDecl] = []
    return Program { imports: imports, structs: structs, enums: enums, type_aliases: type_aliases, consts: consts, functions: functions, compile_items: compile_item_list_empty(), traits: traits, impls: impls }
}

fn program_clone(p: &Program) -> Program {
    return Program {
        imports: import_decl_list_clone(&p.imports),
        structs: struct_decl_list_clone(&p.structs),
        enums: enum_decl_list_clone(&p.enums),
        type_aliases: type_alias_list_clone(&p.type_aliases),
        consts: const_decl_list_clone(&p.consts),
        functions: function_list_clone(&p.functions),
        compile_items: compile_item_list_clone(&p.compile_items),
        traits: trait_decl_list_clone(&p.traits),
        impls: impl_decl_list_clone(&p.impls),
    }
}

fn program_merge(dest: &mut Program, src: &Program) {
    let mut d = dest
    let mut i = 0
    while i < len(&src.structs) {
        push(&mut d.structs, struct_decl_clone(&src.structs[i]))
        i = i + 1
    }
    i = 0
    while i < len(&src.imports) {
        push(&mut d.imports, import_decl_clone(&src.imports[i]))
        i = i + 1
    }
    i = 0
    while i < len(&src.enums) {
        push(&mut d.enums, enum_decl_clone(&src.enums[i]))
        i = i + 1
    }
    i = 0
    while i < len(&src.type_aliases) {
        push(&mut d.type_aliases, type_alias_clone(&src.type_aliases[i]))
        i = i + 1
    }
    i = 0
    while i < len(&src.consts) {
        push(&mut d.consts, const_decl_clone(&src.consts[i]))
        i = i + 1
    }
    i = 0
    while i < len(&src.traits) {
        push(&mut d.traits, trait_decl_clone(&src.traits[i]))
        i = i + 1
    }
    i = 0
    while i < len(&src.impls) {
        push(&mut d.impls, impl_decl_clone(&src.impls[i]))
        i = i + 1
    }
    i = 0
    while i < len(&src.functions) {
        push(&mut d.functions, function_clone(&src.functions[i]))
        i = i + 1
    }
    i = 0
    while i < len(&src.compile_items) {
        push(&mut d.compile_items, compile_item_clone(&src.compile_items[i]))
        i = i + 1
    }
}

fn macro_value_unit() -> MacroValue {
    return MacroValue { kind: MV_UNIT, int_value: 0, bool_value: false, str_value: "", expr: expr_int(0), stmt: stmt_expr(expr_int(0)), block: block_empty(), prog: program_empty(), ast_src: "" }
}

fn macro_value_int(v: i64) -> MacroValue {
    let mut out = macro_value_unit()
    out.kind = MV_INT
    out.int_value = v
    return out
}

fn macro_value_bool(v: bool) -> MacroValue {
    let mut out = macro_value_unit()
    out.kind = MV_BOOL
    out.bool_value = v
    return out
}

fn macro_value_string(v: String) -> MacroValue {
    let mut out = macro_value_unit()
    out.kind = MV_STRING
    out.str_value = v
    return out
}

fn macro_value_bind(name: String) -> MacroValue {
    let mut out = macro_value_unit()
    out.kind = MV_BIND
    out.str_value = name
    return out
}

fn macro_value_expr(e: Expr, src: String) -> MacroValue {
    let mut out = macro_value_unit()
    out.kind = MV_AST_EXPR
    out.expr = expr_clone(&e)
    out.ast_src = src
    return out
}

fn macro_value_stmt(s: Stmt, src: String) -> MacroValue {
    let mut out = macro_value_unit()
    out.kind = MV_AST_STMT
    out.stmt = stmt_clone(&s)
    out.ast_src = src
    return out
}

fn macro_value_block(b: Block, src: String) -> MacroValue {
    let mut out = macro_value_unit()
    out.kind = MV_AST_BLOCK
    out.block = block_clone(&b)
    out.ast_src = src
    return out
}

fn macro_value_item(p: Program, src: String) -> MacroValue {
    let mut out = macro_value_unit()
    out.kind = MV_AST_ITEM
    out.prog = program_clone(&p)
    out.ast_src = src
    return out
}

fn macro_value_clone(v: &MacroValue) -> MacroValue {
    return MacroValue {
        kind: v.kind,
        int_value: v.int_value,
        bool_value: v.bool_value,
        str_value: string_clone(&v.str_value),
        expr: expr_clone(&v.expr),
        stmt: stmt_clone(&v.stmt),
        block: block_clone(&v.block),
        prog: program_clone(&v.prog),
        ast_src: string_clone(&v.ast_src),
    }
}

struct MacroEnv {
    names: [String],
    values: [MacroValue],
}

fn macro_env_new() -> MacroEnv {
    let mut names: [String] = []
    let mut values: [MacroValue] = []
    return MacroEnv { names: names, values: values }
}

fn macro_env_get(env: &MacroEnv, name: &str) -> MacroValue {
    let mut i = len(&env.names) - 1
    while i >= 0 {
        if env.names[i] == name {
            return macro_value_clone(&env.values[i])
        }
        if i == 0 { break }
        i = i - 1
    }
    println("stage2: macro unknown identifier", name)
    exit(1)
    return macro_value_unit()
}

fn macro_env_set(env: &mut MacroEnv, name: &str, v: MacroValue) {
    let mut e = env
    push(&mut e.names, string_clone(name))
    push(&mut e.values, macro_value_clone(&v))
}

struct MacroCtx {
    macro_names: [String],
    macro_funcs: [Function],
    gensym_count: i64,
}

fn macro_ctx_new(prog: &Program) -> MacroCtx {
    let mut names: [String] = []
    let mut funcs: [Function] = []
    let mut i = 0
    while i < len(&prog.functions) {
        let f = &prog.functions[i]
        if f.is_macro {
            push(&mut names, string_clone(&f.name))
            push(&mut funcs, function_clone(f))
        }
        i = i + 1
    }
    return MacroCtx { macro_names: names, macro_funcs: funcs, gensym_count: 0 }
}

fn macro_find_fn(ctx: &MacroCtx, name: &str) -> i64 {
    let mut i = 0
    while i < len(&ctx.macro_names) {
        if ctx.macro_names[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn macro_gensym(ctx: &mut MacroCtx, prefix: &str) -> String {
    let name = "__dast_" + string_clone(prefix) + "_" + int_to_string(ctx.gensym_count)
    ctx.gensym_count = ctx.gensym_count + 1
    return name
}

struct EvalResult {
    value: MacroValue,
    returned: bool,
}

fn eval_result(value: MacroValue, returned: bool) -> EvalResult {
    return EvalResult { value: value, returned: returned }
}

fn eval_block(ctx: &mut MacroCtx, env: &mut MacroEnv, block: &Block) -> EvalResult {
    let n = len(&block.stmts)
    if n == 0 { return eval_result(macro_value_unit(), false) }
    let mut i = 0
    while i < n {
        let stmt = stmt_clone(&block.stmts[i])
        if i + 1 == n && stmt.kind == STMT_EXPR {
            let v = eval_expr(ctx, env, &stmt.expr)
            return eval_result(v, false)
        }
        let res = eval_stmt(ctx, env, &stmt)
        if res.returned { return res }
        i = i + 1
    }
    return eval_result(macro_value_unit(), false)
}

fn eval_stmt(ctx: &mut MacroCtx, env: &mut MacroEnv, stmt: &Stmt) -> EvalResult {
    if stmt.kind == STMT_LET {
        let v = eval_expr(ctx, env, &stmt.expr)
        macro_env_set(env, &stmt.name, v)
        return eval_result(macro_value_unit(), false)
    }
    if stmt.kind == STMT_RETURN {
        if stmt.ret_has_value {
            let v = eval_expr(ctx, env, &stmt.expr)
            return eval_result(v, true)
        }
        return eval_result(macro_value_unit(), true)
    }
    if stmt.kind == STMT_EXPR {
        let v = eval_expr(ctx, env, &stmt.expr)
        return eval_result(v, false)
    }
    println("stage2: unsupported macro stmt")
    exit(1)
    return eval_result(macro_value_unit(), false)
}

fn macro_value_expect_string(v: &MacroValue) -> String {
    if v.kind == MV_STRING { return string_clone(&v.str_value) }
    println("stage2: macro expects String/str")
    exit(1)
    return ""
}

fn macro_value_to_string(v: &MacroValue) -> String {
    if v.kind == MV_STRING { return string_clone(&v.str_value) }
    if v.kind == MV_AST_EXPR || v.kind == MV_AST_STMT || v.kind == MV_AST_ITEM || v.kind == MV_AST_BLOCK {
        if v.ast_src != "" { return string_clone(&v.ast_src) }
    }
    println("stage2: ast_to_string unsupported value")
    exit(1)
    return ""
}

fn macro_value_expect_expr(v: &MacroValue) -> Expr {
    if v.kind == MV_AST_EXPR { return expr_clone(&v.expr) }
    println("stage2: ast_eq expects AstExpr")
    exit(1)
    return expr_int(0)
}

fn ast_expr_list_eq(a: & [Expr], b: & [Expr]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if !ast_expr_eq(&(*a)[i], &(*b)[i]) { return false }
        i = i + 1
    }
    return true
}

fn ast_field_init_eq(a: &FieldInit, b: &FieldInit) -> bool {
    if a.name != b.name { return false }
    return ast_expr_eq(&a.value, &b.value)
}

fn ast_field_init_list_eq(a: & [FieldInit], b: & [FieldInit]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if !ast_field_init_eq(&(*a)[i], &(*b)[i]) { return false }
        i = i + 1
    }
    return true
}

fn ast_param_eq(a: &Param, b: &Param) -> bool {
    if a.name != b.name { return false }
    if a.has_type != b.has_type { return false }
    if a.has_type && a.typ != b.typ { return false }
    return true
}

fn ast_param_list_eq(a: & [Param], b: & [Param]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if !ast_param_eq(&(*a)[i], &(*b)[i]) { return false }
        i = i + 1
    }
    return true
}

fn ast_quote_part_eq(a: &QuotePart, b: &QuotePart) -> bool {
    if a.text != b.text { return false }
    if a.has_expr != b.has_expr { return false }
    if a.has_expr && !ast_expr_eq(&a.expr, &b.expr) { return false }
    return true
}

fn ast_quote_part_list_eq(a: & [QuotePart], b: & [QuotePart]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if !ast_quote_part_eq(&(*a)[i], &(*b)[i]) { return false }
        i = i + 1
    }
    return true
}

fn ast_pattern_eq(a: &Pattern, b: &Pattern) -> bool {
    if a.kind != b.kind { return false }
    if a.name != b.name { return false }
    if a.int_value != b.int_value { return false }
    if a.range_inclusive != b.range_inclusive { return false }
    if a.range_has_start != b.range_has_start { return false }
    if a.range_has_end != b.range_has_end { return false }
    if a.range_has_start && !ast_expr_eq(&a.range_start, &b.range_start) { return false }
    if a.range_has_end && !ast_expr_eq(&a.range_end, &b.range_end) { return false }
    if a.variant != b.variant { return false }
    if a.has_payload != b.has_payload { return false }
    if len(&a.payload) != len(&b.payload) { return false }
    let mut pi = 0
    while pi < len(&a.payload) {
        if !ast_pattern_eq(&a.payload[pi], &b.payload[pi]) { return false }
        pi = pi + 1
    }
    if a.struct_name != b.struct_name { return false }
    if len(&a.struct_fields) != len(&b.struct_fields) { return false }
    let mut fi = 0
    while fi < len(&a.struct_fields) {
        let fa = &a.struct_fields[fi]
        let fb = &b.struct_fields[fi]
        if fa.name != fb.name { return false }
        if !ast_pattern_eq(&fa.pattern, &fb.pattern) { return false }
        fi = fi + 1
    }
    return true
}

fn ast_match_arm_eq(a: &MatchArm, b: &MatchArm) -> bool {
    if !ast_pattern_eq(&a.pattern, &b.pattern) { return false }
    if a.has_guard != b.has_guard { return false }
    if a.has_guard && !ast_expr_eq(&a.guard, &b.guard) { return false }
    return ast_block_eq(&a.block, &b.block)
}

fn ast_match_arm_list_eq(a: & [MatchArm], b: & [MatchArm]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if !ast_match_arm_eq(&(*a)[i], &(*b)[i]) { return false }
        i = i + 1
    }
    return true
}

fn ast_stmt_eq(a: &Stmt, b: &Stmt) -> bool {
    if a.kind != b.kind { return false }
    if a.name != b.name { return false }
    if a.mutable != b.mutable { return false }
    if a.has_type != b.has_type { return false }
    if a.has_type && a.typ != b.typ { return false }
    if !ast_expr_eq(&a.lhs, &b.lhs) { return false }
    if !ast_expr_eq(&a.expr, &b.expr) { return false }
    if !ast_block_eq(&a.block, &b.block) { return false }
    if a.has_else != b.has_else { return false }
    if a.has_else && !ast_block_eq(&a.else_block, &b.else_block) { return false }
    if a.ret_has_value != b.ret_has_value { return false }
    if a.pat_variant != b.pat_variant { return false }
    if a.pat_binding != b.pat_binding { return false }
    if a.pat_has_binding != b.pat_has_binding { return false }
    if !ast_match_arm_list_eq(&a.arms, &b.arms) { return false }
    return true
}

fn ast_block_eq(a: &Block, b: &Block) -> bool {
    if len(&a.stmts) != len(&b.stmts) { return false }
    let mut i = 0
    while i < len(&a.stmts) {
        if !ast_stmt_eq(&a.stmts[i], &b.stmts[i]) { return false }
        i = i + 1
    }
    return true
}

fn ast_expr_eq(a: &Expr, b: &Expr) -> bool {
    if a.kind != b.kind { return false }
    if a.name != b.name { return false }
    if a.int_value != b.int_value { return false }
    if a.float_text != b.float_text { return false }
    if a.bool_value != b.bool_value { return false }
    if a.ref_mut != b.ref_mut { return false }
    if a.quote_kind != b.quote_kind { return false }
    if !ast_expr_list_eq(&a.args, &b.args) { return false }
    if !ast_field_init_list_eq(&a.fields, &b.fields) { return false }
    if !ast_param_list_eq(&a.params, &b.params) { return false }
    if !ast_block_eq(&a.block, &b.block) { return false }
    if !ast_match_arm_list_eq(&a.match_arms, &b.match_arms) { return false }
    if !ast_quote_part_list_eq(&a.quote_parts, &b.quote_parts) { return false }
    return true
}

fn eval_macro_fn(ctx: &mut MacroCtx, f: &Function, args: [MacroValue]) -> MacroValue {
    if len(&args) != len(&f.params) {
        println("stage2: macro arg mismatch", f.name, len(&args), len(&f.params))
        exit(1)
    }
    let mut env = macro_env_new()
    let mut i = 0
    while i < len(&f.params) {
        macro_env_set(&mut env, &f.params[i].name, macro_value_clone(&args[i]))
        i = i + 1
    }
    let res = eval_block(ctx, &mut env, &f.body)
    return res.value
}

fn eval_macro_call(ctx: &mut MacroCtx, name: &str, args: [MacroValue]) -> MacroValue {
    let idx = macro_find_fn(ctx, name)
    if idx < 0 {
        println("stage2: unknown macro", name)
        exit(1)
    }
    return eval_macro_fn(ctx, &ctx.macro_funcs[idx], args)
}

fn eval_expr(ctx: &mut MacroCtx, env: &mut MacroEnv, expr: &Expr) -> MacroValue {
    match expr.kind {
        EXPR_INT => { return macro_value_int(expr.int_value) }
        EXPR_BOOL => { return macro_value_bool(expr.bool_value) }
        EXPR_CHAR => { return macro_value_int(expr.int_value) }
        EXPR_STRING => { return macro_value_string(string_clone(&expr.name)) }
        EXPR_IDENT => { return macro_env_get(env, &expr.name) }
        EXPR_BLOCK => {
            let res = eval_block(ctx, env, &expr.block)
            return res.value
        }
        EXPR_QUOTE => { return eval_quote_expr(ctx, env, expr) }
        EXPR_MACRO_CALL => {
            let name = string_clone(&expr.name)
            if name == "compile" {
                if len(&expr.args) != 1 { println("stage2: compile! expects 1 arg"); exit(1) }
                let arg0 = expr_clone(&expr.args[0])
                return eval_expr(ctx, env, &arg0)
            }
            let mut args: [MacroValue] = []
            let mut i = 0
            while i < len(&expr.args) {
                let arg = expr_clone(&expr.args[i])
                push(&mut args, eval_expr(ctx, env, &arg))
                i = i + 1
            }
            return eval_macro_call(ctx, &name, args)
        }
        EXPR_CALL => {
            let name = string_clone(&expr.name)
            if name == "ast_expr" {
                let arg0 = expr_clone(&expr.args[0])
                let v = eval_expr(ctx, env, &arg0)
                let s = macro_value_expect_string(&v)
                let e = parse_expr_string(&s)
                return macro_value_expr(e, s)
            }
            if name == "ast_stmt" {
                let arg0 = expr_clone(&expr.args[0])
                let v = eval_expr(ctx, env, &arg0)
                let s = macro_value_expect_string(&v)
                let st = parse_stmt_string(&s)
                return macro_value_stmt(st, s)
            }
            if name == "ast_item" {
                let arg0 = expr_clone(&expr.args[0])
                let v = eval_expr(ctx, env, &arg0)
                let s = macro_value_expect_string(&v)
                let p = parse_program_loose(&s)
                return macro_value_item(p, s)
            }
            if name == "ast_block" {
                let arg0 = expr_clone(&expr.args[0])
                let v = eval_expr(ctx, env, &arg0)
                let s = macro_value_expect_string(&v)
                let b = parse_block_string(&s)
                return macro_value_block(b, s)
            }
            if name == "ast_to_string" {
                let arg0 = expr_clone(&expr.args[0])
                let v = eval_expr(ctx, env, &arg0)
                return macro_value_string(macro_value_to_string(&v))
            }
            if name == "ast_eq" {
                if len(&expr.args) != 2 { println("stage2: ast_eq expects 2 args"); exit(1) }
                let a0 = expr_clone(&expr.args[0])
                let a1 = expr_clone(&expr.args[1])
                let v0 = eval_expr(ctx, env, &a0)
                let v1 = eval_expr(ctx, env, &a1)
                let e0 = macro_value_expect_expr(&v0)
                let e1 = macro_value_expect_expr(&v1)
                let ok = ast_expr_eq(&e0, &e1)
                return macro_value_bool(ok)
            }
            if name == "ast_assert_eq" {
                if len(&expr.args) != 2 { println("stage2: ast_assert_eq expects 2 args"); exit(1) }
                let a0 = expr_clone(&expr.args[0])
                let a1 = expr_clone(&expr.args[1])
                let v0 = eval_expr(ctx, env, &a0)
                let v1 = eval_expr(ctx, env, &a1)
                let e0 = macro_value_expect_expr(&v0)
                let e1 = macro_value_expect_expr(&v1)
                let ok = ast_expr_eq(&e0, &e1)
                if !ok {
                    let s0 = macro_value_to_string(&v0)
                    let s1 = macro_value_to_string(&v1)
                    println("stage2: assert_ast_eq failed", s0, s1)
                    exit(1)
                }
                return macro_value_unit()
            }
            if name == "gensym" {
                let arg0 = expr_clone(&expr.args[0])
                let v = eval_expr(ctx, env, &arg0)
                let prefix = macro_value_expect_string(&v)
                let name = macro_gensym(ctx, &prefix)
                return macro_value_string(name)
            }
            if name == "bind" {
                let arg0 = expr_clone(&expr.args[0])
                let v = eval_expr(ctx, env, &arg0)
                let name = macro_value_expect_string(&v)
                return macro_value_bind(name)
            }
        }
    }
    println("stage2: unsupported macro expr")
    exit(1)
    return macro_value_unit()
}

struct QuoteSplice {
    id: i64,
    value: MacroValue,
}

fn quote_splice_list_empty() -> [QuoteSplice] {
    let mut out: [QuoteSplice] = []
    return out
}

fn quote_placeholder_name(id: i64) -> String {
    return "__dast_splice_" + int_to_string(id) + "__"
}

fn quote_is_placeholder(name: &str) -> bool {
    let prefix = "__dast_splice_"
    let suffix = "__"
    return str_has_prefix(name, &prefix) && str_has_suffix(name, &suffix)
}

fn quote_placeholder_index(name: &str) -> i64 {
    if !quote_is_placeholder(name) { return -1 }
    let prefix = "__dast_splice_"
    let suffix = "__"
    let plen = str_len(&prefix)
    let slen = str_len(name)
    let inner_len = slen - plen - str_len(&suffix)
    if inner_len <= 0 { return -1 }
    let inner = str_substr(name, plen, inner_len)
    return parse_int_simple(&inner)
}

fn quote_bind_marker(name: &str) -> String {
    return "__dast_bind__" + string_clone(name)
}

fn quote_is_bind_marker(name: &str) -> bool {
    let prefix = "__dast_bind__"
    return str_has_prefix(name, &prefix)
}

fn quote_strip_bind_marker(name: &str) -> String {
    if !quote_is_bind_marker(name) { return string_clone(name) }
    let prefix = "__dast_bind__"
    let plen = str_len(&prefix)
    let slen = str_len(name)
    if slen <= plen { return "" }
    return str_substr(name, plen, slen - plen)
}

fn quote_is_ident_char(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
}

fn quote_join(out: String, add: &str) -> String {
    if out == "" { return string_clone(add) }
    if add == "" { return out }
    let out_len = str_len(&out)
    let add_len = str_len(add)
    if out_len > 0 && add_len > 0 {
        let last = str_char_at(&out, out_len - 1)
        let first = str_char_at(add, 0)
        if quote_is_ident_char(last) && quote_is_ident_char(first) {
            return out + " " + string_clone(add)
        }
    }
    return out + string_clone(add)
}

struct RenameMap {
    names: [String],
    values: [String],
}

fn rename_map_new() -> RenameMap {
    let mut names: [String] = []
    let mut values: [String] = []
    return RenameMap { names: names, values: values }
}

fn rename_map_clone(m: &RenameMap) -> RenameMap {
    let mut out = rename_map_new()
    let mut i = 0
    while i < len(&m.names) {
        push(&mut out.names, string_clone(&m.names[i]))
        push(&mut out.values, string_clone(&m.values[i]))
        i = i + 1
    }
    return out
}

fn rename_map_get(m: &RenameMap, name: &str) -> String {
    let mut i = 0
    while i < len(&m.names) {
        if m.names[i] == name { return string_clone(&m.values[i]) }
        i = i + 1
    }
    return string_clone(name)
}

fn rename_map_add(m: &mut RenameMap, name: &str, renamed: &str) {
    let mut r = m
    push(&mut r.names, string_clone(name))
    push(&mut r.values, string_clone(renamed))
}

fn hygiene_rename_ident(ctx: &mut MacroCtx, m: &RenameMap, name: &str) -> String {
    if quote_is_placeholder(name) { return string_clone(name) }
    if quote_is_bind_marker(name) { return quote_strip_bind_marker(name) }
    return rename_map_get(m, name)
}

fn hygiene_bind_name(ctx: &mut MacroCtx, m: &mut RenameMap, name: &str) -> String {
    if quote_is_placeholder(name) { return string_clone(name) }
    if quote_is_bind_marker(name) { return quote_strip_bind_marker(name) }
    let renamed = macro_gensym(ctx, name)
    rename_map_add(m, name, &renamed)
    return renamed
}
