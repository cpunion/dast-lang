// stage2: minimal compiler pipeline (parse -> QBE -> native).

struct QbeValue {
    typ: String,
    expr: String,
    lines: [String],
}

fn string_list_empty() -> [String] {
    let mut out: [String] = []
    return out
}

fn bool_list_empty() -> [bool] {
    let mut out: [bool] = []
    return out
}

fn qbe_lines_empty() -> [String] {
    return string_list_empty()
}

fn str_clone(s: &str) -> String {
    return substr(s, 0, len(&s))
}

fn clone_expr_list(items: & [Expr]) -> [Expr] {
    let mut out: [Expr] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, expr_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn string_has_prefix(s: &str, prefix: &str) -> bool {
    let sl = len(&s)
    let pl = len(&prefix)
    if pl > sl { return false }
    return substr(string_clone(s), 0, pl) == string_clone(prefix)
}

fn is_digit_str(s: &str) -> bool {
    let n = len(&s)
    if n == 0 { return false }
    let mut i = 0
    while i < n {
        let c = str_char_at(s, i)
        if c < 48 || c > 57 { return false }
        i = i + 1
    }
    return true
}

fn qbe_value(typ: String, expr: String) -> QbeValue {
    return QbeValue { typ: typ, expr: expr, lines: qbe_lines_empty() }
}

fn qbe_value_with_lines(typ: String, expr: String, lines: [String]) -> QbeValue {
    return QbeValue { typ: typ, expr: expr, lines: lines }
}

struct FuncSig {
    name: String,
    ret_type: String,
}

fn func_sig_list_empty() -> [FuncSig] {
    let mut out: [FuncSig] = []
    return out
}

fn func_sig_clone(s: &FuncSig) -> FuncSig {
    return FuncSig { name: string_clone(&s.name), ret_type: string_clone(&s.ret_type) }
}

fn func_sig_list_clone(items: & [FuncSig]) -> [FuncSig] {
    let mut out: [FuncSig] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, func_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct StructFieldSig {
    name: String,
    typ: String,
}

fn struct_field_sig_list_empty() -> [StructFieldSig] {
    let mut out: [StructFieldSig] = []
    return out
}

fn struct_field_sig_clone(f: &StructFieldSig) -> StructFieldSig {
    return StructFieldSig { name: string_clone(&f.name), typ: string_clone(&f.typ) }
}

fn struct_field_sig_list_clone(items: & [StructFieldSig]) -> [StructFieldSig] {
    let mut out: [StructFieldSig] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, struct_field_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct StructSig {
    name: String,
    type_params: [String],
    fields: [StructFieldSig],
}

fn struct_sig_list_empty() -> [StructSig] {
    let mut out: [StructSig] = []
    return out
}

fn struct_sig_clone(s: &StructSig) -> StructSig {
    return StructSig { name: string_clone(&s.name), type_params: ast_string_list_clone(&s.type_params), fields: struct_field_sig_list_clone(&s.fields) }
}

fn struct_sig_list_clone(items: & [StructSig]) -> [StructSig] {
    let mut out: [StructSig] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, struct_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct EnumVariantSig {
    name: String,
    value: i64,
    has_payload: bool,
    payload_type: String,
}

fn enum_variant_sig_list_empty() -> [EnumVariantSig] {
    let mut out: [EnumVariantSig] = []
    return out
}

fn enum_variant_sig_clone(v: &EnumVariantSig) -> EnumVariantSig {
    return EnumVariantSig { name: string_clone(&v.name), value: v.value, has_payload: v.has_payload, payload_type: string_clone(&v.payload_type) }
}

fn enum_variant_sig_list_clone(items: & [EnumVariantSig]) -> [EnumVariantSig] {
    let mut out: [EnumVariantSig] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, enum_variant_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct EnumSig {
    name: String,
    type_params: [String],
    tag_type: String,
    variants: [EnumVariantSig],
}

fn enum_sig_list_empty() -> [EnumSig] {
    let mut out: [EnumSig] = []
    return out
}

fn enum_sig_clone(s: &EnumSig) -> EnumSig {
    return EnumSig { name: string_clone(&s.name), type_params: ast_string_list_clone(&s.type_params), tag_type: string_clone(&s.tag_type), variants: enum_variant_sig_list_clone(&s.variants) }
}

fn enum_sig_list_clone(items: & [EnumSig]) -> [EnumSig] {
    let mut out: [EnumSig] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, enum_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct Emitter {
    // String table.
    strings: [String],
    // Const table.
    const_names: [String],
    const_exprs: [Expr],
    const_types: [String],
    // Type alias table.
    type_alias_names: [String],
    type_alias_targets: [String],
    // Struct table.
    struct_sigs: [StructSig],
    // Enum table.
    enum_sigs: [EnumSig],
    // Function table.
    func_sigs: [FuncSig],
    func_decls: [Function],
    // Trait impls.
    impls: [ImplDecl],
    // Monomorphized functions.
    inst_func_names: [String],
    inst_funcs: [Function],
    // Vars.
    var_names: [String],
    var_types: [String],
    var_mut: [bool],
    enum_var_names: [String],
    enum_var_types: [String],
    // Local closures (simple inlining).
    closure_names: [String],
    closure_blocks: [Block],
    // Live drop candidates in current function.
    drop_live_names: [String],
    drop_live_types: [String],
    // Current function return type.
    cur_ret_type: String,
    // Temp id counter.
    temp_id: i64,
    // Label id counter.
    label_id: i64,
    // Loop control stacks.
    break_labels: [String],
    continue_labels: [String],
    // Emitted body lines.
    body: [String],
    // Emitted line count.
    emit_lines: i64,
}

fn emitter_new() -> Emitter {
    return Emitter {
        strings: string_list_empty(),
        const_names: string_list_empty(),
        const_exprs: expr_list_empty(),
        const_types: string_list_empty(),
        type_alias_names: string_list_empty(),
        type_alias_targets: string_list_empty(),
        struct_sigs: struct_sig_list_empty(),
        enum_sigs: enum_sig_list_empty(),
        func_sigs: func_sig_list_empty(),
        func_decls: function_list_empty(),
        impls: impl_decl_list_empty(),
        inst_func_names: string_list_empty(),
        inst_funcs: function_list_empty(),
        var_names: string_list_empty(),
        var_types: string_list_empty(),
        var_mut: bool_list_empty(),
        enum_var_names: string_list_empty(),
        enum_var_types: string_list_empty(),
        closure_names: string_list_empty(),
        closure_blocks: block_list_empty(),
        drop_live_names: string_list_empty(),
        drop_live_types: string_list_empty(),
        cur_ret_type: "unit",
        temp_id: 0,
        label_id: 0,
        break_labels: string_list_empty(),
        continue_labels: string_list_empty(),
        body: string_list_empty(),
        emit_lines: 0,
    }
}

fn emitter_with_globals(glob: &Emitter) -> Emitter {
    let mut e = emitter_new()
    e.strings = ast_string_list_clone(&glob.strings)
    e.const_names = ast_string_list_clone(&glob.const_names)
    e.const_exprs = clone_expr_list(&glob.const_exprs)
    e.const_types = ast_string_list_clone(&glob.const_types)
    e.type_alias_names = ast_string_list_clone(&glob.type_alias_names)
    e.type_alias_targets = ast_string_list_clone(&glob.type_alias_targets)
    e.struct_sigs = struct_sig_list_clone(&glob.struct_sigs)
    e.enum_sigs = enum_sig_list_clone(&glob.enum_sigs)
    e.func_sigs = func_sig_list_clone(&glob.func_sigs)
    e.func_decls = function_list_clone(&glob.func_decls)
    e.impls = impl_decl_list_clone(&glob.impls)
    e.inst_func_names = ast_string_list_clone(&glob.inst_func_names)
    e.inst_funcs = function_list_clone(&glob.inst_funcs)
    e.closure_names = string_list_empty()
    e.closure_blocks = block_list_empty()
    e.drop_live_names = string_list_empty()
    e.drop_live_types = string_list_empty()
    e.cur_ret_type = string_clone(&glob.cur_ret_type)
    e.enum_var_names = string_list_empty()
    e.enum_var_types = string_list_empty()
    return e
}

fn emit_line(e: &mut Emitter, line: String) {
    let mut body = e.body
    push(&mut body, line)
    e.body = body
    e.emit_lines = e.emit_lines + 1
}

fn mangle_name(name: &str) -> String {
    let mut out = ""
    let mut i = 0
    let n = str_len(&name)
    while i < n {
        let c = str_char_at(name, i)
        let is_alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        let is_digit = c >= '0' && c <= '9'
        if is_alpha || is_digit || c == '_' {
            out = out + str_substr(name, i, 1)
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    if out == "" { return "_" }
    return out
}

struct EnumCall {
    ok: bool,
    enum_name: String,
    variant: String,
}

fn enum_call_parse(name: &str) -> EnumCall {
    let mut dot = -1
    let mut i = 0
    let n = str_len(&name)
    while i < n {
        if str_char_at(name, i) == '.' {
            dot = i
            break
        }
        i = i + 1
    }
    if dot < 0 {
        return EnumCall { ok: false, enum_name: "", variant: "" }
    }
    let enum_name = str_substr(name, 0, dot)
    let variant = str_substr(name, dot + 1, n - dot - 1)
    return EnumCall { ok: true, enum_name: enum_name, variant: variant }
}

fn var_slot(name: &str) -> String {
    return "v_" + mangle_name(name)
}

fn int_to_string(n: i64) -> String {
    if n == 0 { return "0" }
    let mut v = n
    let mut neg = false
    if v < 0 {
        neg = true
        v = -v
    }
    let mut out = ""
    while v > 0 {
        let d = v % 10
        out = str_substr("0123456789", d, 1) + out
        v = v / 10
    }
    if neg { out = "-" + out }
    return out
}

fn temp_name(id: i64) -> String {
    return "%t" + int_to_string(id)
}

fn new_temp(e: &mut Emitter) -> i64 {
    let id = e.temp_id
    e.temp_id = id + 1
    return id
}

fn new_label(e: &mut Emitter, prefix: &str) -> String {
    let id = e.label_id
    e.label_id = id + 1
    return prefix + int_to_string(id)
}

fn push_break_label(e: &mut Emitter, label: String) {
    let mut ls = e.break_labels
    push(&mut ls, label)
    e.break_labels = ls
}

fn push_continue_label(e: &mut Emitter, label: String) {
    let mut ls = e.continue_labels
    push(&mut ls, label)
    e.continue_labels = ls
}

fn pop_break_label(e: &mut Emitter) {
    let n = len(&e.break_labels)
    if n == 0 { return }
    let mut ls = e.break_labels
    let mut out: [String] = []
    let mut i = 0
    while i < n - 1 {
        push(&mut out, ls[i])
        i = i + 1
    }
    e.break_labels = out
}

fn pop_continue_label(e: &mut Emitter) {
    let n = len(&e.continue_labels)
    if n == 0 { return }
    let mut ls = e.continue_labels
    let mut out: [String] = []
    let mut i = 0
    while i < n - 1 {
        push(&mut out, ls[i])
        i = i + 1
    }
    e.continue_labels = out
}

fn top_break_label(e: &Emitter) -> String {
    let n = len(&e.break_labels)
    if n == 0 { return "" }
    return string_clone(&e.break_labels[n - 1])
}

fn top_continue_label(e: &Emitter) -> String {
    let n = len(&e.continue_labels)
    if n == 0 { return "" }
    return string_clone(&e.continue_labels[n - 1])
}

fn emit_label(e: &mut Emitter, label: &str) {
    emit_line(e, "@" + label)
}

fn type_is_ref_raw(t: &str) -> bool {
    return string_has_prefix(t, "&")
}

fn type_is_mut_ref_raw(t: &str) -> bool {
    return string_has_prefix(t, "&mut ")
}

fn type_ref_base_raw(t: &str) -> String {
    if string_has_prefix(t, "&mut ") {
        let n = str_len(t)
        return substr(string_clone(t), 5, n - 5)
    }
    if string_has_prefix(t, "&") {
        let n = str_len(t)
        return substr(string_clone(t), 1, n - 1)
    }
    return string_clone(t)
}

fn type_is_array_raw(t: &str) -> bool {
    return string_has_prefix(t, "[")
}

fn type_array_elem_raw(t: &str) -> String {
    let n = str_len(t)
    if n <= 2 { return "i64" }
    return substr(string_clone(t), 1, n - 2)
}

struct TypeArgs {
    base: String,
    args: [String],
    has: bool,
}

fn type_args_parse(t: &str) -> TypeArgs {
    let n = str_len(t)
    let mut i = 0
    let mut idx = -1
    while i < n {
        if str_char_at(t, i) == '[' { idx = i; break }
        i = i + 1
    }
    if idx < 0 {
        return TypeArgs { base: string_clone(t), args: string_list_empty(), has: false }
    }
    let base = str_substr(t, 0, idx)
    let mut args: [String] = []
    let mut depth = 0
    let mut start = idx + 1
    let mut j = idx + 1
    while j < n {
        let c = str_char_at(t, j)
        if c == '[' { depth = depth + 1 }
        if c == ']' {
            if depth == 0 {
                let part = str_substr(t, start, j - start)
                if part != "" { push(&mut args, part) }
                break
            }
            depth = depth - 1
        } else if c == ',' && depth == 0 {
            let part = str_substr(t, start, j - start)
            if part != "" { push(&mut args, part) }
            start = j + 1
        }
        j = j + 1
    }
    return TypeArgs { base: base, args: args, has: true }
}

fn type_subst(e: &Emitter, t: &str, params: & [String], args: & [String]) -> String {
    if len(params) == 0 || len(args) == 0 { return string_clone(t) }
    let rt = type_resolve(e, t)
    if type_is_ref_raw(&rt) {
        let base = type_ref_base_raw(&rt)
        return "&" + type_subst(e, &base, params, args)
    }
    if type_is_array_raw(&rt) {
        let elem = type_array_elem_raw(&rt)
        return "[" + type_subst(e, &elem, params, args) + "]"
    }
    let parsed = type_args_parse(&rt)
    if parsed.has {
        let mut out_args: [String] = []
        let mut i = 0
        while i < len(&parsed.args) {
            push(&mut out_args, type_subst(e, &parsed.args[i], params, args))
            i = i + 1
        }
        let mut s = parsed.base + "["
        let mut j = 0
        while j < len(&out_args) {
            if j > 0 { s = s + "," }
            s = s + out_args[j]
            j = j + 1
        }
        s = s + "]"
        return s
    }
    let mut k = 0
    while k < len(params) {
        if rt == (*params)[k] {
            if (*args)[k] == "" { return rt }
            return string_clone(&(*args)[k])
        }
        k = k + 1
    }
    return rt
}

fn type_alias_index(e: &Emitter, name: &str) -> i64 {
    let mut i = 0
    while i < len(&e.type_alias_names) {
        if e.type_alias_names[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn type_resolve(e: &Emitter, t: &str) -> String {
    let cur = string_clone(t)
    if cur == "" { return cur }
    if cur == "string" {
        println("stage2: use String/str instead of string")
        exit(1)
    }
    if type_is_ref_raw(&cur) {
        let base = type_ref_base_raw(&cur)
        if type_is_mut_ref_raw(&cur) {
            return "&mut " + type_resolve(e, &base)
        }
        return "&" + type_resolve(e, &base)
    }
    if type_is_array_raw(&cur) {
        let elem = type_array_elem_raw(&cur)
        return "[" + type_resolve(e, &elem) + "]"
    }
    let mut out = cur
    let mut steps = 0
    while steps < 32 {
        let idx = type_alias_index(e, &out)
        if idx < 0 { return out }
        out = string_clone(&e.type_alias_targets[idx])
        steps = steps + 1
    }
    return out
}

fn type_is_bool(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "bool"
}

fn type_is_string(e: &Emitter, t: &str) -> bool {
    let rt = type_resolve(e, t)
    if type_is_ref_raw(&rt) {
        let base = type_ref_base_raw(&rt)
        return base == "String" || base == "str"
    }
    return rt == "String" || rt == "str"
}

fn type_is_unit(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "unit"
}

fn block_expr_type(e: &Emitter, b: &Block) -> String {
    let n = len(&b.stmts)
    if n == 0 { return "unit" }
    let last = &b.stmts[n - 1]
    if last.kind == STMT_EXPR { return expr_type(e, &last.expr) }
    return "unit"
}

fn type_is_i32(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "i32"
}

fn type_is_i64(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "i64"
}

fn type_is_int(e: &Emitter, t: &str) -> bool {
    return type_is_i32(e, t) || type_is_i64(e, t)
}

fn type_is_ref(e: &Emitter, t: &str) -> bool {
    let rt = type_resolve(e, t)
    return type_is_ref_raw(&rt)
}

fn type_is_mut_ref(e: &Emitter, t: &str) -> bool {
    let rt = type_resolve(e, t)
    return type_is_mut_ref_raw(&rt)
}

fn type_ref_base(e: &Emitter, t: &str) -> String {
    let rt = type_resolve(e, t)
    if type_is_ref_raw(&rt) { return type_ref_base_raw(&rt) }
    return rt
}

fn type_is_array(e: &Emitter, t: &str) -> bool {
    let rt = type_resolve(e, t)
    return type_is_array_raw(&rt)
}

fn type_array_elem(e: &Emitter, t: &str) -> String {
    let rt = type_resolve(e, t)
    if !type_is_array_raw(&rt) { return "i64" }
    return type_array_elem_raw(&rt)
}

fn type_strip_ref(e: &Emitter, t: &str) -> String {
    if type_is_ref(e, t) { return type_ref_base(e, t) }
    return type_resolve(e, t)
}

fn type_strip_args(e: &Emitter, t: &str) -> String {
    let rt = type_strip_ref(e, t)
    let mut i = 0
    let n = str_len(&rt)
    while i < n {
        if str_char_at(&rt, i) == '[' { return str_substr(&rt, 0, i) }
        i = i + 1
    }
    return rt
}

fn qbe_type(e: &Emitter, t: &str) -> String {
    if type_is_ref(e, t) { return "l" }
    if type_is_array(e, t) { return "l" }
    if type_is_bool(e, t) { return "w" }
    return "l"
}

fn store_op_for_type(e: &Emitter, t: &str) -> String {
    if type_is_ref(e, t) { return "storel" }
    if type_is_array(e, t) { return "storel" }
    if type_is_bool(e, t) { return "storew" }
    return "storel"
}

fn load_op_for_type(e: &Emitter, t: &str) -> String {
    if type_is_ref(e, t) { return "load" }
    if type_is_array(e, t) { return "load" }
    if type_is_bool(e, t) { return "loadw" }
    return "load"
}

fn list_index(items: & [String], name: &str) -> i64 {
    let mut i = 0
    while i < len(items) {
        if (*items)[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn const_index(e: &Emitter, name: &str) -> i64 {
    return list_index(&e.const_names, name)
}

fn var_index(e: &Emitter, name: &str) -> i64 {
    return list_index(&e.var_names, name)
}

fn enum_var_index(e: &Emitter, name: &str) -> i64 {
    return list_index(&e.enum_var_names, name)
}

fn enum_var_hint(e: &Emitter, name: &str) -> String {
    let idx = enum_var_index(e, name)
    if idx < 0 { return "" }
    return string_clone(&e.enum_var_types[idx])
}

fn enum_var_set(e: &mut Emitter, name: &str, typ: &str) {
    if name == "" { return }
    let idx = enum_var_index(e, name)
    if idx >= 0 {
        e.enum_var_types[idx] = string_clone(typ)
        return
    }
    let mut names = e.enum_var_names
    let mut types = e.enum_var_types
    push(&mut names, string_clone(name))
    push(&mut types, string_clone(typ))
    e.enum_var_names = names
    e.enum_var_types = types
}

fn struct_index(e: &Emitter, name: &str) -> i64 {
    let key = type_strip_args(e, name)
    let mut i = 0
    while i < len(&e.struct_sigs) {
        if e.struct_sigs[i].name == key { return i }
        i = i + 1
    }
    return -1
}

fn type_is_struct(e: &Emitter, t: &str) -> bool {
    return struct_index(e, t) >= 0
}

fn struct_field_index(e: &Emitter, struct_name: &str, field: &str) -> i64 {
    let si = struct_index(e, struct_name)
    if si < 0 { return -1 }
    let mut i = 0
    while i < len(&e.struct_sigs[si].fields) {
        if e.struct_sigs[si].fields[i].name == field { return i }
        i = i + 1
    }
    return -1
}

fn struct_field_type(e: &Emitter, struct_name: &str, field: &str) -> String {
    let si = struct_index(e, struct_name)
    if si < 0 { return "" }
    let fi = struct_field_index(e, struct_name, field)
    if fi < 0 { return "" }
    let mut ft = string_clone(&e.struct_sigs[si].fields[fi].typ)
    let sig = &e.struct_sigs[si]
    if len(&sig.type_params) > 0 {
        let base_name = type_strip_ref(e, struct_name)
        let parsed = type_args_parse(&base_name)
        if parsed.has && len(&parsed.args) == len(&sig.type_params) {
            ft = type_subst(e, &ft, &sig.type_params, &parsed.args)
        }
    }
    return type_resolve(e, &ft)
}

fn struct_field_count(e: &Emitter, struct_name: &str) -> i64 {
    let si = struct_index(e, struct_name)
    if si < 0 { return 0 }
    return len(&e.struct_sigs[si].fields)
}

fn enum_index(e: &Emitter, name: &str) -> i64 {
    let key = type_strip_args(e, name)
    let mut i = 0
    while i < len(&e.enum_sigs) {
        if e.enum_sigs[i].name == key { return i }
        i = i + 1
    }
    return -1
}

fn type_is_enum(e: &Emitter, t: &str) -> bool {
    return enum_index(e, t) >= 0
}

fn enum_tag_type(e: &Emitter, enum_name: &str) -> String {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return "i32" }
    let mut tt = string_clone(&e.enum_sigs[ei].tag_type)
    let sig = &e.enum_sigs[ei]
    if len(&sig.type_params) > 0 {
        let base_name = type_strip_ref(e, enum_name)
        let parsed = type_args_parse(&base_name)
        if parsed.has && len(&parsed.args) == len(&sig.type_params) {
            tt = type_subst(e, &tt, &sig.type_params, &parsed.args)
        }
    }
    tt = type_resolve(e, &tt)
    if tt == "" { return "i32" }
    return tt
}

fn enum_variant_index(e: &Emitter, enum_name: &str, variant: &str) -> i64 {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return -1 }
    let mut i = 0
    while i < len(&e.enum_sigs[ei].variants) {
        if e.enum_sigs[ei].variants[i].name == variant { return i }
        i = i + 1
    }
    return -1
}

fn enum_variant_value(e: &Emitter, enum_name: &str, variant: &str) -> i64 {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return -1 }
    let vi = enum_variant_index(e, enum_name, variant)
    if vi < 0 { return -1 }
    return e.enum_sigs[ei].variants[vi].value
}

fn enum_has_payload(e: &Emitter, enum_name: &str) -> bool {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return false }
    let mut i = 0
    while i < len(&e.enum_sigs[ei].variants) {
        if e.enum_sigs[ei].variants[i].has_payload { return true }
        i = i + 1
    }
    return false
}

fn enum_variant_has_payload(e: &Emitter, enum_name: &str, variant: &str) -> bool {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return false }
    let vi = enum_variant_index(e, enum_name, variant)
    if vi < 0 { return false }
    return e.enum_sigs[ei].variants[vi].has_payload
}

fn enum_name_for_variant(e: &Emitter, variant: &str) -> String {
    let mut i = 0
    while i < len(&e.enum_sigs) {
        let mut vi = 0
        while vi < len(&e.enum_sigs[i].variants) {
            if e.enum_sigs[i].variants[vi].name == variant {
                return string_clone(&e.enum_sigs[i].name)
            }
            vi = vi + 1
        }
        i = i + 1
    }
    return ""
}

fn enum_variant_payload_type(e: &Emitter, enum_name: &str, variant: &str) -> String {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return "i64" }
    let vi = enum_variant_index(e, enum_name, variant)
    if vi < 0 { return "i64" }
    let mut pt = string_clone(&e.enum_sigs[ei].variants[vi].payload_type)
    let sig = &e.enum_sigs[ei]
    if len(&sig.type_params) > 0 {
        let base_name = type_strip_ref(e, enum_name)
        let parsed = type_args_parse(&base_name)
        if parsed.has && len(&parsed.args) == len(&sig.type_params) {
            pt = type_subst(e, &pt, &sig.type_params, &parsed.args)
        }
    }
    if pt == "" { return "i64" }
    return type_resolve(e, &pt)
}

fn func_index(e: &Emitter, name: &str) -> i64 {
    let mut i = 0
    while i < len(&e.func_sigs) {
        if e.func_sigs[i].name == name { return i }
        i = i + 1
    }
    return -1
}

fn func_decl_index(e: &Emitter, name: &str) -> i64 {
    let mut i = 0
    while i < len(&e.func_decls) {
        if e.func_decls[i].name == name { return i }
        i = i + 1
    }
    return -1
}

fn func_ret_type(e: &Emitter, name: &str) -> String {
    let idx = func_index(e, name)
    if idx < 0 { return "i64" }
    return string_clone(&e.func_sigs[idx].ret_type)
}

fn bind_type_params(e: &Emitter, pat: &str, act: &str, params: & [String], values: &mut [String]) {
    if len(params) == 0 { return }
    let pat_rt = string_clone(pat)
    let act_rt = type_resolve(e, act)
    if type_is_ref_raw(&pat_rt) && type_is_ref_raw(&act_rt) {
        let pb = type_ref_base_raw(&pat_rt)
        let ab = type_ref_base_raw(&act_rt)
        bind_type_params(e, &pb, &ab, params, values)
        return
    }
    if type_is_array_raw(&pat_rt) && type_is_array_raw(&act_rt) {
        let pe = type_array_elem_raw(&pat_rt)
        let ae = type_array_elem_raw(&act_rt)
        bind_type_params(e, &pe, &ae, params, values)
        return
    }
    let pat_args = type_args_parse(&pat_rt)
    let act_args = type_args_parse(&act_rt)
    if pat_args.has {
        if act_args.has && pat_args.base == act_args.base && len(&pat_args.args) == len(&act_args.args) {
            let mut i = 0
            while i < len(&pat_args.args) {
                bind_type_params(e, &pat_args.args[i], &act_args.args[i], params, values)
                i = i + 1
            }
        }
        return
    }
    let idx = list_index(&params, &pat_rt)
    if idx >= 0 {
        if (*values)[idx] == "" {
            (*values)[idx] = act_rt
        }
    }
}

fn func_ret_type_for_call(e: &Emitter, name: &str, args: & [Expr]) -> String {
    let di = func_decl_index(e, name)
    if di < 0 { return func_ret_type(e, name) }
    let f = &e.func_decls[di]
    if len(&f.type_params) == 0 { return func_ret_type(e, name) }
    let mut params: [String] = []
    let mut pi = 0
    while pi < len(&f.type_params) {
        push(&mut params, string_clone(&f.type_params[pi].name))
        pi = pi + 1
    }
    let mut values: [String] = []
    let mut vi = 0
    while vi < len(&params) {
        push(&mut values, "")
        vi = vi + 1
    }
    let mut ai = 0
    while ai < len(&f.params) && ai < len(args) {
        let p = &f.params[ai]
        if p.has_type {
            let at = expr_type(e, &(*args)[ai])
            bind_type_params(e, &p.typ, &at, &params, &mut values)
        }
        ai = ai + 1
    }
    let rt = type_subst(e, &f.ret_type, &params, &values)
    return type_resolve(e, &rt)
}

fn func_type_param_names(f: &Function) -> [String] {
    let mut params: [String] = []
    let mut i = 0
    while i < len(&f.type_params) {
        push(&mut params, string_clone(&f.type_params[i].name))
        i = i + 1
    }
    return params
}

fn impl_type_param_names(imp: &ImplDecl) -> [String] {
    let mut params: [String] = []
    let mut i = 0
    while i < len(&imp.type_params) {
        push(&mut params, string_clone(&imp.type_params[i].name))
        i = i + 1
    }
    return params
}

fn type_matches_pattern(e: &Emitter, pat: &str, act: &str, params: & [String]) -> bool {
    let pat_rt = string_clone(pat)
    let act_rt = type_resolve(e, act)
    if type_is_ref_raw(&pat_rt) {
        if !type_is_ref_raw(&act_rt) { return false }
        let pb = type_ref_base_raw(&pat_rt)
        let ab = type_ref_base_raw(&act_rt)
        return type_matches_pattern(e, &pb, &ab, params)
    }
    if type_is_array_raw(&pat_rt) {
        if !type_is_array_raw(&act_rt) { return false }
        let pe = type_array_elem_raw(&pat_rt)
        let ae = type_array_elem_raw(&act_rt)
        return type_matches_pattern(e, &pe, &ae, params)
    }
    let pat_args = type_args_parse(&pat_rt)
    let act_args = type_args_parse(&act_rt)
    if pat_args.has {
        if !act_args.has { return false }
        if pat_args.base != act_args.base { return false }
        if len(&pat_args.args) != len(&act_args.args) { return false }
        let mut i = 0
        while i < len(&pat_args.args) {
            if !type_matches_pattern(e, &pat_args.args[i], &act_args.args[i], params) { return false }
            i = i + 1
        }
        return true
    }
    if list_index(params, &pat_rt) >= 0 { return true }
    return type_resolve(e, &pat_rt) == act_rt
}

fn impl_has_trait(e: &Emitter, trait_name: &str, for_type: &str) -> bool {
    let mut i = 0
    while i < len(&e.impls) {
        let imp = &e.impls[i]
        if imp.trait_name == trait_name {
            let pat_res = type_resolve(e, &imp.for_type)
            let act_res = type_resolve(e, for_type)
            if pat_res == act_res { return true }
            let params = impl_type_param_names(imp)
            if type_matches_pattern(e, &imp.for_type, for_type, &params) { return true }
            let pb = type_strip_args(e, &imp.for_type)
            let ab = type_strip_args(e, for_type)
            if pb != "" && pb == ab { return true }
        }
        i = i + 1
    }
    return false
}

fn check_type_param_bounds(e: &Emitter, f: &Function, values: & [String]) {
    let mut i = 0
    while i < len(&f.type_params) {
        let tp = &f.type_params[i]
        if tp.has_bound {
            if i >= len(values) || (*values)[i] == "" {
                println("stage2: cannot infer type for", tp.name)
                exit(1)
            }
            let val = &(*values)[i]
            if !impl_has_trait(e, &tp.bound, val) {
                println("stage2: type", val, "does not implement trait", tp.bound)
                exit(1)
            }
        }
        i = i + 1
    }
}

fn func_type_args_for_call(e: &Emitter, f: &Function, args: & [Expr]) -> [String] {
    let params = func_type_param_names(f)
    let mut values: [String] = []
    let mut vi = 0
    while vi < len(&params) {
        push(&mut values, "")
        vi = vi + 1
    }
    let mut ai = 0
    while ai < len(&f.params) && ai < len(args) {
        let p = &f.params[ai]
        if p.has_type {
            let at = expr_type(e, &(*args)[ai])
            bind_type_params(e, &p.typ, &at, &params, &mut values)
        }
        ai = ai + 1
    }
    check_type_param_bounds(e, f, &values)
    return values
}

fn func_inst_name(base: &str, values: & [String]) -> String {
    let mut out = string_clone(base) + "["
    let mut i = 0
    while i < len(values) {
        if i > 0 { out = out + ", " }
        out = out + (*values)[i]
        i = i + 1
    }
    out = out + "]"
    return out
}

fn ensure_inst_func(e: &mut Emitter, f: &Function, values: & [String]) -> String {
    let inst_name = func_inst_name(&f.name, values)
    if list_index(&e.inst_func_names, &inst_name) >= 0 { return inst_name }
    let mut inst = function_clone(f)
    inst.name = string_clone(&inst_name)
    let mut empty_params: [GenericParam] = []
    inst.type_params = empty_params
    let params = func_type_param_names(f)
    let mut pi = 0
    while pi < len(&inst.params) {
        let p = &inst.params[pi]
        if p.has_type {
            let nt = type_subst(e, &p.typ, &params, &values)
            inst.params[pi] = Param { name: string_clone(&p.name), typ: nt, has_type: true }
        }
        pi = pi + 1
    }
    inst.ret_type = type_subst(e, &inst.ret_type, &params, &values)
    let mut names = e.inst_func_names
    let mut funcs = e.inst_funcs
    push(&mut names, string_clone(&inst_name))
    push(&mut funcs, inst)
    e.inst_func_names = names
    e.inst_funcs = funcs
    return inst_name
}

fn func_param_types_for_call(e: &Emitter, f: &Function, values: & [String]) -> [String] {
    let params = func_type_param_names(f)
    let mut out: [String] = []
    let mut i = 0
    while i < len(&f.params) {
        let p = &f.params[i]
        if p.has_type {
            let mut t = string_clone(&p.typ)
            if len(values) > 0 {
                t = type_subst(e, &t, &params, &values)
            }
            push(&mut out, type_resolve(e, &t))
        } else {
            push(&mut out, "")
        }
        i = i + 1
    }
    return out
}

fn emit_auto_borrow(e: &mut Emitter, inner: &Expr, expected_ref: &str) -> QbeValue {
    let base_t = type_ref_base(e, expected_ref)
    let mut ref_t = "&" + string_clone(&base_t)
    let want_mut = type_is_mut_ref_raw(expected_ref)
    if want_mut {
        ref_t = "&mut " + string_clone(&base_t)
    }
    if want_mut {
        check_ref_target(e, inner, true)
    }
    if inner.kind == EXPR_IDENT {
        let name = string_clone(&inner.name)
        if var_index(e, &name) >= 0 {
            return qbe_value(ref_t, "%" + var_slot(&name))
        }
    }
    let v = emit_expr(e, inner)
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    emit_line(e, "  " + tn + " =l alloc8 8")
    let casted = cast_to_type(e, v, &base_t)
    let op = store_op_for_type(e, &base_t)
    emit_line(e, "  " + op + " " + casted + ", " + tn)
    return qbe_value(ref_t, tn)
}

fn const_type(e: &Emitter, name: &str) -> String {
    let idx = const_index(e, name)
    if idx < 0 { return "" }
    return string_clone(&e.const_types[idx])
}

fn var_type(e: &Emitter, name: &str) -> String {
    let idx = var_index(e, name)
    if idx < 0 { return "" }
    return string_clone(&e.var_types[idx])
}

fn var_is_mut(e: &Emitter, name: &str) -> bool {
    let idx = var_index(e, name)
    if idx < 0 { return false }
    if idx >= len(&e.var_mut) { return false }
    return e.var_mut[idx]
}

fn closure_index(e: &Emitter, name: &str) -> i64 {
    let mut i = 0
    while i < len(&e.closure_names) {
        if e.closure_names[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn closure_add(e: &mut Emitter, name: &str, body: &Block) {
    if name == "" { return }
    if closure_index(e, name) >= 0 { return }
    let mut names = e.closure_names
    let mut blocks = e.closure_blocks
    push(&mut names, string_clone(name))
    push(&mut blocks, block_clone(body))
    e.closure_names = names
    e.closure_blocks = blocks
}

fn drop_live_index(e: &Emitter, name: &str) -> i64 {
    let mut i = 0
    while i < len(&e.drop_live_names) {
        if e.drop_live_names[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn drop_needs_drop_type_env(e: &Emitter, t: &str) -> bool {
    let rt = type_resolve(e, t)
    if type_is_ref(e, &rt) { return false }
    if drop_needs_drop_type(string_clone(&rt)) { return true }
    if type_is_struct(e, &rt) { return true }
    if type_is_enum(e, &rt) && enum_has_payload(e, &rt) { return true }
    return false
}

fn drop_fn_for_type(e: &Emitter, t: &str) -> String {
    let rt = type_resolve(e, t)
    if rt == "String" { return "dast_string_free" }
    if drop_is_array_type_name(string_clone(&rt)) { return "dast_array_free" }
    if type_is_struct(e, &rt) { return "dast_struct_free" }
    if type_is_enum(e, &rt) && enum_has_payload(e, &rt) { return "dast_struct_free" }
    return ""
}

fn drop_emit_for_slot(e: &mut Emitter, name: &str, typ: &str) {
    if !drop_needs_drop_type_env(e, typ) { return }
    let fn_name = drop_fn_for_type(e, typ)
    if fn_name == "" { return }
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, typ)
    emit_line(e, "  " + tn + " =l " + op + " %" + var_slot(name))
    emit_line(e, "  call $" + fn_name + "(l " + tn + ")")
}

fn drop_live_remove(e: &mut Emitter, name: &str) {
    let idx = drop_live_index(e, name)
    if idx < 0 { return }
    let mut names: [String] = []
    let mut types: [String] = []
    let mut i = 0
    while i < len(&e.drop_live_names) {
        if i != idx {
            push(&mut names, e.drop_live_names[i])
            push(&mut types, e.drop_live_types[i])
        }
        i = i + 1
    }
    e.drop_live_names = names
    e.drop_live_types = types
}

fn drop_live_set(e: &mut Emitter, name: &str, typ: &str) {
    if !drop_needs_drop_type_env(e, typ) { return }
    let idx = drop_live_index(e, name)
    if idx >= 0 {
        let mut types = e.drop_live_types
        types[idx] = string_clone(typ)
        e.drop_live_types = types
        return
    }
    let mut names = e.drop_live_names
    let mut types = e.drop_live_types
    push(&mut names, string_clone(name))
    push(&mut types, string_clone(typ))
    e.drop_live_names = names
    e.drop_live_types = types
}

fn drop_live_drop_existing(e: &mut Emitter, name: &str) {
    let idx = drop_live_index(e, name)
    if idx < 0 { return }
    let typ = string_clone(&e.drop_live_types[idx])
    drop_emit_for_slot(e, name, &typ)
    drop_live_remove(e, name)
}

fn drop_live_remove_returned_expr(e: &mut Emitter, expr: &Expr) {
    if expr.kind == EXPR_IDENT {
        drop_live_remove(e, &expr.name)
    }
}

fn drop_live_drop_all(e: &mut Emitter) {
    let mut i = 0
    while i < len(&e.drop_live_names) {
        let name = string_clone(&e.drop_live_names[i])
        let typ = string_clone(&e.drop_live_types[i])
        drop_emit_for_slot(e, &name, &typ)
        i = i + 1
    }
    e.drop_live_names = string_list_empty()
    e.drop_live_types = string_list_empty()
}

fn ensure_string(e: &mut Emitter, s: String) -> i64 {
    let mut i = 0
    while i < len(&e.strings) {
        if e.strings[i] == string_clone(&s) { return i }
        i = i + 1
    }
    let id = len(&e.strings)
    let mut strings = e.strings
    push(&mut strings, s)
    e.strings = strings
    return id
}

fn str_data_label(id: i64) -> String {
    return "str_data_" + int_to_string(id)
}

fn str_struct_label(id: i64) -> String {
    return "str_" + int_to_string(id)
}

fn string_data_ptr(e: &mut Emitter, s: &str) -> String {
    let id = ensure_string(e, string_clone(s))
    return "$" + str_data_label(id)
}

fn escape_qbe_string(s: &str) -> String {
    let mut out = ""
    let mut i = 0
    let n = str_len(&s)
    while i < n {
        let c = str_char_at(s, i)
        if c == '\n' { out = out + "\\n" }
        else if c == '\r' { out = out + "\\r" }
        else if c == '\t' { out = out + "\\t" }
        else if c == '\\' { out = out + "\\\\" }
        else if c == '"' { out = out + "\\\"" }
        else { out = out + str_substr(s, i, 1) }
        i = i + 1
    }
    return out
}

fn expr_type(e: &Emitter, expr: &Expr) -> String {
    match expr.kind {
        EXPR_INT => { return "i64" }
        EXPR_CHAR => { return "i64" }
        EXPR_BOOL => { return "bool" }
        EXPR_STRING => { return "String" }
        EXPR_IDENT => {
            let ct = const_type(e, &expr.name)
            if ct != "" { return ct }
            let vt = var_type(e, &expr.name)
            if vt != "" { return vt }
            return "i64"
        }
        EXPR_STRUCT_LIT => {
            return type_resolve(e, &expr.name)
        }
        EXPR_REF => {
            if len(&expr.args) == 0 { return "&i64" }
            let base = expr_type(e, expr_arg_ref(expr, 0, "expr_type_ref"))
            if expr.ref_mut {
                return "&mut " + type_resolve(e, &base)
            }
            return "&" + type_resolve(e, &base)
        }
        EXPR_DEREF => {
            if len(&expr.args) == 0 { return "i64" }
            let base = expr_type(e, expr_arg_ref(expr, 0, "expr_type_deref"))
            if type_is_ref(e, &base) { return type_ref_base(e, &base) }
            return type_resolve(e, &base)
        }
        EXPR_ARRAY => {
            if len(&expr.args) == 0 { return "[i64]" }
            let elem = expr_type(e, expr_arg_ref(expr, 0, "expr_type_array"))
            return "[" + type_resolve(e, &elem) + "]"
        }
        EXPR_INDEX => {
            if len(&expr.args) < 1 { return "i64" }
            let mut recv_t = expr_type(e, expr_arg_ref(expr, 0, "expr_type_index_recv"))
            if type_is_ref(e, &recv_t) { recv_t = type_ref_base(e, &recv_t) }
            if type_is_array(e, &recv_t) { return type_array_elem(e, &recv_t) }
            return "i64"
        }
        EXPR_CLOSURE => {
            return "unit"
        }
        EXPR_BLOCK => {
            let n = len(&expr.block.stmts)
            if n == 0 { return "unit" }
            let last = &expr.block.stmts[n - 1]
            if last.kind == STMT_EXPR { return expr_type(e, &last.expr) }
            return "unit"
        }
        EXPR_MATCH => {
            let mut out = ""
            let mut i = 0
            while i < len(&expr.match_arms) {
                let arm = &expr.match_arms[i]
                let bt = block_expr_type(e, &arm.block)
                if out == "" { out = bt }
                else {
                    let a = type_resolve(e, &out)
                    let b = type_resolve(e, &bt)
                    if a != b {
                        println("stage2: match arms must have same type:", a, "vs", b)
                        exit(1)
                    }
                }
                i = i + 1
            }
            if out == "" { return "unit" }
            return out
        }
        EXPR_FIELD => {
            if len(&expr.args) == 0 { return "i64" }
            if is_digit_str(&expr.name) {
                let mut recv_t = expr_type(e, expr_arg_ref(expr, 0, "expr_type_field_digit"))
                if type_is_ref(e, &recv_t) { recv_t = type_ref_base(e, &recv_t) }
                if type_is_array(e, &recv_t) { return type_array_elem(e, &recv_t) }
                return "i64"
            }
            let recv_expr = expr_arg_ref(expr, 0, "expr_type_field_recv_expr")
            if recv_expr.kind == EXPR_IDENT {
                let recv_name = type_resolve(e, &recv_expr.name)
                let ct = const_type(e, &recv_name)
                let vt = var_type(e, &recv_name)
                if ct == "" && vt == "" && type_is_enum(e, &recv_name) {
                    let vi = enum_variant_index(e, &recv_name, &expr.name)
                    if vi >= 0 { return recv_name }
                }
            }
            let mut recv_t = expr_type(e, expr_arg_ref(expr, 0, "expr_type_field_recv"))
            if type_is_ref(e, &recv_t) { recv_t = type_ref_base(e, &recv_t) }
            let ft = struct_field_type(e, &recv_t, &expr.name)
            if ft != "" { return type_resolve(e, &ft) }
            return "i64"
        }
        EXPR_BINARY => {
            if expr.name == "==" || expr.name == "<" || expr.name == ">" { return "bool" }
            if len(&expr.args) > 0 { return expr_type(e, expr_arg_ref(expr, 0, "expr_type_binary_lhs")) }
            return "i64"
        }
        EXPR_CALL => {
            if expr.name == "print" || expr.name == "println" { return "unit" }
            if expr.name == "len" {
                if len(&expr.args) != 1 {
                    println("stage2: len expects 1 argument")
                    exit(1)
                }
                let t = expr_type(e, expr_arg_ref(expr, 0, "expr_type_len_arg"))
                if !type_is_ref(e, &t) {
                    println("stage2: len expects reference to String/str or array")
                    exit(1)
                }
                let base = type_ref_base(e, &t)
                if !type_is_string(e, &base) && !type_is_array(e, &base) {
                    println("stage2: len expects reference to String/str or array")
                    exit(1)
                }
                return "i64"
            }
            let ec = enum_call_parse(&expr.name)
            if ec.ok { return ec.enum_name }
            let rt = func_ret_type_for_call(e, &expr.name, &expr.args)
            return type_resolve(e, &rt)
        }
        EXPR_MACRO_CALL => { return "unit" }
        EXPR_QUOTE => { return "unit" }
        _ => { return "i64" }
    }
}

fn collect_type_aliases(e: &mut Emitter, prog: &Program) {
    let mut names = string_list_empty()
    let mut targets = string_list_empty()
    let mut i = 0
    while i < len(&prog.type_aliases) {
        let a = &prog.type_aliases[i]
        push(&mut names, string_clone(&a.name))
        push(&mut targets, string_clone(&a.target))
        i = i + 1
    }
    e.type_alias_names = names
    e.type_alias_targets = targets
    // Resolve alias targets after the table is populated.
    let mut j = 0
    while j < len(&e.type_alias_targets) {
        e.type_alias_targets[j] = type_resolve(e, &e.type_alias_targets[j])
        j = j + 1
    }
}

fn collect_structs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.structs) {
        let s = &prog.structs[i]
        let mut tparams: [String] = []
        let mut tp = 0
        while tp < len(&s.type_params) {
            push(&mut tparams, string_clone(&s.type_params[tp].name))
            tp = tp + 1
        }
        let mut fields = struct_field_sig_list_empty()
        let mut fi = 0
        while fi < len(&s.fields) {
            let f = &s.fields[fi]
            push(&mut fields, StructFieldSig { name: string_clone(&f.name), typ: type_resolve(e, &f.typ) })
            fi = fi + 1
        }
        let mut sigs = e.struct_sigs
        push(&mut sigs, StructSig { name: string_clone(&s.name), type_params: tparams, fields: fields })
        e.struct_sigs = sigs
        i = i + 1
    }
}

fn collect_enums(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.enums) {
        let en = &prog.enums[i]
        let mut tparams: [String] = []
        let mut tp = 0
        while tp < len(&en.type_params) {
            push(&mut tparams, string_clone(&en.type_params[tp].name))
            tp = tp + 1
        }
        let mut variants = enum_variant_sig_list_empty()
        let mut vi = 0
        while vi < len(&en.variants) {
            let v = &en.variants[vi]
            push(&mut variants, EnumVariantSig { name: string_clone(&v.name), value: vi, has_payload: v.has_payload, payload_type: type_resolve(e, &v.payload_type) })
            vi = vi + 1
        }
        let mut sigs = e.enum_sigs
        push(&mut sigs, EnumSig { name: string_clone(&en.name), type_params: tparams, tag_type: type_resolve(e, &en.tag_type), variants: variants })
        e.enum_sigs = sigs
        i = i + 1
    }
}

fn collect_funcs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.functions) {
        let f = &prog.functions[i]
        if f.is_macro { i = i + 1; continue }
        let mut sigs = e.func_sigs
        let mut decls = e.func_decls
        let rt = effective_ret_type(e, f)
        push(&mut sigs, FuncSig { name: string_clone(&f.name), ret_type: rt })
        push(&mut decls, function_clone(f))
        e.func_sigs = sigs
        e.func_decls = decls
        i = i + 1
    }
}

fn collect_impls(e: &mut Emitter, prog: &Program) {
    e.impls = impl_decl_list_clone(&prog.impls)
}

fn collect_consts(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.consts) {
        let c = &prog.consts[i]
        let mut ct = expr_type(e, &c.expr)
        if c.has_type { ct = string_clone(&c.typ) }
        let mut names = e.const_names
        let mut exprs = e.const_exprs
        let mut types = e.const_types
        push(&mut names, string_clone(&c.name))
        push(&mut exprs, expr_clone(&c.expr))
        push(&mut types, ct)
        e.const_names = names
        e.const_exprs = exprs
        e.const_types = types
        i = i + 1
    }
}

fn collect_vars_from_block(e: &mut Emitter, b: &Block) {
    collect_vars_from_stmts(e, &b.stmts)
}

fn collect_vars_from_expr(e: &mut Emitter, expr: &Expr) {
    if expr.kind == EXPR_BLOCK {
        collect_vars_from_block(e, &expr.block)
        return
    }
    if expr.kind == EXPR_CLOSURE {
        return
    }
    if expr.kind == EXPR_MATCH {
        if len(&expr.args) > 0 {
            collect_vars_from_expr(e, expr_arg_ref(expr, 0, "collect_vars_field_recv"))
        }
        let enum_t = if len(&expr.args) > 0 { expr_type(e, expr_arg_ref(expr, 0, "collect_vars_enum_recv")) } else { "" }
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            let a = &expr.match_arms[ai]
            if a.has_binding && a.pat_kind == PAT_VARIANT {
                let mut bt = "i64"
                if type_is_enum(e, &enum_t) {
                    bt = enum_variant_payload_type(e, &enum_t, &a.variant)
                }
                collect_var_add(e, &a.binding, bt, false)
            } else if a.pat_kind == PAT_STRUCT {
                let st_name = type_strip_ref(e, &enum_t)
                if !type_is_struct(e, &st_name) {
                    println("stage2: struct pattern requires struct scrutinee")
                    exit(1)
                }
                if a.struct_name != "" && a.struct_name != st_name {
                    println("stage2: struct pattern type mismatch", a.struct_name, "vs", st_name)
                    exit(1)
                }
                let mut fi = 0
                while fi < len(&a.struct_fields) {
                    let f = &a.struct_fields[fi]
                    if f.has_binding {
                        let ftyp = struct_field_type(e, &st_name, &f.name)
                        if ftyp == "" {
                            println("stage2: unknown struct field", f.name)
                            exit(1)
                        }
                        collect_var_add(e, &f.binding, ftyp, false)
                    }
                    fi = fi + 1
                }
            }
            collect_vars_from_block(e, &a.block)
            ai = ai + 1
        }
        return
    }
    let mut i = 0
    while i < len(&expr.args) {
        collect_vars_from_expr(e, expr_arg_ref(expr, i, "collect_vars_arg"))
        i = i + 1
    }
    let mut fi = 0
    while fi < len(&expr.fields) {
        let f = &expr.fields[fi]
        collect_vars_from_expr(e, &f.value)
        fi = fi + 1
    }
}

fn collect_var_add(e: &mut Emitter, name: &str, typ: &str, mutable: bool) {
    if name == "" { return }
    if var_index(e, name) >= 0 { return }
    let mut names = e.var_names
    let mut types = e.var_types
    let mut muts = e.var_mut
    push(&mut names, string_clone(name))
    push(&mut types, string_clone(typ))
    push(&mut muts, mutable)
    e.var_names = names
    e.var_types = types
    e.var_mut = muts
}

fn validate_expr_args(expr: &Expr, ctx: &str) {
    let n = len(&expr.args)
    if expr.kind == EXPR_REF || expr.kind == EXPR_DEREF || expr.kind == EXPR_FIELD || expr.kind == EXPR_MATCH {
        if n < 1 {
            println("stage2: bad expr args", expr.kind, "len", n, expr.name, ctx)
            exit(1)
        }
    }
    if expr.kind == EXPR_INDEX || expr.kind == EXPR_BINARY {
        if n < 2 {
            println("stage2: bad expr args", expr.kind, "len", n, expr.name, ctx)
            exit(1)
        }
    }
    let mut i = 0
    while i < n {
        validate_expr_args(expr_arg_ref(expr, i, "validate_expr_arg"), ctx)
        i = i + 1
    }
    let mut fi = 0
    while fi < len(&expr.fields) {
        validate_expr_args(&expr.fields[fi].value, ctx)
        fi = fi + 1
    }
    if expr.kind == EXPR_BLOCK || expr.kind == EXPR_CLOSURE {
        validate_block_args(&expr.block, ctx)
    }
    if expr.kind == EXPR_MATCH {
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            validate_block_args(&expr.match_arms[ai].block, ctx)
            ai = ai + 1
        }
    }
}

fn validate_stmt_args(stmt: &Stmt, ctx: &str) {
    if stmt.kind == STMT_LET || stmt.kind == STMT_EXPR || stmt.kind == STMT_RETURN || stmt.kind == STMT_ASSIGN {
        validate_expr_args(&stmt.expr, ctx)
        return
    }
    if stmt.kind == STMT_IF || stmt.kind == STMT_WHILE || stmt.kind == STMT_LOOP {
        validate_expr_args(&stmt.expr, ctx)
        validate_block_args(&stmt.block, ctx)
        if stmt.has_else { validate_block_args(&stmt.else_block, ctx) }
        return
    }
    if stmt.kind == STMT_IFLET || stmt.kind == STMT_MATCH {
        validate_expr_args(&stmt.expr, ctx)
        let mut ai = 0
        while ai < len(&stmt.arms) {
            validate_block_args(&stmt.arms[ai].block, ctx)
            ai = ai + 1
        }
        if stmt.kind == STMT_IFLET && stmt.has_else { validate_block_args(&stmt.else_block, ctx) }
        return
    }
}

fn validate_block_args(b: &Block, ctx: &str) {
    let mut i = 0
    while i < len(&b.stmts) {
        validate_stmt_args(&b.stmts[i], ctx)
        i = i + 1
    }
}

fn collect_vars_from_stmts(e: &mut Emitter, items: & [Stmt]) {
    let mut i = 0
    while i < len(items) {
        let s = &(*items)[i]
        if s.kind == STMT_LET {
            if s.name != "" {
                let expr = &s.expr
                let mut typ = expr_type(e, expr)
                if !s.has_type && expr.kind == EXPR_CALL {
                    let ec = enum_call_parse(&expr.name)
                    if ec.ok {
                        if type_is_enum(e, &ec.enum_name) { typ = ec.enum_name }
                        else if typ == "i64" || typ == "" { typ = ec.enum_name }
                        enum_var_set(e, &s.name, &ec.enum_name)
                    }
                }
                if s.has_type {
                    let declared = type_resolve(e, &s.typ)
                    let actual = type_resolve(e, &typ)
                    if declared != "" && actual != "" && declared != actual {
                        let mut ok = false
                        if type_is_int(e, &declared) && type_is_int(e, &actual) { ok = true }
                        if type_is_array(e, &declared) && type_is_array(e, &actual) {
                            let de = type_array_elem(e, &declared)
                            let ae = type_array_elem(e, &actual)
                            if type_is_int(e, &de) && type_is_int(e, &ae) { ok = true }
                        }
                        let db = type_strip_args(e, &declared)
                        let ab = type_strip_args(e, &actual)
                        if db != "" && db == ab { ok = true }
                        if !ok {
                            println("stage2: let type mismatch expected", declared, "got", actual)
                            exit(1)
                        }
                    }
                    typ = declared
                }
                collect_var_add(e, &s.name, &typ, s.mutable)
            }
            collect_vars_from_expr(e, &s.expr)
        }
        if s.kind == STMT_IF {
            collect_vars_from_expr(e, &s.expr)
            collect_vars_from_block(e, &s.block)
            if s.has_else { collect_vars_from_block(e, &s.else_block) }
        } else if s.kind == STMT_IFLET {
            collect_vars_from_expr(e, &s.expr)
            if s.pat_has_binding {
                let mut enum_t = expr_type(e, &s.expr)
                if !type_is_enum(e, &enum_t) && s.expr.kind == EXPR_IDENT {
                    let hint = enum_var_hint(e, &s.expr.name)
                    if hint != "" { enum_t = hint }
                }
                if !type_is_enum(e, &enum_t) && enum_t == "" {
                    let guess = enum_name_for_variant(e, &s.pat_variant)
                    if guess != "" { enum_t = guess }
                }
                let mut bt = "i64"
                if type_is_enum(e, &enum_t) {
                    bt = enum_variant_payload_type(e, &enum_t, &s.pat_variant)
                }
                collect_var_add(e, &s.pat_binding, bt, false)
            }
            collect_vars_from_block(e, &s.block)
            if s.has_else { collect_vars_from_block(e, &s.else_block) }
        } else if s.kind == STMT_MATCH {
            collect_vars_from_expr(e, &s.expr)
            let enum_t = expr_type(e, &s.expr)
            let mut ai = 0
            while ai < len(&s.arms) {
                let a = &s.arms[ai]
                if a.has_binding && a.pat_kind == PAT_VARIANT {
                    let mut bt = "i64"
                    if type_is_enum(e, &enum_t) {
                        bt = enum_variant_payload_type(e, &enum_t, &a.variant)
                    }
                    collect_var_add(e, &a.binding, bt, false)
                } else if a.pat_kind == PAT_STRUCT {
                    let st_name = type_strip_ref(e, &enum_t)
                    if !type_is_struct(e, &st_name) {
                        println("stage2: struct pattern requires struct scrutinee")
                        exit(1)
                    }
                    if a.struct_name != "" && a.struct_name != st_name {
                        println("stage2: struct pattern type mismatch", a.struct_name, "vs", st_name)
                        exit(1)
                    }
                    let mut fi = 0
                    while fi < len(&a.struct_fields) {
                        let f = &a.struct_fields[fi]
                        if f.has_binding {
                            let ftyp = struct_field_type(e, &st_name, &f.name)
                            if ftyp == "" {
                                println("stage2: unknown struct field", f.name)
                                exit(1)
                            }
                            collect_var_add(e, &f.binding, ftyp, false)
                        }
                        fi = fi + 1
                    }
                }
                collect_vars_from_block(e, &a.block)
                ai = ai + 1
            }
        } else if s.kind == STMT_WHILE || s.kind == STMT_LOOP {
            collect_vars_from_expr(e, &s.expr)
            collect_vars_from_block(e, &s.block)
        } else if s.kind == STMT_ASSIGN {
            collect_vars_from_expr(e, &s.lhs)
            collect_vars_from_expr(e, &s.expr)
        } else if s.kind == STMT_RETURN && s.ret_has_value {
            collect_vars_from_expr(e, &s.expr)
        } else if s.kind == STMT_BREAK_VALUE {
            collect_vars_from_expr(e, &s.expr)
        } else if s.kind == STMT_EXPR {
            collect_vars_from_expr(e, &s.expr)
        }
        i = i + 1
    }
}

fn collect_vars(e: &mut Emitter, f: &Function) {
    let mut pi = 0
    while pi < len(&f.params) {
        let p = &f.params[pi]
        let pname = &p.name
        let mut ptyp = "i64"
        if p.has_type { ptyp = string_clone(&p.typ) }
        if var_index(e, pname) < 0 {
            let mut names = e.var_names
            let mut types = e.var_types
            let mut muts = e.var_mut
            push(&mut names, string_clone(pname))
            push(&mut types, ptyp)
            push(&mut muts, false)
            e.var_names = names
            e.var_types = types
            e.var_mut = muts
        }
        pi = pi + 1
    }
    collect_vars_from_block(e, &f.body)
}

fn collect_strings_from_expr(e: &mut Emitter, expr: &Expr) {
    if expr.kind == EXPR_BLOCK {
        collect_strings_from_block(e, &expr.block)
        return
    }
    if expr.kind == EXPR_CLOSURE {
        collect_strings_from_block(e, &expr.block)
        return
    }
    if expr.kind == EXPR_MATCH {
        if len(&expr.args) > 0 {
            collect_strings_from_expr(e, expr_arg_ref(expr, 0, "collect_strings_field_recv"))
        }
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            collect_strings_from_block(e, &expr.match_arms[ai].block)
            ai = ai + 1
        }
        return
    }
    if expr.kind == EXPR_STRING {
        let _ = ensure_string(e, string_clone(&expr.name))
        return
    }
    if expr.kind == EXPR_STRUCT_LIT {
        let _ = ensure_string(e, string_clone(&expr.name))
        let mut fi = 0
        while fi < len(&expr.fields) {
            let f = &expr.fields[fi]
            let _ = ensure_string(e, string_clone(&f.name))
            collect_strings_from_expr(e, &f.value)
            fi = fi + 1
        }
        return
    }
    if expr.kind == EXPR_FIELD {
        let _ = ensure_string(e, string_clone(&expr.name))
        if len(&expr.args) > 0 {
            collect_strings_from_expr(e, expr_arg_ref(expr, 0, "collect_strings_enum_recv"))
        }
        return
    }
    let mut i = 0
    while i < len(&expr.args) {
        collect_strings_from_expr(e, expr_arg_ref(expr, i, "collect_strings_arg"))
        i = i + 1
    }
    let mut j = 0
    while j < len(&expr.fields) {
        collect_strings_from_expr(e, &expr.fields[j].value)
        j = j + 1
    }
}

fn collect_strings_from_block(e: &mut Emitter, b: &Block) {
    collect_strings_from_stmts(e, &b.stmts)
}

fn collect_strings_from_stmts(e: &mut Emitter, items: & [Stmt]) {
    let mut i = 0
    while i < len(items) {
        let s = &(*items)[i]
        collect_strings_from_expr(e, &s.expr)
        if s.kind == STMT_IF {
            collect_strings_from_block(e, &s.block)
            if s.has_else { collect_strings_from_block(e, &s.else_block) }
        } else if s.kind == STMT_IFLET {
            collect_strings_from_block(e, &s.block)
            if s.has_else { collect_strings_from_block(e, &s.else_block) }
        } else if s.kind == STMT_MATCH {
            let mut ai = 0
            while ai < len(&s.arms) {
                collect_strings_from_block(e, &s.arms[ai].block)
                ai = ai + 1
            }
        } else if s.kind == STMT_WHILE || s.kind == STMT_LOOP {
            collect_strings_from_block(e, &s.block)
        } else if s.kind == STMT_BREAK_VALUE {
            collect_strings_from_expr(e, &s.expr)
        }
        i = i + 1
    }
}

fn collect_strings_structs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.structs) {
        let s = &prog.structs[i]
        let _ = ensure_string(e, string_clone(&s.name))
        let mut fi = 0
        while fi < len(&s.fields) {
            let f = &s.fields[fi]
            let _ = ensure_string(e, string_clone(&f.name))
            fi = fi + 1
        }
        i = i + 1
    }
}

fn collect_strings_enums(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(&prog.enums) {
        let en = &prog.enums[i]
        let _ = ensure_string(e, string_clone(&en.name))
        let mut has_payload = false
        let mut vi = 0
        while vi < len(&en.variants) {
            if en.variants[vi].has_payload { has_payload = true }
            vi = vi + 1
        }
        if has_payload {
            let _ = ensure_string(e, "_tag")
            let _ = ensure_string(e, "_payload")
        }
        i = i + 1
    }
}

fn collect_strings(e: &mut Emitter, prog: &Program) {
    collect_strings_structs(e, prog)
    collect_strings_enums(e, prog)
    let mut i = 0
    while i < len(&prog.consts) {
        collect_strings_from_expr(e, &prog.consts[i].expr)
        i = i + 1
    }
    let mut fi = 0
    while fi < len(&prog.functions) {
        if !prog.functions[fi].is_macro {
            collect_strings_from_block(e, &prog.functions[fi].body)
        }
        fi = fi + 1
    }
}

fn emit_string_data(e: &Emitter) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(&e.strings) {
        let data = str_data_label(i)
        let st = str_struct_label(i)
        let s = &e.strings[i]
        let esc = escape_qbe_string(s)
        let slen = str_len(&s)
        out = out + "data $" + data + " = { b \"" + esc + "\", b 0 }\n"
        out = out + "data $" + st + " = { l $" + data + ", l " + int_to_string(slen) + ", l " + int_to_string(slen + 1) + " }\n"
        i = i + 1
    }
    if out != "" { out = out + "\n" }
    return out
}

fn expr_lvalue_base(expr: &Expr) -> String {
    if expr.kind == EXPR_IDENT { return string_clone(&expr.name) }
    if (expr.kind == EXPR_FIELD || expr.kind == EXPR_INDEX) && len(&expr.args) > 0 {
        return expr_lvalue_base(expr_arg_ref(expr, 0, "expr_lvalue_base_recv"))
    }
    return ""
}

fn expr_is_lvalue(expr: &Expr) -> bool {
    return expr_lvalue_base(expr) != ""
}

fn check_ref_target(e: &Emitter, inner: &Expr, want_mut: bool) {
    if !expr_is_lvalue(inner) {
        println("stage2: reference target must be identifier, field, or index")
        exit(1)
    }
    let base = expr_lvalue_base(inner)
    if base != "" && const_index(e, &base) >= 0 {
        println("stage2: cannot take reference to const", base)
        exit(1)
    }
    if want_mut && base != "" && !var_is_mut(e, &base) {
        println("stage2: cannot take &mut of immutable value", base)
        exit(1)
    }
}

fn emit_const_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if expr.kind == EXPR_INT || expr.kind == EXPR_CHAR {
        return qbe_value("i64", int_to_string(expr.int_value))
    }
    if expr.kind == EXPR_BOOL {
        if expr.bool_value { return qbe_value("bool", "1") }
        return qbe_value("bool", "0")
    }
    if expr.kind == EXPR_STRING {
        let id = ensure_string(e, string_clone(&expr.name))
        return qbe_value("String", "$" + str_struct_label(id))
    }
    if expr.kind == EXPR_IDENT {
        let idx = const_index(e, &expr.name)
        if idx >= 0 {
            if idx >= len(&e.const_exprs) {
                println("stage2: const expr missing", expr.name, "idx", idx, "names", len(&e.const_names), "exprs", len(&e.const_exprs))
                exit(1)
            }
            return emit_const_expr(e, &e.const_exprs[idx])
        }
    }
    println("stage2: unsupported const expression")
    exit(1)
    return qbe_value("i64", "0")
}

fn emit_load_var(e: &mut Emitter, name: &str, typ: &str) -> QbeValue {
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, typ)
    let qt = qbe_type(e, typ)
    emit_line(e, "  " + tn + " =" + qt + " " + op + " %" + var_slot(name))
    return qbe_value(type_resolve(e, typ), tn)
}

fn emit_deref_value(e: &mut Emitter, v: QbeValue) -> QbeValue {
    if !type_is_ref(e, &v.typ) { return v }
    let base = type_ref_base(e, &v.typ)
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, &base)
    let qt = qbe_type(e, &base)
    emit_line(e, "  " + tn + " =" + qt + " " + op + " " + v.expr)
    return qbe_value(base, tn)
}

fn ensure_bool_expr(e: &mut Emitter, v: QbeValue) -> String {
    if type_is_bool(e, &v.typ) { return v.expr }
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    emit_line(e, "  " + tn + " =w cnel " + v.expr + ", 0")
    return tn
}

fn cast_to_type(e: &mut Emitter, v: QbeValue, target_t: &str) -> String {
    let rt = type_resolve(e, target_t)
    if type_is_unit(e, &rt) { return "0" }
    if type_is_bool(e, &rt) {
        if type_is_bool(e, &v.typ) { return v.expr }
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =w cnel " + v.expr + ", 0")
        return tn
    }
    if type_is_unit(e, &v.typ) { return "0" }
    if type_is_bool(e, &v.typ) {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l extsw " + v.expr)
        return tn
    }
    return v.expr
}

fn cast_to_l(e: &mut Emitter, v: QbeValue) -> String {
    return cast_to_type(e, v, "i64")
}

fn enum_construct(e: &mut Emitter, enum_name: &str, variant: &str, payload: QbeValue, has_payload_arg: bool) -> QbeValue {
    let tag = enum_variant_value(e, enum_name, variant)
    if tag < 0 {
        println("stage2: unknown enum variant", variant)
        exit(1)
    }
    let tag_t = enum_tag_type(e, enum_name)
    let tag_q = qbe_type(e, &tag_t)
    let tag_fn = struct_set_fn_for_type(e, &tag_t)
    let tag_expr = cast_to_type(e, qbe_value("i64", int_to_string(tag)), &tag_t)
    if enum_has_payload(e, enum_name) {
        let name_ptr = string_data_ptr(e, enum_name)
        let tag_ptr = string_data_ptr(e, "_tag")
        let payload_ptr = string_data_ptr(e, "_payload")
        let payload_t = enum_variant_payload_type(e, enum_name, variant)
        let payload_fn = struct_set_fn_for_type(e, &payload_t)
        let payload_q = qbe_type(e, &payload_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l call $dast_struct_new(l " + name_ptr + ", l 2)")
        emit_line(e, "  call $" + tag_fn + "(l " + tn + ", l " + tag_ptr + ", " + tag_q + " " + tag_expr + ")")
        let mut payload_expr = "0"
        if enum_variant_has_payload(e, enum_name, variant) && has_payload_arg {
            payload_expr = cast_to_type(e, payload, &payload_t)
        }
        emit_line(e, "  call $" + payload_fn + "(l " + tn + ", l " + payload_ptr + ", " + payload_q + " " + payload_expr + ")")
        return qbe_value(string_clone(enum_name), tn)
    }
    return qbe_value(string_clone(enum_name), tag_expr)
}

fn enum_tag_from_value(e: &mut Emitter, v: &QbeValue, enum_t: &str) -> QbeValue {
    let tag_t = enum_tag_type(e, enum_t)
    if type_is_enum(e, enum_t) && enum_has_payload(e, enum_t) {
        let tag_ptr = string_data_ptr(e, "_tag")
        let tag_fn = struct_get_fn_for_type(e, &tag_t)
        let tag_q = qbe_type(e, &tag_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =" + tag_q + " call $" + tag_fn + "(l " + v.expr + ", l " + tag_ptr + ")")
        return qbe_value(string_clone(&tag_t), tn)
    }
    let casted = cast_to_type(e, qbe_value("i64", v.expr), &tag_t)
    return qbe_value(string_clone(&tag_t), casted)
}

fn enum_payload_from_value(e: &mut Emitter, v: &QbeValue, enum_t: &str, variant: &str) -> QbeValue {
    let payload_t = enum_variant_payload_type(e, enum_t, variant)
    if type_is_enum(e, enum_t) && enum_has_payload(e, enum_t) {
        let payload_ptr = string_data_ptr(e, "_payload")
        let payload_fn = struct_get_fn_for_type(e, &payload_t)
        let payload_q = qbe_type(e, &payload_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =" + payload_q + " call $" + payload_fn + "(l " + v.expr + ", l " + payload_ptr + ")")
        return qbe_value(payload_t, tn)
    }
    return qbe_value(payload_t, "0")
}

fn struct_set_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "dast_struct_set_bool" }
    if type_is_string(e, t) { return "dast_struct_set_string" }
    if type_is_i32(e, t) { return "dast_struct_set_i32" }
    if type_is_int(e, t) { return "dast_struct_set_i64" }
    if type_is_enum(e, t) { return "dast_struct_set_i64" }
    if type_is_struct(e, t) { return "dast_struct_set_ptr" }
    return "dast_struct_set_ptr"
}

fn struct_get_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "dast_struct_get_bool" }
    if type_is_string(e, t) { return "dast_struct_get_string" }
    if type_is_i32(e, t) { return "dast_struct_get_i32" }
    if type_is_int(e, t) { return "dast_struct_get_i64" }
    if type_is_enum(e, t) { return "dast_struct_get_i64" }
    if type_is_struct(e, t) { return "dast_struct_get_ptr" }
    return "dast_struct_get_ptr"
}

fn emit_binary_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if len(&expr.args) < 2 { return qbe_value("i64", "0") }
    let lhs = emit_expr(e, expr_arg_ref(expr, 0, "emit_binary_lhs"))
    let rhs = emit_expr(e, expr_arg_ref(expr, 1, "emit_binary_rhs"))
    let op = string_clone(&expr.name)
    if op == "+" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l add " + lhs.expr + ", " + rhs.expr)
        return qbe_value("i64", tn)
    }
    if op == "-" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l sub " + lhs.expr + ", " + rhs.expr)
        return qbe_value("i64", tn)
    }
    if op == "==" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let cmp = if type_is_bool(e, &lhs.typ) { "ceqw" } else { "ceql" }
        emit_line(e, "  " + tn + " =w " + cmp + " " + lhs.expr + ", " + rhs.expr)
        return qbe_value("bool", tn)
    }
    if op == "<" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =w csltl " + lhs.expr + ", " + rhs.expr)
        return qbe_value("bool", tn)
    }
    if op == ">" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        // Reuse signed-less-than by swapping operands.
        emit_line(e, "  " + tn + " =w csltl " + rhs.expr + ", " + lhs.expr)
        return qbe_value("bool", tn)
    }
    println("stage2: unsupported binary op", op)
    exit(1)
    return qbe_value("i64", "0")
}

fn emit_block_expr(e: &mut Emitter, b: &Block) -> QbeValue {
    let n = len(&b.stmts)
    if n == 0 { return qbe_value("unit", "0") }
    let mut i = 0
    while i + 1 < n {
        emit_stmt(e, &b.stmts[i])
        i = i + 1
    }
    let last = &b.stmts[n - 1]
    if last.kind == STMT_EXPR {
        return emit_expr(e, &last.expr)
    }
    emit_stmt(e, last)
    return qbe_value("unit", "0")
}

fn expr_arg_ref(expr: &Expr, idx: i64, ctx: &str) -> &Expr {
    if idx < 0 || idx >= len(&expr.args) {
        println("stage2: expr args oob", expr.kind, "len", len(&expr.args), "idx", idx, expr.name, ctx)
        exit(1)
    }
    return &expr.args[idx]
}

fn emit_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if expr.kind == EXPR_REF || expr.kind == EXPR_DEREF || expr.kind == EXPR_FIELD || expr.kind == EXPR_MATCH {
        if len(&expr.args) < 1 {
            println("stage2: bad expr args", expr.kind, "len", len(&expr.args), expr.name)
            exit(1)
        }
    }
    if expr.kind == EXPR_INDEX || expr.kind == EXPR_BINARY {
        if len(&expr.args) < 2 {
            println("stage2: bad expr args", expr.kind, "len", len(&expr.args), expr.name)
            exit(1)
        }
    }
    if expr.kind == EXPR_CALL && len(&expr.args) == 0 {
        if expr.name == "" {
            println("stage2: empty callee for call")
            exit(1)
        }
    }
    match expr.kind {
        EXPR_INT => { return qbe_value("i64", int_to_string(expr.int_value)) }
        EXPR_CHAR => { return qbe_value("i64", int_to_string(expr.int_value)) }
        EXPR_BOOL => {
            if expr.bool_value { return qbe_value("bool", "1") }
            return qbe_value("bool", "0")
        }
        EXPR_STRING => {
            let id = ensure_string(e, string_clone(&expr.name))
            return qbe_value("String", "$" + str_struct_label(id))
        }
        EXPR_BLOCK => { return emit_block_expr(e, &expr.block) }
        EXPR_MATCH => { return emit_match_expr(e, expr) }
        EXPR_MACRO_CALL => {
            println("stage2: unexpanded macro call")
            exit(1)
            return qbe_value("i64", "0")
        }
        EXPR_QUOTE => {
            println("stage2: unexpanded quote")
            exit(1)
            return qbe_value("i64", "0")
        }
        EXPR_IDENT => {
            let ci = const_index(e, &expr.name)
            if ci >= 0 {
                if ci >= len(&e.const_exprs) {
                    println("stage2: const expr missing", expr.name, "idx", ci, "names", len(&e.const_names), "exprs", len(&e.const_exprs))
                    exit(1)
                }
                return emit_const_expr(e, &e.const_exprs[ci])
            }
            let vt = var_type(e, &expr.name)
            if vt != "" {
                return emit_load_var(e, &expr.name, &vt)
            }
            if var_index(e, &expr.name) >= 0 {
                return emit_load_var(e, &expr.name, "i64")
            }
            return qbe_value("i64", "0")
        }
        EXPR_REF => {
            if len(&expr.args) == 0 { return qbe_value("&i64", "0") }
            let inner = expr_arg_ref(expr, 0, "emit_ref")
            let base_t = expr_type(e, inner)
            let mut ref_t = "&" + string_clone(&base_t)
            if expr.ref_mut {
                ref_t = "&mut " + string_clone(&base_t)
            }
            check_ref_target(e, inner, expr.ref_mut)
            if inner.kind == EXPR_IDENT {
                let name = string_clone(&inner.name)
                if var_index(e, &name) >= 0 {
                    return qbe_value(ref_t, "%" + var_slot(&name))
                }
            }
            let v = emit_expr(e, inner)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l alloc8 8")
            let casted = cast_to_type(e, v, &base_t)
            let op = store_op_for_type(e, &base_t)
            emit_line(e, "  " + op + " " + casted + ", " + tn)
            return qbe_value(ref_t, tn)
        }
        EXPR_DEREF => {
            if len(&expr.args) == 0 { return qbe_value("i64", "0") }
            let ptr = emit_expr(e, expr_arg_ref(expr, 0, "emit_deref"))
            if !type_is_ref(e, &ptr.typ) {
                println("stage2: deref requires reference")
                exit(1)
            }
            let base_t = expr_type(e, expr)
            let op = load_op_for_type(e, &base_t)
            let q = qbe_type(e, &base_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " " + op + " " + ptr.expr)
            return qbe_value(base_t, tn)
        }
        EXPR_ARRAY => {
            let arr_t = expr_type(e, expr)
            let cap = len(&expr.args)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_array_new(l " + int_to_string(cap) + ")")
            let mut i = 0
            while i < len(&expr.args) {
                let v = emit_expr(e, expr_arg_ref(expr, i, "emit_array_elem"))
                let casted = cast_to_l(e, v)
                emit_line(e, "  call $dast_array_push(l " + tn + ", l " + casted + ")")
                i = i + 1
            }
            return qbe_value(arr_t, tn)
        }
        EXPR_INDEX => {
            if len(&expr.args) < 2 { return qbe_value("i64", "0") }
            let recv = emit_expr(e, expr_arg_ref(expr, 0, "emit_index_recv"))
            let idxv = emit_expr(e, expr_arg_ref(expr, 1, "emit_index_idx"))
            let idx = cast_to_l(e, idxv)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_array_get(l " + recv.expr + ", l " + idx + ")")
            let t = expr_type(e, expr)
            return qbe_value(t, tn)
        }
        EXPR_STRUCT_LIT => {
            let st_name = string_clone(&expr.name)
            if struct_index(e, &st_name) < 0 {
                println("stage2: unknown struct", st_name)
                exit(1)
            }
            let name_ptr = string_data_ptr(e, &st_name)
            let field_count = struct_field_count(e, &st_name)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_struct_new(l " + name_ptr + ", l " + int_to_string(field_count) + ")")
            let mut i = 0
            while i < len(&expr.fields) {
                let f = &expr.fields[i]
                let fname = string_clone(&f.name)
                let ftyp = struct_field_type(e, &st_name, &fname)
                if ftyp == "" {
                    println("stage2: unknown struct field", fname)
                    exit(1)
                }
                let v = emit_expr(e, &f.value)
                let casted = cast_to_type(e, v, &ftyp)
                let fname_ptr = string_data_ptr(e, &fname)
                let set_fn = struct_set_fn_for_type(e, &ftyp)
                let q = qbe_type(e, &ftyp)
                emit_line(e, "  call $" + set_fn + "(l " + tn + ", l " + fname_ptr + ", " + q + " " + casted + ")")
                i = i + 1
            }
            return qbe_value(st_name, tn)
        }
        EXPR_FIELD => {
            if len(&expr.args) == 0 {
                println("stage2: field access missing receiver")
                exit(1)
            }
            if is_digit_str(&expr.name) {
                let idx = parse_int_simple(&expr.name)
                let idx_expr = expr_int(idx)
                let at = expr_index(expr_clone(expr_arg_ref(expr, 0, "emit_field_digit")), idx_expr)
                return emit_expr(e, &at)
            }
            let recv_expr = expr_arg_ref(expr, 0, "emit_field_recv_expr")
            if recv_expr.kind == EXPR_IDENT {
                let recv_name = type_resolve(e, &recv_expr.name)
                let ct = const_type(e, &recv_name)
                let vt = var_type(e, &recv_name)
                if ct == "" && vt == "" && type_is_enum(e, &recv_name) {
                    let dummy = qbe_value("i64", "0")
                    return enum_construct(e, &recv_name, &expr.name, dummy, false)
                }
            }
            let recv = emit_expr(e, expr_arg_ref(expr, 0, "emit_field_recv"))
            let mut recv_expr = recv.expr
            let mut recv_type = recv.typ
            if type_is_ref(e, &recv_type) {
                let base_t = type_ref_base(e, &recv_type)
                let op = load_op_for_type(e, &base_t)
                let q = qbe_type(e, &base_t)
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =" + q + " " + op + " " + recv_expr)
                recv_expr = tn
                recv_type = base_t
            }
            let recv_base = type_strip_ref(e, &recv_type)
            let fname = string_clone(&expr.name)
            let ftyp = struct_field_type(e, &recv_base, &fname)
            if ftyp == "" {
                println("stage2: unknown field", fname)
                exit(1)
            }
            let fname_ptr = string_data_ptr(e, &fname)
            let get_fn = struct_get_fn_for_type(e, &ftyp)
            let q = qbe_type(e, &ftyp)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " call $" + get_fn + "(l " + recv_expr + ", l " + fname_ptr + ")")
            return qbe_value(ftyp, tn)
        }
        EXPR_BINARY => {
            return emit_binary_expr(e, expr)
        }
        EXPR_CALL => {
            let ci = closure_index(e, &expr.name)
            if ci >= 0 {
                if len(&expr.args) > 0 {
                    println("stage2: closure args not supported yet")
                    exit(1)
                }
                emit_block(e, &e.closure_blocks[ci])
                return qbe_value("unit", "0")
            }
            if expr.name == "print" || expr.name == "println" {
                emit_print_call(e, expr)
                return qbe_value("unit", "0")
            }
            if expr.name == "len" {
                if len(&expr.args) < 1 { return qbe_value("i64", "0") }
                let mut v = emit_expr(e, expr_arg_ref(expr, 0, "emit_len"))
                if type_is_ref(e, &v.typ) {
                    let base = type_ref_base(e, &v.typ)
                    if type_is_string(e, &v.typ) || type_is_array(e, &base) {
                        v = emit_deref_value(e, v)
                    }
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                let fn_name = if type_is_string(e, &v.typ) { "dast_string_len" } else { "dast_array_len" }
                emit_line(e, "  " + tn + " =l call $" + fn_name + "(l " + v.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "string_clone" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let mut v = emit_expr(e, expr_arg_ref(expr, 0, "emit_string_clone"))
                if type_is_string(e, &v.typ) && type_is_ref(e, &v.typ) {
                    v = emit_deref_value(e, v)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_string_clone(l " + v.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "char_at" {
                if len(&expr.args) < 2 { return qbe_value("i64", "0") }
                let mut s = emit_expr(e, expr_arg_ref(expr, 0, "emit_char_at_s"))
                if type_is_string(e, &s.typ) && type_is_ref(e, &s.typ) {
                    s = emit_deref_value(e, s)
                }
                let idx = emit_expr(e, expr_arg_ref(expr, 1, "emit_char_at_idx"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_char_at(l " + s.expr + ", l " + idx.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "substr" {
                if len(&expr.args) < 3 { return qbe_value("String", "0") }
                let mut s = emit_expr(e, expr_arg_ref(expr, 0, "emit_substr_s"))
                if type_is_string(e, &s.typ) && type_is_ref(e, &s.typ) {
                    s = emit_deref_value(e, s)
                }
                let start = emit_expr(e, expr_arg_ref(expr, 1, "emit_substr_start"))
                let count = emit_expr(e, expr_arg_ref(expr, 2, "emit_substr_count"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_substr(l " + s.expr + ", l " + start.expr + ", l " + count.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "read_file" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_file"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_file(l " + path.expr + ")")
                return qbe_value("String", tn)
            }
            if expr.name == "read_dir" {
                if len(&expr.args) < 1 { return qbe_value("[String]", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_dir"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_dir(l " + path.expr + ")")
                return qbe_value("[String]", tn)
            }
            if expr.name == "write_file" {
                if len(&expr.args) < 2 { return qbe_value("unit", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_write_file_path"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                let mut data = emit_expr(e, expr_arg_ref(expr, 1, "emit_write_file_data"))
                if type_is_string(e, &data.typ) && type_is_ref(e, &data.typ) {
                    data = emit_deref_value(e, data)
                }
                emit_line(e, "  call $dast_write_file(l " + path.expr + ", l " + data.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "mkdir" {
                if len(&expr.args) < 1 { return qbe_value("unit", "0") }
                let mut path = emit_expr(e, expr_arg_ref(expr, 0, "emit_mkdir"))
                if type_is_string(e, &path.typ) && type_is_ref(e, &path.typ) {
                    path = emit_deref_value(e, path)
                }
                emit_line(e, "  call $dast_mkdir(l " + path.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "exec" {
                if len(&expr.args) < 2 { return qbe_value("i64", "0") }
                let mut cmd = emit_expr(e, expr_arg_ref(expr, 0, "emit_exec_cmd"))
                if type_is_string(e, &cmd.typ) && type_is_ref(e, &cmd.typ) {
                    cmd = emit_deref_value(e, cmd)
                }
                let args = emit_expr(e, expr_arg_ref(expr, 1, "emit_exec_args"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_exec(l " + cmd.expr + ", l " + args.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "exit" {
                if len(&expr.args) < 1 { return qbe_value("unit", "0") }
                let code = emit_expr(e, expr_arg_ref(expr, 0, "emit_exit"))
                emit_line(e, "  call $dast_exit(l " + code.expr + ")")
                return qbe_value("unit", "0")
            }
            if expr.name == "args" {
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_args()")
                return qbe_value("[String]", tn)
            }
            if expr.name == "read_line" {
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_line()")
                return qbe_value("String", tn)
            }
            if expr.name == "read_bytes" {
                if len(&expr.args) < 1 { return qbe_value("String", "0") }
                let count = emit_expr(e, expr_arg_ref(expr, 0, "emit_read_bytes"))
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_read_bytes(l " + count.expr + ")")
                return qbe_value("String", tn)
            }
            let ec = enum_call_parse(&expr.name)
            if ec.ok && type_is_enum(e, &ec.enum_name) {
                let mut payload = qbe_value("i64", "0")
                let mut has_payload_arg = false
                if len(&expr.args) > 0 {
                    payload = emit_expr(e, expr_arg_ref(expr, 0, "emit_enum_payload"))
                    has_payload_arg = true
                }
                return enum_construct(e, &ec.enum_name, &ec.variant, payload, has_payload_arg)
            }
            let mut call_name = string_clone(&expr.name)
            let mut rt = func_ret_type_for_call(e, &expr.name, &expr.args)
            let di = func_decl_index(e, &expr.name)
            let mut param_types: [String] = []
            if di >= 0 {
                let f = &e.func_decls[di]
                if len(&f.type_params) > 0 {
                    let values = func_type_args_for_call(e, f, &expr.args)
                    let mut ok = true
                    let mut vi = 0
                    while vi < len(&values) {
                        if values[vi] == "" { ok = false }
                        vi = vi + 1
                    }
                    if ok {
                        let params = func_type_param_names(f)
                        call_name = ensure_inst_func(e, f, &values)
                        let rt_sub = type_subst(e, &f.ret_type, &params, &values)
                        rt = type_resolve(e, &rt_sub)
                        param_types = func_param_types_for_call(e, f, &values)
                    } else {
                        let mut empty_vals: [String] = []
                        param_types = func_param_types_for_call(e, f, &empty_vals)
                    }
                } else {
                    let mut empty_vals: [String] = []
                    param_types = func_param_types_for_call(e, f, &empty_vals)
                }
            }
            let callee = "dast_user_" + mangle_name(&call_name)
            let ret_t = type_resolve(e, &rt)
            let ret_q = qbe_type(e, &ret_t)
            let mut args_text = ""
            let mut i = 0
            while i < len(&expr.args) {
                if i > 0 { args_text = args_text + ", " }
                if i < len(&param_types) && param_types[i] != "" && !type_is_ref(e, &param_types[i]) {
                    let arg_expr = expr_arg_ref(expr, i, "emit_call_arg_type")
                    if arg_expr.kind == EXPR_IDENT {
                        let src_t = expr_type(e, arg_expr)
                        if drop_needs_drop_type_env(e, &src_t) {
                            drop_live_remove(e, &arg_expr.name)
                        }
                    }
                }
                let mut v = qbe_value("i64", "0")
                let arg_expr = expr_arg_ref(expr, i, "emit_call_arg_val")
                if i < len(&param_types) && param_types[i] != "" && type_is_ref(e, &param_types[i]) {
                    let arg_t = expr_type(e, arg_expr)
                    if !type_is_ref(e, &arg_t) {
                        v = emit_auto_borrow(e, arg_expr, &param_types[i])
                    } else {
                        v = emit_expr(e, arg_expr)
                    }
                } else {
                    v = emit_expr(e, arg_expr)
                }
                let qt = qbe_type(e, &v.typ)
                args_text = args_text + qt + " " + v.expr
                i = i + 1
            }
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + ret_q + " call $" + callee + "(" + args_text + ")")
            return qbe_value(ret_t, tn)
        }
        _ => {
            println("stage2: unsupported expr kind", expr.kind)
            exit(1)
            return qbe_value("i64", "0")
        }
    }
}

fn print_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "dast_print_bool" }
    if type_is_string(e, t) { return "dast_print_string" }
    if type_is_struct(e, t) { return "dast_print_struct" }
    return "dast_print_i64"
}

fn emit_print_arg(e: &mut Emitter, v: &QbeValue) {
    // Emit any prerequisite lines (for loads).
    let mut i = 0
    while i < len(&v.lines) {
        emit_line(e, string_clone(&v.lines[i]))
        i = i + 1
    }
    let mut arg = QbeValue { typ: string_clone(&v.typ), expr: string_clone(&v.expr), lines: qbe_lines_empty() }
    if type_is_string(e, &arg.typ) && type_is_ref(e, &arg.typ) {
        arg = emit_deref_value(e, arg)
    }
    let fn_name = print_fn_for_type(e, &arg.typ)
    let qt = qbe_type(e, &arg.typ)
    emit_line(e, "  call $" + fn_name + "(" + qt + " " + arg.expr + ")")
}

fn emit_print_call(e: &mut Emitter, call: &Expr) {
    let newline = call.name == "println"
    let mut i = 0
    while i < len(&call.args) {
        if i > 0 {
            emit_line(e, "  call $dast_print_space()")
        }
        let v = emit_expr(e, expr_arg_ref(call, i, "emit_print_arg"))
        emit_print_arg(e, &v)
        i = i + 1
    }
    if newline {
        emit_line(e, "  call $dast_print_newline()")
    }
}

fn emit_store_let(e: &mut Emitter, name: &str, expr: &Expr) {
    let typ = var_type(e, name)
    if expr.kind == EXPR_CLOSURE {
        closure_add(e, name, &expr.block)
        return
    }
    // Moves from non-copy identifiers should transfer drop ownership.
    if expr.kind == EXPR_IDENT {
        let src_t = expr_type(e, expr)
        if drop_needs_drop_type_env(e, &src_t) {
            drop_live_remove(e, &expr.name)
        }
    }
    let mut v = qbe_value("i64", "0")
    if expr.kind == EXPR_STRUCT_LIT {
        let declared = type_resolve(e, &typ)
        let actual = type_resolve(e, &expr.name)
        let db = type_strip_args(e, &declared)
        let ab = type_strip_args(e, &actual)
        if db != "" && db == ab && declared != actual {
            let mut lit = expr_clone(expr)
            lit.name = string_clone(&declared)
            v = emit_expr(e, &lit)
        } else {
            v = emit_expr(e, expr)
        }
    } else {
        v = emit_expr(e, expr)
    }
    drop_live_drop_existing(e, name)
    let op = store_op_for_type(e, &typ)
    emit_line(e, "  " + op + " " + v.expr + ", %" + var_slot(name))
    drop_live_set(e, name, &typ)
}

fn emit_block(e: &mut Emitter, b: &Block) {
    let mut i = 0
    while i < len(&b.stmts) {
        emit_stmt(e, &b.stmts[i])
        i = i + 1
    }
}

fn block_ends_with_terminator(b: &Block) -> bool {
    let n = len(&b.stmts)
    if n == 0 { return false }
    let last = stmt_clone(&b.stmts[n - 1])
    return last.kind == STMT_BREAK || last.kind == STMT_CONTINUE || last.kind == STMT_RETURN
}

fn emit_store_assign(e: &mut Emitter, lhs: &Expr, expr: &Expr) {
    if lhs.kind == EXPR_IDENT {
        if !var_is_mut(e, &lhs.name) {
            println("stage2: cannot assign to immutable value", lhs.name)
            exit(1)
        }
        emit_store_let(e, &lhs.name, expr)
        return
    }
    if lhs.kind == EXPR_FIELD {
        let base_name = expr_lvalue_base(lhs)
        let base_t = var_type(e, &base_name)
        if base_name != "" && !var_is_mut(e, &base_name) && !type_is_mut_ref(e, &base_t) {
            println("stage2: cannot assign to immutable value", base_name)
            exit(1)
        }
        if len(&lhs.args) == 0 {
            println("stage2: field assignment missing receiver")
            exit(1)
        }
        let recv = emit_expr(e, expr_arg_ref(lhs, 0, "assign_field_recv"))
        let mut recv_expr = recv.expr
        let mut recv_base = recv.typ
        if type_is_ref(e, &recv_base) {
            let base_t = type_ref_base(e, &recv_base)
            let op = load_op_for_type(e, &base_t)
            let q = qbe_type(e, &base_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " " + op + " " + recv_expr)
            recv_expr = tn
            recv_base = base_t
        }
        recv_base = type_strip_ref(e, &recv_base)
        let fname = string_clone(&lhs.name)
        let ftyp = struct_field_type(e, &recv_base, &fname)
        if ftyp == "" {
            println("stage2: unknown field", fname)
            exit(1)
        }
        let v = emit_expr(e, expr)
        let casted = cast_to_type(e, v, &ftyp)
        let fname_ptr = string_data_ptr(e, &fname)
        let set_fn = struct_set_fn_for_type(e, &ftyp)
        let q = qbe_type(e, &ftyp)
        emit_line(e, "  call $" + set_fn + "(l " + recv_expr + ", l " + fname_ptr + ", " + q + " " + casted + ")")
        return
    }
    if lhs.kind == EXPR_INDEX {
        let base_name = expr_lvalue_base(lhs)
        let base_t = var_type(e, &base_name)
        if base_name != "" && !var_is_mut(e, &base_name) && !type_is_mut_ref(e, &base_t) {
            println("stage2: cannot assign to immutable value", base_name)
            exit(1)
        }
        if len(&lhs.args) < 2 {
            println("stage2: index assignment missing args")
            exit(1)
        }
        let recv = emit_expr(e, expr_arg_ref(lhs, 0, "assign_index_recv"))
        let idxv = emit_expr(e, expr_arg_ref(lhs, 1, "assign_index_idx"))
        let idx = cast_to_l(e, idxv)
        let elem_t = expr_type(e, lhs)
        let v = emit_expr(e, expr)
        let casted = cast_to_type(e, v, &elem_t)
        emit_line(e, "  call $dast_array_set(l " + recv.expr + ", l " + idx + ", l " + casted + ")")
        return
    }
    if lhs.kind == EXPR_DEREF && len(&lhs.args) > 0 {
        let ptr = emit_expr(e, expr_arg_ref(lhs, 0, "assign_deref_ptr"))
        if !type_is_mut_ref(e, &ptr.typ) {
            println("stage2: assignment through & requires &mut")
            exit(1)
        }
        let target_t = expr_type(e, lhs)
        let v = emit_expr(e, expr)
        let casted = cast_to_type(e, v, &target_t)
        let op = store_op_for_type(e, &target_t)
        emit_line(e, "  " + op + " " + casted + ", " + ptr.expr)
        return
    }
    println("stage2: unsupported assignment target")
    exit(1)
}

fn emit_if(e: &mut Emitter, stmt: &Stmt) {
    let cond_val = emit_expr(e, &stmt.expr)
    let cond_expr = ensure_bool_expr(e, cond_val)
    let then_label = new_label(e, "if_then_")
    let else_label = new_label(e, "if_else_")
    let end_label = new_label(e, "if_end_")
    emit_line(e, "  jnz " + cond_expr + ", @" + string_clone(&then_label) + ", @" + string_clone(&else_label))
    emit_label(e, &then_label)
    emit_block(e, &stmt.block)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &else_label)
    if stmt.has_else { emit_block(e, &stmt.else_block) }
    if !stmt.has_else || !block_ends_with_terminator(&stmt.else_block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &end_label)
}

fn emit_store_value(e: &mut Emitter, name: &str, typ: &str, value_expr: &str) {
    if name == "" { return }
    drop_live_drop_existing(e, name)
    let op = store_op_for_type(e, typ)
    emit_line(e, "  " + op + " " + string_clone(value_expr) + ", %" + var_slot(name))
    drop_live_set(e, name, typ)
}

fn emit_iflet(e: &mut Emitter, stmt: &Stmt) {
    let scrut = emit_expr(e, &stmt.expr)
    let mut enum_t = expr_type(e, &stmt.expr)
    if !type_is_enum(e, &enum_t) && stmt.expr.kind == EXPR_IDENT {
        let hint = enum_var_hint(e, &stmt.expr.name)
        if hint != "" { enum_t = hint }
    }
    if !type_is_enum(e, &enum_t) && enum_t == "" {
        let guess = enum_name_for_variant(e, &stmt.pat_variant)
        if guess != "" { enum_t = guess }
    }
    if !type_is_enum(e, &enum_t) {
        println("stage2: if let requires enum expression")
        exit(1)
    }
    let tag_t = enum_tag_type(e, &enum_t)
    let tagv = enum_tag_from_value(e, &scrut, &enum_t)
    let tag_val = enum_variant_value(e, &enum_t, &stmt.pat_variant)
    let cond_tmp = new_temp(e)
    let cond_tn = temp_name(cond_tmp)
    let cmp = if type_is_bool(e, &tag_t) || type_is_i32(e, &tag_t) { "ceqw" } else { "ceql" }
    emit_line(e, "  " + cond_tn + " =w " + cmp + " " + tagv.expr + ", " + int_to_string(tag_val))
    let then_label = new_label(e, "iflet_then_")
    let else_label = new_label(e, "iflet_else_")
    let end_label = new_label(e, "iflet_end_")
    emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&then_label) + ", @" + string_clone(&else_label))
    emit_label(e, &then_label)
    if stmt.pat_has_binding {
        let payload_t = enum_variant_payload_type(e, &enum_t, &stmt.pat_variant)
        let payload_v = enum_payload_from_value(e, &scrut, &enum_t, &stmt.pat_variant)
        let casted = cast_to_type(e, payload_v, &payload_t)
        let mut bind_t = var_type(e, &stmt.pat_binding)
        if bind_t == "" { bind_t = payload_t }
        emit_store_value(e, &stmt.pat_binding, &bind_t, &casted)
    }
    emit_block(e, &stmt.block)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &else_label)
    if stmt.has_else { emit_block(e, &stmt.else_block) }
    if !stmt.has_else || !block_ends_with_terminator(&stmt.else_block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &end_label)
}

fn emit_match(e: &mut Emitter, stmt: &Stmt) {
    let scrut = emit_expr(e, &stmt.expr)
    let mut scrut_t = expr_type(e, &stmt.expr)
    let mut is_enum = type_is_enum(e, &scrut_t)
    if !is_enum {
        let mut guess = ""
        let mut ai = 0
        while ai < len(&stmt.arms) {
            if stmt.arms[ai].pat_kind == PAT_VARIANT {
                guess = enum_name_for_variant(e, &stmt.arms[ai].variant)
                break
            }
            ai = ai + 1
        }
        if guess != "" { scrut_t = guess; is_enum = true }
    }
    let mut tag_t = string_clone(&scrut.typ)
    let mut tag_expr = string_clone(&scrut.expr)
    if is_enum {
        let tagv = enum_tag_from_value(e, &scrut, &scrut_t)
        tag_t = enum_tag_type(e, &scrut_t)
        tag_expr = string_clone(&tagv.expr)
    }
    let cmp = if type_is_bool(e, &tag_t) || type_is_i32(e, &tag_t) { "ceqw" } else { "ceql" }
    let end_label = new_label(e, "match_end_")
    let mut i = 0
    let mut next_label = new_label(e, "match_next_")
    while i < len(&stmt.arms) {
        let arm = &stmt.arms[i]
        let arm_label = new_label(e, "match_arm_")
        if arm.pat_kind == PAT_WILDCARD || arm.pat_kind == PAT_STRUCT {
            emit_line(e, "  jmp @" + string_clone(&arm_label))
        } else {
            let cond_tmp = new_temp(e)
            let cond_tn = temp_name(cond_tmp)
            if arm.pat_kind == PAT_VARIANT {
                let tag_val = enum_variant_value(e, &scrut_t, &arm.variant)
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(tag_val))
            } else if arm.pat_kind == PAT_INT {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(arm.int_value))
            } else {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(arm.int_value))
            }
            emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&arm_label) + ", @" + string_clone(&next_label))
        }
        emit_label(e, &arm_label)
        if arm.has_binding && arm.pat_kind == PAT_VARIANT && is_enum {
            let payload_t = enum_variant_payload_type(e, &scrut_t, &arm.variant)
            let payload_v = enum_payload_from_value(e, &scrut, &scrut_t, &arm.variant)
            let casted = cast_to_type(e, payload_v, &payload_t)
            let mut bind_t = var_type(e, &arm.binding)
            if bind_t == "" { bind_t = payload_t }
            emit_store_value(e, &arm.binding, &bind_t, &casted)
        } else if arm.pat_kind == PAT_STRUCT {
            let st_name = type_strip_ref(e, &scrut_t)
            if !type_is_struct(e, &st_name) {
                println("stage2: struct pattern requires struct scrutinee")
                exit(1)
            }
            if arm.struct_name != "" && arm.struct_name != st_name {
                println("stage2: struct pattern type mismatch", arm.struct_name, "vs", st_name)
                exit(1)
            }
            let mut fi = 0
            while fi < len(&arm.struct_fields) {
                let f = &arm.struct_fields[fi]
                if f.has_binding {
                    let ftyp = struct_field_type(e, &st_name, &f.name)
                    if ftyp == "" {
                        println("stage2: unknown struct field", f.name)
                        exit(1)
                    }
                    let fname_ptr = string_data_ptr(e, &f.name)
                    let get_fn = struct_get_fn_for_type(e, &ftyp)
                    let q = qbe_type(e, &ftyp)
                    let tmp = new_temp(e)
                    let tn = temp_name(tmp)
                    emit_line(e, "  " + tn + " =" + q + " call $" + get_fn + "(l " + scrut.expr + ", l " + fname_ptr + ")")
                    let mut bind_t = var_type(e, &f.binding)
                    if bind_t == "" { bind_t = ftyp }
                    emit_store_value(e, &f.binding, &bind_t, &tn)
                }
                fi = fi + 1
            }
        }
        emit_block(e, &arm.block)
        if !block_ends_with_terminator(&arm.block) {
            emit_line(e, "  jmp @" + string_clone(&end_label))
        }
        emit_label(e, &next_label)
        next_label = new_label(e, "match_next_")
        i = i + 1
    }
    emit_label(e, &end_label)
}

fn emit_match_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if len(&expr.args) == 0 { return qbe_value("unit", "0") }
    let scrut_expr = expr_clone(expr_arg_ref(expr, 0, "emit_match_scrut"))
    let scrut = emit_expr(e, &scrut_expr)
    let mut scrut_t = expr_type(e, &scrut_expr)
    let mut is_enum = type_is_enum(e, &scrut_t)
    if !is_enum {
        let mut guess = ""
        let mut ai = 0
        while ai < len(&expr.match_arms) {
            let a = &expr.match_arms[ai]
            if a.pat_kind == PAT_VARIANT {
                guess = enum_name_for_variant(e, &a.variant)
                break
            }
            ai = ai + 1
        }
        if guess != "" { scrut_t = guess; is_enum = true }
    }
    let mut tag_t = string_clone(&scrut.typ)
    let mut tag_expr = string_clone(&scrut.expr)
    if is_enum {
        let tagv = enum_tag_from_value(e, &scrut, &scrut_t)
        tag_t = enum_tag_type(e, &scrut_t)
        tag_expr = string_clone(&tagv.expr)
    }
    let cmp = if type_is_bool(e, &tag_t) || type_is_i32(e, &tag_t) { "ceqw" } else { "ceql" }
    let end_label = new_label(e, "match_end_")
    let ret0 = expr_type(e, expr)
    let ret_t = type_resolve(e, &ret0)
    let mut res_ptr = ""
    let need_res = !type_is_unit(e, &ret_t)
    if need_res {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l alloc8 8")
        res_ptr = tn
    }
    let mut i = 0
    let mut next_label = new_label(e, "match_next_")
    while i < len(&expr.match_arms) {
        let arm = &expr.match_arms[i]
        let arm_label = new_label(e, "match_arm_")
        if arm.pat_kind == PAT_WILDCARD || arm.pat_kind == PAT_STRUCT {
            emit_line(e, "  jmp @" + string_clone(&arm_label))
        } else {
            let cond_tmp = new_temp(e)
            let cond_tn = temp_name(cond_tmp)
            if arm.pat_kind == PAT_VARIANT {
                let tag_val = enum_variant_value(e, &scrut_t, &arm.variant)
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(tag_val))
            } else if arm.pat_kind == PAT_INT {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(arm.int_value))
            } else {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(arm.int_value))
            }
            emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&arm_label) + ", @" + string_clone(&next_label))
        }
        emit_label(e, &arm_label)
        if arm.has_binding && arm.pat_kind == PAT_VARIANT && is_enum {
            let payload_t = enum_variant_payload_type(e, &scrut_t, &arm.variant)
            let payload_v = enum_payload_from_value(e, &scrut, &scrut_t, &arm.variant)
            let casted = cast_to_type(e, payload_v, &payload_t)
            let mut bind_t = var_type(e, &arm.binding)
            if bind_t == "" { bind_t = payload_t }
            emit_store_value(e, &arm.binding, &bind_t, &casted)
        } else if arm.pat_kind == PAT_STRUCT {
            let st_name = type_strip_ref(e, &scrut_t)
            if !type_is_struct(e, &st_name) {
                println("stage2: struct pattern requires struct scrutinee")
                exit(1)
            }
            if arm.struct_name != "" && arm.struct_name != st_name {
                println("stage2: struct pattern type mismatch", arm.struct_name, "vs", st_name)
                exit(1)
            }
            let mut fi = 0
            while fi < len(&arm.struct_fields) {
                let f = &arm.struct_fields[fi]
                if f.has_binding {
                    let ftyp = struct_field_type(e, &st_name, &f.name)
                    if ftyp == "" {
                        println("stage2: unknown struct field", f.name)
                        exit(1)
                    }
                    let fname_ptr = string_data_ptr(e, &f.name)
                    let get_fn = struct_get_fn_for_type(e, &ftyp)
                    let q = qbe_type(e, &ftyp)
                    let tmp = new_temp(e)
                    let tn = temp_name(tmp)
                    emit_line(e, "  " + tn + " =" + q + " call $" + get_fn + "(l " + scrut.expr + ", l " + fname_ptr + ")")
                    let mut bind_t = var_type(e, &f.binding)
                    if bind_t == "" { bind_t = ftyp }
                    emit_store_value(e, &f.binding, &bind_t, &tn)
                }
                fi = fi + 1
            }
        }
        let arm_val = emit_block_expr(e, &arm.block)
        if !block_ends_with_terminator(&arm.block) {
            if need_res {
                let casted = cast_to_type(e, arm_val, &ret_t)
                let op = store_op_for_type(e, &ret_t)
                emit_line(e, "  " + op + " " + casted + ", " + res_ptr)
            }
            emit_line(e, "  jmp @" + string_clone(&end_label))
        }
        emit_label(e, &next_label)
        next_label = new_label(e, "match_next_")
        i = i + 1
    }
    emit_label(e, &end_label)
    if !need_res { return qbe_value("unit", "0") }
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, &ret_t)
    let q = qbe_type(e, &ret_t)
    emit_line(e, "  " + tn + " =" + q + " " + op + " " + res_ptr)
    return qbe_value(ret_t, tn)
}

fn emit_while(e: &mut Emitter, stmt: &Stmt) {
    let cond_label = new_label(e, "while_cond_")
    let body_label = new_label(e, "while_body_")
    let end_label = new_label(e, "while_end_")
    emit_line(e, "  jmp @" + string_clone(&cond_label))
    emit_label(e, &cond_label)
    let cond_val = emit_expr(e, &stmt.expr)
    let cond_expr = ensure_bool_expr(e, cond_val)
    emit_line(e, "  jnz " + cond_expr + ", @" + string_clone(&body_label) + ", @" + string_clone(&end_label))
    emit_label(e, &body_label)
    push_break_label(e, string_clone(&end_label))
    push_continue_label(e, string_clone(&cond_label))
    emit_block(e, &stmt.block)
    pop_continue_label(e)
    pop_break_label(e)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&cond_label))
    }
    emit_label(e, &end_label)
}

fn emit_loop(e: &mut Emitter, stmt: &Stmt) {
    let body_label = new_label(e, "loop_body_")
    let end_label = new_label(e, "loop_end_")
    emit_line(e, "  jmp @" + string_clone(&body_label))
    emit_label(e, &body_label)
    push_break_label(e, string_clone(&end_label))
    push_continue_label(e, string_clone(&body_label))
    emit_block(e, &stmt.block)
    pop_continue_label(e)
    pop_break_label(e)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&body_label))
    }
    emit_label(e, &end_label)
}

fn emit_break(e: &mut Emitter) {
    let target = top_break_label(e)
    if target == "" {
        println("stage2: break outside loop")
        exit(1)
    }
    emit_line(e, "  jmp @" + target)
}

fn emit_continue(e: &mut Emitter) {
    let target = top_continue_label(e)
    if target == "" {
        println("stage2: continue outside loop")
        exit(1)
    }
    emit_line(e, "  jmp @" + target)
}

fn emit_return(e: &mut Emitter, stmt: &Stmt) {
    let target_t = string_clone(&e.cur_ret_type)
    let mut rexpr = "0"
    if stmt.ret_has_value {
        let v = emit_expr(e, &stmt.expr)
        rexpr = cast_to_type(e, v, &target_t)
        drop_live_remove_returned_expr(e, &stmt.expr)
    }
    drop_live_drop_all(e)
    emit_line(e, "  ret " + rexpr)
}

fn emit_stmt(e: &mut Emitter, stmt: &Stmt) {
    if stmt.kind == STMT_LET {
        emit_store_let(e, &stmt.name, &stmt.expr)
        return
    }
    if stmt.kind == STMT_ASSIGN {
        emit_store_assign(e, &stmt.lhs, &stmt.expr)
        return
    }
    if stmt.kind == STMT_IF {
        emit_if(e, stmt)
        return
    }
    if stmt.kind == STMT_IFLET {
        emit_iflet(e, stmt)
        return
    }
    if stmt.kind == STMT_MATCH {
        emit_match(e, stmt)
        return
    }
    if stmt.kind == STMT_WHILE {
        emit_while(e, stmt)
        return
    }
    if stmt.kind == STMT_LOOP {
        emit_loop(e, stmt)
        return
    }
    if stmt.kind == STMT_BREAK {
        emit_break(e)
        return
    }
    if stmt.kind == STMT_BREAK_VALUE {
        println("stage2: break value only allowed in loop expression desugar")
        exit(1)
    }
    if stmt.kind == STMT_CONTINUE {
        emit_continue(e)
        return
    }
    if stmt.kind == STMT_RETURN {
        emit_return(e, stmt)
        return
    }
    let _ = emit_expr(e, &stmt.expr)
}

fn emit_var_allocs(e: &Emitter) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(&e.var_names) {
        let name = &e.var_names[i]
        let typ = &e.var_types[i]
        let alloc = if type_is_bool(e, typ) { "alloc4 4" } else { "alloc8 8" }
        out = out + "  %" + var_slot(name) + " =l " + alloc + "\n"
        i = i + 1
    }
    return out
}

fn func_param_sig(e: &Emitter, params: & [Param]) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(params) {
        if i > 0 { out = out + ", " }
        let p = &(*params)[i]
        let mut ptyp = "i64"
        if p.has_type { ptyp = type_resolve(e, &p.typ) }
        let qt = qbe_type(e, &ptyp)
        out = out + qt + " %p" + int_to_string(i)
        i = i + 1
    }
    return out
}

fn body_ends_with_ret_line(e: &Emitter) -> bool {
    let n = len(&e.body)
    if n == 0 { return false }
    let mut i = n - 1
    while i >= 0 {
        let line = string_clone(&e.body[i])
        if string_has_prefix(&line, "@") {
            i = i - 1
        } else {
            return string_has_prefix(&line, "  ret ")
        }
    }
    return false
}

fn emit_param_store_lines(e: &Emitter, params: & [Param]) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(params) {
        let p = &(*params)[i]
        let pname = &p.name
        let mut ptyp = "i64"
        if p.has_type { ptyp = type_resolve(e, &p.typ) }
        let ptemp = "%p" + int_to_string(i)
        let op = store_op_for_type(e, &ptyp)
        out = out + "  " + op + " " + ptemp + ", %" + var_slot(pname) + "\n"
        i = i + 1
    }
    return out
}

fn effective_ret_type(e: &Emitter, f: &Function) -> String {
    if f.ret_type == "" { return "unit" }
    return type_resolve(e, &f.ret_type)
}

fn emit_function_text(e: &Emitter, f: &Function) -> String {
    let mut out = ""
    let export_kw = if f.name == "main" { "export " } else { "" }
    let fname = "dast_user_" + mangle_name(&f.name)
    let sig = func_param_sig(e, &f.params)
    let ret_t = effective_ret_type(e, f)
    let ret_q = qbe_type(e, &ret_t)
    out = out + export_kw + "function " + ret_q + " $" + fname + "(" + sig + ") {\n"
    out = out + "@entry\n"
    out = out + emit_var_allocs(e)
    out = out + emit_param_store_lines(e, &f.params)
    out = out + "\n@L_entry\n"
    let mut i = 0
    while i < len(&e.body) {
        out = out + string_clone(&e.body[i]) + "\n"
        i = i + 1
    }
    if !block_ends_with_terminator(&f.body) && !body_ends_with_ret_line(e) {
        out = out + "  ret 0\n\n}\n"
    } else {
        out = out + "\n}\n"
    }
    return out
}

struct FuncEmitResult {
    text: String,
    lines: i64,
}

fn emit_compiled_function(glob: &mut Emitter, f: &Function) -> FuncEmitResult {
    let mut e = emitter_with_globals(glob)
    let eff_rt = effective_ret_type(&e, f)
    e.cur_ret_type = string_clone(&eff_rt)
    validate_block_args(&f.body, f.name)
    collect_vars(&mut e, f)
    let stmt_count = len(&f.body.stmts)
    if stmt_count > 0 {
        let last = stmt_clone(&f.body.stmts[stmt_count - 1])
        if last.kind == STMT_EXPR && !block_ends_with_terminator(&f.body) && eff_rt != "unit" {
            let mut i = 0
            while i + 1 < stmt_count {
                emit_stmt(&mut e, &f.body.stmts[i])
                i = i + 1
            }
            let ret_stmt = stmt_return(last.expr)
            emit_return(&mut e, &ret_stmt)
        } else {
            emit_block(&mut e, &f.body)
        }
    } else {
        emit_block(&mut e, &f.body)
    }
    let has_term = block_ends_with_terminator(&f.body)
    let has_ret = body_ends_with_ret_line(&e)
    if !has_term && !has_ret {
        drop_live_drop_all(&mut e)
    }
    let text = emit_function_text(&e, f)
    glob.strings = ast_string_list_clone(&e.strings)
    glob.inst_func_names = ast_string_list_clone(&e.inst_func_names)
    glob.inst_funcs = function_list_clone(&e.inst_funcs)
    return FuncEmitResult { text: text, lines: e.emit_lines }
}

struct CompileStats {
    func_count: i64,
    total_lines: i64,
    max_lines: i64,
    max_func: String,
    string_count: i64,
    const_count: i64,
}

fn compile_stats_new() -> CompileStats {
    return CompileStats { func_count: 0, total_lines: 0, max_lines: 0, max_func: "", string_count: 0, const_count: 0 }
}

fn compile_to_qbe(prog: Program) -> String {
    let mut stats = compile_stats_new()
    return compile_to_qbe_with_stats(prog, &mut stats)
}

fn compile_to_qbe_with_stats(prog: Program, stats: &mut CompileStats) -> String {
    let mut glob = emitter_new()
    collect_type_aliases(&mut glob, &prog)
    collect_structs(&mut glob, &prog)
    collect_enums(&mut glob, &prog)
    collect_funcs(&mut glob, &prog)
    collect_impls(&mut glob, &prog)
    collect_consts(&mut glob, &prog)
    collect_strings(&mut glob, &prog)
    stats.string_count = len(&glob.strings)
    stats.const_count = len(&glob.const_names)

    let mut out_funcs = ""
    let mut i = 0
    while i < len(&prog.functions) {
        let f = &prog.functions[i]
        if !f.is_macro {
            let res = emit_compiled_function(&mut glob, f)
            out_funcs = out_funcs + res.text + "\n"
            stats.func_count = stats.func_count + 1
            stats.total_lines = stats.total_lines + res.lines
            if res.lines > stats.max_lines {
                stats.max_lines = res.lines
                stats.max_func = f.name
            }
        }
        i = i + 1
    }
    let mut inst_i = 0
    while inst_i < len(&glob.inst_funcs) {
        let res = emit_compiled_function(&mut glob, &glob.inst_funcs[inst_i])
        out_funcs = out_funcs + res.text + "\n"
        stats.func_count = stats.func_count + 1
        stats.total_lines = stats.total_lines + res.lines
        if res.lines > stats.max_lines {
            stats.max_lines = res.lines
            stats.max_func = glob.inst_funcs[inst_i].name
        }
        inst_i = inst_i + 1
    }
    let data = emit_string_data(&glob)
    return data + out_funcs
}

fn c_ret_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "int32_t" }
    return "int64_t"
}

fn main_ret_type(prog: &Program) -> String {
    let mut e = emitter_new()
    collect_type_aliases(&mut e, prog)
    let mut i = 0
    while i < len(&prog.functions) {
        let f = &prog.functions[i]
        if !f.is_macro && f.name == "main" { return effective_ret_type(&e, f) }
        i = i + 1
    }
    return "unit"
}

fn build_entry_c(e: &Emitter, main_ret_t: &str) -> String {
    // Keep it tiny; args() is rarely needed in early tests.
    let mut out = ""
    out = out + "#include <stdint.h>\n\n"
    out = out + "void dast_set_args(int argc, char **argv);\n"
    let c_rt = c_ret_type(e, main_ret_t)
    out = out + c_rt + " dast_user_main(void);\n\n"
    out = out + "int main(int argc, char **argv) {\n"
    out = out + "    dast_set_args(argc - 1, argv + 1);\n"
    out = out + "    " + c_rt + " r = dast_user_main();\n"
    out = out + "    return (int)r;\n"
    out = out + "}\n"
    return out
}

fn run_exec(cmd: String, args: [String]) {
    let code = exec(cmd, args)
    if code != 0 {
        println("exec failed", code)
        exit(code)
    }
}

fn load_prelude_dir(dir: String) -> String {
    let names = read_dir(string_clone(&dir))
    let mut out = ""
    let mut i = 0
    while i < len(&names) {
        let name = names[i]
        if str_has_suffix(&name, ".dast") {
            let path = string_clone(&dir) + "/" + name
            let text = read_file(path)
            out = out + text + "\n"
        }
        i = i + 1
    }
    return out
}

fn compile_native_single(src_path: String, out_bin: String) {
    let src = read_file(src_path)
    let prelude_dir = "compiler/stage2/stdlib/prelude"
    let prelude = load_prelude_dir(prelude_dir)
    let src_all = prelude + "\n" + src
    let prog = macro_expand_program(parse_program(&src_all))
    let mut alias_e = emitter_new()
    collect_type_aliases(&mut alias_e, &prog)
    let main_rt = main_ret_type(&prog)
    let qbe = compile_to_qbe(prog)

    // Use a deterministic target directory.
    let target_dir = "compiler/stage2/target/min"
    mkdir(target_dir)
    let qbe_path = target_dir + "/main.qbe"
    let asm_path = target_dir + "/main.s"
    let entry_path = target_dir + "/entry.c"
    let runtime_path = "compiler/bootstrap/stage0/runtime/c_runtime.c"

    write_file(qbe_path, qbe)
    write_file(entry_path, build_entry_c(&alias_e, &main_rt))

    run_exec("qbe", ["-o", string_clone(&asm_path), string_clone(&qbe_path)])
    run_exec("cc", ["-O2", "-std=c99", string_clone(&asm_path), runtime_path, entry_path, "-o", out_bin])
}

fn compile_native_single_stats(src_path: String, out_bin: String) {
    let src = read_file(src_path)
    let prelude_dir = "compiler/stage2/stdlib/prelude"
    let prelude = load_prelude_dir(prelude_dir)
    let src_all = prelude + "\n" + src
    let prog = macro_expand_program(parse_program(&src_all))
    let mut alias_e = emitter_new()
    collect_type_aliases(&mut alias_e, &prog)
    let main_rt = main_ret_type(&prog)
    let mut stats = compile_stats_new()
    let qbe = compile_to_qbe_with_stats(prog, &mut stats)

    println("stats", "funcs", stats.func_count, "lines", stats.total_lines, "strings", stats.string_count, "consts", stats.const_count)
    if stats.max_func != "" {
        println("stats-max-func", stats.max_func, stats.max_lines)
    }

    let target_dir = "compiler/stage2/target/min"
    mkdir(target_dir)
    let qbe_path = target_dir + "/main.qbe"
    let asm_path = target_dir + "/main.s"
    let entry_path = target_dir + "/entry.c"
    let runtime_path = "compiler/bootstrap/stage0/runtime/c_runtime.c"

    write_file(qbe_path, qbe)
    write_file(entry_path, build_entry_c(&alias_e, &main_rt))

    run_exec("qbe", ["-o", string_clone(&asm_path), string_clone(&qbe_path)])
    run_exec("cc", ["-O2", "-std=c99", string_clone(&asm_path), runtime_path, entry_path, "-o", out_bin])
}

fn compile_and_run_single(src_path: String, run_args: [String]) {
    let out_bin = "compiler/stage2/target/min/main"
    compile_native_single(src_path, string_clone(&out_bin))
    let _ = exec(out_bin, run_args)
}
