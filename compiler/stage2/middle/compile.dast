struct CompileResult {
    prog: IrProgram,
    errors: [ParseError],
}

struct NameCount {
    name: String,
    count: i32,
}

struct Compiler {
    tctx: TypeContext,
    structs: [StructDecl],
    enums: [EnumDecl],
    consts: [ConstDecl],
    name_counts: [NameCount],
    scope_names: [String],
    scope_ir: [String],
    scope_marks: [i32],
    blocks: [IrBlock],
    cur_block: i32,
    block_id: i32,
    temp_id: i32,
}

fn name_count_list_new() -> [NameCount] {
    let mut items: [NameCount] = []
    return items
}

fn string_list_new() -> [String] {
    let mut items: [String] = []
    return items
}

fn int_list_new() -> [i32] {
    let mut items: [i32] = []
    return items
}

fn block_list_new() -> [IrBlock] {
    let mut items: [IrBlock] = []
    return items
}

fn instr_list_new() -> [IrInstr] {
    let mut items: [IrInstr] = []
    return items
}

fn compiler_add_type_error(c: &mut Compiler, msg: String) {
    let mut tctx = c.tctx
    add_type_error(&mut tctx, msg)
    c.tctx = tctx
}

fn compiler_check_expr(c: &mut Compiler, expr: Expr) -> i32 {
    let mut tctx = c.tctx
    let t = check_expr(&mut tctx, expr)
    c.tctx = tctx
    return t
}

fn compiler_parse_type(c: &mut Compiler, text: String, self_name: String) -> i32 {
    let mut tctx = c.tctx
    let t = ctx_parse_type(&mut tctx, text, self_name)
    c.tctx = tctx
    return t
}

fn compiler_resolve_struct_name(c: &mut Compiler, name: String) -> String {
    let mut tctx = c.tctx
    let q = resolve_struct_name(&mut tctx, name)
    c.tctx = tctx
    return q
}

fn compiler_resolve_func_name(c: &mut Compiler, name: String) -> String {
    let mut tctx = c.tctx
    let q = resolve_func_name(&mut tctx, name)
    c.tctx = tctx
    return q
}

fn compiler_resolve_enum_name(c: &mut Compiler, name: String) -> String {
    let mut tctx = c.tctx
    let q = resolve_enum_name(&mut tctx, name)
    c.tctx = tctx
    return q
}

fn compiler_resolve_const_name(c: &mut Compiler, name: String) -> String {
    let mut tctx = c.tctx
    let q = resolve_const_name(&mut tctx, name)
    c.tctx = tctx
    return q
}

fn compiler_resolve_reexport_func(c: &mut Compiler, module: String, name: String) -> String {
    let mut tctx = c.tctx
    let q = resolve_reexport(&mut tctx, module, name, reexport_kind_func())
    c.tctx = tctx
    return q
}

fn compiler_resolve_type_name(c: &mut Compiler, name: String, self_name: String) -> String {
    let mut tctx = c.tctx
    let q = ctx_resolve_type_name(&mut tctx, name, self_name)
    c.tctx = tctx
    return q
}

fn compiler_parse_type_in_module(c: &mut Compiler, text: String, self_name: String, module: String) -> i32 {
    let mut tctx = c.tctx
    let t = ctx_parse_type_in_module(&mut tctx, text, self_name, module)
    c.tctx = tctx
    return t
}

fn compiler_type_make(c: &mut Compiler, kind: i32, name: String, is_ref: bool, is_mut: bool, elem: i32) -> i32 {
    let mut tctx = c.tctx
    let t = ctx_type_make(&mut tctx, kind, name, is_ref, is_mut, elem)
    c.tctx = tctx
    return t
}

fn compiler_env_push(c: &mut Compiler) {
    let mut tctx = c.tctx
    ctx_env_push(&mut tctx)
    c.tctx = tctx
}

fn compiler_env_pop(c: &mut Compiler) {
    let mut tctx = c.tctx
    ctx_env_pop(&mut tctx)
    c.tctx = tctx
}

fn compiler_env_declare(c: &mut Compiler, name: String, typ: i32, mutable: bool) {
    let mut tctx = c.tctx
    ctx_env_declare(&mut tctx, name, typ, mutable)
    c.tctx = tctx
}

fn compiler_type_is_ref(c: &Compiler, t: i32) -> bool {
    let tctx = c.tctx
    return ctx_type_is_ref(&tctx, t)
}

fn compiler_type_kind(c: &Compiler, t: i32) -> i32 {
    let tctx = c.tctx
    return ctx_type_kind(&tctx, t)
}

fn compiler_type_name(c: &Compiler, t: i32) -> String {
    let tctx = c.tctx
    return ctx_type_name(&tctx, t)
}

fn compiler_type_string(c: &Compiler, t: i32) -> String {
    let tctx = c.tctx
    return ctx_type_string(&tctx, t)
}

fn compiler_deref_type(c: &mut Compiler, t: i32) -> i32 {
    let mut tctx = c.tctx
    let base = ctx_deref_type(&mut tctx, t)
    c.tctx = tctx
    return base
}

fn compiler_find_method(c: &Compiler, type_name: String, name: String) -> i32 {
    let tctx = c.tctx
    return find_method(&tctx, type_name, name)
}

fn compile_program(prog: Program, tctx: TypeContext) -> CompileResult {
    let mut c = Compiler {
        tctx: tctx,
        structs: prog.structs,
        enums: prog.enums,
        consts: prog.consts,
        name_counts: name_count_list_new(),
        scope_names: string_list_new(),
        scope_ir: string_list_new(),
        scope_marks: int_list_new(),
        blocks: block_list_new(),
        cur_block: -1,
        block_id: 0,
        temp_id: 0,
    }
    let mut funcs: [IrFunction] = []
    let mut entry = ""
    let mut i = 0
    while i < len(prog.functions) {
        let decl = prog.functions[i]
        let qname = qualify_name(decl.module, decl.name)
        let f = compile_function(&mut c, decl, qname, "")
        push(&mut funcs, f)
        if entry == "" && decl.module == "" && decl.name == "main" {
            entry = qname
        }
        i = i + 1
    }
    let mut j = 0
    while j < len(prog.impls) {
        let imp = prog.impls[j]
        let mut tctx = c.tctx
        ctx_set_current_module(&mut tctx, imp.module)
        c.tctx = tctx
        let type_qname = compiler_resolve_type_name(&mut c, imp.type_name, "")
        if type_qname != "" {
            let mut k = 0
            while k < len(imp.methods) {
                let m = imp.methods[k]
                let name = type_qname + "." + m.name
                let f = compile_function(&mut c, m, name, type_qname)
                push(&mut funcs, f)
                k = k + 1
            }
        }
        j = j + 1
    }
    let ir_prog = IrProgram { version: "v0", features: string_list_new(), functions: funcs, entry: entry }
    return CompileResult { prog: ir_prog, errors: c.tctx.errors }
}

fn compiler_module_alias(c: &Compiler, name: String) -> String {
    let tctx = c.tctx
    return module_alias_module(&tctx, name)
}

fn compile_function(c: &mut Compiler, f: FunctionDecl, name: String, self_name: String) -> IrFunction {
    c.block_id = 0
    c.temp_id = 0
    c.name_counts = name_count_list_new()
    c.scope_names = string_list_new()
    c.scope_ir = string_list_new()
    c.scope_marks = int_list_new()
    c.blocks = block_list_new()
    c.cur_block = -1
    let mut tctx = c.tctx
    ctx_set_current_module(&mut tctx, f.module)
    tctx.env = env_new()
    c.tctx = tctx
    compiler_env_push(c)

    let mut params: [String] = []
    let mut param_types: [String] = []
    let mut i = 0
    while i < len(f.params) {
        let p = f.params[i]
        let t = compiler_parse_type(c, p.typ, self_name)
        let ir_name = declare_var(c, p.name, t, false)
        push(&mut params, ir_name)
        push(&mut param_types, compiler_type_string(c, t))
        i = i + 1
    }

    let mut return_type = ""
    if f.has_return {
        let rt = compiler_parse_type(c, f.ret, self_name)
        return_type = compiler_type_string(c, rt)
    }

    let entry_block = new_block(c, "entry")
    set_current_block(c, entry_block)
    compile_function_body(c, f, self_name)
    if !current_block_has_term(c) {
        emit_term(c, IrTerm.Return(IrReturn { has_value: false, value: -1 }))
    }

    compiler_env_pop(c)
    let blocks = c.blocks
    let func = IrFunction { name: name, params: params, param_types: param_types, return_type: return_type, blocks: blocks, temp_count: c.temp_id }
    return func
}

fn compile_function_body(c: &mut Compiler, f: FunctionDecl, self_name: String) {
    let mut allow_implicit = true
    if f.has_return {
        if is_unit_type_text(f.ret) {
            allow_implicit = false
        }
    }
    compile_block_with_tail(c, f.body, allow_implicit, self_name)
}

fn is_unit_type_text(text: String) -> bool {
    if text == "unit" || text == "()" {
        return true
    }
    return false
}

fn compile_block_with_tail(c: &mut Compiler, block: Block, allow_implicit: bool, self_name: String) {
    if !allow_implicit {
        compile_block(c, block, self_name)
        return
    }
    push_scope(c)
    let mut i = 0
    while i < len(block.stmts) && !current_block_has_term(c) {
        if i == len(block.stmts) - 1 {
            match block.stmts[i] {
                .Expr(e) => {
                    let v = compile_expr(c, e.expr, self_name)
                    emit_term(c, IrTerm.Return(IrReturn { has_value: true, value: v }))
                    pop_scope(c)
                    return
                }
                Stmt.If(s) => {
                    compile_tail_if(c, s, allow_implicit, self_name)
                    pop_scope(c)
                    return
                }
                Stmt.Match(m) => {
                    compile_tail_match(c, m, allow_implicit, self_name)
                    pop_scope(c)
                    return
                }
                _ => {
                }
            }
        }
        compile_stmt(c, block.stmts[i], self_name)
        i = i + 1
    }
    pop_scope(c)
}

fn compile_block(c: &mut Compiler, block: Block, self_name: String) {
    push_scope(c)
    let mut i = 0
    while i < len(block.stmts) && !current_block_has_term(c) {
        compile_stmt(c, block.stmts[i], self_name)
        i = i + 1
    }
    pop_scope(c)
}

fn compile_stmt(c: &mut Compiler, stmt: Stmt, self_name: String) {
    match stmt {
        Stmt.Let(s) => { compile_let(c, s, self_name) }
        Stmt.Assign(s) => { compile_assign(c, s, self_name) }
        .Expr(s) => { compile_expr(c, s.expr, self_name) }
        Stmt.Return(s) => { compile_return(c, s, self_name) }
        Stmt.If(s) => { compile_if(c, s, self_name) }
        Stmt.While(s) => { compile_while(c, s, self_name) }
        Stmt.Match(s) => { compile_match(c, s, self_name) }
    }
}

fn compile_let(c: &mut Compiler, s: LetStmt, self_name: String) {
    if !s.has_init {
        compiler_add_type_error(c, "let requires initializer")
        return
    }
    let init_t = compiler_check_expr(c, s.init)
    let mut decl_t = init_t
    if s.has_type {
        decl_t = compiler_parse_type(c, s.typ, self_name)
    }
    let name = declare_var(c, s.name, decl_t, s.mutable)
    let val = compile_expr(c, s.init, self_name)
    emit_instr(c, IrInstr.StoreVar(IrStoreVar { name: name, src: val }))
}

fn compile_assign(c: &mut Compiler, s: AssignStmt, self_name: String) {
    match s.target {
        Expr.Ident(id) => {
            let ir_name = lookup_var(c, id.name)
            if ir_name == "" {
                compiler_add_type_error(c, "undefined variable '" + id.name + "'")
                return
            }
            let val = compile_expr(c, s.value, self_name)
            emit_instr(c, IrInstr.StoreVar(IrStoreVar { name: ir_name, src: val }))
        }
        .Deref(d) => {
            let r = compile_expr(c, d.expr, self_name)
            let val = compile_expr(c, s.value, self_name)
            emit_instr(c, IrInstr.StoreRef(IrStoreRef { ref: r, src: val }))
        }
        Expr.Index(ix) => {
            let recv = compile_expr(c, ix.recv, self_name)
            let idx = compile_expr(c, ix.index, self_name)
            let val = compile_expr(c, s.value, self_name)
            emit_instr(c, IrInstr.SetIndex(IrSetIndex { array: recv, index: idx, src: val }))
        }
        .Field(f) => {
            let recv = compile_expr(c, f.recv, self_name)
            let val = compile_expr(c, s.value, self_name)
            emit_instr(c, IrInstr.SetField(IrSetField { src: recv, field: f.name, value: val }))
        }
        _ => {
            compiler_add_type_error(c, "invalid assignment target")
        }
    }
}

fn compile_return(c: &mut Compiler, s: ReturnStmt, self_name: String) {
    if !s.has_value {
        emit_term(c, IrTerm.Return(IrReturn { has_value: false, value: -1 }))
        return
    }
    let val = compile_expr(c, s.value, self_name)
    emit_term(c, IrTerm.Return(IrReturn { has_value: true, value: val }))
}

fn compile_if(c: &mut Compiler, s: IfStmt, self_name: String) {
    let cond = compile_expr(c, s.cond, self_name)
    let then_block = new_block(c, "then")
    let else_block = new_block(c, "else")
    let merge_block = new_block(c, "merge")
    emit_term(c, IrTerm.Branch(IrBranch { cond: cond, then_label: block_label(c, then_block), else_label: block_label(c, else_block) }))

    set_current_block(c, then_block)
    compile_block(c, s.then_block, self_name)
    if !current_block_has_term(c) {
        emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, merge_block) }))
    }

    set_current_block(c, else_block)
    if s.has_else {
        compile_block(c, s.else_block, self_name)
    }
    if !current_block_has_term(c) {
        emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, merge_block) }))
    }

    set_current_block(c, merge_block)
}

fn compile_tail_if(c: &mut Compiler, s: IfStmt, allow_implicit: bool, self_name: String) {
    if !s.has_else {
        compile_if(c, s, self_name)
        return
    }
    let cond = compile_expr(c, s.cond, self_name)
    let then_block = new_block(c, "then")
    let else_block = new_block(c, "else")
    let merge_block = new_block(c, "merge")
    emit_term(c, IrTerm.Branch(IrBranch { cond: cond, then_label: block_label(c, then_block), else_label: block_label(c, else_block) }))

    set_current_block(c, then_block)
    compile_block_with_tail(c, s.then_block, allow_implicit, self_name)
    if !current_block_has_term(c) {
        emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, merge_block) }))
    }

    set_current_block(c, else_block)
    compile_block_with_tail(c, s.else_block, allow_implicit, self_name)
    if !current_block_has_term(c) {
        emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, merge_block) }))
    }

    set_current_block(c, merge_block)
}

fn compile_while(c: &mut Compiler, s: WhileStmt, self_name: String) {
    let cond_block = new_block(c, "cond")
    let body_block = new_block(c, "body")
    let after_block = new_block(c, "after")
    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, cond_block) }))

    set_current_block(c, cond_block)
    let cond = compile_expr(c, s.cond, self_name)
    emit_term(c, IrTerm.Branch(IrBranch { cond: cond, then_label: block_label(c, body_block), else_label: block_label(c, after_block) }))

    set_current_block(c, body_block)
    compile_block(c, s.body, self_name)
    if !current_block_has_term(c) {
        emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, cond_block) }))
    }

    set_current_block(c, after_block)
}

fn resolve_struct_pattern_name(c: &mut Compiler, name: String, scrut_type: i32) -> String {
    let mut q = compiler_resolve_struct_name(c, name)
    if q == "" { q = name }
    if q == "" {
        q = struct_name_for_type(c, scrut_type)
    }
    return q
}

fn emit_pattern_check(c: &mut Compiler, pat: Pattern, value: i32, value_type: i32, self_name: String, next_label: String) {
    match pat {
        .Wildcard(_) => {}
        .Literal(lp) => {
            let const_val = new_temp(c)
            let tname = compiler_type_name(c, value_type)
            emit_instr(c, IrInstr.Const(IrConst { dst: const_val, value: const_to_ir(lp.value, tname) }))
            let cmp = new_temp(c)
            emit_instr(c, IrInstr.BinOp(IrBinOp { dst: cmp, op: "==", lhs: value, rhs: const_val }))
            let cont = new_block(c, "match_check")
            emit_term(c, IrTerm.Branch(IrBranch { cond: cmp, then_label: block_label(c, cont), else_label: next_label }))
            set_current_block(c, cont)
        }
        .Variant(vp) => {
            let mut pat_enum = enum_name_for_type(c, value_type)
            if vp.enum_name != "" {
                pat_enum = compiler_resolve_enum_name(c, vp.enum_name)
            }
            let tag_info = enum_tag_info(c, pat_enum, vp.variant)
            if !tag_info.ok {
                compiler_add_type_error(c, "unknown enum variant '" + vp.variant + "'")
            }
            let tag = new_temp(c)
            emit_instr(c, IrInstr.EnumTag(IrEnumTag { dst: tag, src: value }))
            let const_tag = new_temp(c)
            emit_instr(c, IrInstr.Const(IrConst { dst: const_tag, value: ir_value_int_t(tag_info.tag, tag_info.tag_type) }))
            let cmp = new_temp(c)
            emit_instr(c, IrInstr.BinOp(IrBinOp { dst: cmp, op: "==", lhs: tag, rhs: const_tag }))
            let cont = new_block(c, "match_check")
            emit_term(c, IrTerm.Branch(IrBranch { cond: cmp, then_label: block_label(c, cont), else_label: next_label }))
            set_current_block(c, cont)
        }
        Pattern.Struct(sp) => {
            emit_struct_pattern_checks(c, sp, value, value_type, self_name, next_label)
        }
    }
}

fn emit_struct_pattern_checks(c: &mut Compiler, sp: StructPattern, scrut: i32, scrut_type: i32, self_name: String, next_label: String) {
    let struct_name = resolve_struct_pattern_name(c, sp.name, scrut_type)
    let sidx = find_struct_decl(c.structs, struct_name)
    if sidx < 0 {
        compiler_add_type_error(c, "unknown struct '" + struct_name + "'")
        return
    }
    let st = c.structs[sidx]
    let mut i = 0
    while i < len(sp.fields) {
        let f = sp.fields[i]
        if f.has_pattern {
            let field_val = new_temp(c)
            emit_instr(c, IrInstr.GetField(IrGetField { dst: field_val, src: scrut, field: f.name }))
            let ft = struct_field_type(c, struct_name, f.name, self_name)
            emit_pattern_check(c, f.pattern, field_val, ft, self_name, next_label)
        }
        i = i + 1
    }
}

fn bind_struct_pattern(c: &mut Compiler, sp: StructPattern, scrut: i32, scrut_type: i32, self_name: String) {
    let struct_name = resolve_struct_pattern_name(c, sp.name, scrut_type)
    let sidx = find_struct_decl(c.structs, struct_name)
    if sidx < 0 {
        compiler_add_type_error(c, "unknown struct '" + struct_name + "'")
        return
    }
    let st = c.structs[sidx]
    let mut i = 0
    while i < len(sp.fields) {
        let f = sp.fields[i]
        let fidx = find_field(st, f.name)
        if fidx < 0 {
            compiler_add_type_error(c, "unknown field '" + f.name + "'")
        } else {
            let ft = compiler_parse_type_in_module(c, st.fields[fidx].typ, self_name, st.module)
            let field_val = new_temp(c)
            emit_instr(c, IrInstr.GetField(IrGetField { dst: field_val, src: scrut, field: f.name }))
            if f.bind {
                let name = declare_var(c, f.name, ft, false)
                emit_instr(c, IrInstr.StoreVar(IrStoreVar { name: name, src: field_val }))
            } else if f.has_pattern {
                match f.pattern {
                    .Variant(vp) => {
                        if vp.has_binding {
                            let mut pat_enum = enum_name_for_type(c, ft)
                            if vp.enum_name != "" {
                                pat_enum = compiler_resolve_enum_name(c, vp.enum_name)
                            }
                            let payload_type = variant_payload_type(c, pat_enum, vp.variant, self_name)
                            let payload = new_temp(c)
                            emit_instr(c, IrInstr.EnumPayload(IrEnumPayload { dst: payload, src: field_val }))
                            let name = declare_var(c, vp.binding, payload_type, false)
                            emit_instr(c, IrInstr.StoreVar(IrStoreVar { name: name, src: payload }))
                        }
                    }
                    Pattern.Struct(sp2) => {
                        bind_struct_pattern(c, sp2, field_val, ft, self_name)
                    }
                    _ => {}
                }
            }
        }
        i = i + 1
    }
}

fn compile_match(c: &mut Compiler, s: MatchStmt, self_name: String) {
    let mut scrut = compile_expr(c, s.expr, self_name)
    let mut scrut_type = compiler_check_expr(c, s.expr)
    if compiler_type_is_ref(c, scrut_type) {
        let base = compiler_deref_type(c, scrut_type)
        let tmp = new_temp(c)
        emit_instr(c, IrInstr.LoadRef(IrLoadRef { dst: tmp, src: scrut }))
        scrut = tmp
        scrut_type = base
    }
    let after = new_block(c, "match_after")
    let scrut_kind = compiler_type_kind(c, scrut_type)
    let mut scrut_name = ""
    if scrut_kind == 6 || scrut_kind == 5 {
        scrut_name = compiler_type_name(c, scrut_type)
    }
    let mut i = 0
    while i < len(s.arms) {
        let arm = s.arms[i]
        let arm_block = new_block(c, "match_arm")
        match arm.pattern {
            .Wildcard(_) => {
                emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, arm_block) }))
                let mut next_label = block_label(c, after)
                let mut next_block = -1
                if i != len(s.arms) - 1 {
                    next_block = new_block(c, "match_next")
                    next_label = block_label(c, next_block)
                }
                set_current_block(c, arm_block)
                compile_match_arm(c, arm, scrut, scrut_type, scrut_name, self_name, false, next_label)
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
                if next_block >= 0 {
                    set_current_block(c, next_block)
                } else {
                    set_current_block(c, after)
                }
            }
            .Variant(vp) => {
                if scrut_kind != 6 {
                    compiler_add_type_error(c, "enum pattern requires enum expression")
                }
                let mut pat_enum = scrut_name
                if vp.enum_name != "" {
                    pat_enum = compiler_resolve_enum_name(c, vp.enum_name)
                }
                let tag_info = enum_tag_info(c, pat_enum, vp.variant)
                if !tag_info.ok {
                    compiler_add_type_error(c, "unknown enum variant '" + vp.variant + "'")
                }
                let tag = new_temp(c)
                emit_instr(c, IrInstr.EnumTag(IrEnumTag { dst: tag, src: scrut }))
                let const_tag = new_temp(c)
                emit_instr(c, IrInstr.Const(IrConst { dst: const_tag, value: ir_value_int_t(tag_info.tag, tag_info.tag_type) }))
                let cmp = new_temp(c)
                emit_instr(c, IrInstr.BinOp(IrBinOp { dst: cmp, op: "==", lhs: tag, rhs: const_tag }))
                let next = new_block(c, "match_next")
                emit_term(c, IrTerm.Branch(IrBranch { cond: cmp, then_label: block_label(c, arm_block), else_label: block_label(c, next) }))
                set_current_block(c, arm_block)
                compile_match_arm(c, arm, scrut, scrut_type, scrut_name, self_name, false, block_label(c, next))
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
                set_current_block(c, next)
                if i == len(s.arms) - 1 {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
            }
            Pattern.Struct(sp) => {
                if scrut_kind != 5 {
                    compiler_add_type_error(c, "struct pattern requires struct expression")
                }
                let next = new_block(c, "match_next")
                let check_block = new_block(c, "match_check")
                emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, check_block) }))
                set_current_block(c, check_block)
                emit_struct_pattern_checks(c, sp, scrut, scrut_type, self_name, block_label(c, next))
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, arm_block) }))
                }
                set_current_block(c, arm_block)
                compile_match_arm(c, arm, scrut, scrut_type, scrut_name, self_name, false, block_label(c, next))
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
                set_current_block(c, next)
                if i == len(s.arms) - 1 {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
            }
            .Literal(lp) => {
                if scrut_kind != 1 && scrut_kind != 2 && scrut_kind != 3 {
                    compiler_add_type_error(c, "literal pattern requires int, bool, or string expression")
                }
                let const_val = new_temp(c)
                let tname = compiler_type_name(c, scrut_type)
                emit_instr(c, IrInstr.Const(IrConst { dst: const_val, value: const_to_ir(lp.value, tname) }))
                let cmp = new_temp(c)
                emit_instr(c, IrInstr.BinOp(IrBinOp { dst: cmp, op: "==", lhs: scrut, rhs: const_val }))
                let next = new_block(c, "match_next")
                emit_term(c, IrTerm.Branch(IrBranch { cond: cmp, then_label: block_label(c, arm_block), else_label: block_label(c, next) }))
                set_current_block(c, arm_block)
                compile_match_arm(c, arm, scrut, scrut_type, scrut_name, self_name, false, block_label(c, next))
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
                set_current_block(c, next)
                if i == len(s.arms) - 1 {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
            }
        }
        i = i + 1
    }
    if c.cur_block != after && !current_block_has_term(c) {
        emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
    }
    set_current_block(c, after)
}

fn compile_tail_match(c: &mut Compiler, s: MatchStmt, allow_implicit: bool, self_name: String) {
    let mut scrut = compile_expr(c, s.expr, self_name)
    let mut scrut_type = compiler_check_expr(c, s.expr)
    if compiler_type_is_ref(c, scrut_type) {
        let base = compiler_deref_type(c, scrut_type)
        let tmp = new_temp(c)
        emit_instr(c, IrInstr.LoadRef(IrLoadRef { dst: tmp, src: scrut }))
        scrut = tmp
        scrut_type = base
    }
    let after = new_block(c, "match_after")
    let scrut_kind = compiler_type_kind(c, scrut_type)
    let mut scrut_name = ""
    if scrut_kind == 6 || scrut_kind == 5 {
        scrut_name = compiler_type_name(c, scrut_type)
    }
    let mut i = 0
    while i < len(s.arms) {
        let arm = s.arms[i]
        let arm_block = new_block(c, "match_arm")
        match arm.pattern {
            .Wildcard(_) => {
                emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, arm_block) }))
                let mut next_label = block_label(c, after)
                let mut next_block = -1
                if i != len(s.arms) - 1 {
                    next_block = new_block(c, "match_next")
                    next_label = block_label(c, next_block)
                }
                set_current_block(c, arm_block)
                compile_match_arm(c, arm, scrut, scrut_type, scrut_name, self_name, allow_implicit, next_label)
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
                if next_block >= 0 {
                    set_current_block(c, next_block)
                } else {
                    set_current_block(c, after)
                }
            }
            .Variant(vp) => {
                if scrut_kind != 6 {
                    compiler_add_type_error(c, "enum pattern requires enum expression")
                }
                let mut pat_enum = scrut_name
                if vp.enum_name != "" {
                    pat_enum = compiler_resolve_enum_name(c, vp.enum_name)
                }
                let tag_info = enum_tag_info(c, pat_enum, vp.variant)
                if !tag_info.ok {
                    compiler_add_type_error(c, "unknown enum variant '" + vp.variant + "'")
                }
                let tag = new_temp(c)
                emit_instr(c, IrInstr.EnumTag(IrEnumTag { dst: tag, src: scrut }))
                let const_tag = new_temp(c)
                emit_instr(c, IrInstr.Const(IrConst { dst: const_tag, value: ir_value_int_t(tag_info.tag, tag_info.tag_type) }))
                let cmp = new_temp(c)
                emit_instr(c, IrInstr.BinOp(IrBinOp { dst: cmp, op: "==", lhs: tag, rhs: const_tag }))
                let next = new_block(c, "match_next")
                emit_term(c, IrTerm.Branch(IrBranch { cond: cmp, then_label: block_label(c, arm_block), else_label: block_label(c, next) }))
                set_current_block(c, arm_block)
                compile_match_arm(c, arm, scrut, scrut_type, scrut_name, self_name, allow_implicit, block_label(c, next))
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
                set_current_block(c, next)
                if i == len(s.arms) - 1 {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
            }
            Pattern.Struct(sp) => {
                if scrut_kind != 5 {
                    compiler_add_type_error(c, "struct pattern requires struct expression")
                }
                let next = new_block(c, "match_next")
                let check_block = new_block(c, "match_check")
                emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, check_block) }))
                set_current_block(c, check_block)
                emit_struct_pattern_checks(c, sp, scrut, scrut_type, self_name, block_label(c, next))
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, arm_block) }))
                }
                set_current_block(c, arm_block)
                compile_match_arm(c, arm, scrut, scrut_type, scrut_name, self_name, allow_implicit, block_label(c, next))
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
                set_current_block(c, next)
                if i == len(s.arms) - 1 {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
            }
            .Literal(lp) => {
                if scrut_kind != 1 && scrut_kind != 2 && scrut_kind != 3 {
                    compiler_add_type_error(c, "literal pattern requires int, bool, or string expression")
                }
                let const_val = new_temp(c)
                let tname = compiler_type_name(c, scrut_type)
                emit_instr(c, IrInstr.Const(IrConst { dst: const_val, value: const_to_ir(lp.value, tname) }))
                let cmp = new_temp(c)
                emit_instr(c, IrInstr.BinOp(IrBinOp { dst: cmp, op: "==", lhs: scrut, rhs: const_val }))
                let next = new_block(c, "match_next")
                emit_term(c, IrTerm.Branch(IrBranch { cond: cmp, then_label: block_label(c, arm_block), else_label: block_label(c, next) }))
                set_current_block(c, arm_block)
                compile_match_arm(c, arm, scrut, scrut_type, scrut_name, self_name, allow_implicit, block_label(c, next))
                if !current_block_has_term(c) {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
                set_current_block(c, next)
                if i == len(s.arms) - 1 {
                    emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
                }
            }
        }
        i = i + 1
    }
    if c.cur_block != after && !current_block_has_term(c) {
        emit_term(c, IrTerm.Jump(IrJump { target: block_label(c, after) }))
    }
    set_current_block(c, after)
}

fn compile_match_arm(c: &mut Compiler, arm: MatchArm, scrut: i32, scrut_type: i32, scrut_name: String, self_name: String, allow_implicit: bool, next_label: String) {
    push_scope(c)
    match arm.pattern {
        .Variant(vp) => {
            let mut pat_enum = scrut_name
            if vp.enum_name != "" {
                pat_enum = compiler_resolve_enum_name(c, vp.enum_name)
            }
            if vp.has_binding {
                let payload = new_temp(c)
                emit_instr(c, IrInstr.EnumPayload(IrEnumPayload { dst: payload, src: scrut }))
                let payload_type = variant_payload_type(c, pat_enum, vp.variant, self_name)
                let name = declare_var(c, vp.binding, payload_type, false)
                emit_instr(c, IrInstr.StoreVar(IrStoreVar { name: name, src: payload }))
            }
        }
        Pattern.Struct(sp) => {
            bind_struct_pattern(c, sp, scrut, scrut_type, self_name)
        }
        _ => {}
    }
    if arm.has_guard {
        let cond = compile_expr(c, arm.guard, self_name)
        let body_block = new_block(c, "match_body")
        emit_term(c, IrTerm.Branch(IrBranch { cond: cond, then_label: block_label(c, body_block), else_label: next_label }))
        set_current_block(c, body_block)
    }
    if allow_implicit {
        compile_block_with_tail(c, arm.body, allow_implicit, self_name)
    } else {
        compile_block(c, arm.body, self_name)
    }
    pop_scope(c)
}

fn compile_expr(c: &mut Compiler, expr: Expr, self_name: String) -> i32 {
    match expr {
        .IntLit(i) => {
            let v = parse_int(i.value)
            let t = new_temp(c)
            emit_instr(c, IrInstr.Const(IrConst { dst: t, value: ir_value_int(v) }))
            return t
        }
        .BoolLit(b) => {
            let t = new_temp(c)
            emit_instr(c, IrInstr.Const(IrConst { dst: t, value: ir_value_bool(b.value) }))
            return t
        }
        .StringLit(s) => {
            let v = parse_string_literal(s.value)
            let t = new_temp(c)
            emit_instr(c, IrInstr.Const(IrConst { dst: t, value: ir_value_string(v) }))
            return t
        }
        .ArrayLit(a) => {
            let mut elems: [i32] = []
            let mut i = 0
            while i < len(a.elems) {
                let v = compile_expr(c, a.elems[i], self_name)
                push(&mut elems, v)
                i = i + 1
            }
            let dst = new_temp(c)
            emit_instr(c, IrInstr.MakeArray(IrMakeArray { dst: dst, elems: elems }))
            return dst
        }
        Expr.Ident(id) => {
            let ir_name = lookup_var(c, id.name)
            if ir_name != "" {
                let t = new_temp(c)
                emit_instr(c, IrInstr.LoadVar(IrLoadVar { dst: t, name: ir_name }))
                return t
            }
            let cq = compiler_resolve_const_name(c, id.name)
            let cidx = find_const_decl(c.consts, cq)
            if cidx >= 0 {
                let mut tname = ""
                if c.consts[cidx].has_type { tname = c.consts[cidx].typ }
                let v = const_to_ir(c.consts[cidx].value, tname)
                let t = new_temp(c)
                emit_instr(c, IrInstr.Const(IrConst { dst: t, value: v }))
                return t
            }
            compiler_add_type_error(c, "undefined variable '" + id.name + "'")
            return const_zero(c)
        }
        .Ref(r) => {
            match r.expr {
                Expr.Ident(id) => {
                    let ir_name = lookup_var(c, id.name)
                    if ir_name == "" {
                        compiler_add_type_error(c, "undefined variable '" + id.name + "'")
                        return const_zero(c)
                    }
                    let t = new_temp(c)
                    emit_instr(c, IrInstr.AddrOf(IrAddrOf { dst: t, name: ir_name }))
                    return t
                }
                _ => {
                    compiler_add_type_error(c, "reference target must be identifier")
                    return const_zero(c)
                }
            }
        }
        .Deref(d) => {
            let src = compile_expr(c, d.expr, self_name)
            let t = new_temp(c)
            emit_instr(c, IrInstr.LoadRef(IrLoadRef { dst: t, src: src }))
            return t
        }
        .Unary(u) => {
            let src = compile_expr(c, u.expr, self_name)
            let t = new_temp(c)
            emit_instr(c, IrInstr.UnaryOp(IrUnaryOp { dst: t, op: op_string(u.op), src: src }))
            return t
        }
        .Binary(b) => {
            let l = compile_expr(c, b.left, self_name)
            let r = compile_expr(c, b.right, self_name)
            let t = new_temp(c)
            emit_instr(c, IrInstr.BinOp(IrBinOp { dst: t, op: op_string(b.op), lhs: l, rhs: r }))
            return t
        }
        Expr.Call(call) => {
            match call.callee {
                Expr.Ident(id) => {
                    let mut args: [i32] = []
                    let mut i = 0
                    while i < len(call.args) {
                        let v = compile_expr(c, call.args[i], self_name)
                        push(&mut args, v)
                        i = i + 1
                    }
                    let fq = compiler_resolve_func_name(c, id.name)
                    let mut callee = id.name
                    if fq != "" {
                        callee = fq
                    }
                    let dst = new_temp(c)
                    emit_instr(c, IrInstr.Call(IrCall { dst: dst, callee: callee, args: args }))
                    return dst
                }
                _ => {
                    compiler_add_type_error(c, "can only call identifiers in stage1")
                    return const_zero(c)
                }
            }
        }
        .MethodCall(m) => {
            let res = resolve_method_call(c, m.recv, m.method, self_name)
            if res.is_enum {
                let mut payload = -1
                if len(m.args) > 0 {
                    payload = compile_expr(c, m.args[0], self_name)
                }
                let tag_info = enum_tag_info(c, res.enum_name, res.method_name)
                if !tag_info.ok {
                    compiler_add_type_error(c, "unknown enum variant '" + res.method_name + "'")
                }
                let dst = new_temp(c)
                emit_instr(c, IrInstr.MakeEnum(IrMakeEnum { dst: dst, name: res.enum_name, variant: res.method_name, tag: tag_info.tag, tag_type: tag_info.tag_type, payload: payload }))
                return dst
            }
            let mut final_args: [i32] = []
            if res.with_self {
                let recv = compile_expr(c, m.recv, self_name)
                push(&mut final_args, recv)
            }
            let mut j = 0
            while j < len(m.args) {
                let v = compile_expr(c, m.args[j], self_name)
                push(&mut final_args, v)
                j = j + 1
            }
            let dst = new_temp(c)
            emit_instr(c, IrInstr.Call(IrCall { dst: dst, callee: res.callee, args: final_args }))
            return dst
        }
        .StructLit(s) => {
            let qname = compiler_resolve_struct_name(c, s.name)
            let mut struct_name = s.name
            if qname != "" {
                struct_name = qname
            }
            let mut fields: [IrStructFieldInit] = []
            let mut i = 0
            while i < len(s.fields) {
                let f = s.fields[i]
                let v = compile_expr(c, f.value, self_name)
                push(&mut fields, IrStructFieldInit { name: f.name, src: v })
                i = i + 1
            }
            let dst = new_temp(c)
            emit_instr(c, IrInstr.MakeStruct(IrMakeStruct { dst: dst, name: struct_name, fields: fields }))
            return dst
        }
        .Field(f) => {
            match f.recv {
                Expr.Ident(id) => {
                    if lookup_var(c, id.name) == "" {
                        let eq = compiler_resolve_enum_name(c, id.name)
                        let enum_idx = find_enum_decl(c.enums, eq)
                        if enum_idx >= 0 {
                            if enum_has_variant(c.enums[enum_idx], f.name) {
                                let tag_info = enum_tag_info(c, eq, f.name)
                                if !tag_info.ok {
                                    compiler_add_type_error(c, "unknown enum variant '" + f.name + "'")
                                }
                                let dst = new_temp(c)
                                emit_instr(c, IrInstr.MakeEnum(IrMakeEnum { dst: dst, name: eq, variant: f.name, tag: tag_info.tag, tag_type: tag_info.tag_type, payload: -1 }))
                                return dst
                            }
                        }
                    }
                }
                _ => {}
            }
            let recv = compile_expr(c, f.recv, self_name)
            let dst = new_temp(c)
            emit_instr(c, IrInstr.GetField(IrGetField { dst: dst, src: recv, field: f.name }))
            return dst
        }
        Expr.Index(ix) => {
            let recv = compile_expr(c, ix.recv, self_name)
            let idx = compile_expr(c, ix.index, self_name)
            let dst = new_temp(c)
            emit_instr(c, IrInstr.Index(IrIndex { dst: dst, array: recv, index: idx }))
            return dst
        }
    }
    return const_zero(c)
}

struct MethodResolution {
    callee: String,
    with_self: bool,
    is_enum: bool,
    enum_name: String,
    method_name: String,
}

fn resolve_method_call(c: &mut Compiler, recv: Expr, method: String, self_name: String) -> MethodResolution {
    match recv {
        Expr.Ident(id) => {
            if lookup_var(c, id.name) == "" {
                let alias_mod = compiler_module_alias(c, id.name)
                if alias_mod != "" {
                    let tctx = c.tctx
                    let fidx = find_func_in_module(&tctx, alias_mod, method)
                    if fidx >= 0 {
                        let sig = tctx.funcs[fidx]
                        return MethodResolution { callee: qualify_name(sig.module, sig.name), with_self: false, is_enum: false, enum_name: "", method_name: method }
                    }
                    let rq = compiler_resolve_reexport_func(c, alias_mod, method)
                    if rq != "" {
                        return MethodResolution { callee: rq, with_self: false, is_enum: false, enum_name: "", method_name: method }
                    }
                }
                let eq = compiler_resolve_enum_name(c, id.name)
                let enum_idx = find_enum_decl(c.enums, eq)
                if enum_idx >= 0 {
                    if enum_has_variant(c.enums[enum_idx], method) {
                        return MethodResolution { callee: "", with_self: false, is_enum: true, enum_name: eq, method_name: method }
                    }
                }
                let mut type_q = eq
                if type_q == "" {
                    type_q = compiler_resolve_struct_name(c, id.name)
                }
                if type_q != "" {
                    let midx = compiler_find_method(c, type_q, method)
                    if midx >= 0 {
                        let sig = c.tctx.methods[midx]
                        if !sig.has_self {
                            return MethodResolution { callee: sig.func_name, with_self: false, is_enum: false, enum_name: "", method_name: method }
                        }
                    }
                }
            }
        }
        _ => {}
    }
    let recv_t = compiler_check_expr(c, recv)
    let mut base = recv_t
    if compiler_type_is_ref(c, base) {
        base = compiler_deref_type(c, base)
    }
    let type_name = compiler_type_name(c, base)
    let midx = compiler_find_method(c, type_name, method)
    if midx >= 0 {
        let sig = c.tctx.methods[midx]
        return MethodResolution { callee: sig.func_name, with_self: true, is_enum: false, enum_name: "", method_name: method }
    }
    compiler_add_type_error(c, "unknown method '" + method + "'")
    return MethodResolution { callee: method, with_self: true, is_enum: false, enum_name: "", method_name: method }
}

fn op_string(k: TokenKind) -> String {
    if k == TokenKind.Plus { return "+" }
    if k == TokenKind.Minus { return "-" }
    if k == TokenKind.Star { return "*" }
    if k == TokenKind.Slash { return "/" }
    if k == TokenKind.Percent { return "%" }
    if k == TokenKind.EqEq { return "==" }
    if k == TokenKind.NotEq { return "!=" }
    if k == TokenKind.Lt { return "<" }
    if k == TokenKind.LtEq { return "<=" }
    if k == TokenKind.Gt { return ">" }
    if k == TokenKind.GtEq { return ">=" }
    if k == TokenKind.AndAnd { return "&&" }
    if k == TokenKind.OrOr { return "||" }
    if k == TokenKind.Bang { return "!" }
    return "?"
}

fn parse_int(text: String) -> i32 {
    if len(text) == 0 { return 0 }
    let mut i = 0
    let mut neg = false
    if char_at(text, 0) == 45 {
        neg = true
        i = 1
    }
    let mut val = 0
    while i < len(text) {
        let c = char_at(text, i)
        if c < 48 || c > 57 {
            i = len(text)
        } else {
            val = val * 10 + (c - 48)
            i = i + 1
        }
    }
    if neg { return -val }
    return val
}

fn parse_string_literal(raw: String) -> String {
    if len(raw) < 2 { return raw }
    let mut out = ""
    let mut i = 1
    let end = len(raw) - 1
    while i < end {
        let c = char_at(raw, i)
        let mut handled = false
        if c == 92 {
            if i + 1 < end {
                let n = char_at(raw, i + 1)
                if n == 110 { out = out + "\n" }
                else if n == 116 { out = out + "\t" }
                else if n == 92 { out = out + "\\" }
                else if n == 34 { out = out + "\"" }
                else { out = out + substr(raw, i + 1, 1) }
                i = i + 2
                handled = true
            }
        }
        if !handled {
            out = out + substr(raw, i, 1)
            i = i + 1
        }
    }
    return out
}

fn const_to_ir(v: ConstValue, type_name: String) -> IrValue {
    if v.kind == const_kind_int() {
        if is_int_type_name(type_name) {
            return ir_value_int_t(parse_int(v.int_value), type_name)
        }
        return ir_value_int(parse_int(v.int_value))
    }
    if v.kind == const_kind_bool() {
        return ir_value_bool(v.bool_value)
    }
    if v.kind == const_kind_string() {
        return ir_value_string(parse_string_literal(v.str_value))
    }
    return ir_value_unit()
}

fn const_zero(c: &mut Compiler) -> i32 {
    let t = new_temp(c)
    emit_instr(c, IrInstr.Const(IrConst { dst: t, value: ir_value_int(0) }))
    return t
}

fn find_enum_decl(enums: [EnumDecl], name: String) -> i32 {
    let mut i = 0
    while i < len(enums) {
        if enum_qname(enums[i]) == name { return i }
        i = i + 1
    }
    return -1
}

fn find_struct_decl(structs: [StructDecl], name: String) -> i32 {
    let mut i = 0
    while i < len(structs) {
        if qualify_name(structs[i].module, structs[i].name) == name { return i }
        i = i + 1
    }
    return -1
}

fn find_const_decl(consts: [ConstDecl], name: String) -> i32 {
    let mut i = 0
    while i < len(consts) {
        if qualify_name(consts[i].module, consts[i].name) == name { return i }
        i = i + 1
    }
    return -1
}

fn enum_has_variant(e: EnumDecl, name: String) -> bool {
    let mut i = 0
    while i < len(e.variants) {
        if e.variants[i].name == name { return true }
        i = i + 1
    }
    return false
}

struct EnumTagInfo {
    ok: bool,
    tag: i32,
    tag_type: String,
}

fn enum_tag_info(c: &Compiler, enum_name: String, variant: String) -> EnumTagInfo {
    let idx = find_enum_decl(c.enums, enum_name)
    if idx < 0 { return EnumTagInfo { ok: false, tag: 0, tag_type: "" } }
    let e = c.enums[idx]
    let mut tag_type = e.repr
    if tag_type == "" { tag_type = "i32" }
    let mut next = 0
    let mut i = 0
    while i < len(e.variants) {
        let v = e.variants[i]
        if v.has_value {
            next = parse_int(v.value)
        }
        if v.name == variant {
            return EnumTagInfo { ok: true, tag: next, tag_type: tag_type }
        }
        next = next + 1
        i = i + 1
    }
    return EnumTagInfo { ok: false, tag: 0, tag_type: tag_type }
}

fn enum_name_for_scrut(c: &mut Compiler, expr: Expr, self_name: String) -> String {
    let t = compiler_check_expr(c, expr)
    if compiler_type_kind(c, t) == 6 {
        return compiler_type_name(c, t)
    }
    return ""
}

fn struct_name_for_type(c: &Compiler, t: i32) -> String {
    if compiler_type_kind(c, t) == 5 {
        return compiler_type_name(c, t)
    }
    return ""
}

fn enum_name_for_type(c: &Compiler, t: i32) -> String {
    if compiler_type_kind(c, t) == 6 {
        return compiler_type_name(c, t)
    }
    return ""
}

fn struct_field_type(c: &mut Compiler, struct_name: String, field: String, self_name: String) -> i32 {
    let idx = find_struct_decl(c.structs, struct_name)
    if idx < 0 { return 0 }
    let st = c.structs[idx]
    let fidx = find_field(st, field)
    if fidx < 0 { return 0 }
    return compiler_parse_type_in_module(c, st.fields[fidx].typ, self_name, st.module)
}

fn variant_payload_type(c: &mut Compiler, enum_name: String, variant: String, self_name: String) -> i32 {
    let eidx = find_enum_decl(c.enums, enum_name)
    if eidx < 0 { return 0 }
    let e = c.enums[eidx]
    let mut i = 0
    while i < len(e.variants) {
        let v = e.variants[i]
        if v.name == variant {
            if v.has_payload {
                return compiler_parse_type_in_module(c, v.payload, self_name, e.module)
            }
            return compiler_type_make(c, 4, "unit", false, false, -1)
        }
        i = i + 1
    }
    return 0
}

fn push_scope(c: &mut Compiler) {
    let mut marks = c.scope_marks
    let names = c.scope_names
    push(&mut marks, len(names))
    c.scope_marks = marks
    compiler_env_push(c)
}

fn pop_scope(c: &mut Compiler) {
    let mut marks = c.scope_marks
    let mut names = c.scope_names
    let mut irs = c.scope_ir
    if len(marks) == 0 { return }
    let idx = marks[len(marks)-1]
    pop(&mut marks)
    while len(names) > idx {
        pop(&mut names)
        pop(&mut irs)
    }
    c.scope_marks = marks
    c.scope_names = names
    c.scope_ir = irs
    compiler_env_pop(c)
}

fn declare_var(c: &mut Compiler, name: String, typ: i32, mutable: bool) -> String {
    let ir_name = unique_name(c, name)
    let mut names = c.scope_names
    let mut irs = c.scope_ir
    push(&mut names, name)
    push(&mut irs, ir_name)
    c.scope_names = names
    c.scope_ir = irs
    compiler_env_declare(c, name, typ, mutable)
    return ir_name
}

fn lookup_var(c: &Compiler, name: String) -> String {
    let mut i = len(c.scope_names) - 1
    while i >= 0 {
        if c.scope_names[i] == name {
            return c.scope_ir[i]
        }
        if i == 0 { return "" }
        i = i - 1
    }
    return ""
}

fn unique_name(c: &mut Compiler, base: String) -> String {
    let mut counts = c.name_counts
    let mut i = 0
    while i < len(counts) {
        if counts[i].name == base {
            let n = counts[i].count
            let mut entry = counts[i]
            entry.count = n + 1
            counts[i] = entry
            c.name_counts = counts
            return base + "#" + int_to_string(n)
        }
        i = i + 1
    }
    push(&mut counts, NameCount { name: base, count: 1 })
    c.name_counts = counts
    return base
}

fn new_block(c: &mut Compiler, prefix: String) -> i32 {
    let label = prefix + int_to_string(c.block_id)
    c.block_id = c.block_id + 1
    let block = IrBlock { label: label, instrs: instr_list_new(), term: ir_term_none() }
    let mut blocks = c.blocks
    push(&mut blocks, block)
    let idx = len(blocks) - 1
    c.blocks = blocks
    return idx
}

fn block_label(c: &Compiler, idx: i32) -> String {
    if idx < 0 || idx >= len(c.blocks) { return "" }
    return c.blocks[idx].label
}

fn set_current_block(c: &mut Compiler, idx: i32) {
    c.cur_block = idx
}

fn current_block_has_term(c: &Compiler) -> bool {
    if c.cur_block < 0 { return false }
    let term = c.blocks[c.cur_block].term
    match term {
        .None(_) => { return false }
        _ => { return true }
    }
}

fn emit_instr(c: &mut Compiler, inst: IrInstr) {
    if c.cur_block < 0 { return }
    let mut blocks = c.blocks
    let mut blk = blocks[c.cur_block]
    let mut instrs = blk.instrs
    push(&mut instrs, inst)
    blk.instrs = instrs
    blocks[c.cur_block] = blk
    c.blocks = blocks
}

fn emit_term(c: &mut Compiler, term: IrTerm) {
    if c.cur_block < 0 { return }
    let mut blk = c.blocks[c.cur_block]
    blk.term = term
    c.blocks[c.cur_block] = blk
}

fn new_temp(c: &mut Compiler) -> i32 {
    let t = c.temp_id
    c.temp_id = c.temp_id + 1
    return t
}
