// stage2: minimal compiler pipeline (parse -> QBE -> native).

struct QbeValue {
    typ: String,
    expr: String,
    lines: [String],
}

fn string_list_empty() -> [String] {
    let mut out: [String] = []
    return out
}

fn qbe_lines_empty() -> [String] {
    return string_list_empty()
}

fn str_clone(s: &str) -> String {
    return substr(s, 0, len(s))
}

fn clone_expr_list(items: & [Expr]) -> [Expr] {
    let mut out: [Expr] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, expr_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn string_has_prefix(s: &str, prefix: &str) -> bool {
    let sl = len(string_clone(s))
    let pl = len(string_clone(prefix))
    if pl > sl { return false }
    return substr(string_clone(s), 0, pl) == string_clone(prefix)
}

fn qbe_value(typ: String, expr: String) -> QbeValue {
    return QbeValue { typ: typ, expr: expr, lines: qbe_lines_empty() }
}

fn qbe_value_with_lines(typ: String, expr: String, lines: [String]) -> QbeValue {
    return QbeValue { typ: typ, expr: expr, lines: lines }
}

struct FuncSig {
    name: String,
    ret_type: String,
}

fn func_sig_list_empty() -> [FuncSig] {
    let mut out: [FuncSig] = []
    return out
}

fn func_sig_clone(s: &FuncSig) -> FuncSig {
    return FuncSig { name: string_clone(&s.name), ret_type: string_clone(&s.ret_type) }
}

fn func_sig_list_clone(items: & [FuncSig]) -> [FuncSig] {
    let mut out: [FuncSig] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, func_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct StructFieldSig {
    name: String,
    typ: String,
}

fn struct_field_sig_list_empty() -> [StructFieldSig] {
    let mut out: [StructFieldSig] = []
    return out
}

fn struct_field_sig_clone(f: &StructFieldSig) -> StructFieldSig {
    return StructFieldSig { name: string_clone(&f.name), typ: string_clone(&f.typ) }
}

fn struct_field_sig_list_clone(items: & [StructFieldSig]) -> [StructFieldSig] {
    let mut out: [StructFieldSig] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, struct_field_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct StructSig {
    name: String,
    fields: [StructFieldSig],
}

fn struct_sig_list_empty() -> [StructSig] {
    let mut out: [StructSig] = []
    return out
}

fn struct_sig_clone(s: &StructSig) -> StructSig {
    return StructSig { name: string_clone(&s.name), fields: struct_field_sig_list_clone(&s.fields) }
}

fn struct_sig_list_clone(items: & [StructSig]) -> [StructSig] {
    let mut out: [StructSig] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, struct_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct EnumVariantSig {
    name: String,
    value: i64,
    has_payload: bool,
    payload_type: String,
}

fn enum_variant_sig_list_empty() -> [EnumVariantSig] {
    let mut out: [EnumVariantSig] = []
    return out
}

fn enum_variant_sig_clone(v: &EnumVariantSig) -> EnumVariantSig {
    return EnumVariantSig { name: string_clone(&v.name), value: v.value, has_payload: v.has_payload, payload_type: string_clone(&v.payload_type) }
}

fn enum_variant_sig_list_clone(items: & [EnumVariantSig]) -> [EnumVariantSig] {
    let mut out: [EnumVariantSig] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, enum_variant_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct EnumSig {
    name: String,
    tag_type: String,
    variants: [EnumVariantSig],
}

fn enum_sig_list_empty() -> [EnumSig] {
    let mut out: [EnumSig] = []
    return out
}

fn enum_sig_clone(s: &EnumSig) -> EnumSig {
    return EnumSig { name: string_clone(&s.name), tag_type: string_clone(&s.tag_type), variants: enum_variant_sig_list_clone(&s.variants) }
}

fn enum_sig_list_clone(items: & [EnumSig]) -> [EnumSig] {
    let mut out: [EnumSig] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, enum_sig_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct Emitter {
    // String table.
    strings: [String],
    // Const table.
    const_names: [String],
    const_exprs: [Expr],
    const_types: [String],
    // Type alias table.
    type_alias_names: [String],
    type_alias_targets: [String],
    // Struct table.
    struct_sigs: [StructSig],
    // Enum table.
    enum_sigs: [EnumSig],
    // Function table.
    func_sigs: [FuncSig],
    // Vars.
    var_names: [String],
    var_types: [String],
    // Live drop candidates in current function.
    drop_live_names: [String],
    drop_live_types: [String],
    // Current function return type.
    cur_ret_type: String,
    // Temp id counter.
    temp_id: i64,
    // Label id counter.
    label_id: i64,
    // Loop control stacks.
    break_labels: [String],
    continue_labels: [String],
    // Emitted body lines.
    body: [String],
}

fn emitter_new() -> Emitter {
    return Emitter {
        strings: string_list_empty(),
        const_names: string_list_empty(),
        const_exprs: expr_list_empty(),
        const_types: string_list_empty(),
        type_alias_names: string_list_empty(),
        type_alias_targets: string_list_empty(),
        struct_sigs: struct_sig_list_empty(),
        enum_sigs: enum_sig_list_empty(),
        func_sigs: func_sig_list_empty(),
        var_names: string_list_empty(),
        var_types: string_list_empty(),
        drop_live_names: string_list_empty(),
        drop_live_types: string_list_empty(),
        cur_ret_type: "unit",
        temp_id: 0,
        label_id: 0,
        break_labels: string_list_empty(),
        continue_labels: string_list_empty(),
        body: string_list_empty(),
    }
}

fn emitter_with_globals(glob: &Emitter) -> Emitter {
    let mut e = emitter_new()
    e.strings = ast_string_list_clone(&glob.strings)
    e.const_names = ast_string_list_clone(&glob.const_names)
    e.const_exprs = clone_expr_list(&glob.const_exprs)
    e.const_types = ast_string_list_clone(&glob.const_types)
    e.type_alias_names = ast_string_list_clone(&glob.type_alias_names)
    e.type_alias_targets = ast_string_list_clone(&glob.type_alias_targets)
    e.struct_sigs = struct_sig_list_clone(&glob.struct_sigs)
    e.enum_sigs = enum_sig_list_clone(&glob.enum_sigs)
    e.func_sigs = func_sig_list_clone(&glob.func_sigs)
    e.drop_live_names = string_list_empty()
    e.drop_live_types = string_list_empty()
    e.cur_ret_type = string_clone(&glob.cur_ret_type)
    return e
}

fn emit_line(e: &mut Emitter, line: String) {
    let mut body = e.body
    push(&mut body, line)
    e.body = body
}

fn mangle_name(name: &str) -> String {
    let mut out = ""
    let mut i = 0
    let n = str_len(name)
    while i < n {
        let c = str_char_at(name, i)
        let is_alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        let is_digit = c >= '0' && c <= '9'
        if is_alpha || is_digit || c == '_' {
            out = out + str_substr(name, i, 1)
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    if out == "" { return "_" }
    return out
}

struct EnumCall {
    ok: bool,
    enum_name: String,
    variant: String,
}

fn enum_call_parse(name: &str) -> EnumCall {
    let mut dot = -1
    let mut i = 0
    let n = str_len(name)
    while i < n {
        if str_char_at(name, i) == '.' {
            dot = i
            break
        }
        i = i + 1
    }
    if dot < 0 {
        return EnumCall { ok: false, enum_name: "", variant: "" }
    }
    let enum_name = str_substr(name, 0, dot)
    let variant = str_substr(name, dot + 1, n - dot - 1)
    return EnumCall { ok: true, enum_name: enum_name, variant: variant }
}

fn var_slot(name: &str) -> String {
    return "v_" + mangle_name(name)
}

fn int_to_string(n: i64) -> String {
    if n == 0 { return "0" }
    let mut v = n
    let mut neg = false
    if v < 0 {
        neg = true
        v = -v
    }
    let mut out = ""
    while v > 0 {
        let d = v % 10
        out = str_substr("0123456789", d, 1) + out
        v = v / 10
    }
    if neg { out = "-" + out }
    return out
}

fn temp_name(id: i64) -> String {
    return "%t" + int_to_string(id)
}

fn new_temp(e: &mut Emitter) -> i64 {
    let id = e.temp_id
    e.temp_id = id + 1
    return id
}

fn new_label(e: &mut Emitter, prefix: &str) -> String {
    let id = e.label_id
    e.label_id = id + 1
    return prefix + int_to_string(id)
}

fn push_break_label(e: &mut Emitter, label: String) {
    let mut ls = e.break_labels
    push(&mut ls, label)
    e.break_labels = ls
}

fn push_continue_label(e: &mut Emitter, label: String) {
    let mut ls = e.continue_labels
    push(&mut ls, label)
    e.continue_labels = ls
}

fn pop_break_label(e: &mut Emitter) {
    let n = len(e.break_labels)
    if n == 0 { return }
    let mut ls = e.break_labels
    let mut out: [String] = []
    let mut i = 0
    while i < n - 1 {
        push(&mut out, ls[i])
        i = i + 1
    }
    e.break_labels = out
}

fn pop_continue_label(e: &mut Emitter) {
    let n = len(e.continue_labels)
    if n == 0 { return }
    let mut ls = e.continue_labels
    let mut out: [String] = []
    let mut i = 0
    while i < n - 1 {
        push(&mut out, ls[i])
        i = i + 1
    }
    e.continue_labels = out
}

fn top_break_label(e: &Emitter) -> String {
    let n = len(e.break_labels)
    if n == 0 { return "" }
    return string_clone(&e.break_labels[n - 1])
}

fn top_continue_label(e: &Emitter) -> String {
    let n = len(e.continue_labels)
    if n == 0 { return "" }
    return string_clone(&e.continue_labels[n - 1])
}

fn emit_label(e: &mut Emitter, label: &str) {
    emit_line(e, "@" + label)
}

fn type_is_ref_raw(t: &str) -> bool {
    return string_has_prefix(t, "&")
}

fn type_ref_base_raw(t: &str) -> String {
    if string_has_prefix(t, "&mut ") {
        let n = len(string_clone(t))
        return substr(string_clone(t), 5, n - 5)
    }
    if string_has_prefix(t, "&") {
        let n = len(string_clone(t))
        return substr(string_clone(t), 1, n - 1)
    }
    return string_clone(t)
}

fn type_is_array_raw(t: &str) -> bool {
    return string_has_prefix(t, "[")
}

fn type_array_elem_raw(t: &str) -> String {
    let n = len(string_clone(t))
    if n <= 2 { return "i64" }
    return substr(string_clone(t), 1, n - 2)
}

fn type_alias_index(e: &Emitter, name: &str) -> i64 {
    let mut i = 0
    while i < len(e.type_alias_names) {
        if e.type_alias_names[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn type_resolve(e: &Emitter, t: &str) -> String {
    let cur = string_clone(t)
    if cur == "" { return cur }
    if type_is_ref_raw(&cur) {
        let base = type_ref_base_raw(&cur)
        return "&" + type_resolve(e, &base)
    }
    if type_is_array_raw(&cur) {
        let elem = type_array_elem_raw(&cur)
        return "[" + type_resolve(e, &elem) + "]"
    }
    let mut out = cur
    let mut steps = 0
    while steps < 32 {
        let idx = type_alias_index(e, &out)
        if idx < 0 { return out }
        out = string_clone(&e.type_alias_targets[idx])
        steps = steps + 1
    }
    return out
}

fn type_is_bool(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "bool"
}

fn type_is_string(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "String"
}

fn type_is_unit(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "unit"
}

fn type_is_i32(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "i32"
}

fn type_is_i64(e: &Emitter, t: &str) -> bool {
    return type_resolve(e, t) == "i64"
}

fn type_is_int(e: &Emitter, t: &str) -> bool {
    return type_is_i32(e, t) || type_is_i64(e, t)
}

fn type_is_ref(e: &Emitter, t: &str) -> bool {
    let rt = type_resolve(e, t)
    return type_is_ref_raw(&rt)
}

fn type_ref_base(e: &Emitter, t: &str) -> String {
    let rt = type_resolve(e, t)
    if type_is_ref_raw(&rt) { return type_ref_base_raw(&rt) }
    return rt
}

fn type_is_array(e: &Emitter, t: &str) -> bool {
    let rt = type_resolve(e, t)
    return type_is_array_raw(&rt)
}

fn type_array_elem(e: &Emitter, t: &str) -> String {
    let rt = type_resolve(e, t)
    if !type_is_array_raw(&rt) { return "i64" }
    return type_array_elem_raw(&rt)
}

fn type_strip_ref(e: &Emitter, t: &str) -> String {
    if type_is_ref(e, t) { return type_ref_base(e, t) }
    return type_resolve(e, t)
}

fn qbe_type(e: &Emitter, t: &str) -> String {
    if type_is_ref(e, t) { return "l" }
    if type_is_array(e, t) { return "l" }
    if type_is_bool(e, t) { return "w" }
    return "l"
}

fn store_op_for_type(e: &Emitter, t: &str) -> String {
    if type_is_ref(e, t) { return "storel" }
    if type_is_array(e, t) { return "storel" }
    if type_is_bool(e, t) { return "storew" }
    return "storel"
}

fn load_op_for_type(e: &Emitter, t: &str) -> String {
    if type_is_ref(e, t) { return "load" }
    if type_is_array(e, t) { return "load" }
    if type_is_bool(e, t) { return "loadw" }
    return "load"
}

fn list_index(items: & [String], name: &str) -> i64 {
    let mut i = 0
    while i < len(*items) {
        if (*items)[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn const_index(e: &Emitter, name: &str) -> i64 {
    return list_index(&e.const_names, name)
}

fn var_index(e: &Emitter, name: &str) -> i64 {
    return list_index(&e.var_names, name)
}

fn struct_index(e: &Emitter, name: &str) -> i64 {
    let key = type_strip_ref(e, name)
    let mut i = 0
    while i < len(e.struct_sigs) {
        if e.struct_sigs[i].name == key { return i }
        i = i + 1
    }
    return -1
}

fn type_is_struct(e: &Emitter, t: &str) -> bool {
    return struct_index(e, t) >= 0
}

fn struct_field_index(e: &Emitter, struct_name: &str, field: &str) -> i64 {
    let si = struct_index(e, struct_name)
    if si < 0 { return -1 }
    let mut i = 0
    while i < len(e.struct_sigs[si].fields) {
        if e.struct_sigs[si].fields[i].name == field { return i }
        i = i + 1
    }
    return -1
}

fn struct_field_type(e: &Emitter, struct_name: &str, field: &str) -> String {
    let si = struct_index(e, struct_name)
    if si < 0 { return "" }
    let fi = struct_field_index(e, struct_name, field)
    if fi < 0 { return "" }
    return type_resolve(e, &e.struct_sigs[si].fields[fi].typ)
}

fn struct_field_count(e: &Emitter, struct_name: &str) -> i64 {
    let si = struct_index(e, struct_name)
    if si < 0 { return 0 }
    return len(e.struct_sigs[si].fields)
}

fn enum_index(e: &Emitter, name: &str) -> i64 {
    let key = type_strip_ref(e, name)
    let mut i = 0
    while i < len(e.enum_sigs) {
        if e.enum_sigs[i].name == key { return i }
        i = i + 1
    }
    return -1
}

fn type_is_enum(e: &Emitter, t: &str) -> bool {
    return enum_index(e, t) >= 0
}

fn enum_tag_type(e: &Emitter, enum_name: &str) -> String {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return "i32" }
    let tt = type_resolve(e, &e.enum_sigs[ei].tag_type)
    if tt == "" { return "i32" }
    return tt
}

fn enum_variant_index(e: &Emitter, enum_name: &str, variant: &str) -> i64 {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return -1 }
    let mut i = 0
    while i < len(e.enum_sigs[ei].variants) {
        if e.enum_sigs[ei].variants[i].name == variant { return i }
        i = i + 1
    }
    return -1
}

fn enum_variant_value(e: &Emitter, enum_name: &str, variant: &str) -> i64 {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return -1 }
    let vi = enum_variant_index(e, enum_name, variant)
    if vi < 0 { return -1 }
    return e.enum_sigs[ei].variants[vi].value
}

fn enum_has_payload(e: &Emitter, enum_name: &str) -> bool {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return false }
    let mut i = 0
    while i < len(e.enum_sigs[ei].variants) {
        if e.enum_sigs[ei].variants[i].has_payload { return true }
        i = i + 1
    }
    return false
}

fn enum_variant_has_payload(e: &Emitter, enum_name: &str, variant: &str) -> bool {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return false }
    let vi = enum_variant_index(e, enum_name, variant)
    if vi < 0 { return false }
    return e.enum_sigs[ei].variants[vi].has_payload
}

fn enum_variant_payload_type(e: &Emitter, enum_name: &str, variant: &str) -> String {
    let ei = enum_index(e, enum_name)
    if ei < 0 { return "i64" }
    let vi = enum_variant_index(e, enum_name, variant)
    if vi < 0 { return "i64" }
    let pt = string_clone(&e.enum_sigs[ei].variants[vi].payload_type)
    if pt == "" { return "i64" }
    return pt
}

fn func_index(e: &Emitter, name: &str) -> i64 {
    let mut i = 0
    while i < len(e.func_sigs) {
        if e.func_sigs[i].name == name { return i }
        i = i + 1
    }
    return -1
}

fn func_ret_type(e: &Emitter, name: &str) -> String {
    let idx = func_index(e, name)
    if idx < 0 { return "i64" }
    return string_clone(&e.func_sigs[idx].ret_type)
}

fn const_type(e: &Emitter, name: &str) -> String {
    let idx = const_index(e, name)
    if idx < 0 { return "" }
    return string_clone(&e.const_types[idx])
}

fn var_type(e: &Emitter, name: &str) -> String {
    let idx = var_index(e, name)
    if idx < 0 { return "" }
    return string_clone(&e.var_types[idx])
}

fn drop_live_index(e: &Emitter, name: &str) -> i64 {
    let mut i = 0
    while i < len(e.drop_live_names) {
        if e.drop_live_names[i] == name { return i }
        i = i + 1
    }
    return -1
}

fn drop_needs_drop_type_env(e: &Emitter, t: &str) -> bool {
    let rt = type_resolve(e, t)
    if type_is_ref(e, &rt) { return false }
    if drop_needs_drop_type(string_clone(&rt)) { return true }
    if type_is_struct(e, &rt) { return true }
    if type_is_enum(e, &rt) && enum_has_payload(e, &rt) { return true }
    return false
}

fn drop_fn_for_type(e: &Emitter, t: &str) -> String {
    let rt = type_resolve(e, t)
    if rt == "String" { return "dast_string_free" }
    if drop_is_array_type_name(string_clone(&rt)) { return "dast_array_free" }
    if type_is_struct(e, &rt) { return "dast_struct_free" }
    if type_is_enum(e, &rt) && enum_has_payload(e, &rt) { return "dast_struct_free" }
    return ""
}

fn drop_emit_for_slot(e: &mut Emitter, name: &str, typ: &str) {
    if !drop_needs_drop_type_env(e, typ) { return }
    let fn_name = drop_fn_for_type(e, typ)
    if fn_name == "" { return }
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, typ)
    emit_line(e, "  " + tn + " =l " + op + " %" + var_slot(name))
    emit_line(e, "  call $" + fn_name + "(l " + tn + ")")
}

fn drop_live_remove(e: &mut Emitter, name: &str) {
    let idx = drop_live_index(e, name)
    if idx < 0 { return }
    let mut names: [String] = []
    let mut types: [String] = []
    let mut i = 0
    while i < len(e.drop_live_names) {
        if i != idx {
            push(&mut names, e.drop_live_names[i])
            push(&mut types, e.drop_live_types[i])
        }
        i = i + 1
    }
    e.drop_live_names = names
    e.drop_live_types = types
}

fn drop_live_set(e: &mut Emitter, name: &str, typ: &str) {
    if !drop_needs_drop_type_env(e, typ) { return }
    let idx = drop_live_index(e, name)
    if idx >= 0 {
        let mut types = e.drop_live_types
        types[idx] = string_clone(typ)
        e.drop_live_types = types
        return
    }
    let mut names = e.drop_live_names
    let mut types = e.drop_live_types
    push(&mut names, string_clone(name))
    push(&mut types, string_clone(typ))
    e.drop_live_names = names
    e.drop_live_types = types
}

fn drop_live_drop_existing(e: &mut Emitter, name: &str) {
    let idx = drop_live_index(e, name)
    if idx < 0 { return }
    let typ = string_clone(&e.drop_live_types[idx])
    drop_emit_for_slot(e, name, &typ)
    drop_live_remove(e, name)
}

fn drop_live_remove_returned_expr(e: &mut Emitter, expr: &Expr) {
    if expr.kind == EXPR_IDENT {
        drop_live_remove(e, &expr.name)
    }
}

fn drop_live_drop_all(e: &mut Emitter) {
    let mut i = 0
    while i < len(e.drop_live_names) {
        let name = string_clone(&e.drop_live_names[i])
        let typ = string_clone(&e.drop_live_types[i])
        drop_emit_for_slot(e, &name, &typ)
        i = i + 1
    }
    e.drop_live_names = string_list_empty()
    e.drop_live_types = string_list_empty()
}

fn ensure_string(e: &mut Emitter, s: String) -> i64 {
    let mut i = 0
    while i < len(e.strings) {
        if e.strings[i] == string_clone(&s) { return i }
        i = i + 1
    }
    let id = len(e.strings)
    let mut strings = e.strings
    push(&mut strings, s)
    e.strings = strings
    return id
}

fn str_data_label(id: i64) -> String {
    return "str_data_" + int_to_string(id)
}

fn str_struct_label(id: i64) -> String {
    return "str_" + int_to_string(id)
}

fn string_data_ptr(e: &mut Emitter, s: &str) -> String {
    let id = ensure_string(e, string_clone(s))
    return "$" + str_data_label(id)
}

fn escape_qbe_string(s: &str) -> String {
    let mut out = ""
    let mut i = 0
    let n = str_len(s)
    while i < n {
        let c = str_char_at(s, i)
        if c == '\n' { out = out + "\\n" }
        else if c == '\r' { out = out + "\\r" }
        else if c == '\t' { out = out + "\\t" }
        else if c == '\\' { out = out + "\\\\" }
        else if c == '"' { out = out + "\\\"" }
        else { out = out + str_substr(s, i, 1) }
        i = i + 1
    }
    return out
}

fn expr_type(e: &Emitter, expr: &Expr) -> String {
    match expr.kind {
        EXPR_INT => { return "i64" }
        EXPR_CHAR => { return "i64" }
        EXPR_BOOL => { return "bool" }
        EXPR_STRING => { return "String" }
        EXPR_IDENT => {
            let ct = const_type(e, &expr.name)
            if ct != "" { return ct }
            let vt = var_type(e, &expr.name)
            if vt != "" { return vt }
            return "i64"
        }
        EXPR_STRUCT_LIT => {
            return type_resolve(e, &expr.name)
        }
        EXPR_REF => {
            if len(expr.args) == 0 { return "&i64" }
            let base = expr_type(e, &expr.args[0])
            return "&" + type_resolve(e, &base)
        }
        EXPR_DEREF => {
            if len(expr.args) == 0 { return "i64" }
            let base = expr_type(e, &expr.args[0])
            if type_is_ref(e, &base) { return type_ref_base(e, &base) }
            return type_resolve(e, &base)
        }
        EXPR_ARRAY => {
            if len(expr.args) == 0 { return "[i64]" }
            let elem = expr_type(e, &expr.args[0])
            return "[" + type_resolve(e, &elem) + "]"
        }
        EXPR_INDEX => {
            if len(expr.args) < 1 { return "i64" }
            let mut recv_t = expr_type(e, &expr.args[0])
            if type_is_ref(e, &recv_t) { recv_t = type_ref_base(e, &recv_t) }
            if type_is_array(e, &recv_t) { return type_array_elem(e, &recv_t) }
            return "i64"
        }
        EXPR_FIELD => {
            if len(expr.args) == 0 { return "i64" }
            let recv_expr = &expr.args[0]
            if recv_expr.kind == EXPR_IDENT {
                let recv_name = type_resolve(e, &recv_expr.name)
                let ct = const_type(e, &recv_name)
                let vt = var_type(e, &recv_name)
                if ct == "" && vt == "" && type_is_enum(e, &recv_name) {
                    let vi = enum_variant_index(e, &recv_name, &expr.name)
                    if vi >= 0 { return recv_name }
                }
            }
            let mut recv_t = expr_type(e, &expr.args[0])
            if type_is_ref(e, &recv_t) { recv_t = type_ref_base(e, &recv_t) }
            let ft = struct_field_type(e, &recv_t, &expr.name)
            if ft != "" { return type_resolve(e, &ft) }
            return "i64"
        }
        EXPR_BINARY => {
            if expr.name == "==" || expr.name == "<" || expr.name == ">" { return "bool" }
            if len(expr.args) > 0 { return expr_type(e, &expr.args[0]) }
            return "i64"
        }
        EXPR_CALL => {
            if expr.name == "print" || expr.name == "println" { return "unit" }
            if expr.name == "len" { return "i64" }
            let ec = enum_call_parse(&expr.name)
            if ec.ok && type_is_enum(e, &ec.enum_name) { return ec.enum_name }
            let rt = func_ret_type(e, &expr.name)
            return type_resolve(e, &rt)
        }
        _ => { return "i64" }
    }
}

fn collect_type_aliases(e: &mut Emitter, prog: &Program) {
    let mut names = string_list_empty()
    let mut targets = string_list_empty()
    let mut i = 0
    while i < len(prog.type_aliases) {
        let a = &prog.type_aliases[i]
        push(&mut names, string_clone(&a.name))
        push(&mut targets, string_clone(&a.target))
        i = i + 1
    }
    e.type_alias_names = names
    e.type_alias_targets = targets
    // Resolve alias targets after the table is populated.
    let mut j = 0
    while j < len(e.type_alias_targets) {
        e.type_alias_targets[j] = type_resolve(e, &e.type_alias_targets[j])
        j = j + 1
    }
}

fn collect_structs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(prog.structs) {
        let s = &prog.structs[i]
        let mut fields = struct_field_sig_list_empty()
        let mut fi = 0
        while fi < len(s.fields) {
            let f = &s.fields[fi]
            push(&mut fields, StructFieldSig { name: string_clone(&f.name), typ: type_resolve(e, &f.typ) })
            fi = fi + 1
        }
        let mut sigs = e.struct_sigs
        push(&mut sigs, StructSig { name: string_clone(&s.name), fields: fields })
        e.struct_sigs = sigs
        i = i + 1
    }
}

fn collect_enums(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(prog.enums) {
        let en = &prog.enums[i]
        let mut variants = enum_variant_sig_list_empty()
        let mut vi = 0
        while vi < len(en.variants) {
            let v = &en.variants[vi]
            push(&mut variants, EnumVariantSig { name: string_clone(&v.name), value: vi, has_payload: v.has_payload, payload_type: type_resolve(e, &v.payload_type) })
            vi = vi + 1
        }
        let mut sigs = e.enum_sigs
        push(&mut sigs, EnumSig { name: string_clone(&en.name), tag_type: type_resolve(e, &en.tag_type), variants: variants })
        e.enum_sigs = sigs
        i = i + 1
    }
}

fn collect_funcs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(prog.functions) {
        let f = &prog.functions[i]
        let mut sigs = e.func_sigs
        let rt = effective_ret_type(e, f)
        push(&mut sigs, FuncSig { name: string_clone(&f.name), ret_type: rt })
        e.func_sigs = sigs
        i = i + 1
    }
}

fn collect_consts(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(prog.consts) {
        let c = &prog.consts[i]
        let ct = expr_type(e, &c.expr)
        let mut names = e.const_names
        let mut exprs = e.const_exprs
        let mut types = e.const_types
        push(&mut names, string_clone(&c.name))
        push(&mut exprs, expr_clone(&c.expr))
        push(&mut types, ct)
        e.const_names = names
        e.const_exprs = exprs
        e.const_types = types
        i = i + 1
    }
}

fn collect_vars_from_block(e: &mut Emitter, b: &Block) {
    collect_vars_from_stmts(e, &b.stmts)
}

fn collect_var_add(e: &mut Emitter, name: &str, typ: &str) {
    if name == "" { return }
    if var_index(e, name) >= 0 { return }
    let mut names = e.var_names
    let mut types = e.var_types
    push(&mut names, string_clone(name))
    push(&mut types, string_clone(typ))
    e.var_names = names
    e.var_types = types
}

fn collect_vars_from_stmts(e: &mut Emitter, items: & [Stmt]) {
    let mut i = 0
    while i < len(*items) {
        let s = &(*items)[i]
        if s.kind == STMT_LET {
            if s.name != "" {
                let typ = expr_type(e, &s.expr)
                collect_var_add(e, &s.name, &typ)
            }
        }
        if s.kind == STMT_IF {
            collect_vars_from_block(e, &s.block)
            if s.has_else { collect_vars_from_block(e, &s.else_block) }
        } else if s.kind == STMT_IFLET {
            if s.pat_has_binding {
                let enum_t = expr_type(e, &s.expr)
                let mut bt = "i64"
                if type_is_enum(e, &enum_t) {
                    bt = enum_variant_payload_type(e, &enum_t, &s.pat_variant)
                }
                collect_var_add(e, &s.pat_binding, bt)
            }
            collect_vars_from_block(e, &s.block)
            if s.has_else { collect_vars_from_block(e, &s.else_block) }
        } else if s.kind == STMT_MATCH {
            let enum_t = expr_type(e, &s.expr)
            let mut ai = 0
            while ai < len(s.arms) {
                let a = &s.arms[ai]
                if a.has_binding && a.pat_kind == PAT_VARIANT {
                    let mut bt = "i64"
                    if type_is_enum(e, &enum_t) {
                        bt = enum_variant_payload_type(e, &enum_t, &a.variant)
                    }
                    collect_var_add(e, &a.binding, bt)
                }
                collect_vars_from_block(e, &a.block)
                ai = ai + 1
            }
        } else if s.kind == STMT_WHILE || s.kind == STMT_LOOP {
            collect_vars_from_block(e, &s.block)
        }
        i = i + 1
    }
}

fn collect_vars(e: &mut Emitter, f: &Function) {
    let mut pi = 0
    while pi < len(f.params) {
        let p = &f.params[pi]
        let pname = &p.name
        let mut ptyp = "i64"
        if p.has_type { ptyp = string_clone(&p.typ) }
        if var_index(e, pname) < 0 {
            let mut names = e.var_names
            let mut types = e.var_types
            push(&mut names, string_clone(pname))
            push(&mut types, ptyp)
            e.var_names = names
            e.var_types = types
        }
        pi = pi + 1
    }
    collect_vars_from_block(e, &f.body)
}

fn collect_strings_from_expr(e: &mut Emitter, expr: &Expr) {
    if expr.kind == EXPR_STRING {
        let _ = ensure_string(e, string_clone(&expr.name))
        return
    }
    if expr.kind == EXPR_STRUCT_LIT {
        let _ = ensure_string(e, string_clone(&expr.name))
        let mut fi = 0
        while fi < len(expr.fields) {
            let f = &expr.fields[fi]
            let _ = ensure_string(e, string_clone(&f.name))
            collect_strings_from_expr(e, &f.value)
            fi = fi + 1
        }
        return
    }
    if expr.kind == EXPR_FIELD {
        let _ = ensure_string(e, string_clone(&expr.name))
        if len(expr.args) > 0 {
            collect_strings_from_expr(e, &expr.args[0])
        }
        return
    }
    let mut i = 0
    while i < len(expr.args) {
        collect_strings_from_expr(e, &expr.args[i])
        i = i + 1
    }
    let mut j = 0
    while j < len(expr.fields) {
        collect_strings_from_expr(e, &expr.fields[j].value)
        j = j + 1
    }
}

fn collect_strings_from_block(e: &mut Emitter, b: &Block) {
    collect_strings_from_stmts(e, &b.stmts)
}

fn collect_strings_from_stmts(e: &mut Emitter, items: & [Stmt]) {
    let mut i = 0
    while i < len(*items) {
        let s = &(*items)[i]
        collect_strings_from_expr(e, &s.expr)
        if s.kind == STMT_IF {
            collect_strings_from_block(e, &s.block)
            if s.has_else { collect_strings_from_block(e, &s.else_block) }
        } else if s.kind == STMT_IFLET {
            collect_strings_from_block(e, &s.block)
            if s.has_else { collect_strings_from_block(e, &s.else_block) }
        } else if s.kind == STMT_MATCH {
            let mut ai = 0
            while ai < len(s.arms) {
                collect_strings_from_block(e, &s.arms[ai].block)
                ai = ai + 1
            }
        } else if s.kind == STMT_WHILE || s.kind == STMT_LOOP {
            collect_strings_from_block(e, &s.block)
        }
        i = i + 1
    }
}

fn collect_strings_structs(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(prog.structs) {
        let s = &prog.structs[i]
        let _ = ensure_string(e, string_clone(&s.name))
        let mut fi = 0
        while fi < len(s.fields) {
            let f = &s.fields[fi]
            let _ = ensure_string(e, string_clone(&f.name))
            fi = fi + 1
        }
        i = i + 1
    }
}

fn collect_strings_enums(e: &mut Emitter, prog: &Program) {
    let mut i = 0
    while i < len(prog.enums) {
        let en = &prog.enums[i]
        let _ = ensure_string(e, string_clone(&en.name))
        let mut has_payload = false
        let mut vi = 0
        while vi < len(en.variants) {
            if en.variants[vi].has_payload { has_payload = true }
            vi = vi + 1
        }
        if has_payload {
            let _ = ensure_string(e, "_tag")
            let _ = ensure_string(e, "_payload")
        }
        i = i + 1
    }
}

fn collect_strings(e: &mut Emitter, prog: &Program) {
    collect_strings_structs(e, prog)
    collect_strings_enums(e, prog)
    let mut i = 0
    while i < len(prog.consts) {
        collect_strings_from_expr(e, &prog.consts[i].expr)
        i = i + 1
    }
    let mut fi = 0
    while fi < len(prog.functions) {
        collect_strings_from_block(e, &prog.functions[fi].body)
        fi = fi + 1
    }
}

fn emit_string_data(e: &Emitter) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(e.strings) {
        let data = str_data_label(i)
        let st = str_struct_label(i)
        let s = &e.strings[i]
        let esc = escape_qbe_string(s)
        let slen = str_len(s)
        out = out + "data $" + data + " = { b \"" + esc + "\", b 0 }\n"
        out = out + "data $" + st + " = { l $" + data + ", l " + int_to_string(slen) + ", l " + int_to_string(slen + 1) + " }\n"
        i = i + 1
    }
    if out != "" { out = out + "\n" }
    return out
}

fn emit_const_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if expr.kind == EXPR_INT || expr.kind == EXPR_CHAR {
        return qbe_value("i64", int_to_string(expr.int_value))
    }
    if expr.kind == EXPR_BOOL {
        if expr.bool_value { return qbe_value("bool", "1") }
        return qbe_value("bool", "0")
    }
    if expr.kind == EXPR_STRING {
        let id = ensure_string(e, string_clone(&expr.name))
        return qbe_value("String", "$" + str_struct_label(id))
    }
    if expr.kind == EXPR_IDENT {
        let idx = const_index(e, &expr.name)
        if idx >= 0 {
            return emit_const_expr(e, &e.const_exprs[idx])
        }
    }
    return qbe_value("i64", "0")
}

fn emit_load_var(e: &mut Emitter, name: &str, typ: &str) -> QbeValue {
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    let op = load_op_for_type(e, typ)
    let qt = qbe_type(e, typ)
    emit_line(e, "  " + tn + " =" + qt + " " + op + " %" + var_slot(name))
    return qbe_value(type_resolve(e, typ), tn)
}

fn ensure_bool_expr(e: &mut Emitter, v: QbeValue) -> String {
    if type_is_bool(e, &v.typ) { return v.expr }
    let tmp = new_temp(e)
    let tn = temp_name(tmp)
    emit_line(e, "  " + tn + " =w cnel " + v.expr + ", 0")
    return tn
}

fn cast_to_type(e: &mut Emitter, v: QbeValue, target_t: &str) -> String {
    let rt = type_resolve(e, target_t)
    if type_is_unit(e, &rt) { return "0" }
    if type_is_bool(e, &rt) {
        if type_is_bool(e, &v.typ) { return v.expr }
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =w cnel " + v.expr + ", 0")
        return tn
    }
    if type_is_unit(e, &v.typ) { return "0" }
    if type_is_bool(e, &v.typ) {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l extsw " + v.expr)
        return tn
    }
    return v.expr
}

fn cast_to_l(e: &mut Emitter, v: QbeValue) -> String {
    return cast_to_type(e, v, "i64")
}

fn enum_construct(e: &mut Emitter, enum_name: &str, variant: &str, payload: QbeValue, has_payload_arg: bool) -> QbeValue {
    let tag = enum_variant_value(e, enum_name, variant)
    if tag < 0 {
        println("stage2: unknown enum variant", variant)
        exit(1)
    }
    let tag_t = enum_tag_type(e, enum_name)
    let tag_q = qbe_type(e, &tag_t)
    let tag_fn = struct_set_fn_for_type(e, &tag_t)
    let tag_expr = cast_to_type(e, qbe_value("i64", int_to_string(tag)), &tag_t)
    if enum_has_payload(e, enum_name) {
        let name_ptr = string_data_ptr(e, enum_name)
        let tag_ptr = string_data_ptr(e, "_tag")
        let payload_ptr = string_data_ptr(e, "_payload")
        let payload_t = enum_variant_payload_type(e, enum_name, variant)
        let payload_fn = struct_set_fn_for_type(e, &payload_t)
        let payload_q = qbe_type(e, &payload_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l call $dast_struct_new(l " + name_ptr + ", l 2)")
        emit_line(e, "  call $" + tag_fn + "(l " + tn + ", l " + tag_ptr + ", " + tag_q + " " + tag_expr + ")")
        let mut payload_expr = "0"
        if enum_variant_has_payload(e, enum_name, variant) && has_payload_arg {
            payload_expr = cast_to_type(e, payload, &payload_t)
        }
        emit_line(e, "  call $" + payload_fn + "(l " + tn + ", l " + payload_ptr + ", " + payload_q + " " + payload_expr + ")")
        return qbe_value(string_clone(enum_name), tn)
    }
    return qbe_value(string_clone(enum_name), tag_expr)
}

fn enum_tag_from_value(e: &mut Emitter, v: &QbeValue, enum_t: &str) -> QbeValue {
    let tag_t = enum_tag_type(e, enum_t)
    if type_is_enum(e, enum_t) && enum_has_payload(e, enum_t) {
        let tag_ptr = string_data_ptr(e, "_tag")
        let tag_fn = struct_get_fn_for_type(e, &tag_t)
        let tag_q = qbe_type(e, &tag_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =" + tag_q + " call $" + tag_fn + "(l " + v.expr + ", l " + tag_ptr + ")")
        return qbe_value(string_clone(&tag_t), tn)
    }
    let casted = cast_to_type(e, qbe_value("i64", v.expr), &tag_t)
    return qbe_value(string_clone(&tag_t), casted)
}

fn enum_payload_from_value(e: &mut Emitter, v: &QbeValue, enum_t: &str, variant: &str) -> QbeValue {
    let payload_t = enum_variant_payload_type(e, enum_t, variant)
    if type_is_enum(e, enum_t) && enum_has_payload(e, enum_t) {
        let payload_ptr = string_data_ptr(e, "_payload")
        let payload_fn = struct_get_fn_for_type(e, &payload_t)
        let payload_q = qbe_type(e, &payload_t)
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =" + payload_q + " call $" + payload_fn + "(l " + v.expr + ", l " + payload_ptr + ")")
        return qbe_value(payload_t, tn)
    }
    return qbe_value(payload_t, "0")
}

fn struct_set_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "dast_struct_set_bool" }
    if type_is_string(e, t) { return "dast_struct_set_string" }
    if type_is_i32(e, t) { return "dast_struct_set_i32" }
    if type_is_int(e, t) { return "dast_struct_set_i64" }
    if type_is_enum(e, t) { return "dast_struct_set_i64" }
    if type_is_struct(e, t) { return "dast_struct_set_ptr" }
    return "dast_struct_set_ptr"
}

fn struct_get_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "dast_struct_get_bool" }
    if type_is_string(e, t) { return "dast_struct_get_string" }
    if type_is_i32(e, t) { return "dast_struct_get_i32" }
    if type_is_int(e, t) { return "dast_struct_get_i64" }
    if type_is_enum(e, t) { return "dast_struct_get_i64" }
    if type_is_struct(e, t) { return "dast_struct_get_ptr" }
    return "dast_struct_get_ptr"
}

fn emit_binary_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    if len(expr.args) < 2 { return qbe_value("i64", "0") }
    let lhs = emit_expr(e, &expr.args[0])
    let rhs = emit_expr(e, &expr.args[1])
    let op = string_clone(&expr.name)
    if op == "+" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l add " + lhs.expr + ", " + rhs.expr)
        return qbe_value("i64", tn)
    }
    if op == "-" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =l sub " + lhs.expr + ", " + rhs.expr)
        return qbe_value("i64", tn)
    }
    if op == "==" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        let cmp = if type_is_bool(e, &lhs.typ) { "ceqw" } else { "ceql" }
        emit_line(e, "  " + tn + " =w " + cmp + " " + lhs.expr + ", " + rhs.expr)
        return qbe_value("bool", tn)
    }
    if op == "<" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        emit_line(e, "  " + tn + " =w csltl " + lhs.expr + ", " + rhs.expr)
        return qbe_value("bool", tn)
    }
    if op == ">" {
        let tmp = new_temp(e)
        let tn = temp_name(tmp)
        // Reuse signed-less-than by swapping operands.
        emit_line(e, "  " + tn + " =w csltl " + rhs.expr + ", " + lhs.expr)
        return qbe_value("bool", tn)
    }
    println("stage2: unsupported binary op", op)
    exit(1)
    return qbe_value("i64", "0")
}

fn emit_expr(e: &mut Emitter, expr: &Expr) -> QbeValue {
    match expr.kind {
        EXPR_INT => { return qbe_value("i64", int_to_string(expr.int_value)) }
        EXPR_CHAR => { return qbe_value("i64", int_to_string(expr.int_value)) }
        EXPR_BOOL => {
            if expr.bool_value { return qbe_value("bool", "1") }
            return qbe_value("bool", "0")
        }
        EXPR_STRING => {
            let id = ensure_string(e, string_clone(&expr.name))
            return qbe_value("String", "$" + str_struct_label(id))
        }
        EXPR_IDENT => {
            let ci = const_index(e, &expr.name)
            if ci >= 0 {
                return emit_const_expr(e, &e.const_exprs[ci])
            }
            let vt = var_type(e, &expr.name)
            if vt != "" {
                return emit_load_var(e, &expr.name, &vt)
            }
            return qbe_value("i64", "0")
        }
        EXPR_REF => {
            if len(expr.args) == 0 { return qbe_value("&i64", "0") }
            let inner = &expr.args[0]
            let base_t = expr_type(e, inner)
            let ref_t = "&" + string_clone(&base_t)
            if inner.kind == EXPR_IDENT {
                let name = string_clone(&inner.name)
                if var_index(e, &name) >= 0 {
                    return qbe_value(ref_t, "%" + var_slot(&name))
                }
            }
            let v = emit_expr(e, inner)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l alloc8 8")
            let casted = cast_to_type(e, v, &base_t)
            let op = store_op_for_type(e, &base_t)
            emit_line(e, "  " + op + " " + casted + ", " + tn)
            return qbe_value(ref_t, tn)
        }
        EXPR_DEREF => {
            if len(expr.args) == 0 { return qbe_value("i64", "0") }
            let ptr = emit_expr(e, &expr.args[0])
            let base_t = expr_type(e, expr)
            let op = load_op_for_type(e, &base_t)
            let q = qbe_type(e, &base_t)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " " + op + " " + ptr.expr)
            return qbe_value(base_t, tn)
        }
        EXPR_ARRAY => {
            let arr_t = expr_type(e, expr)
            let cap = len(expr.args)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_array_new(l " + int_to_string(cap) + ")")
            let mut i = 0
            while i < len(expr.args) {
                let v = emit_expr(e, &expr.args[i])
                let casted = cast_to_l(e, v)
                emit_line(e, "  call $dast_array_push(l " + tn + ", l " + casted + ")")
                i = i + 1
            }
            return qbe_value(arr_t, tn)
        }
        EXPR_INDEX => {
            if len(expr.args) < 2 { return qbe_value("i64", "0") }
            let recv = emit_expr(e, &expr.args[0])
            let idxv = emit_expr(e, &expr.args[1])
            let idx = cast_to_l(e, idxv)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_array_get(l " + recv.expr + ", l " + idx + ")")
            let t = expr_type(e, expr)
            return qbe_value(t, tn)
        }
        EXPR_STRUCT_LIT => {
            let st_name = string_clone(&expr.name)
            if struct_index(e, &st_name) < 0 {
                println("stage2: unknown struct", st_name)
                exit(1)
            }
            let name_ptr = string_data_ptr(e, &st_name)
            let field_count = struct_field_count(e, &st_name)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =l call $dast_struct_new(l " + name_ptr + ", l " + int_to_string(field_count) + ")")
            let mut i = 0
            while i < len(expr.fields) {
                let f = &expr.fields[i]
                let fname = string_clone(&f.name)
                let ftyp = struct_field_type(e, &st_name, &fname)
                if ftyp == "" {
                    println("stage2: unknown struct field", fname)
                    exit(1)
                }
                let v = emit_expr(e, &f.value)
                let casted = cast_to_type(e, v, &ftyp)
                let fname_ptr = string_data_ptr(e, &fname)
                let set_fn = struct_set_fn_for_type(e, &ftyp)
                let q = qbe_type(e, &ftyp)
                emit_line(e, "  call $" + set_fn + "(l " + tn + ", l " + fname_ptr + ", " + q + " " + casted + ")")
                i = i + 1
            }
            return qbe_value(st_name, tn)
        }
        EXPR_FIELD => {
            if len(expr.args) == 0 {
                println("stage2: field access missing receiver")
                exit(1)
            }
            let recv_expr = &expr.args[0]
            if recv_expr.kind == EXPR_IDENT {
                let recv_name = type_resolve(e, &recv_expr.name)
                let ct = const_type(e, &recv_name)
                let vt = var_type(e, &recv_name)
                if ct == "" && vt == "" && type_is_enum(e, &recv_name) {
                    let dummy = qbe_value("i64", "0")
                    return enum_construct(e, &recv_name, &expr.name, dummy, false)
                }
            }
            let recv = emit_expr(e, &expr.args[0])
            let recv_t = type_strip_ref(e, &recv.typ)
            let fname = string_clone(&expr.name)
            let ftyp = struct_field_type(e, &recv_t, &fname)
            if ftyp == "" {
                println("stage2: unknown field", fname)
                exit(1)
            }
            let fname_ptr = string_data_ptr(e, &fname)
            let get_fn = struct_get_fn_for_type(e, &ftyp)
            let q = qbe_type(e, &ftyp)
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + q + " call $" + get_fn + "(l " + recv.expr + ", l " + fname_ptr + ")")
            return qbe_value(ftyp, tn)
        }
        EXPR_BINARY => {
            return emit_binary_expr(e, expr)
        }
        EXPR_CALL => {
            if expr.name == "print" || expr.name == "println" {
                emit_print_call(e, expr)
                return qbe_value("unit", "0")
            }
            if expr.name == "len" {
                if len(expr.args) < 1 { return qbe_value("i64", "0") }
                let v = emit_expr(e, &expr.args[0])
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                let fn_name = if type_is_string(e, &v.typ) { "dast_string_len" } else { "dast_array_len" }
                emit_line(e, "  " + tn + " =l call $" + fn_name + "(l " + v.expr + ")")
                return qbe_value("i64", tn)
            }
            if expr.name == "string_clone" {
                if len(expr.args) < 1 { return qbe_value("String", "0") }
                let v = emit_expr(e, &expr.args[0])
                let tmp = new_temp(e)
                let tn = temp_name(tmp)
                emit_line(e, "  " + tn + " =l call $dast_string_clone(l " + v.expr + ")")
                return qbe_value("String", tn)
            }
            let ec = enum_call_parse(&expr.name)
            if ec.ok && type_is_enum(e, &ec.enum_name) {
                let mut payload = qbe_value("i64", "0")
                let mut has_payload_arg = false
                if len(expr.args) > 0 {
                    payload = emit_expr(e, &expr.args[0])
                    has_payload_arg = true
                }
                return enum_construct(e, &ec.enum_name, &ec.variant, payload, has_payload_arg)
            }
            let callee = "dast_user_" + mangle_name(&expr.name)
            let rt = func_ret_type(e, &expr.name)
            let ret_t = type_resolve(e, &rt)
            let ret_q = qbe_type(e, &ret_t)
            let mut args_text = ""
            let mut i = 0
            while i < len(expr.args) {
                if i > 0 { args_text = args_text + ", " }
                let v = emit_expr(e, &expr.args[i])
                let qt = qbe_type(e, &v.typ)
                args_text = args_text + qt + " " + v.expr
                i = i + 1
            }
            let tmp = new_temp(e)
            let tn = temp_name(tmp)
            emit_line(e, "  " + tn + " =" + ret_q + " call $" + callee + "(" + args_text + ")")
            return qbe_value(ret_t, tn)
        }
        _ => {
            println("stage2: unsupported expr kind", expr.kind)
            exit(1)
            return qbe_value("i64", "0")
        }
    }
}

fn print_fn_for_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "dast_print_bool" }
    if type_is_string(e, t) { return "dast_print_string" }
    if type_is_struct(e, t) { return "dast_print_struct" }
    return "dast_print_i64"
}

fn emit_print_arg(e: &mut Emitter, v: &QbeValue) {
    // Emit any prerequisite lines (for loads).
    let mut i = 0
    while i < len(v.lines) {
        emit_line(e, string_clone(&v.lines[i]))
        i = i + 1
    }
    let fn_name = print_fn_for_type(e, &v.typ)
    let qt = qbe_type(e, &v.typ)
    emit_line(e, "  call $" + fn_name + "(" + qt + " " + v.expr + ")")
}

fn emit_print_call(e: &mut Emitter, call: &Expr) {
    let newline = call.name == "println"
    let mut i = 0
    while i < len(call.args) {
        if i > 0 {
            emit_line(e, "  call $dast_print_space()")
        }
        let v = emit_expr(e, &call.args[i])
        emit_print_arg(e, &v)
        i = i + 1
    }
    if newline {
        emit_line(e, "  call $dast_print_newline()")
    }
}

fn emit_store_let(e: &mut Emitter, name: &str, expr: &Expr) {
    let typ = var_type(e, name)
    // Moves from non-copy identifiers should transfer drop ownership.
    if expr.kind == EXPR_IDENT {
        let src_t = expr_type(e, expr)
        if drop_needs_drop_type_env(e, &src_t) {
            drop_live_remove(e, &expr.name)
        }
    }
    let v = emit_expr(e, expr)
    drop_live_drop_existing(e, name)
    let op = store_op_for_type(e, &typ)
    emit_line(e, "  " + op + " " + v.expr + ", %" + var_slot(name))
    drop_live_set(e, name, &typ)
}

fn emit_block(e: &mut Emitter, b: &Block) {
    let mut i = 0
    while i < len(b.stmts) {
        emit_stmt(e, &b.stmts[i])
        i = i + 1
    }
}

fn block_ends_with_terminator(b: &Block) -> bool {
    let n = len(b.stmts)
    if n == 0 { return false }
    let last = stmt_clone(&b.stmts[n - 1])
    return last.kind == STMT_BREAK || last.kind == STMT_CONTINUE || last.kind == STMT_RETURN
}

fn emit_store_assign(e: &mut Emitter, lhs: &Expr, expr: &Expr) {
    if lhs.kind == EXPR_IDENT {
        emit_store_let(e, &lhs.name, expr)
        return
    }
    if lhs.kind == EXPR_DEREF && len(lhs.args) > 0 {
        let ptr = emit_expr(e, &lhs.args[0])
        let target_t = expr_type(e, lhs)
        let v = emit_expr(e, expr)
        let casted = cast_to_type(e, v, &target_t)
        let op = store_op_for_type(e, &target_t)
        emit_line(e, "  " + op + " " + casted + ", " + ptr.expr)
        return
    }
    println("stage2: unsupported assignment target")
    exit(1)
}

fn emit_if(e: &mut Emitter, stmt: &Stmt) {
    let cond_val = emit_expr(e, &stmt.expr)
    let cond_expr = ensure_bool_expr(e, cond_val)
    let then_label = new_label(e, "if_then_")
    let else_label = new_label(e, "if_else_")
    let end_label = new_label(e, "if_end_")
    emit_line(e, "  jnz " + cond_expr + ", @" + string_clone(&then_label) + ", @" + string_clone(&else_label))
    emit_label(e, &then_label)
    emit_block(e, &stmt.block)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &else_label)
    if stmt.has_else { emit_block(e, &stmt.else_block) }
    if !stmt.has_else || !block_ends_with_terminator(&stmt.else_block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &end_label)
}

fn emit_store_value(e: &mut Emitter, name: &str, typ: &str, value_expr: &str) {
    if name == "" { return }
    drop_live_drop_existing(e, name)
    let op = store_op_for_type(e, typ)
    emit_line(e, "  " + op + " " + string_clone(value_expr) + ", %" + var_slot(name))
    drop_live_set(e, name, typ)
}

fn emit_iflet(e: &mut Emitter, stmt: &Stmt) {
    let scrut = emit_expr(e, &stmt.expr)
    let enum_t = expr_type(e, &stmt.expr)
    let tag_t = enum_tag_type(e, &enum_t)
    let tagv = enum_tag_from_value(e, &scrut, &enum_t)
    let tag_val = enum_variant_value(e, &enum_t, &stmt.pat_variant)
    let cond_tmp = new_temp(e)
    let cond_tn = temp_name(cond_tmp)
    let cmp = if type_is_bool(e, &tag_t) || type_is_i32(e, &tag_t) { "ceqw" } else { "ceql" }
    emit_line(e, "  " + cond_tn + " =w " + cmp + " " + tagv.expr + ", " + int_to_string(tag_val))
    let then_label = new_label(e, "iflet_then_")
    let else_label = new_label(e, "iflet_else_")
    let end_label = new_label(e, "iflet_end_")
    emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&then_label) + ", @" + string_clone(&else_label))
    emit_label(e, &then_label)
    if stmt.pat_has_binding {
        let payload_t = enum_variant_payload_type(e, &enum_t, &stmt.pat_variant)
        let payload_v = enum_payload_from_value(e, &scrut, &enum_t, &stmt.pat_variant)
        let casted = cast_to_type(e, payload_v, &payload_t)
        let mut bind_t = var_type(e, &stmt.pat_binding)
        if bind_t == "" { bind_t = payload_t }
        emit_store_value(e, &stmt.pat_binding, &bind_t, &casted)
    }
    emit_block(e, &stmt.block)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &else_label)
    if stmt.has_else { emit_block(e, &stmt.else_block) }
    if !stmt.has_else || !block_ends_with_terminator(&stmt.else_block) {
        emit_line(e, "  jmp @" + string_clone(&end_label))
    }
    emit_label(e, &end_label)
}

fn emit_match(e: &mut Emitter, stmt: &Stmt) {
    let scrut = emit_expr(e, &stmt.expr)
    let scrut_t = expr_type(e, &stmt.expr)
    let is_enum = type_is_enum(e, &scrut_t)
    let mut tag_t = string_clone(&scrut.typ)
    let mut tag_expr = string_clone(&scrut.expr)
    if is_enum {
        let tagv = enum_tag_from_value(e, &scrut, &scrut_t)
        tag_t = enum_tag_type(e, &scrut_t)
        tag_expr = tagv.expr
    }
    let cmp = if type_is_bool(e, &tag_t) || type_is_i32(e, &tag_t) { "ceqw" } else { "ceql" }
    let end_label = new_label(e, "match_end_")
    let mut i = 0
    let mut next_label = new_label(e, "match_next_")
    while i < len(stmt.arms) {
        let arm = &stmt.arms[i]
        let arm_label = new_label(e, "match_arm_")
        if arm.pat_kind == PAT_WILDCARD {
            emit_line(e, "  jmp @" + string_clone(&arm_label))
        } else {
            let cond_tmp = new_temp(e)
            let cond_tn = temp_name(cond_tmp)
            if arm.pat_kind == PAT_VARIANT {
                let tag_val = enum_variant_value(e, &scrut_t, &arm.variant)
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(tag_val))
            } else if arm.pat_kind == PAT_INT {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(arm.int_value))
            } else {
                emit_line(e, "  " + cond_tn + " =w " + cmp + " " + string_clone(&tag_expr) + ", " + int_to_string(arm.int_value))
            }
            emit_line(e, "  jnz " + cond_tn + ", @" + string_clone(&arm_label) + ", @" + string_clone(&next_label))
        }
        emit_label(e, &arm_label)
        if arm.has_binding && arm.pat_kind == PAT_VARIANT && is_enum {
            let payload_t = enum_variant_payload_type(e, &scrut_t, &arm.variant)
            let payload_v = enum_payload_from_value(e, &scrut, &scrut_t, &arm.variant)
            let casted = cast_to_type(e, payload_v, &payload_t)
            let mut bind_t = var_type(e, &arm.binding)
            if bind_t == "" { bind_t = payload_t }
            emit_store_value(e, &arm.binding, &bind_t, &casted)
        }
        emit_block(e, &arm.block)
        if !block_ends_with_terminator(&arm.block) {
            emit_line(e, "  jmp @" + string_clone(&end_label))
        }
        emit_label(e, &next_label)
        next_label = new_label(e, "match_next_")
        i = i + 1
    }
    emit_label(e, &end_label)
}

fn emit_while(e: &mut Emitter, stmt: &Stmt) {
    let cond_label = new_label(e, "while_cond_")
    let body_label = new_label(e, "while_body_")
    let end_label = new_label(e, "while_end_")
    emit_line(e, "  jmp @" + string_clone(&cond_label))
    emit_label(e, &cond_label)
    let cond_val = emit_expr(e, &stmt.expr)
    let cond_expr = ensure_bool_expr(e, cond_val)
    emit_line(e, "  jnz " + cond_expr + ", @" + string_clone(&body_label) + ", @" + string_clone(&end_label))
    emit_label(e, &body_label)
    push_break_label(e, string_clone(&end_label))
    push_continue_label(e, string_clone(&cond_label))
    emit_block(e, &stmt.block)
    pop_continue_label(e)
    pop_break_label(e)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&cond_label))
    }
    emit_label(e, &end_label)
}

fn emit_loop(e: &mut Emitter, stmt: &Stmt) {
    let body_label = new_label(e, "loop_body_")
    let end_label = new_label(e, "loop_end_")
    emit_line(e, "  jmp @" + string_clone(&body_label))
    emit_label(e, &body_label)
    push_break_label(e, string_clone(&end_label))
    push_continue_label(e, string_clone(&body_label))
    emit_block(e, &stmt.block)
    pop_continue_label(e)
    pop_break_label(e)
    if !block_ends_with_terminator(&stmt.block) {
        emit_line(e, "  jmp @" + string_clone(&body_label))
    }
    emit_label(e, &end_label)
}

fn emit_break(e: &mut Emitter) {
    let target = top_break_label(e)
    if target == "" {
        println("stage2: break outside loop")
        exit(1)
    }
    emit_line(e, "  jmp @" + target)
}

fn emit_continue(e: &mut Emitter) {
    let target = top_continue_label(e)
    if target == "" {
        println("stage2: continue outside loop")
        exit(1)
    }
    emit_line(e, "  jmp @" + target)
}

fn emit_return(e: &mut Emitter, stmt: &Stmt) {
    let target_t = string_clone(&e.cur_ret_type)
    let mut rexpr = "0"
    if stmt.ret_has_value {
        let v = emit_expr(e, &stmt.expr)
        rexpr = cast_to_type(e, v, &target_t)
        drop_live_remove_returned_expr(e, &stmt.expr)
    }
    drop_live_drop_all(e)
    emit_line(e, "  ret " + rexpr)
}

fn emit_stmt(e: &mut Emitter, stmt: &Stmt) {
    if stmt.kind == STMT_LET {
        emit_store_let(e, &stmt.name, &stmt.expr)
        return
    }
    if stmt.kind == STMT_ASSIGN {
        emit_store_assign(e, &stmt.lhs, &stmt.expr)
        return
    }
    if stmt.kind == STMT_IF {
        emit_if(e, stmt)
        return
    }
    if stmt.kind == STMT_IFLET {
        emit_iflet(e, stmt)
        return
    }
    if stmt.kind == STMT_MATCH {
        emit_match(e, stmt)
        return
    }
    if stmt.kind == STMT_WHILE {
        emit_while(e, stmt)
        return
    }
    if stmt.kind == STMT_LOOP {
        emit_loop(e, stmt)
        return
    }
    if stmt.kind == STMT_BREAK {
        emit_break(e)
        return
    }
    if stmt.kind == STMT_CONTINUE {
        emit_continue(e)
        return
    }
    if stmt.kind == STMT_RETURN {
        emit_return(e, stmt)
        return
    }
    let _ = emit_expr(e, &stmt.expr)
}

fn emit_var_allocs(e: &Emitter) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(e.var_names) {
        let name = &e.var_names[i]
        let typ = &e.var_types[i]
        let alloc = if type_is_bool(e, typ) { "alloc4 4" } else { "alloc8 8" }
        out = out + "  %" + var_slot(name) + " =l " + alloc + "\n"
        i = i + 1
    }
    return out
}

fn func_param_sig(e: &Emitter, params: & [Param]) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(*params) {
        if i > 0 { out = out + ", " }
        let p = &(*params)[i]
        let mut ptyp = "i64"
        if p.has_type { ptyp = type_resolve(e, &p.typ) }
        let qt = qbe_type(e, &ptyp)
        out = out + qt + " %p" + int_to_string(i)
        i = i + 1
    }
    return out
}

fn body_ends_with_ret_line(e: &Emitter) -> bool {
    let n = len(e.body)
    if n == 0 { return false }
    let mut i = n - 1
    while i >= 0 {
        let line = string_clone(&e.body[i])
        if string_has_prefix(&line, "@") {
            i = i - 1
        } else {
            return string_has_prefix(&line, "  ret ")
        }
    }
    return false
}

fn emit_param_store_lines(e: &Emitter, params: & [Param]) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(*params) {
        let p = &(*params)[i]
        let pname = &p.name
        let mut ptyp = "i64"
        if p.has_type { ptyp = type_resolve(e, &p.typ) }
        let ptemp = "%p" + int_to_string(i)
        let op = store_op_for_type(e, &ptyp)
        out = out + "  " + op + " " + ptemp + ", %" + var_slot(pname) + "\n"
        i = i + 1
    }
    return out
}

fn effective_ret_type(e: &Emitter, f: &Function) -> String {
    if f.ret_type == "" { return "unit" }
    return type_resolve(e, &f.ret_type)
}

fn emit_function_text(e: &Emitter, f: &Function) -> String {
    let mut out = ""
    let export_kw = if f.name == "main" { "export " } else { "" }
    let fname = "dast_user_" + mangle_name(&f.name)
    let sig = func_param_sig(e, &f.params)
    let ret_t = effective_ret_type(e, f)
    let ret_q = qbe_type(e, &ret_t)
    out = out + export_kw + "function " + ret_q + " $" + fname + "(" + sig + ") {\n"
    out = out + "@entry\n"
    out = out + emit_var_allocs(e)
    out = out + emit_param_store_lines(e, &f.params)
    out = out + "\n@L_entry\n"
    let mut i = 0
    while i < len(e.body) {
        out = out + string_clone(&e.body[i]) + "\n"
        i = i + 1
    }
    if !block_ends_with_terminator(&f.body) && !body_ends_with_ret_line(e) {
        out = out + "  ret 0\n\n}\n"
    } else {
        out = out + "\n}\n"
    }
    return out
}

fn emit_compiled_function(glob: &mut Emitter, f: &Function) -> String {
    let mut e = emitter_with_globals(glob)
    let eff_rt = effective_ret_type(&e, f)
    e.cur_ret_type = string_clone(&eff_rt)
    collect_vars(&mut e, f)
    let stmt_count = len(f.body.stmts)
    if stmt_count > 0 {
        let last = stmt_clone(&f.body.stmts[stmt_count - 1])
        if last.kind == STMT_EXPR && !block_ends_with_terminator(&f.body) && eff_rt != "unit" {
            let mut i = 0
            while i + 1 < stmt_count {
                emit_stmt(&mut e, &f.body.stmts[i])
                i = i + 1
            }
            let ret_stmt = stmt_return(last.expr)
            emit_return(&mut e, &ret_stmt)
        } else {
            emit_block(&mut e, &f.body)
        }
    } else {
        emit_block(&mut e, &f.body)
    }
    let has_term = block_ends_with_terminator(&f.body)
    let has_ret = body_ends_with_ret_line(&e)
    if !has_term && !has_ret {
        drop_live_drop_all(&mut e)
    }
    let text = emit_function_text(&e, f)
    glob.strings = ast_string_list_clone(&e.strings)
    return text
}

fn compile_to_qbe(prog: Program) -> String {
    let mut glob = emitter_new()
    collect_type_aliases(&mut glob, &prog)
    collect_structs(&mut glob, &prog)
    collect_enums(&mut glob, &prog)
    collect_funcs(&mut glob, &prog)
    collect_consts(&mut glob, &prog)
    collect_strings(&mut glob, &prog)

    let mut out_funcs = ""
    let mut i = 0
    while i < len(prog.functions) {
        out_funcs = out_funcs + emit_compiled_function(&mut glob, &prog.functions[i]) + "\n"
        i = i + 1
    }
    let data = emit_string_data(&glob)
    return data + out_funcs
}

fn c_ret_type(e: &Emitter, t: &str) -> String {
    if type_is_bool(e, t) { return "int32_t" }
    return "int64_t"
}

fn main_ret_type(prog: &Program) -> String {
    let mut e = emitter_new()
    collect_type_aliases(&mut e, prog)
    let mut i = 0
    while i < len(prog.functions) {
        let f = &prog.functions[i]
        if f.name == "main" { return effective_ret_type(&e, f) }
        i = i + 1
    }
    return "unit"
}

fn build_entry_c(e: &Emitter, main_ret_t: &str) -> String {
    // Keep it tiny; args() is rarely needed in early tests.
    let mut out = ""
    out = out + "#include <stdint.h>\n\n"
    out = out + "void dast_set_args(int argc, char **argv);\n"
    let c_rt = c_ret_type(e, main_ret_t)
    out = out + c_rt + " dast_user_main(void);\n\n"
    out = out + "int main(int argc, char **argv) {\n"
    out = out + "    dast_set_args(argc - 1, argv + 1);\n"
    out = out + "    " + c_rt + " r = dast_user_main();\n"
    out = out + "    return (int)r;\n"
    out = out + "}\n"
    return out
}

fn run_exec(cmd: String, args: [String]) {
    let code = exec(cmd, args)
    if code != 0 {
        println("exec failed", code)
        exit(code)
    }
}

fn load_prelude_dir(dir: String) -> String {
    let names = read_dir(string_clone(&dir))
    let mut out = ""
    let mut i = 0
    while i < len(names) {
        let name = names[i]
        if str_has_suffix(&name, ".dast") {
            let path = string_clone(&dir) + "/" + name
            let text = read_file(path)
            out = out + text + "\n"
        }
        i = i + 1
    }
    return out
}

fn compile_native_single(src_path: String, out_bin: String) {
    let src = read_file(src_path)
    let prelude_dir = "compiler/stage2/stdlib/prelude"
    let prelude = load_prelude_dir(prelude_dir)
    let src_all = prelude + "\n" + src
    let prog = parse_program(src_all)
    let mut alias_e = emitter_new()
    collect_type_aliases(&mut alias_e, &prog)
    let main_rt = main_ret_type(&prog)
    let qbe = compile_to_qbe(prog)

    // Use a deterministic target directory.
    let target_dir = "compiler/stage2/target/min"
    mkdir(target_dir)
    let qbe_path = target_dir + "/main.qbe"
    let asm_path = target_dir + "/main.s"
    let entry_path = target_dir + "/entry.c"
    let runtime_path = "compiler/bootstrap/stage0/runtime/c_runtime.c"

    write_file(qbe_path, qbe)
    write_file(entry_path, build_entry_c(&alias_e, &main_rt))

    run_exec("qbe", ["-o", string_clone(&asm_path), string_clone(&qbe_path)])
    run_exec("cc", ["-O2", "-std=c99", string_clone(&asm_path), runtime_path, entry_path, "-o", out_bin])
}

fn compile_and_run_single(src_path: String, run_args: [String]) {
    let out_bin = "compiler/stage2/target/min/main"
    compile_native_single(src_path, string_clone(&out_bin))
    let _ = exec(out_bin, run_args)
}
