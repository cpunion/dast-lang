// Core traits - fundamental behavior definitions

/// Clone trait - types that can be duplicated
pub trait Clone {
    fn clone(self: &Self) -> Self;
}

/// Default trait - types with a default value
pub trait Default {
    fn default() -> Self;
}

/// Display trait - types that can be formatted as strings
pub trait Display {
    fn to_string(self: &Self) -> String;
}

/// Debug trait - types that can be debug-formatted
pub trait Debug {
    fn debug_string(self: &Self) -> String;
}

/// PartialEq trait - types that can be compared for equality
pub trait PartialEq {
    fn eq(self: &Self, other: &Self) -> bool;
    fn ne(self: &Self, other: &Self) -> bool;
}

/// PartialOrd trait - types that can be ordered
pub trait PartialOrd {
    fn lt(self: &Self, other: &Self) -> bool;
    fn le(self: &Self, other: &Self) -> bool;
    fn gt(self: &Self, other: &Self) -> bool;
    fn ge(self: &Self, other: &Self) -> bool;
}
