struct ParseError {
    pos: i32,
    file: String,
    line: i32,
    col: i32,
    msg: String,
}

fn vis_private() -> i32 { return 0 }
fn vis_pub() -> i32 { return 1 }
fn vis_pub_crate() -> i32 { return 2 }
fn vis_pub_super() -> i32 { return 3 }

struct Visibility {
    kind: i32,
}

fn const_kind_int() -> i32 { return 0 }
fn const_kind_bool() -> i32 { return 1 }
fn const_kind_string() -> i32 { return 2 }

struct ConstValue {
    kind: i32,
    int_value: String,
    str_value: String,
    bool_value: bool,
}

struct ConstDecl {
    vis: Visibility,
    module: String,
    file: String,
    pos: i32,
    name: String,
    has_type: bool,
    typ: String,
    value: ConstValue,
}

struct Param {
    pos: i32,
    name: String,
    typ: String,
}

struct Field {
    vis: Visibility,
    pos: i32,
    name: String,
    typ: String,
}

struct StructDecl {
    vis: Visibility,
    module: String,
    file: String,
    pos: i32,
    name: String,
    fields: [Field],
}

struct Variant {
    pos: i32,
    name: String,
    has_payload: bool,
    payload: String,
    has_value: bool,
    value: String,
}

struct EnumDecl {
    vis: Visibility,
    module: String,
    file: String,
    pos: i32,
    name: String,
    repr: String,
    variants: [Variant],
}

struct IdentExpr {
    pos: i32,
    name: String,
}

struct IntLit {
    pos: i32,
    value: String,
}

struct StringLit {
    pos: i32,
    value: String,
}

struct BoolLit {
    pos: i32,
    value: bool,
}

struct UnaryExpr {
    pos: i32,
    op: TokenKind,
    expr: Expr,
}

struct BinaryExpr {
    pos: i32,
    op: TokenKind,
    left: Expr,
    right: Expr,
}

struct CallExpr {
    pos: i32,
    callee: Expr,
    args: [Expr],
}

struct IndexExpr {
    pos: i32,
    recv: Expr,
    index: Expr,
}

struct FieldExpr {
    pos: i32,
    recv: Expr,
    name: String,
}

struct FieldInit {
    pos: i32,
    name: String,
    value: Expr,
}

struct StructLit {
    pos: i32,
    name: String,
    fields: [FieldInit],
}

struct ArrayLit {
    pos: i32,
    elems: [Expr],
}

struct RefExpr {
    pos: i32,
    mutable: bool,
    expr: Expr,
}

struct DerefExpr {
    pos: i32,
    expr: Expr,
}

struct MethodCallExpr {
    pos: i32,
    recv: Expr,
    method: String,
    args: [Expr],
    resolved_name: String,
    resolved_self: bool,
    enum_name: String,
}

enum Expr {
    Ident(IdentExpr),
    IntLit(IntLit),
    StringLit(StringLit),
    BoolLit(BoolLit),
    Unary(UnaryExpr),
    Binary(BinaryExpr),
    Call(CallExpr),
    MethodCall(MethodCallExpr),
    Index(IndexExpr),
    Field(FieldExpr),
    StructLit(StructLit),
    ArrayLit(ArrayLit),
    Ref(RefExpr),
    Deref(DerefExpr),
}

struct LetStmt {
    pos: i32,
    name: String,
    mutable: bool,
    has_type: bool,
    typ: String,
    has_init: bool,
    init: Expr,
}

struct ReturnStmt {
    pos: i32,
    has_value: bool,
    value: Expr,
}

struct ExprStmt {
    pos: i32,
    expr: Expr,
}

struct IfStmt {
    pos: i32,
    cond: Expr,
    then_block: Block,
    has_else: bool,
    else_block: Block,
}

struct WhileStmt {
    pos: i32,
    cond: Expr,
    body: Block,
}

struct WildcardPattern {}

struct VariantPattern {
    pos: i32,
    enum_name: String,
    variant: String,
    has_binding: bool,
    binding: String,
}

struct StructPatternField {
    pos: i32,
    name: String,
    bind: bool,
    has_pattern: bool,
    pattern: Pattern,
}

struct StructPattern {
    pos: i32,
    name: String,
    fields: [StructPatternField],
}

struct LiteralPattern {
    pos: i32,
    value: ConstValue,
}

enum Pattern {
    Wildcard(WildcardPattern),
    Variant(VariantPattern),
    Struct(StructPattern),
    Literal(LiteralPattern),
}

struct MatchArm {
    pos: i32,
    pattern: Pattern,
    has_guard: bool,
    guard: Expr,
    body: Block,
}

struct MatchStmt {
    pos: i32,
    expr: Expr,
    arms: [MatchArm],
}

struct Block {
    stmts: [Stmt],
}

enum Stmt {
    Let(LetStmt),
    Return(ReturnStmt),
    Expr(ExprStmt),
    If(IfStmt),
    Assign(AssignStmt),
    While(WhileStmt),
    Match(MatchStmt),
}

struct AssignStmt {
    pos: i32,
    target: Expr,
    value: Expr,
}

struct FunctionDecl {
    vis: Visibility,
    module: String,
    file: String,
    pos: i32,
    name: String,
    is_test: bool,
    params: [Param],
    has_return: bool,
    ret: String,
    body: Block,
}

struct ImplDecl {
    vis: Visibility,
    module: String,
    file: String,
    pos: i32,
    type_name: String,
    methods: [FunctionDecl],
}

struct ImportDecl {
    vis: Visibility,
    module: String,
    file: String,
    pos: i32,
    has_items: bool,
    items: [String],
    path: String,
    path_is_string: bool,
    has_alias: bool,
    alias: String,
}

struct Program {
    imports: [ImportDecl],
    structs: [StructDecl],
    enums: [EnumDecl],
    consts: [ConstDecl],
    functions: [FunctionDecl],
    impls: [ImplDecl],
}
