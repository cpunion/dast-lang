// Minimal lexer for stage2.

const TK_EOF: i32 = 0
const TK_IDENT: i32 = 1
const TK_INT: i32 = 2
const TK_STRING: i32 = 3
const TK_CHAR: i32 = 4
const TK_CONST: i32 = 5
const TK_FN: i32 = 6
const TK_LET: i32 = 7
const TK_TRUE: i32 = 8
const TK_FALSE: i32 = 9
const TK_ASSIGN: i32 = 10
const TK_LPAREN: i32 = 11
const TK_RPAREN: i32 = 12
const TK_LBRACE: i32 = 13
const TK_RBRACE: i32 = 14
const TK_COMMA: i32 = 15
const TK_MINUS: i32 = 16
const TK_PLUS: i32 = 17
const TK_LT: i32 = 18
const TK_EQEQ: i32 = 19
const TK_IF: i32 = 20
const TK_ELSE: i32 = 21
const TK_WHILE: i32 = 22
const TK_LOOP: i32 = 23
const TK_BREAK: i32 = 24
const TK_CONTINUE: i32 = 25
const TK_MUT: i32 = 26
const TK_RETURN: i32 = 27
const TK_ARROW: i32 = 28
const TK_COLON: i32 = 29
const TK_STRUCT: i32 = 30
const TK_DOT: i32 = 31
const TK_ENUM: i32 = 32
const TK_AMP: i32 = 33
const TK_STAR: i32 = 34
const TK_LBRACKET: i32 = 35
const TK_RBRACKET: i32 = 36
const TK_MATCH: i32 = 37
const TK_FATARROW: i32 = 38
const TK_GT: i32 = 39
const TK_TYPE: i32 = 40
const TK_TAG: i32 = 41
const TK_TRAIT: i32 = 42
const TK_IMPL: i32 = 43
const TK_FOR: i32 = 44
const TK_SEMI: i32 = 45
const TK_PIPE: i32 = 46
const TK_BANG: i32 = 47
const TK_DOLLAR: i32 = 48
const TK_MACRO: i32 = 49
const TK_QUOTE: i32 = 50
const TK_IN: i32 = 51
const TK_DOTDOT: i32 = 52
const TK_NEQ: i32 = 53
const TK_LTE: i32 = 54
const TK_GTE: i32 = 55
const TK_AMPAMP: i32 = 56
const TK_PIPEPIPE: i32 = 57
const TK_SLASH: i32 = 58
const TK_PERCENT: i32 = 59
const TK_CARET: i32 = 60
const TK_SHL: i32 = 61
const TK_SHR: i32 = 62
const TK_FLOAT: i32 = 63
const TK_WHERE: i32 = 64

// Character constants used by the lexer.
const CH_TAB = 9
const CH_LF = 10
const CH_CR = 13
const CH_SPACE = 32
const CH_QUOTE = 34
const CH_APOSTROPHE = 39
const CH_LPAREN = 40
const CH_RPAREN = 41
const CH_COMMA = 44
const CH_MINUS = 45
const CH_PLUS = 43
const CH_SLASH = 47
const CH_PERCENT = 37
const CH_EQ = 61
const CH_LT = 60
const CH_GT = 62
const CH_BACKSLASH = 92
const CH_UNDERSCORE = 95
const CH_LBRACE = 123
const CH_RBRACE = 125
const CH_LBRACKET = 91
const CH_RBRACKET = 93
const CH_LOWER_N = 110
const CH_COLON = 58
const CH_DOT = 46
const CH_SEMI = 59
const CH_AMP = 38
const CH_STAR = 42
const CH_PIPE = 124
const CH_BANG = 33
const CH_DOLLAR = 36
const CH_CARET = 94

struct Token {
    kind: i32,
    text: String,
    name: String,
    int_value: i64,
    bool_value: bool,
}

fn tok(kind: i32, text: String) -> Token {
    let name = string_clone(&text)
    return Token { kind: kind, text: text, name: name, int_value: 0, bool_value: false }
}

fn tok_int(v: i64) -> Token {
    return Token { kind: TK_INT, text: "", name: "", int_value: v, bool_value: false }
}

fn tok_float(text: String) -> Token {
    let name = string_clone(&text)
    return Token { kind: TK_FLOAT, text: text, name: name, int_value: 0, bool_value: false }
}

fn tok_bool(v: bool) -> Token {
    return Token { kind: if v { TK_TRUE } else { TK_FALSE }, text: "", name: "", int_value: 0, bool_value: v }
}

fn tok_char(v: i64, raw: String) -> Token {
    return Token { kind: TK_CHAR, text: raw, name: "", int_value: v, bool_value: false }
}

struct Lexer {
    src: String,
    idx: i64,
    n: i64,
}

fn lexer_new(src: &str) -> Lexer {
    let s = string_clone(src)
    let n = str_len(&s)
    return Lexer { src: s, idx: 0, n: n }
}

fn lex_is_space(c: i64) -> bool {
    return c == CH_SPACE || c == CH_TAB || c == CH_LF || c == CH_CR
}

fn lex_is_alpha(c: i64) -> bool {
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    return c == CH_UNDERSCORE
}

fn lex_is_digit(c: i64) -> bool {
    return c >= 48 && c <= 57
}

fn lex_peek(l: &Lexer) -> i64 {
    if l.idx >= l.n { return -1 }
    return str_char_at(&l.src, l.idx)
}

fn lex_peek_next(l: &Lexer) -> i64 {
    if l.idx + 1 >= l.n { return -1 }
    return str_char_at(&l.src, l.idx + 1)
}

fn lex_advance(l: &mut Lexer) -> i64 {
    let c = lex_peek(l)
    if c >= 0 { l.idx = l.idx + 1 }
    return c
}

fn lex_skip_space_and_comments(l: &mut Lexer) {
    let mut done = false
    while !done {
        done = true
        while lex_is_space(lex_peek(l)) { let _ = lex_advance(l); done = false }
        // Line comments: // ...
        if lex_peek(l) == CH_SLASH && lex_peek_next(l) == CH_SLASH {
            done = false
            while true {
                let c = lex_peek(l)
                if c < 0 || c == CH_LF { break }
                let _ = lex_advance(l)
            }
        }
    }
}

fn lex_read_ident(l: &mut Lexer) -> String {
    let start = l.idx
    while true {
        let c = lex_peek(l)
        if !(lex_is_alpha(c) || lex_is_digit(c)) { break }
        let _ = lex_advance(l)
    }
    return str_substr(&l.src, start, l.idx - start)
}

fn lex_read_number(l: &mut Lexer) -> Token {
    let start = l.idx
    while lex_is_digit(lex_peek(l)) { let _ = lex_advance(l) }
    if lex_peek(l) == CH_DOT && lex_peek_next(l) != CH_DOT && lex_is_digit(lex_peek_next(l)) {
        let _ = lex_advance(l)
        while lex_is_digit(lex_peek(l)) { let _ = lex_advance(l) }
        let text = str_substr(&l.src, start, l.idx - start)
        return tok_float(text)
    }
    let text = str_substr(&l.src, start, l.idx - start)
    return tok_int(parse_int_simple(&text))
}

fn lex_escape_piece(c: i64) -> String {
    if c == CH_LOWER_N { return string_clone("\n") }
    if c == CH_BACKSLASH { return string_clone("\\") }
    if c == CH_QUOTE { return string_clone("\"") }
    if c == CH_APOSTROPHE { return string_clone("'") }
    return string_clone("")
}

fn lex_read_string(l: &mut Lexer) -> String {
    // Opening quote already checked.
    let _ = lex_advance(l)
    let mut out = string_clone("")
    let mut seg_start = l.idx
    while l.idx < l.n {
        let c = lex_peek(l)
        if c == CH_QUOTE {
            if l.idx > seg_start {
                out = out + str_substr(&l.src, seg_start, l.idx - seg_start)
            }
            let _ = lex_advance(l)
            return out
        }
        if c == CH_BACKSLASH {
            if l.idx > seg_start {
                out = out + str_substr(&l.src, seg_start, l.idx - seg_start)
            }
            let _ = lex_advance(l)
            let esc = lex_advance(l)
            let piece = lex_escape_piece(esc)
            if piece != "" {
                out = out + piece
            } else if esc >= 0 {
                out = out + str_substr(&l.src, l.idx - 1, 1)
            }
            seg_start = l.idx
            continue
        }
        let _ = lex_advance(l)
    }
    return out
}

struct CharLit {
    value: i64,
    raw: String,
}

fn lex_read_char(l: &mut Lexer) -> CharLit {
    let start = l.idx
    // Opening quote already checked.
    let _ = lex_advance(l)
    let c0 = lex_advance(l)
    let mut value = c0
    if c0 == CH_BACKSLASH {
        let esc = lex_advance(l)
        if esc == CH_LOWER_N { value = CH_LF }
        else if esc == CH_BACKSLASH { value = CH_BACKSLASH }
        else if esc == CH_APOSTROPHE { value = CH_APOSTROPHE }
        else if esc == CH_QUOTE { value = CH_QUOTE }
        else { value = esc }
    }
    // Consume closing quote if present.
    if lex_peek(l) == CH_APOSTROPHE { let _ = lex_advance(l) }
    let end = l.idx
    let raw = substr(&l.src, start, end - start)
    return CharLit { value: value, raw: raw }
}

fn lexer_next(l: &mut Lexer) -> Token {
    lex_skip_space_and_comments(l)
    let c = lex_peek(l)
    if c < 0 { return tok(TK_EOF, "") }
    if lex_is_alpha(c) {
        let text = lex_read_ident(l)
        if text == "const" { return tok(TK_CONST, text) }
        if text == "fn" { return tok(TK_FN, text) }
        if text == "let" { return tok(TK_LET, text) }
        if text == "mut" { return tok(TK_MUT, text) }
        if text == "if" { return tok(TK_IF, text) }
        if text == "else" { return tok(TK_ELSE, text) }
        if text == "while" { return tok(TK_WHILE, text) }
        if text == "loop" { return tok(TK_LOOP, text) }
        if text == "break" { return tok(TK_BREAK, text) }
        if text == "continue" { return tok(TK_CONTINUE, text) }
        if text == "return" { return tok(TK_RETURN, text) }
        if text == "struct" { return tok(TK_STRUCT, text) }
        if text == "enum" { return tok(TK_ENUM, text) }
        if text == "type" { return tok(TK_TYPE, text) }
        if text == "tag" { return tok(TK_TAG, text) }
        if text == "match" { return tok(TK_MATCH, text) }
        if text == "trait" { return tok(TK_TRAIT, text) }
        if text == "impl" { return tok(TK_IMPL, text) }
        if text == "for" { return tok(TK_FOR, text) }
        if text == "in" { return tok(TK_IN, text) }
        if text == "where" { return tok(TK_WHERE, text) }
        if text == "macro" { return tok(TK_MACRO, text) }
        if text == "quote" { return tok(TK_QUOTE, text) }
        if text == "true" { return tok_bool(true) }
        if text == "false" { return tok_bool(false) }
        return tok(TK_IDENT, text)
    }
    if lex_is_digit(c) { return lex_read_number(l) }
    if c == CH_QUOTE {
        let s = lex_read_string(l)
        return tok(TK_STRING, s)
    }
    if c == CH_APOSTROPHE {
        let v = lex_read_char(l)
        return tok_char(v.value, v.raw)
    }
    if c == CH_EQ && lex_peek_next(l) == CH_EQ {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_EQEQ, "==")
    }
    if c == CH_BANG && lex_peek_next(l) == CH_EQ {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_NEQ, "!=")
    }
    if c == CH_LT && lex_peek_next(l) == CH_LT {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_SHL, "<<")
    }
    if c == CH_GT && lex_peek_next(l) == CH_GT {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_SHR, ">>")
    }
    if c == CH_LT && lex_peek_next(l) == CH_EQ {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_LTE, "<=")
    }
    if c == CH_GT && lex_peek_next(l) == CH_EQ {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_GTE, ">=")
    }
    if c == CH_AMP && lex_peek_next(l) == CH_AMP {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_AMPAMP, "&&")
    }
    if c == CH_PIPE && lex_peek_next(l) == CH_PIPE {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_PIPEPIPE, "||")
    }
    if c == CH_DOT && lex_peek_next(l) == CH_DOT {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_DOTDOT, "..")
    }
    if c == CH_EQ && lex_peek_next(l) == CH_GT {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_FATARROW, "=>")
    }
    if c == CH_MINUS && lex_peek_next(l) == CH_GT {
        let _ = lex_advance(l)
        let _ = lex_advance(l)
        return tok(TK_ARROW, "->")
    }
    let _ = lex_advance(l)
    if c == CH_EQ { return tok(TK_ASSIGN, "=") }
    if c == CH_LPAREN { return tok(TK_LPAREN, "(") }
    if c == CH_RPAREN { return tok(TK_RPAREN, ")") }
    if c == CH_LBRACE { return tok(TK_LBRACE, "{") }
    if c == CH_RBRACE { return tok(TK_RBRACE, "}") }
    if c == CH_COMMA { return tok(TK_COMMA, ",") }
    if c == CH_SEMI { return tok(TK_SEMI, ";") }
    if c == CH_COLON { return tok(TK_COLON, ":") }
    if c == CH_DOT { return tok(TK_DOT, ".") }
    if c == CH_LBRACKET { return tok(TK_LBRACKET, "[") }
    if c == CH_RBRACKET { return tok(TK_RBRACKET, "]") }
    if c == CH_AMP { return tok(TK_AMP, "&") }
    if c == CH_STAR { return tok(TK_STAR, "*") }
    if c == CH_PIPE { return tok(TK_PIPE, "|") }
    if c == CH_BANG { return tok(TK_BANG, "!") }
    if c == CH_DOLLAR { return tok(TK_DOLLAR, "$") }
    if c == CH_CARET { return tok(TK_CARET, "^") }
    if c == CH_MINUS { return tok(TK_MINUS, "-") }
    if c == CH_PLUS { return tok(TK_PLUS, "+") }
    if c == CH_SLASH { return tok(TK_SLASH, "/") }
    if c == CH_PERCENT { return tok(TK_PERCENT, "%") }
    if c == CH_LT { return tok(TK_LT, "<") }
    if c == CH_GT { return tok(TK_GT, ">") }
    return tok(TK_EOF, "")
}

fn lexer_all(src: &str) -> [Token] {
    let mut l = lexer_new(src)
    let mut out: [Token] = []
    while true {
        let t = lexer_next(&mut l)
        push(&mut out, t)
        if t.kind == TK_EOF { break }
    }
    return out
}
