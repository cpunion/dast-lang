fn is_space(c: i32) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn is_digit(c: i32) -> bool {
    return c >= '0' && c <= '9'
}

fn is_alpha(c: i32) -> bool {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_'
}

fn is_alnum(c: i32) -> bool {
    return is_alpha(c) || is_digit(c)
}

fn keyword_kind(s: String) -> TokenKind {
    if s == "fn" { return TokenKind.Fn }
    if s == "let" { return TokenKind.Let }
    if s == "mut" { return TokenKind.Mut }
    if s == "if" { return TokenKind.If }
    if s == "else" { return TokenKind.Else }
    if s == "while" { return TokenKind.While }
    if s == "loop" { return TokenKind.Loop }
    if s == "break" { return TokenKind.Break }
    if s == "continue" { return TokenKind.Continue }
    if s == "return" { return TokenKind.Return }
    if s == "struct" { return TokenKind.Struct }
    if s == "enum" { return TokenKind.Enum }
    if s == "match" { return TokenKind.Match }
    if s == "true" { return TokenKind.True }
    if s == "false" { return TokenKind.False }
    if s == "impl" { return TokenKind.Impl }
    if s == "trait" { return TokenKind.Trait }
    if s == "self" { return TokenKind.SelfVal }
    if s == "Self" { return TokenKind.SelfType }
    if s == "const" { return TokenKind.Const }
    if s == "pub" { return TokenKind.Pub }
    if s == "import" { return TokenKind.Import }
    if s == "as" { return TokenKind.As }
    if s == "from" { return TokenKind.From }
    if s == "mod" { return TokenKind.Mod }
    return TokenKind.Ident
}

fn lex(src: String) -> Tokens {
    let n = len(src)
    let mut items: [Token] = []
    let mut i = 0
    while i < n {
        let c = char_at(src, i)
        let mut handled = false
        if is_space(c) {
            i = i + 1
            handled = true
        }
        if !handled && c == '/' {
            if i + 1 < n {
                if char_at(src, i + 1) == '/' {
                    i = i + 2
                    let mut scanning = true
                    while i < n && scanning {
                        if char_at(src, i) == '\n' {
                            scanning = false
                        } else {
                            i = i + 1
                        }
                    }
                    handled = true
                }
            }
        }
        if !handled && is_alpha(c) {
            let start = i
            i = i + 1
            let mut scanning = true
            while i < n && scanning {
                if !is_alnum(char_at(src, i)) {
                    scanning = false
                } else {
                    i = i + 1
                }
            }
            let lexeme = substr(src, start, i - start)
            let kind = keyword_kind(lexeme)
            push(&mut items, Token { kind: kind, start: start, len: i - start })
            handled = true
        }
        if !handled && is_digit(c) {
            let start = i
            i = i + 1
            let mut scanning = true
            while i < n && scanning {
                if !is_digit(char_at(src, i)) {
                    scanning = false
                } else {
                    i = i + 1
                }
            }
            push(&mut items, Token { kind: TokenKind.Int, start: start, len: i - start })
            handled = true
        }
        if !handled && c == '"' {
            let start = i
            i = i + 1
            let mut scanning = true
            while i < n && scanning {
                let ch = char_at(src, i)
                if ch == '\\' {
                    if i + 1 < n {
                        i = i + 2
                    } else {
                        i = i + 1
                    }
                } else if ch == '"' {
                    scanning = false
                } else {
                    i = i + 1
                }
            }
            if i < n {
                i = i + 1
            }
            push(&mut items, Token { kind: TokenKind.String, start: start, len: i - start })
            handled = true
        }
        if !handled && c == '\'' {
            let start = i
            i = i + 1
            let mut scanning = true
            while i < n && scanning {
                let ch = char_at(src, i)
                if ch == '\\' {
                    if i + 1 < n {
                        i = i + 2
                    } else {
                        i = i + 1
                    }
                } else if ch == '\'' {
                    scanning = false
                } else {
                    i = i + 1
                }
            }
            if i < n {
                i = i + 1
            }
            push(&mut items, Token { kind: TokenKind.Char, start: start, len: i - start })
            handled = true
        }
        if !handled {
            let start = i
            let mut next = -1
            if i + 1 < n {
                next = char_at(src, i + 1)
            }
            if c == '=' && next == '=' {
                push(&mut items, Token { kind: TokenKind.EqEq, start: start, len: 2 })
                i = i + 2
                handled = true
            } else if c == '=' && next == '>' {
                push(&mut items, Token { kind: TokenKind.FatArrow, start: start, len: 2 })
                i = i + 2
                handled = true
            } else if c == '-' && next == '>' {
                push(&mut items, Token { kind: TokenKind.Arrow, start: start, len: 2 })
                i = i + 2
                handled = true
            } else if c == '!' && next == '=' {
                push(&mut items, Token { kind: TokenKind.NotEq, start: start, len: 2 })
                i = i + 2
                handled = true
            } else if c == '<' && next == '=' {
                push(&mut items, Token { kind: TokenKind.LtEq, start: start, len: 2 })
                i = i + 2
                handled = true
            } else if c == '>' && next == '=' {
                push(&mut items, Token { kind: TokenKind.GtEq, start: start, len: 2 })
                i = i + 2
                handled = true
            } else if c == '&' && next == '&' {
                push(&mut items, Token { kind: TokenKind.AndAnd, start: start, len: 2 })
                i = i + 2
                handled = true
            } else if c == '|' && next == '|' {
                push(&mut items, Token { kind: TokenKind.OrOr, start: start, len: 2 })
                i = i + 2
                handled = true
            } else if c == ':' && next == ':' {
                push(&mut items, Token { kind: TokenKind.ColonColon, start: start, len: 2 })
                i = i + 2
                handled = true
            } else {
                let kind = single_char_kind(c)
                if kind != TokenKind.Invalid {
                    push(&mut items, Token { kind: kind, start: start, len: 1 })
                    i = i + 1
                    handled = true
                }
            }
        }
        if !handled {
            i = i + 1
        }
    }
    push(&mut items, Token { kind: TokenKind.Eof, start: n, len: 0 })
    return Tokens { items: items }
}

struct Lexer {
    toks: Tokens,
    idx: i32,
}

fn lexer_new(src: String) -> Lexer {
    let toks = lex(src)
    return Lexer { toks: toks, idx: 0 }
}

fn lexer_pos(self: &Lexer) -> i32 {
    return self.idx
}

fn lexer_set_pos(self: &mut Lexer, pos: i32) {
    self.idx = pos
}

fn lexer_peek(self: &Lexer) -> Token {
    return token_at(self.toks, self.idx)
}

fn lexer_peek_n(self: &Lexer, n: i32) -> Token {
    return token_at(self.toks, self.idx + n)
}

fn lexer_next(self: &mut Lexer) -> Token {
    let tok = lexer_peek(self)
    self.idx = self.idx + 1
    return tok
}
