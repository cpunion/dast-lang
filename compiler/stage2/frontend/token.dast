struct Token {
    kind: TokenKind,
    start: i32,
    len: i32,
}

struct Tokens {
    items: [Token],
}

@repr(i32)
enum TokenKind {
    Invalid = -1,
    Eof = 0,
    Ident = 1,
    Int = 2,
    String = 3,
    Char = 4,
    Fn = 10,
    Let = 11,
    Mut = 12,
    If = 13,
    Else = 14,
    While = 15,
    Return = 16,
    Struct = 17,
    Enum = 18,
    Match = 19,
    True = 20,
    False = 21,
    Impl = 22,
    Trait = 72,
    SelfVal = 23,
    SelfType = 24,
    Const = 25,
    Pub = 26,
    Import = 27,
    As = 28,
    From = 29,
    Mod = 67,
    Loop = 68,
    Break = 69,
    Continue = 70,
    For = 73,
    Type = 74,
    Eq = 75,
    LParen = 30,
    RParen = 31,
    LBrace = 32,
    RBrace = 33,
    LBracket = 34,
    RBracket = 35,
    Comma = 36,
    Colon = 37,
    Semi = 38,
    Arrow = 39,
    FatArrow = 40,
    Dot = 41,
    At = 42,
    Assign = 50,
    Plus = 51,
    Minus = 52,
    Star = 53,
    Slash = 54,
    Percent = 55,
    Bang = 56,
    Amp = 57,
    Pipe = 58,
    EqEq = 59,
    NotEq = 60,
    Lt = 61,
    LtEq = 62,
    Gt = 63,
    GtEq = 64,
    AndAnd = 65,
    OrOr = 66,
    ColonColon = 71,
}

fn single_char_kind(c: i32) -> TokenKind {
    if c == '(' { return TokenKind.LParen }
    if c == ')' { return TokenKind.RParen }
    if c == '{' { return TokenKind.LBrace }
    if c == '}' { return TokenKind.RBrace }
    if c == '[' { return TokenKind.LBracket }
    if c == ']' { return TokenKind.RBracket }
    if c == ',' { return TokenKind.Comma }
    if c == ':' { return TokenKind.Colon }
    if c == ';' { return TokenKind.Semi }
    if c == '.' { return TokenKind.Dot }
    if c == '@' { return TokenKind.At }
    if c == '=' { return TokenKind.Assign }
    if c == '+' { return TokenKind.Plus }
    if c == '-' { return TokenKind.Minus }
    if c == '*' { return TokenKind.Star }
    if c == '/' { return TokenKind.Slash }
    if c == '%' { return TokenKind.Percent }
    if c == '!' { return TokenKind.Bang }
    if c == '&' { return TokenKind.Amp }
    if c == '|' { return TokenKind.Pipe }
    if c == '<' { return TokenKind.Lt }
    if c == '>' { return TokenKind.Gt }
    return TokenKind.Invalid
}

fn token_at(toks: Tokens, i: i32) -> Token {
    if i < 0 || i >= len(toks.items) {
        return Token { kind: TokenKind.Eof, start: 0, len: 0 }
    }
    return toks.items[i]
}

fn tok_kind(toks: Tokens, i: i32) -> TokenKind {
    return token_at(toks, i).kind
}

fn tok_start(toks: Tokens, i: i32) -> i32 {
    return token_at(toks, i).start
}

fn tok_len(toks: Tokens, i: i32) -> i32 {
    return token_at(toks, i).len
}

fn lexeme_at(src: String, toks: Tokens, i: i32) -> String {
    let start = tok_start(toks, i)
    let ln = tok_len(toks, i)
    return substr(src, start, ln)
}
