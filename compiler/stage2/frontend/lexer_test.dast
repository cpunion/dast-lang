// Unit tests for lexer char literals.

fn test_lexer_char_literals() {
    let src = string_clone("'a' '\\n' '\\'' '\\\\'")
    let toks = lexer_all(&src)
    assert_true(len(&toks) == 5, "bad token count")
    assert_true(toks[0].kind == TK_CHAR && toks[0].int_value == 97, "bad a")
    assert_true(toks[1].kind == TK_CHAR && toks[1].int_value == 10, "bad n")
    assert_true(toks[2].kind == TK_CHAR && toks[2].int_value == 39, "bad q")
    assert_true(toks[3].kind == TK_CHAR && toks[3].int_value == 92, "bad b")
    assert_true(toks[4].kind == TK_EOF, "missing eof")
}
