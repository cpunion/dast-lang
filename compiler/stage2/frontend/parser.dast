fn peek_kind(lex: &Lexer) -> TokenKind {
    return lexer_peek(lex).kind
}

fn peek_kind_n(lex: &Lexer, n: i32) -> TokenKind {
    return lexer_peek_n(lex, n).kind
}

fn current_lexeme(src: String, lex: &Lexer) -> String {
    let tok = lexer_peek(lex)
    return substr(src, tok.start, tok.len)
}

fn next_lexeme(src: String, lex: &mut Lexer) -> String {
    let tok = lexer_next(lex)
    return substr(src, tok.start, tok.len)
}

fn add_error(errors: &mut [ParseError], pos: i32, msg: String) {
    push(errors, ParseError { pos: pos, file: "", line: 0, col: 0, msg: msg })
}

fn sync_to_top_level(lex: &mut Lexer) {
    let mut done = false
    while !done {
        let k = peek_kind(lex)
        if k == TokenKind.Fn || k == TokenKind.Struct || k == TokenKind.Enum || k == TokenKind.Const || k == TokenKind.At || k == TokenKind.Eof {
            done = true
        } else {
            lexer_next(lex)
        }
    }
}

fn sync_to_stmt_end(lex: &mut Lexer) {
    let mut done = false
    while !done {
        let k = peek_kind(lex)
        if k == TokenKind.Semi {
            lexer_next(lex)
            done = true
        } else if k == TokenKind.RBrace || k == TokenKind.Eof {
            done = true
        } else {
            lexer_next(lex)
        }
    }
}

fn dummy_expr() -> Expr {
    return Expr.IntLit(IntLit { pos: -1, value: "0" })
}

fn infix_prec(k: TokenKind) -> i32 {
    if k == TokenKind.OrOr { return 1 }
    if k == TokenKind.AndAnd { return 2 }
    if k == TokenKind.EqEq || k == TokenKind.NotEq { return 3 }
    if k == TokenKind.Lt || k == TokenKind.LtEq || k == TokenKind.Gt || k == TokenKind.GtEq { return 4 }
    if k == TokenKind.Plus || k == TokenKind.Minus { return 5 }
    if k == TokenKind.Star || k == TokenKind.Slash || k == TokenKind.Percent { return 6 }
    return -1
}

fn looks_like_struct_lit(lex: &Lexer) -> bool {
    if peek_kind(lex) != TokenKind.LBrace {
        return false
    }
    let k1 = peek_kind_n(lex, 1)
    if k1 == TokenKind.RBrace {
        return true
    }
    if k1 == TokenKind.Ident && peek_kind_n(lex, 2) == TokenKind.Colon {
        return true
    }
    return false
}

fn parse_expr(src: String, lex: &mut Lexer, errors: &mut [ParseError], min_prec: i32) -> Expr {
    let mut left = parse_unary(src, lex, errors)
    let mut done = false
    while !done {
        let k = peek_kind(lex)
        let prec = infix_prec(k)
        if prec < min_prec {
            done = true
        } else {
            let op_pos = lexer_pos(lex)
            lexer_next(lex)
            let right = parse_expr(src, lex, errors, prec + 1)
            left = Expr.Binary(BinaryExpr { pos: op_pos, op: k, left: left, right: right })
        }
    }
    return left
}

fn parse_unary(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Expr {
    let k = peek_kind(lex)
    if k == TokenKind.Minus || k == TokenKind.Bang {
        let op_pos = lexer_pos(lex)
        lexer_next(lex)
        let expr = parse_unary(src, lex, errors)
        return Expr.Unary(UnaryExpr { pos: op_pos, op: k, expr: expr })
    }
    if k == TokenKind.Amp {
        let op_pos = lexer_pos(lex)
        lexer_next(lex)
        let mut mutable = false
        if peek_kind(lex) == TokenKind.Mut {
            mutable = true;
            lexer_next(lex)
        }
        let expr = parse_unary(src, lex, errors)
        return Expr.Ref(RefExpr { pos: op_pos, mutable: mutable, expr: expr })
    }
    if k == TokenKind.Star {
        let op_pos = lexer_pos(lex)
        lexer_next(lex)
        let expr = parse_unary(src, lex, errors)
        return Expr.Deref(DerefExpr { pos: op_pos, expr: expr })
    }
    return parse_postfix(src, lex, errors)
}

fn parse_postfix(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Expr {
    let mut expr = parse_primary(src, lex, errors)
    let mut done = false
    while !done {
        let k = peek_kind(lex)
        if k == TokenKind.Dot {
            let dot_pos = lexer_pos(lex)
            lexer_next(lex)
            if peek_kind(lex) != TokenKind.Ident {
                add_error(errors, lexer_pos(lex), "expected field name");
                lexer_next(lex)
                expr = Expr.Field(FieldExpr { pos: dot_pos, recv: expr, name: "" })
            } else {
                let name = next_lexeme(src, lex)
                expr = Expr.Field(FieldExpr { pos: dot_pos, recv: expr, name: name })
            }
        } else if k == TokenKind.LBracket {
            let idx_pos = lexer_pos(lex)
            lexer_next(lex)
            let index = parse_expr(src, lex, errors, 0)
            if peek_kind(lex) == TokenKind.RBracket {
                lexer_next(lex)
            } else {
                add_error(errors, lexer_pos(lex), "expected ']'");
            }
            expr = Expr.Index(IndexExpr { pos: idx_pos, recv: expr, index: index })
        } else if k == TokenKind.LParen {
            let call_pos = lexer_pos(lex)
            lexer_next(lex)
            let mut args: [Expr] = []
            if peek_kind(lex) != TokenKind.RParen {
                let mut more = true
                while more {
                    let arg = parse_expr(src, lex, errors, 0)
                    push(&mut args, arg)
                    if peek_kind(lex) == TokenKind.Comma {
                        lexer_next(lex)
                    } else {
                        more = false
                    }
                }
            }
            if peek_kind(lex) == TokenKind.RParen {
                lexer_next(lex)
            } else {
                add_error(errors, lexer_pos(lex), "expected ')'");
            }
            match expr {
                Expr.Ident(_) => {
                    expr = Expr.Call(CallExpr { pos: call_pos, callee: expr, args: args })
                }
                .Field(f) => {
                    expr = Expr.MethodCall(MethodCallExpr {
                        pos: call_pos,
                        recv: f.recv,
                        method: f.name,
                        args: args,
                        resolved_name: "",
                        resolved_self: false,
                        enum_name: "",
                    })
                }
                _ => {
                    add_error(errors, lexer_pos(lex), "can only call identifiers or field accesses");
                }
            }
        } else {
            done = true
        }
    }
    return expr
}

fn parse_primary(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Expr {
    let k = peek_kind(lex)
    let start_pos = lexer_pos(lex)
    if k == TokenKind.If && peek_kind_n(lex, 1) == TokenKind.Let {
        return parse_if_let_expr(src, lex, errors)
    }
    if k == TokenKind.Ident || k == TokenKind.SelfVal {
        let name = next_lexeme(src, lex)
        if looks_like_struct_lit(lex) {
            lexer_next(lex)
            let mut fields: [FieldInit] = []
            let mut done = false
            while !done {
                let fk = peek_kind(lex)
                if fk == TokenKind.RBrace || fk == TokenKind.Eof {
                    done = true
                } else {
                    if fk != TokenKind.Ident {
                        add_error(errors, lexer_pos(lex), "expected field name");
                        lexer_next(lex)
                    } else {
                        let field_pos = lexer_pos(lex)
                        let fname = next_lexeme(src, lex)
                        if peek_kind(lex) == TokenKind.Colon {
                            lexer_next(lex)
                        } else {
                            add_error(errors, lexer_pos(lex), "expected ':' in field");
                        }
                        let val = parse_expr(src, lex, errors, 0)
                        push(&mut fields, FieldInit { pos: field_pos, name: fname, value: val })
                        if peek_kind(lex) == TokenKind.Comma {
                            lexer_next(lex)
                        }
                    }
                }
            }
            if peek_kind(lex) == TokenKind.RBrace {
                lexer_next(lex)
            } else {
                add_error(errors, lexer_pos(lex), "expected '}'");
            }
            return Expr.StructLit(StructLit { pos: start_pos, name: name, fields: fields })
        }
        return Expr.Ident(IdentExpr { pos: start_pos, name: name })
    }
    if k == TokenKind.Int {
        let val = next_lexeme(src, lex)
        return Expr.IntLit(IntLit { pos: start_pos, value: val })
    }
    if k == TokenKind.String {
        let val = next_lexeme(src, lex)
        return Expr.StringLit(StringLit { pos: start_pos, value: val })
    }
    if k == TokenKind.Char {
        let val = next_lexeme(src, lex)
        return Expr.IntLit(IntLit { pos: start_pos, value: char_literal_to_int_string(val) })
    }
    if k == TokenKind.True {
        lexer_next(lex)
        return Expr.BoolLit(BoolLit { pos: start_pos, value: true })
    }
    if k == TokenKind.False {
        lexer_next(lex)
        return Expr.BoolLit(BoolLit { pos: start_pos, value: false })
    }
    if k == TokenKind.LParen {
        lexer_next(lex)
        let expr = parse_expr(src, lex, errors, 0)
        if peek_kind(lex) == TokenKind.RParen {
            lexer_next(lex)
        } else {
            add_error(errors, lexer_pos(lex), "expected ')'");
        }
        return expr
    }
    if k == TokenKind.LBracket {
        lexer_next(lex)
        let mut elems: [Expr] = []
        if peek_kind(lex) != TokenKind.RBracket {
            let mut more = true
            while more {
                let elem = parse_expr(src, lex, errors, 0)
                push(&mut elems, elem)
                if peek_kind(lex) == TokenKind.Comma {
                    lexer_next(lex)
                } else {
                    more = false
                }
            }
        }
        if peek_kind(lex) == TokenKind.RBracket {
            lexer_next(lex)
        } else {
            add_error(errors, lexer_pos(lex), "expected ']'");
        }
        return Expr.ArrayLit(ArrayLit { pos: start_pos, elems: elems })
    }
    add_error(errors, lexer_pos(lex), "unexpected token in expression");
    lexer_next(lex)
    return dummy_expr()
}

fn parse_ident(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> String {
    if peek_kind(lex) != TokenKind.Ident {
        add_error(errors, lexer_pos(lex), "expected identifier");
        lexer_next(lex)
        return ""
    }
    let name = next_lexeme(src, lex)
    return name
}

fn visibility_private() -> Visibility {
    return Visibility { kind: vis_private() }
}

fn parse_visibility(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Visibility {
    if peek_kind(lex) != TokenKind.Pub {
        return visibility_private()
    }
    lexer_next(lex)
    if peek_kind(lex) == TokenKind.LParen {
        lexer_next(lex)
        let scope = parse_ident(src, lex, errors)
        let mut kind = vis_pub()
        if scope == "crate" { kind = vis_pub_crate() }
        else if scope == "super" { kind = vis_pub_super() }
        else if scope != "" { add_error(errors, lexer_pos(lex), "unknown pub scope") }
        if peek_kind(lex) == TokenKind.RParen {
            lexer_next(lex)
        } else {
            add_error(errors, lexer_pos(lex), "expected ')'");
        }
        return Visibility { kind: kind }
    }
    return Visibility { kind: vis_pub() }
}

fn parse_param_name(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> String {
    let k = peek_kind(lex)
    if k != TokenKind.Ident && k != TokenKind.SelfVal {
        add_error(errors, lexer_pos(lex), "expected parameter name");
        lexer_next(lex)
        return ""
    }
    let name = next_lexeme(src, lex)
    return name
}

fn parse_type(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> String {
    let mut text = ""
    if peek_kind(lex) == TokenKind.Amp {
        text = "&";
        lexer_next(lex)
        if peek_kind(lex) == TokenKind.Mut {
            text = "&mut ";
            lexer_next(lex)
        }
    }
    if peek_kind(lex) == TokenKind.LBracket {
        lexer_next(lex)
        let inner = parse_type(src, lex, errors)
        if peek_kind(lex) == TokenKind.RBracket {
            lexer_next(lex)
        } else {
            add_error(errors, lexer_pos(lex), "expected ']' in type");
        }
        return text + "[" + inner + "]"
    }
    if peek_kind(lex) == TokenKind.SelfType {
        let name = next_lexeme(src, lex)
        return text + name
    }
    if peek_kind(lex) == TokenKind.Ident {
        let name = next_lexeme(src, lex)
        return text + name
    }
    add_error(errors, lexer_pos(lex), "expected type");
    lexer_next(lex)
    return ""
}

fn parse_path(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> String {
    let mut path = parse_ident(src, lex, errors)
    let mut done = false
    while !done {
        if peek_kind(lex) == TokenKind.Dot {
            lexer_next(lex)
            let seg = parse_ident(src, lex, errors)
            if seg != "" {
                path = path + "." + seg
            }
        } else {
            done = true
        }
    }
    return path
}

struct ParsedAttr {
    kind: String,
    repr: String,
}

struct ImportPath {
    path: String,
    is_string: bool,
}

fn parse_string_lit_token(raw: String) -> String {
    if len(raw) < 2 { return raw }
    let mut out = ""
    let mut i = 1
    let end = len(raw) - 1
    while i < end {
        let c = char_at(raw, i)
        let mut handled = false
        if c == 92 {
            if i + 1 < end {
                let n = char_at(raw, i + 1)
                if n == 110 { out = out + "\n" }
                else if n == 116 { out = out + "\t" }
                else if n == 92 { out = out + "\\" }
                else if n == 34 { out = out + "\"" }
                else { out = out + substr(raw, i + 1, 1) }
                i = i + 2
                handled = true
            }
        }
        if !handled {
            out = out + substr(raw, i, 1)
            i = i + 1
        }
    }
    return out
}

fn parse_import_path(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> ImportPath {
    if peek_kind(lex) == TokenKind.String {
        let raw = next_lexeme(src, lex)
        return ImportPath { path: parse_string_lit_token(raw), is_string: true }
    }
    return ImportPath { path: parse_path(src, lex, errors), is_string: false }
}

fn import_item_list_new() -> [ImportItemSpec] {
    let mut items: [ImportItemSpec] = []
    return items
}

fn generic_param_list_new() -> [GenericParam] {
    let mut params: [GenericParam] = []
    return params
}

fn parse_type_params(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> [GenericParam] {
    let mut params: [GenericParam] = []
    if peek_kind(lex) != TokenKind.LBracket {
        return params
    }
    lexer_next(lex)
    if peek_kind(lex) == TokenKind.RBracket {
        lexer_next(lex)
        return params
    }
    let mut done = false
    while !done {
        let param_pos = lexer_pos(lex)
        if peek_kind(lex) != TokenKind.Ident {
            add_error(errors, lexer_pos(lex), "expected type parameter name")
            done = true
        } else {
            let name = next_lexeme(src, lex)
            push(&mut params, GenericParam { pos: param_pos, name: name })
            if peek_kind(lex) == TokenKind.Comma {
                lexer_next(lex)
            } else {
                done = true
            }
        }
    }
    if peek_kind(lex) == TokenKind.RBracket {
        lexer_next(lex)
    } else {
        add_error(errors, lexer_pos(lex), "expected ']' after type parameters")
    }
    return params
}

fn parse_attribute(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> ParsedAttr {
    let name = parse_ident(src, lex, errors)
    if name == "test" {
        return ParsedAttr { kind: "test", repr: "" }
    }
    if name != "repr" {
        add_error(errors, lexer_pos(lex), "unknown attribute");
        return ParsedAttr { kind: "", repr: "" }
    }
    if peek_kind(lex) == TokenKind.LParen {
        lexer_next(lex)
    } else {
        add_error(errors, lexer_pos(lex), "expected '(' after repr");
    }
    let repr = parse_ident(src, lex, errors)
    if peek_kind(lex) == TokenKind.RParen {
        lexer_next(lex)
    } else {
        add_error(errors, lexer_pos(lex), "expected ')'");
    }
    return ParsedAttr { kind: "repr", repr: repr }
}

fn parse_const_value(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> ConstValue {
    let k = peek_kind(lex)
    if k == TokenKind.Minus {
        lexer_next(lex)
        if peek_kind(lex) == TokenKind.Int {
            let val = "-" + next_lexeme(src, lex)
            return ConstValue { kind: const_kind_int(), int_value: val, str_value: "", bool_value: false }
        }
        add_error(errors, lexer_pos(lex), "expected int literal after '-'");
        return ConstValue { kind: const_kind_int(), int_value: "0", str_value: "", bool_value: false }
    }
    if k == TokenKind.Int {
        let val = next_lexeme(src, lex)
        return ConstValue { kind: const_kind_int(), int_value: val, str_value: "", bool_value: false }
    }
    if k == TokenKind.True {
        lexer_next(lex)
        return ConstValue { kind: const_kind_bool(), int_value: "", str_value: "", bool_value: true }
    }
    if k == TokenKind.False {
        lexer_next(lex)
        return ConstValue { kind: const_kind_bool(), int_value: "", str_value: "", bool_value: false }
    }
    if k == TokenKind.String {
        let val = next_lexeme(src, lex)
        return ConstValue { kind: const_kind_string(), int_value: "", str_value: val, bool_value: false }
    }
    if k == TokenKind.Char {
        let val = next_lexeme(src, lex)
        return ConstValue { kind: const_kind_int(), int_value: char_literal_to_int_string(val), str_value: "", bool_value: false }
    }
    add_error(errors, lexer_pos(lex), "expected const literal");
    lexer_next(lex)
    return ConstValue { kind: const_kind_int(), int_value: "0", str_value: "", bool_value: false }
}

fn char_literal_to_int_string(text: String) -> String {
    let code = parse_char_literal(text)
    return int_to_string(code)
}

fn parse_char_literal(text: String) -> i32 {
    if len(text) < 2 { return 0 }
    let mut i = 1
    let end = len(text) - 1
    if i >= end { return 0 }
    let c = char_at(text, i)
    if c == '\\' {
        if i + 1 >= end { return 0 }
        let n = char_at(text, i + 1)
        if n == 'n' { return '\n' }
        if n == 't' { return '\t' }
        if n == 'r' { return '\r' }
        if n == '\\' { return '\\' }
        if n == '\'' { return '\'' }
        return n
    }
    return c
}

fn parse_params(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> [Param] {
    let mut params: [Param] = []
    if peek_kind(lex) == TokenKind.RParen {
        return params
    }
    let mut done = false
    while !done {
        let param_pos = lexer_pos(lex)
        let name = parse_param_name(src, lex, errors)
        if peek_kind(lex) == TokenKind.Colon {
            lexer_next(lex)
        } else {
            add_error(errors, lexer_pos(lex), "expected ':' in param");
        }
        let typ = parse_type(src, lex, errors)
        push(&mut params, Param { pos: param_pos, name: name, typ: typ })
        if peek_kind(lex) == TokenKind.Comma {
            lexer_next(lex)
        } else {
            done = true
        }
    }
    return params
}

fn parse_const_decl(src: String, lex: &mut Lexer, errors: &mut [ParseError], vis: Visibility, pos: i32) -> ConstDecl {
    let name = parse_ident(src, lex, errors)
    let mut has_type = false
    let mut typ = ""
    if peek_kind(lex) == TokenKind.Colon {
        lexer_next(lex)
        typ = parse_type(src, lex, errors)
        has_type = true
    }
    if peek_kind(lex) == TokenKind.Assign {
        lexer_next(lex)
    } else {
        add_error(errors, lexer_pos(lex), "expected '=' in const");
    }
    let value = parse_const_value(src, lex, errors)
    maybe_consume_semi(lex)
    return ConstDecl { vis: vis, module: "", file: "", pos: pos, name: name, has_type: has_type, typ: typ, value: value }
}

fn parse_impl(src: String, lex: &mut Lexer, errors: &mut [ParseError], vis: Visibility, pos: i32) -> ImplDecl {
    lexer_next(lex)
    let type_name = parse_ident(src, lex, errors)
    let mut methods: [FunctionDecl] = []
    if peek_kind(lex) != TokenKind.LBrace {
        add_error(errors, lexer_pos(lex), "expected '{' after impl");
        sync_to_top_level(lex)
        return ImplDecl { vis: vis, module: "", file: "", pos: pos, type_name: type_name, methods: methods }
    }
    lexer_next(lex)
    let mut done = false
    while !done {
        let k = peek_kind(lex)
        if k == TokenKind.RBrace || k == TokenKind.Eof {
            done = true
        } else if k == TokenKind.Pub || k == TokenKind.Fn {
            let mvis = parse_visibility(src, lex, errors)
            let mut ok = true
            let mut fn_pos = lexer_pos(lex)
            if peek_kind(lex) == TokenKind.Fn {
                lexer_next(lex)
            } else {
                add_error(errors, lexer_pos(lex), "expected fn");
                lexer_next(lex)
                ok = false
            }
            if ok {
                let name = parse_ident(src, lex, errors)
                let mut params: [Param] = []
                let mut has_return = false
                let mut ret = ""
                let mut body = empty_block()
                if peek_kind(lex) == TokenKind.LParen {
                    lexer_next(lex)
                    params = parse_params(src, lex, errors)
                    if peek_kind(lex) == TokenKind.RParen {
                        lexer_next(lex)
                    } else {
                        add_error(errors, lexer_pos(lex), "expected ')'");
                    }
                } else {
                    add_error(errors, lexer_pos(lex), "expected '(' after fn name");
                }
                if peek_kind(lex) == TokenKind.Arrow {
                    lexer_next(lex)
                    ret = parse_type(src, lex, errors)
                    has_return = true
                }
                if peek_kind(lex) == TokenKind.LBrace {
                    body = parse_block(src, lex, errors)
                } else {
                    add_error(errors, lexer_pos(lex), "expected '{' for function body");
                }
                push(&mut methods, FunctionDecl {
                    vis: mvis,
                    module: "",
                    file: "",
                    pos: fn_pos,
                    name: name,
                    type_params: generic_param_list_new(),
                    is_test: false,
                    params: params,
                    has_return: has_return,
                    ret: ret,
                    body: body,
                })
            }
        } else {
            add_error(errors, lexer_pos(lex), "expected method");
            lexer_next(lex)
        }
    }
    if peek_kind(lex) == TokenKind.RBrace {
        lexer_next(lex)
    }
    return ImplDecl { vis: vis, module: "", file: "", pos: pos, type_name: type_name, methods: methods }
}

fn parse_struct_decl(src: String, lex: &mut Lexer, errors: &mut [ParseError], vis: Visibility, pos: i32) -> StructDecl {
    lexer_next(lex)
    let name = parse_ident(src, lex, errors)
    let type_params = parse_type_params(src, lex, errors)
    let mut fields: [Field] = []
    if peek_kind(lex) != TokenKind.LBrace {
        add_error(errors, lexer_pos(lex), "expected '{' after struct");
        sync_to_top_level(lex)
        return StructDecl { vis: vis, module: "", file: "", pos: pos, name: name, type_params: type_params, fields: fields }
    }
    lexer_next(lex)
    let mut done = false
    while !done {
        let k = peek_kind(lex)
        if k == TokenKind.RBrace || k == TokenKind.Eof {
            done = true
        } else {
            let fvis = parse_visibility(src, lex, errors)
            if peek_kind(lex) != TokenKind.Ident {
                add_error(errors, lexer_pos(lex), "expected field name");
                lexer_next(lex)
            } else {
                let field_pos = lexer_pos(lex)
                let fname = next_lexeme(src, lex)
                if peek_kind(lex) == TokenKind.Colon {
                    lexer_next(lex)
                } else {
                    add_error(errors, lexer_pos(lex), "expected ':' in field");
                }
                let typ = parse_type(src, lex, errors)
                push(&mut fields, Field { vis: fvis, pos: field_pos, name: fname, typ: typ })
                if peek_kind(lex) == TokenKind.Comma {
                    lexer_next(lex)
                }
            }
        }
    }
    if peek_kind(lex) == TokenKind.RBrace {
        lexer_next(lex)
    }
    return StructDecl { vis: vis, module: "", file: "", pos: pos, name: name, type_params: type_params, fields: fields }
}

fn parse_enum_decl(src: String, lex: &mut Lexer, errors: &mut [ParseError], repr: String, vis: Visibility, pos: i32) -> EnumDecl {
    lexer_next(lex)
    let name = parse_ident(src, lex, errors)
    let type_params = parse_type_params(src, lex, errors)
    let mut variants: [Variant] = []
    if peek_kind(lex) != TokenKind.LBrace {
        add_error(errors, lexer_pos(lex), "expected '{' after enum");
        sync_to_top_level(lex)
        return EnumDecl { vis: vis, module: "", file: "", pos: pos, name: name, type_params: type_params, repr: repr, variants: variants }
    }
    lexer_next(lex)
    let mut done = false
    while !done {
        let k = peek_kind(lex)
        if k == TokenKind.RBrace || k == TokenKind.Eof {
            done = true
        } else {
            if k != TokenKind.Ident {
                add_error(errors, lexer_pos(lex), "expected variant name");
                lexer_next(lex)
            } else {
                let variant_pos = lexer_pos(lex)
                let vname = next_lexeme(src, lex)
                let mut has_payload = false
                let mut payload = ""
                let mut has_value = false
                let mut value = ""
                if peek_kind(lex) == TokenKind.LParen {
                    lexer_next(lex)
                    payload = parse_type(src, lex, errors)
                    has_payload = true
                    if peek_kind(lex) == TokenKind.RParen {
                        lexer_next(lex)
                    } else {
                        add_error(errors, lexer_pos(lex), "expected ')' after variant payload");
                    }
                }
                if peek_kind(lex) == TokenKind.Assign {
                    lexer_next(lex)
                    let v = parse_const_value(src, lex, errors)
                    if v.kind != const_kind_int() {
                        add_error(errors, lexer_pos(lex), "enum discriminant must be int");
                    } else {
                        has_value = true
                        value = v.int_value
                    }
                }
                push(&mut variants, Variant { pos: variant_pos, name: vname, has_payload: has_payload, payload: payload, has_value: has_value, value: value })
                if peek_kind(lex) == TokenKind.Comma {
                    lexer_next(lex)
                }
            }
        }
    }
    if peek_kind(lex) == TokenKind.RBrace {
        lexer_next(lex)
    }
    return EnumDecl { vis: vis, module: "", file: "", pos: pos, name: name, type_params: type_params, repr: repr, variants: variants }
}

fn parse_import_decl(src: String, lex: &mut Lexer, errors: &mut [ParseError], vis: Visibility, pos: i32) -> ImportDecl {
    lexer_next(lex)
    let mut items: [ImportItemSpec] = []
    let mut has_items = false
    let mut path = ""
    let mut path_is_string = false
    let mut has_alias = false
    let mut alias = ""
    if peek_kind(lex) == TokenKind.LBrace {
        lexer_next(lex)
        has_items = true
        let mut done = false
        while !done {
            if peek_kind(lex) == TokenKind.RBrace || peek_kind(lex) == TokenKind.Eof {
                done = true
            } else {
                let item_pos = lexer_pos(lex)
                let name = parse_ident(src, lex, errors)
                let mut has_item_alias = false
                let mut item_alias = ""
                if peek_kind(lex) == TokenKind.As {
                    lexer_next(lex)
                    item_alias = parse_ident(src, lex, errors)
                    has_item_alias = item_alias != ""
                }
                if name != "" {
                    push(&mut items, ImportItemSpec {
                        pos: item_pos,
                        name: name,
                        has_alias: has_item_alias,
                        alias: item_alias,
                    })
                }
                if peek_kind(lex) == TokenKind.Comma {
                    lexer_next(lex)
                }
            }
        }
        if peek_kind(lex) == TokenKind.RBrace {
            lexer_next(lex)
        } else {
            add_error(errors, lexer_pos(lex), "expected '}' in import list");
        }
        if peek_kind(lex) == TokenKind.From {
            lexer_next(lex)
        } else {
            add_error(errors, lexer_pos(lex), "expected 'from' in import");
        }
        let res = parse_import_path(src, lex, errors)
        path = res.path
        path_is_string = res.is_string
        if !path_is_string {
            add_error(errors, lexer_pos(lex), "import path must be string literal")
        }
        if path == "" {
            add_error(errors, lexer_pos(lex), "import path cannot be empty")
        }
    } else {
        let res = parse_import_path(src, lex, errors)
        path = res.path
        path_is_string = res.is_string
        if !path_is_string {
            add_error(errors, lexer_pos(lex), "import path must be string literal")
        }
        if path == "" {
            add_error(errors, lexer_pos(lex), "import path cannot be empty")
        }
    }
    if peek_kind(lex) == TokenKind.As {
        lexer_next(lex)
        alias = parse_ident(src, lex, errors)
        has_alias = alias != ""
    }
    maybe_consume_semi(lex)
    return ImportDecl { vis: vis, module: "", file: "", pos: pos, has_items: has_items, items: items, path: path, path_is_string: path_is_string, has_alias: has_alias, alias: alias }
}

fn maybe_consume_semi(lex: &mut Lexer) {
    if peek_kind(lex) == TokenKind.Semi {
        lexer_next(lex)
    }
}

fn empty_block() -> Block {
    let mut stmts: [Stmt] = []
    return Block { stmts: stmts }
}

fn parse_block(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Block {
    let mut stmts: [Stmt] = []
    if peek_kind(lex) != TokenKind.LBrace {
        add_error(errors, lexer_pos(lex), "expected '{'");
        sync_to_stmt_end(lex)
        return Block { stmts: stmts }
    }
    lexer_next(lex)
    while peek_kind(lex) != TokenKind.RBrace && peek_kind(lex) != TokenKind.Eof {
        let stmt = parse_stmt(src, lex, errors)
        push(&mut stmts, stmt)
    }
    if peek_kind(lex) == TokenKind.RBrace {
        lexer_next(lex)
    } else {
        add_error(errors, lexer_pos(lex), "expected '}'");
    }
    return Block { stmts: stmts }
}

fn parse_let(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> LetStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    let mut mutable = false
    if peek_kind(lex) == TokenKind.Mut {
        mutable = true;
        lexer_next(lex)
    }
    let name = parse_ident(src, lex, errors)
    let mut has_type = false
    let mut typ = ""
    if peek_kind(lex) == TokenKind.Colon {
        lexer_next(lex)
        typ = parse_type(src, lex, errors)
        has_type = true
    }
    let mut has_init = false
    let mut init = dummy_expr()
    if peek_kind(lex) == TokenKind.Assign {
        lexer_next(lex)
        init = parse_expr(src, lex, errors, 0)
        has_init = true
    }
    maybe_consume_semi(lex)
    return LetStmt { pos: pos, name: name, mutable: mutable, has_type: has_type, typ: typ, has_init: has_init, init: init }
}

fn parse_return(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> ReturnStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    if peek_kind(lex) == TokenKind.Semi || peek_kind(lex) == TokenKind.RBrace {
        maybe_consume_semi(lex)
        return ReturnStmt { pos: pos, has_value: false, value: dummy_expr() }
    }
    let expr = parse_expr(src, lex, errors, 0)
    maybe_consume_semi(lex)
    return ReturnStmt { pos: pos, has_value: true, value: expr }
}

fn parse_if(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> IfStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    let cond = parse_expr(src, lex, errors, 0)
    let then_block = parse_block(src, lex, errors)
    let mut has_else = false
    let mut else_block = empty_block()
    if peek_kind(lex) == TokenKind.Else {
        lexer_next(lex)
        has_else = true;
        if peek_kind(lex) == TokenKind.If {
            let nested = parse_if(src, lex, errors)
            let mut stmts: [Stmt] = []
            push(&mut stmts, Stmt.If(nested))
            else_block = Block { stmts: stmts }
        } else {
            else_block = parse_block(src, lex, errors)
        }
    }
    return IfStmt { pos: pos, cond: cond, then_block: then_block, has_else: has_else, else_block: else_block }
}

fn parse_if_let(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> MatchStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    lexer_next(lex)
    let pat = parse_pattern(src, lex, errors)
    if peek_kind(lex) == TokenKind.Assign {
        lexer_next(lex)
    } else {
        add_error(errors, lexer_pos(lex), "expected '=' in if let");
    }
    let expr = parse_expr(src, lex, errors, 0)
    let then_block = parse_block(src, lex, errors)
    let mut has_else = false
    let mut else_block = empty_block()
    if peek_kind(lex) == TokenKind.Else {
        lexer_next(lex)
        has_else = true;
        if peek_kind(lex) == TokenKind.If {
            let nested = parse_if(src, lex, errors)
            let mut stmts: [Stmt] = []
            push(&mut stmts, Stmt.If(nested))
            else_block = Block { stmts: stmts }
        } else {
            else_block = parse_block(src, lex, errors)
        }
    }
    let mut arms: [MatchArm] = []
    push(&mut arms, MatchArm { pos: pos, pattern: pat, has_guard: false, guard: dummy_expr(), body: then_block })
    let mut else_body = empty_block()
    if has_else { else_body = else_block }
    push(&mut arms, MatchArm { pos: pos, pattern: Pattern.Wildcard(WildcardPattern {}), has_guard: false, guard: dummy_expr(), body: else_body })
    return MatchStmt { pos: pos, expr: expr, arms: arms }
}

fn parse_if_let_expr(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Expr {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    lexer_next(lex)
    let pat = parse_pattern(src, lex, errors)
    if peek_kind(lex) == TokenKind.Assign {
        lexer_next(lex)
    } else {
        add_error(errors, lexer_pos(lex), "expected '=' in if let");
    }
    let expr = parse_expr(src, lex, errors, 0)
    let then_block = parse_block(src, lex, errors)
    let mut has_else = false
    let mut else_block = empty_block()
    if peek_kind(lex) == TokenKind.Else {
        lexer_next(lex)
        has_else = true;
        if peek_kind(lex) == TokenKind.If {
            let nested = parse_if(src, lex, errors)
            let mut stmts: [Stmt] = []
            push(&mut stmts, Stmt.If(nested))
            else_block = Block { stmts: stmts }
        } else {
            else_block = parse_block(src, lex, errors)
        }
    }
    return Expr.IfLet(IfLetExpr { pos: pos, pattern: pat, expr: expr, then_block: then_block, has_else: has_else, else_block: else_block })
}

fn parse_while(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> WhileStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    let cond = parse_expr(src, lex, errors, 0)
    let body = parse_block(src, lex, errors)
    return WhileStmt { pos: pos, cond: cond, body: body }
}

fn parse_loop(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> WhileStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    let cond = Expr.BoolLit(BoolLit { pos: pos, value: true })
    let body = parse_block(src, lex, errors)
    return WhileStmt { pos: pos, cond: cond, body: body }
}

fn parse_break(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> BreakStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    maybe_consume_semi(lex)
    return BreakStmt { pos: pos }
}

fn parse_continue(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> ContinueStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    maybe_consume_semi(lex)
    return ContinueStmt { pos: pos }
}

fn parse_pattern(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Pattern {
    let k = peek_kind(lex)
    if k == TokenKind.Minus || k == TokenKind.Int || k == TokenKind.True || k == TokenKind.False || k == TokenKind.String || k == TokenKind.Char {
        let pos = lexer_pos(lex)
        let val = parse_const_value(src, lex, errors)
        if peek_kind(lex) == TokenKind.Dot && peek_kind_n(lex, 1) == TokenKind.Dot {
            lexer_next(lex)
            lexer_next(lex)
            let mut inclusive = false
            if peek_kind(lex) == TokenKind.Assign {
                inclusive = true
                lexer_next(lex)
            }
            let end = parse_const_value(src, lex, errors)
            return Pattern.Range(RangePattern { pos: pos, start: val, end: end, inclusive: inclusive })
        }
        return Pattern.Literal(LiteralPattern { pos: pos, value: val })
    }
    if k == TokenKind.Ident {
        let pos = lexer_pos(lex)
        let name = next_lexeme(src, lex)
        if name == "_" {
            return Pattern.Wildcard(WildcardPattern {})
        }
        if peek_kind(lex) == TokenKind.LBrace {
            lexer_next(lex)
            let mut fields: [StructPatternField] = []
            let mut has_rest = false
            let mut done = false
            while !done {
                let fk = peek_kind(lex)
                if fk == TokenKind.RBrace || fk == TokenKind.Eof {
                    done = true
                } else {
                    if has_rest {
                        add_error(errors, lexer_pos(lex), "rest pattern must be last");
                    }
                    if fk == TokenKind.Dot && peek_kind_n(lex, 1) == TokenKind.Dot {
                        if has_rest {
                            add_error(errors, lexer_pos(lex), "duplicate '..' in struct pattern");
                        }
                        lexer_next(lex)
                        lexer_next(lex)
                        has_rest = true
                        if peek_kind(lex) == TokenKind.Comma {
                            lexer_next(lex)
                        }
                    } else if fk != TokenKind.Ident {
                        add_error(errors, lexer_pos(lex), "expected field name");
                        lexer_next(lex)
                    } else {
                        let field_pos = lexer_pos(lex)
                        let fname = next_lexeme(src, lex)
                        let mut bind = true
                        let mut has_pattern = false
                        let mut pat = Pattern.Wildcard(WildcardPattern {})
                        if peek_kind(lex) == TokenKind.Colon {
                            lexer_next(lex)
                            bind = false
                            has_pattern = true
                            pat = parse_pattern(src, lex, errors)
                        }
                        push(&mut fields, StructPatternField { pos: field_pos, name: fname, bind: bind, has_pattern: has_pattern, pattern: pat })
                        if peek_kind(lex) == TokenKind.Comma {
                            lexer_next(lex)
                        }
                    }
                }
            }
            if peek_kind(lex) == TokenKind.RBrace {
                lexer_next(lex)
            } else {
                add_error(errors, lexer_pos(lex), "expected '}'");
            }
            return Pattern.Struct(StructPattern { pos: pos, name: name, fields: fields, has_rest: has_rest })
        }
        if peek_kind(lex) == TokenKind.Dot {
            lexer_next(lex)
            if peek_kind(lex) != TokenKind.Ident {
                add_error(errors, lexer_pos(lex), "expected variant name");
                lexer_next(lex)
                return Pattern.Variant(VariantPattern { pos: pos, enum_name: name, variant: "", has_binding: false, binding: "" })
            }
            let variant = next_lexeme(src, lex)
            let mut has_binding = false
            let mut binding = ""
            if peek_kind(lex) == TokenKind.LParen {
                lexer_next(lex)
                if peek_kind(lex) == TokenKind.Ident {
                    binding = next_lexeme(src, lex)
                    has_binding = true
                } else {
                    add_error(errors, lexer_pos(lex), "expected binding name");
                }
                if peek_kind(lex) == TokenKind.RParen {
                    lexer_next(lex)
                } else {
                    add_error(errors, lexer_pos(lex), "expected ')'");
                }
            }
            return Pattern.Variant(VariantPattern { pos: pos, enum_name: name, variant: variant, has_binding: has_binding, binding: binding })
        }
        return Pattern.Bind(BindPattern { pos: pos, name: name })
    }
    if k == TokenKind.Dot {
        let pos = lexer_pos(lex)
        lexer_next(lex)
        if peek_kind(lex) != TokenKind.Ident {
            add_error(errors, lexer_pos(lex), "expected variant name");
            lexer_next(lex)
            return Pattern.Variant(VariantPattern { pos: pos, enum_name: "", variant: "", has_binding: false, binding: "" })
        }
        let variant = next_lexeme(src, lex)
        let mut has_binding = false
        let mut binding = ""
        if peek_kind(lex) == TokenKind.LParen {
            lexer_next(lex)
            if peek_kind(lex) == TokenKind.Ident {
                binding = next_lexeme(src, lex)
                has_binding = true
            } else {
                add_error(errors, lexer_pos(lex), "expected binding name");
            }
            if peek_kind(lex) == TokenKind.RParen {
                lexer_next(lex)
            } else {
                add_error(errors, lexer_pos(lex), "expected ')'");
            }
        }
        return Pattern.Variant(VariantPattern { pos: pos, enum_name: "", variant: variant, has_binding: has_binding, binding: binding })
    }
    add_error(errors, lexer_pos(lex), "unexpected pattern");
    lexer_next(lex)
    return Pattern.Wildcard(WildcardPattern {})
}

fn parse_match(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> MatchStmt {
    let pos = lexer_pos(lex)
    lexer_next(lex)
    let expr = parse_expr(src, lex, errors, 0)
    if peek_kind(lex) != TokenKind.LBrace {
        add_error(errors, lexer_pos(lex), "expected '{' after match");
        let mut empty: [MatchArm] = []
        return MatchStmt { pos: pos, expr: expr, arms: empty }
    }
    lexer_next(lex)
    let mut arms: [MatchArm] = []
    let mut done = false
    while !done {
        let k = peek_kind(lex)
        if k == TokenKind.RBrace || k == TokenKind.Eof {
            done = true
        } else {
            let arm_pos = lexer_pos(lex)
            let mut patterns: [Pattern] = []
            let first_pat = parse_pattern(src, lex, errors)
            push(&mut patterns, first_pat)
            while peek_kind(lex) == TokenKind.Pipe {
                lexer_next(lex)
                let next_pat = parse_pattern(src, lex, errors)
                push(&mut patterns, next_pat)
            }
            let mut has_guard = false
            let mut guard_expr = dummy_expr()
            if peek_kind(lex) == TokenKind.If {
                lexer_next(lex)
                has_guard = true
                guard_expr = parse_expr(src, lex, errors, 0)
            }
            if peek_kind(lex) == TokenKind.FatArrow {
                lexer_next(lex)
            } else {
                add_error(errors, lexer_pos(lex), "expected '=>'");
            }
            let mut body = empty_block()
            if peek_kind(lex) == TokenKind.LBrace {
                body = parse_block(src, lex, errors)
            } else {
                let expr_body = parse_expr(src, lex, errors, 0)
                let mut stmts: [Stmt] = []
                push(&mut stmts, Stmt.Expr(ExprStmt { pos: arm_pos, expr: expr_body }))
                body = Block { stmts: stmts }
                maybe_consume_semi(lex)
            }
            let mut pi = 0
            while pi < len(patterns) {
                push(&mut arms, MatchArm { pos: arm_pos, pattern: patterns[pi], has_guard: has_guard, guard: guard_expr, body: body })
                pi = pi + 1
            }
            if peek_kind(lex) == TokenKind.Comma {
                lexer_next(lex)
            }
        }
    }
    if peek_kind(lex) == TokenKind.RBrace {
        lexer_next(lex)
    }
    return MatchStmt { pos: pos, expr: expr, arms: arms }
}

fn parse_stmt(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Stmt {
    let k = peek_kind(lex)
    if k == TokenKind.Let {
        return Stmt.Let(parse_let(src, lex, errors))
    }
    if k == TokenKind.Return {
        return Stmt.Return(parse_return(src, lex, errors))
    }
    if k == TokenKind.If {
        if peek_kind_n(lex, 1) == TokenKind.Let {
            return Stmt.Match(parse_if_let(src, lex, errors))
        }
        return Stmt.If(parse_if(src, lex, errors))
    }
    if k == TokenKind.While {
        return Stmt.While(parse_while(src, lex, errors))
    }
    if k == TokenKind.Loop {
        return Stmt.While(parse_loop(src, lex, errors))
    }
    if k == TokenKind.Break {
        return Stmt.Break(parse_break(src, lex, errors))
    }
    if k == TokenKind.Continue {
        return Stmt.Continue(parse_continue(src, lex, errors))
    }
    if k == TokenKind.Match {
        return Stmt.Match(parse_match(src, lex, errors))
    }
    let stmt_pos = lexer_pos(lex)
    let expr = parse_expr(src, lex, errors, 0)
    if peek_kind(lex) == TokenKind.Assign {
        lexer_next(lex)
        let value = parse_expr(src, lex, errors, 0)
        maybe_consume_semi(lex)
        return Stmt.Assign(AssignStmt { pos: stmt_pos, target: expr, value: value })
    }
    maybe_consume_semi(lex)
    return Stmt.Expr(ExprStmt { pos: stmt_pos, expr: expr })
}

fn parse_program(src: String, lex: &mut Lexer, errors: &mut [ParseError]) -> Program {
    let mut imports: [ImportDecl] = []
    let mut structs: [StructDecl] = []
    let mut enums: [EnumDecl] = []
    let mut consts: [ConstDecl] = []
    let mut functions: [FunctionDecl] = []
    let mut impls: [ImplDecl] = []
    let mut pending_repr = ""
    let mut pending_test = false
    while peek_kind(lex) != TokenKind.Eof {
        let k = peek_kind(lex)
        if k == TokenKind.At {
            lexer_next(lex)
            let attr = parse_attribute(src, lex, errors)
            if attr.kind == "repr" && attr.repr != "" {
                if pending_repr != "" {
                    add_error(errors, lexer_pos(lex), "duplicate repr attribute");
                } else {
                    pending_repr = attr.repr
                }
            } else if attr.kind == "test" {
                if pending_test {
                    add_error(errors, lexer_pos(lex), "duplicate test attribute");
                } else {
                    pending_test = true
                }
            }
        } else {
            let vis = parse_visibility(src, lex, errors)
            let kk = peek_kind(lex)
            if kk == TokenKind.Import {
                if pending_test {
                    add_error(errors, lexer_pos(lex), "test attribute only valid on function");
                    pending_test = false
                }
                let import_pos = lexer_pos(lex)
                let decl = parse_import_decl(src, lex, errors, vis, import_pos)
                push(&mut imports, decl)
            } else if kk == TokenKind.Mod {
                if pending_test {
                    add_error(errors, lexer_pos(lex), "test attribute only valid on function");
                    pending_test = false
                }
                let mod_pos = lexer_pos(lex)
                lexer_next(lex)
                let name = parse_ident(src, lex, errors)
                maybe_consume_semi(lex)
                push(&mut imports, ImportDecl { vis: vis, module: "", file: "", pos: mod_pos, has_items: false, items: import_item_list_new(), path: name, path_is_string: false, has_alias: false, alias: "" })
            } else if kk == TokenKind.Struct {
                if pending_test {
                    add_error(errors, lexer_pos(lex), "test attribute only valid on function");
                    pending_test = false
                }
                if pending_repr != "" {
                    add_error(errors, lexer_pos(lex), "repr only valid on enum");
                    pending_repr = ""
                }
                let struct_pos = lexer_pos(lex)
                let decl = parse_struct_decl(src, lex, errors, vis, struct_pos)
                push(&mut structs, decl)
            } else if kk == TokenKind.Enum {
                if pending_test {
                    add_error(errors, lexer_pos(lex), "test attribute only valid on function");
                    pending_test = false
                }
                let enum_pos = lexer_pos(lex)
                let decl = parse_enum_decl(src, lex, errors, pending_repr, vis, enum_pos)
                pending_repr = ""
                push(&mut enums, decl)
            } else if kk == TokenKind.Const {
                if pending_test {
                    add_error(errors, lexer_pos(lex), "test attribute only valid on function");
                    pending_test = false
                }
                if pending_repr != "" {
                    add_error(errors, lexer_pos(lex), "repr only valid on enum");
                    pending_repr = ""
                }
                let const_pos = lexer_pos(lex)
                lexer_next(lex)
                let decl = parse_const_decl(src, lex, errors, vis, const_pos)
                push(&mut consts, decl)
            } else if kk == TokenKind.Impl {
                if pending_test {
                    add_error(errors, lexer_pos(lex), "test attribute only valid on function");
                    pending_test = false
                }
                if pending_repr != "" {
                    add_error(errors, lexer_pos(lex), "repr only valid on enum");
                    pending_repr = ""
                }
                let impl_pos = lexer_pos(lex)
                let decl = parse_impl(src, lex, errors, vis, impl_pos)
                push(&mut impls, decl)
            } else if kk == TokenKind.Fn {
                if pending_repr != "" {
                    add_error(errors, lexer_pos(lex), "repr only valid on enum");
                    pending_repr = ""
                }
                let fn_pos = lexer_pos(lex)
                lexer_next(lex)
                let name = parse_ident(src, lex, errors)
                let mut params: [Param] = []
                let mut has_return = false
                let mut ret = ""
                let mut body = empty_block()
                if peek_kind(lex) == TokenKind.LParen {
                    lexer_next(lex)
                    params = parse_params(src, lex, errors)
                    if peek_kind(lex) == TokenKind.RParen {
                        lexer_next(lex)
                    } else {
                        add_error(errors, lexer_pos(lex), "expected ')'");
                    }
                } else {
                    add_error(errors, lexer_pos(lex), "expected '(' after fn name");
                }
                if peek_kind(lex) == TokenKind.Arrow {
                    lexer_next(lex)
                    ret = parse_type(src, lex, errors)
                    has_return = true
                }
                if peek_kind(lex) == TokenKind.LBrace {
                    body = parse_block(src, lex, errors)
                } else {
                    add_error(errors, lexer_pos(lex), "expected '{' for function body");
                }
                push(&mut functions, FunctionDecl {
                    vis: vis,
                    module: "",
                    file: "",
                    pos: fn_pos,
                    name: name,
                    type_params: generic_param_list_new(),
                    is_test: pending_test,
                    params: params,
                    has_return: has_return,
                    ret: ret,
                    body: body,
                })
                pending_test = false
            } else {
                if pending_test {
                    add_error(errors, lexer_pos(lex), "test attribute only valid on function");
                    pending_test = false
                }
                if pending_repr != "" {
                    add_error(errors, lexer_pos(lex), "repr only valid on enum");
                    pending_repr = ""
                }
                add_error(errors, lexer_pos(lex), "expected top-level declaration");
                lexer_next(lex)
            }
        }
    }
    return Program { imports: imports, structs: structs, enums: enums, consts: consts, functions: functions, impls: impls }
}
