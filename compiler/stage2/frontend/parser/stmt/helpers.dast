fn parse_expr_before_block(p: &mut Parser) -> Expr {
    let prev = p.no_struct_lit
    p.no_struct_lit = true
    let e = parse_expr(p)
    p.no_struct_lit = prev
    return e
}

fn parse_match_arm_body(p: &mut Parser) -> Block {
    if parser_peek(p).kind == TK_LBRACE {
        return parse_block(p)
    }
    let e = parse_expr(p)
    let mut stmts = stmt_list_empty()
    push(&mut stmts, stmt_expr(e))
    return Block { stmts: stmts }
}

fn parse_binding_list(p: &mut Parser, end_kind: i32) -> [String] {
    let mut names: [String] = []
    if parser_peek(p).kind == end_kind { return names }
    let mut done = false
    while !done {
        let name = parser_expect(p, TK_IDENT, "ident").text
        push(&mut names, name)
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
            if parser_peek(p).kind == end_kind { done = true }
        } else {
            done = true
        }
    }
    return names
}

fn desugar_pattern_lets(names: & [String], base_expr: &Expr, mutable: bool) -> [Stmt] {
    let mut out: [Stmt] = []
    let mut i = 0
    while i < len(names) {
        let name = string_clone(&(*names)[i])
        if name != "_" {
            let idx = expr_int(i)
            let idx_expr = expr_index(expr_clone(base_expr), idx)
            push(&mut out, stmt_let(name, mutable, false, "", idx_expr))
        }
        i = i + 1
    }
    return out
}

fn rewrite_break_values_block(b: &Block, target: &str) -> Block {
    let mut out: [Stmt] = []
    let mut i = 0
    while i < len(&b.stmts) {
        let mut items = rewrite_break_values_stmt(&b.stmts[i], target)
        let mut j = 0
        while j < len(&items) {
            push(&mut out, items[j])
            j = j + 1
        }
        i = i + 1
    }
    return Block { stmts: out }
}

fn rewrite_break_values_stmt(s: &Stmt, target: &str) -> [Stmt] {
    let mut out: [Stmt] = []
    if s.kind == STMT_BREAK_VALUE {
        push(&mut out, stmt_assign(string_clone(target), expr_clone(&s.expr)))
        push(&mut out, stmt_break())
        return out
    }
    if s.kind == STMT_IF {
        let tb = rewrite_break_values_block(&s.block, target)
        let mut eb = block_empty()
        if s.has_else { eb = rewrite_break_values_block(&s.else_block, target) }
        push(&mut out, stmt_if(expr_clone(&s.expr), tb, eb, s.has_else))
        return out
    }
    if s.kind == STMT_IFLET {
        let tb = rewrite_break_values_block(&s.block, target)
        let mut eb = block_empty()
        if s.has_else { eb = rewrite_break_values_block(&s.else_block, target) }
        push(&mut out, stmt_iflet(expr_clone(&s.expr), string_clone(&s.pat_variant), string_clone(&s.pat_binding), s.pat_has_binding, tb, eb, s.has_else))
        return out
    }
    if s.kind == STMT_MATCH {
        let mut arms = match_arm_list_empty()
        let mut ai = 0
        while ai < len(&s.arms) {
            let mut a = match_arm_clone(&s.arms[ai])
            a.block = rewrite_break_values_block(&a.block, target)
            push(&mut arms, a)
            ai = ai + 1
        }
        push(&mut out, stmt_match(expr_clone(&s.expr), arms))
        return out
    }
    if s.kind == STMT_WHILE {
        let tb = rewrite_break_values_block(&s.block, target)
        push(&mut out, stmt_while(expr_clone(&s.expr), tb))
        return out
    }
    if s.kind == STMT_LOOP {
        let tb = rewrite_break_values_block(&s.block, target)
        push(&mut out, stmt_loop(tb))
        return out
    }
    if s.kind == STMT_EXPR && s.expr.kind == EXPR_BLOCK {
        let nb = rewrite_break_values_block(&s.expr.block, target)
        push(&mut out, stmt_expr(expr_block(nb)))
        return out
    }
    push(&mut out, stmt_clone(s))
    return out
}

fn desugar_let_pattern(p: &mut Parser, names: & [String], rhs: Expr, mutable: bool) -> Stmt {
    let tmp = parser_gensym(p, "__pat")
    let mut stmts: [Stmt] = []
    push(&mut stmts, stmt_let(string_clone(&tmp), false, false, "", rhs))
    let base = expr_ident(string_clone(&tmp))
    let mut binds = desugar_pattern_lets(&names, &base, mutable)
    let mut i = 0
    while i < len(&binds) {
        push(&mut stmts, binds[i])
        i = i + 1
    }
    return stmt_expr(expr_block(Block { stmts: stmts }))
}

fn pattern_irrefutable(pat: &Pattern) -> bool {
    if pat.kind == PAT_WILDCARD || pat.kind == PAT_BIND { return true }
    if pat.kind == PAT_STRUCT {
        let mut i = 0
        while i < len(&pat.struct_fields) {
            if !pattern_irrefutable(&pat.struct_fields[i].pattern) { return false }
            i = i + 1
        }
        return true
    }
    return false
}

fn desugar_struct_pattern_bindings(out: &mut [Stmt], base: &Expr, pat: &Pattern, mutable: bool) {
    if pat.kind == PAT_BIND {
        if pat.name != "_" {
            push(out, stmt_let(string_clone(&pat.name), mutable, false, "", expr_clone(base)))
        }
        return
    }
    if pat.kind == PAT_WILDCARD { return }
    if pat.kind != PAT_STRUCT { return }
    let mut i = 0
    while i < len(&pat.struct_fields) {
        let f = &pat.struct_fields[i]
        let field_expr = expr_field(expr_clone(base), string_clone(&f.name))
        desugar_struct_pattern_bindings(out, &field_expr, &f.pattern, mutable)
        i = i + 1
    }
}

fn desugar_struct_pattern_let(p: &mut Parser, pat: &Pattern, rhs: Expr, mutable: bool) -> Stmt {
    let tmp = parser_gensym(p, "__pat")
    let mut stmts: [Stmt] = []
    push(&mut stmts, stmt_let(string_clone(&tmp), false, false, "", rhs))
    let base = expr_ident(string_clone(&tmp))
    if !pattern_irrefutable(pat) {
        println("stage2: let struct pattern must be irrefutable")
        exit(1)
    }
    desugar_struct_pattern_bindings(&mut stmts, &base, pat, mutable)
    return stmt_expr(expr_block(Block { stmts: stmts }))
}

fn desugar_loop_expr(p: &mut Parser, name: String, mutable: bool, has_type: bool, typ: String, body: Block) -> Stmt {
    let res = parser_gensym(p, "__loop_res")
    let mut stmts: [Stmt] = []
    push(&mut stmts, stmt_let(string_clone(&res), true, has_type, string_clone(&typ), expr_int(0)))
    let rb = rewrite_break_values_block(&body, &res)
    push(&mut stmts, stmt_loop(rb))
    push(&mut stmts, stmt_expr(expr_ident(res)))
    return stmt_let(name, mutable, has_type, typ, expr_block(Block { stmts: stmts }))
}

fn desugar_while_let(p: &mut Parser, scrut: Expr, pat: Pattern, body: Block, binding: String, has_binding: bool) -> Stmt {
    let mut else_stmts: [Stmt] = []
    push(&mut else_stmts, stmt_break())
    let else_block = Block { stmts: else_stmts }
    let iflet = stmt_iflet(scrut, string_clone(&pat.variant), binding, has_binding, body, else_block, true)
    let mut loop_stmts: [Stmt] = []
    push(&mut loop_stmts, iflet)
    return stmt_loop(Block { stmts: loop_stmts })
}

fn desugar_for_stmt(p: &mut Parser, names: & [String], iter_expr: Expr, body: Block) -> Stmt {
    let arr_name = parser_gensym(p, "__for_arr")
    let idx_name = parser_gensym(p, "__for_i")
    let elem_name = parser_gensym(p, "__for_elem")
    let mut stmts: [Stmt] = []
    push(&mut stmts, stmt_let(string_clone(&arr_name), false, false, "", iter_expr))
    push(&mut stmts, stmt_let(string_clone(&idx_name), true, true, "i64", expr_int(0)))
    let arr_ident = expr_ident(string_clone(&arr_name))
    let cond = expr_binary("<", expr_ident(string_clone(&idx_name)), expr_call("len", [expr_ref(arr_ident)]))
    let mut body_stmts: [Stmt] = []
    let elem_expr = expr_index(expr_ident(string_clone(&arr_name)), expr_ident(string_clone(&idx_name)))
    if len(names) <= 1 {
        if len(names) == 1 && (*names)[0] != "_" {
            push(&mut body_stmts, stmt_let(string_clone(&(*names)[0]), false, false, "", elem_expr))
        }
    } else {
        push(&mut body_stmts, stmt_let(string_clone(&elem_name), false, false, "", elem_expr))
        let base = expr_ident(string_clone(&elem_name))
        let mut binds = desugar_pattern_lets(&names, &base, false)
        let mut bi = 0
        while bi < len(&binds) {
            push(&mut body_stmts, binds[bi])
            bi = bi + 1
        }
    }
    let inc = expr_binary("+", expr_ident(string_clone(&idx_name)), expr_int(1))
    push(&mut body_stmts, stmt_assign(string_clone(&idx_name), inc))
    let mut i = 0
    while i < len(&body.stmts) {
        push(&mut body_stmts, body.stmts[i])
        i = i + 1
    }
    let while_stmt = stmt_while(cond, Block { stmts: body_stmts })
    push(&mut stmts, while_stmt)
    return stmt_expr(expr_block(Block { stmts: stmts }))
}
