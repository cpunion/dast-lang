// Statement parsing for stage2.

fn parse_variant_pattern(p: &mut Parser) -> MatchArm {
    let _ = parser_expect(p, TK_DOT, ".")
    let variant = parser_expect(p, TK_IDENT, "variant").text
    let mut binding = ""
    let mut has_binding = false
    if parser_peek(p).kind == TK_LPAREN {
        let _ = parser_advance(p)
        binding = parser_expect(p, TK_IDENT, "binding").text
        let _ = parser_expect(p, TK_RPAREN, ")")
        has_binding = true
    }
    return MatchArm {
        pat_kind: PAT_VARIANT,
        variant: variant,
        binding: binding,
        has_binding: has_binding,
        has_guard: false,
        guard: expr_int(0),
        int_value: 0,
        range_end: 0,
        range_inclusive: false,
        struct_name: "",
        struct_fields: struct_pattern_field_list_empty(),
        block: block_empty(),
    }
}

fn parse_struct_pattern(p: &mut Parser) -> MatchArm {
    let name = parser_expect(p, TK_IDENT, "struct").text
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut fields: [StructPatternField] = []
    if parser_peek(p).kind != TK_RBRACE {
        let mut done = false
        while !done {
            let fname = parser_expect(p, TK_IDENT, "field").text
            let mut binding = string_clone(&fname)
            let mut has_binding = true
            let mut has_pattern = false
            let mut pat_kind = PAT_WILDCARD
            let mut int_value = 0
            let mut range_end = 0
            let mut range_inclusive = false
            if parser_peek(p).kind == TK_COLON {
                let _ = parser_advance(p)
                if parser_peek(p).kind == TK_IDENT {
                    let name = parser_advance(p).text
                    if name == "_" {
                        has_binding = false
                        has_pattern = true
                        pat_kind = PAT_WILDCARD
                    } else {
                        binding = name
                        has_binding = true
                    }
                } else if parser_peek(p).kind == TK_INT {
                    let v = parser_advance(p).int_value
                    if parser_peek(p).kind == TK_DOT && parser_peek_next(p).kind == TK_DOT {
                        let _ = parser_advance(p)
                        let _ = parser_advance(p)
                        if parser_peek(p).kind == TK_ASSIGN {
                            let _ = parser_advance(p)
                            range_inclusive = true
                        }
                        range_end = parser_expect(p, TK_INT, "range end").int_value
                        has_binding = false
                        has_pattern = true
                        pat_kind = PAT_RANGE
                        int_value = v
                    } else {
                        has_binding = false
                        has_pattern = true
                        pat_kind = PAT_INT
                        int_value = v
                    }
                } else {
                    println("stage2: unsupported struct pattern field")
                    exit(1)
                }
            }
            push(&mut fields, StructPatternField { name: fname, binding: binding, has_binding: has_binding, has_pattern: has_pattern, pat_kind: pat_kind, int_value: int_value, range_end: range_end, range_inclusive: range_inclusive })
            if parser_peek(p).kind == TK_COMMA {
                let _ = parser_advance(p)
            } else {
                done = true
            }
        }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return MatchArm {
        pat_kind: PAT_STRUCT,
        variant: "",
        binding: "",
        has_binding: false,
        has_guard: false,
        guard: expr_int(0),
        int_value: 0,
        range_end: 0,
        range_inclusive: false,
        struct_name: name,
        struct_fields: fields,
        block: block_empty(),
    }
}

fn binding_list_contains(items: & [String], name: &str) -> bool {
    let mut i = 0
    while i < len(items) {
        if items[i] == name { return true }
        i = i + 1
    }
    return false
}

fn pattern_binding_names(pat: &MatchArm) -> [String] {
    let mut out: [String] = []
    if pat.has_binding {
        push(&mut out, string_clone(&pat.binding))
    }
    if pat.pat_kind == PAT_STRUCT {
        let mut i = 0
        while i < len(&pat.struct_fields) {
            if pat.struct_fields[i].has_binding {
                let name = string_clone(&pat.struct_fields[i].binding)
                if !binding_list_contains(&out, &name) {
                    push(&mut out, name)
                }
            }
            i = i + 1
        }
    }
    return out
}

fn binding_list_equal(a: & [String], b: & [String]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if !binding_list_contains(b, &(*a)[i]) { return false }
        i = i + 1
    }
    return true
}

fn pattern_has_binding(pat: &MatchArm) -> bool {
    if pat.has_binding { return true }
    if pat.pat_kind == PAT_STRUCT {
        let mut i = 0
        while i < len(&pat.struct_fields) {
            if pat.struct_fields[i].has_binding { return true }
            i = i + 1
        }
    }
    return false
}

fn parse_match_pattern_single(p: &mut Parser) -> MatchArm {
    let t = parser_peek(p)
    let mut arm = MatchArm {
        pat_kind: PAT_WILDCARD,
        variant: "",
        binding: "",
        has_binding: false,
        has_guard: false,
        guard: expr_int(0),
        int_value: 0,
        range_end: 0,
        range_inclusive: false,
        struct_name: "",
        struct_fields: struct_pattern_field_list_empty(),
        block: block_empty(),
    }
    if t.kind == TK_DOT {
        arm = parse_variant_pattern(p)
    } else if t.kind == TK_IDENT && parser_peek_next(p).kind == TK_LBRACE {
        arm = parse_struct_pattern(p)
    } else if t.kind == TK_INT {
        let v = parser_advance(p).int_value
        if parser_peek(p).kind == TK_DOT && parser_peek_next(p).kind == TK_DOT {
            let _ = parser_advance(p)
            let _ = parser_advance(p)
            let mut inclusive = false
            if parser_peek(p).kind == TK_ASSIGN {
                let _ = parser_advance(p)
                inclusive = true
            }
            let end = parser_expect(p, TK_INT, "range end").int_value
            arm = MatchArm {
                pat_kind: PAT_RANGE,
                variant: "",
                binding: "",
                has_binding: false,
                has_guard: false,
                guard: expr_int(0),
                int_value: v,
                range_end: end,
                range_inclusive: inclusive,
                struct_name: "",
                struct_fields: struct_pattern_field_list_empty(),
                block: block_empty(),
            }
            return arm
        }
        arm = MatchArm {
            pat_kind: PAT_INT,
            variant: "",
            binding: "",
            has_binding: false,
            has_guard: false,
            guard: expr_int(0),
            int_value: v,
            range_end: 0,
            range_inclusive: false,
            struct_name: "",
            struct_fields: struct_pattern_field_list_empty(),
            block: block_empty(),
        }
    } else if t.kind == TK_IDENT && t.text == "_" {
        let _ = parser_advance(p)
        arm = MatchArm {
            pat_kind: PAT_WILDCARD,
            variant: "",
            binding: "",
            has_binding: false,
            has_guard: false,
            guard: expr_int(0),
            int_value: 0,
            range_end: 0,
            range_inclusive: false,
            struct_name: "",
            struct_fields: struct_pattern_field_list_empty(),
            block: block_empty(),
        }
    } else {
        println("parse error: expected pattern got", t.kind, t.text)
        exit(1)
    }
    return arm
}

fn parse_match_pattern_list(p: &mut Parser) -> [MatchArm] {
    let mut out: [MatchArm] = []
    let first = parse_match_pattern_single(p)
    let first_bindings = pattern_binding_names(&first)
    push(&mut out, first)
    while parser_peek(p).kind == TK_PIPE {
        let _ = parser_advance(p)
        let next = parse_match_pattern_single(p)
        let next_bindings = pattern_binding_names(&next)
        if !binding_list_equal(&first_bindings, &next_bindings) {
            println("stage2: or-patterns must bind same names")
            exit(1)
        }
        push(&mut out, next)
    }
    return out
}
