// Statement parsing for stage2.

fn pattern_empty() -> Pattern {
    return Pattern {
        kind: PAT_WILDCARD,
        name: "",
        int_value: 0,
        range_inclusive: false,
        range_has_start: false,
        range_has_end: false,
        range_start: expr_int(0),
        range_end: expr_int(0),
        variant: "",
        has_payload: false,
        payload: pattern_list_empty(),
        struct_name: "",
        struct_fields: struct_pattern_field_list_empty(),
    }
}

fn pattern_wildcard() -> Pattern {
    let mut p = pattern_empty()
    p.kind = PAT_WILDCARD
    return p
}

fn pattern_bind(name: String) -> Pattern {
    let mut p = pattern_empty()
    p.kind = PAT_BIND
    p.name = name
    return p
}

fn pattern_int(v: i64) -> Pattern {
    let mut p = pattern_empty()
    p.kind = PAT_INT
    p.int_value = v
    return p
}

fn pattern_range(start: Expr, has_start: bool, end: Expr, has_end: bool, inclusive: bool) -> Pattern {
    let mut p = pattern_empty()
    p.kind = PAT_RANGE
    p.range_has_start = has_start
    p.range_has_end = has_end
    p.range_start = start
    p.range_end = end
    p.range_inclusive = inclusive
    return p
}

fn pattern_variant(variant: String, payload: [Pattern]) -> Pattern {
    let mut p = pattern_empty()
    p.kind = PAT_VARIANT
    p.variant = variant
    p.payload = payload
    p.has_payload = len(&p.payload) > 0
    return p
}

fn pattern_struct(name: String, fields: [StructPatternField]) -> Pattern {
    let mut p = pattern_empty()
    p.kind = PAT_STRUCT
    p.struct_name = name
    p.struct_fields = fields
    return p
}

fn parse_variant_pattern(p: &mut Parser) -> Pattern {
    let _ = parser_expect(p, TK_DOT, ".")
    let variant = parser_expect(p, TK_IDENT, "variant").text
    let mut payload: [Pattern] = []
    if parser_peek(p).kind == TK_LPAREN {
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_RPAREN {
            // Treat empty payload as wildcard.
            push(&mut payload, pattern_wildcard())
        } else {
            let pat = parse_pattern(p)
            push(&mut payload, pat)
        }
        let _ = parser_expect(p, TK_RPAREN, ")")
    }
    return pattern_variant(variant, payload)
}

fn parse_struct_pattern(p: &mut Parser) -> Pattern {
    let name = parser_expect(p, TK_IDENT, "struct").text
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut fields: [StructPatternField] = []
    if parser_peek(p).kind != TK_RBRACE {
        let mut done = false
        while !done {
            if parser_peek(p).kind == TK_DOTDOT {
                println("stage2: unsupported '..' in struct pattern")
                exit(1)
            }
            let fname = parser_expect(p, TK_IDENT, "field").text
            let mut pat = pattern_bind(string_clone(&fname))
            if parser_peek(p).kind == TK_COLON {
                let _ = parser_advance(p)
                pat = parse_pattern(p)
            }
            push(&mut fields, StructPatternField { name: fname, pattern: pat })
            if parser_peek(p).kind == TK_COMMA {
                let _ = parser_advance(p)
            } else {
                done = true
            }
        }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return pattern_struct(name, fields)
}

fn binding_list_contains(items: & [String], name: &str) -> bool {
    let mut i = 0
    while i < len(items) {
        if items[i] == name { return true }
        i = i + 1
    }
    return false
}

fn binding_list_add_unique(items: &mut [String], name: &str) {
    if name == "" { return }
    if !binding_list_contains(items, name) {
        push(items, string_clone(name))
    }
}

fn pattern_binding_names_inner(out: &mut [String], pat: &Pattern) {
    if pat.kind == PAT_BIND {
        binding_list_add_unique(out, &pat.name)
        return
    }
    if pat.kind == PAT_STRUCT {
        let mut i = 0
        while i < len(&pat.struct_fields) {
            pattern_binding_names_inner(out, &pat.struct_fields[i].pattern)
            i = i + 1
        }
        return
    }
    if pat.kind == PAT_VARIANT && pat.has_payload && len(&pat.payload) > 0 {
        pattern_binding_names_inner(out, &pat.payload[0])
        return
    }
}

fn pattern_binding_names(pat: &Pattern) -> [String] {
    let mut out: [String] = []
    pattern_binding_names_inner(&mut out, pat)
    return out
}

fn binding_list_equal(a: & [String], b: & [String]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if !binding_list_contains(b, &(*a)[i]) { return false }
        i = i + 1
    }
    return true
}

fn pattern_range_end_terminator(kind: i32) -> bool {
    if kind == TK_COMMA { return true }
    if kind == TK_PIPE { return true }
    if kind == TK_FATARROW { return true }
    if kind == TK_RBRACE { return true }
    if kind == TK_RPAREN { return true }
    if kind == TK_IF { return true }
    if kind == TK_EOF { return true }
    return false
}

fn parse_pattern_expr(p: &mut Parser) -> Expr {
    let prev = p.no_struct_lit
    p.no_struct_lit = true
    let e = parse_expr(p)
    p.no_struct_lit = prev
    return e
}

fn pattern_from_expr(expr: &Expr) -> Pattern {
    if expr.kind == EXPR_IDENT {
        if expr.name == "_" { return pattern_wildcard() }
        return pattern_bind(string_clone(&expr.name))
    }
    if expr.kind == EXPR_INT || expr.kind == EXPR_CHAR {
        return pattern_int(expr.int_value)
    }
    if expr.kind == EXPR_BOOL {
        let v = if expr.bool_value { 1 } else { 0 }
        return pattern_int(v)
    }
    println("parse error: unsupported pattern")
    exit(1)
    return pattern_wildcard()
}

fn parse_range_pattern_with_start(p: &mut Parser, start_expr: Expr) -> Pattern {
    let _ = parser_expect(p, TK_DOTDOT, "..")
    let mut inclusive = false
    if parser_peek(p).kind == TK_ASSIGN {
        let _ = parser_advance(p)
        inclusive = true
    }
    let mut has_end = false
    let mut end_expr = expr_int(0)
    if !pattern_range_end_terminator(parser_peek(p).kind) {
        end_expr = parse_pattern_expr(p)
        has_end = true
    } else if inclusive {
        println("stage2: range pattern requires end for ..=")
        exit(1)
    }
    return pattern_range(start_expr, true, end_expr, has_end, inclusive)
}

fn parse_range_pattern_open(p: &mut Parser) -> Pattern {
    let _ = parser_expect(p, TK_DOTDOT, "..")
    let mut inclusive = false
    if parser_peek(p).kind == TK_ASSIGN {
        let _ = parser_advance(p)
        inclusive = true
    }
    if pattern_range_end_terminator(parser_peek(p).kind) {
        if inclusive {
            println("stage2: range pattern requires end for ..=")
            exit(1)
        }
        return pattern_wildcard()
    }
    let end_expr = parse_pattern_expr(p)
    return pattern_range(expr_int(0), false, end_expr, true, inclusive)
}

fn parse_pattern(p: &mut Parser) -> Pattern {
    let t = parser_peek(p)
    if t.kind == TK_DOTDOT {
        return parse_range_pattern_open(p)
    }
    if t.kind == TK_DOT {
        return parse_variant_pattern(p)
    }
    if t.kind == TK_IDENT && t.text == "_" {
        let _ = parser_advance(p)
        return pattern_wildcard()
    }
    if t.kind == TK_IDENT && parser_peek_next(p).kind == TK_LBRACE {
        return parse_struct_pattern(p)
    }
    let start_expr = parse_pattern_expr(p)
    if parser_peek(p).kind == TK_DOTDOT {
        return parse_range_pattern_with_start(p, start_expr)
    }
    return pattern_from_expr(&start_expr)
}

fn parse_match_pattern_list(p: &mut Parser) -> [Pattern] {
    let mut out: [Pattern] = []
    let first = parse_pattern(p)
    let first_bindings = pattern_binding_names(&first)
    push(&mut out, first)
    while parser_peek(p).kind == TK_PIPE {
        let _ = parser_advance(p)
        let next = parse_pattern(p)
        let next_bindings = pattern_binding_names(&next)
        if !binding_list_equal(&first_bindings, &next_bindings) {
            println("stage2: or-patterns must bind same names")
            exit(1)
        }
        push(&mut out, next)
    }
    return out
}
