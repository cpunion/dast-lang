fn parse_block(p: &mut Parser) -> Block {
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut stmts = stmt_list_empty()
    while parser_peek(p).kind != TK_RBRACE && parser_peek(p).kind != TK_EOF {
        push(&mut stmts, parse_stmt(p))
        while parser_peek(p).kind == TK_SEMI {
            let _ = parser_advance(p)
        }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return Block { stmts: stmts }
}

fn parse_stmt(p: &mut Parser) -> Stmt {
    let t = parser_peek(p)
    if t.kind == TK_IDENT && parser_peek_next(p).kind == TK_COLON {
        let _ = parser_advance(p)
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_LOOP {
            let _ = parser_advance(p)
            let body = parse_block(p)
            return stmt_loop(body)
        }
        println("parse error: label must prefix loop")
        exit(1)
    }
    if t.kind == TK_LET {
        let _ = parser_advance(p)
        let mut is_mut = false
        if parser_peek(p).kind == TK_MUT {
            let _ = parser_advance(p)
            is_mut = true
        }
        if parser_peek(p).kind == TK_LPAREN || parser_peek(p).kind == TK_LBRACKET {
            let end_kind = if parser_peek(p).kind == TK_LPAREN { TK_RPAREN } else { TK_RBRACKET }
            let _ = parser_advance(p)
            let names = parse_binding_list(p, end_kind)
            let end_label = if end_kind == TK_RPAREN { string_clone(")") } else { string_clone("]") }
            let _ = parser_expect(p, end_kind, end_label)
            let _ = parser_expect(p, TK_ASSIGN, "=")
            let e = parse_expr(p)
            return desugar_let_pattern(p, &names, e, is_mut)
        }
        if parser_peek(p).kind == TK_IDENT && parser_peek_next(p).kind == TK_LBRACE {
            let pat = parse_struct_pattern(p)
            let _ = parser_expect(p, TK_ASSIGN, "=")
            let e = parse_expr(p)
            return desugar_struct_pattern_let(p, &pat, e, is_mut)
        }
        let name = parser_expect(p, TK_IDENT, "ident").text
        let mut has_type = false
        let mut typ = string_clone("")
        if parser_peek(p).kind == TK_COLON {
            let _ = parser_advance(p)
            typ = parse_type_name(p)
            has_type = true
        }
        let _ = parser_expect(p, TK_ASSIGN, "=")
        if parser_peek(p).kind == TK_LOOP {
            let _ = parser_advance(p)
            let body = parse_block(p)
            return desugar_loop_expr(p, name, is_mut, has_type, typ, body)
        }
        let e = parse_expr(p)
        return stmt_let(name, is_mut, has_type, typ, e)
    }
    if t.kind == TK_FOR {
        let _ = parser_advance(p)
        let mut names: [String] = []
        if parser_peek(p).kind == TK_LPAREN {
            let _ = parser_advance(p)
            names = parse_binding_list(p, TK_RPAREN)
            let _ = parser_expect(p, TK_RPAREN, ")")
        } else {
            let name = parser_expect(p, TK_IDENT, "ident").text
            push(&mut names, name)
        }
        let _ = parser_expect(p, TK_IN, "in")
        let iter_expr = parse_expr_before_block(p)
        let body = parse_block(p)
        return desugar_for_stmt(p, &names, iter_expr, body)
    }
    if t.kind == TK_IF {
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_LET {
            let _ = parser_advance(p)
            let pat = parse_pattern(p)
            if pat.kind != PAT_VARIANT {
                println("stage2: if let requires variant pattern")
                exit(1)
            }
            let mut binding = string_clone("")
            let mut has_binding = false
            if pat.has_payload && len(&pat.payload) > 0 {
                let pay = &pat.payload[0]
                if pay.kind == PAT_BIND {
                    binding = string_clone(&pay.name)
                    has_binding = true
                } else if pay.kind == PAT_WILDCARD {
                    has_binding = false
                } else {
                    println("stage2: if let variant payload must be binding or _")
                    exit(1)
                }
            }
            let _ = parser_expect(p, TK_ASSIGN, "=")
            let scrut = parse_expr_before_block(p)
            let then_block = parse_block(p)
            let mut has_else = false
            let mut else_block = block_empty()
            if parser_peek(p).kind == TK_ELSE {
                let _ = parser_advance(p)
                if parser_peek(p).kind == TK_IF {
                    let else_if = parse_stmt(p)
                    let mut stmts = stmt_list_empty()
                    push(&mut stmts, else_if)
                    else_block = Block { stmts: stmts }
                } else {
                    else_block = parse_block(p)
                }
                has_else = true
            }
            return stmt_iflet(scrut, string_clone(&pat.variant), binding, has_binding, then_block, else_block, has_else)
        }
        let cond = parse_expr_before_block(p)
        let then_block = parse_block(p)
        let mut has_else = false
        let mut else_block = block_empty()
        if parser_peek(p).kind == TK_ELSE {
            let _ = parser_advance(p)
            if parser_peek(p).kind == TK_IF {
                let else_if = parse_stmt(p)
                let mut stmts = stmt_list_empty()
                push(&mut stmts, else_if)
                else_block = Block { stmts: stmts }
            } else {
                else_block = parse_block(p)
            }
            has_else = true
        }
        return stmt_if(cond, then_block, else_block, has_else)
    }
    if t.kind == TK_MATCH {
        let _ = parser_advance(p)
        let scrut = parse_expr_before_block(p)
        let _ = parser_expect(p, TK_LBRACE, "{")
        let mut arms = match_arm_list_empty()
        while parser_peek(p).kind != TK_RBRACE && parser_peek(p).kind != TK_EOF {
            let mut pats = parse_match_pattern_list(p)
            let mut guard = expr_int(0)
            let mut has_guard = false
            if parser_peek(p).kind == TK_IF {
                let _ = parser_advance(p)
                guard = parse_expr(p)
                has_guard = true
            }
            let _ = parser_expect(p, TK_FATARROW, "=>")
            let block = parse_match_arm_body(p)
            let mut pi = 0
            while pi < len(&pats) {
                let mut arm = MatchArm { pattern: pats[pi], has_guard: false, guard: expr_int(0), block: block_empty() }
                if has_guard {
                    arm.guard = expr_clone(&guard)
                    arm.has_guard = true
                }
                arm.block = block_clone(&block)
                push(&mut arms, arm)
                pi = pi + 1
            }
            if parser_peek(p).kind == TK_COMMA { let _ = parser_advance(p) }
        }
        let _ = parser_expect(p, TK_RBRACE, "}")
        return stmt_match(scrut, arms)
    }
    if t.kind == TK_WHILE {
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_LET {
            let _ = parser_advance(p)
            let pat = parse_pattern(p)
            if pat.kind != PAT_VARIANT {
                println("stage2: while let requires variant pattern")
                exit(1)
            }
            let mut binding = string_clone("")
            let mut has_binding = false
            if pat.has_payload && len(&pat.payload) > 0 {
                let pay = &pat.payload[0]
                if pay.kind == PAT_BIND {
                    binding = string_clone(&pay.name)
                    has_binding = true
                } else if pay.kind == PAT_WILDCARD {
                    has_binding = false
                } else {
                    println("stage2: while let variant payload must be binding or _")
                    exit(1)
                }
            }
            let _ = parser_expect(p, TK_ASSIGN, "=")
            let scrut = parse_expr_before_block(p)
            let body = parse_block(p)
            return desugar_while_let(p, scrut, pat, body, binding, has_binding)
        }
        let cond = parse_expr_before_block(p)
        let body = parse_block(p)
        return stmt_while(cond, body)
    }
    if t.kind == TK_LOOP {
        let _ = parser_advance(p)
        let body = parse_block(p)
        return stmt_loop(body)
    }
    if t.kind == TK_BREAK {
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_IDENT && parser_peek_next(p).kind == TK_COLON {
            let _ = parser_advance(p)
            let _ = parser_advance(p)
            return stmt_break()
        }
        let k = parser_peek(p).kind
        if k == TK_RBRACE || k == TK_EOF || k == TK_SEMI {
            return stmt_break()
        }
        let v = parse_expr(p)
        return stmt_break_value(v)
    }
    if t.kind == TK_CONTINUE {
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_IDENT {
            let _ = parser_advance(p)
            if parser_peek(p).kind == TK_COLON { let _ = parser_advance(p) }
        }
        return stmt_continue()
    }
    if t.kind == TK_RETURN {
        let _ = parser_advance(p)
        let k = parser_peek(p).kind
        if k == TK_RBRACE || k == TK_EOF {
            return stmt_return_unit()
        }
        let v = parse_expr(p)
        return stmt_return(v)
    }
    let lhs = parse_expr(p)
    if parser_peek(p).kind == TK_ASSIGN {
        let _ = parser_advance(p)
        let rhs = parse_expr(p)
        return stmt_assign_expr(lhs, rhs)
    }
    return stmt_expr(lhs)
}
