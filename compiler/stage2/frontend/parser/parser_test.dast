fn test_parse_where_fn_bounds() {
    let src = "fn f[T: Clone](x: T) where T: Display + Iter[i32] { } fn main() { }"
    let prog = parse_program_or_exit(src)
    if len(&prog.functions) == 0 {
        println("missing functions")
        exit(1)
    }
    let mut fi = 0
    let mut found = false
    let mut f = function_clone(&prog.functions[0])
    while fi < len(&prog.functions) {
        if prog.functions[fi].name == "f" {
            f = function_clone(&prog.functions[fi])
            found = true
        }
        fi = fi + 1
    }
    if !found {
        println("missing function f")
        exit(1)
    }
    assert_i64_eq(len(&f.type_params), 1)
    let tp = f.type_params[0]
    assert_i64_eq(len(&tp.bounds), 3)
    assert_str_eq(tp.bounds[0], "Clone")
    assert_str_eq(tp.bounds[1], "Display")
    assert_str_eq(tp.bounds[2], "Iter[i32]")
}

fn test_parse_where_struct_bounds() {
    let src = "struct Box[T] where T: Clone { v: T } fn main() { }"
    let prog = parse_program_or_exit(src)
    if len(&prog.structs) == 0 {
        println("missing struct")
        exit(1)
    }
    let s = struct_decl_clone(&prog.structs[0])
    assert_i64_eq(len(&s.type_params), 1)
    let tp = s.type_params[0]
    assert_i64_eq(len(&tp.bounds), 1)
    assert_str_eq(tp.bounds[0], "Clone")
}

fn test_parse_where_unknown_param_error() {
    let src = "fn f[T](x: T) where U: Clone { } fn main() { }"
    let res = parse_program(src)
    if !string_list_contains(&res.errors, "stage2: unknown type param in where clause") {
        println("expected unknown param error")
        exit(1)
    }
}

fn test_parse_where_non_nominal_bound_error() {
    let src = "fn f[T](x: T) where T: &str { } fn main() { }"
    let res = parse_program(src)
    if !string_list_contains(&res.errors, "stage2: trait bound must be nominal type") {
        println("expected non-nominal bound error")
        exit(1)
    }
}

fn test_parse_array_pattern() {
    let src = "fn main() { let xs = [1, 2]; match xs { [a, b] => { } _ => { } } }"
    let prog = parse_program_or_exit(src)
    if len(&prog.functions) == 0 {
        println("missing function")
        exit(1)
    }
    let f = function_clone(&prog.functions[0])
    let mut mi = 0
    let mut found = false
    while mi < len(&f.body.stmts) {
        let s = f.body.stmts[mi]
        if s.kind == STMT_MATCH {
            found = true
            if len(&s.arms) == 0 {
                println("missing match arms")
                exit(1)
            }
            let arm0 = s.arms[0]
            if arm0.pattern.kind != PAT_ARRAY {
                println("expected array pattern")
                exit(1)
            }
            assert_i64_eq(len(&arm0.pattern.payload), 2)
            if arm0.pattern.payload[0].kind != PAT_BIND || arm0.pattern.payload[1].kind != PAT_BIND {
                println("expected bind patterns in array")
                exit(1)
            }
        }
        mi = mi + 1
    }
    if !found {
        println("missing match statement")
        exit(1)
    }
}

fn test_parse_struct_rest_pattern() {
    let src = "struct Point { x: i64, y: i64 } fn main() { let p = Point { x: 1, y: 2 }; match p { Point { x, .. } => { } _ => { } } }"
    let _ = parse_program_or_exit(src)
}

fn test_parse_expr_error() {
    let res = parse_expr_string("1 +")
    if len(&res.errors) == 0 {
        println("expected parse error")
        exit(1)
    }
}

fn test_parse_reserved_int_width_error() {
    let src = "fn main() { let x: i128 = 1 }"
    let res = parse_program(src)
    if !string_list_contains(&res.errors, "parse error: i128/u128 are reserved but not supported") {
        println("expected reserved int width error")
        exit(1)
    }
}

fn test_parse_double_ref_error() {
    let src = "fn main() { let x: &&i32 = 0 }"
    let res = parse_program(src)
    if len(&res.errors) == 0 {
        println("expected parse error for double ref")
        exit(1)
    }
}
