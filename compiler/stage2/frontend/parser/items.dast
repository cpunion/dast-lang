// Item and program parsing for stage2.

fn parse_const(p: &mut Parser) -> ConstDecl {
    let _ = parser_expect(p, TK_CONST, "const")
    let name = parser_expect(p, TK_IDENT, "ident").text
    let mut has_type = false
    let mut typ = string_clone("i64")
    if parser_peek(p).kind == TK_COLON {
        let _ = parser_advance(p)
        typ = parse_type_name(p)
        has_type = true
    }
    let _ = parser_expect(p, TK_ASSIGN, "=")
    let expr = parse_const_expr(p)
    return ConstDecl { name: name, has_type: has_type, typ: typ, expr: expr }
}

fn parse_struct_fields(p: &mut Parser) -> [StructField] {
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut fields: [StructField] = []
    if parser_peek(p).kind == TK_RBRACE {
        let _ = parser_advance(p)
        return fields
    }
    let mut done = false
    while !done {
        let fname = parser_expect(p, TK_IDENT, "field").text
        let _ = parser_expect(p, TK_COLON, ":")
        let ftyp = parse_type_name(p)
        push(&mut fields, StructField { name: fname, typ: ftyp })
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
            if parser_peek(p).kind == TK_RBRACE {
                done = true
            }
        } else {
            done = true
        }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return fields
}

fn parse_struct(p: &mut Parser) -> StructDecl {
    let _ = parser_expect(p, TK_STRUCT, "struct")
    let name = parser_expect(p, TK_IDENT, "struct name").text
    let mut type_params = parse_generic_params(p)
    parse_where_clause(p, &mut type_params)
    let fields = parse_struct_fields(p)
    return StructDecl { name: name, type_params: type_params, fields: fields }
}

fn parse_enum_variants(p: &mut Parser) -> [EnumVariant] {
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut variants: [EnumVariant] = []
    if parser_peek(p).kind == TK_RBRACE {
        let _ = parser_advance(p)
        return variants
    }
    let mut done = false
    while !done {
        let vname = parser_expect(p, TK_IDENT, "variant").text
        let mut has_payload = false
        let mut payload_type = string_clone("")
        if parser_peek(p).kind == TK_LPAREN {
            let _ = parser_advance(p)
            payload_type = parse_type_name(p)
            let _ = parser_expect(p, TK_RPAREN, ")")
            has_payload = true
        }
        push(&mut variants, EnumVariant { name: vname, has_payload: has_payload, payload_type: payload_type })
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
            if parser_peek(p).kind == TK_RBRACE {
                done = true
            }
        } else {
            done = true
        }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return variants
}

fn parse_enum(p: &mut Parser) -> EnumDecl {
    let _ = parser_expect(p, TK_ENUM, "enum")
    let name = parser_expect(p, TK_IDENT, "enum name").text
    let mut type_params = parse_generic_params(p)
    let mut tag_type = string_clone("i32")
    if parser_peek(p).kind == TK_TAG {
        let _ = parser_advance(p)
        tag_type = parse_type_name(p)
    }
    parse_where_clause(p, &mut type_params)
    let variants = parse_enum_variants(p)
    return EnumDecl { name: name, type_params: type_params, tag_type: tag_type, variants: variants }
}

fn parse_type_alias(p: &mut Parser) -> TypeAlias {
    let _ = parser_expect(p, TK_TYPE, "type")
    let name = parser_expect(p, TK_IDENT, "type name").text
    let _ = parser_expect(p, TK_ASSIGN, "=")
    let target = parse_type_name(p)
    return TypeAlias { name: name, target: target }
}

fn parse_generic_params(p: &mut Parser) -> [GenericParam] {
    let mut params: [GenericParam] = []
    if parser_peek(p).kind != TK_LBRACKET { return params }
    let _ = parser_advance(p)
    if parser_peek(p).kind == TK_RBRACKET {
        let _ = parser_advance(p)
        return params
    }
    let mut done = false
    while !done {
        let name = parser_expect(p, TK_IDENT, "type param").text
        let mut bounds: [String] = []
        if parser_peek(p).kind == TK_COLON {
            let _ = parser_advance(p)
            bounds = parse_bound_list(p)
        }
        push(&mut params, GenericParam { name: name, bounds: bounds })
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
    let _ = parser_expect(p, TK_RBRACKET, "]")
    return params
}

fn string_list_contains(items: & [String], name: &str) -> bool {
    let mut i = 0
    while i < len(items) {
        if (*items)[i] == name { return true }
        i = i + 1
    }
    return false
}

fn generic_param_index(params: & [GenericParam], name: &str) -> i64 {
    let mut i = 0
    while i < len(params) {
        if (*params)[i].name == name { return i }
        i = i + 1
    }
    return -1
}

fn generic_param_add_bound(params: &mut [GenericParam], idx: i64, bound: &str) {
    if idx < 0 { return }
    let mut p = (*params)[idx]
    if !string_list_contains(&p.bounds, bound) {
        push(&mut p.bounds, string_clone(bound))
    }
    (*params)[idx] = p
}

fn parse_trait_bound(p: &mut Parser) -> String {
    let t = parse_type_name(p)
    if str_len(&t) == 0 {
        parser_fail(p, "stage2: expected trait bound")
    }
    if str_has_prefix_lit(&t, "&") || str_has_prefix_lit(&t, "[") {
        parser_fail(p, "stage2: trait bound must be nominal type")
    }
    return t
}

fn parse_bound_list(p: &mut Parser) -> [String] {
    let mut out: [String] = []
    push(&mut out, parse_trait_bound(p))
    while parser_peek(p).kind == TK_PLUS {
        let _ = parser_advance(p)
        push(&mut out, parse_trait_bound(p))
    }
    return out
}

fn parse_where_clause(p: &mut Parser, params: &mut [GenericParam]) {
    if parser_peek(p).kind != TK_WHERE { return }
    let _ = parser_advance(p)
    let mut done = false
    while !done {
        let name = parser_expect(p, TK_IDENT, "type param").text
        let idx = generic_param_index(params, &name)
        if idx < 0 {
            parser_fail(p, "stage2: unknown type param in where clause")
            // skip bounds to keep progress
            let _ = parser_expect(p, TK_COLON, ":")
            let _ = parse_bound_list(p)
            if parser_peek(p).kind == TK_COMMA { let _ = parser_advance(p) }
            continue
        }
        let _ = parser_expect(p, TK_COLON, ":")
        let bounds = parse_bound_list(p)
        let mut bi = 0
        while bi < len(&bounds) {
            generic_param_add_bound(params, idx, &bounds[bi])
            bi = bi + 1
        }
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
}

fn parse_type_suffix(p: &mut Parser, base: String) -> String {
    let mut out = base
    if parser_peek(p).kind == TK_LBRACKET {
        let _ = parser_advance(p)
        let mut args: [String] = []
        if parser_peek(p).kind != TK_RBRACKET {
            let mut done = false
            while !done {
                push(&mut args, parse_type_name(p))
                if parser_peek(p).kind == TK_COMMA {
                    let _ = parser_advance(p)
                } else {
                    done = true
                }
            }
        }
        let _ = parser_expect(p, TK_RBRACKET, "]")
        let mut s = out + "["
        let mut i = 0
        while i < len(&args) {
            if i > 0 { s = s + "," }
            s = s + args[i]
            i = i + 1
        }
        s = s + "]"
        out = s
    }
    return out
}

fn parse_type_name(p: &mut Parser) -> String {
    let mut is_ref = false
    let mut is_mut = false
    if parser_peek(p).kind == TK_AMP {
        let _ = parser_advance(p)
        is_ref = true
        if parser_peek(p).kind == TK_MUT {
            let _ = parser_advance(p)
            is_mut = true
        }
    }
    let mut base = string_clone("")
    if parser_peek(p).kind == TK_LBRACKET {
        let _ = parser_advance(p)
        let elem = parse_type_name(p)
        let _ = parser_expect(p, TK_RBRACKET, "]")
        base = "[" + elem + "]"
    } else {
        base = parser_expect(p, TK_IDENT, "type").text
        base = parse_type_suffix(p, base)
    }
    if base == "string" {
        parser_fail(p, "parse error: use String/str instead of string")
    }
    if is_ref {
        if is_mut { return string_clone("&mut ") + base }
        return string_clone("&") + base
    }
    return base
}

fn parse_params(p: &mut Parser) -> [Param] {
    let mut params: [Param] = []
    if parser_peek(p).kind == TK_RPAREN { return params }
    let mut done = false
    while !done {
        let name = parser_expect(p, TK_IDENT, "param").text
        let mut typ = string_clone("i64")
        let mut has_type = false
        if parser_peek(p).kind == TK_COLON {
            let _ = parser_advance(p)
            typ = parse_type_name(p)
            has_type = true
        }
        push(&mut params, Param { name: name, typ: typ, has_type: has_type })
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
    return params
}

fn parse_fn(p: &mut Parser) -> Function {
    let _ = parser_expect(p, TK_FN, "fn")
    let name = parser_expect(p, TK_IDENT, "main").text
    let mut type_params = parse_generic_params(p)
    let _ = parser_expect(p, TK_LPAREN, "(")
    let params = parse_params(p)
    let _ = parser_expect(p, TK_RPAREN, ")")
    let mut ret_type = string_clone("")
    if parser_peek(p).kind == TK_ARROW {
        let _ = parser_advance(p)
        ret_type = parse_type_name(p)
    }
    parse_where_clause(p, &mut type_params)
    let body_block = parse_block(p)
    return Function { name: name, type_params: type_params, params: params, ret_type: ret_type, body: body_block, is_macro: false }
}

fn parse_macro_fn(p: &mut Parser) -> Function {
    let _ = parser_expect(p, TK_MACRO, "macro")
    let mut f = parse_fn(p)
    f.is_macro = true
    return f
}

fn parse_trait(p: &mut Parser) -> TraitDecl {
    let _ = parser_expect(p, TK_TRAIT, "trait")
    let name = parser_expect(p, TK_IDENT, "trait name").text
    let mut type_params = parse_generic_params(p)
    parse_where_clause(p, &mut type_params)
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut methods: [TraitMethod] = []
    while parser_peek(p).kind != TK_RBRACE && parser_peek(p).kind != TK_EOF {
        if parser_peek(p).kind != TK_FN {
            parser_fail(p, "stage2: trait body expects method")
            let _ = parser_advance(p)
            continue
        }
        let m = parse_trait_method(p)
        push(&mut methods, m)
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return TraitDecl { name: name, type_params: type_params, methods: methods }
}

fn parse_trait_method(p: &mut Parser) -> TraitMethod {
    let _ = parser_expect(p, TK_FN, "fn")
    let name = parser_expect(p, TK_IDENT, "trait method name").text
    let type_params = parse_generic_params(p)
    let _ = parser_expect(p, TK_LPAREN, "(")
    let params = parse_params(p)
    let _ = parser_expect(p, TK_RPAREN, ")")
    let mut ret_type = string_clone("")
    if parser_peek(p).kind == TK_ARROW {
        let _ = parser_advance(p)
        ret_type = parse_type_name(p)
    }
    let _ = parser_expect(p, TK_SEMI, ";")
    let mut out_params: [Param] = []
    let mut i = 0
    while i < len(&params) {
        let mut p0 = params[i]
        if p0.name == "self" && !p0.has_type {
            p0.typ = "Self"
            p0.has_type = true
        }
        if !p0.has_type {
            parser_fail(p, "stage2: trait method param requires type")
        }
        push(&mut out_params, p0)
        i = i + 1
    }
    return TraitMethod { name: name, type_params: type_params, params: out_params, ret_type: ret_type }
}

fn parse_impl(p: &mut Parser, funcs: &mut [Function]) -> ImplDecl {
    let _ = parser_expect(p, TK_IMPL, "impl")
    let mut type_params = parse_generic_params(p)
    let first = parser_expect(p, TK_IDENT, "impl target").text
    let mut trait_name = string_clone("")
    let mut for_type = string_clone("")
    let target = parse_type_suffix(p, first)
    if parser_peek(p).kind == TK_FOR {
        let _ = parser_advance(p)
        trait_name = target
        for_type = parse_type_name(p)
    } else {
        for_type = target
    }
    parse_where_clause(p, &mut type_params)
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut methods: [TraitMethod] = []
    while parser_peek(p).kind != TK_RBRACE && parser_peek(p).kind != TK_EOF {
        let mut m = parse_fn(p)
        let method_type_params = generic_param_list_clone(&m.type_params)
        let mut pi = 0
        while pi < len(&m.params) {
            let name = m.params[pi].name
            let mut pt = m.params[pi].typ
            let mut has_type = m.params[pi].has_type
            if name == "self" && !has_type {
                pt = "Self"
                has_type = true
            }
            if pt == "Self" { pt = string_clone(&for_type) }
            if pt == "&Self" { pt = "&" + string_clone(&for_type) }
            if pt == "&mut Self" { pt = "&mut " + string_clone(&for_type) }
            m.params[pi] = Param { name: name, typ: pt, has_type: has_type }
            pi = pi + 1
        }
        if m.ret_type == "Self" { m.ret_type = string_clone(&for_type) }
        let tm = TraitMethod { name: string_clone(&m.name), type_params: method_type_params, params: param_list_clone(&m.params), ret_type: string_clone(&m.ret_type) }
        push(&mut methods, tm)
        if len(&type_params) > 0 {
            let mut combined = generic_param_list_clone(&type_params)
            let mut ti = 0
            while ti < len(&m.type_params) {
                push(&mut combined, generic_param_clone(&m.type_params[ti]))
                ti = ti + 1
            }
            m.type_params = combined
        }
        push(funcs, m)
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return ImplDecl { trait_name: trait_name, for_type: for_type, type_params: type_params, methods: methods }
}

fn parse_import(p: &mut Parser) -> ImportDecl {
    let _ = parser_expect(p, TK_IDENT, "import")
    let path = parser_expect(p, TK_STRING, "import path").text
    let mut alias = string_clone("")
    if parser_peek(p).kind == TK_IDENT && parser_peek(p).text == "as" {
        let _ = parser_advance(p)
        alias = parser_expect(p, TK_IDENT, "import alias").text
    }
    if parser_peek(p).kind == TK_SEMI { let _ = parser_advance(p) }
    return ImportDecl { path: path, alias: alias }
}

struct ParseResult {
    program: Program,
    errors: [String],
}

fn parse_program_internal(p: &mut Parser, require_main: bool) -> Program {
    let mut imports: [ImportDecl] = []
    let mut structs: [StructDecl] = []
    let mut enums: [EnumDecl] = []
    let mut type_aliases: [TypeAlias] = []
    let mut consts: [ConstDecl] = []
    let mut funcs: [Function] = []
    let mut compile_items: [CompileItem] = []
    let mut traits: [TraitDecl] = []
    let mut impls: [ImplDecl] = []
    let mut has_main = false
    let mut done = false
    while !done {
        let k = parser_peek(p).kind
        if k == TK_EOF {
            done = true
        } else if k == TK_STRUCT {
            push(&mut structs, parse_struct(p))
        } else if k == TK_ENUM {
            push(&mut enums, parse_enum(p))
        } else if k == TK_TYPE {
            push(&mut type_aliases, parse_type_alias(p))
        } else if k == TK_CONST {
            push(&mut consts, parse_const(p))
        } else if k == TK_MACRO {
            let f = parse_macro_fn(p)
            push(&mut funcs, f)
        } else if k == TK_TRAIT {
            push(&mut traits, parse_trait(p))
        } else if k == TK_IMPL {
            let imp = parse_impl(p, &mut funcs)
            push(&mut impls, imp)
        } else if k == TK_IDENT && parser_peek(p).text == "import" {
            push(&mut imports, parse_import(p))
        } else if k == TK_FN {
            let f = parse_fn(p)
            if !f.is_macro && string_clone(&f.name) == "main" { has_main = true }
            push(&mut funcs, f)
        } else if k == TK_IDENT && parser_peek(p).text == "compile" && parser_peek_next(p).kind == TK_BANG {
            let expr = parse_expr(p)
            push(&mut compile_items, CompileItem { expr: expr })
            if parser_peek(p).kind == TK_SEMI { let _ = parser_advance(p) }
        } else {
            let mut msg = string_clone("parse error: unexpected token in program ")
            msg = msg + parser_int_to_string(k)
            if parser_peek(p).text != "" { msg = msg + " " + parser_peek(p).text }
            parser_fail(p, msg)
            let _ = parser_advance(p)
        }
    }
    if require_main && !has_main {
        parser_fail(p, "parse error: missing fn main")
    }
    return Program { imports: imports, structs: structs, enums: enums, type_aliases: type_aliases, consts: consts, functions: funcs, compile_items: compile_items, traits: traits, impls: impls }
}

fn parse_program_with_errors(src: &str) -> ParseResult {
    let toks = lexer_all(src)
    let mut p = parser_new(toks)
    p.soft_errors = true
    let prog = parse_program_internal(&mut p, true)
    return ParseResult { program: prog, errors: ast_string_list_clone(&p.errors) }
}

fn parse_program(src: &str) -> Program {
    let toks = lexer_all(src)
    let mut p = parser_new(toks)
    let prog = parse_program_internal(&mut p, true)
    if p.had_error {
        let mut i = 0
        while i < len(&p.errors) {
            println(p.errors[i])
            i = i + 1
        }
        exit(1)
    }
    return prog
}

// Parse a program without requiring fn main (used by macro expansion).
fn parse_program_loose(src: &str) -> Program {
    let toks = lexer_all(src)
    let mut p = parser_new(toks)
    let prog = parse_program_internal(&mut p, false)
    if p.had_error {
        let mut i = 0
        while i < len(&p.errors) {
            println(p.errors[i])
            i = i + 1
        }
        exit(1)
    }
    return prog
}
