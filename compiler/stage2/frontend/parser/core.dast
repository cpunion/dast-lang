// Parser core utilities for stage2.

struct Parser {
    tokens: [Token],
    idx: i64,
    n: i64,
    no_struct_lit: bool,
    gensym: i64,
    soft_errors: bool,
    had_error: bool,
    errors: [String],
}

fn token_clone(t: Token) -> Token {
    return Token { kind: t.kind, text: string_clone(&t.text), name: string_clone(&t.name), int_value: t.int_value, bool_value: t.bool_value }
}

fn parser_new(tokens: [Token]) -> Parser {
    let n = len(&tokens)
    let mut errs: [String] = []
    return Parser { tokens: tokens, idx: 0, n: n, no_struct_lit: false, gensym: 0, soft_errors: false, had_error: false, errors: errs }
}

fn parser_peek(p: &Parser) -> Token {
    if p.idx >= p.n { return Token { kind: TK_EOF, text: "", name: "", int_value: 0, bool_value: false } }
    return p.tokens[p.idx]
}

fn parser_peek_next(p: &Parser) -> Token {
    let next = p.idx + 1
    if next >= p.n { return Token { kind: TK_EOF, text: "", name: "", int_value: 0, bool_value: false } }
    return p.tokens[next]
}

fn parser_advance(p: &mut Parser) -> Token {
    let t = parser_peek(p)
    if p.idx < p.n { p.idx = p.idx + 1 }
    return t
}

fn parser_expect(p: &mut Parser, kind: i32, label: String) -> Token {
    let t = parser_advance(p)
    if t.kind != kind {
        let mut msg = string_clone("parse error: expected ")
        msg = msg + label + " got "
        msg = msg + parser_int_to_string_i32(t.kind)
        if t.text != "" { msg = msg + " " + t.text }
        parser_fail(p, msg)
    }
    return t
}

fn parser_fail(p: &mut Parser, msg: String) {
    if p.soft_errors {
        let mut errs = p.errors
        push(&mut errs, msg)
        p.errors = errs
        p.had_error = true
        return
    }
    println(msg)
    exit(1)
}

fn parser_int_to_string(n: i64) -> String {
    if n == 0 { return string_clone("0") }
    let mut x = n
    let mut out = string_clone("")
    let mut neg = false
    if x < 0 {
        neg = true
        x = 0 - x
    }
    while x > 0 {
        let d = x % 10
        let digit = substr("0123456789", d, 1)
        out = digit + out
        x = x / 10
    }
    if neg { out = "-" + out }
    return out
}

fn parser_int_to_string_i32(n: i32) -> String {
    if n == 0 { return string_clone("0") }
    let mut x = n
    let mut out = string_clone("")
    let mut neg = false
    if x < 0 {
        neg = true
        x = 0 - x
    }
    while x > 0 {
        let d = x % 10
        let digit = parser_digit_i32(d)
        out = digit + out
        x = x / 10
    }
    if neg { out = "-" + out }
    return out
}

fn parser_digit_i32(d: i32) -> String {
    if d == 0 { return string_clone("0") }
    if d == 1 { return string_clone("1") }
    if d == 2 { return string_clone("2") }
    if d == 3 { return string_clone("3") }
    if d == 4 { return string_clone("4") }
    if d == 5 { return string_clone("5") }
    if d == 6 { return string_clone("6") }
    if d == 7 { return string_clone("7") }
    if d == 8 { return string_clone("8") }
    return string_clone("9")
}

fn parser_gensym(p: &mut Parser, prefix: String) -> String {
    let id = p.gensym
    p.gensym = p.gensym + 1
    return prefix + parser_int_to_string(id)
}

// Parse helpers from raw strings for macro expansion.
struct ExprParseResult {
    expr: Expr,
    errors: [String],
}

struct StmtParseResult {
    stmt: Stmt,
    errors: [String],
}

struct BlockParseResult {
    block: Block,
    errors: [String],
}

// Parse helpers that collect errors instead of exiting.
fn parse_expr_string(src: &str) -> ExprParseResult {
    let toks = lexer_all(src)
    let mut p = parser_new(toks)
    p.soft_errors = true
    let expr = parse_expr(&mut p)
    return ExprParseResult { expr: expr, errors: ast_string_list_clone(&p.errors) }
}

fn parse_stmt_string(src: &str) -> StmtParseResult {
    let toks = lexer_all(src)
    let mut p = parser_new(toks)
    p.soft_errors = true
    let stmt = parse_stmt(&mut p)
    return StmtParseResult { stmt: stmt, errors: ast_string_list_clone(&p.errors) }
}

fn parse_block_string(src: &str) -> BlockParseResult {
    let toks = lexer_all(src)
    let mut p = parser_new(toks)
    p.soft_errors = true
    let block = parse_block(&mut p)
    return BlockParseResult { block: block, errors: ast_string_list_clone(&p.errors) }
}
