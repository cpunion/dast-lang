fn parse_args(p: &mut Parser) -> [Expr] {
    let mut args: [Expr] = []
    if parser_peek(p).kind == TK_RPAREN { return args }
    let mut done = false
    while !done {
        push(&mut args, parse_expr(p))
        let t = parser_peek(p)
        if t.kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
    return args
}

fn parse_unary(p: &mut Parser) -> Expr {
    let t = parser_peek(p)
    if t.kind == TK_MINUS {
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_INT {
            let v = parser_advance(p).int_value
            return expr_int(-v)
        }
        let inner = parse_unary(p)
        return expr_unary("-", inner)
    }
    if t.kind == TK_BANG {
        let _ = parser_advance(p)
        let inner = parse_unary(p)
        return expr_unary("!", inner)
    }
    if t.kind == TK_AMP {
        let _ = parser_advance(p)
        let mut is_mut = false
        if parser_peek(p).kind == TK_MUT {
            let _ = parser_advance(p)
            is_mut = true
        }
        let inner = parse_unary(p)
        if is_mut { return expr_ref_mut(inner) }
        return expr_ref(inner)
    }
    if t.kind == TK_STAR {
        let _ = parser_advance(p)
        let inner = parse_unary(p)
        return expr_deref(inner)
    }
    return parse_postfix(p)
}

fn parse_postfix(p: &mut Parser) -> Expr {
    let mut cur = parse_primary(p)
    let mut done = false
    while !done {
        let t = parser_peek(p)
        if t.kind == TK_LPAREN {
            let _ = parser_advance(p)
            let args = parse_args(p)
            let _ = parser_expect(p, TK_RPAREN, ")")
            if cur.kind == EXPR_IDENT {
                cur = expr_call(cur.name, args)
            } else if cur.kind == EXPR_FIELD && len(&cur.args) > 0 && cur.args[0].kind == EXPR_IDENT {
                let recv_name = string_clone(&cur.args[0].name)
                let mut is_type = false
                if len(&recv_name) > 0 {
                    let c = str_char_at(&recv_name, 0)
                    if c >= 65 && c <= 90 { is_type = true }
                }
                if is_type {
                    let callee = recv_name + "." + cur.name
                    cur = expr_call(callee, args)
                } else {
                    let mut full_args: [Expr] = []
                    push(&mut full_args, expr_clone(&cur.args[0]))
                    let mut i = 0
                    while i < len(&args) {
                        push(&mut full_args, args[i])
                        i = i + 1
                    }
                    cur = expr_call(cur.name, full_args)
                }
            } else {
                println("parse error: call target")
                exit(1)
            }
        } else if t.kind == TK_BANG {
            let _ = parser_advance(p)
            let _ = parser_expect(p, TK_LPAREN, "(")
            let args = parse_args(p)
            let _ = parser_expect(p, TK_RPAREN, ")")
            if cur.kind == EXPR_IDENT {
                cur = expr_macro_call(cur.name, args)
            } else if cur.kind == EXPR_FIELD && len(&cur.args) > 0 && cur.args[0].kind == EXPR_IDENT {
                let recv_name = string_clone(&cur.args[0].name)
                let callee = recv_name + "." + cur.name
                cur = expr_macro_call(callee, args)
            } else {
                println("parse error: macro call target")
                exit(1)
            }
        } else if t.kind == TK_LBRACKET {
            if cur.kind == EXPR_IDENT && is_type_arg_struct_lit(p) {
                let full_name = parse_type_suffix(p, string_clone(&cur.name))
                let fields = parse_struct_lit_fields(p)
                cur = expr_struct_lit(full_name, fields)
            } else {
                let _ = parser_advance(p)
                let idx = parse_expr(p)
                let _ = parser_expect(p, TK_RBRACKET, "]")
                cur = expr_index(cur, idx)
            }
        } else if t.kind == TK_DOT {
            let _ = parser_advance(p)
            let nt = parser_peek(p)
            let mut fname = ""
            if nt.kind == TK_IDENT {
                fname = parser_advance(p).text
            } else if nt.kind == TK_INT {
                fname = parser_int_to_string(parser_advance(p).int_value)
            } else {
                println("parse error: expected field")
                exit(1)
            }
            cur = expr_field(cur, fname)
        } else {
            done = true
        }
    }
    return cur
}

fn is_type_arg_struct_lit(p: &Parser) -> bool {
    if parser_peek(p).kind != TK_LBRACKET { return false }
    let mut idx = p.idx
    let mut depth = 0
    while idx < p.n {
        let t = token_clone(&p.tokens[idx])
        if t.kind == TK_LBRACKET { depth = depth + 1 }
        if t.kind == TK_RBRACKET {
            depth = depth - 1
            if depth == 0 {
                let next = idx + 1
                if next >= p.n { return false }
                let nt = token_clone(&p.tokens[next])
                return nt.kind == TK_LBRACE
            }
        }
        idx = idx + 1
    }
    return false
}
