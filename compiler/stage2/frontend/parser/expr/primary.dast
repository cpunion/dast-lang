// Expression parsing for stage2.

fn parse_const_expr(p: &mut Parser) -> Expr {
    let t = parser_peek(p)
    if t.kind == TK_MINUS {
        let _ = parser_advance(p)
        let v = parser_expect(p, TK_INT, "int").int_value
        return expr_int(-v)
    }
    return parse_expr(p)
}

fn parse_primary(p: &mut Parser) -> Expr {
    let t = parser_peek(p)
    match t.kind {
        TK_PIPE => {
            return parse_closure(p)
        }
        TK_IDENT => {
            let name = parser_advance(p).text
            if !p.no_struct_lit && parser_peek(p).kind == TK_LBRACE {
                let fields = parse_struct_lit_fields(p)
                return expr_struct_lit(name, fields)
            }
            return expr_ident(name)
        }
        TK_INT => {
            let v = parser_advance(p).int_value
            return expr_int(v)
        }
        TK_TRUE => {
            let _ = parser_advance(p)
            return expr_bool(true)
        }
        TK_FALSE => {
            let _ = parser_advance(p)
            return expr_bool(false)
        }
        TK_CHAR => {
            let v = parser_advance(p).int_value
            return expr_char(v)
        }
        TK_STRING => {
            let s = parser_advance(p).text
            return expr_string(s)
        }
        TK_MINUS => {
            let _ = parser_advance(p)
            let v = parser_expect(p, TK_INT, "int").int_value
            return expr_int(-v)
        }
        TK_LPAREN => {
            let _ = parser_advance(p)
            if parser_peek(p).kind == TK_RPAREN {
                let _ = parser_advance(p)
                return expr_int(0)
            }
            let mut elems: [Expr] = []
            push(&mut elems, parse_expr(p))
            if parser_peek(p).kind == TK_COMMA {
                let mut done = false
                while !done {
                    let _ = parser_advance(p)
                    if parser_peek(p).kind == TK_RPAREN {
                        done = true
                    } else {
                        push(&mut elems, parse_expr(p))
                        if parser_peek(p).kind != TK_COMMA {
                            done = true
                        }
                    }
                }
                let _ = parser_expect(p, TK_RPAREN, ")")
                return expr_array(elems)
            }
            let _ = parser_expect(p, TK_RPAREN, ")")
            return elems[0]
        }
        TK_LBRACKET => {
            let _ = parser_advance(p)
            let mut elems: [Expr] = []
            if parser_peek(p).kind != TK_RBRACKET {
                let mut done = false
                while !done {
                    push(&mut elems, parse_expr(p))
                    if parser_peek(p).kind == TK_COMMA {
                        let _ = parser_advance(p)
                    } else {
                        done = true
                    }
                }
            }
            let _ = parser_expect(p, TK_RBRACKET, "]")
            return expr_array(elems)
        }
        TK_LBRACE => {
            let blk = parse_block(p)
            return expr_block(blk)
        }
        TK_MATCH => {
            return parse_match_expr(p)
        }
        TK_IF => {
            return parse_if_expr(p)
        }
        TK_QUOTE => {
            return parse_quote_expr(p)
        }
        _ => {
            println("parse error: unexpected token", t.kind, t.text)
            exit(1)
            return expr_int(0)
        }
    }
}

fn parse_match_expr(p: &mut Parser) -> Expr {
    let _ = parser_expect(p, TK_MATCH, "match")
    let scrut = parse_expr_before_block(p)
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut arms = match_arm_list_empty()
    while parser_peek(p).kind != TK_RBRACE && parser_peek(p).kind != TK_EOF {
        let mut arm = parse_match_pattern(p)
        if parser_peek(p).kind == TK_IF {
            let _ = parser_advance(p)
            arm.guard = parse_expr(p)
            arm.has_guard = true
        }
        let _ = parser_expect(p, TK_FATARROW, "=>")
        arm.block = parse_match_arm_body(p)
        push(&mut arms, arm)
        if parser_peek(p).kind == TK_COMMA { let _ = parser_advance(p) }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return expr_match(scrut, arms)
}

fn parse_if_expr(p: &mut Parser) -> Expr {
    let _ = parser_expect(p, TK_IF, "if")
    let cond = parse_expr_before_block(p)
    let then_block = parse_block(p)
    let mut else_block = block_empty()
    if parser_peek(p).kind == TK_ELSE {
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_IF {
            let else_expr = parse_if_expr(p)
            let mut stmts = stmt_list_empty()
            push(&mut stmts, stmt_expr(else_expr))
            else_block = Block { stmts: stmts }
        } else {
            else_block = parse_block(p)
        }
    } else {
        println("parse error: if expression requires else")
        exit(1)
    }
    let mut arms = match_arm_list_empty()
    let arm_true = MatchArm {
        pat_kind: PAT_INT,
        variant: "",
        binding: "",
        has_binding: false,
        has_guard: false,
        guard: expr_int(0),
        int_value: 1,
        struct_name: "",
        struct_fields: struct_pattern_field_list_empty(),
        block: then_block,
    }
    let arm_false = MatchArm {
        pat_kind: PAT_WILDCARD,
        variant: "",
        binding: "",
        has_binding: false,
        has_guard: false,
        guard: expr_int(0),
        int_value: 0,
        struct_name: "",
        struct_fields: struct_pattern_field_list_empty(),
        block: else_block,
    }
    push(&mut arms, arm_true)
    push(&mut arms, arm_false)
    return expr_match(cond, arms)
}

fn parse_closure_params(p: &mut Parser) -> [Param] {
    let mut params: [Param] = []
    if parser_peek(p).kind == TK_PIPE { return params }
    let mut done = false
    while !done {
        let name = parser_expect(p, TK_IDENT, "param").text
        let mut typ = "i64"
        let mut has_type = false
        if parser_peek(p).kind == TK_COLON {
            let _ = parser_advance(p)
            typ = parse_type_name(p)
            has_type = true
        }
        push(&mut params, Param { name: name, typ: typ, has_type: has_type })
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
    return params
}

fn parse_closure(p: &mut Parser) -> Expr {
    let _ = parser_expect(p, TK_PIPE, "|")
    let params = parse_closure_params(p)
    let _ = parser_expect(p, TK_PIPE, "|")
    let body = parse_block(p)
    return expr_closure(params, body)
}

fn parse_struct_lit_fields(p: &mut Parser) -> [FieldInit] {
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut fields: [FieldInit] = []
    if parser_peek(p).kind == TK_RBRACE {
        let _ = parser_advance(p)
        return fields
    }
    let mut done = false
    while !done {
        let fname = parser_expect(p, TK_IDENT, "field").text
        let _ = parser_expect(p, TK_COLON, ":")
        let val = parse_expr(p)
        push(&mut fields, FieldInit { name: fname, value: val })
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return fields
}

fn quote_token_text(t: &Token) -> String {
    if t.kind == TK_INT { return int_to_string(t.int_value) }
    if t.kind == TK_STRING { return "\"" + string_clone(&t.text) + "\"" }
    if t.kind == TK_CHAR {
        if t.text != "" { return string_clone(&t.text) }
        return "'?'"
    }
    if t.kind == TK_TRUE { return "true" }
    if t.kind == TK_FALSE { return "false" }
    return string_clone(&t.text)
}

fn quote_append_token(text: String, t: &Token) -> String {
    let tok = quote_token_text(t)
    if text == "" { return tok }
    return text + " " + tok
}

fn parse_quote_parts(p: &mut Parser) -> [QuotePart] {
    let mut parts: [QuotePart] = []
    let mut depth = 1
    let mut text = ""
    while depth > 0 {
        let t = parser_peek(p)
        if t.kind == TK_EOF { break }
        if t.kind == TK_DOLLAR {
            let _ = parser_advance(p)
            if text != "" {
                push(&mut parts, QuotePart { text: text, has_expr: false, expr: expr_int(0) })
                text = ""
            }
            if parser_peek(p).kind == TK_LPAREN {
                let _ = parser_advance(p)
                let expr = parse_expr(p)
                let _ = parser_expect(p, TK_RPAREN, ")")
                push(&mut parts, QuotePart { text: "", has_expr: true, expr: expr })
            } else {
                let name = parser_expect(p, TK_IDENT, "splice").text
                push(&mut parts, QuotePart { text: "", has_expr: true, expr: expr_ident(name) })
            }
            continue
        }
        if t.kind == TK_LBRACE {
            depth = depth + 1
        } else if t.kind == TK_RBRACE {
            depth = depth - 1
            if depth == 0 {
                let _ = parser_advance(p)
                break
            }
        }
        let tok = parser_advance(p)
        text = quote_append_token(text, &tok)
    }
    if text != "" {
        push(&mut parts, QuotePart { text: text, has_expr: false, expr: expr_int(0) })
    }
    return parts
}

fn parse_quote_expr(p: &mut Parser) -> Expr {
    let _ = parser_expect(p, TK_QUOTE, "quote")
    let kind_name = parser_expect(p, TK_IDENT, "quote kind").text
    let mut kind = QUOTE_EXPR
    if kind_name == "expr" { kind = QUOTE_EXPR }
    else if kind_name == "stmt" { kind = QUOTE_STMT }
    else if kind_name == "item" { kind = QUOTE_ITEM }
    else {
        println("parse error: unknown quote kind", kind_name)
        exit(1)
    }
    let _ = parser_expect(p, TK_LBRACE, "{")
    let parts = parse_quote_parts(p)
    return expr_quote(kind, parts)
}
