fn parse_add(p: &mut Parser) -> Expr {
    let mut left = parse_postfix(p)
    let mut done = false
    while !done {
        let t = parser_peek(p)
        if t.kind == TK_PLUS || t.kind == TK_MINUS {
            let op = parser_advance(p).text
            let rhs = parse_postfix(p)
            left = expr_binary(op, left, rhs)
        } else {
            done = true
        }
    }
    return left
}

fn parse_lt(p: &mut Parser) -> Expr {
    let mut left = parse_add(p)
    let mut done = false
    while !done {
        let t = parser_peek(p)
        if t.kind == TK_LT || t.kind == TK_GT {
            let op = parser_advance(p).text
            let rhs = parse_add(p)
            left = expr_binary(op, left, rhs)
        } else {
            done = true
        }
    }
    return left
}

fn parse_eq(p: &mut Parser) -> Expr {
    let mut left = parse_lt(p)
    let mut done = false
    while !done {
        let t = parser_peek(p)
        if t.kind == TK_EQEQ {
            let op = parser_advance(p).text
            let rhs = parse_lt(p)
            left = expr_binary(op, left, rhs)
        } else {
            done = true
        }
    }
    return left
}

fn parse_expr(p: &mut Parser) -> Expr {
    return parse_eq(p)
}
