// Expression parsing for stage2.

fn parse_const_expr(p: &mut Parser) -> Expr {
    let t = parser_peek(p)
    if t.kind == TK_MINUS {
        let _ = parser_advance(p)
        let v = parser_expect(p, TK_INT, "int").int_value
        return expr_int(-v)
    }
    return parse_expr(p)
}

fn parse_primary(p: &mut Parser) -> Expr {
    let t = parser_peek(p)
    match t.kind {
        TK_PIPE => {
            return parse_closure(p)
        }
        TK_IDENT => {
            let name = parser_advance(p).text
            if !p.no_struct_lit && parser_peek(p).kind == TK_LBRACE {
                let fields = parse_struct_lit_fields(p)
                return expr_struct_lit(name, fields)
            }
            return expr_ident(name)
        }
        TK_INT => {
            let v = parser_advance(p).int_value
            return expr_int(v)
        }
        TK_TRUE => {
            let _ = parser_advance(p)
            return expr_bool(true)
        }
        TK_FALSE => {
            let _ = parser_advance(p)
            return expr_bool(false)
        }
        TK_CHAR => {
            let v = parser_advance(p).int_value
            return expr_char(v)
        }
        TK_STRING => {
            let s = parser_advance(p).text
            return expr_string(s)
        }
        TK_MINUS => {
            let _ = parser_advance(p)
            let v = parser_expect(p, TK_INT, "int").int_value
            return expr_int(-v)
        }
        TK_LPAREN => {
            let _ = parser_advance(p)
            if parser_peek(p).kind == TK_RPAREN {
                let _ = parser_advance(p)
                return expr_int(0)
            }
            let mut elems: [Expr] = []
            push(&mut elems, parse_expr(p))
            if parser_peek(p).kind == TK_COMMA {
                let mut done = false
                while !done {
                    let _ = parser_advance(p)
                    if parser_peek(p).kind == TK_RPAREN {
                        done = true
                    } else {
                        push(&mut elems, parse_expr(p))
                        if parser_peek(p).kind != TK_COMMA {
                            done = true
                        }
                    }
                }
                let _ = parser_expect(p, TK_RPAREN, ")")
                return expr_array(elems)
            }
            let _ = parser_expect(p, TK_RPAREN, ")")
            return elems[0]
        }
        TK_LBRACKET => {
            let _ = parser_advance(p)
            let mut elems: [Expr] = []
            if parser_peek(p).kind != TK_RBRACKET {
                let mut done = false
                while !done {
                    push(&mut elems, parse_expr(p))
                    if parser_peek(p).kind == TK_COMMA {
                        let _ = parser_advance(p)
                    } else {
                        done = true
                    }
                }
            }
            let _ = parser_expect(p, TK_RBRACKET, "]")
            return expr_array(elems)
        }
        TK_LBRACE => {
            let blk = parse_block(p)
            return expr_block(blk)
        }
        TK_MATCH => {
            return parse_match_expr(p)
        }
        TK_IF => {
            return parse_if_expr(p)
        }
        TK_QUOTE => {
            return parse_quote_expr(p)
        }
        _ => {
            println("parse error: unexpected token", t.kind, t.text)
            exit(1)
            return expr_int(0)
        }
    }
}

fn parse_match_expr(p: &mut Parser) -> Expr {
    let _ = parser_expect(p, TK_MATCH, "match")
    let scrut = parse_expr_before_block(p)
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut arms = match_arm_list_empty()
    while parser_peek(p).kind != TK_RBRACE && parser_peek(p).kind != TK_EOF {
        let mut arm = parse_match_pattern(p)
        let _ = parser_expect(p, TK_FATARROW, "=>")
        arm.block = parse_match_arm_body(p)
        push(&mut arms, arm)
        if parser_peek(p).kind == TK_COMMA { let _ = parser_advance(p) }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return expr_match(scrut, arms)
}

fn parse_if_expr(p: &mut Parser) -> Expr {
    let _ = parser_expect(p, TK_IF, "if")
    let cond = parse_expr_before_block(p)
    let then_block = parse_block(p)
    let mut else_block = block_empty()
    if parser_peek(p).kind == TK_ELSE {
        let _ = parser_advance(p)
        if parser_peek(p).kind == TK_IF {
            let else_expr = parse_if_expr(p)
            let mut stmts = stmt_list_empty()
            push(&mut stmts, stmt_expr(else_expr))
            else_block = Block { stmts: stmts }
        } else {
            else_block = parse_block(p)
        }
    } else {
        println("parse error: if expression requires else")
        exit(1)
    }
    let mut arms = match_arm_list_empty()
    let arm_true = MatchArm {
        pat_kind: PAT_INT,
        variant: "",
        binding: "",
        has_binding: false,
        int_value: 1,
        struct_name: "",
        struct_fields: struct_pattern_field_list_empty(),
        block: then_block,
    }
    let arm_false = MatchArm {
        pat_kind: PAT_WILDCARD,
        variant: "",
        binding: "",
        has_binding: false,
        int_value: 0,
        struct_name: "",
        struct_fields: struct_pattern_field_list_empty(),
        block: else_block,
    }
    push(&mut arms, arm_true)
    push(&mut arms, arm_false)
    return expr_match(cond, arms)
}

fn parse_closure_params(p: &mut Parser) -> [Param] {
    let mut params: [Param] = []
    if parser_peek(p).kind == TK_PIPE { return params }
    let mut done = false
    while !done {
        let name = parser_expect(p, TK_IDENT, "param").text
        let mut typ = "i64"
        let mut has_type = false
        if parser_peek(p).kind == TK_COLON {
            let _ = parser_advance(p)
            typ = parse_type_name(p)
            has_type = true
        }
        push(&mut params, Param { name: name, typ: typ, has_type: has_type })
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
    return params
}

fn parse_closure(p: &mut Parser) -> Expr {
    let _ = parser_expect(p, TK_PIPE, "|")
    let params = parse_closure_params(p)
    let _ = parser_expect(p, TK_PIPE, "|")
    let body = parse_block(p)
    return expr_closure(params, body)
}

fn parse_struct_lit_fields(p: &mut Parser) -> [FieldInit] {
    let _ = parser_expect(p, TK_LBRACE, "{")
    let mut fields: [FieldInit] = []
    if parser_peek(p).kind == TK_RBRACE {
        let _ = parser_advance(p)
        return fields
    }
    let mut done = false
    while !done {
        let fname = parser_expect(p, TK_IDENT, "field").text
        let _ = parser_expect(p, TK_COLON, ":")
        let val = parse_expr(p)
        push(&mut fields, FieldInit { name: fname, value: val })
        if parser_peek(p).kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
    let _ = parser_expect(p, TK_RBRACE, "}")
    return fields
}

fn quote_token_text(t: &Token) -> String {
    if t.kind == TK_INT { return int_to_string(t.int_value) }
    if t.kind == TK_STRING { return "\"" + string_clone(&t.text) + "\"" }
    if t.kind == TK_CHAR {
        if t.text != "" { return string_clone(&t.text) }
        return "'?'"
    }
    if t.kind == TK_TRUE { return "true" }
    if t.kind == TK_FALSE { return "false" }
    return string_clone(&t.text)
}

fn quote_append_token(text: String, t: &Token) -> String {
    let tok = quote_token_text(t)
    if text == "" { return tok }
    return text + " " + tok
}

fn parse_quote_parts(p: &mut Parser) -> [QuotePart] {
    let mut parts: [QuotePart] = []
    let mut depth = 1
    let mut text = ""
    while depth > 0 {
        let t = parser_peek(p)
        if t.kind == TK_EOF { break }
        if t.kind == TK_DOLLAR {
            let _ = parser_advance(p)
            if text != "" {
                push(&mut parts, QuotePart { text: text, has_expr: false, expr: expr_int(0) })
                text = ""
            }
            if parser_peek(p).kind == TK_LPAREN {
                let _ = parser_advance(p)
                let expr = parse_expr(p)
                let _ = parser_expect(p, TK_RPAREN, ")")
                push(&mut parts, QuotePart { text: "", has_expr: true, expr: expr })
            } else {
                let name = parser_expect(p, TK_IDENT, "splice").text
                push(&mut parts, QuotePart { text: "", has_expr: true, expr: expr_ident(name) })
            }
            continue
        }
        if t.kind == TK_LBRACE {
            depth = depth + 1
        } else if t.kind == TK_RBRACE {
            depth = depth - 1
            if depth == 0 {
                let _ = parser_advance(p)
                break
            }
        }
        let tok = parser_advance(p)
        text = quote_append_token(text, &tok)
    }
    if text != "" {
        push(&mut parts, QuotePart { text: text, has_expr: false, expr: expr_int(0) })
    }
    return parts
}

fn parse_quote_expr(p: &mut Parser) -> Expr {
    let _ = parser_expect(p, TK_QUOTE, "quote")
    let kind_name = parser_expect(p, TK_IDENT, "quote kind").text
    let mut kind = QUOTE_EXPR
    if kind_name == "expr" { kind = QUOTE_EXPR }
    else if kind_name == "stmt" { kind = QUOTE_STMT }
    else if kind_name == "item" { kind = QUOTE_ITEM }
    else {
        println("parse error: unknown quote kind", kind_name)
        exit(1)
    }
    let _ = parser_expect(p, TK_LBRACE, "{")
    let parts = parse_quote_parts(p)
    return expr_quote(kind, parts)
}

fn parse_args(p: &mut Parser) -> [Expr] {
    let mut args: [Expr] = []
    if parser_peek(p).kind == TK_RPAREN { return args }
    let mut done = false
    while !done {
        push(&mut args, parse_expr(p))
        let t = parser_peek(p)
        if t.kind == TK_COMMA {
            let _ = parser_advance(p)
        } else {
            done = true
        }
    }
    return args
}

fn parse_unary(p: &mut Parser) -> Expr {
    let t = parser_peek(p)
    if t.kind == TK_MINUS {
        let _ = parser_advance(p)
        let v = parser_expect(p, TK_INT, "int").int_value
        return expr_int(-v)
    }
    if t.kind == TK_AMP {
        let _ = parser_advance(p)
        let mut is_mut = false
        if parser_peek(p).kind == TK_MUT {
            let _ = parser_advance(p)
            is_mut = true
        }
        let inner = parse_unary(p)
        if is_mut { return expr_ref_mut(inner) }
        return expr_ref(inner)
    }
    if t.kind == TK_STAR {
        let _ = parser_advance(p)
        let inner = parse_unary(p)
        return expr_deref(inner)
    }
    return parse_primary(p)
}

fn parse_postfix(p: &mut Parser) -> Expr {
    let mut cur = parse_unary(p)
    let mut done = false
    while !done {
        let t = parser_peek(p)
        if t.kind == TK_LPAREN {
            let _ = parser_advance(p)
            let args = parse_args(p)
            let _ = parser_expect(p, TK_RPAREN, ")")
            if cur.kind == EXPR_IDENT {
                cur = expr_call(cur.name, args)
            } else if cur.kind == EXPR_FIELD && len(cur.args) > 0 && cur.args[0].kind == EXPR_IDENT {
                let recv_name = string_clone(&cur.args[0].name)
                let mut is_type = false
                if len(recv_name) > 0 {
                    let c = str_char_at(&recv_name, 0)
                    if c >= 65 && c <= 90 { is_type = true }
                }
                if is_type {
                    let callee = recv_name + "." + cur.name
                    cur = expr_call(callee, args)
                } else {
                    let mut full_args: [Expr] = []
                    push(&mut full_args, expr_clone(&cur.args[0]))
                    let mut i = 0
                    while i < len(args) {
                        push(&mut full_args, args[i])
                        i = i + 1
                    }
                    cur = expr_call(cur.name, full_args)
                }
            } else {
                println("parse error: call target")
                exit(1)
            }
        } else if t.kind == TK_BANG {
            let _ = parser_advance(p)
            let _ = parser_expect(p, TK_LPAREN, "(")
            let args = parse_args(p)
            let _ = parser_expect(p, TK_RPAREN, ")")
            if cur.kind == EXPR_IDENT {
                cur = expr_macro_call(cur.name, args)
            } else {
                println("parse error: macro call target")
                exit(1)
            }
        } else if t.kind == TK_LBRACKET {
            if cur.kind == EXPR_IDENT && is_type_arg_struct_lit(p) {
                let full_name = parse_type_suffix(p, string_clone(&cur.name))
                let fields = parse_struct_lit_fields(p)
                cur = expr_struct_lit(full_name, fields)
            } else {
                let _ = parser_advance(p)
                let idx = parse_expr(p)
                let _ = parser_expect(p, TK_RBRACKET, "]")
                cur = expr_index(cur, idx)
            }
        } else if t.kind == TK_DOT {
            let _ = parser_advance(p)
            let nt = parser_peek(p)
            let mut fname = ""
            if nt.kind == TK_IDENT {
                fname = parser_advance(p).text
            } else if nt.kind == TK_INT {
                fname = parser_int_to_string(parser_advance(p).int_value)
            } else {
                println("parse error: expected field")
                exit(1)
            }
            cur = expr_field(cur, fname)
        } else {
            done = true
        }
    }
    return cur
}

fn is_type_arg_struct_lit(p: &Parser) -> bool {
    if parser_peek(p).kind != TK_LBRACKET { return false }
    let mut idx = p.idx
    let mut depth = 0
    while idx < p.n {
        let t = token_clone(&p.tokens[idx])
        if t.kind == TK_LBRACKET { depth = depth + 1 }
        if t.kind == TK_RBRACKET {
            depth = depth - 1
            if depth == 0 {
                let next = idx + 1
                if next >= p.n { return false }
                let nt = token_clone(&p.tokens[next])
                return nt.kind == TK_LBRACE
            }
        }
        idx = idx + 1
    }
    return false
}

fn parse_add(p: &mut Parser) -> Expr {
    let mut left = parse_postfix(p)
    let mut done = false
    while !done {
        let t = parser_peek(p)
        if t.kind == TK_PLUS || t.kind == TK_MINUS {
            let op = parser_advance(p).text
            let rhs = parse_postfix(p)
            left = expr_binary(op, left, rhs)
        } else {
            done = true
        }
    }
    return left
}

fn parse_lt(p: &mut Parser) -> Expr {
    let mut left = parse_add(p)
    let mut done = false
    while !done {
        let t = parser_peek(p)
        if t.kind == TK_LT || t.kind == TK_GT {
            let op = parser_advance(p).text
            let rhs = parse_add(p)
            left = expr_binary(op, left, rhs)
        } else {
            done = true
        }
    }
    return left
}

fn parse_eq(p: &mut Parser) -> Expr {
    let mut left = parse_lt(p)
    let mut done = false
    while !done {
        let t = parser_peek(p)
        if t.kind == TK_EQEQ {
            let op = parser_advance(p).text
            let rhs = parse_lt(p)
            left = expr_binary(op, left, rhs)
        } else {
            done = true
        }
    }
    return left
}

fn parse_expr(p: &mut Parser) -> Expr {
    return parse_eq(p)
}
