fn ctx_set_func_ret(ctx: &mut TypeContext, idx: i32, ret: i32) {
    let mut funcs = ctx.funcs
    if idx < 0 || idx >= len(funcs) {
        return
    }
    let mut sig = funcs[idx]
    sig.ret = ret
    funcs[idx] = sig
    ctx.funcs = funcs
}

fn ctx_set_method_ret(ctx: &mut TypeContext, idx: i32, ret: i32) {
    let mut methods = ctx.methods
    if idx < 0 || idx >= len(methods) {
        return
    }
    let mut sig = methods[idx]
    sig.ret = ret
    methods[idx] = sig
    ctx.methods = methods
}

