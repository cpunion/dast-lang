struct TypeTable {
    kinds: [i32],
    names: [String],
    refs: [bool],
    muts: [bool],
    elems: [i32],
}

struct FuncSig {
    module: String,
    vis: Visibility,
    name: String,
    params: [i32],
    ret: i32,
    ret_explicit: bool,
}

struct MethodSig {
    module: String,
    vis: Visibility,
    type_name: String,
    name: String,
    func_name: String,
    params: [i32],
    ret: i32,
    ret_explicit: bool,
    has_self: bool,
}

struct ConstSig {
    module: String,
    vis: Visibility,
    name: String,
    typ: i32,
}

fn reexport_kind_struct() -> i32 { return 1 }
fn reexport_kind_enum() -> i32 { return 2 }
fn reexport_kind_const() -> i32 { return 3 }
fn reexport_kind_func() -> i32 { return 4 }

struct ReExport {
    module: String,
    name: String,
    target: String,
    kind: i32,
    vis: Visibility,
}

struct PendingReExport {
    module: String,
    name: String,
    target_name: String,
    target_mod: String,
    vis: Visibility,
    file: String,
    pos: i32,
}

struct ModuleAlias {
    alias: String,
    module: String,
}

struct ImportItem {
    local: String,
    module: String,
    name: String,
}

struct VarEntry {
    name: String,
    typ: i32,
    mutable: bool,
}

struct Env {
    names: [String],
    types: [i32],
    muts: [bool],
    scopes: [i32],
}

struct TypeContext {
    types: TypeTable,
    funcs: [FuncSig],
    methods: [MethodSig],
    consts: [ConstSig],
    structs: [StructDecl],
    enums: [EnumDecl],
    imports: [ImportDecl],
    module_aliases: [ModuleAlias],
    import_items: [ImportItem],
    reexports: [ReExport],
    current_module: String,
    builtins: [String],
    errors: [ParseError],
    env: Env,
    infer_return: bool,
    inferred_type: i32,
    has_return: bool,
    has_bare_return: bool,
    current_func: String,
    current_ret: i32,
    current_ret_explicit: bool,
    self_type: String,
    current_file: String,
    current_pos: i32,
    loop_depth: i32,
}

fn type_table_new() -> TypeTable {
    let mut kinds: [i32] = []
    let mut names: [String] = []
    let mut refs: [bool] = []
    let mut muts: [bool] = []
    let mut elems: [i32] = []
    // index 0 invalid
    push(&mut kinds, 0)
    push(&mut names, "invalid")
    push(&mut refs, false)
    push(&mut muts, false)
    push(&mut elems, -1)
    return TypeTable { kinds: kinds, names: names, refs: refs, muts: muts, elems: elems }
}

fn alias_list_new() -> [ModuleAlias] {
    let mut items: [ModuleAlias] = []
    return items
}

fn import_entry_list_new() -> [ImportItem] {
    let mut items: [ImportItem] = []
    return items
}

fn name_list_new() -> [String] {
    let mut items: [String] = []
    return items
}

fn name_list_contains(items: [String], name: String) -> bool {
    let mut i = 0
    while i < len(items) {
        if items[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn module_list_push_unique(list: &mut [String], module: String) {
    if !name_list_contains(*list, module) {
        push(list, module)
    }
}

fn module_strip_root(path: String) -> String {
    // Use nested if to avoid Stage0's lack of short-circuit evaluation
    if len(path) >= 2 {
        if char_at(path, 0) == 58 {
            if char_at(path, 1) == 58 {
                return substr(path, 2, len(path) - 2)
            }
        }
    }
    return path
}

fn path_last_segment(path: String) -> String {
    let clean = module_strip_root(path)
    let mut last = 0
    let mut i = 0
    while i < len(clean) {
        if char_at(clean, i) == 46 {
            last = i + 1
        }
        i = i + 1
    }
    if last < 0 || last >= len(clean) {
        return clean
    }
    return substr(clean, last, len(clean) - last)
}

fn qualify_name(module: String, name: String) -> String {
    if module == "" {
        return name
    }
    return module + "::" + name
}

fn module_parent(path: String) -> String {
    let mut last = -1
    let mut i = 0
    while i < len(path) {
        if char_at(path, i) == 46 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    return substr(path, 0, last)
}

fn module_join(base: String, rel: String) -> String {
    let clean = module_strip_root(rel)
    if clean != rel {
        return clean
    }
    if base == "" { return rel }
    if rel == "" { return base }
    return base + "." + rel
}

fn module_is_prefix(prefix: String, path: String) -> bool {
    if prefix == "" {
        return true
    }
    if path == prefix {
        return true
    }
    let want = prefix + "."
    if len(path) < len(want) {
        return false
    }
    return substr(path, 0, len(want)) == want
}

fn visibility_allows(vis: Visibility, def_module: String, use_module: String) -> bool {
    if def_module == use_module {
        return true
    }
    if vis.kind == vis_pub() {
        return true
    }
    if vis.kind == vis_pub_crate() {
        return true
    }
    if vis.kind == vis_pub_super() {
        let parent = module_parent(def_module)
        return module_is_prefix(parent, use_module)
    }
    return false
}

fn module_list_from_program(prog: Program) -> [String] {
    let mut modules = name_list_new()
    let mut i = 0
    while i < len(prog.imports) {
        module_list_push_unique(&mut modules, prog.imports[i].module)
        i = i + 1
    }
    let mut j = 0
    while j < len(prog.structs) {
        module_list_push_unique(&mut modules, prog.structs[j].module)
        j = j + 1
    }
    let mut k = 0
    while k < len(prog.enums) {
        module_list_push_unique(&mut modules, prog.enums[k].module)
        k = k + 1
    }
    let mut c = 0
    while c < len(prog.consts) {
        module_list_push_unique(&mut modules, prog.consts[c].module)
        c = c + 1
    }
    let mut f = 0
    while f < len(prog.functions) {
        module_list_push_unique(&mut modules, prog.functions[f].module)
        f = f + 1
    }
    let mut imp = 0
    while imp < len(prog.impls) {
        module_list_push_unique(&mut modules, prog.impls[imp].module)
        imp = imp + 1
    }
    return modules
}

fn module_aliases_from_imports(imports: [ImportDecl], module: String) -> [ModuleAlias] {
    let mut aliases = alias_list_new()
    let mut i = 0
    while i < len(imports) {
        let imp = imports[i]
        if imp.module == module && !imp.has_items {
            let mut name = ""
            if imp.has_alias {
                name = imp.alias
            } else {
                name = path_last_segment(imp.path)
            }
            if name != "" {
                let mut full = module_join(module, imp.path)
                if full == "" && imp.path == "::" {
                    full = "::"
                }
                push(&mut aliases, ModuleAlias { alias: name, module: full })
            }
        }
        i = i + 1
    }
    return aliases
}

fn import_items_from_imports(imports: [ImportDecl], module: String) -> [ImportItem] {
    let mut items = import_entry_list_new()
    let mut i = 0
    while i < len(imports) {
        let imp = imports[i]
        if imp.module == module && imp.has_items {
            let full = module_join(module, imp.path)
            let mut j = 0
            while j < len(imp.items) {
                let spec = imp.items[j]
                let mut local = spec.name
                if spec.has_alias {
                    local = spec.alias
                }
                if local != "" && spec.name != "" {
                    push(&mut items, ImportItem { local: local, module: full, name: spec.name })
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return items
}

fn local_decl_exists(ctx: &TypeContext, module: String, name: String) -> bool {
    let structs = ctx.structs
    let enums = ctx.enums
    let consts = ctx.consts
    if find_struct_in_module(&structs, module, name) >= 0 { return true }
    if find_enum_in_module(&enums, module, name) >= 0 { return true }
    if find_const_in_module(&consts, module, name) >= 0 { return true }
    if find_func_in_module(ctx, module, name) >= 0 { return true }
    return false
}

fn check_import_name(ctx: &mut TypeContext, module: String, name: String, seen: &mut [String]) {
    if name == "" {
        return
    }
    if name_list_contains(*seen, name) {
        add_type_error(ctx, "duplicate import '" + name + "'")
        return
    }
    if local_decl_exists(ctx, module, name) {
        add_type_error(ctx, "import '" + name + "' conflicts with local declaration")
    }
    push(seen, name)
}

fn check_import_conflicts(ctx: &mut TypeContext, prog: Program) {
    let modules = module_list_from_program(prog)
    let mut mi = 0
    while mi < len(modules) {
        let module = modules[mi]
        let mut seen = name_list_new()
        let mut i = 0
        while i < len(prog.imports) {
            let imp = prog.imports[i]
            if imp.module == module {
                ctx_set_file(ctx, imp.file)
                ctx_set_pos(ctx, imp.pos)
                if imp.has_items {
                    let mut j = 0
                    while j < len(imp.items) {
                        let spec = imp.items[j]
                        ctx_set_pos(ctx, spec.pos)
                        let mut local = spec.name
                        if spec.has_alias {
                            local = spec.alias
                        }
                        check_import_name(ctx, module, local, &mut seen)
                        j = j + 1
                    }
                } else {
                    let mut alias = ""
                    if imp.has_alias {
                        alias = imp.alias
                    } else {
                        alias = path_last_segment(imp.path)
                    }
                    check_import_name(ctx, module, alias, &mut seen)
                }
            }
            i = i + 1
        }
        mi = mi + 1
    }
}

fn module_alias_module(ctx: &TypeContext, name: String) -> String {
    let mut i = 0
    while i < len(ctx.module_aliases) {
        if ctx.module_aliases[i].alias == name {
            let mod = ctx.module_aliases[i].module
            if mod == "" {
                return "::"
            }
            return mod
        }
        i = i + 1
    }
    return ""
}

fn ctx_set_current_module(ctx: &mut TypeContext, module: String) {
    ctx.current_module = module
    ctx.module_aliases = module_aliases_from_imports(ctx.imports, module)
    ctx.import_items = import_items_from_imports(ctx.imports, module)
}

fn find_reexport(ctx: &TypeContext, module: String, name: String, kind: i32) -> i32 {
    let mut i = 0
    while i < len(ctx.reexports) {
        let r = ctx.reexports[i]
        if r.module == module && r.name == name && r.kind == kind {
            return i
        }
        i = i + 1
    }
    return -1
}

fn reexport_list_has_name(list: [ReExport], module: String, name: String) -> bool {
    let mut i = 0
    while i < len(list) {
        let r = list[i]
        if r.module == module && r.name == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn find_reexport_in_list(list: [ReExport], module: String, name: String) -> i32 {
    let mut i = 0
    while i < len(list) {
        let r = list[i]
        if r.module == module && r.name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn resolve_reexport(ctx: &mut TypeContext, module: String, name: String, kind: i32) -> String {
    let idx = find_reexport(ctx, module, name, kind)
    if idx < 0 { return "" }
    let r = ctx.reexports[idx]
    if !visibility_allows(r.vis, r.module, ctx.current_module) {
        let label = name
        if kind == reexport_kind_struct() { add_type_error(ctx, "struct '" + label + "' is private") }
        if kind == reexport_kind_enum() { add_type_error(ctx, "enum '" + label + "' is private") }
        if kind == reexport_kind_const() { add_type_error(ctx, "const '" + label + "' is private") }
        if kind == reexport_kind_func() { add_type_error(ctx, "function '" + label + "' is private") }
        return ""
    }
    return r.target
}

fn collect_reexports(ctx: &mut TypeContext, prog: Program) {
    let mut out = reexport_list_new()
    let mut pending: [PendingReExport] = []
    let mut i = 0
    while i < len(prog.imports) {
        let imp = prog.imports[i]
        let mut eligible = true
        if imp.vis.kind != vis_pub() && imp.vis.kind != vis_pub_crate() && imp.vis.kind != vis_pub_super() {
            eligible = false
        }
        if eligible {
            ctx_set_file(ctx, imp.file)
            ctx_set_pos(ctx, imp.pos)
            let module = imp.module
            let target_mod = module_join(module, imp.path)
            let structs = ctx.structs
            let enums = ctx.enums
            let consts = ctx.consts
            let funcs = prog.functions
            if imp.has_items {
                let mut j = 0
                while j < len(imp.items) {
                    let spec = imp.items[j]
                    ctx_set_pos(ctx, spec.pos)
                    let target_name = spec.name
                    let mut name = spec.name
                    if spec.has_alias {
                        name = spec.alias
                    }
                    let mut do_item = true
                    if name == "" || target_name == "" {
                        do_item = false
                    }
                    if do_item && reexport_list_has_name(out, module, name) {
                        add_type_error(ctx, "duplicate reexport '" + name + "'")
                        do_item = false
                    }
                    if do_item {
                        let mut found = false
                        let sidx = find_struct_in_module(&structs, target_mod, target_name)
                        if sidx >= 0 {
                            let decl = structs[sidx]
                            if !visibility_allows(decl.vis, decl.module, module) {
                                add_type_error(ctx, "cannot reexport private struct '" + target_name + "'")
                            } else {
                                push(&mut out, ReExport { module: module, name: name, target: qualify_name(decl.module, decl.name), kind: reexport_kind_struct(), vis: imp.vis })
                            }
                            found = true
                        }
                        let eidx = find_enum_in_module(&enums, target_mod, target_name)
                        if !found && eidx >= 0 {
                            let decl = enums[eidx]
                            if !visibility_allows(decl.vis, decl.module, module) {
                                add_type_error(ctx, "cannot reexport private enum '" + target_name + "'")
                            } else {
                                push(&mut out, ReExport { module: module, name: name, target: qualify_name(decl.module, decl.name), kind: reexport_kind_enum(), vis: imp.vis })
                            }
                            found = true
                        }
                        let cidx = find_const_in_module(&consts, target_mod, target_name)
                        if !found && cidx >= 0 {
                            let decl = consts[cidx]
                            if !visibility_allows(decl.vis, decl.module, module) {
                                add_type_error(ctx, "cannot reexport private const '" + target_name + "'")
                            } else {
                                push(&mut out, ReExport { module: module, name: name, target: qualify_name(decl.module, decl.name), kind: reexport_kind_const(), vis: imp.vis })
                            }
                            found = true
                        }
                        if !found {
                            let fidx = find_func_decl_in_module(&funcs, target_mod, target_name)
                            if fidx >= 0 {
                                let decl = funcs[fidx]
                                if !visibility_allows(decl.vis, decl.module, module) {
                                    add_type_error(ctx, "cannot reexport private function '" + target_name + "'")
                                } else {
                                    push(&mut out, ReExport { module: module, name: name, target: qualify_name(decl.module, decl.name), kind: reexport_kind_func(), vis: imp.vis })
                                }
                                found = true
                            }
                        }
                        if !found {
                            push(&mut pending, PendingReExport { module: module, name: name, target_name: target_name, target_mod: target_mod, vis: imp.vis, file: imp.file, pos: spec.pos })
                        }
                    }
                    j = j + 1
                }
            } else {
                let mut s = 0
                while s < len(structs) {
                    let decl = structs[s]
                    if decl.module == target_mod && visibility_allows(decl.vis, decl.module, module) {
                        let name = decl.name
                        if reexport_list_has_name(out, module, name) {
                            add_type_error(ctx, "duplicate reexport '" + name + "'")
                        } else {
                            let target = qualify_name(decl.module, name)
                            push(&mut out, ReExport { module: module, name: name, target: target, kind: reexport_kind_struct(), vis: imp.vis })
                        }
                    }
                    s = s + 1
                }
                let mut e = 0
                while e < len(enums) {
                    let decl = enums[e]
                    if decl.module == target_mod && visibility_allows(decl.vis, decl.module, module) {
                        let name = decl.name
                        if reexport_list_has_name(out, module, name) {
                            add_type_error(ctx, "duplicate reexport '" + name + "'")
                        } else {
                            let target = qualify_name(decl.module, name)
                            push(&mut out, ReExport { module: module, name: name, target: target, kind: reexport_kind_enum(), vis: imp.vis })
                        }
                    }
                    e = e + 1
                }
                let mut c = 0
                while c < len(consts) {
                    let decl = consts[c]
                    if decl.module == target_mod && visibility_allows(decl.vis, decl.module, module) {
                        let name = decl.name
                        if reexport_list_has_name(out, module, name) {
                            add_type_error(ctx, "duplicate reexport '" + name + "'")
                        } else {
                            let target = qualify_name(decl.module, name)
                            push(&mut out, ReExport { module: module, name: name, target: target, kind: reexport_kind_const(), vis: imp.vis })
                        }
                    }
                    c = c + 1
                }
                let mut f = 0
                while f < len(funcs) {
                    let decl = funcs[f]
                    if decl.module == target_mod && visibility_allows(decl.vis, decl.module, module) {
                        let name = decl.name
                        if reexport_list_has_name(out, module, name) {
                            add_type_error(ctx, "duplicate reexport '" + name + "'")
                        } else {
                            let target = qualify_name(decl.module, name)
                            push(&mut out, ReExport { module: module, name: name, target: target, kind: reexport_kind_func(), vis: imp.vis })
                        }
                    }
                    f = f + 1
                }
            }
        }
        i = i + 1
    }
    let mut p = 0
    while p < len(pending) {
        let pend = pending[p]
        ctx_set_file(ctx, pend.file)
        ctx_set_pos(ctx, pend.pos)
        if reexport_list_has_name(out, pend.module, pend.name) {
            add_type_error(ctx, "duplicate reexport '" + pend.name + "'")
        } else {
            let idx = find_reexport_in_list(out, pend.target_mod, pend.target_name)
            if idx >= 0 {
                let base = out[idx]
                if !visibility_allows(base.vis, base.module, pend.module) {
                    if base.kind == reexport_kind_struct() { add_type_error(ctx, "cannot reexport private struct '" + pend.target_name + "'") }
                    if base.kind == reexport_kind_enum() { add_type_error(ctx, "cannot reexport private enum '" + pend.target_name + "'") }
                    if base.kind == reexport_kind_const() { add_type_error(ctx, "cannot reexport private const '" + pend.target_name + "'") }
                    if base.kind == reexport_kind_func() { add_type_error(ctx, "cannot reexport private function '" + pend.target_name + "'") }
                } else {
                    push(&mut out, ReExport { module: pend.module, name: pend.name, target: base.target, kind: base.kind, vis: pend.vis })
                }
            } else {
                add_type_error(ctx, "reexport '" + pend.target_name + "' not found in module '" + pend.target_mod + "'")
            }
        }
        p = p + 1
    }
    ctx.reexports = out
}

fn type_make(types: &mut TypeTable, kind: i32, name: String, is_ref: bool, is_mut: bool, elem: i32) -> i32 {
    let mut kinds = types.kinds
    let mut names = types.names
    let mut refs = types.refs
    let mut muts = types.muts
    let mut elems = types.elems
    push(&mut kinds, kind)
    push(&mut names, name)
    push(&mut refs, is_ref)
    push(&mut muts, is_mut)
    push(&mut elems, elem)
    let idx = len(kinds) - 1
    types.kinds = kinds
    types.names = names
    types.refs = refs
    types.muts = muts
    types.elems = elems
    return idx
}

fn type_is_ref(types: &TypeTable, t: i32) -> bool {
    if t < 0 || t >= len(types.kinds) {
        return false
    }
    return types.refs[t]
}

fn type_kind(types: &TypeTable, t: i32) -> i32 {
    if t < 0 || t >= len(types.kinds) {
        return 0
    }
    return types.kinds[t]
}

fn type_name(types: &TypeTable, t: i32) -> String {
    if t < 0 || t >= len(types.names) {
        return "invalid"
    }
    return types.names[t]
}

fn type_elem(types: &TypeTable, t: i32) -> i32 {
    if t < 0 || t >= len(types.elems) {
        return -1
    }
    return types.elems[t]
}

fn type_equal(types: &TypeTable, a: i32, b: i32) -> bool {
    if a == 0 || b == 0 {
        return false
    }
    if type_kind(types, a) != type_kind(types, b) {
        return false
    }
    if types.refs[a] != types.refs[b] || types.muts[a] != types.muts[b] {
        return false
    }
    if type_kind(types, a) == 5 || type_kind(types, a) == 6 {
        return type_name(types, a) == type_name(types, b)
    }
    if type_kind(types, a) == 7 {
        return type_equal(types, type_elem(types, a), type_elem(types, b))
    }
    return true
}

fn type_base_equal(types: &TypeTable, a: i32, b: i32) -> bool {
    if a == 0 || b == 0 { return false }
    if type_kind(types, a) != type_kind(types, b) { return false }
    if type_kind(types, a) == 5 || type_kind(types, a) == 6 {
        return type_name(types, a) == type_name(types, b)
    }
    if type_kind(types, a) == 7 {
        return type_base_equal(types, type_elem(types, a), type_elem(types, b))
    }
    return true
}

fn type_assignable(types: &TypeTable, actual: i32, expected: i32) -> bool {
    if type_equal(types, actual, expected) { return true }
    if type_is_ref(types, actual) && type_is_ref(types, expected) && !types.muts[expected] && types.muts[actual] {
        return type_base_equal(types, actual, expected)
    }
    return false
}

fn type_string(types: &TypeTable, t: i32) -> String {
    if t == 0 {
        return "invalid"
    }
    let mut base = ""
    let kind = type_kind(types, t)
    if kind == 1 { base = "int" }
    else if kind == 2 { base = "bool" }
    else if kind == 3 { base = "string" }
    else if kind == 4 { base = "unit" }
    else if kind == 7 {
        let elem = type_elem(types, t)
        base = "[" + type_string(types, elem) + "]"
    } else {
        base = type_name(types, t)
    }
    if types.refs[t] {
        if types.muts[t] {
            return "&mut " + base
        }
        return "&" + base
    }
    return base
}

fn env_new() -> Env {
    let mut names: [String] = []
    let mut types: [i32] = []
    let mut muts: [bool] = []
    let mut scopes: [i32] = []
    return Env { names: names, types: types, muts: muts, scopes: scopes }
}

fn env_push(env: &mut Env) {
    let mut scopes = env.scopes
    let names = env.names
    push(&mut scopes, len(names))
    env.scopes = scopes
}

fn env_pop(env: &mut Env) {
    let mut scopes = env.scopes
    let mut names = env.names
    let mut types = env.types
    let mut muts = env.muts
    if len(scopes) == 0 {
        return
    }
    let idx = scopes[len(scopes)-1]
    pop(&mut scopes)
    while len(names) > idx {
        pop(&mut names)
        pop(&mut types)
        pop(&mut muts)
    }
    env.scopes = scopes
    env.names = names
    env.types = types
    env.muts = muts
}

fn env_declare(env: &mut Env, name: String, typ: i32, mutable: bool) {
    let mut names = env.names
    let mut types = env.types
    let mut muts = env.muts
    push(&mut names, name)
    push(&mut types, typ)
    push(&mut muts, mutable)
    env.names = names
    env.types = types
    env.muts = muts
}

fn env_lookup(env: &Env, name: String) -> VarEntry {
    let mut i = len(env.names) - 1
    while i >= 0 {
        if env.names[i] == name {
            return VarEntry { name: name, typ: env.types[i], mutable: env.muts[i] }
        }
        if i == 0 {
            return VarEntry { name: "", typ: 0, mutable: false }
        }
        i = i - 1
    }
    return VarEntry { name: "", typ: 0, mutable: false }
}

fn add_type_error(ctx: &mut TypeContext, msg: String) {
    let mut errors = ctx.errors
    push(&mut errors, ParseError { pos: ctx.current_pos, file: ctx.current_file, line: 0, col: 0, msg: msg })
    ctx.errors = errors
}

fn ctx_set_pos(ctx: &mut TypeContext, pos: i32) {
    ctx.current_pos = pos
}

fn ctx_set_file(ctx: &mut TypeContext, file: String) {
    ctx.current_file = file
}

fn expr_pos(e: Expr) -> i32 {
    match e {
        Expr.Ident(x) => { return x.pos }
        Expr.IntLit(x) => { return x.pos }
        Expr.StringLit(x) => { return x.pos }
        Expr.BoolLit(x) => { return x.pos }
        Expr.Unary(x) => { return x.pos }
        Expr.Binary(x) => { return x.pos }
        Expr.Call(x) => { return x.pos }
        Expr.MethodCall(x) => { return x.pos }
        Expr.Index(x) => { return x.pos }
        Expr.Field(x) => { return x.pos }
        Expr.StructLit(x) => { return x.pos }
        Expr.ArrayLit(x) => { return x.pos }
        Expr.Ref(x) => { return x.pos }
        Expr.Deref(x) => { return x.pos }
        Expr.IfLet(x) => { return x.pos }
    }
    return 0
}

fn stmt_pos(s: Stmt) -> i32 {
    match s {
        Stmt.Let(x) => { return x.pos }
        Stmt.Return(x) => { return x.pos }
        Stmt.Expr(x) => { return x.pos }
        Stmt.If(x) => { return x.pos }
        Stmt.Assign(x) => { return x.pos }
        Stmt.While(x) => { return x.pos }
        Stmt.Match(x) => { return x.pos }
        Stmt.Break(x) => { return x.pos }
        Stmt.Continue(x) => { return x.pos }
    }
    return 0
}

fn pattern_pos(p: Pattern) -> i32 {
    match p {
        Pattern.Bind(v) => { return v.pos }
        Pattern.Variant(v) => { return v.pos }
        Pattern.Struct(v) => { return v.pos }
        Pattern.Range(v) => { return v.pos }
        Pattern.Literal(v) => { return v.pos }
        _ => { return 0 }
    }
}

fn ctx_type_make(ctx: &mut TypeContext, kind: i32, name: String, is_ref: bool, is_mut: bool, elem: i32) -> i32 {
    let mut types = ctx.types
    let t = type_make(&mut types, kind, name, is_ref, is_mut, elem)
    ctx.types = types
    return t
}

fn ctx_type_for_const_value(ctx: &mut TypeContext, v: ConstValue) -> i32 {
    let mut types = ctx.types
    let t = type_for_const_value(&mut types, v)
    ctx.types = types
    return t
}

fn ctx_parse_type(ctx: &mut TypeContext, text: String, self_name: String) -> i32 {
    let mut types = ctx.types
    let t = parse_type_from_text(&mut types, ctx, text, self_name)
    ctx.types = types
    return t
}

fn ctx_parse_type_in_module(ctx: &mut TypeContext, text: String, self_name: String, module: String) -> i32 {
    let saved_module = ctx.current_module
    let saved_aliases = ctx.module_aliases
    let saved_items = ctx.import_items
    ctx_set_current_module(ctx, module)
    let t = ctx_parse_type(ctx, text, self_name)
    ctx.current_module = saved_module
    ctx.module_aliases = saved_aliases
    ctx.import_items = saved_items
    return t
}

