}

fn is_int(types: &TypeTable, t: i32) -> bool { return type_kind(types, t) == 1 && !type_is_ref(types, t) }
fn is_bool(types: &TypeTable, t: i32) -> bool { return type_kind(types, t) == 2 && !type_is_ref(types, t) }
fn is_string(types: &TypeTable, t: i32) -> bool { return type_kind(types, t) == 3 && !type_is_ref(types, t) }

fn parse_type_from_text(types: &mut TypeTable, ctx: &mut TypeContext, text: String, self_name: String) -> i32 {
    let mut i = 0
    return parse_type_text_inner(types, ctx, text, self_name, &mut i)
}

fn parse_type_text_inner(types: &mut TypeTable, ctx: &mut TypeContext, text: String, self_name: String, idx: &mut i32) -> i32 {
    // skip spaces
    let mut scanning = true
    while *idx < len(text) && scanning {
        if char_at(text, *idx) == 32 {
            *idx = *idx + 1
        } else {
            scanning = false
        }
    }
    let mut is_ref = false
    let mut is_mut = false
    if *idx < len(text) {
        let c = char_at(text, *idx)
        if c == 38 {
            is_ref = true;
            *idx = *idx + 1
            if *idx + 3 < len(text) {
                if substr(text, *idx, 3) == "mut" {
                    is_mut = true;
                    *idx = *idx + 3
                    if *idx < len(text) {
                        if char_at(text, *idx) == 32 {
                            *idx = *idx + 1
                        }
                    }
                }
            }
        }
    }
    if *idx < len(text) {
        let c = char_at(text, *idx)
        if c == 91 {
            *idx = *idx + 1
            let elem = parse_type_text_inner(types, ctx, text, self_name, idx)
            if *idx < len(text) {
                if char_at(text, *idx) == 93 {
                    *idx = *idx + 1
                }
            }
            let t = type_make(types, 7, "", is_ref, is_mut, elem)
            return t
        }
    }
    let mut start = *idx
    scanning = true
    while *idx < len(text) && scanning {
        let c = char_at(text, *idx)
        if c == 32 || c == 93 {
            scanning = false
        } else {
            *idx = *idx + 1
        }
    }
    let mut name = substr(text, start, *idx - start)
    if name == "Self" && self_name != "" {
        name = self_name
    }
    let mut kind = 0
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "i128" ||
       name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "u128" ||
       name == "isize" || name == "usize" || name == "int" || name == "char" {
        kind = 1
    } else if name == "bool" {
        kind = 2
    } else if name == "String" || name == "str" || name == "string" {
        kind = 3
    } else if name == "unit" || name == "()" {
        kind = 4
    } else {
        let resolved = ctx_resolve_type_name(ctx, name, self_name)
        name = resolved
        let structs = ctx.structs
        let enums = ctx.enums
        if find_struct_qname(&structs, name) >= 0 {
            kind = 5
        } else if find_enum_qname(&enums, name) >= 0 {
            kind = 6
        }
    }
    return type_make(types, kind, name, is_ref, is_mut, -1)
}

fn struct_qname(st: StructDecl) -> String {
    return qualify_name(st.module, st.name)
}

fn enum_qname(en: EnumDecl) -> String {
    return qualify_name(en.module, en.name)
}

fn find_struct_qname(structs: & [StructDecl], qname: String) -> i32 {
    let mut i = 0
    while i < len(structs) {
        if struct_qname(structs[i]) == qname {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_struct_in_module(structs: & [StructDecl], module: String, name: String) -> i32 {
    let mut i = 0
    while i < len(structs) {
        if structs[i].module == module && structs[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_enum_qname(enums: & [EnumDecl], qname: String) -> i32 {
    let mut i = 0
    while i < len(enums) {
        if enum_qname(enums[i]) == qname {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_enum_in_module(enums: & [EnumDecl], module: String, name: String) -> i32 {
    let mut i = 0
    while i < len(enums) {
        if enums[i].module == module && enums[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn const_qname(c: ConstSig) -> String {
    return qualify_name(c.module, c.name)
}

fn find_const_qname(consts: & [ConstSig], qname: String) -> i32 {
    let mut i = 0
    while i < len(consts) {
        if const_qname(consts[i]) == qname {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_const_in_module(consts: & [ConstSig], module: String, name: String) -> i32 {
    let mut i = 0
    while i < len(consts) {
        if consts[i].module == module && consts[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_variant(en: EnumDecl, name: String) -> i32 {
    let mut i = 0
    while i < len(en.variants) {
        if en.variants[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_field(st: StructDecl, name: String) -> i32 {
    let mut i = 0
    while i < len(st.fields) {
        if st.fields[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn type_for_const_value(types: &mut TypeTable, v: ConstValue) -> i32 {
    if v.kind == const_kind_int() {
        return type_make(types, 1, "int", false, false, -1)
    }
    if v.kind == const_kind_bool() {
        return type_make(types, 2, "bool", false, false, -1)
    }
    if v.kind == const_kind_string() {
        return type_make(types, 3, "string", false, false, -1)
    }
    return 0
}

fn is_valid_enum_repr(name: String) -> bool {
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "i128" {
        return true
    }
    if name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "u128" {
        return true
    }
    if name == "isize" || name == "usize" {
        return true
    }
    return false
}

fn collect_func_sigs(ctx: &mut TypeContext, prog: Program) {
    let mut i = 0
    while i < len(prog.functions) {
        let f = prog.functions[i]
        ctx_set_file(ctx, f.file)
        ctx_set_pos(ctx, f.pos)
        ctx_set_current_module(ctx, f.module)
        let consts = ctx.consts
        let structs = ctx.structs
        let enums = ctx.enums
        if find_func_in_module(ctx, f.module, f.name) >= 0 {
            add_type_error(ctx, "duplicate function '" + f.name + "'")
        } else if find_const_in_module(&consts, f.module, f.name) >= 0 {
            add_type_error(ctx, "name '" + f.name + "' already used by const")
        } else if find_struct_in_module(&structs, f.module, f.name) >= 0 {
            add_type_error(ctx, "name '" + f.name + "' already used by struct")
        } else if find_enum_in_module(&enums, f.module, f.name) >= 0 {
            add_type_error(ctx, "name '" + f.name + "' already used by enum")
        } else {
            let mut params: [i32] = []
            let mut j = 0
            while j < len(f.params) {
                let p = f.params[j]
                ctx_set_pos(ctx, p.pos)
                let t = ctx_parse_type(ctx, p.typ, "")
                push(&mut params, t)
                j = j + 1
            }
            let mut ret = 0
            let mut explicit = false
            if f.has_return {
                ctx_set_pos(ctx, f.pos)
                ret = ctx_parse_type(ctx, f.ret, "")
                explicit = true
            }
            ctx_push_func(ctx, FuncSig {
                module: f.module,
                vis: f.vis,
                name: f.name,
                params: params,
                ret: ret,
                ret_explicit: explicit,
            })
        }
        i = i + 1
    }
}

fn collect_consts(ctx: &mut TypeContext, prog: Program) {
    let mut i = 0
    while i < len(prog.consts) {
        let c = prog.consts[i]
        ctx_set_file(ctx, c.file)
        ctx_set_pos(ctx, c.pos)
        ctx_set_current_module(ctx, c.module)
        let consts = ctx.consts
        let structs = ctx.structs
        let enums = ctx.enums
        if find_const_in_module(&consts, c.module, c.name) >= 0 {
            add_type_error(ctx, "duplicate const '" + c.name + "'")
        } else {
            if find_struct_in_module(&structs, c.module, c.name) >= 0 {
                add_type_error(ctx, "name '" + c.name + "' already used by struct")
            }
            if find_enum_in_module(&enums, c.module, c.name) >= 0 {
                add_type_error(ctx, "name '" + c.name + "' already used by enum")
            }
            if find_func_in_module(ctx, c.module, c.name) >= 0 {
                add_type_error(ctx, "name '" + c.name + "' already used by function")
            }
            let val_t = ctx_type_for_const_value(ctx, c.value)
            let mut decl_t = val_t
            if c.has_type {
                ctx_set_pos(ctx, c.pos)
                decl_t = ctx_parse_type(ctx, c.typ, "")
                if !ctx_type_equal(ctx, decl_t, val_t) && decl_t != 0 && val_t != 0 {
                    add_type_error(ctx, "const '" + c.name + "' type mismatch")
                }
            }
            ctx_push_const(ctx, ConstSig { module: c.module, vis: c.vis, name: c.name, typ: decl_t })
        }
        i = i + 1
    }
}

fn collect_method_sigs(ctx: &mut TypeContext, prog: Program) {
    let mut i = 0
    while i < len(prog.impls) {
        let imp = prog.impls[i]
        ctx_set_file(ctx, imp.file)
        ctx_set_pos(ctx, imp.pos)
        ctx_set_current_module(ctx, imp.module)
        let type_qname = ctx_resolve_type_name(ctx, imp.type_name, "")
        let mut j = 0
        while j < len(imp.methods) {
            let f = imp.methods[j]
            ctx_set_file(ctx, f.file)
            ctx_set_pos(ctx, f.pos)
            if type_qname != "" {
                if find_method(ctx, type_qname, f.name) >= 0 {
                    add_type_error(ctx, "duplicate method '" + f.name + "' for '" + imp.type_name + "'")
                } else {
                    let mut params: [i32] = []
                    let mut k = 0
                    while k < len(f.params) {
                        let p = f.params[k]
                        if p.name == "self" && k != 0 {
                            ctx_set_pos(ctx, p.pos)
                            add_type_error(ctx, "self must be first parameter")
                        }
                        ctx_set_pos(ctx, p.pos)
                        let t = ctx_parse_type(ctx, p.typ, type_qname)
                        push(&mut params, t)
                        k = k + 1
                    }
                    let mut ret = 0
                    let mut explicit = false
                    if f.has_return {
                        ctx_set_pos(ctx, f.pos)
                        ret = ctx_parse_type(ctx, f.ret, type_qname)
                        explicit = true
                    }
                    let mut has_self = false
                    if len(f.params) > 0 && f.params[0].name == "self" {
                        has_self = true
                    }
                    ctx_push_method(ctx, MethodSig {
                        module: imp.module,
                        vis: f.vis,
                        type_name: type_qname,
                        name: f.name,
                        func_name: type_qname + "." + f.name,
                        params: params,
                        ret: ret,
                        ret_explicit: explicit,
                        has_self: has_self,
                    })
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn func_qname(f: FuncSig) -> String {
    return qualify_name(f.module, f.name)
}

fn find_func_qname(ctx: &TypeContext, qname: String) -> i32 {
    let mut i = 0
    while i < len(ctx.funcs) {
        if func_qname(ctx.funcs[i]) == qname {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_func_in_module(ctx: &TypeContext, module: String, name: String) -> i32 {
    let mut i = 0
    while i < len(ctx.funcs) {
        if ctx.funcs[i].module == module && ctx.funcs[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_func_decl_in_module(funcs: & [FunctionDecl], module: String, name: String) -> i32 {
    let mut i = 0
    while i < len(funcs) {
        if funcs[i].module == module && funcs[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_method(ctx: &TypeContext, type_name: String, name: String) -> i32 {
    let mut i = 0
    while i < len(ctx.methods) {
        let m = ctx.methods[i]
        if m.type_name == type_name && m.name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn builtin_list() -> [String] {
    let mut b: [String] = []
    push(&mut b, "print")
    push(&mut b, "println")
    push(&mut b, "len")
    push(&mut b, "push")
    push(&mut b, "pop")
    push(&mut b, "exit")
    push(&mut b, "read_file")
    push(&mut b, "read_dir")
    push(&mut b, "write_file")
    push(&mut b, "mkdir")
    push(&mut b, "args")
    push(&mut b, "char_at")
    push(&mut b, "substr")
    return b
}

fn is_builtin(ctx: &TypeContext, name: String) -> bool {
    let mut i = 0
    while i < len(ctx.builtins) {
        if ctx.builtins[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn find_import_item(ctx: &TypeContext, name: String) -> i32 {
    let mut i = 0
    while i < len(ctx.import_items) {
        if ctx.import_items[i].local == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn resolve_struct_name(ctx: &mut TypeContext, name: String) -> String {
    let structs = ctx.structs
    if find_struct_in_module(&structs, ctx.current_module, name) >= 0 {
        return qualify_name(ctx.current_module, name)
    }
    let idx = find_import_item(ctx, name)
    if idx >= 0 {
        let item = ctx.import_items[idx]
        let sidx = find_struct_in_module(&structs, item.module, item.name)
        if sidx >= 0 {
            let decl = structs[sidx]
            if visibility_allows(decl.vis, decl.module, ctx.current_module) {
                return qualify_name(decl.module, decl.name)
            }
            add_type_error(ctx, "struct '" + name + "' is private")
            return ""
        }
        let reexp = resolve_reexport(ctx, item.module, item.name, reexport_kind_struct())
        if reexp != "" { return reexp }
        add_type_error(ctx, "imported '" + name + "' is not a struct")
    }
    return ""
}

fn resolve_enum_name(ctx: &mut TypeContext, name: String) -> String {
    let enums = ctx.enums
    if find_enum_in_module(&enums, ctx.current_module, name) >= 0 {
        return qualify_name(ctx.current_module, name)
    }
    let idx = find_import_item(ctx, name)
    if idx >= 0 {
        let item = ctx.import_items[idx]
        let eidx = find_enum_in_module(&enums, item.module, item.name)
        if eidx >= 0 {
            let decl = enums[eidx]
            if visibility_allows(decl.vis, decl.module, ctx.current_module) {
                return qualify_name(decl.module, decl.name)
            }
            add_type_error(ctx, "enum '" + name + "' is private")
            return ""
        }
        let reexp = resolve_reexport(ctx, item.module, item.name, reexport_kind_enum())
        if reexp != "" { return reexp }
        add_type_error(ctx, "imported '" + name + "' is not an enum")
    }
    return ""
}

fn resolve_const_name(ctx: &mut TypeContext, name: String) -> String {
    let consts = ctx.consts
    if find_const_in_module(&consts, ctx.current_module, name) >= 0 {
        return qualify_name(ctx.current_module, name)
    }
    let idx = find_import_item(ctx, name)
    if idx >= 0 {
        let item = ctx.import_items[idx]
        let cidx = find_const_in_module(&consts, item.module, item.name)
        if cidx >= 0 {
            let c = consts[cidx]
            if visibility_allows(c.vis, c.module, ctx.current_module) {
                return qualify_name(c.module, c.name)
            }
            add_type_error(ctx, "const '" + name + "' is private")
            return ""
        }
        let reexp = resolve_reexport(ctx, item.module, item.name, reexport_kind_const())
        if reexp != "" { return reexp }
        add_type_error(ctx, "imported '" + name + "' is not a const")
    }
    return ""
}

fn resolve_func_name(ctx: &mut TypeContext, name: String) -> String {
    if find_func_in_module(ctx, ctx.current_module, name) >= 0 {
        return qualify_name(ctx.current_module, name)
    }
    let idx = find_import_item(ctx, name)
    if idx >= 0 {
        let item = ctx.import_items[idx]
        let fidx = find_func_in_module(ctx, item.module, item.name)
        if fidx >= 0 {
            let f = ctx.funcs[fidx]
            if visibility_allows(f.vis, f.module, ctx.current_module) {
                return qualify_name(f.module, f.name)
            }
            add_type_error(ctx, "function '" + name + "' is private")
            return ""
        }
        let reexp = resolve_reexport(ctx, item.module, item.name, reexport_kind_func())
        if reexp != "" { return reexp }
        add_type_error(ctx, "imported '" + name + "' is not a function")
    }
    return ""
}

fn ctx_resolve_type_name(ctx: &mut TypeContext, name: String, self_name: String) -> String {
    if name == "Self" && self_name != "" {
        return self_name
    }
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "i128" ||
       name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "u128" ||
       name == "isize" || name == "usize" || name == "int" || name == "char" ||
       name == "bool" || name == "String" || name == "str" || name == "string" ||
       name == "unit" || name == "()" {
        return name
    }
    let structs = ctx.structs
    if find_struct_in_module(&structs, ctx.current_module, name) >= 0 {
        return qualify_name(ctx.current_module, name)
    }
    let enums = ctx.enums
    if find_enum_in_module(&enums, ctx.current_module, name) >= 0 {
        return qualify_name(ctx.current_module, name)
    }
    let idx = find_import_item(ctx, name)
    if idx >= 0 {
        let item = ctx.import_items[idx]
        let sidx = find_struct_in_module(&structs, item.module, item.name)
        if sidx >= 0 {
            let decl = structs[sidx]
            if visibility_allows(decl.vis, decl.module, ctx.current_module) {
                return qualify_name(decl.module, decl.name)
            }
            add_type_error(ctx, "struct '" + name + "' is private")
            return name
        }
        let eidx = find_enum_in_module(&enums, item.module, item.name)
        if eidx >= 0 {
            let decl = enums[eidx]
            if visibility_allows(decl.vis, decl.module, ctx.current_module) {
                return qualify_name(decl.module, decl.name)
            }
            add_type_error(ctx, "enum '" + name + "' is private")
            return name
        }
        let re_s = resolve_reexport(ctx, item.module, item.name, reexport_kind_struct())
        if re_s != "" { return re_s }
        let re_e = resolve_reexport(ctx, item.module, item.name, reexport_kind_enum())
        if re_e != "" { return re_e }
        add_type_error(ctx, "imported '" + name + "' is not a type")
        return name
    }
    add_type_error(ctx, "unknown type '" + name + "'")
    return name
}

fn deref_type(types: &mut TypeTable, t: i32) -> i32 {
    if t == 0 { return 0 }
    let kind = type_kind(types, t)
    let name = type_name(types, t)
    let elem = type_elem(types, t)
    return type_make(types, kind, name, false, false, elem)
}

fn block_expr_type(ctx: &mut TypeContext, block: Block) -> i32 {
    let unit = ctx_type_make(ctx, 4, "unit", false, false, -1)
    ctx_env_push(ctx)
    if len(block.stmts) == 0 {
        ctx_env_pop(ctx)
        return unit
    }
    let mut i = 0
    let mut t = unit
    while i < len(block.stmts) {
        if i == len(block.stmts) - 1 {
            match block.stmts[i] {
                Stmt.Expr(e) => { t = check_expr(ctx, e.expr) }
                _ => { check_stmt(ctx, block.stmts[i]); t = unit }
            }
        } else {
            check_stmt(ctx, block.stmts[i])
        }
        i = i + 1
    }
    ctx_env_pop(ctx)
    return t
}

fn check_expr(ctx: &mut TypeContext, expr: Expr) -> i32 {
    ctx_set_pos(ctx, expr_pos(expr))
    match expr {
        Expr.Ident(x) => {
            let v = ctx_env_lookup(ctx, x.name)
            if v.name != "" {
                return v.typ
            }
            let cq = resolve_const_name(ctx, x.name)
            if cq != "" {
                let cidx = ctx_find_const(ctx, cq)
                if cidx >= 0 {
                    return ctx.consts[cidx].typ
                }
            }
            let eq = resolve_enum_name(ctx, x.name)
            if eq != "" {
                return ctx_type_make(ctx, 6, eq, false, false, -1)
            }
            let sq = resolve_struct_name(ctx, x.name)
            if sq != "" {
                return ctx_type_make(ctx, 5, sq, false, false, -1)
            }
            add_type_error(ctx, "undefined variable '" + x.name + "'")
            return 0
        }
        .IntLit(_) => { return ctx_type_make(ctx, 1, "int", false, false, -1) }
        .StringLit(_) => { return ctx_type_make(ctx, 3, "string", false, false, -1) }
        .BoolLit(_) => { return ctx_type_make(ctx, 2, "bool", false, false, -1) }
        .Unary(u) => {
            let t = check_expr(ctx, u.expr)
            if u.op == TokenKind.Minus {
                if !ctx_is_int(ctx, t) && t != 0 {
                    add_type_error(ctx, "unary '-' requires int")
                }
                return ctx_type_make(ctx, 1, "int", false, false, -1)
            }
            if u.op == TokenKind.Bang {
                if !ctx_is_bool(ctx, t) && t != 0 {
                    add_type_error(ctx, "unary '!' requires bool")
                }
                return ctx_type_make(ctx, 2, "bool", false, false, -1)
            }
            return 0
        }
        .Binary(b) => {
            let lt = check_expr(ctx, b.left)
            let rt = check_expr(ctx, b.right)
            if b.op == TokenKind.Plus {
                if ctx_is_int(ctx, lt) && ctx_is_int(ctx, rt) {
                    return ctx_type_make(ctx, 1, "int", false, false, -1)
                }
                if ctx_is_string(ctx, lt) && ctx_is_string(ctx, rt) {
                    return ctx_type_make(ctx, 3, "string", false, false, -1)
                }
                add_type_error(ctx, "'+' requires int or string")
                return 0
            }
            if b.op == TokenKind.Minus || b.op == TokenKind.Star || b.op == TokenKind.Slash || b.op == TokenKind.Percent {
                if !ctx_is_int(ctx, lt) || !ctx_is_int(ctx, rt) {
                    add_type_error(ctx, "arithmetic requires int")
                    return 0
                }
                return ctx_type_make(ctx, 1, "int", false, false, -1)
            }
            if b.op == TokenKind.EqEq || b.op == TokenKind.NotEq {
                if !ctx_type_equal(ctx, lt, rt) && lt != 0 && rt != 0 {
                    add_type_error(ctx, "equality operands must have same type")
                }
                return ctx_type_make(ctx, 2, "bool", false, false, -1)
            }
            if b.op == TokenKind.Lt || b.op == TokenKind.LtEq || b.op == TokenKind.Gt || b.op == TokenKind.GtEq {
                if !ctx_is_int(ctx, lt) || !ctx_is_int(ctx, rt) {
                    add_type_error(ctx, "comparison requires int")
                }
                return ctx_type_make(ctx, 2, "bool", false, false, -1)
            }
            if b.op == TokenKind.AndAnd || b.op == TokenKind.OrOr {
                if !ctx_is_bool(ctx, lt) || !ctx_is_bool(ctx, rt) {
                    add_type_error(ctx, "logical op requires bool")
                }
                return ctx_type_make(ctx, 2, "bool", false, false, -1)
            }
            return 0
        }
        .Ref(r) => {
            match r.expr {
                Expr.Ident(id) => {
                    let v = ctx_env_lookup(ctx, id.name)
                    if v.name == "" {
                        if resolve_const_name(ctx, id.name) != "" {
                            add_type_error(ctx, "cannot take reference to const '" + id.name + "'")
                        } else {
                            add_type_error(ctx, "undefined variable '" + id.name + "'")
                        }
                        return 0
                    }
                    if r.mutable && !v.mutable {
                        add_type_error(ctx, "cannot take &mut of immutable '" + id.name + "'")
                    }
                    let base = v.typ
                    let kind = ctx_type_kind(ctx, base)
                    let name = ctx_type_name(ctx, base)
                    let elem = ctx_type_elem(ctx, base)
                    return ctx_type_make(ctx, kind, name, true, r.mutable, elem)
                }
                _ => {
                    add_type_error(ctx, "reference target must be identifier")
                    return 0
                }
            }
        }
        .Deref(d) => {
            let t = check_expr(ctx, d.expr)
            if !ctx_type_is_ref(ctx, t) {
                add_type_error(ctx, "deref requires reference")
                return 0
            }
            let kind = ctx_type_kind(ctx, t)
            let name = ctx_type_name(ctx, t)
            let elem = ctx_type_elem(ctx, t)
            return ctx_type_make(ctx, kind, name, false, false, elem)
        }
        .ArrayLit(a) => {
            if len(a.elems) == 0 {
                let invalid_elem = 0
                return ctx_type_make(ctx, 7, "", false, false, invalid_elem)
            }
            let elem_t = check_expr(ctx, a.elems[0])
            let mut i = 1
            while i < len(a.elems) {
                let t = check_expr(ctx, a.elems[i])
                if !ctx_type_equal(ctx, t, elem_t) && t != 0 && elem_t != 0 {
                    add_type_error(ctx, "array element type mismatch")
                }
                i = i + 1
            }
            return ctx_type_make(ctx, 7, "", false, false, elem_t)
        }
        Expr.Index(ix) => {
            let recv_t = check_expr(ctx, ix.recv)
            let idx_t = check_expr(ctx, ix.index)
            if !ctx_is_int(ctx, idx_t) && idx_t != 0 {
                add_type_error(ctx, "index requires int")
            }
            let mut base = recv_t
            if ctx_type_is_ref(ctx, base) {
                let kind = ctx_type_kind(ctx, base)
                let name = ctx_type_name(ctx, base)
                let elem = ctx_type_elem(ctx, base)
                base = ctx_type_make(ctx, kind, name, false, false, elem)
            }
            if ctx_type_kind(ctx, base) != 7 {
                add_type_error(ctx, "index requires array")
                return 0
            }
            return ctx_type_elem(ctx, base)
        }
        .StructLit(s) => {
            let qname = resolve_struct_name(ctx, s.name)
            if qname == "" {
                return 0
            }
            let idx = ctx_find_struct(ctx, qname)
            if idx < 0 {
                add_type_error(ctx, "unknown struct '" + s.name + "'")
                return 0
            }
            let decl = ctx.structs[idx]
            let mut seen: [String] = []
            let mut i = 0
            while i < len(s.fields) {
                let f = s.fields[i]
                if find_field(decl, f.name) < 0 {
                    add_type_error(ctx, "unknown field '" + f.name + "'")
                } else {
                    let field = decl.fields[find_field(decl, f.name)]
                    if !visibility_allows(field.vis, decl.module, ctx.current_module) {
                        add_type_error(ctx, "field '" + f.name + "' is private")
                    }
                    let ft = ctx_parse_type_in_module(ctx, field.typ, "", decl.module)
                    let vt = check_expr(ctx, f.value)
                    if !ctx_type_assignable(ctx, vt, ft) && ft != 0 && vt != 0 {
                        add_type_error(ctx, "field type mismatch")
                    }
                }
                push(&mut seen, f.name)
                i = i + 1
            }
            let mut j = 0
            while j < len(decl.fields) {
                let fname = decl.fields[j].name
                let mut found = false
                let mut k = 0
                while k < len(seen) {
                    if seen[k] == fname {
                        found = true
                    }
                    k = k + 1
                }
                if !found {
                    if !visibility_allows(decl.fields[j].vis, decl.module, ctx.current_module) {
                        add_type_error(ctx, "field '" + fname + "' is private")
                    } else {
                        add_type_error(ctx, "missing field '" + fname + "'")
                    }
                }
                j = j + 1
            }
            return ctx_type_make(ctx, 5, qname, false, false, -1)
        }
        .Field(f) => {
            match f.recv {
                Expr.Ident(id) => {
                    if ctx_env_lookup(ctx, id.name).name == "" {
                        let eq = resolve_enum_name(ctx, id.name)
                        if eq != "" {
                            let eidx = ctx_find_enum(ctx, eq)
                            if eidx < 0 { return 0 }
                            let en = ctx.enums[eidx]
                            let vidx = find_variant(en, f.name)
                            if vidx < 0 {
                                add_type_error(ctx, "unknown variant '" + f.name + "'")
                                return 0
                            }
                            if en.variants[vidx].has_payload {
                                add_type_error(ctx, "variant requires payload")
                            }
                            return ctx_type_make(ctx, 6, eq, false, false, -1)
                        }
                    }
                }
                _ => {}
            }
            let recv_t = check_expr(ctx, f.recv)
            let mut base = recv_t
            if ctx_type_is_ref(ctx, base) {
                let kind = ctx_type_kind(ctx, base)
                let name = ctx_type_name(ctx, base)
                let elem = ctx_type_elem(ctx, base)
                base = ctx_type_make(ctx, kind, name, false, false, elem)
            }
            if ctx_type_kind(ctx, base) != 5 {
                add_type_error(ctx, "field access requires struct")
                return 0
            }
            let sidx = ctx_find_struct(ctx, ctx_type_name(ctx, base))
            if sidx < 0 {
                add_type_error(ctx, "unknown struct")
                return 0
            }
            let decl = ctx.structs[sidx]
            let find = find_field(decl, f.name)
            if find < 0 {
                add_type_error(ctx, "unknown field '" + f.name + "'")
                return 0
            }
            if !visibility_allows(decl.fields[find].vis, decl.module, ctx.current_module) {
                add_type_error(ctx, "field '" + f.name + "' is private")
            }
            let ft = ctx_parse_type_in_module(ctx, decl.fields[find].typ, "", decl.module)
            return ft
        }
        Expr.Call(c) => {
            match c.callee {
                Expr.Ident(id) => {
                    let fq = resolve_func_name(ctx, id.name)
                    if fq != "" {
                        let fidx = find_func_qname(ctx, fq)
                        if fidx >= 0 {
                            let sig = ctx.funcs[fidx]
                            if len(c.args) != len(sig.params) {
                                add_type_error(ctx, "argument count mismatch")
                            }
                            let mut i = 0
                            while i < len(c.args) && i < len(sig.params) {
                                let at = check_expr(ctx, c.args[i])
                                if !ctx_type_assignable(ctx, at, sig.params[i]) && at != 0 && sig.params[i] != 0 {
                                    add_type_error(ctx, "argument type mismatch")
                                }
                                i = i + 1
                            }
                            return sig.ret
                        }
                    }
                    if is_builtin(ctx, id.name) {
                        if id.name == "len" {
                            if len(c.args) != 1 {
                                add_type_error(ctx, "len expects 1 argument")
                            } else {
                                let mut at = check_expr(ctx, c.args[0])
                                if ctx_type_is_ref(ctx, at) {
                                    at = ctx_deref_type(ctx, at)
                                }
                                if ctx_type_kind(ctx, at) != 3 && ctx_type_kind(ctx, at) != 7 && at != 0 {
                                    add_type_error(ctx, "len expects string or array")
                                }
                            }
                            return ctx_type_make(ctx, 1, "int", false, false, -1)
                        }
                        if id.name == "char_at" {
                            if len(c.args) != 2 {
                                add_type_error(ctx, "char_at expects 2 arguments")
                            } else {
                                let st = check_expr(ctx, c.args[0])
                                let it = check_expr(ctx, c.args[1])
                                if !ctx_is_string(ctx, st) && st != 0 {
                                    add_type_error(ctx, "char_at expects string")
                                }
                                if !ctx_is_int(ctx, it) && it != 0 {
                                    add_type_error(ctx, "char_at expects int index")
                                }
                            }
                            return ctx_type_make(ctx, 1, "int", false, false, -1)
                        }
                        if id.name == "substr" {
                            if len(c.args) != 3 {
                                add_type_error(ctx, "substr expects 3 arguments")
                            } else {
                                let st = check_expr(ctx, c.args[0])
                                let it = check_expr(ctx, c.args[1])
                                let lt = check_expr(ctx, c.args[2])
                                if !ctx_is_string(ctx, st) && st != 0 {
                                    add_type_error(ctx, "substr expects string")
                                }
                                if !ctx_is_int(ctx, it) && it != 0 {
                                    add_type_error(ctx, "substr expects int start")
                                }
                                if !ctx_is_int(ctx, lt) && lt != 0 {
                                    add_type_error(ctx, "substr expects int length")
                                }
                            }
                            return ctx_type_make(ctx, 3, "string", false, false, -1)
                        }
                        if id.name == "read_file" {
                            if len(c.args) != 1 {
                                add_type_error(ctx, "read_file expects 1 argument")
                            } else {
                                let pt = check_expr(ctx, c.args[0])
                                if !ctx_is_string(ctx, pt) && pt != 0 {
                                    add_type_error(ctx, "read_file expects string path")
                                }
                            }
                            return ctx_type_make(ctx, 3, "string", false, false, -1)
                        }
                        if id.name == "read_dir" {
                            if len(c.args) != 1 {
                                add_type_error(ctx, "read_dir expects 1 argument")
                            } else {
                                let pt = check_expr(ctx, c.args[0])
                                if !ctx_is_string(ctx, pt) && pt != 0 {
                                    add_type_error(ctx, "read_dir expects string path")
                                }
                            }
                            let elem = ctx_type_make(ctx, 3, "string", false, false, -1)
                            return ctx_type_make(ctx, 7, "", false, false, elem)
                        }
                        if id.name == "write_file" {
                            if len(c.args) != 2 {
                                add_type_error(ctx, "write_file expects 2 arguments")
                            } else {
                                let pt = check_expr(ctx, c.args[0])
                                let dt = check_expr(ctx, c.args[1])
                                if !ctx_is_string(ctx, pt) && pt != 0 {
                                    add_type_error(ctx, "write_file expects string path")
                                }
                                if !ctx_is_string(ctx, dt) && dt != 0 {
                                    add_type_error(ctx, "write_file expects string data")
                                }
                            }
                            return ctx_type_make(ctx, 4, "unit", false, false, -1)
                        }
                        if id.name == "mkdir" {
                            if len(c.args) != 1 {
                                add_type_error(ctx, "mkdir expects 1 argument")
                            } else {
                                let pt = check_expr(ctx, c.args[0])
                                if !ctx_is_string(ctx, pt) && pt != 0 {
                                    add_type_error(ctx, "mkdir expects string path")
                                }
                            }
                            return ctx_type_make(ctx, 4, "unit", false, false, -1)
                        }
                        if id.name == "args" {
                            if len(c.args) != 0 {
                                add_type_error(ctx, "args expects no arguments")
                            }
                            let elem = ctx_type_make(ctx, 3, "string", false, false, -1)
                            return ctx_type_make(ctx, 7, "", false, false, elem)
                        }
                        if id.name == "push" {
                            if len(c.args) != 2 {
                                add_type_error(ctx, "push expects 2 arguments")
                                return ctx_type_make(ctx, 4, "unit", false, false, -1)
                            }
                            let t0 = check_expr(ctx, c.args[0])
                            if !ctx_type_is_ref(ctx, t0) || !ctx.types.muts[t0] {
                                add_type_error(ctx, "push expects &mut array")
                                return ctx_type_make(ctx, 4, "unit", false, false, -1)
                            }
                            let base = ctx_deref_type(ctx, t0)
                            if ctx_type_kind(ctx, base) != 7 {
                                add_type_error(ctx, "push expects &mut [T]")
                                return ctx_type_make(ctx, 4, "unit", false, false, -1)
                            }
                            let vt = check_expr(ctx, c.args[1])
                            let elem = ctx_type_elem(ctx, base)
                            if !ctx_type_assignable(ctx, vt, elem) && vt != 0 && elem != 0 {
                                add_type_error(ctx, "push expects element type")
                            }
                            return ctx_type_make(ctx, 4, "unit", false, false, -1)
                        }
                        if id.name == "pop" {
                            if len(c.args) != 1 {
                                add_type_error(ctx, "pop expects 1 argument")
                                return 0
                            }
                            let t0 = check_expr(ctx, c.args[0])
                            if !ctx_type_is_ref(ctx, t0) || !ctx.types.muts[t0] {
                                add_type_error(ctx, "pop expects &mut array")
                                return 0
                            }
                            let base = ctx_deref_type(ctx, t0)
                            if ctx_type_kind(ctx, base) != 7 {
                                add_type_error(ctx, "pop expects &mut [T]")
                                return 0
                            }
                            return ctx_type_elem(ctx, base)
                        }
                        return ctx_type_make(ctx, 4, "unit", false, false, -1)
                    }
                    add_type_error(ctx, "undefined function '" + id.name + "'")
                    return 0
                }
                .Field(f) => {
                    match f.recv {
                        Expr.Ident(id) => {
                            let eq = resolve_enum_name(ctx, id.name)
                            if eq != "" {
                                let eidx = ctx_find_enum(ctx, eq)
                                if eidx < 0 { return 0 }
                                let en = ctx.enums[eidx]
                                let vidx = find_variant(en, f.name)
                                if vidx < 0 {
                                    add_type_error(ctx, "unknown variant '" + f.name + "'")
                                    return 0
                                }
                                if en.variants[vidx].has_payload {
                                    if len(c.args) != 1 {
                                        add_type_error(ctx, "variant expects payload")
                                    } else {
                                        let payload_t = ctx_parse_type_in_module(ctx, en.variants[vidx].payload, "", en.module)
                                        let at = check_expr(ctx, c.args[0])
                                        if !ctx_type_assignable(ctx, at, payload_t) && at != 0 && payload_t != 0 {
                                            add_type_error(ctx, "variant payload type mismatch")
                                        }
                                    }
                                } else if len(c.args) != 0 {
                                    add_type_error(ctx, "variant has no payload")
                                }
                                return ctx_type_make(ctx, 6, eq, false, false, -1)
                            }
                        }
                        _ => {}
                    }
                    add_type_error(ctx, "can only call identifiers or enum variants")
                    return 0
                }
                _ => {
                    add_type_error(ctx, "can only call identifiers or enum variants")
                    return 0
                }
            }
        }
        .MethodCall(m) => {
            match m.recv {
                Expr.Ident(id) => {
                    if ctx_env_lookup(ctx, id.name).name == "" {
                        let alias_mod = module_alias_module(ctx, id.name)
                        if alias_mod != "" {
                            let mod_name = module_strip_root(alias_mod)
                            let fidx = find_func_in_module(ctx, mod_name, m.method)
                            if fidx >= 0 {
                                let sig = ctx.funcs[fidx]
                                if !visibility_allows(sig.vis, sig.module, ctx.current_module) {
                                    add_type_error(ctx, "function '" + m.method + "' is private")
                                    return sig.ret
                                }
                                if len(m.args) != len(sig.params) {
                                    add_type_error(ctx, "function argument count mismatch")
                                }
                                let mut i = 0
                                while i < len(m.args) && i < len(sig.params) {
                                    let at = check_expr(ctx, m.args[i])
                                    if !ctx_type_assignable(ctx, at, sig.params[i]) && at != 0 && sig.params[i] != 0 {
                                        add_type_error(ctx, "function argument type mismatch")
                                    }
                                    i = i + 1
                                }
                                return sig.ret
                            }
                            let rq = resolve_reexport(ctx, alias_mod, m.method, reexport_kind_func())
                            if rq != "" {
                                let fidx2 = find_func_qname(ctx, rq)
                                if fidx2 >= 0 {
                                    let sig2 = ctx.funcs[fidx2]
                                    if len(m.args) != len(sig2.params) {
                                        add_type_error(ctx, "function argument count mismatch")
                                    }
                                    let mut i2 = 0
                                    while i2 < len(m.args) && i2 < len(sig2.params) {
                                        let at2 = check_expr(ctx, m.args[i2])
                                        if !ctx_type_assignable(ctx, at2, sig2.params[i2]) && at2 != 0 && sig2.params[i2] != 0 {
                                            add_type_error(ctx, "function argument type mismatch")
                                        }
                                        i2 = i2 + 1
                                    }
                                    return sig2.ret
                                }
                            }
                        }
                        let eq = resolve_enum_name(ctx, id.name)
                        if eq != "" {
                            let eidx = ctx_find_enum(ctx, eq)
                            if eidx >= 0 {
                                let en = ctx.enums[eidx]
                                let vidx = find_variant(en, m.method)
                                if vidx >= 0 {
                                    if en.variants[vidx].has_payload {
                                        if len(m.args) != 1 {
                                            add_type_error(ctx, "variant expects payload")
                                        } else {
                                            let payload_t = ctx_parse_type_in_module(ctx, en.variants[vidx].payload, "", en.module)
                                            let at = check_expr(ctx, m.args[0])
                                            if !ctx_type_assignable(ctx, at, payload_t) && at != 0 && payload_t != 0 {
                                                add_type_error(ctx, "variant payload type mismatch")
                                            }
                                        }
                                    } else if len(m.args) != 0 {
                                        add_type_error(ctx, "variant has no payload")
                                    }
                                    return ctx_type_make(ctx, 6, eq, false, false, -1)
                                }
                            }
                        }
                        let mut type_q = eq
                        if type_q == "" {
                            type_q = resolve_struct_name(ctx, id.name)
                        }
                        if type_q != "" {
                            let midx = find_method(ctx, type_q, m.method)
                            if midx >= 0 {
                                let sig = ctx.methods[midx]
                                if !visibility_allows(sig.vis, sig.module, ctx.current_module) {
                                    add_type_error(ctx, "method '" + m.method + "' is private")
                                    return sig.ret
                                }
                                if sig.has_self {
                                    add_type_error(ctx, "static call to method that requires self")
                                }
                                if len(m.args) != len(sig.params) {
                                    add_type_error(ctx, "method argument count mismatch")
                                }
                                let mut i = 0
                                while i < len(m.args) && i < len(sig.params) {
                                    let at = check_expr(ctx, m.args[i])
                                    if !ctx_type_assignable(ctx, at, sig.params[i]) && at != 0 && sig.params[i] != 0 {
                                        add_type_error(ctx, "method argument type mismatch")
                                    }
                                    i = i + 1
                                }
                                return sig.ret
                            }
                        }
                    }
                }
                _ => {}
            }
            let recv_t = check_expr(ctx, m.recv)
            let mut base = recv_t
            if ctx_type_is_ref(ctx, base) {
                let kind = ctx_type_kind(ctx, base)
                let name = ctx_type_name(ctx, base)
                let elem = ctx_type_elem(ctx, base)
                base = ctx_type_make(ctx, kind, name, false, false, elem)
            }
            if ctx_type_kind(ctx, base) != 5 && ctx_type_kind(ctx, base) != 6 {
                if base != 0 {
                    add_type_error(ctx, "method call requires struct or enum receiver")
                }
                return 0
            }
            let midx = find_method(ctx, ctx_type_name(ctx, base), m.method)
            if midx < 0 {
                add_type_error(ctx, "unknown method '" + m.method + "'")
                return 0
            }
            let sig = ctx.methods[midx]
            if !visibility_allows(sig.vis, sig.module, ctx.current_module) {
                add_type_error(ctx, "method '" + m.method + "' is private")
                return sig.ret
            }
            if !sig.has_self {
                add_type_error(ctx, "method requires no self; call as Type.method()")
                return sig.ret
            }
            if len(sig.params) == 0 || !ctx_type_assignable(ctx, recv_t, sig.params[0]) {
                add_type_error(ctx, "receiver type mismatch")
            }
            let expected = len(sig.params) - 1
            if len(m.args) != expected {
                add_type_error(ctx, "method argument count mismatch")
            }
            let mut i = 0
            while i < len(m.args) && i + 1 < len(sig.params) {
                let at = check_expr(ctx, m.args[i])
                if !ctx_type_assignable(ctx, at, sig.params[i + 1]) && at != 0 && sig.params[i + 1] != 0 {
                    add_type_error(ctx, "method argument type mismatch")
                }
                i = i + 1
            }
            return sig.ret
        }
        Expr.IfLet(x) => {
            let scrut = check_expr(ctx, x.expr)
            let mut scrut_name = ""
            let mut scrut_kind = 0
            if scrut != 0 {
                scrut_kind = ctx_type_kind(ctx, scrut)
                if scrut_kind == 6 || scrut_kind == 5 {
                    scrut_name = ctx_type_name(ctx, scrut)
                } else if scrut_kind != 1 && scrut_kind != 2 && scrut_kind != 3 && scrut_kind != 5 {
                    add_type_error(ctx, "if let requires enum, struct, int, bool, or string expression")
                }
            }
            ctx_env_push(ctx)
            check_pattern(ctx, x.pattern, scrut, scrut_name)
            let then_t = block_expr_type(ctx, x.then_block)
            ctx_env_pop(ctx)
            let unit = ctx_type_make(ctx, 4, "unit", false, false, -1)
            if !x.has_else {
                return unit
            }
            let else_t = block_expr_type(ctx, x.else_block)
            if !ctx_type_assignable(ctx, then_t, else_t) && !ctx_type_assignable(ctx, else_t, then_t) && then_t != 0 && else_t != 0 {
                add_type_error(ctx, "if let branch type mismatch")
            }
            if then_t != 0 { return then_t }
            return else_t
        }
    }
}

fn check_assign(ctx: &mut TypeContext, target: Expr, value: Expr) {
    match target {
        Expr.Ident(id) => {
            let v = ctx_env_lookup(ctx, id.name)
            if v.name == "" {
                if resolve_const_name(ctx, id.name) != "" {
                    add_type_error(ctx, "cannot assign to const '" + id.name + "'")
                } else {
                    add_type_error(ctx, "undefined variable '" + id.name + "'")
                }
                return
            }
            if !v.mutable {
                add_type_error(ctx, "cannot assign to immutable '" + id.name + "'")
            }
            let vt = check_expr(ctx, value)
            if !ctx_type_assignable(ctx, vt, v.typ) && vt != 0 && v.typ != 0 {
                add_type_error(ctx, "assignment type mismatch")
            }
        }
        .Deref(d) => {
            let rt = check_expr(ctx, d.expr)
            if !ctx_type_is_ref(ctx, rt) {
                add_type_error(ctx, "assignment requires mutable reference")
                return
            }
            if !ctx.types.muts[rt] {
                add_type_error(ctx, "assignment through & requires &mut")
            }
            let base = ctx_deref_type(ctx, rt)
            let vt = check_expr(ctx, value)
            if !ctx_type_assignable(ctx, vt, base) && vt != 0 && base != 0 {
                add_type_error(ctx, "assignment type mismatch")
            }
        }
        Expr.Index(ix) => {
            let recv_t = check_expr(ctx, ix.recv)
            let idx_t = check_expr(ctx, ix.index)
            if !ctx_is_int(ctx, idx_t) && idx_t != 0 {
                add_type_error(ctx, "index requires int")
            }
            let mut base = recv_t
            if ctx_type_is_ref(ctx, base) {
                if !ctx.types.muts[base] {
                    add_type_error(ctx, "assignment through & requires &mut")
                }
                let kind = ctx_type_kind(ctx, base)
                let name = ctx_type_name(ctx, base)
                let elem = ctx_type_elem(ctx, base)
                base = ctx_type_make(ctx, kind, name, false, false, elem)
            }
            if ctx_type_kind(ctx, base) != 7 {
                add_type_error(ctx, "index assignment requires array")
                return
            }
            let vt = check_expr(ctx, value)
            let elem = ctx_type_elem(ctx, base)
            if !ctx_type_assignable(ctx, vt, elem) && vt != 0 && elem != 0 {
                add_type_error(ctx, "index assignment type mismatch")
            }
        }
        .Field(f) => {
            let recv_t = check_expr(ctx, f.recv)
            let mut base = recv_t
            if ctx_type_is_ref(ctx, base) {
                if !ctx.types.muts[base] {
                    add_type_error(ctx, "assignment through & requires &mut")
                }
                let kind = ctx_type_kind(ctx, base)
                let name = ctx_type_name(ctx, base)
                let elem = ctx_type_elem(ctx, base)
                base = ctx_type_make(ctx, kind, name, false, false, elem)
            } else {
                match f.recv {
                    Expr.Ident(id) => {
                        let v = ctx_env_lookup(ctx, id.name)
                        if v.name != "" && !v.mutable {
                            add_type_error(ctx, "cannot assign through immutable '" + id.name + "'")
                        }
                    }
                    _ => {}
                }
            }
            if ctx_type_kind(ctx, base) != 5 {
                if base != 0 {
                    add_type_error(ctx, "field assignment requires struct")
                }
                return
            }
            let sidx = ctx_find_struct(ctx, ctx_type_name(ctx, base))
            if sidx < 0 {
                add_type_error(ctx, "unknown struct")
                return
            }
            let decl = ctx.structs[sidx]
            let find = find_field(decl, f.name)
            if find < 0 {
                add_type_error(ctx, "unknown field '" + f.name + "'")
                return
            }
            if !visibility_allows(decl.fields[find].vis, decl.module, ctx.current_module) {
                add_type_error(ctx, "field '" + f.name + "' is private")
            }
            let ft = ctx_parse_type_in_module(ctx, decl.fields[find].typ, "", decl.module)
            let vt = check_expr(ctx, value)
            if !ctx_type_assignable(ctx, vt, ft) && vt != 0 && ft != 0 {
                add_type_error(ctx, "field assignment type mismatch")
            }
        }
        _ => {
            add_type_error(ctx, "invalid assignment target")
        }
    }
}

fn check_stmt(ctx: &mut TypeContext, stmt: Stmt) {
    ctx_set_pos(ctx, stmt_pos(stmt))
    match stmt {
        Stmt.Let(s) => {
            if !s.has_init {
                add_type_error(ctx, "let requires initializer")
                return
            }
            let init_t = check_expr(ctx, s.init)
            let mut decl_t = init_t
            if s.has_type {
                decl_t = ctx_parse_type(ctx, s.typ, "")
                match s.init {
                    .ArrayLit(a) => {
                        if len(a.elems) == 0 && ctx_type_kind(ctx, decl_t) == 7 {
                            // allow empty array with explicit type
                        } else if !ctx_type_assignable(ctx, init_t, decl_t) && init_t != 0 && decl_t != 0 {
                            add_type_error(ctx, "cannot assign " + ctx_type_string(ctx, init_t) + " to " + ctx_type_string(ctx, decl_t))
                        }
                    }
                    _ => {
                        if !ctx_type_assignable(ctx, init_t, decl_t) && init_t != 0 && decl_t != 0 {
                            add_type_error(ctx, "cannot assign " + ctx_type_string(ctx, init_t) + " to " + ctx_type_string(ctx, decl_t))
                        }
                    }
                }
            }
            ctx_env_declare(ctx, s.name, decl_t, s.mutable)
        }
        Stmt.Return(r) => {
            if ctx.current_ret_explicit {
                if !r.has_value {
                    if ctx.current_ret != 0 && ctx_type_kind(ctx, ctx.current_ret) != 4 {
                        add_type_error(ctx, "returning unit from non-unit function")
                    }
                    return
                }
                let vt = check_expr(ctx, r.value)
                if ctx_type_kind(ctx, ctx.current_ret) == 4 {
                    if vt != 0 && ctx_type_kind(ctx, vt) != 4 {
                        add_type_error(ctx, "returning value from unit function")
                    }
                    return
                }
                if !ctx_type_assignable(ctx, vt, ctx.current_ret) && vt != 0 && ctx.current_ret != 0 {
                    add_type_error(ctx, "return type mismatch")
                }
                return
            }
            if !r.has_value {
                ctx.has_bare_return = true
                return
            }
            let vt = check_expr(ctx, r.value)
            if vt == 0 { return }
            if !ctx.has_return {
                ctx.inferred_type = vt
                ctx.has_return = true
                return
            }
            if !ctx_type_assignable(ctx, vt, ctx.inferred_type) {
                add_type_error(ctx, "return type mismatch")
            }
        }
        .Expr(e) => {
            check_expr(ctx, e.expr)
        }
        Stmt.Assign(a) => {
            check_assign(ctx, a.target, a.value)
        }
        Stmt.If(s) => {
            let ct = check_expr(ctx, s.cond)
            if !ctx_is_bool(ctx, ct) && ct != 0 {
                add_type_error(ctx, "if condition must be bool")
            }
            check_block(ctx, s.then_block)
            if s.has_else {
                check_block(ctx, s.else_block)
            }
        }
        Stmt.While(s) => {
            let ct = check_expr(ctx, s.cond)
            if !ctx_is_bool(ctx, ct) && ct != 0 {
                add_type_error(ctx, "while condition must be bool")
            }
            ctx.loop_depth = ctx.loop_depth + 1
            check_block(ctx, s.body)
            ctx.loop_depth = ctx.loop_depth - 1
        }
        Stmt.Match(m) => {
            check_match(ctx, m)
        }
        Stmt.Break(_) => {
            if ctx.loop_depth <= 0 {
                add_type_error(ctx, "break outside loop")
            }
        }
        Stmt.Continue(_) => {
            if ctx.loop_depth <= 0 {
                add_type_error(ctx, "continue outside loop")
            }
        }
    }
    return
}

fn check_block(ctx: &mut TypeContext, block: Block) {
    ctx_env_push(ctx)
    let mut i = 0
    while i < len(block.stmts) {
        check_stmt(ctx, block.stmts[i])
        i = i + 1
    }
    ctx_env_pop(ctx)
}

fn check_tail_block(ctx: &mut TypeContext, block: Block, allow_implicit: bool) {
    if !allow_implicit {
        check_block(ctx, block)
        return
    }
    ctx_env_push(ctx)
    let mut i = 0
    while i < len(block.stmts) {
        if i == len(block.stmts) - 1 {
            check_tail_stmt(ctx, block.stmts[i], allow_implicit)
        } else {
            check_stmt(ctx, block.stmts[i])
        }
        i = i + 1
    }
    ctx_env_pop(ctx)
}

fn check_tail_stmt(ctx: &mut TypeContext, stmt: Stmt, allow_implicit: bool) {
    ctx_set_pos(ctx, stmt_pos(stmt))
    match stmt {
        .Expr(e) => {
            let r = ReturnStmt { pos: e.pos, has_value: true, value: e.expr }
            check_stmt(ctx, Stmt.Return(r))
        }
        Stmt.Return(r) => { check_stmt(ctx, Stmt.Return(r)) }
        Stmt.If(s) => { check_tail_if(ctx, s, allow_implicit) }
        Stmt.Match(m) => { check_tail_match(ctx, m, allow_implicit) }
        _ => { check_stmt(ctx, stmt) }
    }
}

fn check_tail_if(ctx: &mut TypeContext, s: IfStmt, allow_implicit: bool) {
    ctx_set_pos(ctx, s.pos)
    let ct = check_expr(ctx, s.cond)
    if !ctx_is_bool(ctx, ct) && ct != 0 {
        add_type_error(ctx, "if condition must be bool")
    }
    if !s.has_else {
        check_block(ctx, s.then_block)
        if allow_implicit && ctx.current_ret_explicit && ctx_type_kind(ctx, ctx.current_ret) != 4 {
            add_type_error(ctx, "tail if requires else to return value")
        }
        return
    }
    check_tail_block(ctx, s.then_block, allow_implicit)
    check_tail_block(ctx, s.else_block, allow_implicit)
}

fn check_pattern(ctx: &mut TypeContext, pat: Pattern, scrut_type: i32, scrut_name: String) {
    let kind = ctx_type_kind(ctx, scrut_type)
    match pat {
        .Wildcard(_) => {}
        .Bind(bp) => {
            ctx_set_pos(ctx, bp.pos)
            if bp.name != "" {
                ctx_env_declare(ctx, bp.name, scrut_type, false)
            }
        }
        .Literal(lp) => {
            ctx_set_pos(ctx, lp.pos)
            if kind != 1 && kind != 2 && kind != 3 {
                add_type_error(ctx, "literal pattern requires int, bool, or string expression")
            } else {
                let pt = ctx_type_for_const_value(ctx, lp.value)
                if pt != 0 && ctx_type_kind(ctx, pt) != kind {
                    add_type_error(ctx, "pattern type mismatch")
                }
            }
        }
        .Range(rp) => {
            ctx_set_pos(ctx, rp.pos)
            if kind != 1 {
                add_type_error(ctx, "range pattern requires int expression")
            }
            if rp.start.kind != const_kind_int() || rp.end.kind != const_kind_int() {
                add_type_error(ctx, "range bounds must be int literals")
            }
        }
        .Variant(vp) => {
            ctx_set_pos(ctx, vp.pos)
            if kind != 6 {
                add_type_error(ctx, "enum pattern requires enum expression")
                return
            }
            let mut pat_enum = vp.enum_name
            if pat_enum == "" {
                pat_enum = scrut_name
            } else {
                pat_enum = resolve_enum_name(ctx, pat_enum)
            }
            if pat_enum == "" {
                add_type_error(ctx, "cannot resolve enum for pattern")
                return
            }
            if pat_enum != scrut_name {
                add_type_error(ctx, "enum pattern requires matching enum type")
                return
            }
            let eidx = ctx_find_enum(ctx, pat_enum)
            if eidx < 0 {
                add_type_error(ctx, "unknown enum '" + pat_enum + "'")
                return
            }
            let decl = ctx.enums[eidx]
            let vidx = find_variant(decl, vp.variant)
            if vidx < 0 {
                add_type_error(ctx, "unknown variant '" + vp.variant + "'")
                return
            }
            if vp.has_binding {
                if !decl.variants[vidx].has_payload {
                    add_type_error(ctx, "variant has no payload to bind")
                } else {
                    let pt = ctx_parse_type_in_module(ctx, decl.variants[vidx].payload, "", decl.module)
                    ctx_env_declare(ctx, vp.binding, pt, false)
                }
            }
        }
        Pattern.Struct(sp) => {
            ctx_set_pos(ctx, sp.pos)
            if kind != 5 {
                add_type_error(ctx, "struct pattern requires struct expression")
                return
            }
            let mut pat_struct = resolve_struct_name(ctx, sp.name)
            if pat_struct == "" { pat_struct = sp.name }
            if pat_struct == "" {
                add_type_error(ctx, "cannot resolve struct for pattern")
                return
            }
            if scrut_name != "" && pat_struct != scrut_name {
                add_type_error(ctx, "struct pattern requires matching struct type")
                return
            }
            let sidx = ctx_find_struct(ctx, pat_struct)
            if sidx < 0 {
                add_type_error(ctx, "unknown struct '" + pat_struct + "'")
                return
            }
            let decl = ctx.structs[sidx]
            let mut seen: [String] = []
            let mut i = 0
            while i < len(sp.fields) {
                let f = sp.fields[i]
                ctx_set_pos(ctx, f.pos)
                if name_list_contains(seen, f.name) {
                    add_type_error(ctx, "duplicate field '" + f.name + "' in pattern")
                } else {
                    let fidx = find_field(decl, f.name)
                    if fidx < 0 {
                        add_type_error(ctx, "unknown field '" + f.name + "'")
                    } else {
                        push(&mut seen, f.name)
                        let field = decl.fields[fidx]
                        let ft = ctx_parse_type_in_module(ctx, field.typ, "", decl.module)
                        if f.bind {
                            ctx_env_declare(ctx, f.name, ft, false)
                        } else if f.has_pattern {
                            let mut field_name = ""
                            let field_kind = ctx_type_kind(ctx, ft)
                            if field_kind == 5 || field_kind == 6 {
                                field_name = ctx_type_name(ctx, ft)
                            }
                            check_pattern(ctx, f.pattern, ft, field_name)
                        }
                    }
                }
                i = i + 1
            }
            if !sp.has_rest {
                let mut j = 0
                while j < len(decl.fields) {
                    let fname = decl.fields[j].name
                    let mut found = false
                    let mut k = 0
                    while k < len(seen) {
                        if seen[k] == fname {
                            found = true
                        }
                        k = k + 1
                    }
                    if !found {
                        add_type_error(ctx, "missing field '" + fname + "' in pattern")
                    }
                    j = j + 1
                }
            }
        }
    }
}

fn check_match(ctx: &mut TypeContext, m: MatchStmt) {
    ctx_set_pos(ctx, m.pos)
    let scrut = check_expr(ctx, m.expr)
    let mut scrut_name = ""
    let mut scrut_kind = 0
    if scrut != 0 {
        scrut_kind = ctx_type_kind(ctx, scrut)
        if scrut_kind == 6 || scrut_kind == 5 {
            scrut_name = ctx_type_name(ctx, scrut)
        } else if scrut_kind != 1 && scrut_kind != 2 && scrut_kind != 3 && scrut_kind != 5 {
            add_type_error(ctx, "match requires enum, struct, int, bool, or string expression")
        }
    }
    let mut i = 0
    while i < len(m.arms) {
        ctx_env_push(ctx)
        let pat = m.arms[i].pattern
        check_pattern(ctx, pat, scrut, scrut_name)
        if m.arms[i].has_guard {
            let gp = expr_pos(m.arms[i].guard)
            if gp != 0 { ctx_set_pos(ctx, gp) }
            let gt = check_expr(ctx, m.arms[i].guard)
            if !ctx_is_bool(ctx, gt) && gt != 0 {
                add_type_error(ctx, "match guard must be bool")
            }
        }
        check_block(ctx, m.arms[i].body)
        ctx_env_pop(ctx)
        i = i + 1
    }
}

fn check_tail_match(ctx: &mut TypeContext, m: MatchStmt, allow_implicit: bool) {
    ctx_set_pos(ctx, m.pos)
    let scrut = check_expr(ctx, m.expr)
    let mut scrut_name = ""
    let mut scrut_kind = 0
    if scrut != 0 {
        scrut_kind = ctx_type_kind(ctx, scrut)
        if scrut_kind == 6 || scrut_kind == 5 {
            scrut_name = ctx_type_name(ctx, scrut)
        } else if scrut_kind != 1 && scrut_kind != 2 && scrut_kind != 3 && scrut_kind != 5 {
            add_type_error(ctx, "match requires enum, struct, int, bool, or string expression")
        }
    }
    let mut i = 0
    while i < len(m.arms) {
        ctx_env_push(ctx)
        let pat = m.arms[i].pattern
        check_pattern(ctx, pat, scrut, scrut_name)
        if m.arms[i].has_guard {
            let gp = expr_pos(m.arms[i].guard)
            if gp != 0 { ctx_set_pos(ctx, gp) }
            let gt = check_expr(ctx, m.arms[i].guard)
            if !ctx_is_bool(ctx, gt) && gt != 0 {
                add_type_error(ctx, "match guard must be bool")
            }
        }
        check_tail_block(ctx, m.arms[i].body, allow_implicit)
        ctx_env_pop(ctx)
        i = i + 1
    }
}

fn check_function(ctx: &mut TypeContext, f: FunctionDecl) {
    ctx_set_file(ctx, f.file)
    ctx_set_pos(ctx, f.pos)
    ctx_set_current_module(ctx, f.module)
    let fidx = find_func_in_module(ctx, f.module, f.name)
    if fidx < 0 {
        return
    }
    let sig = ctx.funcs[fidx]
    ctx.current_func = qualify_name(sig.module, sig.name)
    ctx.current_ret = sig.ret
    ctx.current_ret_explicit = sig.ret_explicit
    ctx.infer_return = !sig.ret_explicit
    ctx.inferred_type = 0
    ctx.has_return = false
    ctx.has_bare_return = false

    ctx.env = env_new()
    ctx_env_push(ctx)
    let mut i = 0
    while i < len(f.params) {
        ctx_env_declare(ctx, f.params[i].name, sig.params[i], false)
        i = i + 1
    }

    let allow_implicit = ctx.infer_return || (ctx.current_ret_explicit && ctx_type_kind(ctx, ctx.current_ret) != 4)
    check_tail_block(ctx, f.body, allow_implicit)

    if ctx.infer_return {
        if ctx.has_return {
            if ctx.inferred_type != 0 {
                ctx_set_func_ret(ctx, fidx, ctx.inferred_type)
            }
            let ret_t = ctx.funcs[fidx].ret
            if ctx.has_bare_return && ctx_type_kind(ctx, ret_t) != 4 {
                add_type_error(ctx, "mixing 'return' and 'return value' in inferred function")
            }
        } else {
            ctx_set_func_ret(ctx, fidx, ctx_type_make(ctx, 4, "unit", false, false, -1))
        }
    }
    ctx_env_pop(ctx)
}

fn check_method(ctx: &mut TypeContext, type_name: String, f: FunctionDecl) {
    ctx_set_file(ctx, f.file)
    ctx_set_pos(ctx, f.pos)
    ctx_set_current_module(ctx, f.module)
    let midx = find_method(ctx, type_name, f.name)
    if midx < 0 {
        return
    }
    let sig = ctx.methods[midx]
    ctx.current_func = sig.func_name
    if sig.has_self {
        if len(f.params) == 0 || f.params[0].name != "self" {
            add_type_error(ctx, "self must be first parameter")
        } else {
            let self_t = sig.params[0]
            let mut base = self_t
            if ctx_type_is_ref(ctx, base) {
                let kind = ctx_type_kind(ctx, base)
                let name = ctx_type_name(ctx, base)
                let elem = ctx_type_elem(ctx, base)
                base = ctx_type_make(ctx, kind, name, false, false, elem)
            }
            if ctx_type_kind(ctx, base) != 5 && ctx_type_kind(ctx, base) != 6 {
                add_type_error(ctx, "self must be Self, &Self, or &mut Self")
            } else if ctx_type_name(ctx, base) != type_name {
                add_type_error(ctx, "self type must be Self")
            }
        }
    }

    ctx.current_ret = sig.ret
    ctx.current_ret_explicit = sig.ret_explicit
    ctx.infer_return = !sig.ret_explicit
    ctx.inferred_type = 0
    ctx.has_return = false
    ctx.has_bare_return = false
    ctx.self_type = type_name

    ctx.env = env_new()
    ctx_env_push(ctx)
    let mut i = 0
    while i < len(f.params) {
        ctx_env_declare(ctx, f.params[i].name, sig.params[i], false)
        i = i + 1
    }

    let allow_implicit = ctx.infer_return || (ctx.current_ret_explicit && ctx_type_kind(ctx, ctx.current_ret) != 4)
    check_tail_block(ctx, f.body, allow_implicit)

    if ctx.infer_return {
        if ctx.has_return {
            if ctx.inferred_type != 0 {
                ctx_set_method_ret(ctx, midx, ctx.inferred_type)
            }
            let ret_t = ctx.methods[midx].ret
            if ctx.has_bare_return && ctx_type_kind(ctx, ret_t) != 4 {
                add_type_error(ctx, "mixing 'return' and 'return value' in inferred function")
            }
        } else {
            ctx_set_method_ret(ctx, midx, ctx_type_make(ctx, 4, "unit", false, false, -1))
        }
    }

    ctx_env_pop(ctx)
    ctx.self_type = ""
}

fn check_program(prog: Program) -> TypeContext {
    let mut ctx = TypeContext {
        types: type_table_new(),
        funcs: func_sig_list_new(),
        methods: method_sig_list_new(),
        consts: const_sig_list_new(),
        structs: prog.structs,
        enums: prog.enums,
        imports: prog.imports,
        module_aliases: alias_list_new(),
        import_items: import_entry_list_new(),
        reexports: reexport_list_new(),
        current_module: "",
        builtins: builtin_list(),
        errors: parse_error_list_new(),
        env: env_new(),
        infer_return: false,
        inferred_type: 0,
        has_return: false,
        has_bare_return: false,
        current_func: "",
        current_ret: 0,
        current_ret_explicit: false,
        self_type: "",
        current_file: "",
        current_pos: 0,
        loop_depth: 0,
    }
    let mut ei = 0
    while ei < len(prog.enums) {
        let e = prog.enums[ei]
        ctx_set_file(&mut ctx, e.file)
        ctx_set_pos(&mut ctx, e.pos)
        if e.repr != "" && !is_valid_enum_repr(e.repr) {
            add_type_error(&mut ctx, "unsupported repr '" + e.repr + "'")
        }
        ei = ei + 1
    }
    collect_consts(&mut ctx, prog)
    collect_reexports(&mut ctx, prog)
    collect_func_sigs(&mut ctx, prog)
    collect_method_sigs(&mut ctx, prog)
    check_import_conflicts(&mut ctx, prog)
    let mut i = 0
    while i < len(prog.functions) {
        check_function(&mut ctx, prog.functions[i])
        i = i + 1
    }
    let mut j = 0
    while j < len(prog.impls) {
        let imp = prog.impls[j]
        ctx_set_file(&mut ctx, imp.file)
        ctx_set_pos(&mut ctx, imp.pos)
        ctx_set_current_module(&mut ctx, imp.module)
        let type_qname = ctx_resolve_type_name(&mut ctx, imp.type_name, "")
        let mut k = 0
        while k < len(imp.methods) {
            if type_qname != "" {
                check_method(&mut ctx, type_qname, imp.methods[k])
            }
            k = k + 1
        }
        j = j + 1
    }
    return ctx
}
