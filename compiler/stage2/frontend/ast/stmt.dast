// AST: statements and blocks for stage2.

const STMT_LET: i32 = 1
const STMT_EXPR: i32 = 2
const STMT_ASSIGN: i32 = 3
const STMT_IF: i32 = 4
const STMT_WHILE: i32 = 5
const STMT_LOOP: i32 = 6
const STMT_BREAK: i32 = 7
const STMT_CONTINUE: i32 = 8
const STMT_RETURN: i32 = 9
const STMT_IFLET: i32 = 10
const STMT_MATCH: i32 = 11
const STMT_BREAK_VALUE: i32 = 12

const PAT_VARIANT: i32 = 1
const PAT_INT: i32 = 2
const PAT_WILDCARD: i32 = 3
const PAT_STRUCT: i32 = 4
const PAT_RANGE: i32 = 5
const PAT_BIND: i32 = 6
const PAT_ARRAY: i32 = 7

struct Block {
    stmts: [Stmt],
}

struct Pattern {
    kind: i32,
    name: String,
    int_value: i64,
    range_inclusive: bool,
    range_has_start: bool,
    range_has_end: bool,
    range_start: Expr,
    range_end: Expr,
    variant: String,
    has_payload: bool,
    payload: [Pattern],
    struct_name: String,
    struct_fields: [StructPatternField],
}

struct StructPatternField {
    name: String,
    pattern: Pattern,
}

struct MatchArm {
    pattern: Pattern,
    has_guard: bool,
    guard: Expr,
    block: Block,
}

fn struct_pattern_field_list_empty() -> [StructPatternField] {
    let mut out: [StructPatternField] = []
    return out
}

fn struct_pattern_field_clone(f: &StructPatternField) -> StructPatternField {
    return StructPatternField {
        name: string_clone(&f.name),
        pattern: pattern_clone(&f.pattern),
    }
}

fn struct_pattern_field_list_clone(items: & [StructPatternField]) -> [StructPatternField] {
    let mut out: [StructPatternField] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, struct_pattern_field_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn match_arm_list_empty() -> [MatchArm] {
    let mut out: [MatchArm] = []
    return out
}

fn match_arm_clone(a: &MatchArm) -> MatchArm {
    return MatchArm {
        pattern: pattern_clone(&a.pattern),
        has_guard: a.has_guard,
        guard: expr_clone(&a.guard),
        block: block_clone(&a.block),
    }
}

fn pattern_list_empty() -> [Pattern] {
    let mut out: [Pattern] = []
    return out
}

fn pattern_list_clone(items: & [Pattern]) -> [Pattern] {
    let mut out: [Pattern] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, pattern_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn pattern_clone(p: &Pattern) -> Pattern {
    return Pattern {
        kind: p.kind,
        name: string_clone(&p.name),
        int_value: p.int_value,
        range_inclusive: p.range_inclusive,
        range_has_start: p.range_has_start,
        range_has_end: p.range_has_end,
        range_start: expr_clone(&p.range_start),
        range_end: expr_clone(&p.range_end),
        variant: string_clone(&p.variant),
        has_payload: p.has_payload,
        payload: pattern_list_clone(&p.payload),
        struct_name: string_clone(&p.struct_name),
        struct_fields: struct_pattern_field_list_clone(&p.struct_fields),
    }
}

fn match_arm_list_clone(items: & [MatchArm]) -> [MatchArm] {
    let mut out: [MatchArm] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, match_arm_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn stmt_list_empty() -> [Stmt] {
    let mut out: [Stmt] = []
    return out
}

fn block_empty() -> Block {
    return Block { stmts: stmt_list_empty() }
}

fn block_list_empty() -> [Block] {
    let mut out: [Block] = []
    return out
}

struct Stmt {
    kind: i32,
    name: String,
    mutable: bool,
    has_type: bool,
    typ: String,
    lhs: Expr,
    expr: Expr,
    block: Block,
    else_block: Block,
    has_else: bool,
    ret_has_value: bool,
    pat_variant: String,
    pat_binding: String,
    pat_has_binding: bool,
    arms: [MatchArm],
}

fn stmt_list_clone(items: & [Stmt]) -> [Stmt] {
    let mut out: [Stmt] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, stmt_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn block_clone(b: &Block) -> Block {
    return Block { stmts: stmt_list_clone(&b.stmts) }
}

fn stmt_clone(s: &Stmt) -> Stmt {
    return Stmt {
        kind: s.kind,
        name: string_clone(&s.name),
        mutable: s.mutable,
        has_type: s.has_type,
        typ: string_clone(&s.typ),
        lhs: expr_clone(&s.lhs),
        expr: expr_clone(&s.expr),
        block: block_clone(&s.block),
        else_block: block_clone(&s.else_block),
        has_else: s.has_else,
        ret_has_value: s.ret_has_value,
        pat_variant: string_clone(&s.pat_variant),
        pat_binding: string_clone(&s.pat_binding),
        pat_has_binding: s.pat_has_binding,
        arms: match_arm_list_clone(&s.arms),
    }
}

fn stmt_let(name: String, mutable: bool, has_type: bool, typ: String, expr: Expr) -> Stmt {
    return Stmt { kind: STMT_LET, name: name, mutable: mutable, has_type: has_type, typ: typ, lhs: expr_int(0), expr: expr, block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_assign(name: String, expr: Expr) -> Stmt {
    let lhs = expr_ident(string_clone(&name))
    return Stmt { kind: STMT_ASSIGN, name: name, mutable: false, has_type: false, typ: "", lhs: lhs, expr: expr, block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_assign_expr(lhs: Expr, expr: Expr) -> Stmt {
    let mut name = string_clone("")
    if lhs.kind == EXPR_IDENT { name = string_clone(&lhs.name) }
    return Stmt { kind: STMT_ASSIGN, name: name, mutable: false, has_type: false, typ: "", lhs: lhs, expr: expr, block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_expr(expr: Expr) -> Stmt {
    return Stmt { kind: STMT_EXPR, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: expr, block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_if(cond: Expr, then_block: Block, else_block: Block, has_else: bool) -> Stmt {
    return Stmt { kind: STMT_IF, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: cond, block: then_block, else_block: else_block, has_else: has_else, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_while(cond: Expr, body: Block) -> Stmt {
    return Stmt { kind: STMT_WHILE, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: cond, block: body, else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_loop(body: Block) -> Stmt {
    return Stmt { kind: STMT_LOOP, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: expr_int(0), block: body, else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_break() -> Stmt {
    return Stmt { kind: STMT_BREAK, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: expr_int(0), block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_break_value(expr: Expr) -> Stmt {
    return Stmt { kind: STMT_BREAK_VALUE, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: expr, block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_continue() -> Stmt {
    return Stmt { kind: STMT_CONTINUE, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: expr_int(0), block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_return(expr: Expr) -> Stmt {
    return Stmt { kind: STMT_RETURN, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: expr, block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: true, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_return_unit() -> Stmt {
    return Stmt { kind: STMT_RETURN, name: "", mutable: false, has_type: false, typ: "", lhs: expr_int(0), expr: expr_int(0), block: block_empty(), else_block: block_empty(), has_else: false, ret_has_value: false, pat_variant: "", pat_binding: "", pat_has_binding: false, arms: match_arm_list_empty() }
}

fn stmt_iflet(scrut: Expr, variant: String, binding: String, has_binding: bool, then_block: Block, else_block: Block, has_else: bool) -> Stmt {
    return Stmt {
        kind: STMT_IFLET,
        name: "",
        mutable: false,
        has_type: false,
        typ: "",
        lhs: expr_int(0),
        expr: scrut,
        block: then_block,
        else_block: else_block,
        has_else: has_else,
        ret_has_value: false,
        pat_variant: variant,
        pat_binding: binding,
        pat_has_binding: has_binding,
        arms: match_arm_list_empty(),
    }
}

fn stmt_match(scrut: Expr, arms: [MatchArm]) -> Stmt {
    return Stmt {
        kind: STMT_MATCH,
        name: "",
        mutable: false,
        has_type: false,
        typ: "",
        lhs: expr_int(0),
        expr: scrut,
        block: block_empty(),
        else_block: block_empty(),
        has_else: false,
        ret_has_value: false,
        pat_variant: "",
        pat_binding: "",
        pat_has_binding: false,
        arms: arms,
    }
}
