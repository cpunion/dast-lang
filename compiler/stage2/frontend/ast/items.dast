// AST: items (struct/enum/const/function/program) for stage2.

struct ConstDecl {
    name: String,
    has_type: bool,
    typ: String,
    expr: Expr,
}

fn const_decl_clone(c: &ConstDecl) -> ConstDecl {
    return ConstDecl {
        name: string_clone(&c.name),
        has_type: c.has_type,
        typ: string_clone(&c.typ),
        expr: expr_clone(&c.expr),
    }
}

fn const_decl_list_clone(items: & [ConstDecl]) -> [ConstDecl] {
    let mut out: [ConstDecl] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, const_decl_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn ast_string_list_clone(items: & [String]) -> [String] {
    let mut out: [String] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, string_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct GenericParam {
    name: String,
    has_bound: bool,
    bound: String,
}

fn generic_param_clone(p: &GenericParam) -> GenericParam {
    return GenericParam { name: string_clone(&p.name), has_bound: p.has_bound, bound: string_clone(&p.bound) }
}

fn generic_param_list_clone(items: & [GenericParam]) -> [GenericParam] {
    let mut out: [GenericParam] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, generic_param_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct StructField {
    name: String,
    typ: String,
}

fn struct_field_clone(f: &StructField) -> StructField {
    return StructField { name: string_clone(&f.name), typ: string_clone(&f.typ) }
}

fn struct_field_list_clone(items: & [StructField]) -> [StructField] {
    let mut out: [StructField] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, struct_field_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct StructDecl {
    name: String,
    type_params: [GenericParam],
    fields: [StructField],
}

fn struct_decl_clone(s: &StructDecl) -> StructDecl {
    return StructDecl { name: string_clone(&s.name), type_params: generic_param_list_clone(&s.type_params), fields: struct_field_list_clone(&s.fields) }
}

fn struct_decl_list_clone(items: & [StructDecl]) -> [StructDecl] {
    let mut out: [StructDecl] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, struct_decl_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct EnumVariant {
    name: String,
    has_payload: bool,
    payload_type: String,
}

fn enum_variant_clone(v: &EnumVariant) -> EnumVariant {
    return EnumVariant { name: string_clone(&v.name), has_payload: v.has_payload, payload_type: string_clone(&v.payload_type) }
}

fn enum_variant_list_clone(items: & [EnumVariant]) -> [EnumVariant] {
    let mut out: [EnumVariant] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, enum_variant_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct EnumDecl {
    name: String,
    type_params: [GenericParam],
    tag_type: String,
    variants: [EnumVariant],
}

fn enum_decl_clone(e: &EnumDecl) -> EnumDecl {
    return EnumDecl { name: string_clone(&e.name), type_params: generic_param_list_clone(&e.type_params), tag_type: string_clone(&e.tag_type), variants: enum_variant_list_clone(&e.variants) }
}

fn enum_decl_list_clone(items: & [EnumDecl]) -> [EnumDecl] {
    let mut out: [EnumDecl] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, enum_decl_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct TypeAlias {
    name: String,
    target: String,
}

fn type_alias_clone(a: &TypeAlias) -> TypeAlias {
    return TypeAlias { name: string_clone(&a.name), target: string_clone(&a.target) }
}

fn type_alias_list_clone(items: & [TypeAlias]) -> [TypeAlias] {
    let mut out: [TypeAlias] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, type_alias_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct Param {
    name: String,
    typ: String,
    has_type: bool,
}

fn param_clone(p: &Param) -> Param {
    return Param { name: string_clone(&p.name), typ: string_clone(&p.typ), has_type: p.has_type }
}

fn param_list_clone(items: & [Param]) -> [Param] {
    let mut out: [Param] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, param_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn param_list_empty() -> [Param] {
    let mut out: [Param] = []
    return out
}

struct Function {
    name: String,
    type_params: [GenericParam],
    params: [Param],
    ret_type: String,
    body: Block,
    is_macro: bool,
}

fn function_clone(f: &Function) -> Function {
    return Function {
        name: string_clone(&f.name),
        type_params: generic_param_list_clone(&f.type_params),
        params: param_list_clone(&f.params),
        ret_type: string_clone(&f.ret_type),
        body: block_clone(&f.body),
        is_macro: f.is_macro,
    }
}

fn function_list_clone(items: & [Function]) -> [Function] {
    let mut out: [Function] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, function_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn function_list_empty() -> [Function] {
    let mut out: [Function] = []
    return out
}

struct CompileItem {
    expr: Expr,
}

fn compile_item_clone(c: &CompileItem) -> CompileItem {
    return CompileItem { expr: expr_clone(&c.expr) }
}

fn compile_item_list_clone(items: & [CompileItem]) -> [CompileItem] {
    let mut out: [CompileItem] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, compile_item_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn compile_item_list_empty() -> [CompileItem] {
    let mut out: [CompileItem] = []
    return out
}

struct Program {
    structs: [StructDecl],
    enums: [EnumDecl],
    type_aliases: [TypeAlias],
    consts: [ConstDecl],
    functions: [Function],
    compile_items: [CompileItem],
    traits: [TraitDecl],
    impls: [ImplDecl],
}

struct TraitDecl {
    name: String,
    type_params: [GenericParam],
}

fn trait_decl_clone(t: &TraitDecl) -> TraitDecl {
    return TraitDecl { name: string_clone(&t.name), type_params: generic_param_list_clone(&t.type_params) }
}

fn trait_decl_list_clone(items: & [TraitDecl]) -> [TraitDecl] {
    let mut out: [TraitDecl] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, trait_decl_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

struct ImplDecl {
    trait_name: String,
    for_type: String,
    type_params: [GenericParam],
}

fn impl_decl_clone(i: &ImplDecl) -> ImplDecl {
    return ImplDecl { trait_name: string_clone(&i.trait_name), for_type: string_clone(&i.for_type), type_params: generic_param_list_clone(&i.type_params) }
}

fn impl_decl_list_clone(items: & [ImplDecl]) -> [ImplDecl] {
    let mut out: [ImplDecl] = []
    let mut i = 0
    while i < len(items) {
        push(&mut out, impl_decl_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn impl_decl_list_empty() -> [ImplDecl] {
    let mut out: [ImplDecl] = []
    return out
}
