// Shared backend helpers for codegen (used by qbe).
// Extracted from codegen-c to allow disabling C backend.

// Dast C Code Generator (Stage0 compatible)
// Generates C source code from IR v0 programs

// =============================================================================
// Type Mapping
// =============================================================================

fn cg_map_type(typ: String) -> String {
    if typ == "int" || typ == "i64" { return "int64_t" }
    if typ == "i32" { return "int32_t" }
    if typ == "i16" { return "int16_t" }
    if typ == "i8" { return "int8_t" }
    if typ == "u8" { return "uint8_t" }
    if typ == "u16" { return "uint16_t" }
    if typ == "u32" { return "uint32_t" }
    if typ == "u64" { return "uint64_t" }
    if typ == "isize" { return "intptr_t" }
    if typ == "usize" { return "uintptr_t" }
    if typ == "char" { return "uint32_t" }
    if typ == "f32" { return "float" }
    if typ == "f64" { return "double" }
    if typ == "bool" { return "bool" }
    if typ == "String" || typ == "String" { return "dast_string_t" }
    if typ == "unit" || typ == "" { return "void" }
    return "int64_t"
}

fn cg_debug_enabled() -> bool {
    // Opt-in debug via marker file to avoid spamming normal runs.
    let flag = read_file("/tmp/dast-cg-debug")
    return flag != ""
}

// =============================================================================
// String Helpers
// =============================================================================

fn cg_has_prefix(s: String, prefix: String) -> bool {
    let slen = len(string_clone(&s))
    let plen = len(string_clone(&prefix))
    if slen < plen { return false }
    return substr(s, 0, plen) == prefix
}

fn cg_has_suffix(s: String, suffix: String) -> bool {
    let slen = len(string_clone(&s))
    let suflen = len(string_clone(&suffix))
    if slen < suflen { return false }
    return substr(s, slen - suflen, suflen) == suffix
}

fn cg_trim_space(s: String) -> String {
    let mut start = 0
    let mut end = len(string_clone(&s))
    let mut done = false
    while start < end && !done {
        let c = char_at(string_clone(&s), start)
        if c == 32 || c == 9 {
            start = start + 1
        } else {
            done = true
        }
    }
    done = false
    while end > start && !done {
        let c = char_at(string_clone(&s), end - 1)
        if c == 32 || c == 9 {
            end = end - 1
        } else {
            done = true
        }
    }
    if end <= start { return "" }
    return substr(s, start, end - start)
}

fn cg_string_list_contains(items: & [String], name: String) -> bool {
    let mut i = 0
    while i < len(*items) {
        if (*items)[i] == name { return true }
        i = i + 1
    }
    return false
}

fn cg_normalize_type(t: String) -> String {
    let mut s = cg_trim_space(t)
    if cg_has_prefix(string_clone(&s), "&mut ") {
        let slen = len(string_clone(&s))
        let base = cg_trim_space(substr(string_clone(&s), 5, slen - 5))
        let norm = cg_normalize_type(base)
        if norm == "String" || norm == "str" { return "str" }
        return "&" + norm
    }
    if cg_has_prefix(string_clone(&s), "&") {
        let slen = len(string_clone(&s))
        let base = cg_trim_space(substr(string_clone(&s), 1, slen - 1))
        let norm = cg_normalize_type(base)
        if norm == "String" || norm == "str" { return "str" }
        return "&" + norm
    }
    if s == "String" { return "String" }
    return s
}

fn cg_is_array_type(t: String) -> bool {
    let s = cg_trim_space(t)
    let slen = len(string_clone(&s))
    if slen < 2 { return false }
    if char_at(string_clone(&s), 0) != 91 { return false }
    return char_at(string_clone(&s), slen - 1) == 93
}

fn cg_array_elem_type(t: String) -> String {
    let s = cg_trim_space(t)
    let slen = len(string_clone(&s))
    if slen < 2 { return "" }
    return cg_normalize_type(substr(string_clone(&s), 1, slen - 2))
}

fn cg_is_ref_type(t: String) -> bool {
    let s = cg_trim_space(t)
    return cg_has_prefix(s, "&")
}

fn cg_ref_base_type(t: String) -> String {
    let s = cg_trim_space(t)
    if !cg_has_prefix(string_clone(&s), "&") { return "" }
    let slen = len(string_clone(&s))
    return cg_normalize_type(substr(string_clone(&s), 1, slen - 1))
}

fn cg_is_int_type(t: String) -> bool {
    let s = cg_normalize_type(t)
    if s == "int" { return true }
    if s == "i8" || s == "i16" || s == "i32" || s == "i64" { return true }
    if s == "u8" || s == "u16" || s == "u32" || s == "u64" { return true }
    if s == "isize" || s == "usize" { return true }
    if s == "char" { return true }
    return false
}

fn cg_is_bool_type(t: String) -> bool {
    return cg_normalize_type(t) == "bool"
}

fn cg_is_string_type(t: String) -> bool {
    let s = cg_normalize_type(t)
    if cg_is_ref_type(string_clone(&s)) {
        let base = cg_ref_base_type(string_clone(&s))
        return base == "String" || base == "str"
    }
    return s == "String" || s == "str"
}

fn cg_is_unit_type(t: String) -> bool {
    let s = cg_normalize_type(t)
    return s == "unit" || s == ""
}

fn cg_is_value_type(t: String) -> bool {
    let s = cg_normalize_type(t)
    return s == "value" || s == "any"
}

fn cg_is_type_var(t: String, struct_fields: &StringListMap) -> bool {
    let s = cg_normalize_type(t)
    if s == "" { return false }
    if cg_is_ref_type(string_clone(&s)) { return cg_is_type_var(cg_ref_base_type(string_clone(&s)), struct_fields) }
    if cg_is_array_type(string_clone(&s)) { return cg_is_type_var(cg_array_elem_type(string_clone(&s)), struct_fields) }
    if cg_has_type_args(string_clone(&s)) { return false }
    if find_char(string_clone(&s), 58, 0) >= 0 { return false }
    if cg_is_payload_type(string_clone(&s)) { return false }
    if cg_is_value_type(string_clone(&s)) { return false }
    if cg_is_int_type(string_clone(&s)) || cg_is_bool_type(string_clone(&s)) || cg_is_string_type(string_clone(&s)) || cg_is_unit_type(string_clone(&s)) { return false }
    let key = cg_struct_key_name(string_clone(&s))
    if cg_string_list_contains(&struct_fields.keys, key) { return false }
    return true
}

fn cg_is_struct_type(t: String) -> bool {
    let s = cg_normalize_type(t)
    if s == "" { return false }
    if cg_is_value_type(string_clone(&s)) { return false }
    if cg_is_payload_type(string_clone(&s)) { return false }
    if cg_is_int_type(string_clone(&s)) || cg_is_bool_type(string_clone(&s)) || cg_is_string_type(string_clone(&s)) || cg_is_unit_type(string_clone(&s)) { return false }
    if cg_is_ref_type(string_clone(&s)) || cg_is_array_type(string_clone(&s)) { return false }
    return true
}

fn cg_die(msg: String) {
    eprintln("cg: " + msg)
    exit(1)
}

fn cg_type_unify(a: &str, b: &str) -> String {
    let a2 = cg_normalize_type(string_clone(a))
    let b2 = cg_normalize_type(string_clone(b))
    if a2 == "" { return b2 }
    if b2 == "" { return a2 }
    if a2 == "unit" { return b2 }
    if b2 == "unit" { return a2 }
    if a2 == b2 { return a2 }
    if cg_is_payload_type(string_clone(&a2)) || cg_is_payload_type(string_clone(&b2)) {
        if a2 == b2 { return a2 }
        if cg_is_payload_type(string_clone(&a2)) && !cg_is_payload_type(string_clone(&b2)) { return a2 }
        if cg_is_payload_type(string_clone(&b2)) && !cg_is_payload_type(string_clone(&a2)) { return b2 }
        return ""
    }
    let ta = cg_parse_type_args(string_clone(&a2))
    let tb = cg_parse_type_args(string_clone(&b2))
    if ta.has || tb.has {
        if !ta.has || !tb.has {
            if ta.has { return a2 }
            return b2
        }
        if ta.base != tb.base { return "" }
        if len(ta.args) != len(tb.args) { return "" }
        let mut args = cg_string_list_new()
        let mut i = 0
        while i < len(ta.args) {
            let u = cg_type_unify(&ta.args[i], &tb.args[i])
            if u == "" { return "" }
            push(&mut args, u)
            i = i + 1
        }
        return ta.base + "[" + cg_type_args_join(args) + "]"
    }
    if cg_is_ref_type(string_clone(&a2)) && cg_is_ref_type(string_clone(&b2)) {
        let ba = cg_ref_base_type(string_clone(&a2))
        let bb = cg_ref_base_type(string_clone(&b2))
        let base = cg_type_unify(&ba, &bb)
        if base == "" { return "" }
        return "&" + base
    }
    if cg_is_array_type(string_clone(&a2)) && cg_is_array_type(string_clone(&b2)) {
        let ea = cg_array_elem_type(string_clone(&a2))
        let eb = cg_array_elem_type(string_clone(&b2))
        let elem = cg_type_unify(&ea, &eb)
        if elem == "" { return "" }
        return "[" + elem + "]"
    }
    if cg_is_int_type(string_clone(&a2)) && cg_is_int_type(string_clone(&b2)) {
        if a2 == "int" { return b2 }
        if b2 == "int" { return a2 }
        return ""
    }
    return ""
}

// =============================================================================
// Simple String Map
// =============================================================================

struct StringMap {
    keys: [String],
    values: [String],
    buckets: [int],
    count: int,
}

fn cg_int_list_new() -> [int] {
    let mut items: [int] = []
    return items
}

fn cg_string_list_new() -> [String] {
    let mut items: [String] = []
    return items
}

fn cg_string_list_clone(items: & [String]) -> [String] {
    let mut out: [String] = []
    let mut i = 0
    while i < len(*items) {
        push(&mut out, string_clone(&(*items)[i]))
        i = i + 1
    }
    return out
}

fn cg_string_list_list_new() -> [[String]] {
    let mut items: [[String]] = []
    return items
}

fn string_map_bucket_list_new() -> [int] {
    let mut items: [int] = []
    return items
}

fn string_map_make_buckets(cap: int) -> [int] {
    let mut buckets = string_map_bucket_list_new()
    let mut i = 0
    while i < cap {
        push(&mut buckets, 0)
        i = i + 1
    }
    return buckets
}

fn string_hash(key: &str) -> int {
    // Simple rolling hash; fast enough and stage0-friendly.
    let k = string_clone(key)
    let mut h = 0
    let mut i = 0
    let klen = len(string_clone(&k))
    while i < klen {
        // h = h * 131 + (char + 1)
        h = h * 131 + char_at(string_clone(&k), i) + 1
        i = i + 1
    }
    if h < 0 { h = -h }
    return h
}

fn string_map_slot(buckets: & [int], keys: & [String], key: &str) -> int {
    let cap = len(*buckets)
    if cap <= 0 { return -1 }
    let key_cmp = string_clone(key)
    let mut start = string_hash(&key_cmp) % cap
    if start < 0 { start = -start }
    let mut step = 0
    while step < cap {
        let slot = (start + step) % cap
        let entry = (*buckets)[slot]
        if entry == 0 { return slot }
        let idx = entry - 1
        if idx >= 0 && idx < len(*keys) && (*keys)[idx] == key_cmp {
            return slot
        }
        step = step + 1
    }
    return -1
}

fn string_map_rebuild(m: &mut StringMap) {
    let cap = len(m.buckets)
    if cap <= 0 { return }
    let mut buckets = string_map_make_buckets(cap)
    let mut i = 0
    while i < len(m.keys) {
        let slot = string_map_slot(&buckets, &m.keys, &m.keys[i])
        if slot >= 0 { buckets[slot] = i + 1 }
        i = i + 1
    }
    m.buckets = buckets
    m.count = len(m.keys)
}

fn string_map_maybe_resize(m: &mut StringMap) {
    let mut cap = len(m.buckets)
    if cap <= 0 {
        m.buckets = string_map_make_buckets(1024)
        string_map_rebuild(m)
        return
    }
    // Resize around 70% load factor.
    if m.count * 10 >= cap * 7 {
        cap = cap * 2
        if cap < 1024 { cap = 1024 }
        m.buckets = string_map_make_buckets(cap)
        string_map_rebuild(m)
    }
}

fn string_map_new() -> StringMap {
    let mut k = cg_string_list_new()
    let mut v = cg_string_list_new()
    let buckets = string_map_make_buckets(1024)
    return StringMap { keys: k, values: v, buckets: buckets, count: 0 }
}

fn string_map_clone(src: &StringMap) -> StringMap {
    let mut keys = cg_string_list_new()
    let mut values = cg_string_list_new()
    let mut i = 0
    while i < len(src.keys) {
        push(&mut keys, string_clone(&src.keys[i]))
        push(&mut values, string_clone(&src.values[i]))
        i = i + 1
    }
    let keys_len = len(keys)
    let mut cap = keys_len * 2
    if cap < 1024 { cap = 1024 }
    let mut out = StringMap { keys: keys, values: values, buckets: string_map_make_buckets(cap), count: keys_len }
    string_map_rebuild(&mut out)
    return out
}

fn string_map_get(m: &StringMap, key: &str) -> String {
    let cap = len(m.buckets)
    if cap > 0 {
        let slot = string_map_slot(&m.buckets, &m.keys, key)
        if slot >= 0 {
            let entry = m.buckets[slot]
            if entry > 0 {
                let idx = entry - 1
                if idx >= 0 && idx < len(m.values) {
                    return string_clone(&m.values[idx])
                }
            }
        }
        return ""
    }
    // Fallback to linear scan if buckets are unavailable.
    let k = string_clone(key)
    let mut i = 0
    while i < len(m.keys) {
        if m.keys[i] == k { return string_clone(&m.values[i]) }
        i = i + 1
    }
    return ""
}

fn string_map_set(m: &mut StringMap, key: String, val: String) -> bool {
    // Avoid cloning on every comparison; this was a major hotspot.
    let mut mm = m
    let key_cmp = string_clone(&key)
    let val_cmp = string_clone(&val)
    string_map_maybe_resize(mm)
    let cap = len(mm.buckets)
    if cap > 0 {
        let slot = string_map_slot(&mm.buckets, &mm.keys, &key_cmp)
        if slot >= 0 {
            let entry = mm.buckets[slot]
            if entry > 0 {
                let idx = entry - 1
                if idx >= 0 && idx < len(mm.keys) && mm.keys[idx] == key_cmp {
                    if mm.values[idx] == val_cmp { return false }
                    mm.values[idx] = val
                    return true
                }
            }
            let idx_new = len(mm.keys)
            push(&mut mm.keys, key)
            push(&mut mm.values, val)
            mm.buckets[slot] = idx_new + 1
            mm.count = mm.count + 1
            return true
        }
    }
    // Fallback to linear scan if buckets are unavailable.
    let mut i = 0
    while i < len(mm.keys) {
        if mm.keys[i] == key_cmp {
            if mm.values[i] == val_cmp { return false }
            mm.values[i] = val
            return true
        }
        i = i + 1
    }
    push(&mut mm.keys, key)
    push(&mut mm.values, val)
    mm.count = len(mm.keys)
    return true
}

fn cg_string_lt(a: &str, b: &str) -> bool {
    let aval = string_clone(a)
    let bval = string_clone(b)
    let mut i = 0
    let alen = len(aval)
    let blen = len(bval)
    while i < alen && i < blen {
        let ca = char_at(aval, i)
        let cb = char_at(bval, i)
        if ca < cb { return true }
        if ca > cb { return false }
        i = i + 1
    }
    return alen < blen
}

fn string_map_sort(m: &mut StringMap) {
    // Sorting was extremely expensive under stage0 move semantics.
    // Keep maps unsorted and rely on linear lookup instead.
    return
}

fn string_map_get_sorted(m: &StringMap, key: &str) -> String {
    return string_map_get(m, key)
}

// Seed field types for core helper structs used by the codegen itself.
fn cg_seed_field_types() -> StringMap {
    let mut out = string_map_new()
    let _ = string_map_set(&mut out, "backend.cg::StringMap.keys", "[String]")
    let _ = string_map_set(&mut out, "backend.cg::StringMap.values", "[String]")
    let _ = string_map_set(&mut out, "backend.cg::StringListMap.keys", "[String]")
    let _ = string_map_set(&mut out, "backend.cg::StringListMap.values", "[[String]]")
    let _ = string_map_set(&mut out, "backend.cg::TempFieldList.items", "[[String]]")
    let _ = string_map_set(&mut out, "backend.interp::Runtime.prog", "middle::IrProgram")
    let _ = string_map_set(&mut out, "backend.interp::Runtime.heap", "[middle::IrValue]")
    let _ = string_map_set(&mut out, "backend.interp::Runtime.structs", "[middle::IrStructValue]")
    let _ = string_map_set(&mut out, "backend.interp::Runtime.enums", "[middle::IrEnumValue]")
    let _ = string_map_set(&mut out, "backend.interp::Runtime.arrays", "[middle::IrArrayValue]")
    let _ = string_map_set(&mut out, "backend.interp::Runtime.args", "[String]")
    let _ = string_map_set(&mut out, "backend.interp::Runtime.error", "String")
    let _ = string_map_set(&mut out, "driver::ManifestResult.manifest", "driver::Manifest")
    let _ = string_map_set(&mut out, "driver::ManifestResult.errors", "[frontend::ParseError]")
    // Seed core IR value fields to avoid mis-inference.
    let _ = string_map_set(&mut out, "middle::IrEnumValue.name", "String")
    let _ = string_map_set(&mut out, "middle::IrEnumValue.variant", "String")
    let _ = string_map_set(&mut out, "middle::IrEnumValue.tag", "i32")
    let _ = string_map_set(&mut out, "middle::IrEnumValue.tag_type", "String")
    let _ = string_map_set(&mut out, "middle::IrEnumValue.has_payload", "bool")
    let _ = string_map_set(&mut out, "middle::IrEnumValue.payload", "middle::IrValue")
    let _ = string_map_set(&mut out, "middle::IrParseResult.ok", "bool")
    let _ = string_map_set(&mut out, "middle::IrParseResult.prog", "middle::IrProgram")
    let _ = string_map_set(&mut out, "middle::IrParseResult.error", "String")
    let _ = string_map_set(&mut out, "middle::IrParseResult.line", "i32")
    let _ = string_map_set(&mut out, "middle::IrLineParse.ok", "bool")
    let _ = string_map_set(&mut out, "middle::IrLineParse.is_term", "bool")
    let _ = string_map_set(&mut out, "middle::IrLineParse.instr", "middle::IrInstr")
    let _ = string_map_set(&mut out, "middle::IrLineParse.term", "middle::IrTerm")
    let _ = string_map_set(&mut out, "middle::IrLineParse.max_temp", "i32")
    let _ = string_map_set(&mut out, "middle::IrLineParse.error", "String")
    let _ = string_map_set(&mut out, "middle::IrEnumNameParse.ok", "bool")
    let _ = string_map_set(&mut out, "middle::IrEnumNameParse.name", "String")
    let _ = string_map_set(&mut out, "middle::IrEnumNameParse.type_params", "[String]")
    let _ = string_map_set(&mut out, "middle::IrEnumNameParse.error", "String")
    let _ = string_map_set(&mut out, "middle::IrEnumHeaderParse.ok", "bool")
    let _ = string_map_set(&mut out, "middle::IrEnumHeaderParse.decl", "middle::IrEnumDecl")
    let _ = string_map_set(&mut out, "middle::IrEnumHeaderParse.error", "String")
    let _ = string_map_set(&mut out, "middle::IrEnumVariantParse.ok", "bool")
    let _ = string_map_set(&mut out, "middle::IrEnumVariantParse.variant", "middle::IrEnumVariant")
    let _ = string_map_set(&mut out, "middle::IrEnumVariantParse.error", "String")
    let _ = string_map_set(&mut out, "middle::IrOperandParse.ok", "bool")
    let _ = string_map_set(&mut out, "middle::IrOperandParse.operand", "middle::IrOperand")
    let _ = string_map_set(&mut out, "middle::IrOperandParse.max_temp", "i32")
    let _ = string_map_set(&mut out, "middle::IrOperandParse.error", "String")
    let _ = string_map_set(&mut out, "frontend::Visibility.kind", "i32")
    let _ = string_map_set(&mut out, "frontend::Program.imports", "[frontend::ImportDecl]")
    let _ = string_map_set(&mut out, "frontend::Program.structs", "[frontend::StructDecl]")
    let _ = string_map_set(&mut out, "frontend::Program.enums", "[frontend::EnumDecl]")
    let _ = string_map_set(&mut out, "frontend::Program.consts", "[frontend::ConstDecl]")
    let _ = string_map_set(&mut out, "frontend::Program.traits", "[frontend::TraitDecl]")
    let _ = string_map_set(&mut out, "frontend::Program.type_aliases", "[frontend::TypeAlias]")
    let _ = string_map_set(&mut out, "frontend::Program.functions", "[frontend::FunctionDecl]")
    let _ = string_map_set(&mut out, "frontend::Program.impls", "[frontend::ImplDecl]")
    let _ = string_map_set(&mut out, "frontend::Program.impl_traits", "[frontend::ImplTrait]")
    let _ = string_map_set(&mut out, "frontend::Program.compile_items", "[frontend::CompileItem]")
    let _ = string_map_set(&mut out, "frontend::TypeTable.kinds", "[i32]")
    let _ = string_map_set(&mut out, "frontend::TypeTable.names", "[String]")
    let _ = string_map_set(&mut out, "frontend::TypeTable.refs", "[bool]")
    let _ = string_map_set(&mut out, "frontend::TypeTable.muts", "[bool]")
    let _ = string_map_set(&mut out, "frontend::TypeTable.elems", "[i32]")
    let _ = string_map_set(&mut out, "frontend::TypeParamSig.name", "String")
    let _ = string_map_set(&mut out, "frontend::TypeParamSig.bounds", "[String]")
    let _ = string_map_set(&mut out, "frontend::FuncSig.module", "String")
    let _ = string_map_set(&mut out, "frontend::FuncSig.vis", "frontend::Visibility")
    let _ = string_map_set(&mut out, "frontend::FuncSig.name", "String")
    let _ = string_map_set(&mut out, "frontend::FuncSig.type_params", "[String]")
    let _ = string_map_set(&mut out, "frontend::FuncSig.type_param_bounds", "[frontend::TypeParamSig]")
    let _ = string_map_set(&mut out, "frontend::FuncSig.params", "[i32]")
    let _ = string_map_set(&mut out, "frontend::FuncSig.ret", "i32")
    let _ = string_map_set(&mut out, "frontend::FuncSig.ret_explicit", "bool")
    let _ = string_map_set(&mut out, "frontend::MethodSig.module", "String")
    let _ = string_map_set(&mut out, "frontend::MethodSig.vis", "frontend::Visibility")
    let _ = string_map_set(&mut out, "frontend::MethodSig.type_name", "String")
