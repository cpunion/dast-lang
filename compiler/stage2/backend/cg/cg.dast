fn cg_seed_struct_fields() -> StringListMap {
    let mut out = string_list_map_new()
    // Core helper structs used throughout cg/qbe need explicit fields for layout.
    let _ = string_list_map_add(&mut out, "backend.cg::StringMap", "keys")
    let _ = string_list_map_add(&mut out, "backend.cg::StringMap", "values")
    let _ = string_list_map_add(&mut out, "backend.cg::StringListMap", "keys")
    let _ = string_list_map_add(&mut out, "backend.cg::StringListMap", "values")
    let _ = string_list_map_add(&mut out, "backend.cg::TempFieldList", "items")
    // Seed core IR structs so field offsets are correct before inference stabilizes.
    let _ = string_list_map_add(&mut out, "middle::IrProgram", "version")
    let _ = string_list_map_add(&mut out, "middle::IrProgram", "features")
    let _ = string_list_map_add(&mut out, "middle::IrProgram", "enums")
    let _ = string_list_map_add(&mut out, "middle::IrProgram", "functions")
    let _ = string_list_map_add(&mut out, "middle::IrProgram", "entry")
    let _ = string_list_map_add(&mut out, "middle::IrFunction", "name")
    let _ = string_list_map_add(&mut out, "middle::IrFunction", "params")
    let _ = string_list_map_add(&mut out, "middle::IrFunction", "param_types")
    let _ = string_list_map_add(&mut out, "middle::IrFunction", "return_type")
    let _ = string_list_map_add(&mut out, "middle::IrFunction", "blocks")
    let _ = string_list_map_add(&mut out, "middle::IrFunction", "temp_count")
    let _ = string_list_map_add(&mut out, "middle::IrBlock", "label")
    let _ = string_list_map_add(&mut out, "middle::IrBlock", "instrs")
    let _ = string_list_map_add(&mut out, "middle::IrBlock", "term")
    let _ = string_list_map_add(&mut out, "middle::IrEnumDecl", "name")
