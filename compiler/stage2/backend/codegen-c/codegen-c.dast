fn cg_seed_struct_fields() -> StringListMap {
    let mut out = string_list_map_new()
    let _ = string_list_map_add(&mut out, "middle::IrEnumValue", "name")
    let _ = string_list_map_add(&mut out, "middle::IrEnumValue", "variant")
    let _ = string_list_map_add(&mut out, "middle::IrEnumValue", "tag")
    let _ = string_list_map_add(&mut out, "middle::IrEnumValue", "tag_type")
    let _ = string_list_map_add(&mut out, "middle::IrEnumValue", "has_payload")
    let _ = string_list_map_add(&mut out, "middle::IrEnumValue", "payload")
    return out
}

fn cg_add_seed_struct_fields(struct_fields: &mut StringListMap) {
    let _ = string_list_map_add(struct_fields, "middle::IrEnumValue", "name")
    let _ = string_list_map_add(struct_fields, "middle::IrEnumValue", "variant")
    let _ = string_list_map_add(struct_fields, "middle::IrEnumValue", "tag")
    let _ = string_list_map_add(struct_fields, "middle::IrEnumValue", "tag_type")
    let _ = string_list_map_add(struct_fields, "middle::IrEnumValue", "has_payload")
    let _ = string_list_map_add(struct_fields, "middle::IrEnumValue", "payload")
}

fn cg_merge_field_types(dst: &mut StringMap, src: StringMap) {
    let mut i = 0
    while i < len(src.keys) {
        let key = src.keys[i]
        let val = src.values[i]
        let cur = string_map_get(dst, &key)
        let next = cg_type_unify(&cur, &val)
        let _ = string_map_set(dst, key, next)
        i = i + 1
    }
}

// =============================================================================
// String List Map
// =============================================================================

struct StringListMap {
    keys: [String],
    values: [[String]],
}

fn string_list_map_new() -> StringListMap {
    let mut k = cg_string_list_new()
    let mut v = cg_string_list_list_new()
    return StringListMap { keys: k, values: v }
}

fn string_list_map_ensure(m: &mut StringListMap, key: String) -> bool {
    let mut i = 0
    while i < len(m.keys) {
        if m.keys[i] == key { return false }
        i = i + 1
    }
    let mut keys = m.keys
    let mut values = m.values
    let mut empty = cg_string_list_new()
    push(&mut keys, key)
    push(&mut values, empty)
    m.keys = keys
    m.values = values
    return true
}

fn string_list_map_get(m: &StringListMap, key: &String) -> [String] {
    let k = string_clone(key)
    let mut i = 0
    while i < len(m.keys) {
        if m.keys[i] == k { return m.values[i] }
        i = i + 1
    }
    let mut empty = cg_string_list_new()
    return empty
}

fn string_list_map_add(m: &mut StringListMap, key: String, val: String) -> bool {
    let mut i = 0
    while i < len(m.keys) {
        if m.keys[i] == key {
            let mut vals = m.values[i]
            if cg_string_list_contains(&vals, string_clone(&val)) { return false }
            push(&mut vals, val)
            let mut values = m.values
            values[i] = vals
            m.values = values
            return true
        }
        i = i + 1
    }
    let mut keys = m.keys
    let mut values = m.values
    let mut vals = cg_string_list_new()
    push(&mut vals, val)
    push(&mut keys, key)
    push(&mut values, vals)
    m.keys = keys
    m.values = values
    return true
}

fn cg_collect_field_types(p: &IrProgram, funcs: & [IrFunction], struct_fields: &StringListMap, seed_fields: StringMap, enum_names: & [String], enum_tag_payloads: &StringMap, label: String, progress: bool) -> StringMap {
    let mut out = seed_fields
    let total = len(funcs)
    let step = 25
    let mut i = 0
    while i < len(funcs) {
        if !cg_func_has_field_ops(&funcs[i]) {
            i = i + 1
            continue
        }
        if progress {
            eprintln("ir-c: " + label + " start", i + 1, "/", total, funcs[i].name)
        }
        let inf = cg_infer_function_types(p, &funcs[i], &out, struct_fields, enum_names, enum_tag_payloads)
        cg_merge_field_types(&mut out, inf.field_types)
        if progress && ((i + 1) % step == 0 || i + 1 == total) {
            eprintln("ir-c: " + label + " done", i + 1, "/", total)
        }
        i = i + 1
    }
    return out
}

fn cg_func_has_field_ops(f: &IrFunction) -> bool {
    let mut bi = 0
    while bi < len(f.blocks) {
        let blk = f.blocks[bi]
        let mut j = 0
        while j < len(blk.instrs) {
            match blk.instrs[j] {
                IrInstr.MakeStruct(_) => { return true }
                IrInstr.GetField(_) => { return true }
                IrInstr.SetField(_) => { return true }
                _ => {}
            }
            j = j + 1
        }
        bi = bi + 1
    }
    return false
}

fn cg_collect_struct_fields(p: &IrProgram, funcs: & [IrFunction], seed_fields: &StringMap, struct_fields_hint: &StringListMap, enum_names: & [String], enum_tag_payloads: &StringMap) -> StringListMap {
    let mut out = string_list_map_new()
    let mut i = 0
    while i < len(struct_fields_hint.keys) {
        let name = struct_fields_hint.keys[i]
        let fields = struct_fields_hint.values[i]
        let _ = string_list_map_ensure(&mut out, string_clone(&name))
        let mut j = 0
        while j < len(fields) {
            let _ = string_list_map_add(&mut out, string_clone(&name), fields[j])
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < len(funcs) {
        let f = funcs[i]
        let mut bi = 0
        while bi < len(f.blocks) {
            let blk = f.blocks[bi]
            let mut j = 0
            while j < len(blk.instrs) {
                match blk.instrs[j] {
                    IrInstr.MakeStruct(i2) => {
                        let name = cg_struct_key_name(i2.name)
                        if name != "" {
                            let _ = string_list_map_ensure(&mut out, string_clone(&name))
                            let mut k = 0
                            while k < len(i2.fields) {
                                let _ = string_list_map_add(&mut out, string_clone(&name), i2.fields[k].name)
                                k = k + 1
                            }
                        }
                    }
                    _ => {}
                }
                j = j + 1
            }
            bi = bi + 1
        }
        i = i + 1
    }
    return out
}

fn cg_collect_struct_ref_from_type(refs: &mut [String], typ: String) {
    let s = cg_normalize_type(typ)
    if s == "" { return }
    if cg_is_payload_type(s) { return }
    if cg_is_ref_type(s) {
        cg_collect_struct_ref_from_type(refs, cg_ref_base_type(s))
        return
    }
    if cg_is_array_type(s) {
        cg_collect_struct_ref_from_type(refs, cg_array_elem_type(s))
        return
    }
    if !cg_is_struct_type(s) { return }
    let key = cg_struct_key_name(s)
    if !cg_string_list_contains(refs, string_clone(&key)) {
        push(refs, key)
    }
}

fn cg_collect_struct_refs(funcs: & [IrFunction], struct_fields: &StringListMap, field_types: &StringMap, payload_types: &StringListMap, env_field_types: &StringListMap) -> [String] {
    let mut refs = cg_string_list_new()
    let mut i = 0
    while i < len(struct_fields.keys) {
        let name = struct_fields.keys[i]
        if !cg_string_list_contains(&refs, string_clone(&name)) {
            push(&mut refs, name)
        }
        i = i + 1
    }
    i = 0
    while i < len(funcs) {
        let f = funcs[i]
        cg_collect_struct_ref_from_type(&mut refs, f.return_type)
        let mut j = 0
        while j < len(f.param_types) {
            cg_collect_struct_ref_from_type(&mut refs, f.param_types[j])
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < len(field_types.values) {
        cg_collect_struct_ref_from_type(&mut refs, field_types.values[i])
        i = i + 1
    }
    i = 0
    while i < len(payload_types.values) {
        let types = payload_types.values[i]
        let mut j = 0
        while j < len(types) {
            cg_collect_struct_ref_from_type(&mut refs, types[j])
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < len(env_field_types.values) {
        let types = env_field_types.values[i]
        let mut j = 0
        while j < len(types) {
            cg_collect_struct_ref_from_type(&mut refs, types[j])
            j = j + 1
        }
        i = i + 1
    }
    return refs
}

fn cg_enum_inst_from_type(p: &IrProgram, t: String) -> String {
    let s = cg_normalize_type(t)
    if s == "" { return "" }
    if cg_is_ref_type(s) { return cg_enum_inst_from_type(p, cg_ref_base_type(s)) }
    if cg_is_array_type(s) { return cg_enum_inst_from_type(p, cg_array_elem_type(s)) }
    let base = cg_enum_base_name(s)
    if cg_enum_decl_index(p.enums, base) >= 0 { return s }
    return ""
}

fn cg_enum_inst_names(p: &IrProgram, funcs: & [IrFunction], struct_fields: &StringListMap, field_types: &StringMap) -> [String] {
    let mut out = cg_string_list_new()
    let mut ei = 0
    while ei < len(p.enums) {
        let name = cg_struct_key_name(p.enums[ei].name)
        if !cg_string_list_contains(&out, string_clone(&name)) {
            push(&mut out, name)
        }
        ei = ei + 1
    }
    let mut i = 0
    while i < len(struct_fields.keys) {
        let name = struct_fields.keys[i]
        let inst = cg_enum_inst_from_type(p, name)
        if inst != "" && !cg_string_list_contains(&out, string_clone(&inst)) {
            push(&mut out, inst)
        }
        i = i + 1
    }
    i = 0
    while i < len(funcs) {
        let f = funcs[i]
        let inst = cg_enum_inst_from_type(p, f.return_type)
        if inst != "" && !cg_string_list_contains(&out, string_clone(&inst)) {
            push(&mut out, inst)
        }
        let mut j = 0
        while j < len(f.param_types) {
            let inst2 = cg_enum_inst_from_type(p, f.param_types[j])
            if inst2 != "" && !cg_string_list_contains(&out, string_clone(&inst2)) {
                push(&mut out, inst2)
            }
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < len(field_types.values) {
        let inst3 = cg_enum_inst_from_type(p, field_types.values[i])
        if inst3 != "" && !cg_string_list_contains(&out, string_clone(&inst3)) {
            push(&mut out, inst3)
        }
        i = i + 1
    }
    return out
}

fn cg_enum_type_map_for_inst(decl: &IrEnumDecl, inst_name: &String) -> StringMap {
    let mut out = string_map_new()
    if len(decl.type_params) == 0 { return out }
    let ta = cg_parse_type_args(string_clone(inst_name))
    let mut i = 0
    while i < len(decl.type_params) {
        let mut arg = ""
        if i < len(ta.args) { arg = cg_normalize_type(ta.args[i]) }
        if arg != "" {
            let _ = string_map_set(&mut out, decl.type_params[i], arg)
        }
        i = i + 1
    }
    return out
}

fn cg_enum_seed_fields(p: &IrProgram, funcs: & [IrFunction], struct_fields: &StringListMap) -> StringMap {
    let empty = string_map_new()
    let insts = cg_enum_inst_names(&p, &funcs, struct_fields, &empty)
    let mut out = string_map_new()
    let mut i = 0
    while i < len(insts) {
        let name = insts[i]
        let base = cg_enum_base_name(name)
        let idx = cg_enum_decl_index(p.enums, base)
        if idx >= 0 {
            let decl = p.enums[idx]
            let mut tag_t = decl.tag_type
            if tag_t == "" { tag_t = "i32" }
            let _ = string_map_set(&mut out, cg_field_key(name, "_tag"), cg_normalize_type(tag_t))
            let _ = string_map_set(&mut out, cg_field_key(name, "_payload"), cg_payload_type(name))
        }
        i = i + 1
    }
    return out
}

fn cg_add_enum_struct_fields(p: &IrProgram, funcs: & [IrFunction], struct_fields: &mut StringListMap, field_types: &StringMap) {
    let insts = cg_enum_inst_names(&p, &funcs, struct_fields, field_types)
    let mut i = 0
    while i < len(insts) {
        let name = cg_struct_key_name(insts[i])
        let _ = string_list_map_ensure(struct_fields, name)
        let _ = string_list_map_add(struct_fields, name, "_tag")
        let _ = string_list_map_add(struct_fields, name, "_payload")
        i = i + 1
    }
}

fn cg_collect_enum_payload_types(p: &IrProgram, funcs: & [IrFunction], struct_fields: &StringListMap, field_types: &StringMap) -> StringListMap {
    let mut out = string_list_map_new()
    let insts = cg_enum_inst_names(&p, &funcs, struct_fields, field_types)
    let mut i = 0
    while i < len(insts) {
        let name = insts[i]
        let base = cg_enum_base_name(name)
        let idx = cg_enum_decl_index(p.enums, base)
        if idx >= 0 {
            let decl = p.enums[idx]
            let tmap = cg_enum_type_map_for_inst(&decl, &name)
            let mut j = 0
            while j < len(decl.variants) {
                let mut pt = string_clone(&decl.variants[j].payload_type)
                if pt == "" { pt = "unit" }
                let mut sub = cg_subst_type(string_clone(&pt), struct_fields, &tmap)
                if sub == "" { sub = pt }
                let mut typ = cg_normalize_type(sub)
                if typ == "" { typ = "unit" }
                let _ = string_list_map_add(&mut out, string_clone(&name), typ)
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

fn cg_collect_enum_tag_payloads(p: &IrProgram, funcs: & [IrFunction], struct_fields: &StringListMap, field_types: &StringMap) -> StringMap {
    let mut out = string_map_new()
    let insts = cg_enum_inst_names(&p, &funcs, struct_fields, field_types)
    let mut i = 0
    while i < len(insts) {
        let name = insts[i]
        let base = cg_enum_base_name(name)
        let idx = cg_enum_decl_index(p.enums, base)
        if idx >= 0 {
            let decl = p.enums[idx]
            let tmap = cg_enum_type_map_for_inst(&decl, &name)
            let mut j = 0
            while j < len(decl.variants) {
                let mut pt = string_clone(&decl.variants[j].payload_type)
                if pt == "" { pt = "unit" }
                let mut sub = cg_subst_type(string_clone(&pt), struct_fields, &tmap)
                if sub == "" { sub = pt }
                let mut typ = cg_normalize_type(sub)
                if typ == "" { typ = "unit" }
                let key = cg_enum_tag_key(string_clone(&name), decl.variants[j].tag)
                let _ = string_map_set(&mut out, key, typ)
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

fn cg_collect_env_field_types(p: &IrProgram, funcs: & [IrFunction], seed_fields: &StringMap, struct_fields: &StringListMap, enum_names: & [String], enum_tag_payloads: &StringMap) -> StringListMap {
    let mut out = string_list_map_new()
    let mut i = 0
    while i < len(funcs) {
        let f = funcs[i]
        if !cg_func_has_env_make(&f) {
            i = i + 1
            continue
        }
        let infer = cg_infer_function_types(p, &f, seed_fields, struct_fields, enum_names, enum_tag_payloads)
        let mut bi = 0
        while bi < len(f.blocks) {
            let blk = f.blocks[bi]
            let mut j = 0
            while j < len(blk.instrs) {
                match blk.instrs[j] {
                    IrInstr.MakeStruct(i2) => {
                        if cg_struct_key_name(i2.name) == "$Env" {
                            let mut k = 0
                            while k < len(i2.fields) {
                                let field = i2.fields[k]
                                let mut pt = cg_operand_type(field.src, &infer.temp_types)
                                if pt == "" {
                                    let key = cg_field_key(i2.name, field.name)
                                    pt = cg_get_field_type_seeded(&infer, seed_fields, true, &key)
                                }
                                if pt == "" { pt = "unit" }
                                pt = cg_normalize_type(pt)
                                let _ = string_list_map_add(&mut out, field.name, pt)
                                k = k + 1
                            }
                        }
                    }
                    _ => {}
                }
                j = j + 1
            }
            bi = bi + 1
        }
        i = i + 1
    }
    return out
}

fn cg_func_has_env_make(f: &IrFunction) -> bool {
    let mut bi = 0
    while bi < len(f.blocks) {
        let blk = f.blocks[bi]
        let mut j = 0
        while j < len(blk.instrs) {
            match blk.instrs[j] {
                IrInstr.MakeStruct(i2) => {
                    if cg_struct_key_name(i2.name) == "$Env" { return true }
                }
                _ => {}
            }
            j = j + 1
        }
        bi = bi + 1
    }
    return false
}

// =============================================================================
// Type Inference
// =============================================================================

struct TempFieldList {
    items: [[String]],
}

struct CgInfer {
    func_name: String,
    temp_types: [String],
    var_types: StringMap,
    seed_fields: StringMap,
    field_types: StringMap,
    temp_field_types: StringMap,
    var_field_types: StringMap,
    temp_closure_funcs: [String],
    var_closure_funcs: StringMap,
}

fn cg_temp_field_add(temp_fields: &mut TempFieldList, idx: i32, field: String) -> bool {
    if idx < 0 || idx >= len(temp_fields.items) { return false }
    let mut items = temp_fields.items
    let mut fields = items[idx]
    if cg_string_list_contains(&fields, string_clone(&field)) { return false }
    push(&mut fields, field)
    items[idx] = fields
    temp_fields.items = items
    return true
}

fn cg_struct_has_fields(struct_fields: &StringListMap, name: &String, fields: & [String]) -> bool {
    let have = string_list_map_get(struct_fields, name)
    let mut i = 0
    while i < len(fields) {
        if !cg_string_list_contains(&have, fields[i]) { return false }
        i = i + 1
    }
    return true
}

fn cg_guess_struct_type(struct_fields: &StringListMap, fields: & [String]) -> String {
    let mut found = ""
    let mut i = 0
    while i < len(struct_fields.keys) {
        let name = struct_fields.keys[i]
        if cg_struct_has_fields(struct_fields, &name, fields) {
            if found != "" { return "" }
            found = name
        }
        i = i + 1
    }
    return found
}

fn cg_has_type_args(name: String) -> bool {
    let s = cg_trim_space(name)
    if cg_is_array_type(s) { return false }
    let mut i = 0
    while i < len(s) {
        if char_at(s, i) == 91 { return true }
        i = i + 1
    }
    return false
}

struct CgTypeArgs {
    base: String,
    args: [String],
    has: bool,
}

fn cg_parse_type_args(t: String) -> CgTypeArgs {
    let s = cg_trim_space(t)
    if s == "" { return CgTypeArgs { base: "", args: cg_string_list_new(), has: false } }
    if cg_is_array_type(s) { return CgTypeArgs { base: s, args: cg_string_list_new(), has: false } }
    let mut idx = -1
    let mut i = 0
    while i < len(s) {
        if char_at(s, i) == 91 && idx < 0 {
            idx = i
        }
        i = i + 1
    }
    if idx < 0 {
        return CgTypeArgs { base: s, args: cg_string_list_new(), has: false }
    }
    let base = cg_trim_space(substr(s, 0, idx))
    let mut args = cg_string_list_new()
    let mut depth = 0
    let mut start = idx + 1
    i = idx + 1
    while i < len(s) {
        let c = char_at(s, i)
        if c == 91 {
            depth = depth + 1
        } else if c == 93 {
            if depth == 0 {
                let part = cg_trim_space(substr(s, start, i - start))
                if part != "" { push(&mut args, part) }
                return CgTypeArgs { base: base, args: args, has: true }
            }
            depth = depth - 1
        } else if c == 44 && depth == 0 {
            let part = cg_trim_space(substr(s, start, i - start))
            push(&mut args, part)
            start = i + 1
        }
        i = i + 1
    }
    return CgTypeArgs { base: base, args: args, has: true }
}

fn cg_type_args_join(args: [String]) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(args) {
        if i > 0 { out = out + "," }
        out = out + args[i]
        i = i + 1
    }
    return out
}

fn cg_enum_base_name(name: String) -> String {
    let s = cg_normalize_type(name)
    let ta = cg_parse_type_args(s)
    if ta.has { return ta.base }
    return s
}

fn cg_enum_decl_index(enums: [IrEnumDecl], base: String) -> i32 {
    let key = cg_struct_key_name(base)
    let mut i = 0
    while i < len(enums) {
        if cg_struct_key_name(enums[i].name) == key { return i }
        i = i + 1
    }
    return -1
}

fn cg_enum_names(p: &IrProgram) -> [String] {
    let mut out = cg_string_list_new()
    let mut i = 0
    while i < len(p.enums) {
        let name = cg_struct_key_name(p.enums[i].name)
        if !cg_string_list_contains(&out, string_clone(&name)) {
            push(&mut out, name)
        }
        i = i + 1
    }
    return out
}

fn cg_struct_is_enum(enum_names: & [String], name: String) -> bool {
    let s = cg_normalize_type(name)
    if cg_is_ref_type(s) { return cg_struct_is_enum(enum_names, cg_ref_base_type(s)) }
    if cg_is_array_type(s) { return cg_struct_is_enum(enum_names, cg_array_elem_type(s)) }
    let base = cg_struct_key_name(cg_enum_base_name(s))
    return cg_string_list_contains(&enum_names, base)
}

fn cg_block_tag_key(label: String, src: i32) -> String {
    return label + "#" + int_to_string(src)
}

fn cg_enum_tag_key(enum_name: String, tag: i32) -> String {
    return cg_struct_key_name(enum_name) + "#" + int_to_string(tag)
}

fn cg_enum_tag_key_str(enum_name: String, tag: String) -> String {
    return cg_struct_key_name(enum_name) + "#" + tag
}

fn cg_field_key(struct_name: String, field: String) -> String {
    return cg_struct_key_name(struct_name) + "." + field
}

fn cg_temp_field_key(idx: i32, field: String) -> String {
    return "t" + int_to_string(idx) + "." + field
}

fn cg_var_field_key(name: String, field: String) -> String {
    return name + "." + field
}

// =============================================================================
// Generic Instantiation Helpers
// =============================================================================

struct FuncInstance {
    base: String,
    name: String,
    param_types: [String],
    return_type: String,
}

struct FuncInstanceResult {
    items: [FuncInstance],
    name_map: StringMap,
    entry_name: String,
}

fn cg_type_vars_in_type(t: String, struct_fields: &StringListMap, out: &mut [String]) {
    let s = cg_normalize_type(t)
    if s == "" { return }
    if cg_is_ref_type(s) {
        cg_type_vars_in_type(cg_ref_base_type(s), struct_fields, out)
        return
    }
    if cg_is_array_type(s) {
        cg_type_vars_in_type(cg_array_elem_type(s), struct_fields, out)
        return
    }
    let ta = cg_parse_type_args(s)
    if ta.has {
        let mut i = 0
        while i < len(ta.args) {
            cg_type_vars_in_type(ta.args[i], struct_fields, out)
            i = i + 1
        }
        return
    }
    if cg_is_type_var(s, struct_fields) && !cg_string_list_contains(out, string_clone(&s)) {
        push(out, s)
    }
}

fn cg_func_is_generic(f: &IrFunction, struct_fields: &StringListMap) -> bool {
    let mut vars = cg_string_list_new()
    let mut i = 0
    while i < len(f.param_types) {
        cg_type_vars_in_type(f.param_types[i], struct_fields, &mut vars)
        i = i + 1
    }
    cg_type_vars_in_type(f.return_type, struct_fields, &mut vars)
    return len(vars) > 0
}

fn cg_program_has_generic(funcs: & [IrFunction], struct_fields: &StringListMap) -> bool {
    let mut i = 0
    while i < len(funcs) {
        if cg_func_is_generic(&funcs[i], struct_fields) { return true }
        i = i + 1
    }
    return false
}

fn cg_bind_type_vars(param_type: String, arg_type: String, struct_fields: &StringListMap, map: &mut StringMap) -> bool {
    let p = cg_normalize_type(param_type)
    let a = cg_normalize_type(arg_type)
    if p == "" || a == "" { return false }
    if cg_is_ref_type(p) {
        if !cg_is_ref_type(a) { cg_die("type mismatch: expected ref, got " + a) }
        return cg_bind_type_vars(cg_ref_base_type(p), cg_ref_base_type(a), struct_fields, map)
    }
    if cg_is_array_type(p) {
        if !cg_is_array_type(a) { cg_die("type mismatch: expected array, got " + a) }
        return cg_bind_type_vars(cg_array_elem_type(p), cg_array_elem_type(a), struct_fields, map)
    }
    let pa = cg_parse_type_args(p)
    if pa.has {
        let aa = cg_parse_type_args(a)
        if !aa.has { cg_die("type mismatch: expected " + p + ", got " + a) }
        if pa.base != aa.base { cg_die("type mismatch: expected " + p + ", got " + a) }
        if len(pa.args) != len(aa.args) { cg_die("type mismatch: expected " + p + ", got " + a) }
        let mut i = 0
        while i < len(pa.args) {
            let _ = cg_bind_type_vars(pa.args[i], aa.args[i], struct_fields, map)
            i = i + 1
        }
        return true
    }
    if cg_is_type_var(p, struct_fields) {
        let cur = string_map_get(map, &p)
        if cur == "" {
            let _ = string_map_set(map, p, a)
            return true
        }
        if cur != a {
            cg_die("type var " + p + " bound to " + cur + " and " + a)
        }
    }
    return false
}

fn cg_subst_type(t: String, struct_fields: &StringListMap, map: &StringMap) -> String {
    let s = cg_normalize_type(t)
    if s == "" { return "" }
    if cg_is_ref_type(s) {
        let base = cg_subst_type(cg_ref_base_type(s), struct_fields, map)
        if base == "" { return "" }
        return "&" + base
    }
    if cg_is_array_type(s) {
        let elem = cg_subst_type(cg_array_elem_type(s), struct_fields, map)
        if elem == "" { return "" }
        return "[" + elem + "]"
    }
    let ta = cg_parse_type_args(s)
    if ta.has {
        let mut args = cg_string_list_new()
        let mut i = 0
        while i < len(ta.args) {
            let sub = cg_subst_type(ta.args[i], struct_fields, map)
            if sub == "" { return "" }
            push(&mut args, sub)
            i = i + 1
        }
        return ta.base + "[" + cg_type_args_join(args) + "]"
    }
    if cg_is_type_var(s, struct_fields) {
        return string_map_get(map, &s)
    }
    return s
}

fn cg_func_instance_key(base: String, param_types: [String], return_type: String) -> String {
    let mut key = base + "|"
    let mut i = 0
    while i < len(param_types) {
        if i > 0 { key = key + "," }
        key = key + cg_normalize_type(param_types[i])
        i = i + 1
    }
    key = key + "->" + cg_normalize_type(return_type)
    return key
}

fn cg_func_instance_name(base: String, param_types: [String], return_type: String, generic: bool) -> String {
    if !generic { return base }
    let mut name = base + "::["
    let mut i = 0
    while i < len(param_types) {
        if i > 0 { name = name + "," }
        name = name + cg_normalize_type(param_types[i])
        i = i + 1
    }
    name = name + "]"
    let rt = cg_normalize_type(return_type)
    if rt != "" && rt != "unit" {
        name = name + "->" + rt
    }
    return name
}

fn cg_build_type_map(basef: &IrFunction, inst: FuncInstance, struct_fields: &StringListMap) -> StringMap {
    let mut map = string_map_new()
    let mut i = 0
    while i < len(basef.param_types) && i < len(inst.param_types) {
        let _ = cg_bind_type_vars(basef.param_types[i], inst.param_types[i], struct_fields, &mut map)
        i = i + 1
    }
    if basef.return_type != "" && inst.return_type != "" {
        let _ = cg_bind_type_vars(basef.return_type, inst.return_type, struct_fields, &mut map)
    }
    return map
}

fn cg_subst_instr(inst: IrInstr, struct_fields: &StringListMap, map: &StringMap) -> IrInstr {
    match inst {
        IrInstr.MakeStruct(ms) => {
            let name = cg_subst_type(ms.name, struct_fields, map)
            if name == "" { cg_die("cannot resolve struct type " + ms.name) }
            return IrInstr.MakeStruct(IrMakeStruct { dst: ms.dst, name: name, fields: ms.fields })
        }
        _ => { return inst }
    }
}

fn cg_subst_blocks(blocks: & [IrBlock], struct_fields: &StringListMap, map: &StringMap) -> [IrBlock] {
    let mut out: [IrBlock] = []
    let mut i = 0
    while i < len(blocks) {
        let blk = blocks[i]
        let mut instrs: [IrInstr] = []
        let mut j = 0
        while j < len(blk.instrs) {
            push(&mut instrs, cg_subst_instr(blk.instrs[j], struct_fields, map))
            j = j + 1
        }
        push(&mut out, IrBlock { label: blk.label, instrs: instrs, term: blk.term })
        i = i + 1
    }
    return out
}

struct ResolvedCall {
    name: String,
    param_types: [String],
    return_type: String,
}

fn cg_resolve_call_instance(inst: IrCall, infer: &CgInfer, p: &IrProgram, struct_fields: &StringListMap, inst_map: &StringMap) -> ResolvedCall {
    let fidx = cg_find_function_index(p, inst.callee)
    if fidx < 0 {
        return ResolvedCall { name: inst.callee, param_types: cg_string_list_new(), return_type: "" }
    }
    let f = p.functions[fidx]
    let mut tv_map = string_map_new()
    let mut i = 0
    while i < len(inst.args) && i < len(f.param_types) {
        let at = cg_operand_type(inst.args[i], &infer.temp_types)
        if at != "" {
            let _ = cg_bind_type_vars(f.param_types[i], at, struct_fields, &mut tv_map)
        }
        i = i + 1
    }
    let mut cparams = cg_string_list_new()
    i = 0
    while i < len(f.param_types) {
        let mut ct = cg_subst_type(f.param_types[i], struct_fields, &tv_map)
        if ct == "" {
            let pt = cg_normalize_type(f.param_types[i])
            if cg_is_type_var(pt, struct_fields) {
                cg_die("cannot infer type for " + pt + " in call to " + f.name)
            }
            ct = pt
        }
        push(&mut cparams, ct)
        i = i + 1
    }
    let mut cret = cg_subst_type(f.return_type, struct_fields, &tv_map)
    if cret == "" {
        let rt = cg_normalize_type(f.return_type)
        if cg_is_type_var(rt, struct_fields) {
            cg_die("cannot infer return type for " + f.name)
        }
        cret = rt
    }
    let key = cg_func_instance_key(f.name, cparams, cret)
    let name = string_map_get(inst_map, &key)
    if name == "" {
        cg_die("missing function instance for " + key)
    }
    return ResolvedCall { name: name, param_types: cparams, return_type: cret }
}

fn cg_struct_key_name(name: String) -> String {
    if name == "Env" { return "$Env" }
    return name
}

fn cg_set_temp_type(infer: &mut CgInfer, idx: i32, typ: String) -> bool {
    if idx < 0 || idx >= len(infer.temp_types) { return false }
    let cur = infer.temp_types[idx]
    let next = cg_type_unify(&cur, &typ)
    if next == "" {
        if cur != "" && typ != "" {
            let fname = infer.func_name
            if fname != "" {
                cg_die("type conflict in " + fname + " for t" + int_to_string(idx) + ": " + cur + " vs " + typ)
            }
            cg_die("type conflict for t" + int_to_string(idx) + ": " + cur + " vs " + typ)
        }
        return false
    }
    if next != cur {
        let mut temps = infer.temp_types
        temps[idx] = next
        infer.temp_types = temps
        return true
    }
    return false
}

fn cg_set_var_type(infer: &mut CgInfer, name: String, typ: String) -> bool {
    let map0 = infer.var_types
    let cur = string_map_get(&map0, &name)
    let next = cg_type_unify(&cur, &typ)
    if next == "" {
        if cur != "" && typ != "" {
            cg_die("type conflict for var " + name + ": " + cur + " vs " + typ)
        }
        return false
    }
    if next == cur { return false }
    let mut map = infer.var_types
    let changed = string_map_set(&mut map, name, next)
    infer.var_types = map
    return changed
}

fn cg_set_field_type(infer: &mut CgInfer, struct_name: String, field: String, typ: String) -> bool {
    let key = cg_field_key(struct_name, field)
    let map0 = infer.field_types
    let cur = string_map_get(&map0, &key)
    let next = cg_type_unify(&cur, &typ)
    if next == "" {
        if cur != "" && typ != "" {
            cg_die("type conflict for field " + key + ": " + cur + " vs " + typ)
        }
        return false
    }
    if next == cur { return false }
    let mut map = infer.field_types
    let changed = string_map_set(&mut map, key, next)
    infer.field_types = map
    return changed
}

fn cg_set_var_closure(infer: &mut CgInfer, name: String, val: String) -> bool {
    let map0 = infer.var_closure_funcs
    let cur = string_map_get(&map0, &name)
    if cur == val { return false }
    let mut map = infer.var_closure_funcs
    let changed = string_map_set(&mut map, name, val)
    infer.var_closure_funcs = map
    return changed
}

fn cg_get_var_type(infer: &CgInfer, name: &String) -> String {
    let map = infer.var_types
    return string_map_get(&map, name)
}

fn cg_get_field_type(infer: &CgInfer, key: &String) -> String {
    let key_val = string_clone(key)
    let map = infer.field_types
    let cur = string_map_get(&map, key)
    if cur != "" { return cur }
    let base = cg_field_key_base(string_clone(key))
    if base != key_val {
        let cur2 = string_map_get(&map, &base)
        if cur2 != "" { return cur2 }
    }
    let seed = infer.seed_fields
    let cur3 = string_map_get_sorted(&seed, key)
    if cur3 != "" { return cur3 }
    if base != key_val {
        return string_map_get_sorted(&seed, &base)
    }
    return ""
}

fn cg_get_field_type_seeded(infer: &CgInfer, seed: &StringMap, use_seed: bool, key: &String) -> String {
    let key_val = string_clone(key)
    if key_val == "middle::IrEnumValue.payload" { return "middle::IrValue" }
    let map = infer.field_types
    let cur = string_map_get(&map, key)
    if cur != "" { return cur }
    let base = cg_field_key_base(string_clone(key))
    if !use_seed {
        if base != key_val {
            return string_map_get(&map, &base)
        }
        return ""
    }
    let seeded = string_map_get_sorted(seed, key)
    if seeded != "" { return seeded }
    if base != key_val {
        let cur2 = string_map_get(&map, &base)
        if cur2 != "" { return cur2 }
        return string_map_get_sorted(seed, &base)
    }
    return ""
}

fn cg_field_key_base(key: String) -> String {
    let dot = find_char(key, 46, 0)
    if dot < 0 { return key }
    let st = substr(key, 0, dot)
    let field = substr(key, dot + 1, len(key) - dot - 1)
    let ta = cg_parse_type_args(st)
    if ta.has {
        return cg_struct_key_name(ta.base) + "." + field
    }
    return key
}

fn cg_set_field_type_seeded(infer: &mut CgInfer, seed: &StringMap, use_seed: bool, struct_name: String, field: String, typ: String) -> bool {
    if !use_seed {
        return cg_set_field_type(infer, struct_name, field, typ)
    }
    let key = cg_field_key(struct_name, field)
    let map0 = infer.field_types
    let cur_local = string_map_get(&map0, &key)
    let mut cur = cur_local
    if cur == "" {
        cur = string_map_get_sorted(seed, &key)
    }
    let next = cg_type_unify(&cur, &typ)
    if next == "" {
        if cur != "" && typ != "" {
            let key_msg = string_clone(&key)
            cg_die("type conflict for field " + key_msg + ": " + cur + " vs " + typ)
        }
        return false
    }
    if next == cur_local { return false }
    if cur_local == "" && next == cur { return false }
    let mut map = infer.field_types
    let changed = string_map_set(&mut map, key, next)
    infer.field_types = map
    return changed
}

fn cg_get_var_closure(infer: &CgInfer, name: String) -> String {
    let map = infer.var_closure_funcs
    return string_map_get(&map, &name)
}

fn cg_get_temp_type_at(infer: &CgInfer, idx: i32) -> String {
    if idx < 0 || idx >= len(infer.temp_types) { return "" }
    return infer.temp_types[idx]
}

fn cg_get_temp_closure(infer: &CgInfer, idx: i32) -> String {
    if idx < 0 || idx >= len(infer.temp_closure_funcs) { return "" }
    return infer.temp_closure_funcs[idx]
}

fn cg_operand_type(op: IrOperand, temp_types: & [String]) -> String {
    if op.is_const {
        let v = op.value
        if v.kind == ir_kind_int() {
            if v.int_type != "" { return cg_normalize_type(v.int_type) }
            return "int"
        }
        if v.kind == ir_kind_bool() { return "bool" }
        if v.kind == ir_kind_string() { return "String" }
        if v.kind == ir_kind_unit() { return "unit" }
        return ""
    }
    if op.temp < 0 || op.temp >= len(temp_types) { return "" }
    return temp_types[op.temp]
}

fn cg_find_function_index(p: &IrProgram, name: String) -> i32 {
    let mut i = 0
    while i < len(p.functions) {
        if p.functions[i].name == name { return i }
        i = i + 1
    }
    return -1
}

fn cg_is_builtin(name: String) -> bool {
    if name == "print" || name == "println" { return true }
    if name == "eprint" || name == "eprintln" { return true }
    if name == "len" || name == "push" || name == "pop" { return true }
    if name == "exit" { return true }
    if name == "read_file" || name == "read_dir" || name == "write_file" { return true }
    if name == "mkdir" || name == "args" { return true }
    if name == "char_at" || name == "substr" { return true }
    if name == "string_clone" { return true }
    if name == "read_line" || name == "read_bytes" { return true }
    if name == "int_to_string" { return true }
    if name == "exec" { return true }
    if name == "string_free" || name == "array_free" || name == "struct_free" { return true }
    return false
}

fn cg_infer_builtin_call(inst: IrCall, infer: &mut CgInfer) -> bool {
    let mut changed = false
    let name = inst.callee
    if name == "print" || name == "println" || name == "eprint" || name == "eprintln" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "unit") { changed = true }
        }
        return changed
    }
    if name == "len" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "int") { changed = true }
        }
        if len(inst.args) > 0 {
            let at = cg_operand_type(inst.args[0], &infer.temp_types)
            if at != "" {
                let mut base = at
                if cg_is_ref_type(at) { base = cg_ref_base_type(at) }
                if cg_is_array_type(base) || cg_is_string_type(base) {
                    // no-op
                }
            }
        }
        return changed
    }
    if name == "push" {
        if len(inst.args) >= 2 {
            let at = cg_operand_type(inst.args[0], &infer.temp_types)
            let et = cg_operand_type(inst.args[1], &infer.temp_types)
            if at != "" {
                let mut base = at
                if cg_is_ref_type(at) { base = cg_ref_base_type(at) }
                if cg_is_array_type(base) {
                    let elem = cg_array_elem_type(base)
                    if elem != "" && !cg_is_unit_type(elem) && et != "" {
                        if cg_set_temp_type(infer, inst.args[1].temp, elem) { changed = true }
                    } else if elem != "" && !cg_is_unit_type(elem) && et == "" {
                        // infer operand type
                        // no direct place to set const
                    } else if (elem == "" || cg_is_unit_type(elem)) && et != "" {
                        let mut newt = "[" + et + "]"
                        if cg_is_ref_type(at) { newt = "&" + newt }
                        if cg_set_temp_type(infer, inst.args[0].temp, newt) { changed = true }
                    }
                }
            } else if et != "" {
                if inst.args[0].temp >= 0 {
                    let newt = "&[" + et + "]"
                    if cg_set_temp_type(infer, inst.args[0].temp, newt) { changed = true }
                }
            }
        }
        return changed
    }
    if name == "pop" {
        if len(inst.args) >= 1 {
            let at = cg_operand_type(inst.args[0], &infer.temp_types)
            if at != "" {
                let mut base = at
                if cg_is_ref_type(at) { base = cg_ref_base_type(at) }
                if cg_is_array_type(base) {
                    let elem = cg_array_elem_type(base)
                    if elem != "" && !cg_is_unit_type(elem) && inst.dst >= 0 {
                        if cg_set_temp_type(infer, inst.dst, elem) { changed = true }
                    } else if (elem == "" || cg_is_unit_type(elem)) && inst.dst >= 0 {
                        let dt = cg_get_temp_type_at(infer, inst.dst)
                        if dt != "" && inst.args[0].temp >= 0 {
                            let mut newt = "[" + dt + "]"
                            if cg_is_ref_type(at) { newt = "&" + newt }
                            if cg_set_temp_type(infer, inst.args[0].temp, newt) { changed = true }
                        }
                    }
                }
            } else if inst.dst >= 0 {
                let dt = cg_get_temp_type_at(infer, inst.dst)
                if dt != "" && inst.args[0].temp >= 0 {
                    let newt = "&[" + dt + "]"
                    if cg_set_temp_type(infer, inst.args[0].temp, newt) { changed = true }
                }
            }
        }
        return changed
    }
    if name == "args" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "[String]") { changed = true }
        }
        return changed
    }
    if name == "char_at" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "int") { changed = true }
        }
        if len(inst.args) > 0 {
            let t0 = cg_operand_type(inst.args[0], &infer.temp_types)
            if t0 == "" && inst.args[0].temp >= 0 {
                if cg_set_temp_type(infer, inst.args[0].temp, "String") { changed = true }
            }
        }
        if len(inst.args) > 1 {
            let t1 = cg_operand_type(inst.args[1], &infer.temp_types)
            if t1 == "" && inst.args[1].temp >= 0 {
                if cg_set_temp_type(infer, inst.args[1].temp, "int") { changed = true }
            }
        }
        return changed
    }
    if name == "substr" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "String") { changed = true }
        }
        if len(inst.args) > 0 {
            let t0 = cg_operand_type(inst.args[0], &infer.temp_types)
            if t0 == "" && inst.args[0].temp >= 0 {
                if cg_set_temp_type(infer, inst.args[0].temp, "String") { changed = true }
            }
        }
        if len(inst.args) > 1 {
            let t1 = cg_operand_type(inst.args[1], &infer.temp_types)
            if t1 == "" && inst.args[1].temp >= 0 {
                if cg_set_temp_type(infer, inst.args[1].temp, "int") { changed = true }
            }
        }
        if len(inst.args) > 2 {
            let t2 = cg_operand_type(inst.args[2], &infer.temp_types)
            if t2 == "" && inst.args[2].temp >= 0 {
                if cg_set_temp_type(infer, inst.args[2].temp, "int") { changed = true }
            }
        }
        return changed
    }
    if name == "string_clone" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "String") { changed = true }
        }
        return changed
    }
    if name == "read_file" || name == "read_line" || name == "read_bytes" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "String") { changed = true }
        }
        if len(inst.args) > 0 {
            let t0 = cg_operand_type(inst.args[0], &infer.temp_types)
            if name == "read_bytes" {
                if t0 == "" && inst.args[0].temp >= 0 {
                    if cg_set_temp_type(infer, inst.args[0].temp, "int") { changed = true }
                }
            } else {
                if t0 == "" && inst.args[0].temp >= 0 {
                    if cg_set_temp_type(infer, inst.args[0].temp, "String") { changed = true }
                }
            }
        }
        return changed
    }
    if name == "read_dir" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "[String]") { changed = true }
        }
        if len(inst.args) > 0 {
            if inst.args[0].temp >= 0 {
                let t0 = cg_operand_type(inst.args[0], &infer.temp_types)
                if t0 == "" {
                    if cg_set_temp_type(infer, inst.args[0].temp, "String") { changed = true }
                }
            }
        }
        return changed
    }
    if name == "write_file" || name == "mkdir" || name == "exit" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "unit") { changed = true }
        }
        return changed
    }
    if name == "int_to_string" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "String") { changed = true }
        }
        if len(inst.args) > 0 {
            if inst.args[0].temp >= 0 {
                let t0 = cg_operand_type(inst.args[0], &infer.temp_types)
                if t0 == "" {
                    if cg_set_temp_type(infer, inst.args[0].temp, "int") { changed = true }
                }
            }
        }
        return changed
    }
    if name == "exec" {
        if inst.dst >= 0 {
            if cg_set_temp_type(infer, inst.dst, "int") { changed = true }
        }
        if len(inst.args) > 0 && inst.args[0].temp >= 0 {
            let t0 = cg_operand_type(inst.args[0], &infer.temp_types)
            if t0 == "" {
                if cg_set_temp_type(infer, inst.args[0].temp, "String") { changed = true }
            }
        }
        if len(inst.args) > 1 && inst.args[1].temp >= 0 {
            let t1 = cg_operand_type(inst.args[1], &infer.temp_types)
            if t1 == "" {
                if cg_set_temp_type(infer, inst.args[1].temp, "[String]") { changed = true }
            }
        }
        return changed
    }
    return changed
}

fn cg_infer_function_types(p: &IrProgram, f: &IrFunction, seed_fields: &StringMap, struct_fields: &StringListMap, enum_names: & [String], enum_tag_payloads: &StringMap) -> CgInfer {
    let mut temp_types = cg_string_list_new()
    let mut i = 0
    while i < f.temp_count {
        push(&mut temp_types, "")
        i = i + 1
    }
    let mut temp_items = cg_string_list_list_new()
    let mut temp_fields = TempFieldList { items: temp_items }
    i = 0
    while i < f.temp_count {
        let mut empty = cg_string_list_new()
        let mut items = temp_fields.items
        push(&mut items, empty)
        temp_fields.items = items
        i = i + 1
    }
    let mut temp_var = cg_string_list_new()
    i = 0
    while i < f.temp_count {
        push(&mut temp_var, "")
        i = i + 1
    }
    let mut var_fields = string_list_map_new()
    let mut var_types = string_map_new()
    let mut field_types = string_map_new()
    let mut temp_field_types = string_map_new()
    let mut var_field_types = string_map_new()
    let mut temp_closure_funcs = cg_string_list_new()
    i = 0
    while i < f.temp_count {
        push(&mut temp_closure_funcs, "")
        i = i + 1
    }
    let mut var_closure = string_map_new()
    let mut block_tags = string_map_new()
    let mut bi = 0
    while bi < len(f.blocks) {
        let blk = f.blocks[bi]
        let mut tag_temps = cg_int_list_new()
        let mut tag_srcs = cg_int_list_new()
        let mut cmp_temps = cg_int_list_new()
        let mut cmp_tags = cg_string_list_new()
        let mut cmp_srcs = cg_int_list_new()
        let mut cmp_ops = cg_string_list_new()
        let mut j = 0
        while j < len(blk.instrs) {
            match blk.instrs[j] {
                IrInstr.GetField(i2) => {
                    if i2.field == "_tag" {
                        push(&mut tag_temps, i2.dst)
                        push(&mut tag_srcs, i2.src)
                    }
                }
                IrInstr.BinOp(i2) => {
                    if i2.op == "==" || i2.op == "!=" {
                        let mut tag_temp: int = -1
                        let mut tag_val = ""
                        if i2.lhs.is_const && i2.lhs.value.kind == ir_kind_int() && !i2.rhs.is_const {
                            tag_temp = i2.rhs.temp
                            tag_val = int_to_string(i2.lhs.value.int)
                        } else if i2.rhs.is_const && i2.rhs.value.kind == ir_kind_int() && !i2.lhs.is_const {
                            tag_temp = i2.lhs.temp
                            tag_val = int_to_string(i2.rhs.value.int)
                        }
                        if tag_temp >= 0 && tag_val != "" {
                            let mut k = 0
                            let mut src: int = -1
                            while k < len(tag_temps) {
                                if tag_temps[k] == tag_temp {
                                    src = tag_srcs[k]
                                }
                                k = k + 1
                            }
                            if src >= 0 {
                                push(&mut cmp_temps, i2.dst)
                                push(&mut cmp_tags, tag_val)
                                push(&mut cmp_srcs, src)
                                push(&mut cmp_ops, i2.op)
                            }
                        }
                    }
                }
                _ => {}
            }
            j = j + 1
        }
        match blk.term {
            IrTerm.Branch(t2) => {
                if !t2.cond.is_const && t2.cond.temp >= 0 {
                    let mut k = 0
                    while k < len(cmp_temps) {
                        if cmp_temps[k] == t2.cond.temp {
                            let op = cmp_ops[k]
                            let tag = cmp_tags[k]
                            let src = cmp_srcs[k]
                            if src >= 0 && tag != "" {
                                if op == "==" {
                                    let key = cg_block_tag_key(t2.then_label, src)
                                    let _ = string_map_set(&mut block_tags, key, tag)
                                } else if op == "!=" {
                                    let key = cg_block_tag_key(t2.else_label, src)
                                    let _ = string_map_set(&mut block_tags, key, tag)
                                }
                            }
                        }
                        k = k + 1
                    }
                }
            }
            _ => {}
        }
        bi = bi + 1
    }

    // Param types
    i = 0
    while i < len(f.params) {
        if i < len(f.param_types) {
            let pt = cg_normalize_type(f.param_types[i])
            if pt != "" {
                let _ = string_map_set(&mut var_types, f.params[i], pt)
            }
        }
        i = i + 1
    }

    let mut seed_map = string_map_new()
    seed_map.keys = seed_fields.keys
    seed_map.values = seed_fields.values
    let mut infer = CgInfer {
        func_name: f.name,
        temp_types: temp_types,
        var_types: var_types,
        seed_fields: seed_map,
        field_types: field_types,
        temp_field_types: temp_field_types,
        var_field_types: var_field_types,
        temp_closure_funcs: temp_closure_funcs,
        var_closure_funcs: var_closure
    }
    let use_seed = true
    let mut changed = true
    while changed {
        changed = false
        let mut bi = 0
        while bi < len(f.blocks) {
            let blk = f.blocks[bi]
            let mut j = 0
            while j < len(blk.instrs) {
                let inst = blk.instrs[j]
                match inst {
                    IrInstr.LoadVar(i2) => {
                        if i2.ref {
                            let mut rt = ""
                            if i2.ref_temp >= 0 && i2.ref_temp < len(infer.temp_types) { rt = infer.temp_types[i2.ref_temp] }
                            if rt != "" {
                                let mut base = ""
                                if cg_is_ref_type(rt) { base = cg_ref_base_type(rt) }
                                if base != "" {
                                    if cg_set_temp_type(&mut infer, i2.dst, base) { changed = true }
                                }
                            }
                    } else if i2.addr {
                        let vt = cg_get_var_type(&infer, &i2.name)
                        if vt != "" {
                            let rt = "&" + vt
                            if cg_set_temp_type(&mut infer, i2.dst, rt) { changed = true }
                        }
                        let mut tt = ""
                        if i2.dst >= 0 && i2.dst < len(infer.temp_types) { tt = infer.temp_types[i2.dst] }
                        if tt != "" && cg_is_ref_type(tt) {
                            let base = cg_ref_base_type(tt)
                            if base != "" {
                                if cg_set_var_type(&mut infer, i2.name, base) { changed = true }
                            }
                        }
                        } else {
                            let vt = cg_get_var_type(&infer, &i2.name)
                            if vt != "" {
                                if cg_set_temp_type(&mut infer, i2.dst, vt) { changed = true }
                            }
                            let mut tt = ""
                            if i2.dst >= 0 && i2.dst < len(infer.temp_types) { tt = infer.temp_types[i2.dst] }
                            if tt != "" {
                                if cg_set_var_type(&mut infer, i2.name, tt) { changed = true }
                            }
                        }
                        if !i2.addr && !i2.ref && i2.dst >= 0 && i2.dst < len(temp_var) {
                            let mut tv = temp_var
                            tv[i2.dst] = i2.name
                            temp_var = tv
                        }
                        if !i2.addr && !i2.ref && i2.dst >= 0 {
                            let vt = cg_get_var_type(&infer, &i2.name)
                            if vt != "" {
                                let st_name = cg_struct_key_name(vt)
                                let fields = string_list_map_get(struct_fields, &st_name)
                                let mut fi = 0
                                while fi < len(fields) {
                                    let vkey = cg_var_field_key(i2.name, fields[fi])
                                    let ft = string_map_get(&var_field_types, &vkey)
                                    if ft != "" {
                                        let tkey = cg_temp_field_key(i2.dst, fields[fi])
                                        let _ = string_map_set(&mut temp_field_types, tkey, ft)
                                    }
                                    fi = fi + 1
                                }
                            }
                        }
                        // closure propagation
                        if !i2.addr && !i2.ref {
                            let cf = cg_get_var_closure(&infer, i2.name)
                            if cf != "" && i2.dst >= 0 && i2.dst < len(infer.temp_closure_funcs) {
                                if infer.temp_closure_funcs[i2.dst] == "" {
                                    infer.temp_closure_funcs[i2.dst] = cf
                                    changed = true
                                }
                            }
                        }
                    }
                    IrInstr.StoreVar(i2) => {
                        if i2.ref {
                            let mut rt = ""
                            if i2.ref_temp >= 0 && i2.ref_temp < len(infer.temp_types) { rt = infer.temp_types[i2.ref_temp] }
                            let st = cg_operand_type(i2.src, &infer.temp_types)
                            if rt != "" && st != "" {
                                let mut base = ""
                                if cg_is_ref_type(rt) { base = cg_ref_base_type(rt) }
                                if base != "" {
                                    let _ = cg_type_unify(&base, &st)
                                }
                            }
                        } else {
                            let st = cg_operand_type(i2.src, &infer.temp_types)
                            if st != "" {
                                if cg_set_var_type(&mut infer, i2.name, st) { changed = true }
                            }
                            let vt = cg_get_var_type(&infer, &i2.name)
                            if vt != "" && i2.src.temp >= 0 {
                                if cg_set_temp_type(&mut infer, i2.src.temp, vt) { changed = true }
                            }
                            if i2.src.temp >= 0 {
                                let st2 = cg_get_temp_type_at(&infer, i2.src.temp)
                                if st2 != "" {
                                    let st_name = cg_struct_key_name(st2)
                                    let fields = string_list_map_get(struct_fields, &st_name)
                                    let mut fi = 0
                                    while fi < len(fields) {
                                        let tkey = cg_temp_field_key(i2.src.temp, fields[fi])
                                        let ft = string_map_get(&temp_field_types, &tkey)
                                        if ft != "" {
                                            let vkey = cg_var_field_key(i2.name, fields[fi])
                                            let _ = string_map_set(&mut var_field_types, vkey, ft)
                                        }
                                        fi = fi + 1
                                    }
                                }
                            }
                            // closure propagation
                            if i2.src.temp >= 0 && i2.src.temp < len(infer.temp_closure_funcs) {
                                let cf = infer.temp_closure_funcs[i2.src.temp]
                                if cf != "" {
                                    if cg_set_var_closure(&mut infer, i2.name, cf) { changed = true }
                                }
                            }
                        }
                    }
                    IrInstr.BinOp(i2) => {
                        let lt = cg_operand_type(i2.lhs, &infer.temp_types)
                        let rt = cg_operand_type(i2.rhs, &infer.temp_types)
                        if i2.op == "&&" || i2.op == "||" {
                            if cg_set_temp_type(&mut infer, i2.dst, "bool") { changed = true }
                        } else if i2.op == "==" || i2.op == "!=" || i2.op == "<" || i2.op == "<=" || i2.op == ">" || i2.op == ">=" {
                            if cg_set_temp_type(&mut infer, i2.dst, "bool") { changed = true }
                            if lt != "" && rt == "" && i2.rhs.temp >= 0 {
                                if cg_set_temp_type(&mut infer, i2.rhs.temp, lt) { changed = true }
                            }
                            if rt != "" && lt == "" && i2.lhs.temp >= 0 {
                                if cg_set_temp_type(&mut infer, i2.lhs.temp, rt) { changed = true }
                            }
                        } else {
                            if (lt == "String" || rt == "String") && i2.op == "+" {
                                if cg_set_temp_type(&mut infer, i2.dst, "String") { changed = true }
                                if lt == "" && i2.lhs.temp >= 0 {
                                    if cg_set_temp_type(&mut infer, i2.lhs.temp, "String") { changed = true }
                                }
                                if rt == "" && i2.rhs.temp >= 0 {
                                    if cg_set_temp_type(&mut infer, i2.rhs.temp, "String") { changed = true }
                                }
                            } else {
                                if cg_set_temp_type(&mut infer, i2.dst, lt) { changed = true }
                                if lt == "" && rt != "" {
                                    if cg_set_temp_type(&mut infer, i2.lhs.temp, rt) { changed = true }
                                }
                                if rt == "" && lt != "" {
                                    if cg_set_temp_type(&mut infer, i2.rhs.temp, lt) { changed = true }
                                }
                            }
                        }
                    }
                    IrInstr.Call(i2) => {
                        if cg_is_builtin(i2.callee) {
                            if cg_infer_builtin_call(i2, &mut infer) { changed = true }
                        }
                        let fidx = cg_find_function_index(p, i2.callee)
                        if fidx >= 0 {
                            let callee = p.functions[fidx]
                            let mut tv_map = string_map_new()
                            let mut k = 0
                            while k < len(i2.args) && k < len(callee.param_types) {
                                let at = cg_operand_type(i2.args[k], &infer.temp_types)
                                if at != "" {
                                    let _ = cg_bind_type_vars(callee.param_types[k], at, struct_fields, &mut tv_map)
                                }
                                k = k + 1
                            }
                            if i2.dst >= 0 {
                                let mut rt = cg_subst_type(callee.return_type, struct_fields, &tv_map)
                                if rt == "" {
                                    let r0 = cg_normalize_type(callee.return_type)
                                    if r0 == "" {
                                        rt = "unit"
                                    } else if !cg_is_type_var(r0, struct_fields) {
                                        rt = r0
                                    }
                                }
                                if rt == "unit" { rt = "unit" }
                                if rt != "" {
                                    if cg_set_temp_type(&mut infer, i2.dst, rt) { changed = true }
                                }
                            }
                            k = 0
                            while k < len(i2.args) && k < len(callee.param_types) {
                                let mut pt = cg_subst_type(callee.param_types[k], struct_fields, &tv_map)
                                if pt == "" {
                                    let p0 = cg_normalize_type(callee.param_types[k])
                                    if !cg_is_type_var(p0, struct_fields) {
                                        pt = p0
                                    }
                                }
                                if pt != "" {
                                    if i2.args[k].temp >= 0 {
                                        if cg_set_temp_type(&mut infer, i2.args[k].temp, pt) { changed = true }
                                    }
                                }
                                k = k + 1
                            }
                        }
                    }
                    IrInstr.CallClosure(i2) => {
                        // best-effort: infer closure and return types
                        let ct = cg_operand_type(i2.closure, &infer.temp_types)
                        if ct == "" && i2.closure.temp >= 0 {
                            if cg_set_temp_type(&mut infer, i2.closure.temp, "Closure") { changed = true }
                        }
                        if i2.closure.temp >= 0 {
                            let fname = cg_get_temp_closure(&infer, i2.closure.temp)
                            if fname != "" {
                                let fidx = cg_find_function_index(p, fname)
                                if fidx >= 0 && i2.dst >= 0 {
                                    let mut rt = cg_normalize_type(p.functions[fidx].return_type)
                                    if rt == "" { rt = "unit" }
                                    if cg_set_temp_type(&mut infer, i2.dst, rt) { changed = true }
                                }
                            }
                        }
                    }
                    IrInstr.MakeArray(i2) => {
                        let mut elem = ""
                        let mut k = 0
                        while k < len(i2.elems) {
                            let et = cg_operand_type(i2.elems[k], &infer.temp_types)
                            elem = cg_type_unify(&elem, &et)
                            k = k + 1
                        }
                        if elem == "" { elem = "unit" }
                        let at = "[" + elem + "]"
                        if cg_set_temp_type(&mut infer, i2.dst, at) { changed = true }
                    }
                    IrInstr.Index(i2) => {
                        let at = cg_operand_type(i2.array, &infer.temp_types)
                        if at != "" {
                            let mut base = at
                            let mut is_ref = false
                            if cg_is_ref_type(at) { base = cg_ref_base_type(at) }
                            if cg_is_array_type(base) {
                                let elem = cg_array_elem_type(base)
                                if elem != "" {
                                    if cg_set_temp_type(&mut infer, i2.dst, elem) { changed = true }
                                }
                                if cg_is_ref_type(at) { is_ref = true }
                                let dt = cg_get_temp_type_at(&infer, i2.dst)
                                if dt != "" && cg_is_unit_type(elem) {
                                    let mut at2 = "[" + dt + "]"
                                    if is_ref { at2 = "&" + at2 }
                                    if i2.array.temp >= 0 {
                                        if cg_set_temp_type(&mut infer, i2.array.temp, at2) { changed = true }
                                    }
                                }
                            }
                        } else if i2.array.temp >= 0 {
                            let dt = cg_get_temp_type_at(&infer, i2.dst)
                            if dt != "" {
                                let at2 = "[" + dt + "]"
                                if cg_set_temp_type(&mut infer, i2.array.temp, at2) { changed = true }
                            }
                        }
                    }
                    IrInstr.SetIndex(i2) => {
                        let at = cg_operand_type(i2.array, &infer.temp_types)
                        let st = cg_operand_type(i2.src, &infer.temp_types)
                        if at != "" {
                            let mut base = at
                            let mut is_ref = false
                            if cg_is_ref_type(at) { base = cg_ref_base_type(at); is_ref = true }
                            if cg_is_array_type(base) {
                                let elem = cg_array_elem_type(base)
                                if st != "" && cg_is_unit_type(elem) && i2.array.temp >= 0 {
                                    let mut at2 = "[" + st + "]"
                                    if is_ref { at2 = "&" + at2 }
                                    if cg_set_temp_type(&mut infer, i2.array.temp, at2) { changed = true }
                                }
                            }
                        } else if i2.array.temp >= 0 && st != "" {
                            let at2 = "[" + st + "]"
                            if cg_set_temp_type(&mut infer, i2.array.temp, at2) { changed = true }
                        }
                    }
                    IrInstr.MakeStruct(i2) => {
                        let base_name = cg_struct_key_name(i2.name)
                        let mut is_enum = cg_struct_is_enum(enum_names, i2.name)
                        let mut k = 0
                        while k < len(i2.fields) {
                            let ft = cg_operand_type(i2.fields[k].src, &infer.temp_types)
                            let key = cg_field_key(base_name, i2.fields[k].name)
                            let known = cg_get_field_type_seeded(&infer, seed_fields, use_seed, &key)
                            let mut fty = ft
                            if fty == "" && known != "" { fty = known }
                            if fty != "" && i2.dst >= 0 {
                                let tkey = cg_temp_field_key(i2.dst, i2.fields[k].name)
                                let _ = string_map_set(&mut temp_field_types, tkey, fty)
                            }
                            if ft == "" && known != "" && i2.fields[k].src.temp >= 0 {
                                if cg_set_temp_type(&mut infer, i2.fields[k].src.temp, known) { changed = true }
                            }
                            if i2.name == "Closure" && i2.fields[k].name == "func" {
                                if i2.fields[k].src.is_const && i2.fields[k].src.value.kind == ir_kind_string() {
                                    if i2.dst >= 0 && i2.dst < len(infer.temp_closure_funcs) {
                                        if infer.temp_closure_funcs[i2.dst] == "" {
                                            infer.temp_closure_funcs[i2.dst] = i2.fields[k].src.value.str
                                            changed = true
                                        }
                                    }
                                }
                            }
                            k = k + 1
                        }
                        let mut final_name = base_name
                        if !is_enum && base_name != "$Env" && len(i2.fields) > 0 && cg_has_type_args(i2.name) {
                            let mut ok = true
                            let mut sig = ""
                            k = 0
                            while k < len(i2.fields) {
                                let tkey = cg_temp_field_key(i2.dst, i2.fields[k].name)
                                let ft = string_map_get(&temp_field_types, &tkey)
                                if ft == "" { ok = false }
                                if ok {
                                    if sig != "" { sig = sig + "," }
                                    sig = sig + cg_normalize_type(ft)
                                }
                                k = k + 1
                            }
                            if ok {
                                final_name = base_name + "[" + sig + "]"
                            } else {
                                final_name = ""
                            }
                        }
                        if final_name == "" && !is_enum && base_name != "$Env" && !cg_has_type_args(i2.name) {
                            final_name = base_name
                        }
                        if final_name != "" {
                            if cg_set_temp_type(&mut infer, i2.dst, final_name) { changed = true }
                            k = 0
                            while k < len(i2.fields) {
                                let tkey = cg_temp_field_key(i2.dst, i2.fields[k].name)
                                let ft = string_map_get(&temp_field_types, &tkey)
                                if ft != "" && !(is_enum && i2.fields[k].name == "_payload") {
                                    if cg_set_field_type_seeded(&mut infer, seed_fields, use_seed, final_name, i2.fields[k].name, ft) { changed = true }
                                }
                                k = k + 1
                            }
                        } else if is_enum || base_name == "$Env" {
                            if cg_set_temp_type(&mut infer, i2.dst, base_name) { changed = true }
                            k = 0
                            while k < len(i2.fields) {
                                let tkey = cg_temp_field_key(i2.dst, i2.fields[k].name)
                                let ft = string_map_get(&temp_field_types, &tkey)
                                if ft != "" && !(is_enum && i2.fields[k].name == "_payload") {
                                    if cg_set_field_type_seeded(&mut infer, seed_fields, use_seed, base_name, i2.fields[k].name, ft) { changed = true }
                                }
                                k = k + 1
                            }
                        }
                    }
                    IrInstr.GetField(i2) => {
                        let mut hinted = false
                        if i2.src >= 0 && i2.field != "_tag" && i2.field != "_payload" {
                            let _ = cg_temp_field_add(&mut temp_fields, i2.src, i2.field)
                            if i2.src < len(temp_var) {
                                let vname = temp_var[i2.src]
                                if vname != "" {
                                    let _ = string_list_map_add(&mut var_fields, vname, i2.field)
                                }
                            }
                        }
                        let mut st = ""
                        if i2.src >= 0 && i2.src < len(infer.temp_types) { st = infer.temp_types[i2.src] }
                        if st == "" && i2.src >= 0 && i2.src < len(temp_var) {
                            let vname = temp_var[i2.src]
                            if vname != "" {
                                st = cg_get_var_type(&infer, &vname)
                            }
                        }
                        if cg_is_ref_type(st) { st = cg_ref_base_type(st) }
                        let is_enum = cg_struct_is_enum(enum_names, st)
                        if i2.src >= 0 && !(i2.field == "_payload" && is_enum) {
                            let tkey = cg_temp_field_key(i2.src, i2.field)
                            let ft_hint = string_map_get(&temp_field_types, &tkey)
                            if ft_hint != "" {
                                if cg_set_temp_type(&mut infer, i2.dst, ft_hint) { changed = true }
                                hinted = true
                            }
                        }
                        if st != "" {
                            if i2.field != "_payload" || !is_enum {
                                let key = cg_field_key(st, i2.field)
                                let ft = cg_get_field_type_seeded(&infer, seed_fields, use_seed, &key)
                                if ft != "" {
                                    if cg_set_temp_type(&mut infer, i2.dst, ft) { changed = true }
                                } else {
                                    let tt = cg_get_temp_type_at(&infer, i2.dst)
                                    if tt != "" {
                                        if cg_set_field_type_seeded(&mut infer, seed_fields, use_seed, st, i2.field, tt) { changed = true }
                                    }
                                }
                            }
                            if i2.field == "_payload" && is_enum {
                                let mut pt = ""
                                let bkey = cg_block_tag_key(blk.label, i2.src)
                                let tag = string_map_get(&block_tags, &bkey)
                                if tag != "" {
                                    let tkey = cg_enum_tag_key_str(st, tag)
                                    pt = string_map_get(enum_tag_payloads, &tkey)
                                }
                                if pt == "" { pt = cg_payload_type(st) }
                                if cg_set_temp_type(&mut infer, i2.dst, pt) { changed = true }
                            }
                        }
                    }
                    IrInstr.SetField(i2) => {
                        if i2.src >= 0 && i2.field != "_tag" && i2.field != "_payload" {
                            let _ = cg_temp_field_add(&mut temp_fields, i2.src, i2.field)
                            if i2.src < len(temp_var) {
                                let vname = temp_var[i2.src]
                                if vname != "" {
                                    let _ = string_list_map_add(&mut var_fields, vname, i2.field)
                                }
                            }
                        }
                        let mut st = ""
                        if i2.src >= 0 && i2.src < len(infer.temp_types) { st = infer.temp_types[i2.src] }
                        if cg_is_ref_type(st) { st = cg_ref_base_type(st) }
                        let vt = cg_operand_type(i2.value, &infer.temp_types)
                        let is_enum = cg_struct_is_enum(enum_names, st)
                        if i2.src >= 0 && vt != "" && !(i2.field == "_payload" && is_enum) {
                            let tkey = cg_temp_field_key(i2.src, i2.field)
                            let _ = string_map_set(&mut temp_field_types, tkey, vt)
                        }
                        if st != "" && (i2.field != "_payload" || !is_enum) {
                            if vt != "" {
                                if cg_set_field_type_seeded(&mut infer, seed_fields, use_seed, st, i2.field, vt) { changed = true }
                            } else if vt == "" {
                                let key = cg_field_key(st, i2.field)
                                let known = cg_get_field_type_seeded(&infer, seed_fields, use_seed, &key)
                                if known != "" && i2.value.temp >= 0 {
                                    if cg_set_temp_type(&mut infer, i2.value.temp, known) { changed = true }
                                }
                            }
                        }
                    }
                }
                j = j + 1
            }
            match blk.term {
                IrTerm.Return(t2) => {
                    if t2.has_value {
                        let rt = cg_normalize_type(f.return_type)
                        if rt != "" && t2.value.temp >= 0 {
                            if cg_set_temp_type(&mut infer, t2.value.temp, rt) { changed = true }
                        }
                    }
                }
                _ => {}
            }
            bi = bi + 1
        }
        if len(struct_fields.keys) > 0 {
            let mut ti = 0
            while ti < len(temp_fields.items) {
                let mut tt = ""
                if ti < len(infer.temp_types) { tt = infer.temp_types[ti] }
                if tt == "" {
                    let fields = temp_fields.items[ti]
                    if len(fields) > 0 {
                        let guess = cg_guess_struct_type(struct_fields, &fields)
                        if guess != "" {
                            if cg_set_temp_type(&mut infer, ti, guess) { changed = true }
                        }
                    }
                }
                ti = ti + 1
            }
            let mut vi = 0
            while vi < len(var_fields.keys) {
                let vname = var_fields.keys[vi]
                let vt = cg_get_var_type(&infer, &vname)
                if vt == "" {
                    let fields = var_fields.values[vi]
                    if len(fields) > 0 {
                        let guess = cg_guess_struct_type(struct_fields, &fields)
                        if guess != "" {
                            if cg_set_var_type(&mut infer, vname, guess) { changed = true }
                        }
                    }
                }
                vi = vi + 1
            }
        }
    }

    infer.temp_field_types = temp_field_types
    infer.var_field_types = var_field_types
    return infer
}

// =============================================================================
// Name Mangling
// =============================================================================

fn cg_mangle_ident(name: String) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(name) {
        let c = char_at(name, i)
        let is_alnum = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
        if is_alnum {
            out = out + substr(name, i, 1)
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    if out == "" { return "_" }
    if cg_is_c_keyword(out) { return "_" + out }
    return out
}

fn cg_is_c_keyword(name: String) -> bool {
    if name == "int" || name == "bool" || name == "char" || name == "short" || name == "long" { return true }
    if name == "float" || name == "double" || name == "signed" || name == "unsigned" { return true }
    if name == "void" || name == "struct" || name == "union" || name == "enum" { return true }
    if name == "typedef" || name == "static" || name == "const" || name == "volatile" { return true }
    if name == "return" || name == "if" || name == "else" || name == "switch" { return true }
    if name == "case" || name == "for" || name == "while" || name == "do" { return true }
    if name == "break" || name == "continue" || name == "goto" || name == "sizeof" { return true }
    if name == "default" || name == "extern" || name == "register" || name == "auto" { return true }
    return false
}

fn cg_mangle_func(name: String) -> String {
    if name == "print" { return "dast_print" }
    if name == "println" { return "dast_println" }
    if name == "eprint" { return "dast_eprint" }
    if name == "eprintln" { return "dast_eprintln" }
    if name == "len" { return "dast_array_len" }
    if name == "push" { return "dast_array_push" }
    if name == "read_file" { return "dast_read_file" }
    if name == "write_file" { return "dast_write_file" }
    if name == "read_line" { return "dast_read_line" }
    if name == "int_to_string" { return "dast_int_to_string" }
    if name == "panic" { return "dast_panic" }
    if name == "char_at" { return "dast_string_char_at" }
    if name == "substr" { return "dast_string_substr" }
    if name == "exec" { return "dast_exec" }
    return "dast_" + cg_mangle_ident(name)
}

fn cg_mangle_var(name: String) -> String {
    return "v_" + cg_mangle_ident(name)
}

fn cg_mangle_label(name: String) -> String {
    return "L_" + cg_mangle_ident(name)
}

fn cg_c_struct_name(name: String) -> String {
    let n = cg_struct_key_name(name)
    return "Dast_" + cg_mangle_ident(n)
}

fn cg_payload_type(enum_name: String) -> String {
    return cg_struct_key_name(enum_name) + "$payload"
}

fn cg_is_payload_type(t: String) -> bool {
    let s = cg_normalize_type(t)
    return cg_has_suffix(s, "$payload")
}

fn cg_payload_enum_name(t: String) -> String {
    let s = cg_normalize_type(t)
    if !cg_has_suffix(s, "$payload") { return "" }
    return substr(s, 0, len(s) - len("$payload"))
}

fn cg_payload_c_name(enum_name: String) -> String {
    return cg_c_struct_name(enum_name) + "_Payload"
}

fn cg_union_field_name(t: String) -> String {
    let s = cg_normalize_type(t)
    if s == "" || s == "unit" { return "as_unit" }
    if cg_is_ref_type(s) {
        let base = cg_ref_base_type(s)
        return "as_ref_" + cg_mangle_ident(base)
    }
    if cg_is_array_type(s) {
        let base = cg_array_elem_type(s)
        return "as_arr_" + cg_mangle_ident(base)
    }
    return "as_" + cg_mangle_ident(s)
}

fn cg_env_field_name(field: String, typ: String, env_field_types: &StringListMap) -> String {
    let base = cg_mangle_ident(field)
    let types = string_list_map_get(env_field_types, &field)
    if len(types) <= 1 { return base }
    let mut t = typ
    if t == "" { t = "unit" }
    let suffix = cg_union_field_name(t)
    return base + "__" + suffix
}

// =============================================================================
// C Type Mapping Helpers
// =============================================================================

fn cg_c_type(t: String, struct_fields: &StringListMap) -> String {
    let s = cg_normalize_type(t)
    if s == "" { return "int64_t" }
    if cg_is_value_type(s) || cg_is_type_var(s, struct_fields) { cg_die("non-concrete type: " + s); return "int64_t" }
    if cg_is_payload_type(s) {
        let en = cg_payload_enum_name(s)
        return cg_payload_c_name(en)
    }
    if cg_is_ref_type(s) {
        let base = cg_ref_base_type(s)
        if cg_is_value_type(base) || cg_is_type_var(base, struct_fields) { cg_die("non-concrete ref type: " + base); return "void*" }
        if cg_is_struct_type(base) { return cg_c_type(base, struct_fields) }
        return cg_c_type(base, struct_fields) + "*"
    }
    if cg_is_array_type(s) { return "dast_array_t" }
    if cg_is_string_type(s) { return "dast_string_t" }
    if cg_is_bool_type(s) { return "bool" }
    if cg_is_unit_type(s) { return "dast_unit_t" }
    if cg_is_int_type(s) { return cg_map_type(s) }
    if cg_is_struct_type(s) { return cg_c_struct_name(s) + "*" }
    return cg_c_struct_name(s) + "*"
}

fn cg_c_zero(t: String, struct_fields: &StringListMap) -> String {
    let s = cg_normalize_type(t)
    if s == "" { return "0" }
    if cg_is_value_type(s) || cg_is_type_var(s, struct_fields) { cg_die("non-concrete zero for type: " + s); return "0" }
    if cg_is_payload_type(s) { return "(" + cg_c_type(s, struct_fields) + "){0}" }
    if cg_is_bool_type(s) { return "false" }
    if cg_is_int_type(s) { return "0" }
    if cg_is_ref_type(s) { return "0" }
    if cg_is_string_type(s) { return "(dast_string_t){0}" }
    if cg_is_array_type(s) { return "(dast_array_t){0}" }
    if cg_is_unit_type(s) { return "(dast_unit_t){0}" }
    if cg_is_struct_type(s) {
        let key = cg_struct_key_name(s)
        if !cg_string_list_contains(&struct_fields.keys, key) {
            return "0"
        }
        return "(" + cg_c_type(s, struct_fields) + ")calloc(1, sizeof(" + cg_c_struct_name(s) + "))"
    }
    return "0"
}

fn cg_const_literal(v: IrValue, expected: String, struct_fields: &StringListMap) -> String {
    let t = cg_normalize_type(expected)
    if v.kind == ir_kind_int() {
        let mut val = int_to_string(v.int)
        let mut typ = t
        if typ == "" { typ = v.int_type }
        if typ != "" {
            return "(" + cg_c_type(typ, struct_fields) + ")" + val
        }
        return val
    }
    if v.kind == ir_kind_bool() {
        if v.bool { return "true" }
        return "false"
    }
    if v.kind == ir_kind_string() {
        return "dast_string_from_literal(\"" + ir_escape_string(v.str) + "\")"
    }
    return cg_c_zero(t, struct_fields)
}

fn cg_value_wrap(expr: String, typ: String, struct_fields: &StringListMap) -> String {
    let t = cg_normalize_type(typ)
    if cg_is_int_type(t) { return "(dast_value_t){ .i = " + expr + " }" }
    if cg_is_bool_type(t) { return "(dast_value_t){ .b = " + expr + " }" }
    if cg_is_string_type(t) { return "(dast_value_t){ .s = " + expr + " }" }
    if cg_is_array_type(t) { return "(dast_value_t){ .a = " + expr + " }" }
    if cg_is_struct_type(t) { return "(dast_value_t){ .st = " + expr + " }" }
    if cg_is_ref_type(t) { return "(dast_value_t){ .p = " + expr + " }" }
    return "(dast_value_t){ .p = " + expr + " }"
}

fn cg_value_unwrap(expr: String, typ: String, struct_fields: &StringListMap) -> String {
    let t = cg_normalize_type(typ)
    if cg_is_int_type(t) { return expr + ".i" }
    if cg_is_bool_type(t) { return expr + ".b" }
    if cg_is_string_type(t) { return expr + ".s" }
    if cg_is_array_type(t) { return expr + ".a" }
    if cg_is_struct_type(t) { return expr + ".st" }
    if cg_is_ref_type(t) { return "(" + cg_c_type(t, struct_fields) + ")" + expr + ".p" }
    return expr + ".p"
}

fn cg_operand_expr(op: IrOperand, expected: String, temp_types: & [String], struct_fields: &StringListMap) -> String {
    let et = cg_normalize_type(expected)
    let ot = cg_operand_type(op, temp_types)
    if cg_is_value_type(et) || cg_is_type_var(et, struct_fields) {
        cg_die("non-concrete expected type: " + et)
    }
    if cg_is_value_type(ot) || cg_is_type_var(ot, struct_fields) {
        cg_die("non-concrete operand type: " + ot)
    }
    if op.is_const {
        return cg_const_literal(op.value, expected, struct_fields)
    }
    let expr = "t" + int_to_string(op.temp)
    if cg_is_payload_type(ot) && !cg_is_payload_type(et) && et != "" {
        let field = cg_union_field_name(et)
        return expr + "." + field
    }
    return expr
}

// =============================================================================
// Instruction Generation
// =============================================================================

fn cg_struct_setter(t: String) -> String {
    let s = cg_normalize_type(t)
    if cg_is_int_type(s) { return "dast_struct_set_int" }
    if cg_is_bool_type(s) { return "dast_struct_set_bool" }
    if cg_is_string_type(s) { return "dast_struct_set_string" }
    if cg_is_array_type(s) { return "dast_struct_set_array" }
    if cg_is_ref_type(s) { return "dast_struct_set_ref" }
    return "dast_struct_set_struct"
}

fn cg_struct_getter(t: String) -> String {
    let s = cg_normalize_type(t)
    if cg_is_int_type(s) { return "dast_struct_get_int" }
    if cg_is_bool_type(s) { return "dast_struct_get_bool" }
    if cg_is_string_type(s) { return "dast_struct_get_string" }
    if cg_is_array_type(s) { return "dast_struct_get_array" }
    if cg_is_ref_type(s) { return "dast_struct_get_ref" }
    return "dast_struct_get_struct"
}

fn cg_emit_print_args(args: [IrOperand], temp_types: & [String], newline: bool, struct_fields: &StringListMap, use_stderr: bool) -> String {
    let mut out = ""
    let mut fn_print = "dast_print"
    let mut fn_print_cstr = "dast_print_cstr"
    let mut fn_print_int = "dast_print_int"
    let mut fn_print_bool = "dast_print_bool"
    let mut fn_print_newline = "dast_print_newline"
    let mut fn_print_array = "dast_print_array"
    if use_stderr {
        fn_print = "dast_eprint"
        fn_print_cstr = "dast_eprint_cstr"
        fn_print_int = "dast_eprint_int"
        fn_print_bool = "dast_eprint_bool"
        fn_print_newline = "dast_eprint_newline"
        fn_print_array = "dast_eprint_array"
    }
    let mut i = 0
    while i < len(args) {
        if i > 0 {
            out = out + fn_print_cstr + "(\" \"); "
        }
        let t = cg_operand_type(args[i], temp_types)
        let expr = cg_operand_expr(args[i], t, temp_types, struct_fields)
        if cg_is_string_type(t) {
            out = out + fn_print + "(" + expr + "); "
        } else if cg_is_bool_type(t) {
            out = out + fn_print_bool + "(" + expr + "); "
        } else if cg_is_int_type(t) {
            out = out + fn_print_int + "(" + expr + "); "
        } else if cg_is_array_type(t) {
            out = out + fn_print_array + "(&" + expr + "); "
        } else if cg_is_struct_type(t) {
            out = out + fn_print_cstr + "(\"<struct>\"); "
        } else {
            out = out + fn_print_cstr + "(\"<value>\"); "
        }
        i = i + 1
    }
    if newline {
        out = out + fn_print_newline + "();"
    }
    return out
}

fn cg_emit_call(inst: IrCall, infer: &CgInfer, p: &IrProgram, struct_fields: &StringListMap, inst_map: &StringMap) -> String {
    let name = inst.callee
    if name == "print" {
        return cg_emit_print_args(inst.args, &infer.temp_types, false, struct_fields, false)
    }
    if name == "println" {
        return cg_emit_print_args(inst.args, &infer.temp_types, true, struct_fields, false)
    }
    if name == "eprint" {
        return cg_emit_print_args(inst.args, &infer.temp_types, false, struct_fields, true)
    }
    if name == "eprintln" {
        return cg_emit_print_args(inst.args, &infer.temp_types, true, struct_fields, true)
    }
    if name == "len" {
        if len(inst.args) == 0 { return "" }
        let at = cg_operand_type(inst.args[0], &infer.temp_types)
        if at == "" {
            let op = ir_operand_stringify(inst.args[0])
            let fn_name = infer.func_name
            cg_die("len arg type unknown in " + fn_name + " for " + op)
        }
        let mut base = at
        if cg_is_ref_type(at) { base = cg_ref_base_type(at) }
        if !cg_is_array_type(base) && !cg_is_string_type(base) {
            cg_die("len expects String or array, got " + base)
        }
        let arg_expr = cg_operand_expr(inst.args[0], at, &infer.temp_types, struct_fields)
        let mut call = ""
        if cg_is_array_type(base) {
            if cg_is_ref_type(at) {
                call = "dast_array_len(" + arg_expr + ")"
            } else {
                call = "dast_array_len(&" + arg_expr + ")"
            }
        } else {
            if cg_is_ref_type(at) {
                call = "dast_string_len(*" + arg_expr + ")"
            } else {
                call = "dast_string_len(" + arg_expr + ")"
            }
        }
        if inst.dst >= 0 {
            return "t" + int_to_string(inst.dst) + " = " + call + ";"
        }
        return call + ";"
    }
    if name == "push" {
        if len(inst.args) < 2 { return "" }
        let arr_t = cg_operand_type(inst.args[0], &infer.temp_types)
        let elem_t = cg_operand_type(inst.args[1], &infer.temp_types)
        if arr_t == "" { cg_die("push array type unknown") }
        if elem_t == "" { cg_die("push element type unknown") }
        let mut base = arr_t
        if cg_is_ref_type(arr_t) { base = cg_ref_base_type(arr_t) }
        if !cg_is_array_type(base) { cg_die("push expects array, got " + base) }
        let arr_expr = cg_operand_expr(inst.args[0], arr_t, &infer.temp_types, struct_fields)
        let elem_expr = cg_operand_expr(inst.args[1], elem_t, &infer.temp_types, struct_fields)
        let mut arr_ptr = arr_expr
        if !cg_is_ref_type(arr_t) {
            arr_ptr = "&" + arr_expr
        }
        let mut base_id = inst.dst
        if base_id < 0 { base_id = 0 }
        let tmp = "_push" + int_to_string(base_id)
        let ctype = cg_c_type(elem_t, struct_fields)
        return "{ " + ctype + " " + tmp + " = " + elem_expr + "; dast_array_push(" + arr_ptr + ", &" + tmp + "); }"
    }
    if name == "pop" {
        if len(inst.args) < 1 { return "" }
        let arr_t = cg_operand_type(inst.args[0], &infer.temp_types)
        if arr_t == "" { cg_die("pop array type unknown") }
        let arr_expr = cg_operand_expr(inst.args[0], arr_t, &infer.temp_types, struct_fields)
        let mut base = arr_t
        if cg_is_ref_type(arr_t) { base = cg_ref_base_type(arr_t) }
        if !cg_is_array_type(base) { cg_die("pop expects array, got " + base) }
        let mut elem_t = cg_array_elem_type(base)
        if elem_t == "" { cg_die("pop element type unknown") }
        let ctype = cg_c_type(elem_t, struct_fields)
        let mut base_id = inst.dst
        if base_id < 0 { base_id = 0 }
        let tmp = "_pop" + int_to_string(base_id)
        let mut arr_ptr = arr_expr
        if !cg_is_ref_type(arr_t) {
            arr_ptr = "&" + arr_expr
        }
        if inst.dst >= 0 {
            return "{ " + ctype + " " + tmp + "; dast_array_pop(" + arr_ptr + ", &" + tmp + "); t" + int_to_string(inst.dst) + " = " + tmp + "; }"
        }
        return "{ " + ctype + " " + tmp + "; dast_array_pop(" + arr_ptr + ", &" + tmp + "); }"
    }
    if name == "args" {
        if inst.dst >= 0 {
            return "t" + int_to_string(inst.dst) + " = dast_args();"
        }
        return "dast_args();"
    }
    if name == "read_file" {
        let arg = cg_operand_expr(inst.args[0], "String", &infer.temp_types, struct_fields)
        if inst.dst >= 0 {
            return "t" + int_to_string(inst.dst) + " = dast_read_file(" + arg + ");"
        }
        return "dast_read_file(" + arg + ");"
    }
    if name == "read_dir" {
        let arg = cg_operand_expr(inst.args[0], "String", &infer.temp_types, struct_fields)
        if inst.dst >= 0 {
            return "t" + int_to_string(inst.dst) + " = dast_read_dir(" + arg + ");"
        }
        return "dast_read_dir(" + arg + ");"
    }
    if name == "write_file" {
        let a0 = cg_operand_expr(inst.args[0], "String", &infer.temp_types, struct_fields)
        let a1 = cg_operand_expr(inst.args[1], "String", &infer.temp_types, struct_fields)
        return "dast_write_file(" + a0 + ", " + a1 + ");"
    }
    if name == "mkdir" {
        let a0 = cg_operand_expr(inst.args[0], "String", &infer.temp_types, struct_fields)
        return "dast_mkdir(" + a0 + ");"
    }
    if name == "read_line" {
        if inst.dst >= 0 { return "t" + int_to_string(inst.dst) + " = dast_read_line();" }
        return "dast_read_line();"
    }
    if name == "read_bytes" {
        let a0 = cg_operand_expr(inst.args[0], "int", &infer.temp_types, struct_fields)
        if inst.dst >= 0 { return "t" + int_to_string(inst.dst) + " = dast_read_bytes(" + a0 + ");" }
        return "dast_read_bytes(" + a0 + ");"
    }
    if name == "char_at" {
        let a0 = cg_operand_expr(inst.args[0], "String", &infer.temp_types, struct_fields)
        let a1 = cg_operand_expr(inst.args[1], "int", &infer.temp_types, struct_fields)
        if inst.dst >= 0 { return "t" + int_to_string(inst.dst) + " = dast_string_char_at(" + a0 + ", " + a1 + ");" }
        return "dast_string_char_at(" + a0 + ", " + a1 + ");"
    }
    if name == "substr" {
        let a0 = cg_operand_expr(inst.args[0], "String", &infer.temp_types, struct_fields)
        let a1 = cg_operand_expr(inst.args[1], "int", &infer.temp_types, struct_fields)
        let a2 = cg_operand_expr(inst.args[2], "int", &infer.temp_types, struct_fields)
        if inst.dst >= 0 { return "t" + int_to_string(inst.dst) + " = dast_string_substr(" + a0 + ", " + a1 + ", " + a2 + ");" }
        return "dast_string_substr(" + a0 + ", " + a1 + ", " + a2 + ");"
    }
    if name == "string_clone" {
        let at = cg_operand_type(inst.args[0], &infer.temp_types)
        let a0 = cg_operand_expr(inst.args[0], at, &infer.temp_types, struct_fields)
        let mut call = ""
        if cg_is_ref_type(at) {
            call = "dast_string_clone(*" + a0 + ")"
        } else {
            call = "dast_string_clone(" + a0 + ")"
        }
        if inst.dst >= 0 { return "t" + int_to_string(inst.dst) + " = " + call + ";" }
        return call + ";"
    }
    if name == "string_free" {
        let at = cg_operand_type(inst.args[0], &infer.temp_types)
        let a0 = cg_operand_expr(inst.args[0], at, &infer.temp_types, struct_fields)
        if cg_is_ref_type(at) {
            return "dast_string_free(*" + a0 + ");"
        }
        return "dast_string_free(" + a0 + ");"
    }
    if name == "array_free" {
        let at = cg_operand_type(inst.args[0], &infer.temp_types)
        let a0 = cg_operand_expr(inst.args[0], at, &infer.temp_types, struct_fields)
        if cg_is_ref_type(at) {
            return "dast_array_free(*" + a0 + ");"
        }
        return "dast_array_free(" + a0 + ");"
    }
    if name == "struct_free" {
        let at = cg_operand_type(inst.args[0], &infer.temp_types)
        let a0 = cg_operand_expr(inst.args[0], at, &infer.temp_types, struct_fields)
        if cg_is_ref_type(at) {
            return "dast_struct_free(*" + a0 + ");"
        }
        return "dast_struct_free(" + a0 + ");"
    }
    if name == "int_to_string" {
        let a0 = cg_operand_expr(inst.args[0], "int", &infer.temp_types, struct_fields)
        if inst.dst >= 0 { return "t" + int_to_string(inst.dst) + " = dast_int_to_string(" + a0 + ");" }
        return "dast_int_to_string(" + a0 + ");"
    }
    if name == "exec" {
        let a0 = cg_operand_expr(inst.args[0], "String", &infer.temp_types, struct_fields)
        let a1 = cg_operand_expr(inst.args[1], "[String]", &infer.temp_types, struct_fields)
        if inst.dst >= 0 { return "t" + int_to_string(inst.dst) + " = dast_exec(" + a0 + ", " + a1 + ");" }
        return "dast_exec(" + a0 + ", " + a1 + ");"
    }
    if name == "exit" {
        if len(inst.args) == 0 { return "dast_exit(0);" }
        let a0 = cg_operand_expr(inst.args[0], "int", &infer.temp_types, struct_fields)
        return "dast_exit(" + a0 + ");"
    }

    // User function call (instantiated)
    let resolved = cg_resolve_call_instance(inst, &infer, p, struct_fields, inst_map)
    let mut args = ""
    let mut j = 0
    while j < len(inst.args) {
        if j > 0 { args = args + ", " }
        let mut expected = ""
        if j < len(resolved.param_types) { expected = resolved.param_types[j] }
        args = args + cg_operand_expr(inst.args[j], expected, &infer.temp_types, struct_fields)
        j = j + 1
    }
    let call = cg_mangle_func(resolved.name) + "(" + args + ")"
    if inst.dst >= 0 {
        let mut ret = cg_normalize_type(resolved.return_type)
        if ret == "" || ret == "unit" {
            return "{ " + call + "; t" + int_to_string(inst.dst) + " = (dast_unit_t){0}; }"
        }
        return "t" + int_to_string(inst.dst) + " = " + call + ";"
    }
    return call + ";"
}

fn cg_emit_call_closure(inst: IrCallClosure, infer: &CgInfer, p: &IrProgram, closure_funcs: & [String], struct_fields: &StringListMap) -> String {
    let ct = cg_operand_type(inst.closure, &infer.temp_types)
    let closure_expr = cg_operand_expr(inst.closure, ct, &infer.temp_types, struct_fields)
    let mut func_name = cg_get_temp_closure(infer, inst.closure.temp)
    let mut out = ""
    let mut env_expr = closure_expr + ".env"
    let mut func_expr = closure_expr + ".func"
    if cg_is_ref_type(ct) || cg_is_struct_type(ct) {
        env_expr = closure_expr + "->env"
        func_expr = closure_expr + "->func"
    }
    if func_name != "" {
        let mut args = env_expr
        let mut j = 0
        while j < len(inst.args) {
            args = args + ", " + cg_operand_expr(inst.args[j], "", &infer.temp_types, struct_fields)
            j = j + 1
        }
        let call = cg_mangle_func(func_name) + "(" + args + ")"
        if inst.dst >= 0 {
            let fidx = cg_find_function_index(p, func_name)
            let mut ret = ""
            if fidx >= 0 { ret = cg_normalize_type(p.functions[fidx].return_type) }
            if ret == "" || ret == "unit" {
                out = "{ " + call + "; t" + int_to_string(inst.dst) + " = (dast_unit_t){0}; }"
            } else if cg_is_value_type(ret) || cg_is_type_var(ret, struct_fields) {
                cg_die("non-concrete closure return type: " + ret)
            } else {
                out = "t" + int_to_string(inst.dst) + " = " + call + ";"
            }
        } else {
            out = call + ";"
        }
        return out
    }

    // Fallback: dispatch by function name
    out = "{ dast_string_t _fn = " + func_expr + "; " + cg_c_type("Env", struct_fields) + " _env = " + env_expr + "; "
    let mut i = 0
    while i < len(closure_funcs) {
        let fname = closure_funcs[i]
        let mut args = "_env"
        let mut j = 0
        while j < len(inst.args) {
            args = args + ", " + cg_operand_expr(inst.args[j], "", &infer.temp_types, struct_fields)
            j = j + 1
        }
        let call = cg_mangle_func(fname) + "(" + args + ")"
        if i == 0 {
            out = out + "if (dast_string_eq_cstr(_fn, \"" + fname + "\")) { "
        } else {
            out = out + "else if (dast_string_eq_cstr(_fn, \"" + fname + "\")) { "
        }
        if inst.dst >= 0 {
            let fidx = cg_find_function_index(p, fname)
            let mut ret = ""
            if fidx >= 0 { ret = cg_normalize_type(p.functions[fidx].return_type) }
            if ret == "" || ret == "unit" {
                out = out + call + "; t" + int_to_string(inst.dst) + " = (dast_unit_t){0}; } "
            } else if cg_is_value_type(ret) || cg_is_type_var(ret, struct_fields) {
                cg_die("non-concrete closure return type: " + ret)
            } else {
                out = out + "t" + int_to_string(inst.dst) + " = " + call + "; } "
            }
        } else {
            out = out + call + "; } "
        }
        i = i + 1
    }
    out = out + "else { dast_panic(dast_string_from_literal(\"unknown closure\")); } }"
    return out
}

fn cg_instr(inst: IrInstr, infer: &CgInfer, p: &IrProgram, closure_funcs: & [String], struct_fields: &StringListMap, enum_names: & [String], env_field_types: &StringListMap, inst_map: &StringMap) -> String {
    let temp_field_map = infer.temp_field_types
    match inst {
        IrInstr.LoadVar(i) => {
            if i.ref {
                let rt = cg_get_temp_type_at(infer, i.ref_temp)
                let mut base = rt
                if cg_is_ref_type(base) { base = cg_ref_base_type(base) }
                if cg_is_struct_type(base) {
                    return "t" + int_to_string(i.dst) + " = t" + int_to_string(i.ref_temp) + ";"
                }
                return "t" + int_to_string(i.dst) + " = *t" + int_to_string(i.ref_temp) + ";"
            }
            if i.addr {
                let vt = cg_get_var_type(infer, &i.name)
                let mut base = vt
                if cg_is_ref_type(base) { base = cg_ref_base_type(base) }
                if cg_is_struct_type(base) {
                    return "t" + int_to_string(i.dst) + " = " + cg_mangle_var(i.name) + ";"
                }
                return "t" + int_to_string(i.dst) + " = &" + cg_mangle_var(i.name) + ";"
            }
            return "t" + int_to_string(i.dst) + " = " + cg_mangle_var(i.name) + ";"
        }
        IrInstr.StoreVar(i) => {
            if i.ref {
                let st = cg_operand_expr(i.src, "", &infer.temp_types, struct_fields)
                let rt = cg_get_temp_type_at(infer, i.ref_temp)
                let mut base = rt
                if cg_is_ref_type(base) { base = cg_ref_base_type(base) }
                if cg_is_struct_type(base) {
                    return "t" + int_to_string(i.ref_temp) + " = " + st + ";"
                }
                return "*t" + int_to_string(i.ref_temp) + " = " + st + ";"
            }
            let st = cg_operand_expr(i.src, "", &infer.temp_types, struct_fields)
            return cg_mangle_var(i.name) + " = " + st + ";"
        }
        IrInstr.BinOp(i) => {
            let lt = cg_operand_type(i.lhs, &infer.temp_types)
            let rt = cg_operand_type(i.rhs, &infer.temp_types)
            let l = cg_operand_expr(i.lhs, lt, &infer.temp_types, struct_fields)
            let r = cg_operand_expr(i.rhs, rt, &infer.temp_types, struct_fields)
            if i.op == "+" && (lt == "String" || rt == "String") {
                return "t" + int_to_string(i.dst) + " = dast_string_concat(" + l + ", " + r + ");"
            }
            if (i.op == "==" || i.op == "!=") && (lt == "String" || rt == "String") {
                let eq = "dast_string_eq(" + l + ", " + r + ")"
                if i.op == "!=" {
                    return "t" + int_to_string(i.dst) + " = !" + eq + ";"
                }
                return "t" + int_to_string(i.dst) + " = " + eq + ";"
            }
            return "t" + int_to_string(i.dst) + " = " + l + " " + i.op + " " + r + ";"
        }
        IrInstr.Call(i) => { return cg_emit_call(i, infer, p, struct_fields, inst_map) }
        .CallClosure(i) => { return cg_emit_call_closure(i, infer, p, closure_funcs, struct_fields) }
        IrInstr.MakeArray(i) => {
            let at = cg_get_temp_type_at(infer, i.dst)
            if !cg_is_array_type(at) {
                cg_die("array type unknown for t" + int_to_string(i.dst))
            }
            let mut elem = cg_array_elem_type(at)
            if elem == "" { cg_die("array element type unknown for t" + int_to_string(i.dst)) }
            let ctype = cg_c_type(elem, struct_fields)
            let mut out = "t" + int_to_string(i.dst) + " = dast_array_new(sizeof(" + ctype + "));"
            let mut j = 0
            while j < len(i.elems) {
                let eexpr = cg_operand_expr(i.elems[j], elem, &infer.temp_types, struct_fields)
                let tmp = "_e" + int_to_string(i.dst) + "_" + int_to_string(j)
                out = out + " { " + ctype + " " + tmp + " = " + eexpr + "; dast_array_push(&t" + int_to_string(i.dst) + ", &" + tmp + "); }"
                j = j + 1
            }
            return out
        }
        IrInstr.Index(i) => {
            let at = cg_operand_type(i.array, &infer.temp_types)
            let mut base = at
            if cg_is_ref_type(at) { base = cg_ref_base_type(at) }
            if !cg_is_array_type(base) {
                cg_die("index requires array type, got " + base)
            }
            let mut elem = cg_array_elem_type(base)
            if elem == "" { cg_die("array element type unknown for index") }
            let ctype = cg_c_type(elem, struct_fields)
            let arr = cg_operand_expr(i.array, at, &infer.temp_types, struct_fields)
            let idx = cg_operand_expr(i.index, "int", &infer.temp_types, struct_fields)
            let mut arr_expr = arr
            if cg_is_ref_type(at) {
                arr_expr = "*" + arr
            }
            if i.unchecked {
                return "t" + int_to_string(i.dst) + " = ((" + ctype + "*)(" + arr_expr + ").data)[" + idx + "];"
            }
            return "t" + int_to_string(i.dst) + " = *(" + ctype + "*)dast_array_get(&" + arr_expr + ", " + idx + ");"
        }
        IrInstr.SetIndex(i) => {
            let at = cg_operand_type(i.array, &infer.temp_types)
            let mut base = at
            if cg_is_ref_type(at) { base = cg_ref_base_type(at) }
            if !cg_is_array_type(base) {
                cg_die("set_index requires array type, got " + base)
            }
            let mut elem = cg_array_elem_type(base)
            if elem == "" { cg_die("array element type unknown for set_index") }
            let ctype = cg_c_type(elem, struct_fields)
            let arr = cg_operand_expr(i.array, at, &infer.temp_types, struct_fields)
            let idx = cg_operand_expr(i.index, "int", &infer.temp_types, struct_fields)
            let src = cg_operand_expr(i.src, elem, &infer.temp_types, struct_fields)
            let mut arr_expr = arr
            if cg_is_ref_type(at) {
                arr_expr = "*" + arr
            }
            if i.unchecked {
                return "((" + ctype + "*)(" + arr_expr + ").data)[" + idx + "] = " + src + ";"
            }
            return "{ " + ctype + " _v = " + src + "; dast_array_set(&" + arr_expr + ", " + idx + ", &_v); }"
        }
        IrInstr.MakeStruct(i) => {
            let mut st = i.name
            if i.dst >= 0 && i.dst < len(infer.temp_types) {
                let tt = infer.temp_types[i.dst]
                if tt != "" { st = tt }
            }
            let is_enum = cg_struct_is_enum(enum_names, st)
            let is_env = cg_struct_key_name(st) == "$Env"
            let ctype = cg_c_type(st, struct_fields)
            let cname = cg_c_struct_name(st)
            let mut out = "t" + int_to_string(i.dst) + " = (" + ctype + ")calloc(1, sizeof(" + cname + "));"
            let mut access = "t" + int_to_string(i.dst) + "->"
            let mut j = 0
            while j < len(i.fields) {
                let f = i.fields[j]
                let mut ft = cg_operand_type(f.src, &infer.temp_types)
                let key = cg_field_key(st, f.name)
                let mapped = cg_get_field_type(infer, &key)
                if mapped != "" { ft = mapped }
                if is_enum && f.name == "_tag" {
                    let val = cg_operand_expr(f.src, ft, &infer.temp_types, struct_fields)
                    out = out + " " + access + "_tag = " + val + ";"
                } else if is_enum && f.name == "_payload" {
                    let mut pt = cg_operand_type(f.src, &infer.temp_types)
                    if ft == "" && pt != "" { ft = pt }
                    if ft == "" { ft = "unit" }
                    let mut ut = pt
                    if ut == "" { ut = ft }
                    let val = cg_operand_expr(f.src, ut, &infer.temp_types, struct_fields)
                    if cg_is_payload_type(pt) {
                        out = out + " " + access + "_payload = " + val + ";"
                    } else if !cg_is_unit_type(ut) {
                        let uf = cg_union_field_name(ut)
                        out = out + " " + access + "_payload." + uf + " = " + val + ";"
                    }
                } else if is_env {
                    let types = string_list_map_get(env_field_types, &f.name)
                    if len(types) > 1 {
                        let mut pt = ft
                        if pt == "" { pt = "unit" }
                        if pt == "" && len(types) > 0 { pt = types[0] }
                        let field_id = cg_env_field_name(f.name, pt, env_field_types)
                        let val = cg_operand_expr(f.src, pt, &infer.temp_types, struct_fields)
                        out = out + " " + access + field_id + " = " + val + ";"
                    } else {
                        let val = cg_operand_expr(f.src, ft, &infer.temp_types, struct_fields)
                        let field_id = cg_mangle_ident(f.name)
                        out = out + " " + access + field_id + " = " + val + ";"
                    }
                } else {
                    let val = cg_operand_expr(f.src, ft, &infer.temp_types, struct_fields)
                    let field = cg_mangle_ident(f.name)
                    out = out + " " + access + field + " = " + val + ";"
                }
                j = j + 1
            }
            return out
        }
        IrInstr.GetField(i) => {
            let mut st = ""
            if i.src >= 0 && i.src < len(infer.temp_types) { st = infer.temp_types[i.src] }
            let mut recv = "t" + int_to_string(i.src)
            let mut access = recv + "."
            let mut base = st
            let mut was_ref = false
            if cg_is_ref_type(st) {
                was_ref = true
                base = cg_ref_base_type(st)
            }
            let is_struct = cg_is_struct_type(base) || cg_struct_is_enum(enum_names, base)
            if is_struct {
                access = recv + "->"
            } else if was_ref {
                access = recv + "->"
            }
            let key = cg_field_key(base, i.field)
            let mut ft = ""
            if i.src >= 0 {
                let tkey = cg_temp_field_key(i.src, i.field)
                ft = string_map_get(&temp_field_map, &tkey)
            }
            if ft == "" {
                ft = cg_get_field_type(infer, &key)
            }
            let is_enum = cg_struct_is_enum(enum_names, base)
            if i.field == "_tag" && is_enum {
                return "t" + int_to_string(i.dst) + " = " + access + "_tag;"
            }
            if i.field == "_payload" && is_enum {
                let mut pt = cg_get_temp_type_at(infer, i.dst)
                if pt == "" { pt = ft }
                if cg_is_payload_type(pt) {
                    return "t" + int_to_string(i.dst) + " = " + access + "_payload;"
                }
                if pt == "" { pt = "unit" }
                if cg_is_unit_type(pt) {
                    return "t" + int_to_string(i.dst) + " = (dast_unit_t){0};"
                }
                let uf = cg_union_field_name(pt)
                return "t" + int_to_string(i.dst) + " = " + access + "_payload." + uf + ";"
            }
            if cg_struct_key_name(base) == "$Env" {
                let types = string_list_map_get(env_field_types, &i.field)
                if len(types) > 1 {
                    let mut pt = cg_get_temp_type_at(infer, i.dst)
                    if pt == "" { pt = ft }
                    if pt == "" && len(types) > 0 { pt = types[0] }
                    if pt == "" { pt = "unit" }
                    let field_id = cg_env_field_name(i.field, pt, env_field_types)
                    return "t" + int_to_string(i.dst) + " = " + access + field_id + ";"
                }
            }
            let field = cg_mangle_ident(i.field)
            if ft == "" {
                let dt = cg_get_temp_type_at(infer, i.dst)
                if dt != "" { ft = dt }
            }
            if ft == "" { cg_die("unknown field type for " + key) }
            return "t" + int_to_string(i.dst) + " = " + access + field + ";"
        }
        IrInstr.SetField(i) => {
            let mut st = ""
            if i.src >= 0 && i.src < len(infer.temp_types) { st = infer.temp_types[i.src] }
            let mut recv = "t" + int_to_string(i.src)
            let mut access = recv + "."
            let mut base = st
            let mut was_ref = false
            if cg_is_ref_type(st) {
                was_ref = true
                base = cg_ref_base_type(st)
            }
            let is_struct = cg_is_struct_type(base) || cg_struct_is_enum(enum_names, base)
            if is_struct {
                access = recv + "->"
            } else if was_ref {
                access = recv + "->"
            }
            let is_enum = cg_struct_is_enum(enum_names, base)
            if i.field == "_tag" && is_enum {
                let key = cg_field_key(base, i.field)
                let ft = cg_get_field_type(infer, &key)
                let val = cg_operand_expr(i.value, ft, &infer.temp_types, struct_fields)
                return access + "_tag = " + val + ";"
            }
            if i.field == "_payload" && is_enum {
                let mut pt = cg_operand_type(i.value, &infer.temp_types)
                if pt == "" {
                    let key = cg_field_key(base, i.field)
                    pt = cg_get_field_type(infer, &key)
                }
                if pt == "" { pt = "unit" }
                if cg_is_payload_type(pt) {
                    let val = cg_operand_expr(i.value, pt, &infer.temp_types, struct_fields)
                    return access + "_payload = " + val + ";"
                }
                if cg_is_unit_type(pt) {
                    return access + "_payload.as_unit = (dast_unit_t){0};"
                }
                let uf = cg_union_field_name(pt)
                let val = cg_operand_expr(i.value, pt, &infer.temp_types, struct_fields)
                return access + "_payload." + uf + " = " + val + ";"
            }
            if cg_struct_key_name(base) == "$Env" {
                let types = string_list_map_get(env_field_types, &i.field)
                if len(types) > 1 {
                    let mut pt = cg_operand_type(i.value, &infer.temp_types)
                    if pt == "" {
                        let key = cg_field_key(base, i.field)
                        pt = cg_get_field_type(infer, &key)
                    }
                    if pt == "" && len(types) > 0 { pt = types[0] }
                    if pt == "" { pt = "unit" }
                    let val = cg_operand_expr(i.value, pt, &infer.temp_types, struct_fields)
                    let field_id = cg_env_field_name(i.field, pt, env_field_types)
                    return access + field_id + " = " + val + ";"
                }
            }
            let key = cg_field_key(base, i.field)
            let mut ft = ""
            if i.src >= 0 {
                let tkey = cg_temp_field_key(i.src, i.field)
                ft = string_map_get(&temp_field_map, &tkey)
            }
            if ft == "" { ft = cg_get_field_type(infer, &key) }
            if ft == "" {
                let stype = cg_operand_type(i.value, &infer.temp_types)
                if stype != "" { ft = stype }
            }
            if ft == "" { cg_die("unknown field type for " + key) }
            let val = cg_operand_expr(i.value, ft, &infer.temp_types, struct_fields)
            let field = cg_mangle_ident(i.field)
            return access + field + " = " + val + ";"
        }
    }
    return "/* unknown */"
}

// =============================================================================
// Terminator Generation
// =============================================================================

fn cg_term(term: IrTerm, infer: &CgInfer, f: &IrFunction, struct_fields: &StringListMap) -> String {
    match term {
        .None(_) => { return "" }
        .Jump(t) => { return "goto " + cg_mangle_label(t.target) + ";" }
        .Branch(t) => {
            let cond = cg_operand_expr(t.cond, "bool", &infer.temp_types, struct_fields)
            return "if (" + cond + ") goto " + cg_mangle_label(t.then_label) + "; else goto " + cg_mangle_label(t.else_label) + ";"
        }
        IrTerm.Return(t) => {
            let ret_t = cg_normalize_type(f.return_type)
            if ret_t == "" || ret_t == "unit" {
                return "return;"
            }
            if t.has_value {
                let expr = cg_operand_expr(t.value, ret_t, &infer.temp_types, struct_fields)
                return "return " + expr + ";"
            }
            return "return " + cg_c_zero(ret_t, struct_fields) + ";"
        }
    }
}

// =============================================================================
// Function Generation
// =============================================================================

fn cg_collect_vars(f: &IrFunction) -> [String] {
    let mut vars = cg_string_list_new()
    let mut i = 0
    while i < len(f.blocks) {
        let blk = f.blocks[i]
        let mut j = 0
        while j < len(blk.instrs) {
            match blk.instrs[j] {
                IrInstr.LoadVar(x) => {
                    if x.name != "" && !cg_string_list_contains(&vars, string_clone(&x.name)) { push(&mut vars, x.name) }
                }
                IrInstr.StoreVar(x) => {
                    if x.name != "" && !cg_string_list_contains(&vars, string_clone(&x.name)) { push(&mut vars, x.name) }
                }
                _ => {}
            }
            j = j + 1
        }
        i = i + 1
    }
    return vars
}

fn cg_is_param(f: &IrFunction, name: String) -> bool {
    let mut i = 0
    while i < len(f.params) {
        if f.params[i] == name { return true }
        i = i + 1
    }
    return false
}

fn cg_collect_closure_funcs(funcs: & [IrFunction]) -> [String] {
    let mut out = cg_string_list_new()
    let mut i = 0
    while i < len(funcs) {
        let f = funcs[i]
        if len(f.param_types) > 0 {
            let t0 = cg_struct_key_name(cg_normalize_type(f.param_types[0]))
            if t0 == "$Env" {
                push(&mut out, f.name)
            }
        }
        i = i + 1
    }
    return out
}

fn cg_find_function_index_list(funcs: & [IrFunction], name: String) -> i32 {
    let mut i = 0
    while i < len(funcs) {
        if funcs[i].name == name { return i }
        i = i + 1
    }
    return -1
}

fn cg_reachable_functions(funcs: & [IrFunction], entry: String, closure_funcs: & [String]) -> [IrFunction] {
    if entry == "" {
        let mut out: [IrFunction] = []
        let mut i = 0
        while i < len(funcs) {
            push(&mut out, funcs[i])
            i = i + 1
        }
        return out
    }
    let mut seen = cg_string_list_new()
    let mut work = cg_string_list_new()
    let mut i = 0
    while i < len(closure_funcs) {
        let name = closure_funcs[i]
        if name != "" && !cg_string_list_contains(&seen, string_clone(&name)) {
            push(&mut seen, name)
            push(&mut work, name)
        }
        i = i + 1
    }
    if !cg_string_list_contains(&seen, string_clone(&entry)) {
        push(&mut seen, entry)
        push(&mut work, entry)
    }
    while len(work) > 0 {
        let idx = len(work) - 1
        let name = work[idx]
        pop(&mut work)
        let fidx = cg_find_function_index_list(funcs, name)
        if fidx < 0 { continue }
        let f = funcs[fidx]
        let mut bi = 0
        while bi < len(f.blocks) {
            let blk = f.blocks[bi]
            let mut j = 0
            while j < len(blk.instrs) {
                match blk.instrs[j] {
                    IrInstr.Call(i2) => {
                        let callee = i2.callee
                        if callee != "" && !cg_is_builtin(callee) && !cg_string_list_contains(&seen, string_clone(&callee)) {
                            push(&mut seen, callee)
                            push(&mut work, callee)
                        }
                    }
                    IrInstr.MakeStruct(i2) => {
                        if i2.name == "Closure" {
                            let mut k = 0
                            while k < len(i2.fields) {
                                let field = i2.fields[k]
                                if field.name == "func" && field.src.is_const && field.src.value.kind == ir_kind_string() {
                                    let fname = field.src.value.str
                                    if fname != "" && !cg_string_list_contains(&seen, string_clone(&fname)) {
                                        push(&mut seen, fname)
                                        push(&mut work, fname)
                                    }
                                }
                                k = k + 1
                            }
                        }
                    }
                    _ => {}
                }
                j = j + 1
            }
            bi = bi + 1
        }
    }
    let mut out: [IrFunction] = []
    i = 0
    while i < len(funcs) {
        if cg_string_list_contains(&seen, string_clone(&funcs[i].name)) {
            push(&mut out, funcs[i])
        }
        i = i + 1
    }
    return out
}

fn cg_function(p: &IrProgram, f: &IrFunction, field_types: &StringMap, struct_fields: &StringListMap, enum_names: & [String], env_field_types: &StringListMap, enum_tag_payloads: &StringMap, inst_map: &StringMap, closure_funcs: & [String]) -> String {
    let infer = cg_infer_function_types(p, f, field_types, struct_fields, enum_names, enum_tag_payloads)

    let mut ret_type = "void"
    if f.return_type != "" && f.return_type != "unit" {
        ret_type = cg_c_type(f.return_type, struct_fields)
    }

    let mut params = ""
    let mut i = 0
    while i < len(f.params) {
        if i > 0 { params = params + ", " }
        let mut ptype = "int64_t"
        if i < len(f.param_types) {
            if f.param_types[i] != "" {
                ptype = cg_c_type(f.param_types[i], struct_fields)
            }
        }
        params = params + ptype + " " + cg_mangle_var(f.params[i])
        i = i + 1
    }
    if params == "" { params = "void" }

    let mut out = ret_type + " " + cg_mangle_func(f.name) + "(" + params + ") {\n"

    // Declare locals
    let vars = cg_collect_vars(f)
    let mut vi = 0
    while vi < len(vars) {
        let vname = vars[vi]
        if !cg_is_param(f, vname) {
            let vt = cg_get_var_type(&infer, &vname)
            let ctype = cg_c_type(vt, struct_fields)
            out = out + "    " + ctype + " " + cg_mangle_var(vname) + " = " + cg_c_zero(vt, struct_fields) + ";\n"
        }
        vi = vi + 1
    }

    // Declare temps
    if f.temp_count > 0 {
        i = 0
        while i < f.temp_count {
            let mut tt = ""
            if i < len(infer.temp_types) { tt = infer.temp_types[i] }
            let ctype = cg_c_type(tt, struct_fields)
            out = out + "    " + ctype + " t" + int_to_string(i) + " = " + cg_c_zero(tt, struct_fields) + ";\n"
            i = i + 1
        }
        out = out + "\n"
    }

    // Generate blocks
    i = 0
    while i < len(f.blocks) {
        let blk = f.blocks[i]
        out = out + cg_mangle_label(blk.label) + ":;\n"

        let mut j = 0
        while j < len(blk.instrs) {
            out = out + "    " + cg_instr(blk.instrs[j], &infer, p, closure_funcs, struct_fields, enum_names, env_field_types, inst_map) + "\n"
            j = j + 1
        }

        let term = cg_term(blk.term, &infer, f, struct_fields)
        if term != "" {
            out = out + "    " + term + "\n"
        }
        out = out + "\n"
        i = i + 1
    }

    out = out + "}\n"
    return out
}

fn cg_function_emit(p: &IrProgram, f: &IrFunction, field_types: &StringMap, struct_fields: &StringListMap, enum_names: & [String], env_field_types: &StringListMap, enum_tag_payloads: &StringMap, inst_map: &StringMap, closure_funcs: & [String]) {
    let infer = cg_infer_function_types(p, f, field_types, struct_fields, enum_names, enum_tag_payloads)

    let mut ret_type = "void"
    if f.return_type != "" && f.return_type != "unit" {
        ret_type = cg_c_type(f.return_type, struct_fields)
    }

    let mut params = ""
    let mut i = 0
    while i < len(f.params) {
        if i > 0 { params = params + ", " }
        let mut ptype = "int64_t"
        if i < len(f.param_types) {
            if f.param_types[i] != "" {
                ptype = cg_c_type(f.param_types[i], struct_fields)
            }
        }
        params = params + ptype + " " + cg_mangle_var(f.params[i])
        i = i + 1
    }
    if params == "" { params = "void" }

    print(ret_type + " " + cg_mangle_func(f.name) + "(" + params + ") {\n")

    // Declare locals
    let vars = cg_collect_vars(f)
    let mut vi = 0
    while vi < len(vars) {
        let vname = vars[vi]
        if !cg_is_param(f, vname) {
            let vt = cg_get_var_type(&infer, &vname)
            let ctype = cg_c_type(vt, struct_fields)
            print("    " + ctype + " " + cg_mangle_var(vname) + " = " + cg_c_zero(vt, struct_fields) + ";\n")
        }
        vi = vi + 1
    }

    // Declare temps
    if f.temp_count > 0 {
        i = 0
        while i < f.temp_count {
            let mut tt = ""
            if i < len(infer.temp_types) { tt = infer.temp_types[i] }
            let ctype = cg_c_type(tt, struct_fields)
            print("    " + ctype + " t" + int_to_string(i) + " = " + cg_c_zero(tt, struct_fields) + ";\n")
            i = i + 1
        }
        print("\n")
    }

    // Generate blocks
    i = 0
    while i < len(f.blocks) {
        let blk = f.blocks[i]
        print(cg_mangle_label(blk.label) + ":;\n")

        let mut j = 0
        while j < len(blk.instrs) {
            print("    " + cg_instr(blk.instrs[j], &infer, p, closure_funcs, struct_fields, enum_names, env_field_types, inst_map) + "\n")
            j = j + 1
        }

        let term = cg_term(blk.term, &infer, f, struct_fields)
        if term != "" {
            print("    " + term + "\n")
        }
        print("\n")
        i = i + 1
    }

    print("}\n")
}

// =============================================================================
// Struct/Enum Definitions
// =============================================================================

fn cg_emit_struct_forward_decls(struct_names: [String]) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(struct_names) {
        let name = struct_names[i]
        let cname = cg_c_struct_name(name)
        out = out + "typedef struct " + cname + " " + cname + ";\n"
        i = i + 1
    }
    if out != "" { out = out + "\n" }
    return out
}

fn cg_struct_deps(name: String, struct_fields: &StringListMap, field_types: &StringMap, payload_types: &StringListMap, env_field_types: &StringListMap, enum_names: & [String]) -> [String] {
    let mut deps = cg_string_list_new()
    let fields = string_list_map_get(struct_fields, &name)
    if cg_struct_is_enum(enum_names, name) {
        let mut types = string_list_map_get(payload_types, &name)
        if len(types) == 0 {
            let payload_key = cg_field_key(string_clone(&name), "_payload")
            let mut t = string_map_get(field_types, &payload_key)
            if t == "" { t = "unit" }
            let mut tmp = cg_string_list_new()
            push(&mut tmp, cg_normalize_type(t))
            types = tmp
        }
        let mut k = 0
        while k < len(types) {
            let t = types[k]
            if cg_is_struct_type(t) && !cg_struct_is_enum(enum_names, t) {
                let dep = cg_struct_key_name(t)
                if dep != cg_struct_key_name(name) && !cg_string_list_contains(&deps, string_clone(&dep)) {
                    push(&mut deps, dep)
                }
            }
            k = k + 1
        }
        return deps
    }
    if cg_struct_key_name(name) == "$Env" {
        let mut k = 0
        while k < len(fields) {
            let fname = fields[k]
            let types = string_list_map_get(env_field_types, &fname)
            if len(types) > 0 {
                let mut ti = 0
                while ti < len(types) {
                    let t = types[ti]
                    if cg_is_struct_type(t) && !cg_struct_is_enum(enum_names, t) {
                        let dep = cg_struct_key_name(t)
                        if dep != cg_struct_key_name(name) && !cg_string_list_contains(&deps, string_clone(&dep)) {
                            push(&mut deps, dep)
                        }
                    }
                    ti = ti + 1
                }
            } else {
                let key = cg_field_key(string_clone(&name), fname)
                let mut ft = string_map_get(field_types, &key)
                if ft == "" { ft = "unit" }
                if cg_is_struct_type(ft) && !cg_struct_is_enum(enum_names, ft) {
                    let dep = cg_struct_key_name(ft)
                    if dep != cg_struct_key_name(name) && !cg_string_list_contains(&deps, string_clone(&dep)) {
                        push(&mut deps, dep)
                    }
                }
            }
            k = k + 1
        }
        return deps
    }
    let mut k = 0
    while k < len(fields) {
        let fname = fields[k]
        let key = cg_field_key(name, fname)
        let mut ft = string_map_get(field_types, &key)
        if ft == "" { ft = "unit" }
        if cg_is_struct_type(ft) && !cg_struct_is_enum(enum_names, ft) {
            let dep = cg_struct_key_name(ft)
            if dep != cg_struct_key_name(name) && !cg_string_list_contains(&deps, string_clone(&dep)) {
                push(&mut deps, dep)
            }
        }
        k = k + 1
    }
    return deps
}

fn cg_struct_visit(name: String, struct_fields: &StringListMap, field_types: &StringMap, payload_types: &StringListMap, env_field_types: &StringListMap, enum_names: & [String], temp: &mut StringMap, perm: &mut StringMap, order: &mut [String]) {
    if !cg_string_list_contains(&struct_fields.keys, string_clone(&name)) { return }
    if string_map_get(perm, &name) != "" { return }
    if string_map_get(temp, &name) != "" { return }
    let _ = string_map_set(temp, name, "1")
    let deps = cg_struct_deps(name, struct_fields, field_types, payload_types, env_field_types, enum_names)
    let mut i = 0
    while i < len(deps) {
        cg_struct_visit(deps[i], struct_fields, field_types, payload_types, env_field_types, enum_names, temp, perm, order)
        i = i + 1
    }
    let _ = string_map_set(temp, name, "")
    let _ = string_map_set(perm, name, "1")
    if !cg_string_list_contains(order, string_clone(&name)) {
        push(order, name)
    }
}

fn cg_emit_struct_defs(struct_fields: &StringListMap, field_types: &StringMap, payload_types: &StringListMap, env_field_types: &StringListMap, enum_names: & [String]) -> String {
    let mut out = ""
    let mut order = cg_string_list_new()
    let mut temp = string_map_new()
    let mut perm = string_map_new()
    let mut i = 0
    while i < len(struct_fields.keys) {
        let name = struct_fields.keys[i]
        cg_struct_visit(name, struct_fields, field_types, payload_types, env_field_types, enum_names, &mut temp, &mut perm, &mut order)
        i = i + 1
    }
    i = 0
    while i < len(order) {
        let name = order[i]
        let cname = cg_c_struct_name(name)
        let fields = string_list_map_get(struct_fields, &name)
        let is_enum = cg_struct_is_enum(enum_names, name)
        if is_enum {
            let tag_key = cg_field_key(string_clone(&name), "_tag")
            let mut tag_t = string_map_get(field_types, &tag_key)
            if tag_t == "" { tag_t = "int" }
            let payload_name = cg_payload_c_name(name)
            out = out + "typedef union {\n"
            let mut types = string_list_map_get(payload_types, &name)
            if len(types) == 0 {
                let payload_key = cg_field_key(string_clone(&name), "_payload")
                let mut t = string_map_get(field_types, &payload_key)
                if t == "" { cg_die("unknown enum payload type for " + name) }
                let mut tmp = cg_string_list_new()
                push(&mut tmp, cg_normalize_type(t))
                types = tmp
            }
            if !cg_string_list_contains(&types, "unit") {
                push(&mut types, "unit")
            }
            let mut k = 0
            while k < len(types) {
                let t = types[k]
                let ctype = cg_c_type(t, struct_fields)
                let fname = cg_union_field_name(t)
                out = out + "    " + ctype + " " + fname + ";\n"
                k = k + 1
            }
            out = out + "} " + payload_name + ";\n"
            out = out + "struct " + cname + " {\n"
            out = out + "    " + cg_c_type(tag_t, struct_fields) + " _tag;\n"
            out = out + "    " + payload_name + " _payload;\n"
            out = out + "};\n\n"
        } else if cg_struct_key_name(name) == "$Env" {
            out = out + "struct " + cname + " {\n"
            if len(fields) == 0 {
                out = out + "    uint8_t _;\n"
            } else {
                let mut k = 0
                while k < len(fields) {
                    let fname = fields[k]
                    let types = string_list_map_get(env_field_types, &fname)
                    if len(types) > 1 {
                        let mut ti = 0
                        while ti < len(types) {
                            let t = types[ti]
                            let ctype = cg_c_type(t, struct_fields)
                            let field_id = cg_env_field_name(fname, t, env_field_types)
                            out = out + "    " + ctype + " " + field_id + ";\n"
                            ti = ti + 1
                        }
                    } else {
                        let key = cg_field_key(name, fname)
                        let mut ft = string_map_get(field_types, &key)
                        if ft == "" && len(types) == 1 { ft = types[0] }
                        if ft == "" { cg_die("unknown env field type for " + key) }
                        let field_id = cg_mangle_ident(fname)
                        out = out + "    " + cg_c_type(ft, struct_fields) + " " + field_id + ";\n"
                    }
                    k = k + 1
                }
            }
            out = out + "};\n\n"
        } else {
            out = out + "struct " + cname + " {\n"
            if len(fields) == 0 {
                out = out + "    uint8_t _;\n"
            } else {
                let mut k = 0
                while k < len(fields) {
                    let fname = fields[k]
                    let key = cg_field_key(name, fname)
                    let mut ft = string_map_get(field_types, &key)
                    if ft == "" { cg_die("unknown field type for " + key) }
                    out = out + "    " + cg_c_type(ft, struct_fields) + " " + cg_mangle_ident(fname) + ";\n"
                    k = k + 1
                }
            }
            out = out + "};\n\n"
        }
        i = i + 1
    }
    return out
}

fn cg_add_func_instance(items: &mut [FuncInstance], name_map: &mut StringMap, work: &mut [i32], base: String, param_types: [String], return_type: String, generic: bool) -> String {
    let key = cg_func_instance_key(base, param_types, return_type)
    let existing = string_map_get(name_map, &key)
    if existing != "" { return existing }
    let name = cg_func_instance_name(base, param_types, return_type, generic)
    let _ = string_map_set(name_map, key, name)
    let idx = len(*items)
    push(items, FuncInstance { base: base, name: name, param_types: param_types, return_type: return_type })
    push(work, idx)
    return name
}

fn cg_build_func_instances(p: &IrProgram, seed_fields: &StringMap, struct_fields: &StringListMap, enum_names: & [String], enum_tag_payloads: &StringMap) -> FuncInstanceResult {
    let mut items: [FuncInstance] = []
    let mut name_map = string_map_new()
    let mut work: [i32] = []
    let mut entry_name = ""
    if p.entry != "" {
        let fidx = cg_find_function_index(p, p.entry)
        if fidx >= 0 {
            let f = p.functions[fidx]
            let generic = cg_func_is_generic(&f, struct_fields)
            entry_name = cg_add_func_instance(&mut items, &mut name_map, &mut work, f.name, f.param_types, f.return_type, generic)
        }
    }
    let mut wi = 0
    while wi < len(work) {
        let inst_idx = work[wi]
        let mut skip = false
        if inst_idx < 0 || inst_idx >= len(items) { skip = true }
        if !skip {
            let inst = items[inst_idx]
            let fidx = cg_find_function_index(p, inst.base)
            if fidx < 0 { skip = true }
            if !skip {
                let basef = p.functions[fidx]
                let tmap = cg_build_type_map(&basef, inst, struct_fields)
                let blocks = cg_subst_blocks(&basef.blocks, struct_fields, &tmap)
                let finst = IrFunction { name: inst.name, params: basef.params, param_types: inst.param_types, return_type: inst.return_type, blocks: blocks, temp_count: basef.temp_count }
                let infer = cg_infer_function_types(p, &finst, seed_fields, struct_fields, enum_names, enum_tag_payloads)
                let mut bi = 0
                while bi < len(finst.blocks) {
                    let blk = finst.blocks[bi]
                    let mut j = 0
                    while j < len(blk.instrs) {
                        match blk.instrs[j] {
                            IrInstr.Call(c) => {
                                if cg_is_builtin(c.callee) {
                                    // no instance
                                } else {
                                    let cidx = cg_find_function_index(p, c.callee)
                                    if cidx >= 0 {
                                        let callee = p.functions[cidx]
                                        let mut tv_map = string_map_new()
                                        let mut k = 0
                                        while k < len(c.args) && k < len(callee.param_types) {
                                            let at = cg_operand_type(c.args[k], &infer.temp_types)
                                            if at != "" {
                                                let _ = cg_bind_type_vars(callee.param_types[k], at, struct_fields, &mut tv_map)
                                            }
                                            k = k + 1
                                        }
                                        let mut cparams = cg_string_list_new()
                                        k = 0
                                        while k < len(callee.param_types) {
                                            let mut ct = cg_subst_type(callee.param_types[k], struct_fields, &tv_map)
                                            if ct == "" {
                                                let pt = cg_normalize_type(callee.param_types[k])
                                                if cg_is_type_var(pt, struct_fields) {
                                                    cg_die("cannot infer type for " + pt + " in call to " + callee.name)
                                                }
                                                ct = pt
                                            }
                                            push(&mut cparams, ct)
                                            k = k + 1
                                        }
                                        let mut cret = cg_subst_type(callee.return_type, struct_fields, &tv_map)
                                        if cret == "" {
                                            let rt = cg_normalize_type(callee.return_type)
                                            if cg_is_type_var(rt, struct_fields) {
                                                cg_die("cannot infer return type for " + callee.name)
                                            }
                                            cret = rt
                                        }
                                        let generic = cg_func_is_generic(&callee, struct_fields)
                                        let _ = cg_add_func_instance(&mut items, &mut name_map, &mut work, callee.name, cparams, cret, generic)
                                    }
                                }
                            }
                            IrInstr.MakeStruct(ms) => {
                                if ms.name == "Closure" {
                                    let mut k = 0
                                    while k < len(ms.fields) {
                                        let field = ms.fields[k]
                                        if field.name == "func" && field.src.is_const && field.src.value.kind == ir_kind_string() {
                                            let fname = field.src.value.str
                                            let cidx = cg_find_function_index(p, fname)
                                            if cidx >= 0 {
                                                let callee = p.functions[cidx]
                                                let generic = cg_func_is_generic(&callee, struct_fields)
                                                if generic {
                                                    cg_die("generic closure not supported: " + fname)
                                                }
                                                let _ = cg_add_func_instance(&mut items, &mut name_map, &mut work, callee.name, callee.param_types, callee.return_type, generic)
                                            }
                                        }
                                        k = k + 1
                                    }
                                }
                            }
                            _ => {}
                        }
                        j = j + 1
                    }
                    bi = bi + 1
                }
            }
        }
        wi = wi + 1
    }
    return FuncInstanceResult { items: items, name_map: name_map, entry_name: entry_name }
}

fn cg_instance_functions(p: &IrProgram, insts: & [FuncInstance], struct_fields: &StringListMap) -> [IrFunction] {
    let mut out: [IrFunction] = []
    let mut i = 0
    while i < len(insts) {
        let inst = insts[i]
        let fidx = cg_find_function_index(p, inst.base)
        if fidx >= 0 {
            let f = p.functions[fidx]
            let tmap = cg_build_type_map(&f, inst, struct_fields)
            let blocks = cg_subst_blocks(&f.blocks, struct_fields, &tmap)
            let finst = IrFunction {
                name: inst.name,
                params: f.params,
                param_types: inst.param_types,
                return_type: inst.return_type,
                blocks: blocks,
                temp_count: f.temp_count
            }
            push(&mut out, finst)
        }
        i = i + 1
    }
    return out
}

// =============================================================================
// Program Generation
// =============================================================================

fn ir_program_to_c(p: &IrProgram, progress: bool) -> String {
    let mut out = "// Generated by Dast compiler\n"
    out = out + "#include \"c_runtime.h\"\n\n"

    let empty_structs = string_list_map_new()
    let enum_names = cg_enum_names(p)
    let mut seed_fields = cg_seed_field_types()
    let enum_tag_payloads0 = cg_collect_enum_tag_payloads(&p, &p.functions, &empty_structs, &seed_fields)
    // Initial struct field discovery on base functions
    let mut struct_fields0 = cg_collect_struct_fields(&p, &p.functions, &seed_fields, &empty_structs, &enum_names, &enum_tag_payloads0)
    cg_add_seed_struct_fields(&mut struct_fields0)
    cg_add_enum_struct_fields(&p, &p.functions, &mut struct_fields0, &seed_fields)
    let enum_seed = cg_enum_seed_fields(&p, &p.functions, &struct_fields0)
    cg_merge_field_types(&mut seed_fields, enum_seed)
    string_map_sort(&mut seed_fields)
    // Build concrete function instances
    let inst_res = cg_build_func_instances(p, &seed_fields, &struct_fields0, &enum_names, &enum_tag_payloads0)
    let inst_funcs0 = cg_instance_functions(p, &inst_res.items, &struct_fields0)
    let closure_funcs0 = cg_collect_closure_funcs(&inst_funcs0)
    let inst_funcs = cg_reachable_functions(&inst_funcs0, p.entry, &closure_funcs0)
    // Recompute field/type info on instantiated functions
    let mut struct_fields = cg_collect_struct_fields(&p, &inst_funcs, &seed_fields, &struct_fields0, &enum_names, &enum_tag_payloads0)
    cg_add_seed_struct_fields(&mut struct_fields)
    cg_add_enum_struct_fields(&p, &inst_funcs, &mut struct_fields, &seed_fields)
    let enum_tag_payloads1 = cg_collect_enum_tag_payloads(&p, &inst_funcs, &struct_fields, &seed_fields)
    let mut field_types = cg_collect_field_types(&p, &inst_funcs, &struct_fields, seed_fields, &enum_names, &enum_tag_payloads1, "field_types", progress)
    string_map_sort(&mut field_types)
    let enum_tag_payloads = cg_collect_enum_tag_payloads(&p, &inst_funcs, &struct_fields, &field_types)
    let payload_types = cg_collect_enum_payload_types(&p, &inst_funcs, &struct_fields, &field_types)
    let env_field_types = cg_collect_env_field_types(&p, &inst_funcs, &field_types, &struct_fields, &enum_names, &enum_tag_payloads)
    let struct_refs = cg_collect_struct_refs(&inst_funcs, &struct_fields, &field_types, &payload_types, &env_field_types)
    let closure_funcs = cg_collect_closure_funcs(&inst_funcs)
    let inst_map = inst_res.name_map

    out = out + cg_emit_struct_forward_decls(struct_refs)
    out = out + cg_emit_struct_defs(&struct_fields, &field_types, &payload_types, &env_field_types, &enum_names)

    // Forward declarations
    let mut i = 0
    while i < len(inst_funcs) {
        let f = inst_funcs[i]
        let mut ret_type = "void"
        if f.return_type != "" && f.return_type != "unit" {
            ret_type = cg_c_type(f.return_type, &struct_fields)
        }
        let mut params = ""
        let mut j = 0
        while j < len(f.params) {
            if j > 0 { params = params + ", " }
            let mut ptype = "int64_t"
            if j < len(f.param_types) {
                if f.param_types[j] != "" {
                    ptype = cg_c_type(f.param_types[j], &struct_fields)
                }
            }
            params = params + ptype + " " + cg_mangle_var(f.params[j])
            j = j + 1
        }
        if params == "" { params = "void" }
        out = out + ret_type + " " + cg_mangle_func(f.name) + "(" + params + ");\n"
        i = i + 1
    }
    out = out + "\n"

    // Generate functions
    let total = len(inst_funcs)
    let mut step = 25
    if total > 0 && total < step { step = 1 }
    if progress {
        eprintln("ir-c: funcs", 0, "/", total)
    }
    i = 0
    while i < len(inst_funcs) {
        out = out + cg_function(&p, &inst_funcs[i], &field_types, &struct_fields, &enum_names, &env_field_types, &enum_tag_payloads, &inst_map, &closure_funcs) + "\n"
        if progress && ((i + 1) % step == 0 || i + 1 == total) {
            eprintln("ir-c: funcs", i + 1, "/", total)
        }
        i = i + 1
    }

    // Main wrapper
    out = out + "int main(int argc, char** argv) {\n"
    out = out + "    dast_runtime_init(argc, argv);\n"
    if inst_res.entry_name != "" {
        out = out + "    " + cg_mangle_func(inst_res.entry_name) + "();\n"
    }
    out = out + "    dast_runtime_cleanup();\n"
    out = out + "    return 0;\n"
    out = out + "}\n"

    return out
}

fn ir_program_to_c_emit(p: &IrProgram, progress: bool) {
    let mut out = "// Generated by Dast compiler\n"
    out = out + "#include \"c_runtime.h\"\n\n"
    print(out)

    let empty_structs = string_list_map_new()
    let enum_names = cg_enum_names(p)
    let mut seed_fields = cg_seed_field_types()
    let enum_tag_payloads0 = cg_collect_enum_tag_payloads(&p, &p.functions, &empty_structs, &seed_fields)
    if progress { eprintln("ir-c: collect struct_fields0") }
    let mut struct_fields0 = cg_collect_struct_fields(&p, &p.functions, &seed_fields, &empty_structs, &enum_names, &enum_tag_payloads0)
    cg_add_seed_struct_fields(&mut struct_fields0)
    cg_add_enum_struct_fields(&p, &p.functions, &mut struct_fields0, &seed_fields)
    let enum_seed = cg_enum_seed_fields(&p, &p.functions, &struct_fields0)
    cg_merge_field_types(&mut seed_fields, enum_seed)
    string_map_sort(&mut seed_fields)
    if progress { eprintln("ir-c: build instances") }
    let mut empty_instances: [FuncInstance] = []
    let mut inst_res = FuncInstanceResult { items: empty_instances, name_map: string_map_new(), entry_name: p.entry }
    let mut inst_funcs = p.functions
    let has_generic = cg_program_has_generic(&p.functions, &struct_fields0)
    if progress && !has_generic { eprintln("ir-c: build instances fast-path (no generics)") }
    if has_generic {
        inst_res = cg_build_func_instances(p, &seed_fields, &struct_fields0, &enum_names, &enum_tag_payloads0)
        inst_funcs = cg_instance_functions(p, &inst_res.items, &struct_fields0)
    } else {
        let mut name_map = string_map_new()
        let mut i = 0
        while i < len(p.functions) {
            let f = p.functions[i]
            let key = cg_func_instance_key(f.name, f.param_types, f.return_type)
            let _ = string_map_set(&mut name_map, key, f.name)
            i = i + 1
        }
        let mut empty2: [FuncInstance] = []
        inst_res = FuncInstanceResult { items: empty2, name_map: name_map, entry_name: p.entry }
        inst_funcs = p.functions
    }
    let closure_funcs0 = cg_collect_closure_funcs(&inst_funcs)
    inst_funcs = cg_reachable_functions(&inst_funcs, p.entry, &closure_funcs0)
    if progress { eprintln("ir-c: collect struct_fields") }
    let mut struct_fields = cg_collect_struct_fields(&p, &inst_funcs, &seed_fields, &struct_fields0, &enum_names, &enum_tag_payloads0)
    cg_add_seed_struct_fields(&mut struct_fields)
    cg_add_enum_struct_fields(&p, &inst_funcs, &mut struct_fields, &seed_fields)
    let enum_tag_payloads1 = cg_collect_enum_tag_payloads(&p, &inst_funcs, &struct_fields, &seed_fields)
    if progress { eprintln("ir-c: collect field_types") }
    let mut field_types = cg_collect_field_types(&p, &inst_funcs, &struct_fields, seed_fields, &enum_names, &enum_tag_payloads1, "field_types", progress)
    string_map_sort(&mut field_types)
    if progress { eprintln("ir-c: collect enum tag/payload") }
    let enum_tag_payloads = cg_collect_enum_tag_payloads(&p, &inst_funcs, &struct_fields, &field_types)
    let payload_types = cg_collect_enum_payload_types(&p, &inst_funcs, &struct_fields, &field_types)
    if progress { eprintln("ir-c: collect env field types") }
    let env_field_types = cg_collect_env_field_types(&p, &inst_funcs, &field_types, &struct_fields, &enum_names, &enum_tag_payloads)
    if progress { eprintln("ir-c: collect struct refs") }
    let struct_refs = cg_collect_struct_refs(&inst_funcs, &struct_fields, &field_types, &payload_types, &env_field_types)
    let closure_funcs = cg_collect_closure_funcs(&inst_funcs)
    let inst_map = inst_res.name_map

    if progress { eprintln("ir-c: emit struct decls") }
    print(cg_emit_struct_forward_decls(struct_refs))
    if progress { eprintln("ir-c: emit struct defs") }
    print(cg_emit_struct_defs(&struct_fields, &field_types, &payload_types, &env_field_types, &enum_names))

    // Forward declarations
    let mut i = 0
    while i < len(inst_funcs) {
        let f = inst_funcs[i]
        let mut ret_type = "void"
        if f.return_type != "" && f.return_type != "unit" {
            ret_type = cg_c_type(f.return_type, &struct_fields)
        }
        let mut params = ""
        let mut j = 0
        while j < len(f.params) {
            if j > 0 { params = params + ", " }
            let mut ptype = "int64_t"
            if j < len(f.param_types) {
                if f.param_types[j] != "" {
                    ptype = cg_c_type(f.param_types[j], &struct_fields)
                }
            }
            params = params + ptype + " " + cg_mangle_var(f.params[j])
            j = j + 1
        }
        if params == "" { params = "void" }
        print(ret_type + " " + cg_mangle_func(f.name) + "(" + params + ");\n")
        i = i + 1
    }
    print("\n")

    // Generate functions
    let total = len(inst_funcs)
    let mut step = 25
    if total > 0 && total < step { step = 1 }
    if progress {
        eprintln("ir-c: funcs", 0, "/", total)
    }
    i = 0
    while i < len(inst_funcs) {
        cg_function_emit(&p, &inst_funcs[i], &field_types, &struct_fields, &enum_names, &env_field_types, &enum_tag_payloads, &inst_map, &closure_funcs)
        print("\n")
        if progress && ((i + 1) % step == 0 || i + 1 == total) {
            eprintln("ir-c: funcs", i + 1, "/", total)
        }
        i = i + 1
    }

    // Main wrapper
    print("int main(int argc, char** argv) {\n")
    print("    dast_runtime_init(argc, argv);\n")
    if inst_res.entry_name != "" {
        print("    " + cg_mangle_func(inst_res.entry_name) + "();\n")
    }
    print("    dast_runtime_cleanup();\n")
    print("    return 0;\n")
    print("}\n")
}
