struct Runtime {
    prog: IrProgram,
    heap: [IrValue],
    structs: [IrStructValue],
    enums: [IrEnumValue],
    arrays: [IrArrayValue],
    args: [String],
    error: String,
}

struct Frame {
    func: IrFunction,
    temps: [IrValue],
    var_names: [String],
    var_addrs: [i32],
    cur_block: i32,
}

fn ir_value_list_new() -> [IrValue] {
    let mut items: [IrValue] = []
    return items
}

fn ir_struct_list_new() -> [IrStructValue] {
    let mut items: [IrStructValue] = []
    return items
}

fn ir_enum_list_new() -> [IrEnumValue] {
    let mut items: [IrEnumValue] = []
    return items
}

fn ir_array_list_new() -> [IrArrayValue] {
    let mut items: [IrArrayValue] = []
    return items
}

fn ir_array_empty() -> IrArrayValue {
    return IrArrayValue { elems: ir_value_list_new() }
}

fn runtime_new(prog: IrProgram, args: [String]) -> Runtime {
    return Runtime {
        prog: prog,
        heap: ir_value_list_new(),
        structs: ir_struct_list_new(),
        enums: ir_enum_list_new(),
        arrays: ir_array_list_new(),
        args: args,
        error: "",
    }
}

fn runtime_error(rt: &mut Runtime, msg: String) {
    if rt.error == "" {
        rt.error = msg
    }
}

fn runtime_run(rt: &mut Runtime, entry: String) -> IrValue {
    let mut name = entry
    if name == "" {
        name = rt.prog.entry
    }
    if name == "" {
        runtime_error(rt, "no entry function")
        return ir_value_unit()
    }
    return runtime_call(rt, name, ir_value_list_new())
}

fn runtime_call(rt: &mut Runtime, name: String, args: [IrValue]) -> IrValue {
    if rt.error != "" { return ir_value_unit() }
    if is_builtin_name(name) {
        return call_builtin(rt, name, args)
    }
    let idx = find_function(rt.prog, name)
    if idx < 0 {
        runtime_error(rt, "undefined function '" + name + "'")
        return ir_value_unit()
    }
    let func = rt.prog.functions[idx]
    if len(args) != len(func.params) {
        runtime_error(rt, "function '" + name + "' expects " + int_to_string(len(func.params)) + " args")
        return ir_value_unit()
    }
    let mut fr = frame_new(rt, func, args)
    return exec_frame(rt, &mut fr)
}

fn frame_new(rt: &mut Runtime, func: IrFunction, args: [IrValue]) -> Frame {
    let mut names: [String] = []
    let mut addrs: [i32] = []
    let mut i = 0
    while i < len(func.params) {
        let addr = heap_alloc(rt, args[i])
        push(&mut names, func.params[i])
        push(&mut addrs, addr)
        i = i + 1
    }
    let mut temps: [IrValue] = []
    let mut t = 0
    while t < func.temp_count {
        push(&mut temps, ir_value_unit())
        t = t + 1
    }
    return Frame { func: func, temps: temps, var_names: names, var_addrs: addrs, cur_block: 0 }
}

fn exec_frame(rt: &mut Runtime, fr: &mut Frame) -> IrValue {
    while true {
        if fr.cur_block < 0 || fr.cur_block >= len(fr.func.blocks) {
            runtime_error(rt, "invalid block")
            return ir_value_unit()
        }
        let blk = fr.func.blocks[fr.cur_block]
        let mut i = 0
        while i < len(blk.instrs) {
            exec_instr(rt, fr, blk.instrs[i])
            if rt.error != "" { return ir_value_unit() }
            i = i + 1
        }
        match blk.term {
            .None(_) => { return ir_value_unit() }
            .Jump(t) => {
                let idx = find_block(fr.func, t.target)
                if idx < 0 {
                    runtime_error(rt, "unknown block '" + t.target + "'")
                    return ir_value_unit()
                }
                fr.cur_block = idx
            }
            .Branch(t) => {
                let cond = eval_operand(rt, fr, t.cond)
                if cond.kind != ir_kind_bool() {
                    runtime_error(rt, "branch condition must be bool")
                    return ir_value_unit()
                }
                let mut target = t.else_label
                if cond.bool {
                    target = t.then_label
                }
                let idx = find_block(fr.func, target)
                if idx < 0 {
                    runtime_error(rt, "unknown block '" + target + "'")
                    return ir_value_unit()
                }
                fr.cur_block = idx
            }
            IrTerm.Return(t) => {
                if !t.has_value { return ir_value_unit() }
                return eval_operand(rt, fr, t.value)
            }
        }
    }
    return ir_value_unit()
}

fn exec_instr(rt: &mut Runtime, fr: &mut Frame, inst: IrInstr) {
    match inst {
        .LoadVar(i) => {
            if i.ref {
                let r = get_temp(rt, fr, i.ref_temp)
                let v = deref_value(rt, r)
                set_temp(rt, fr, i.dst, v)
            } else {
                let addr = find_var_addr(fr, i.name)
                if addr < 0 {
                    runtime_error(rt, "undefined variable '" + i.name + "'")
                    return
                }
                if i.addr {
                    set_temp(rt, fr, i.dst, ir_value_ref(addr))
                } else {
                    let v = heap_get(rt, addr)
                    set_temp(rt, fr, i.dst, v)
                }
            }
        }
        .StoreVar(i) => {
            let v = eval_operand(rt, fr, i.src)
            if i.ref {
                let r = get_temp(rt, fr, i.ref_temp)
                store_ref(rt, r, v)
            } else {
                let addr = find_var_addr(fr, i.name)
                if addr < 0 {
                    let new_addr = heap_alloc(rt, v)
                    let mut names = fr.var_names
                    let mut addrs = fr.var_addrs
                    push(&mut names, i.name)
                    push(&mut addrs, new_addr)
                    fr.var_names = names
                    fr.var_addrs = addrs
                } else {
                    heap_set(rt, addr, v)
                }
            }
        }
        .BinOp(i) => {
            let l = eval_operand(rt, fr, i.lhs)
            let r = eval_operand(rt, fr, i.rhs)
            let res = eval_binary(rt, i.op, l, r)
            set_temp(rt, fr, i.dst, res)
        }
        IrInstr.Call(i) => {
            let mut args: [IrValue] = []
            let mut j = 0
            while j < len(i.args) {
                push(&mut args, eval_operand(rt, fr, i.args[j]))
                j = j + 1
            }
            let res = runtime_call(rt, i.callee, args)
            if i.dst >= 0 {
                set_temp(rt, fr, i.dst, res)
            }
        }
        .CallClosure(i) => {
            // Get the closure value from the temp
            let closure_val = eval_operand(rt, fr, i.closure)

            let mut func_name = ""
            let mut env_arg = ir_value_unit()

            // Handle closure struct { func: String, env: Struct }
            if closure_val.kind == ir_kind_struct() {
                let f = struct_get_field(rt, closure_val, "func")
                if f.kind == ir_kind_string() {
                    func_name = f.str
                }
                env_arg = struct_get_field(rt, closure_val, "env")
            } else if closure_val.kind == ir_kind_string() {
                // Legacy: simple string function name (no capture)
                func_name = closure_val.str
            } else {
                runtime_error(rt, "closure call requires closure struct or string")
                return
            }

            if func_name == "" {
                runtime_error(rt, "valid function name not found in closure")
                return
            }

            // Collect args with env as first argument
            let mut args: [IrValue] = []
            push(&mut args, env_arg)

            let mut j = 0
            while j < len(i.args) {
                push(&mut args, eval_operand(rt, fr, i.args[j]))
                j = j + 1
            }
            // Call the closure function
            let res = runtime_call(rt, func_name, args)
            set_temp(rt, fr, i.dst, res)
        }
        .MakeArray(i) => {
            let mut elems: [IrValue] = []
            let mut j = 0
            while j < len(i.elems) {
                push(&mut elems, eval_operand(rt, fr, i.elems[j]))
                j = j + 1
            }
            let arr_idx = array_alloc(rt, IrArrayValue { elems: elems })
            set_temp(rt, fr, i.dst, ir_value_array(arr_idx))
        }
        IrInstr.Index(i) => {
            let arr = eval_operand(rt, fr, i.array)
            let idx = eval_operand(rt, fr, i.index)
            let mut v = array_index(rt, arr, idx)
            if i.unchecked {
                v = array_index_unchecked(rt, arr, idx)
            }
            set_temp(rt, fr, i.dst, v)
        }
        .SetIndex(i) => {
            let arr = eval_operand(rt, fr, i.array)
            let idx = eval_operand(rt, fr, i.index)
            let v = eval_operand(rt, fr, i.src)
            if i.unchecked {
                array_set_unchecked(rt, arr, idx, v)
            } else {
                array_set(rt, arr, idx, v)
            }
        }
        .MakeStruct(i) => {
            let mut fields: [IrStructFieldValue] = []
            let mut j = 0
            while j < len(i.fields) {
                let f = i.fields[j]
                let v = eval_operand(rt, fr, f.src)
                push(&mut fields, IrStructFieldValue { name: f.name, value: v })
                j = j + 1
            }
            let sidx = struct_alloc(rt, IrStructValue { name: i.name, fields: fields })
            set_temp(rt, fr, i.dst, ir_value_struct(sidx))
        }
        .GetField(i) => {
            let src = get_temp(rt, fr, i.src)
            let v = struct_get_field(rt, src, i.field)
            set_temp(rt, fr, i.dst, v)
        }
        .SetField(i) => {
            let src = get_temp(rt, fr, i.src)
            let v = eval_operand(rt, fr, i.value)
            struct_set_field(rt, src, i.field, v)
        }
    }
}

fn set_temp(rt: &mut Runtime, fr: &mut Frame, idx: i32, v: IrValue) {
    if idx < 0 { runtime_error(rt, "invalid temp"); return }
    let mut temps = fr.temps
    while len(temps) <= idx {
        push(&mut temps, ir_value_unit())
    }
    temps[idx] = v
    fr.temps = temps
}

fn get_temp(rt: &mut Runtime, fr: &Frame, idx: i32) -> IrValue {
    if idx < 0 || idx >= len(fr.temps) {
        runtime_error(rt, "invalid temp")
        return ir_value_unit()
    }
    return fr.temps[idx]
}

fn eval_operand(rt: &mut Runtime, fr: &Frame, op: IrOperand) -> IrValue {
    if op.is_const { return op.value }
    return get_temp(rt, fr, op.temp)
}

fn find_var_addr(fr: &Frame, name: String) -> i32 {
    let mut i = len(fr.var_names) - 1
    while i >= 0 {
        if fr.var_names[i] == name {
            return fr.var_addrs[i]
        }
        if i == 0 { return -1 }
        i = i - 1
    }
    return -1
}

fn heap_alloc(rt: &mut Runtime, v: IrValue) -> i32 {
    let mut heap = rt.heap
    push(&mut heap, v)
    let idx = len(heap) - 1
    rt.heap = heap
    return idx
}

fn heap_get(rt: &mut Runtime, addr: i32) -> IrValue {
    if addr < 0 || addr >= len(rt.heap) {
        runtime_error(rt, "invalid reference")
        return ir_value_unit()
    }
    return rt.heap[addr]
}

fn heap_set(rt: &mut Runtime, addr: i32, v: IrValue) {
    if addr < 0 || addr >= len(rt.heap) {
        runtime_error(rt, "invalid reference")
        return
    }
    rt.heap[addr] = v
}

fn deref_value(rt: &mut Runtime, v: IrValue) -> IrValue {
    if v.kind != ir_kind_ref() {
        runtime_error(rt, "deref requires ref")
        return ir_value_unit()
    }
    return heap_get(rt, v.ref)
}

fn store_ref(rt: &mut Runtime, r: IrValue, v: IrValue) {
    if r.kind != ir_kind_ref() {
        runtime_error(rt, "store_ref requires ref")
        return
    }
    heap_set(rt, r.ref, v)
}

fn struct_alloc(rt: &mut Runtime, v: IrStructValue) -> i32 {
    let mut structs = rt.structs
    push(&mut structs, v)
    let idx = len(structs) - 1
    rt.structs = structs
    return idx
}

fn enum_alloc(rt: &mut Runtime, v: IrEnumValue) -> i32 {
    let mut enums = rt.enums
    push(&mut enums, v)
    let idx = len(enums) - 1
    rt.enums = enums
    return idx
}

fn array_alloc(rt: &mut Runtime, v: IrArrayValue) -> i32 {
    let mut arrays = rt.arrays
    push(&mut arrays, v)
    let idx = len(arrays) - 1
    rt.arrays = arrays
    return idx
}

fn struct_get_field(rt: &mut Runtime, v: IrValue, name: String) -> IrValue {
    let mut val = v
    if val.kind == ir_kind_ref() {
        val = deref_value(rt, val)
    }
    if val.kind != ir_kind_struct() {
        runtime_error(rt, "field access requires struct")
        return ir_value_unit()
    }
    let idx = val.obj
    if idx < 0 || idx >= len(rt.structs) {
        runtime_error(rt, "invalid struct")
        return ir_value_unit()
    }
    let st = rt.structs[idx]
    let mut i = 0
    while i < len(st.fields) {
        if st.fields[i].name == name {
            return st.fields[i].value
        }
        i = i + 1
    }
    runtime_error(rt, "unknown field '" + name + "'")
    return ir_value_unit()
}

fn struct_set_field(rt: &mut Runtime, v: IrValue, name: String, value: IrValue) {
    let mut val = v
    if val.kind == ir_kind_ref() {
        val = deref_value(rt, val)
    }
    if val.kind != ir_kind_struct() {
        runtime_error(rt, "field assignment requires struct")
        return
    }
    let idx = val.obj
    if idx < 0 || idx >= len(rt.structs) {
        runtime_error(rt, "invalid struct")
        return
    }
    let mut st = rt.structs[idx]
    let mut i = 0
    while i < len(st.fields) {
        if st.fields[i].name == name {
            st.fields[i] = IrStructFieldValue { name: name, value: value }
            rt.structs[idx] = st
            return
        }
        i = i + 1
    }
    runtime_error(rt, "unknown field '" + name + "'")
}

fn enum_tag(rt: &mut Runtime, v: IrValue) -> IrValue {
    let mut val = v
    if val.kind == ir_kind_ref() {
        val = deref_value(rt, val)
    }
    if val.kind != ir_kind_enum() {
        runtime_error(rt, "enum_tag requires enum")
        return ir_value_unit()
    }
    let idx = val.obj
    if idx < 0 || idx >= len(rt.enums) {
        runtime_error(rt, "invalid enum")
        return ir_value_unit()
    }
    let e = rt.enums[idx]
    return ir_value_int_t(e.tag, e.tag_type)
}

fn enum_payload(rt: &mut Runtime, v: IrValue) -> IrValue {
    let mut val = v
    if val.kind == ir_kind_ref() {
        val = deref_value(rt, val)
    }
    if val.kind != ir_kind_enum() {
        runtime_error(rt, "enum_payload requires enum")
        return ir_value_unit()
    }
    let idx = val.obj
    if idx < 0 || idx >= len(rt.enums) {
        runtime_error(rt, "invalid enum")
        return ir_value_unit()
    }
    let e = rt.enums[idx]
    if !e.has_payload { return ir_value_unit() }
    return e.payload
}

fn array_value(rt: &mut Runtime, v: IrValue) -> IrArrayValue {
    let mut val = v
    if val.kind == ir_kind_ref() {
        val = deref_value(rt, val)
    }
    if val.kind != ir_kind_array() {
        runtime_error(rt, "array required")
        return ir_array_empty()
    }
    let idx = val.obj
    if idx < 0 || idx >= len(rt.arrays) {
        runtime_error(rt, "invalid array")
        return ir_array_empty()
    }
    return rt.arrays[idx]
}

fn array_index(rt: &mut Runtime, arr: IrValue, idx: IrValue) -> IrValue {
    if idx.kind != ir_kind_int() {
        runtime_error(rt, "index requires int")
        return ir_value_unit()
    }
    let a = array_value(rt, arr)
    let i = idx.int
    if i < 0 || i >= len(a.elems) {
        runtime_error(rt, "index out of bounds")
        return ir_value_unit()
    }
    return a.elems[i]
}

fn array_set(rt: &mut Runtime, arr: IrValue, idx: IrValue, v: IrValue) {
    if idx.kind != ir_kind_int() {
        runtime_error(rt, "index requires int")
        return
    }
    let mut val = arr
    if val.kind == ir_kind_ref() {
        val = deref_value(rt, val)
    }
    if val.kind != ir_kind_array() {
        runtime_error(rt, "array required")
        return
    }
    let arr_idx = val.obj
    if arr_idx < 0 || arr_idx >= len(rt.arrays) {
        runtime_error(rt, "invalid array")
        return
    }
    let mut a = rt.arrays[arr_idx]
    let i = idx.int
    if i < 0 || i >= len(a.elems) {
        runtime_error(rt, "index out of bounds")
        return
    }
    a.elems[i] = v
    rt.arrays[arr_idx] = a
}

fn array_index_unchecked(rt: &mut Runtime, arr: IrValue, idx: IrValue) -> IrValue {
    if idx.kind != ir_kind_int() {
        runtime_error(rt, "index requires int")
        return ir_value_unit()
    }
    let a = array_value(rt, arr)
    let i = idx.int
    return a.elems[i]
}

fn array_set_unchecked(rt: &mut Runtime, arr: IrValue, idx: IrValue, v: IrValue) {
    if idx.kind != ir_kind_int() {
        runtime_error(rt, "index requires int")
        return
    }
    let mut val = arr
    if val.kind == ir_kind_ref() {
        val = deref_value(rt, val)
    }
    if val.kind != ir_kind_array() {
        runtime_error(rt, "array required")
        return
    }
    let arr_idx = val.obj
    if arr_idx < 0 || arr_idx >= len(rt.arrays) {
        runtime_error(rt, "invalid array")
        return
    }
    let mut a = rt.arrays[arr_idx]
    let i = idx.int
    a.elems[i] = v
    rt.arrays[arr_idx] = a
}

fn eval_unary(rt: &mut Runtime, op: String, v: IrValue) -> IrValue {
    if op == "-" {
        if v.kind != ir_kind_int() {
            runtime_error(rt, "unary '-' requires int")
            return ir_value_unit()
        }
        return ir_value_int_t(-v.int, v.int_type)
    }
    if op == "!" {
        if v.kind != ir_kind_bool() {
            runtime_error(rt, "unary '!' requires bool")
            return ir_value_unit()
        }
        return ir_value_bool(!v.bool)
    }
    runtime_error(rt, "unknown unary op")
    return ir_value_unit()
}

fn eval_binary(rt: &mut Runtime, op: String, a: IrValue, b: IrValue) -> IrValue {
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
        if op == "+" && a.kind == ir_kind_string() && b.kind == ir_kind_string() {
            return ir_value_string(a.str + b.str)
        }
        if a.kind != ir_kind_int() || b.kind != ir_kind_int() {
            runtime_error(rt, "binary arithmetic requires int")
            return ir_value_unit()
        }
        let t = pick_int_type(a, b)
        if op == "+" { return ir_value_int_t(a.int + b.int, t) }
        if op == "-" { return ir_value_int_t(a.int - b.int, t) }
        if op == "*" { return ir_value_int_t(a.int * b.int, t) }
        if op == "/" {
            if b.int == 0 { runtime_error(rt, "division by zero"); return ir_value_unit() }
            return ir_value_int_t(a.int / b.int, t)
        }
        if op == "%" {
            if b.int == 0 { runtime_error(rt, "modulo by zero"); return ir_value_unit() }
            return ir_value_int_t(a.int % b.int, t)
        }
    }
    if op == "==" || op == "!=" {
        let eq = values_equal(rt, a, b)
        if op == "!=" { return ir_value_bool(!eq) }
        return ir_value_bool(eq)
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if a.kind != ir_kind_int() || b.kind != ir_kind_int() {
            runtime_error(rt, "comparison requires int")
            return ir_value_unit()
        }
        if op == "<" { return ir_value_bool(a.int < b.int) }
        if op == "<=" { return ir_value_bool(a.int <= b.int) }
        if op == ">" { return ir_value_bool(a.int > b.int) }
        if op == ">=" { return ir_value_bool(a.int >= b.int) }
    }
    if op == "&&" || op == "||" {
        if a.kind != ir_kind_bool() || b.kind != ir_kind_bool() {
            runtime_error(rt, "logical op requires bool")
            return ir_value_unit()
        }
        if op == "&&" { return ir_value_bool(a.bool && b.bool) }
        return ir_value_bool(a.bool || b.bool)
    }
    runtime_error(rt, "unknown binary op")
    return ir_value_unit()
}

fn pick_int_type(a: IrValue, b: IrValue) -> String {
    if a.int_type != "" { return a.int_type }
    if b.int_type != "" { return b.int_type }
    return ""
}

fn values_equal(rt: &Runtime, a: IrValue, b: IrValue) -> bool {
    if a.kind != b.kind { return false }
    if a.kind == ir_kind_int() { return a.int == b.int }
    if a.kind == ir_kind_bool() { return a.bool == b.bool }
    if a.kind == ir_kind_string() { return a.str == b.str }
    if a.kind == ir_kind_unit() { return true }
    if a.kind == ir_kind_enum() {
        let ia = a.obj
        let ib = b.obj
        if ia < 0 || ib < 0 { return false }
        if ia >= len(rt.enums) || ib >= len(rt.enums) { return false }
        let ea = rt.enums[ia]
        let eb = rt.enums[ib]
        if ea.name != eb.name { return false }
        if ea.variant != eb.variant { return false }
        if ea.has_payload != eb.has_payload { return false }
        if !ea.has_payload { return true }
        return values_equal(rt, ea.payload, eb.payload)
    }
    return false
}

fn find_block(f: IrFunction, label: String) -> i32 {
    let mut i = 0
    while i < len(f.blocks) {
        if f.blocks[i].label == label { return i }
        i = i + 1
    }
    return -1
}

fn find_function(p: IrProgram, name: String) -> i32 {
    let mut i = 0
    while i < len(p.functions) {
        if p.functions[i].name == name { return i }
        i = i + 1
    }
    return -1
}

fn is_builtin_name(name: String) -> bool {
    if name == "print" { return true }
    if name == "println" { return true }
    if name == "eprint" { return true }
    if name == "eprintln" { return true }
    if name == "len" { return true }
    if name == "push" { return true }
    if name == "pop" { return true }
    if name == "exit" { return true }
    if name == "read_file" { return true }
    if name == "read_dir" { return true }
    if name == "write_file" { return true }
    if name == "mkdir" { return true }
    if name == "args" { return true }
    if name == "char_at" { return true }
    if name == "substr" { return true }
    if name == "read_line" { return true }
    if name == "read_bytes" { return true }
    if name == "exec" { return true }
    return false
}

fn call_builtin(rt: &mut Runtime, name: String, args: [IrValue]) -> IrValue {
    if name == "print" || name == "println" {
        let mut i = 0
        while i < len(args) {
            if i > 0 {
                print(" ")
            }
            print(format_value(rt, args[i]))
            i = i + 1
        }
        if name == "println" {
            println("")
        }
        return ir_value_unit()
    }
    if name == "eprint" || name == "eprintln" {
        let mut i = 0
        while i < len(args) {
            if i > 0 {
                eprint(" ")
            }
            eprint(format_value(rt, args[i]))
            i = i + 1
        }
        if name == "eprintln" {
            eprintln("")
        }
        return ir_value_unit()
    }
    if name == "len" {
        if len(args) != 1 { runtime_error(rt, "len expects 1 argument"); return ir_value_unit() }
        let mut v = args[0]
        if v.kind == ir_kind_ref() {
            v = deref_value(rt, v)
        }
        if v.kind == ir_kind_string() { return ir_value_int(len(v.str)) }
        if v.kind == ir_kind_array() {
            let arr = array_value(rt, v)
            return ir_value_int(len(arr.elems))
        }
        runtime_error(rt, "len expects string or array")
        return ir_value_unit()
    }
    if name == "push" {
        if len(args) != 2 { runtime_error(rt, "push expects 2 arguments"); return ir_value_unit() }
        let target = args[0]
        if target.kind != ir_kind_ref() { runtime_error(rt, "push expects &mut array"); return ir_value_unit() }
        let mut val = deref_value(rt, target)
        if val.kind != ir_kind_array() { runtime_error(rt, "push expects array"); return ir_value_unit() }
        let idx = val.obj
        if idx < 0 || idx >= len(rt.arrays) { runtime_error(rt, "invalid array"); return ir_value_unit() }
        let mut arr = rt.arrays[idx]
        let mut elems = arr.elems
        push(&mut elems, args[1])
        arr.elems = elems
        rt.arrays[idx] = arr
        return ir_value_unit()
    }
    if name == "pop" {
        if len(args) != 1 { runtime_error(rt, "pop expects 1 argument"); return ir_value_unit() }
        let target = args[0]
        if target.kind != ir_kind_ref() { runtime_error(rt, "pop expects &mut array"); return ir_value_unit() }
        let mut val = deref_value(rt, target)
        if val.kind != ir_kind_array() { runtime_error(rt, "pop expects array"); return ir_value_unit() }
        let idx = val.obj
        if idx < 0 || idx >= len(rt.arrays) { runtime_error(rt, "invalid array"); return ir_value_unit() }
        let mut arr = rt.arrays[idx]
        if len(arr.elems) == 0 { runtime_error(rt, "pop from empty array"); return ir_value_unit() }
        let last = arr.elems[len(arr.elems) - 1]
        let mut trimmed: [IrValue] = []
        let mut i = 0
        while i < len(arr.elems) - 1 {
            push(&mut trimmed, arr.elems[i])
            i = i + 1
        }
        arr.elems = trimmed
        rt.arrays[idx] = arr
        return last
    }
    if name == "exit" {
        if len(args) > 1 { runtime_error(rt, "exit expects 0 or 1 argument"); return ir_value_unit() }
        let mut code = 0
        if len(args) == 1 {
            if args[0].kind != ir_kind_int() { runtime_error(rt, "exit expects int"); return ir_value_unit() }
            code = args[0].int
        }
        runtime_error(rt, "exit " + int_to_string(code))
        return ir_value_unit()
    }
    if name == "read_file" {
        if len(args) != 1 { runtime_error(rt, "read_file expects 1 argument"); return ir_value_unit() }
        if args[0].kind != ir_kind_string() { runtime_error(rt, "read_file expects string path"); return ir_value_unit() }
        let data = read_file(args[0].str)
        return ir_value_string(data)
    }
    if name == "read_dir" {
        if len(args) != 1 { runtime_error(rt, "read_dir expects 1 argument"); return ir_value_unit() }
        if args[0].kind != ir_kind_string() { runtime_error(rt, "read_dir expects string path"); return ir_value_unit() }
        let names = read_dir(args[0].str)
        let mut elems: [IrValue] = []
        let mut i = 0
        while i < len(names) {
            push(&mut elems, ir_value_string(names[i]))
            i = i + 1
        }
        let arr_idx = array_alloc(rt, IrArrayValue { elems: elems })
        return ir_value_array(arr_idx)
    }
    if name == "write_file" {
        if len(args) != 2 { runtime_error(rt, "write_file expects 2 arguments"); return ir_value_unit() }
        if args[0].kind != ir_kind_string() || args[1].kind != ir_kind_string() {
            runtime_error(rt, "write_file expects string path and data")
            return ir_value_unit()
        }
        write_file(args[0].str, args[1].str)
        return ir_value_unit()
    }
    if name == "mkdir" {
        if len(args) != 1 { runtime_error(rt, "mkdir expects 1 argument"); return ir_value_unit() }
        if args[0].kind != ir_kind_string() {
            runtime_error(rt, "mkdir expects string path")
            return ir_value_unit()
        }
        mkdir(args[0].str)
        return ir_value_unit()
    }
    if name == "args" {
        if len(args) != 0 { runtime_error(rt, "args expects no arguments"); return ir_value_unit() }
        let mut elems: [IrValue] = []
        let mut i = 0
        while i < len(rt.args) {
            push(&mut elems, ir_value_string(rt.args[i]))
            i = i + 1
        }
        let arr_idx = array_alloc(rt, IrArrayValue { elems: elems })
        return ir_value_array(arr_idx)
    }
    if name == "char_at" {
        if len(args) != 2 { runtime_error(rt, "char_at expects 2 arguments"); return ir_value_unit() }
        if args[0].kind != ir_kind_string() || args[1].kind != ir_kind_int() {
            runtime_error(rt, "char_at expects string and int")
            return ir_value_unit()
        }
        let idx = args[1].int
        if idx < 0 || idx >= len(args[0].str) { runtime_error(rt, "char_at index out of bounds"); return ir_value_unit() }
        let ch = char_at(args[0].str, idx)
        return ir_value_int(ch)
    }
    if name == "substr" {
        if len(args) != 3 { runtime_error(rt, "substr expects 3 arguments"); return ir_value_unit() }
        if args[0].kind != ir_kind_string() || args[1].kind != ir_kind_int() || args[2].kind != ir_kind_int() {
            runtime_error(rt, "substr expects string, int, int")
            return ir_value_unit()
        }
        let start = args[1].int
        let ln = args[2].int
        if start < 0 || ln < 0 || start + ln > len(args[0].str) {
            runtime_error(rt, "substr out of bounds")
            return ir_value_unit()
        }
        return ir_value_string(substr(args[0].str, start, ln))
    }
    if name == "read_line" {
        if len(args) != 0 { runtime_error(rt, "read_line expects no arguments"); return ir_value_unit() }
        let line = read_line()
        return ir_value_string(line)
    }
    if name == "read_bytes" {
        if len(args) != 1 { runtime_error(rt, "read_bytes expects 1 argument"); return ir_value_unit() }
        if args[0].kind != ir_kind_int() { runtime_error(rt, "read_bytes expects int count"); return ir_value_unit() }
        let n = args[0].int
        let data = read_bytes(n)
        return ir_value_string(data)
    }
    if name == "exec" {
        if len(args) != 2 { runtime_error(rt, "exec expects 2 arguments"); return ir_value_unit() }
        if args[0].kind != ir_kind_string() { runtime_error(rt, "exec expects string command"); return ir_value_unit() }
        if args[1].kind != ir_kind_array() { runtime_error(rt, "exec expects [string] args"); return ir_value_unit() }
        let arr = array_value(rt, args[1])
        let mut argv: [String] = []
        let mut i = 0
        while i < len(arr.elems) {
            let v = arr.elems[i]
            if v.kind != ir_kind_string() { runtime_error(rt, "exec expects [string] args"); return ir_value_unit() }
            push(&mut argv, v.str)
            i = i + 1
        }
        let code = exec(args[0].str, argv)
        return ir_value_int(code)
    }
    runtime_error(rt, "unknown builtin")
    return ir_value_unit()
}

fn format_value(rt: &Runtime, v: IrValue) -> String {
    if v.kind == ir_kind_int() { return int_to_string(v.int) }
    if v.kind == ir_kind_string() { return v.str }
    if v.kind == ir_kind_struct() {
        let idx = v.obj
        if idx >= 0 && idx < len(rt.structs) {
            return rt.structs[idx].name + "{...}"
        }
        return "struct{...}"
    }
    if v.kind == ir_kind_enum() {
        let idx = v.obj
        if idx >= 0 && idx < len(rt.enums) {
            return rt.enums[idx].name + "." + rt.enums[idx].variant
        }
        return "enum"
    }
    if v.kind == ir_kind_array() {
        let idx = v.obj
        if idx >= 0 && idx < len(rt.arrays) {
            return "[len=" + int_to_string(len(rt.arrays[idx].elems)) + "]"
        }
        return "[]"
    }
    return ir_value_stringify(v)
}
