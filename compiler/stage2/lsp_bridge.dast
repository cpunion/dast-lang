// LSP Bridge: Exposes Stage 2 frontend analysis to Stage 3 LSP
// This file is part of Stage 2 and provides functions that Stage 3 can call

// Analyze source code and return parse/type errors as strings
// Returns: [parse_error1, parse_error2, ..., type_error1, type_error2, ...]
fn lsp_analyze_source(content: String) -> [String] {
    let mut all_errors: [String] = []

    // Run lexer + parser
    let mut lex = lexer_new(string_clone(&content))
    let mut parse_errors: [ParseError] = []
    let prog = parse_program(&content, "", &mut lex, &mut parse_errors)

    // Collect parse errors
    let mut i = 0
    while i < len(parse_errors) {
        let pe = parse_errors[i]
        // Format: "line:col:message"
        let err_str = int_to_string(pe.line) + ":" + int_to_string(pe.col) + ":" + pe.msg
        push(&mut all_errors, err_str)
        i = i + 1
    }

    // Run type checker (if parsing succeeded)
    if len(parse_errors) == 0 {
        let ctx = check_program(prog, false, false, false)

        // Collect type errors
        let type_errors = ctx.errors
        let mut j = 0
        while j < len(type_errors) {
            let te = type_errors[j]
            let err_str = int_to_string(te.line) + ":" + int_to_string(te.col) + ":" + te.msg
            push(&mut all_errors, err_str)
            j = j + 1
        }
    }

    return all_errors
}

// Find definition of symbol at given position
// Returns: "line:col:name" or "" if not found
fn lsp_find_definition(content: String, target_line: i32, target_col: i32) -> String {
    // Parse the source
    let mut lex = lexer_new(string_clone(&content))
    let mut parse_errors: [ParseError] = []
    let prog = parse_program(&content, "", &mut lex, &mut parse_errors)

    if len(parse_errors) > 0 {
        return ""
    }

    // MVP: Return first function or struct
    let mut i = 0
    while i < len(prog.functions) {
        if i == 0 {
            return "0:0:" + prog.functions[i].name
        }
        i = i + 1
    }

    let mut j = 0
    while j < len(prog.structs) {
        if j == 0 {
            return "0:0:" + prog.structs[j].name
        }
        j = j + 1
    }

    return ""
}

// Get hover information for symbol at position
// Returns: formatted signature or "" if not found
fn lsp_get_hover(content: String, target_line: i32, target_col: i32) -> String {
    // Parse the source
    let mut lex = lexer_new(string_clone(&content))
    let mut parse_errors: [ParseError] = []
    let prog = parse_program(&content, "", &mut lex, &mut parse_errors)

    if len(parse_errors) > 0 {
        return ""
    }

    // MVP: Return signature of first function
    let mut i = 0
    while i < len(prog.functions) {
        if i == 0 {
            return format_function_signature(prog.functions[i])
        }
        i = i + 1
    }

    // Or first struct
    let mut j = 0
    while j < len(prog.structs) {
        if j == 0 {
            return format_struct_signature(prog.structs[j])
        }
        j = j + 1
    }

    return ""
}

// Get code completions
// Returns: list of completion items (function and struct names)
fn lsp_get_completions(content: String, target_line: i32, target_col: i32) -> [String] {
    let mut completions: [String] = []

    // Parse the source
    let mut lex = lexer_new(string_clone(&content))
    let mut parse_errors: [ParseError] = []
    let prog = parse_program(&content, "", &mut lex, &mut parse_errors)

    if len(parse_errors) > 0 {
        return completions
    }

    // Add all function names
    let mut i = 0
    while i < len(prog.functions) {
        push(&mut completions, prog.functions[i].name)
        i = i + 1
    }

    // Add all struct names
    let mut j = 0
    while j < len(prog.structs) {
        push(&mut completions, prog.structs[j].name)
        j = j + 1
    }

    return completions
}

// Format function signature for hover
fn format_function_signature(func: FunctionDecl) -> String {
    let mut sig = "fn " + func.name + "("

    // Add parameters
    let mut i = 0
    while i < len(func.params) {
        if i > 0 {
            sig = sig + ", "
        }
        sig = sig + func.params[i].name + ": " + func.params[i].typ
        i = i + 1
    }

    sig = sig + ")"

    if func.has_return {
        sig = sig + " -> " + func.ret
    }

    return sig
}

// Format struct signature for hover
fn format_struct_signature(st: StructDecl) -> String {
    let mut sig = "struct " + st.name

    if len(st.type_params) > 0 {
        sig = sig + "["
        let mut i = 0
        while i < len(st.type_params) {
            if i > 0 {
                sig = sig + ", "
            }
            sig = sig + st.type_params[i].name
            i = i + 1
        }
        sig = sig + "]"
    }

    return sig
}
