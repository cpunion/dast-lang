// stage2 driver: keep simple, but exercise full compile->run.

fn usage() {
    println("usage", "dast-stage2 <build|run> <file.dast> [-o out] [--target <arch>] [--target-ptr-width <32|64>] [-- args]")
}

fn target_ptr_width_from_name(name: &str) -> i64 {
    if name == "x86_64" || name == "amd64" || name == "aarch64" || name == "arm64" { return 64 }
    if name == "i386" || name == "x86" || name == "armv7" || name == "arm" || name == "wasm32" { return 32 }
    return 0
}

fn main() {
    let argv = args()
    if len(&argv) == 0 {
        println("stage2", "scaffold")
        usage()
        return
    }

    let cmd = string_clone(&argv[0])
    if cmd == "--self-test" {
        println("stage2", "ok")
        return
    }
    if cmd == "--drop-self-test" {
        println("drop", drop_needs_drop_type("String"))
        println("drop", drop_needs_drop_type("[i64]"))
        println("drop", drop_needs_drop_type("i64"))
        println("drop", drop_needs_drop_type("&str"))
        return
    }
    if cmd == "--drop-pass-self-test" {
        let drops = drop_pass_self_test()
        println("drop-pass", drops)
        return
    }

    if cmd != "build" && cmd != "run" {
        println("error", "unknown command")
        usage()
        exit(2)
        return
    }
    if len(&argv) < 2 {
        println("error", "missing input file")
        usage()
        exit(2)
        return
    }

    let mut out_bin = "compiler/stage2/target/min/main"
    let mut ptr_width: i64 = 0
    let mut stats = false
    let mut arg_idx = 1
    if len(&argv) > 1 && argv[1] == "--stats" {
        stats = true
        arg_idx = 2
    }
    if len(&argv) <= arg_idx {
        println("error", "missing input file")
        usage()
        exit(2)
        return
    }
    let src_path = string_clone(&argv[arg_idx])
    let mut run_args: [String] = []
    let mut i = arg_idx + 1
    let mut after_sep = false
    while i < len(&argv) {
        let a = string_clone(&argv[i])
        if !after_sep && a == "--" {
            after_sep = true
            i = i + 1
            continue
        }
        if !after_sep && a == "-o" && i + 1 < len(&argv) {
            out_bin = string_clone(&argv[i + 1])
            i = i + 2
            continue
        }
        if !after_sep && a == "--target-ptr-width" && i + 1 < len(&argv) {
            ptr_width = parse_int_simple(&argv[i + 1])
            i = i + 2
            continue
        }
        if !after_sep && a == "--target" && i + 1 < len(&argv) {
            let pw = target_ptr_width_from_name(&argv[i + 1])
            if pw == 0 {
                println("error", "unknown target", argv[i + 1])
                exit(2)
                return
            }
            ptr_width = pw
            i = i + 2
            continue
        }
        if !after_sep && a == "--stats" {
            stats = true
            i = i + 1
            continue
        }
        if after_sep {
            push(&mut run_args, a)
        }
        i = i + 1
    }

    if ptr_width == 0 {
        let env = getenv("DAST_TARGET_PTR_WIDTH")
        if env != "" {
            ptr_width = parse_int_simple(&env)
        }
    }
    if ptr_width != 32 && ptr_width != 64 {
        ptr_width = 64
    }

    if cmd == "build" {
        if stats {
            compile_native_single_stats(src_path, string_clone(&out_bin), ptr_width)
        } else {
            compile_native_single(src_path, string_clone(&out_bin), ptr_width)
        }
        println("built", out_bin)
        return
    }

    // run
    if stats {
        compile_native_single_stats(src_path, string_clone(&out_bin), ptr_width)
    } else {
        compile_native_single(src_path, string_clone(&out_bin), ptr_width)
    }
    let code = exec(out_bin, run_args)
    if code != 0 {
        println("run-exit", code)
        exit(code)
        return
    }
}
