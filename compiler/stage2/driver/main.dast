struct ArgSplit {
    files: [String],
    rest: [String],
}

struct LineCol {
    line: i32,
    col: i32,
}

struct ParseResult {
    prog: Program,
    errors: [ParseError],
}

fn struct_list_new() -> [StructDecl] {
    let mut items: [StructDecl] = []
    return items
}

fn enum_list_new() -> [EnumDecl] {
    let mut items: [EnumDecl] = []
    return items
}

fn const_list_new() -> [ConstDecl] {
    let mut items: [ConstDecl] = []
    return items
}

fn func_list_new() -> [FunctionDecl] {
    let mut items: [FunctionDecl] = []
    return items
}

fn impl_list_new() -> [ImplDecl] {
    let mut items: [ImplDecl] = []
    return items
}

fn import_list_new() -> [ImportDecl] {
    let mut items: [ImportDecl] = []
    return items
}

fn driver_string_list_new() -> [String] {
    let mut items: [String] = []
    return items
}

fn program_empty() -> Program {
    return Program {
        imports: import_list_new(),
        structs: struct_list_new(),
        enums: enum_list_new(),
        consts: const_list_new(),
        functions: func_list_new(),
        impls: impl_list_new(),
    }
}

fn driver_qualify_name(module: String, name: String) -> String {
    if module == "" { return name }
    return module + "::" + name
}

fn usage() {
    println("usage:")
    println("  dast build <file.dast|dir> [more ...]")
    println("  dast run <file.dast|dir> [more ...] [-- args...]")
    println("  dast ir <file.dast|dir> [more ...]")
    println("  dast test <file.dast|dir> [more ...]")
    println("  dast ir-run <file.ir> [-- args...]")
    println("  dast ir-verify <file.ir>")
    println("  dast ir-opt <file.ir>")
}

fn die_usage() {
    usage()
    exit(1)
}

fn die_error(msg: String) {
    print_error_line("", 0, 0, msg)
    exit(1)
}

fn die_parse(file: String, line: i32, msg: String) {
    print_error_line(file, line, 1, msg)
    exit(1)
}

fn die_errors(errors: [ParseError]) {
    print_errors(errors)
    exit(1)
}

fn handle_runtime_error(err: String) {
    if err == "" { return }
    if driver_string_starts_with(err, "exit ") {
        let code = parse_int(substr(err, 5, len(err) - 5))
        exit(code)
    }
    print_error_line("<runtime>", 0, 0, err)
    exit(1)
}

fn split_args(args: [String], start: i32) -> ArgSplit {
    let mut files: [String] = []
    let mut rest: [String] = []
    let mut i = start
    let mut done = false
    while i < len(args) && !done {
        if args[i] == "--" {
            i = i + 1
            done = true
        } else {
            push(&mut files, args[i])
            i = i + 1
        }
    }
    while i < len(args) {
        push(&mut rest, args[i])
        i = i + 1
    }
    return ArgSplit { files: files, rest: rest }
}

fn parse_files(files: [String]) -> ParseResult {
    let mut merged = program_empty()
    let mut errs: [ParseError] = []
    let mut i = 0
    while i < len(files) {
        let src = read_file(files[i])
        let mut lex = lexer_new(src)
        let mut local_errs: [ParseError] = []
        let mut prog = parse_program(src, &mut lex, &mut local_errs)
        program_set_file(&mut prog, files[i])
        append_program(&mut merged, prog)
        let mut j = 0
        while j < len(local_errs) {
            let e = local_errs[j]
            let mut line = 0
            let mut col = 0
            if e.pos >= 0 {
                let mut offset = 0
                if e.pos < len(lex.toks.items) {
                    offset = tok_start(lex.toks, e.pos)
                } else {
                    offset = len(src)
                }
                let lc = line_col_from_offset(src, offset)
                line = lc.line
                col = lc.col
            }
            push(&mut errs, ParseError { pos: e.pos, file: files[i], line: line, col: col, msg: e.msg })
            j = j + 1
        }
        i = i + 1
    }
    return ParseResult { prog: merged, errors: errs }
}

fn append_program(dst: &mut Program, src: Program) {
    let mut imports = dst.imports
    let mut i = 0
    while i < len(src.imports) {
        push(&mut imports, src.imports[i])
        i = i + 1
    }
    dst.imports = imports
    let mut structs = dst.structs
    i = 0
    while i < len(src.structs) {
        push(&mut structs, src.structs[i])
        i = i + 1
    }
    dst.structs = structs
    let mut enums = dst.enums
    i = 0
    while i < len(src.enums) {
        push(&mut enums, src.enums[i])
        i = i + 1
    }
    dst.enums = enums
    let mut consts = dst.consts
    i = 0
    while i < len(src.consts) {
        push(&mut consts, src.consts[i])
        i = i + 1
    }
    dst.consts = consts
    let mut funcs = dst.functions
    i = 0
    while i < len(src.functions) {
        push(&mut funcs, src.functions[i])
        i = i + 1
    }
    dst.functions = funcs
    let mut impls = dst.impls
    i = 0
    while i < len(src.impls) {
        push(&mut impls, src.impls[i])
        i = i + 1
    }
    dst.impls = impls
}

fn driver_list_contains(list: [String], value: String) -> bool {
    let mut i = 0
    while i < len(list) {
        if list[i] == value {
            return true
        }
        i = i + 1
    }
    return false
}

fn driver_list_index(list: [String], value: String) -> i32 {
    let mut i = 0
    while i < len(list) {
        if list[i] == value {
            return i
        }
        i = i + 1
    }
    return -1
}

fn driver_path_dir(path: String) -> String {
    let mut last = -1
    let mut i = 0
    while i < len(path) {
        if char_at(path, i) == 47 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return "."
    }
    if last == 0 {
        return "/"
    }
    return substr(path, 0, last)
}

fn driver_path_join(dir: String, rel: String) -> String {
    if dir == "" || dir == "." {
        return rel
    }
    if char_at(dir, len(dir) - 1) == 47 {
        return dir + rel
    }
    return dir + "/" + rel
}

fn driver_replace_dots(path: String) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(path) {
        let c = char_at(path, i)
        if c == 46 {
            out = out + "/"
        } else {
            out = out + substr(path, i, 1)
        }
        i = i + 1
    }
    return out
}

fn driver_module_path_to_dir(base_dir: String, mod_path: String) -> String {
    let rel = driver_replace_dots(mod_path)
    return driver_path_join(base_dir, rel)
}

fn driver_string_ends_with(text: String, suffix: String) -> bool {
    if len(text) < len(suffix) { return false }
    let start = len(text) - len(suffix)
    return substr(text, start, len(suffix)) == suffix
}

fn driver_string_starts_with(text: String, prefix: String) -> bool {
    if len(text) < len(prefix) { return false }
    return substr(text, 0, len(prefix)) == prefix
}

fn driver_string_contains(text: String, needle: String) -> bool {
    if needle == "" { return true }
    let mut i = 0
    while i + len(needle) <= len(text) {
        if substr(text, i, len(needle)) == needle {
            return true
        }
        i = i + 1
    }
    return false
}

fn driver_trim_space(text: String) -> String {
    let mut start = 0
    let mut end = len(text)
    let mut done = false
    while start < end && !done {
        let c = char_at(text, start)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            start = start + 1
        } else {
            done = true
        }
    }
    done = false
    while end > start && !done {
        let c = char_at(text, end - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            end = end - 1
        } else {
            done = true
        }
    }
    if end <= start { return "" }
    return substr(text, start, end - start)
}

fn driver_split_lines(text: String) -> [String] {
    let mut lines: [String] = []
    let mut i = 0
    let mut start = 0
    while i < len(text) {
        let c = char_at(text, i)
        if c == 10 {
            push(&mut lines, substr(text, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    if start <= len(text) {
        push(&mut lines, substr(text, start, len(text) - start))
    }
    return lines
}

fn driver_split_path(path: String) -> [String] {
    let mut parts: [String] = []
    let mut i = 0
    let mut start = 0
    while i < len(path) {
        if char_at(path, i) == 47 {
            push(&mut parts, substr(path, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(&mut parts, substr(path, start, len(path) - start))
    return parts
}

fn driver_path_clean(path: String) -> String {
    let mut abs = false
    if len(path) > 0 && char_at(path, 0) == 47 {
        abs = true
    }
    let parts = driver_split_path(path)
    let mut stack: [String] = []
    let mut i = 0
    while i < len(parts) {
        let seg = parts[i]
        if seg == "" || seg == "." {
            // skip
        } else if seg == ".." {
            if len(stack) > 0 {
                let _ = pop(&mut stack)
            }
        } else {
            push(&mut stack, seg)
        }
        i = i + 1
    }
    let mut out = ""
    if abs { out = "/" }
    let mut j = 0
    while j < len(stack) {
        if j > 0 || abs {
            if out != "/" && out != "" { out = out + "/" }
        }
        out = out + stack[j]
        j = j + 1
    }
    if out == "" {
        if abs { return "/" }
        return "."
    }
    return out
}

fn driver_is_test_file(name: String) -> bool {
    return driver_string_ends_with(name, "_test.dast")
}

fn driver_is_dast_file(name: String) -> bool {
    return driver_string_ends_with(name, ".dast")
}

fn driver_list_dast_files(dir: String, include_tests: bool) -> [String] {
    let mut files: [String] = []
    let names = read_dir(dir)
    let mut i = 0
    while i < len(names) {
        let name = names[i]
        let mut take = false
        if driver_is_dast_file(name) {
            take = true
            if !include_tests && driver_is_test_file(name) {
                take = false
            }
        }
        if take {
            let full = driver_path_join(dir, name)
            push(&mut files, full)
        }
        i = i + 1
    }
    return files
}

fn driver_replace_slash(path: String) -> String {
    let mut out = ""
    let mut i = 0
    while i < len(path) {
        let c = char_at(path, i)
        if c == 47 {
            out = out + "."
        } else {
            out = out + substr(path, i, 1)
        }
        i = i + 1
    }
    return out
}

fn driver_path_rel(base: String, path: String) -> String {
    if base == "" || base == "." {
        return path
    }
    if path == base {
        return ""
    }
    let mut prefix = base
    if char_at(prefix, len(prefix) - 1) != 47 {
        prefix = prefix + "/"
    }
    if driver_string_starts_with(path, prefix) {
        return substr(path, len(prefix), len(path) - len(prefix))
    }
    return path
}

fn driver_path_is_within(root: String, path: String) -> bool {
    if root == "" || root == "." { return true }
    let clean_root = driver_path_clean(root)
    let clean_path = driver_path_clean(path)
    if clean_path == clean_root { return true }
    let mut prefix = clean_root
    if len(prefix) > 0 && char_at(prefix, len(prefix) - 1) != 47 {
        prefix = prefix + "/"
    }
    return driver_string_starts_with(clean_path, prefix)
}

fn driver_module_path_from_dir(root_dir: String, dir: String) -> String {
    let rel = driver_path_rel(root_dir, dir)
    if rel == "" || rel == "." {
        return ""
    }
    return driver_replace_slash(rel)
}

fn driver_dir_has_entry(dir: String, name: String) -> bool {
    let names = read_dir(dir)
    let mut i = 0
    while i < len(names) {
        if names[i] == name { return true }
        i = i + 1
    }
    return false
}

fn driver_find_package_root(path: String) -> String {
    let mut dir = path
    if driver_is_dast_file(path) {
        dir = driver_path_dir(path)
    }
    let mut cur = dir
    let mut done = false
    while cur != "" && !done {
        if driver_dir_has_entry(cur, "dast.toml") {
            return cur
        }
        let parent = driver_path_dir(cur)
        if parent == cur || parent == "" {
            done = true
        } else {
            cur = parent
        }
    }
    return ""
}

fn driver_code_root(pkg_root: String) -> String {
    if pkg_root == "" { return "" }
    if driver_dir_has_entry(pkg_root, "src") {
        return driver_path_join(pkg_root, "src")
    }
    return pkg_root
}

fn driver_parse_package_name(toml: String) -> String {
    let lines = driver_split_lines(toml)
    let mut in_pkg = false
    let mut i = 0
    while i < len(lines) {
        let line = driver_trim_space(lines[i])
        if !(line == "" || driver_string_starts_with(line, "#")) {
            if driver_string_starts_with(line, "[") {
                in_pkg = line == "[package]"
            } else if in_pkg && driver_string_starts_with(line, "name") {
                let eq = find_char(line, 61, 0)
                if eq >= 0 {
                    let raw = driver_trim_space(substr(line, eq + 1, len(line) - eq - 1))
                    if len(raw) >= 2 && char_at(raw, 0) == 34 {
                        return parse_string_lit_token(raw)
                    }
                }
            }
        }
        i = i + 1
    }
    return ""
}

fn driver_package_name(pkg_root: String) -> String {
    if pkg_root == "" { return "" }
    let text = read_file(driver_path_join(pkg_root, "dast.toml"))
    return driver_parse_package_name(text)
}

fn driver_is_relative_import(path: String) -> bool {
    if driver_string_starts_with(path, "./") { return true }
    if driver_string_starts_with(path, "../") { return true }
    return false
}

fn driver_import_rel_to_path(rel: String) -> String {
    if driver_string_contains(rel, "/") {
        return rel
    }
    return driver_replace_dots(rel)
}

fn driver_import_path_to_dir(base_dir: String, root_dir: String, path: String, is_string: bool) -> String {
    let mut rel = path
    let mut from_dir = base_dir
    if is_string {
        if !driver_is_relative_import(path) {
            from_dir = root_dir
        }
        if driver_string_starts_with(rel, "./") {
            rel = substr(rel, 2, len(rel) - 2)
        }
        rel = driver_import_rel_to_path(rel)
    } else {
        rel = driver_replace_dots(rel)
    }
    return driver_path_clean(driver_path_join(from_dir, rel))
}

fn program_set_module(prog: &mut Program, module: String) {
    let mut imports: [ImportDecl] = []
    let mut i = 0
    while i < len(prog.imports) {
        let imp = prog.imports[i]
        push(&mut imports, ImportDecl {
            vis: imp.vis,
            module: module,
            file: imp.file,
            pos: imp.pos,
            has_items: imp.has_items,
            items: imp.items,
            path: imp.path,
            path_is_string: imp.path_is_string,
            has_alias: imp.has_alias,
            alias: imp.alias,
        })
        i = i + 1
    }
    prog.imports = imports

    let mut structs: [StructDecl] = []
    i = 0
    while i < len(prog.structs) {
        let st = prog.structs[i]
        push(&mut structs, StructDecl { vis: st.vis, module: module, file: st.file, pos: st.pos, name: st.name, fields: st.fields })
        i = i + 1
    }
    prog.structs = structs

    let mut enums: [EnumDecl] = []
    i = 0
    while i < len(prog.enums) {
        let en = prog.enums[i]
        push(&mut enums, EnumDecl { vis: en.vis, module: module, file: en.file, pos: en.pos, name: en.name, repr: en.repr, variants: en.variants })
        i = i + 1
    }
    prog.enums = enums

    let mut consts: [ConstDecl] = []
    i = 0
    while i < len(prog.consts) {
        let c = prog.consts[i]
        push(&mut consts, ConstDecl { vis: c.vis, module: module, file: c.file, pos: c.pos, name: c.name, has_type: c.has_type, typ: c.typ, value: c.value })
        i = i + 1
    }
    prog.consts = consts

    let mut funcs: [FunctionDecl] = []
    i = 0
    while i < len(prog.functions) {
        let f = prog.functions[i]
        push(&mut funcs, FunctionDecl {
            vis: f.vis,
            module: module,
            file: f.file,
            pos: f.pos,
            name: f.name,
            is_test: f.is_test,
            params: f.params,
            has_return: f.has_return,
            ret: f.ret,
            body: f.body,
        })
        i = i + 1
    }
    prog.functions = funcs

    let mut impls: [ImplDecl] = []
    i = 0
    while i < len(prog.impls) {
        let imp = prog.impls[i]
        let mut methods: [FunctionDecl] = []
        let mut j = 0
        while j < len(imp.methods) {
            let m = imp.methods[j]
            push(&mut methods, FunctionDecl {
                vis: m.vis,
                module: module,
                file: m.file,
                pos: m.pos,
                name: m.name,
                is_test: m.is_test,
                params: m.params,
                has_return: m.has_return,
                ret: m.ret,
                body: m.body,
            })
            j = j + 1
        }
        push(&mut impls, ImplDecl { vis: imp.vis, module: module, file: imp.file, pos: imp.pos, type_name: imp.type_name, methods: methods })
        i = i + 1
    }
    prog.impls = impls
}

fn program_set_file(prog: &mut Program, file: String) {
    let mut imports: [ImportDecl] = []
    let mut i = 0
    while i < len(prog.imports) {
        let imp = prog.imports[i]
        push(&mut imports, ImportDecl {
            vis: imp.vis,
            module: imp.module,
            file: file,
            pos: imp.pos,
            has_items: imp.has_items,
            items: imp.items,
            path: imp.path,
            path_is_string: imp.path_is_string,
            has_alias: imp.has_alias,
            alias: imp.alias,
        })
        i = i + 1
    }
    prog.imports = imports

    let mut structs: [StructDecl] = []
    i = 0
    while i < len(prog.structs) {
        let st = prog.structs[i]
        push(&mut structs, StructDecl { vis: st.vis, module: st.module, file: file, pos: st.pos, name: st.name, fields: st.fields })
        i = i + 1
    }
    prog.structs = structs

    let mut enums: [EnumDecl] = []
    i = 0
    while i < len(prog.enums) {
        let en = prog.enums[i]
        push(&mut enums, EnumDecl { vis: en.vis, module: en.module, file: file, pos: en.pos, name: en.name, repr: en.repr, variants: en.variants })
        i = i + 1
    }
    prog.enums = enums

    let mut consts: [ConstDecl] = []
    i = 0
    while i < len(prog.consts) {
        let c = prog.consts[i]
        push(&mut consts, ConstDecl { vis: c.vis, module: c.module, file: file, pos: c.pos, name: c.name, has_type: c.has_type, typ: c.typ, value: c.value })
        i = i + 1
    }
    prog.consts = consts

    let mut funcs: [FunctionDecl] = []
    i = 0
    while i < len(prog.functions) {
        let f = prog.functions[i]
        push(&mut funcs, FunctionDecl {
            vis: f.vis,
            module: f.module,
            file: file,
            pos: f.pos,
            name: f.name,
            is_test: f.is_test,
            params: f.params,
            has_return: f.has_return,
            ret: f.ret,
            body: f.body,
        })
        i = i + 1
    }
    prog.functions = funcs

    let mut impls: [ImplDecl] = []
    i = 0
    while i < len(prog.impls) {
        let imp = prog.impls[i]
        let mut methods: [FunctionDecl] = []
        let mut j = 0
        while j < len(imp.methods) {
            let m = imp.methods[j]
            push(&mut methods, FunctionDecl {
                vis: m.vis,
                module: m.module,
                file: file,
                pos: m.pos,
                name: m.name,
                is_test: m.is_test,
                params: m.params,
                has_return: m.has_return,
                ret: m.ret,
                body: m.body,
            })
            j = j + 1
        }
        push(&mut impls, ImplDecl { vis: imp.vis, module: imp.module, file: file, pos: imp.pos, type_name: imp.type_name, methods: methods })
        i = i + 1
    }
    prog.impls = impls
}

struct LoadState {
    merged: Program,
    errors: [ParseError],
    loaded: [String],
    sources: [String],
}

fn load_state_new() -> LoadState {
    return LoadState { merged: program_empty(), errors: parse_error_list_new(), loaded: driver_string_list_new(), sources: driver_string_list_new() }
}

fn load_file_recursive(path: String, root_dir: String, module_path: String, state: &mut LoadState, include_tests: bool) {
    if driver_list_contains(state.loaded, path) {
        return
    }
    let src = read_file(path)
    let mut loaded = state.loaded
    push(&mut loaded, path)
    state.loaded = loaded
    let mut sources = state.sources
    push(&mut sources, src)
    state.sources = sources
    let mut lex = lexer_new(src)
    let mut local_errs: [ParseError] = []
    let mut prog = parse_program(src, &mut lex, &mut local_errs)
    program_set_file(&mut prog, path)
    program_set_module(&mut prog, module_path)

    let base = driver_path_dir(path)
    let mut imports: [ImportDecl] = []
    let mut child_dirs: [String] = []
    let mut j = 0
    while j < len(prog.imports) {
        let imp = prog.imports[j]
        if imp.path != "" {
            let child_dir = driver_import_path_to_dir(base, root_dir, imp.path, imp.path_is_string)
            if !driver_path_is_within(root_dir, child_dir) {
                die_error("import path escapes package root: " + imp.path)
            }
            let child_mod = driver_module_path_from_dir(root_dir, child_dir)
            let mut new_path = child_mod
            if child_mod != "" {
                new_path = "::" + child_mod
            }
            push(&mut imports, ImportDecl {
                vis: imp.vis,
                module: imp.module,
                file: imp.file,
                pos: imp.pos,
                has_items: imp.has_items,
                items: imp.items,
                path: new_path,
                path_is_string: false,
                has_alias: imp.has_alias,
                alias: imp.alias,
            })
            push(&mut child_dirs, child_dir)
        } else {
            push(&mut imports, imp)
        }
        j = j + 1
    }
    prog.imports = imports

    let mut merged = state.merged
    append_program(&mut merged, prog)
    state.merged = merged
    let mut errs = state.errors
    let mut i = 0
    while i < len(local_errs) {
        let e = local_errs[i]
        let mut line = 0
        let mut col = 0
        if e.pos >= 0 {
            let mut offset = 0
            if e.pos < len(lex.toks.items) {
                offset = tok_start(lex.toks, e.pos)
            } else {
                offset = len(src)
            }
            let lc = line_col_from_offset(src, offset)
            line = lc.line
            col = lc.col
        }
        push(&mut errs, ParseError { pos: e.pos, file: path, line: line, col: col, msg: e.msg })
        i = i + 1
    }
    state.errors = errs

    j = 0
    while j < len(child_dirs) {
        load_dir_recursive(child_dirs[j], root_dir, state, false)
        j = j + 1
    }
}

fn load_dir_recursive(dir: String, root_dir: String, state: &mut LoadState, include_tests: bool) {
    let module_path = driver_module_path_from_dir(root_dir, dir)
    let files = driver_list_dast_files(dir, include_tests)
    let mut i = 0
    while i < len(files) {
        load_file_recursive(files[i], root_dir, module_path, state, include_tests)
        i = i + 1
    }
}

fn print_errors(errors: [ParseError]) {
    let mut i = 0
    while i < len(errors) {
        let e = errors[i]
        print_error_line(e.file, e.line, e.col, e.msg)
        i = i + 1
    }
}

fn driver_source_for(state: &LoadState, path: String) -> String {
    let idx = driver_list_index(state.loaded, path)
    if idx >= 0 && idx < len(state.sources) {
        return state.sources[idx]
    }
    return ""
}

fn attach_error_locations(errors: [ParseError], state: &LoadState) -> [ParseError] {
    let mut out: [ParseError] = []
    let mut i = 0
    while i < len(errors) {
        let e = errors[i]
        let mut handled = false
        if e.file != "" && e.pos >= 0 && (e.line == 0 || e.col == 0) {
            let src = driver_source_for(state, e.file)
            if src != "" {
                let mut lex = lexer_new(src)
                let mut offset = 0
                if e.pos < len(lex.toks.items) {
                    offset = tok_start(lex.toks, e.pos)
                } else {
                    offset = len(src)
                }
                let lc = line_col_from_offset(src, offset)
                push(&mut out, ParseError { pos: e.pos, file: e.file, line: lc.line, col: lc.col, msg: e.msg })
                handled = true
            }
        }
        if !handled {
            push(&mut out, e)
        }
        i = i + 1
    }
    return out
}

fn line_col_from_offset(src: String, offset: i32) -> LineCol {
    let mut line = 1
    let mut col = 1
    let mut i = 0
    let mut limit = offset
    if limit < 0 { limit = 0 }
    if limit > len(src) { limit = len(src) }
    while i < limit {
        let ch = char_at(src, i)
        if ch == '\n' {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return LineCol { line: line, col: col }
}

fn print_error_line(file: String, line: i32, col: i32, msg: String) {
    let mut fname = file
    if fname == "" { fname = "<unknown>" }
    let loc = fname + ":" + int_to_string(line) + ":" + int_to_string(col)
    println("stage2: " + loc + ": error " + msg)
}

fn collect_tests(prog: Program) -> [String] {
    let mut out: [String] = []
    let mut i = 0
    while i < len(prog.functions) {
        let f = prog.functions[i]
        if f.is_test || driver_string_starts_with(f.name, "test_") {
            push(&mut out, driver_qualify_name(f.module, f.name))
        }
        i = i + 1
    }
    return out
}

fn main() {
    let argv = args()
    if len(argv) < 1 {
        die_usage()
    }
    let cmd = argv[0]
    if cmd != "build" && cmd != "run" && cmd != "ir" && cmd != "ir-run" && cmd != "ir-verify" && cmd != "ir-opt" && cmd != "test" {
        die_usage()
    }
    let mut debug = false
    let mut start = 1
    if len(argv) > 1 && argv[1] == "--debug" {
        debug = true
        start = 2
    }
    if debug { println("stage2: start") }
    let split = split_args(argv, start)
    if len(split.files) == 0 {
        die_usage()
    }

    if cmd == "ir-run" {
        if len(split.files) != 1 {
            die_usage()
        }
        let text = read_file(split.files[0])
        let parsed = ir_parse_program(text)
        if !parsed.ok {
            die_parse(split.files[0], parsed.line, parsed.error)
        }
        let verr = ir_validate(parsed.prog)
        if verr != "" {
            die_error(verr)
        }
        let mut rt = runtime_new(parsed.prog, split.rest)
        if debug { println("stage2: running ir") }
        runtime_run(&mut rt, parsed.prog.entry)
        handle_runtime_error(rt.error)
        return
    }
    if cmd == "ir-verify" {
        if len(split.files) != 1 {
            die_usage()
        }
        let text = read_file(split.files[0])
        let parsed = ir_parse_program(text)
        if !parsed.ok {
            die_parse(split.files[0], parsed.line, parsed.error)
        }
        let verr = ir_validate(parsed.prog)
        if verr != "" {
            die_error(verr)
        }
        return
    }
    if cmd == "ir-opt" {
        if len(split.files) != 1 {
            die_usage()
        }
        let text = read_file(split.files[0])
        let parsed = ir_parse_program(text)
        if !parsed.ok {
            die_parse(split.files[0], parsed.line, parsed.error)
        }
        let verr = ir_validate(parsed.prog)
        if verr != "" {
            die_error(verr)
        }
        let opt = ir_opt_program(parsed.prog)
        let verr2 = ir_validate(opt)
        if verr2 != "" {
            die_error(verr2)
        }
        print(ir_program_format(opt))
        return
    }
    let mut pkg_root = driver_find_package_root(split.files[0])
    let mut pkg_has_toml = pkg_root != ""
    if !pkg_has_toml {
        pkg_root = split.files[0]
        if driver_is_dast_file(pkg_root) {
            pkg_root = driver_path_dir(pkg_root)
        }
    }
    let code_root = driver_code_root(pkg_root)

    let mut state = load_state_new()
    let mut i = 0
    while i < len(split.files) {
        let path = split.files[i]
        let mut dir = path
        if driver_is_dast_file(path) {
            dir = driver_path_dir(path)
        }
        if pkg_has_toml {
            let other_root = driver_find_package_root(path)
            if other_root != pkg_root {
                die_error("multiple package roots not supported")
            }
        } else {
            let other_root = driver_find_package_root(path)
            if other_root != "" && other_root != pkg_root {
                die_error("multiple package roots not supported")
            }
            if !driver_path_is_within(pkg_root, dir) {
                die_error("multiple package roots not supported")
            }
        }
        if dir == pkg_root {
            dir = code_root
        }
        if !driver_path_is_within(code_root, dir) {
            die_error("path outside package root: " + path)
        }
        let include_tests = cmd == "test"
        load_dir_recursive(dir, code_root, &mut state, include_tests)
        i = i + 1
    }
    let parse_res = ParseResult { prog: state.merged, errors: state.errors }
    if len(parse_res.errors) > 0 {
        die_errors(parse_res.errors)
    }
    if debug { println("stage2: parsed") }
    let tctx = check_program(parse_res.prog)
    let terrs = attach_error_locations(tctx.errors, &state)
    if len(terrs) > 0 { die_errors(terrs) }
    if debug { println("stage2: typechecked") }
    let comp = compile_program(parse_res.prog, tctx)
    let cerrs = attach_error_locations(comp.errors, &state)
    if len(cerrs) > 0 { die_errors(cerrs) }
    if debug { println("stage2: compiled") }
    let verr = ir_validate(comp.prog)
    if verr != "" {
        die_error(verr)
    }
    if cmd == "ir" {
        print(ir_program_format(comp.prog))
        return
    }
    if cmd == "build" {
        let mut name = "main"
        if pkg_has_toml {
            let pkg = driver_package_name(pkg_root)
            if pkg != "" { name = pkg }
        }
        let target_dir = driver_path_join(pkg_root, "target")
        mkdir(target_dir)
        let out_path = driver_path_join(target_dir, name + ".ir")
        write_file(out_path, ir_program_format(comp.prog))
        return
    }
    if cmd == "test" {
        let tests = collect_tests(parse_res.prog)
        if len(tests) == 0 {
            println("ok 0")
            return
        }
        let mut ti = 0
        while ti < len(tests) {
            let name = tests[ti]
            if debug { println("stage2: test", name) }
            let mut rt = runtime_new(comp.prog, driver_string_list_new())
            runtime_run(&mut rt, name)
            if rt.error != "" {
                handle_runtime_error(rt.error)
            }
            ti = ti + 1
        }
        println("ok", len(tests))
        return
    }
    let mut rt = runtime_new(comp.prog, split.rest)
    if debug { println("stage2: running") }
    runtime_run(&mut rt, comp.prog.entry)
    handle_runtime_error(rt.error)
}
