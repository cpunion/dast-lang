// Test multiple trait bounds - missing one trait

trait Cloneable {
    fn clone(&self) -> Self;
}

trait Displayable {
    fn display(&self);
}

struct Point {
    x: int,
    y: int,
}

impl Cloneable for Point {
    fn clone(&self) -> Self {
        return Point { x: self.x, y: self.y }
    }
}

// Point does NOT implement Displayable

fn process[T: Cloneable + Displayable](item: &T) -> int {
    return 42
}

fn main() {
    let p = Point { x: 10, y: 20 }
    let result = process::[Point](&p)  // Should error: Point doesn't implement Displayable
    println("result", result)
}
