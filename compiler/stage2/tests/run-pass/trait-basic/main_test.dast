// Test impl Trait for Type method calling
import "std/testing" as t

trait Greeter {
    fn greet(&self) -> String;
}

struct Person {
    name: String,
}

impl Greeter for Person {
    fn greet(&self) -> String {
        return "Hello"
    }
}

fn test_main() {
    let p = Person { name: "Alice" }
    let msg = (&p).greet()
    t.assert_eq!(msg, "Hello")
}
