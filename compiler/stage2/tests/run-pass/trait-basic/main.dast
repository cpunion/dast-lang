// Test impl Trait for Type method calling

trait Greeter {
    fn greet(&self) -> String;
}

struct Person {
    name: String,
}

impl Greeter for Person {
    fn greet(&self) -> String {
        return "Hello"
    }
}

fn main() {
    let p = Person { name: "Alice" }
    let msg = (&p).greet()
    println("result", msg)
}
