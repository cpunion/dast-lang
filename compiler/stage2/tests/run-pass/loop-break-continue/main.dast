fn main() {
    let mut i = 0
    let mut sum = 0
    while i < 5 {
        i = i + 1
        if i == 3 { continue }
        sum = sum + i
        if sum > 10 { break }
    }
    println("sum", sum)

    let mut j = 0
    loop {
        j = j + 1
        if j == 2 { break }
    }
    println("j", j)
}
