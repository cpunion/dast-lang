// Test trait with multiple methods and different self parameter styles

trait Shape {
    fn area(&self) -> int;
    fn perimeter(&self) -> int;
    fn name(&self) -> String;
}

struct Rectangle {
    width: int,
    height: int,
}

impl Shape for Rectangle {
    fn area(&self) -> int {
        return self.width * self.height
    }

    fn perimeter(&self) -> int {
        return 2 * (self.width + self.height)
    }

    fn name(&self) -> String {
        return "Rectangle"
    }
}

struct Square {
    side: int,
}

impl Shape for Square {
    fn area(&self) -> int {
        return self.side * self.side
    }

    fn perimeter(&self) -> int {
        return 4 * self.side
    }

    fn name(&self) -> String {
        return "Square"
    }
}

fn main() {
    println("trait-methods test passed")
}
