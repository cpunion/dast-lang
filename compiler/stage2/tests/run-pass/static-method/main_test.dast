import "std/testing" as t

struct Util { value: int }

impl Util {
    fn add(a: int, b: int) -> int { a + b }
    fn plus(self: &Self, v: int) -> int { self.value + v }
}

fn test_main() {
    let u = Util { value: 2 }
    let a = Util.add(1, 3)
    let b = (&u).plus(4)
    t.assert_eq!(a, 4)
    t.assert_eq!(b, 6)
}
