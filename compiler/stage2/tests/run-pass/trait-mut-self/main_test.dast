// Test trait with &mut self method
import "std/testing" as t

trait Counter {
    fn count(&self) -> int;
    fn increment(&mut self);
}

struct SimpleCounter {
    value: int,
}

impl Counter for SimpleCounter {
    fn count(&self) -> int {
        return self.value
    }

    fn increment(&mut self) {
        self.value = self.value + 1
    }
}

fn test_main() {
    let mut c = SimpleCounter { value: 0 }
    (&mut c).increment()
    t.assert_eq!((&c).count(), 1)
}
