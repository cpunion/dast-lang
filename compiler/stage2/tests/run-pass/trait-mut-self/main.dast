// Test trait with &mut self method

trait Counter {
    fn count(&self) -> int;
    fn increment(&mut self);
}

struct SimpleCounter {
    value: int,
}

impl Counter for SimpleCounter {
    fn count(&self) -> int {
        return self.value
    }

    fn increment(&mut self) {
        self.value = self.value + 1
    }
}

fn main() {
    println("trait-mut-self test passed")
}
