import "std/testing" as t

struct Counter { value: int }

impl Counter {
    fn inc(self: &mut Self, delta: int) -> int {
        self.value = self.value + delta
        self.value
    }

    fn get(self: &Self) -> int { self.value }
}

fn test_main() {
    let mut c = Counter { value: 1 }
    let v = (&mut c).inc(2)
    let g = (&c).get()
    t.assert_eq!(v, 3)
    t.assert_eq!(g, 3)
}
