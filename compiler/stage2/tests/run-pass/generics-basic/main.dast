// Test generic struct parsing
struct Box[T] {
    value: i32,
}

// Test generic enum parsing
enum Option[T] {
    Some(i32),
    None,
}

// ===== Single type param =====
fn identity[T](x: T) -> T {
    return x
}

// ===== Multiple type params =====

// Return first param's type
fn first[T, U](a: T, b: U) -> T {
    return a
}

// Return second param's type
fn second[T, U](a: T, b: U) -> U {
    return b
}

// Three type params - return middle
fn middle[A, B, C](a: A, b: B, c: C) -> B {
    return b
}

// Swap and return first (T appears twice)
fn swap_take_first[T, U](a: T, b: U, c: T) -> T {
    return c
}

fn main() {
    let b = Box { value: 42 }
    println("box", b.value)

    let opt = Option.Some(10)
    match opt {
        Option.Some(x) => { println("some", x) }
        Option.None => { println("none") }
    }

    // ===== Single type param tests =====
    let x1 = identity(7)
    println("identity_int", x1)

    let x2 = identity("hello")
    println("identity_str", x2)

    // ===== Two type param tests =====
    let y1 = first(100, "ignored")
    println("first_int", y1)

    let y2 = first("kept", 999)
    println("first_str", y2)

    let y3 = second(100, "taken")
    println("second_str", y3)

    let y4 = second("ignored", 42)
    println("second_int", y4)

    // ===== Three type param tests =====
    let z1 = middle(1, "mid", true)
    println("middle_str", z1)

    let z2 = middle("a", 999, "c")
    println("middle_int", z2)

    // ===== Same type param multiple times =====
    let w1 = swap_take_first(1, "x", 99)
    println("swap_int", w1)

    let w2 = swap_take_first("first", 0, "third")
    println("swap_str", w2)
}
