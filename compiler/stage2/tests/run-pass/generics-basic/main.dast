// Test generic struct parsing
struct Box[T] {
    value: i32,
}

// Test generic enum parsing
enum Option[T] {
    Some(i32),
    None,
}

// Test generic function with T parameter and return type
fn identity[T](x: T) -> T {
    return x
}

fn first[T, U](a: T, b: U) -> T {
    return a
}

fn main() {
    let b = Box { value: 42 }
    println("box", b.value)

    let opt = Option.Some(10)
    match opt {
        Option.Some(x) => { println("some", x) }
        Option.None => { println("none") }
    }

    // Generic function with T inferred from argument
    let x = identity(7)
    println("identity", x)

    // Multiple type params
    let y = first(100, "hello")
    println("first", y)

    // String type inference
    let s = identity("world")
    println("string", s)
}
