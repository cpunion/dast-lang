import "std/testing" as t

// Test Self type in trait method return type

trait Clone {
    fn clone(&self) -> Self;
}

struct Value {
    data: int,
}

impl Clone for Value {
    fn clone(&self) -> Value {
        return Value { data: self.data }
    }
}

fn test_main() {
    let v = Value { data: 42 }
    let v2 = (&v).clone()
    t.assert_eq!(v2.data, 42)
}
