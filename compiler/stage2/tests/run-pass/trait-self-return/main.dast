// Test Self type in trait method return type

trait Clone {
    fn clone(&self) -> Self;
}

struct Value {
    data: int,
}

impl Clone for Value {
    fn clone(&self) -> Value {
        return Value { data: self.data }
    }
}

fn main() {
    let v = Value { data: 42 }
    let v2 = (&v).clone()
    println("cloned", v2.data)
}
