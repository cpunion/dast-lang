// Test all self parameter styles: self, &self, &mut self, and self: Type

trait Converter {
    fn to_string(&self) -> String;
    fn clone_self(&self) -> int;
}

struct Value {
    n: int,
}

impl Converter for Value {
    fn to_string(&self) -> String {
        return "Value"
    }

    fn clone_self(&self) -> int {
        return self.n
    }
}

// Also test explicit self: &Self syntax (should work like &self)
impl Value {
    fn double(self: &Self) -> int {
        return self.n * 2
    }
}

fn main() {
    println("trait-self-shorthand test passed")
}
